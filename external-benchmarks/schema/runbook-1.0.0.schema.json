{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s3-lang.local/external-benchmarks/runbook-1.0.0.schema.json",
  "title": "S3 Agent Memory Runbook 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "provider", "provider_profile", "source_agent", "target_agent", "scenarios"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "provider": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "provider_profile": {"type": "object"},
    "source_agent": {"$ref": "#/$defs/agent"},
    "target_agent": {"$ref": "#/$defs/agent"},
    "scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "agent": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "harness"], "properties": {"provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "harness": {"type": "string", "minLength": 1}}},
    "scenario": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "mode", "steps"], "properties": {"scenario_id": {"type": "string", "minLength": 1}, "mode": {"enum": ["single-session", "cross-session", "cross-agent", "stale-memory"]}, "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}}}},
    "step": {"type": "object", "additionalProperties": false, "required": ["id", "runner", "argv", "prompt_relpath", "worktree_key", "hard_boundary_after"], "properties": {"id": {"type": "string", "minLength": 1}, "runner": {"enum": ["direct", "ai-memory-managed"]}, "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "prompt_relpath": {"type": "string", "minLength": 1}, "worktree_key": {"type": "string", "minLength": 1}, "agent": {"$ref": "#/$defs/agent"}, "hard_boundary_after": {"type": "boolean"}}}
  }
}
