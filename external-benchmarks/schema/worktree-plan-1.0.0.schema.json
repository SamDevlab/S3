{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s3-lang.local/external-benchmarks/worktree-plan-1.0.0.schema.json",
  "title": "S3 External Benchmark Worktree Plan 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation", "worktrees"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "operation": {"enum": ["prepare", "prepared"]},
    "worktrees": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario_id", "path", "commit"],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
