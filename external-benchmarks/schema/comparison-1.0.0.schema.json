{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s3-lang.local/external-benchmarks/comparison-1.0.0.schema.json",
  "title": "S3 External Benchmark Comparison 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "campaign_version", "category", "status", "comparability", "providers"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "campaign_version": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL"]},
    "comparability": {"type": "object", "additionalProperties": false, "required": ["status", "reasons", "repetitions", "reference"], "properties": {"status": {"enum": ["COMPARABLE", "NOT_COMPARABLE"]}, "reasons": {"type": "array", "items": {"type": "string"}}, "repetitions": {"type": "integer", "minimum": 1}, "reference": {"type": "object", "additionalProperties": false, "required": ["s3_commit", "agent_harness_version", "tool_permissions_profile", "task_protocol_version"], "properties": {"s3_commit": {"type": "string", "minLength": 1}, "agent_harness_version": {"type": "string", "minLength": 1}, "tool_permissions_profile": {"type": "string", "minLength": 1}, "task_protocol_version": {"type": "string", "minLength": 1}}}}},
    "providers": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/providerSummary"}}
  },
  "$defs": {
    "providerSummary": {"type": "object", "additionalProperties": false, "required": ["provider_profile", "campaign_runs_total", "campaign_runs_passed", "campaign_runs_failed", "scenario_observations_total", "scenario_observations_passed", "scenario_observations_failed", "scenario_pass_rate", "critical_oracle_failures", "mean_invariant_recall_rate", "scenarios"], "properties": {"provider_profile": {"type": "object"}, "campaign_runs_total": {"type": "integer", "minimum": 0}, "campaign_runs_passed": {"type": "integer", "minimum": 0}, "campaign_runs_failed": {"type": "integer", "minimum": 0}, "scenario_observations_total": {"type": "integer", "minimum": 0}, "scenario_observations_passed": {"type": "integer", "minimum": 0}, "scenario_observations_failed": {"type": "integer", "minimum": 0}, "scenario_pass_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "critical_oracle_failures": {"type": "integer", "minimum": 0}, "mean_invariant_recall_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "scenarios": {"type": "object", "additionalProperties": {"$ref": "#/$defs/scenarioSummary"}}}},
    "scenarioSummary": {"type": "object", "additionalProperties": false, "required": ["runs", "passed", "failed", "critical_oracle_failures", "pass_rate", "mean_invariant_recall_rate"], "properties": {"runs": {"type": "integer", "minimum": 0}, "passed": {"type": "integer", "minimum": 0}, "failed": {"type": "integer", "minimum": 0}, "critical_oracle_failures": {"type": "integer", "minimum": 0}, "pass_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "mean_invariant_recall_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}}
  }
}
