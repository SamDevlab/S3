{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s3-lang.local/external-benchmarks/task-pack-1.0.0.schema.json",
  "title": "S3 External Benchmark Task Pack 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "version", "global_rules", "scenarios"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "global_rules": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "phase_a", "phase_b", "expected_artifacts"],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "phase_a": {"$ref": "#/$defs/phase"},
          "phase_b": {"$ref": "#/$defs/phase"},
          "expected_artifacts": {"$ref": "#/$defs/artifacts"}
        }
      }
    }
  },
  "$defs": {
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instruction", "authoritative_paths"],
      "properties": {
        "instruction": {"type": "string", "minLength": 1},
        "authoritative_paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "expose_invariants": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_changed", "forbidden_changed", "max_changed_files"],
      "properties": {
        "required_changed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "forbidden_changed": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "max_changed_files": {"type": "integer", "minimum": 1}
      }
    }
  }
}
