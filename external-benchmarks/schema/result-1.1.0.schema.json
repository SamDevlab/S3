{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s3-lang.local/external-benchmarks/result-1.1.0.schema.json",
  "title": "S3 External Benchmark Result 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "scenario_version", "category", "provider", "agent", "status", "reported_invariants", "metrics", "oracle", "execution", "dimensions", "agent_process"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "scenario_id": {"type": "string", "minLength": 1},
    "scenario_version": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "provider": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "agent": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "harness"], "properties": {"provider": {"type": "string"}, "model": {"type": "string"}, "harness": {"type": "string"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["s3_commit", "agent_harness_version", "tool_permissions_profile", "task_protocol_version", "execution_protocol_version", "repetition"], "properties": {"s3_commit": {"type": "string", "minLength": 1}, "agent_harness_version": {"type": "string", "minLength": 1}, "tool_permissions_profile": {"type": "string", "minLength": 1}, "task_protocol_version": {"type": "string", "minLength": 1}, "execution_protocol_version": {"const": "agent-memory-v1.0.3"}, "repetition": {"type": "integer", "minimum": 1}}},
    "status": {"enum": ["VALID_PASS", "VALID_FAIL", "INVALID_OPERATIONAL_RUN", "INVALID_EXECUTION_EVIDENCE"]},
    "reported_invariants": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "metrics": {"type": "object"},
    "oracle": {"type": "array", "items": {"type": "object"}},
    "agent_process": {"type": "object"},
    "dimensions": {"type": "object"},
    "handoff": {"type": "object"},
    "stale_memory": {"type": "object"}
  }
}
