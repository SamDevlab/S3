{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s3-lang.local/external-benchmarks/agent-report-1.0.0.schema.json",
  "title": "S3 Agent Memory Recall Report 1.0.0",
  "type": "object",
