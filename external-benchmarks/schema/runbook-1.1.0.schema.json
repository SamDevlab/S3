{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s3-lang.local/external-benchmarks/runbook-1.1.0.schema.json",
  "title": "S3 Agent Memory Runbook 1.1.0",
  "type": "object",
  "required": ["schema_version", "execution_protocol_version", "campaign_id", "provider", "provider_profile", "source_agent", "target_agent", "timeout_policy", "scenarios"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "execution_protocol_version": {"const": "agent-memory-v1.0.3"},
    "campaign_id": {"const": "agent-memory-v1"},
    "provider": {"type": "object"},
    "provider_profile": {"type": "object"},
    "source_agent": {"type": "object"},
    "target_agent": {"type": "object"},
    "timeout_policy": {"type": "object"},
    "scenarios": {"type": "array", "minItems": 1}
  }
}
