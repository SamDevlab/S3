{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s3-lang.local/external-benchmarks/run-plan-1.0.0.schema.json",
  "title": "S3 External Benchmark Run Plan 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "campaign_version", "provider", "agent", "execution", "run_root", "scenarios"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "campaign_version": {"type": "string", "minLength": 1},
    "provider": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "agent": {"type": "object", "additionalProperties": false, "required": ["provider", "model", "harness"], "properties": {"provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "harness": {"type": "string", "minLength": 1}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["s3_commit", "agent_harness_version", "tool_permissions_profile", "task_protocol_version", "repetition"], "properties": {"s3_commit": {"type": "string", "minLength": 1}, "agent_harness_version": {"type": "string", "minLength": 1}, "tool_permissions_profile": {"type": "string", "minLength": 1}, "task_protocol_version": {"type": "string", "minLength": 1}, "repetition": {"type": "integer", "minimum": 1}}},
    "run_root": {"type": "string", "minLength": 1},
    "scenarios": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["scenario_id", "mode", "template", "worktree_key", "observation_path", "result_path", "required_evidence"], "properties": {"scenario_id": {"type": "string", "minLength": 1}, "mode": {"enum": ["single-session", "cross-session", "cross-agent", "stale-memory"]}, "template": {"type": "string", "minLength": 1}, "worktree_key": {"type": "string", "minLength": 1}, "observation_path": {"type": "string", "minLength": 1}, "result_path": {"type": "string", "minLength": 1}, "required_evidence": {"type": "array", "items": {"enum": ["handoff", "stale_memory"]}, "uniqueItems": true}, "stale_claim_id": {"type": "string", "minLength": 1}}}}
  }
}
