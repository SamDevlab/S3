{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s3-lang.local/external-benchmarks/run-plan-1.1.0.schema.json",
  "title": "S3 External Benchmark Run Plan 1.1.0",
  "type": "object",
  "required": ["schema_version", "campaign_id", "campaign_version", "provider", "timeout_policy", "provider_profile", "agent", "execution", "run_root", "scenarios"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "campaign_id": {"const": "agent-memory-v1"},
    "campaign_version": {"type": "string", "minLength": 1},
    "provider": {"type": "object"},
    "timeout_policy": {"type": "object"},
    "provider_profile": {"type": "object"},
    "agent": {"type": "object"},
    "execution": {"type": "object", "required": ["execution_protocol_version"], "properties": {"execution_protocol_version": {"const": "agent-memory-v1.0.2"}}},
    "run_root": {"type": "string", "minLength": 1},
    "scenarios": {"type": "array", "minItems": 1}
  }
}
