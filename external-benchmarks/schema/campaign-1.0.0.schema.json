{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s3-lang.local/external-benchmarks/campaign-1.0.0.schema.json",
  "title": "S3 External Benchmark Campaign 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "campaign_id",
    "version",
    "category",
    "objective",
    "configurations",
    "protocol",
    "scenarios",
    "gates"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "configurations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["worktree_isolation", "recommended_repetitions", "result_collection", "rules"],
      "properties": {
        "worktree_isolation": {"const": "fresh-worktree-per-scenario"},
        "recommended_repetitions": {"type": "integer", "minimum": 1},
        "result_collection": {"type": "string", "minLength": 1},
        "rules": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "mode", "purpose"],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "mode": {
            "enum": ["single-session", "cross-session", "cross-agent", "stale-memory"]
          },
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["require_all_oracles_pass", "recall_is_gate", "provider_consistency"],
      "properties": {
        "require_all_oracles_pass": {"const": true},
        "recall_is_gate": {"const": false},
        "provider_consistency": {"const": true}
      }
    }
  }
}
