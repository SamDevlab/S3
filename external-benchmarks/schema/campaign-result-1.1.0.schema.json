{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://s3-lang.local/external-benchmarks/campaign-result-1.1.0.schema.json",
  "title": "S3 External Benchmark Campaign Result 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "campaign_version", "category", "provider", "execution", "status", "metrics", "results"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "campaign_id": {"type": "string", "minLength": 1},
    "campaign_version": {"type": "string", "minLength": 1},
    "category": {"type": "string", "minLength": 1},
    "provider": {"type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["s3_commit", "agent_harness_version", "tool_permissions_profile", "task_protocol_version", "execution_protocol_version", "repetition"], "properties": {"s3_commit": {"type": "string", "minLength": 1}, "agent_harness_version": {"type": "string", "minLength": 1}, "tool_permissions_profile": {"type": "string", "minLength": 1}, "task_protocol_version": {"type": "string", "minLength": 1}, "execution_protocol_version": {"const": "agent-memory-v1.0.2"}, "repetition": {"type": "integer", "minimum": 1}}},
    "status": {"enum": ["PASS", "FAIL"]},
    "metrics": {"type": "object"},
    "results": {"type": "array", "items": {"$ref": "result-1.1.0.schema.json"}}
  }
}
