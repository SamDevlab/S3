fn expected_function_start_index(fixture: tryte, function_index: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            match function_index <=> 0:
                -1:
                    return -1

                0:
                    return 2

                1:
                    return -1

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    match function_index <=> 0:
                        -1:
                            return -1

                        0:
                            return 2

                        1:
                            match function_index <=> 1:
                                -1:
                                    return -1

                                0:
                                    return 11

                                1:
                                    return -1

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            match function_index <=> 0:
                                -1:
                                    return -1

                                0:
                                    return 2

                                1:
                                    match function_index <=> 1:
                                        -1:
                                            return -1

                                        0:
                                            return 26

                                        1:
                                            return -1

                        1:
                            return -1

fn expected_function_end_index(fixture: tryte, function_index: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            match function_index <=> 0:
                -1:
                    return -1

                0:
                    return 17

                1:
                    return -1

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    match function_index <=> 0:
                        -1:
                            return -1

                        0:
                            return 9

                        1:
                            match function_index <=> 1:
                                -1:
                                    return -1

                                0:
                                    return 20

                                1:
                                    return -1

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            match function_index <=> 0:
                                -1:
                                    return -1

                                0:
                                    return 24

                                1:
                                    match function_index <=> 1:
                                        -1:
                                            return -1

                                        0:
                                            return 35

                                        1:
                                            return -1

                        1:
                            return -1

fn expected_first_blueprint_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return unknown_blueprint()

        0:
            return blueprint_s3asm_header()

        1:
            match index <=> 1:
                -1:
                    return unknown_blueprint()

                0:
                    return blueprint_blank_line()

                1:
                    match index <=> 2:
                        -1:
                            return unknown_blueprint()

                        0:
                            return blueprint_function_header()

                        1:
                            match in_range(index, 3, 8) <=> 1:
                                -1:
                                    match index <=> 9:
                                        -1:
                                            return unknown_blueprint()

                                        0:
                                            return blueprint_label()

                                        1:
                                            match in_range(index, 10, 16) <=> 1:
                                                -1:
                                                    match index <=> 17:
                                                        -1:
                                                            return unknown_blueprint()

                                                        0:
                                                            return blueprint_end()

                                                        1:
                                                            return unknown_blueprint()

                                                0:
                                                    return blueprint_instruction_with_source()

                                                1:
                                                    return unknown_blueprint()

                                0:
                                    return blueprint_register()

                                1:
                                    return unknown_blueprint()

fn expected_simple_call_blueprint_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return unknown_blueprint()

        0:
            return blueprint_s3asm_header()

        1:
            match index <=> 1:
                -1:
                    return unknown_blueprint()

                0:
                    return blueprint_blank_line()

                1:
                    match index <=> 2:
                        -1:
                            return unknown_blueprint()

                        0:
                            return blueprint_function_header()

                        1:
                            match in_range(index, 3, 4) <=> 1:
                                -1:
                                    match index <=> 5:
                                        -1:
                                            return unknown_blueprint()

                                        0:
                                            return blueprint_register()

                                        1:
                                            match index <=> 6:
                                                -1:
                                                    return unknown_blueprint()

                                                0:
                                                    return blueprint_label()

                                                1:
                                                    match in_range(index, 7, 8) <=> 1:
                                                        -1:
                                                            match index <=> 9:
                                                                -1:
                                                                    return unknown_blueprint()

                                                                0:
                                                                    return blueprint_end()

                                                                1:
                                                                    match index <=> 10:
                                                                        -1:
                                                                            return unknown_blueprint()

                                                                        0:
                                                                            return blueprint_blank_line()

                                                                        1:
                                                                            match index <=> 11:
                                                                                -1:
                                                                                    return unknown_blueprint()

                                                                                0:
                                                                                    return blueprint_function_header()

                                                                                1:
                                                                                    match in_range(index, 12, 14) <=> 1:
                                                                                        -1:
                                                                                            match index <=> 15:
                                                                                                -1:
                                                                                                    return unknown_blueprint()

                                                                                                0:
                                                                                                    return blueprint_label()

                                                                                                1:
                                                                                                    match in_range(index, 16, 19) <=> 1:
                                                                                                        -1:
                                                                                                            match index <=> 20:
                                                                                                                -1:
                                                                                                                    return unknown_blueprint()

                                                                                                                0:
                                                                                                                    return blueprint_end()

                                                                                                                1:
                                                                                                                    return unknown_blueprint()

                                                                                                        0:
                                                                                                            return blueprint_instruction_with_source()

                                                                                                        1:
                                                                                                            return unknown_blueprint()

                                                                                        0:
                                                                                            return blueprint_register()

                                                                                        1:
                                                                                            return unknown_blueprint()

                                                        0:
                                                            return blueprint_instruction_with_source()

                                                        1:
                                                            return unknown_blueprint()

                                0:
                                    return blueprint_param()

                                1:
                                    return unknown_blueprint()

fn expected_sign_blueprint_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return unknown_blueprint()

        0:
            return blueprint_s3asm_header()

        1:
            match index <=> 1:
                -1:
                    return unknown_blueprint()

                0:
                    return blueprint_blank_line()

                1:
                    match index <=> 2:
                        -1:
                            return unknown_blueprint()

                        0:
                            return blueprint_function_header()

                        1:
                            match index <=> 3:
                                -1:
                                    return unknown_blueprint()

                                0:
                                    return blueprint_param()

                                1:
                                    match in_range(index, 4, 9) <=> 1:
                                        -1:
                                            match index <=> 10:
                                                -1:
                                                    return unknown_blueprint()

                                                0:
                                                    return blueprint_label()

                                                1:
                                                    match in_range(index, 11, 13) <=> 1:
                                                        -1:
                                                            match index <=> 14:
                                                                -1:
                                                                    return unknown_blueprint()

                                                                0:
                                                                    return blueprint_label()

                                                                1:
                                                                    match in_range(index, 15, 17) <=> 1:
                                                                        -1:
                                                                            match index <=> 18:
                                                                                -1:
                                                                                    return unknown_blueprint()

                                                                                0:
                                                                                    return blueprint_label()

                                                                                1:
                                                                                    match in_range(index, 19, 20) <=> 1:
                                                                                        -1:
                                                                                            match index <=> 21:
                                                                                                -1:
                                                                                                    return unknown_blueprint()

                                                                                                0:
                                                                                                    return blueprint_label()

                                                                                                1:
                                                                                                    match in_range(index, 22, 23) <=> 1:
                                                                                                        -1:
                                                                                                            match index <=> 24:
                                                                                                                -1:
                                                                                                                    return unknown_blueprint()

                                                                                                                0:
                                                                                                                    return blueprint_end()

                                                                                                                1:
                                                                                                                    match index <=> 25:
                                                                                                                        -1:
                                                                                                                            return unknown_blueprint()

                                                                                                                        0:
                                                                                                                            return blueprint_blank_line()

                                                                                                                        1:
                                                                                                                            match index <=> 26:
                                                                                                                                -1:
                                                                                                                                    return unknown_blueprint()

                                                                                                                                0:
                                                                                                                                    return blueprint_function_header()

                                                                                                                                1:
                                                                                                                                    match in_range(index, 27, 29) <=> 1:
                                                                                                                                        -1:
                                                                                                                                            match index <=> 30:
                                                                                                                                                -1:
                                                                                                                                                    return unknown_blueprint()

                                                                                                                                                0:
                                                                                                                                                    return blueprint_label()

                                                                                                                                                1:
                                                                                                                                                    match in_range(index, 31, 34) <=> 1:
                                                                                                                                                        -1:
                                                                                                                                                            match index <=> 35:
                                                                                                                                                                -1:
                                                                                                                                                                    return unknown_blueprint()

                                                                                                                                                                0:
                                                                                                                                                                    return blueprint_end()

                                                                                                                                                                1:
                                                                                                                                                                    return unknown_blueprint()

                                                                                                                                                        0:
                                                                                                                                                            return blueprint_instruction_with_source()

                                                                                                                                                        1:
                                                                                                                                                            return unknown_blueprint()

                                                                                                                                        0:
                                                                                                                                            return blueprint_register()

                                                                                                                                        1:
                                                                                                                                            return unknown_blueprint()

                                                                                                        0:
                                                                                                            return blueprint_instruction_with_source()

                                                                                                        1:
                                                                                                            return unknown_blueprint()

                                                                                        0:
                                                                                            return blueprint_instruction_with_source()

                                                                                        1:
                                                                                            return unknown_blueprint()

                                                                        0:
                                                                            return blueprint_instruction_with_source()

                                                                        1:
                                                                            return unknown_blueprint()

                                                        0:
                                                            return blueprint_instruction_with_source()

                                                        1:
                                                            return unknown_blueprint()

                                        0:
                                            return blueprint_register()

                                        1:
                                            return unknown_blueprint()

fn expected_blueprint_at(fixture: tryte, index: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return unknown_blueprint()

        0:
            return expected_first_blueprint_at(index)

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return unknown_blueprint()

                0:
                    return expected_simple_call_blueprint_at(index)

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return unknown_blueprint()

                        0:
                            return expected_sign_blueprint_at(index)

                        1:
                            return unknown_blueprint()

