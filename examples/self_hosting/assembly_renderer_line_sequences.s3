    ok = all_passed(ok, validate_expected_at(fixture_first(), 6, blueprint_register()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 7, blueprint_register()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 8, blueprint_register()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 9, blueprint_label()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 10, blueprint_instruction_with_source()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 11, blueprint_instruction_with_source()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 12, blueprint_instruction_with_source()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 13, blueprint_instruction_with_source()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 14, blueprint_instruction_with_source()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 15, blueprint_instruction_with_source()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 16, blueprint_instruction_with_source()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 17, blueprint_end()))
    ok = all_passed(ok, same_trit(validate_blueprint_index(fixture_first(), 18), 0))
    ok = all_passed(ok, same_trit(validate_blueprint_index(fixture_first(), -1), 0))

    return ok

