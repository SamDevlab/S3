fn validate_blueprint_index(fixture: tryte, index: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            return is_valid_index(index, expected_line_count(fixture))

        1:
            return 0

fn validate_transition_index(fixture: tryte, index: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            return is_valid_index(index, expected_transition_count(fixture))

        1:
            return 0

fn is_valid_blueprint_transition(left: tryte, right: tryte) -> trit:
    match left <=> blueprint_s3asm_header():
        -1:
            return 0

        0:
            return same_tryte(right, blueprint_blank_line())

        1:
            match left <=> blueprint_function_header():
                -1:
                    return 0

                0:
                    return any_passed(
                        same_tryte(right, blueprint_param()),
                        same_tryte(right, blueprint_register())
                    )

                1:
                    match left <=> blueprint_param():
                        -1:
                            return 0

                        0:
                            return any_passed(
                                same_tryte(right, blueprint_param()),
                                same_tryte(right, blueprint_register())
                            )

                        1:
                            match left <=> blueprint_register():
                                -1:
                                    return 0

                                0:
                                    return any_passed(
                                        same_tryte(right, blueprint_register()),
                                        any_passed(
                                            same_tryte(right, blueprint_memory()),
                                            same_tryte(right, blueprint_label())
                                        )
                                    )

                                1:
                                    match left <=> blueprint_memory():
                                        -1:
                                            return 0

                                        0:
                                            return any_passed(
                                                same_tryte(right, blueprint_memory()),
                                                same_tryte(right, blueprint_label())
                                            )

                                        1:
                                            match left <=> blueprint_label():
                                                -1:
                                                    return 0

                                                0:
                                                    return any_passed(
                                                        same_tryte(right, blueprint_instruction()),
                                                        same_tryte(right, blueprint_instruction_with_source())
                                                    )

                                                1:
                                                    match left <=> blueprint_instruction():
                                                        -1:
                                                            return 0

                                                        0:
                                                            return any_passed(
                                                                any_passed(
                                                                    same_tryte(right, blueprint_instruction()),
                                                                    same_tryte(right, blueprint_instruction_with_source())
                                                                ),
                                                                any_passed(
                                                                    same_tryte(right, blueprint_label()),
                                                                    same_tryte(right, blueprint_end())
                                                                )
                                                            )

                                                        1:
                                                            match left <=> blueprint_instruction_with_source():
                                                                -1:
                                                                    return 0

                                                                0:
                                                                    return any_passed(
                                                                        any_passed(
                                                                            same_tryte(right, blueprint_instruction()),
                                                                            same_tryte(right, blueprint_instruction_with_source())
                                                                        ),
                                                                        any_passed(
                                                                            same_tryte(right, blueprint_label()),
                                                                            same_tryte(right, blueprint_end())
                                                                        )
                                                                    )

                                                                1:
                                                                    match left <=> blueprint_end():
                                                                        -1:
                                                                            return 0

                                                                        0:
                                                                            return same_tryte(right, blueprint_blank_line())

                                                                        1:
                                                                            match left <=> blueprint_blank_line():
                                                                                -1:
                                                                                    return 0

                                                                                0:
                                                                                    return same_tryte(right, blueprint_function_header())

                                                                                1:
                                                                                    return 0

fn validate_expected_at(fixture: tryte, index: tryte, blueprint: tryte) -> trit:
    return same_tryte(expected_blueprint_at(fixture, index), blueprint)

fn validate_transition_at(fixture: tryte, index: tryte) -> trit:
    match validate_transition_index(fixture, index) <=> 1:
        -1:
            return 0

        0:
            return is_valid_blueprint_transition(
                expected_blueprint_at(fixture, index),
                expected_blueprint_at(fixture, index + 1)
            )

        1:
            return 0

fn validate_first_sequence() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, validate_expected_at(fixture_first(), 0, blueprint_s3asm_header()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 1, blueprint_blank_line()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 2, blueprint_function_header()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 3, blueprint_register()))
    ok = all_passed(ok, validate_expected_at(fixture_first(), 4, blueprint_register()))
