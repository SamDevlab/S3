# Bootstrap line sequence model for a future S3 Assembly renderer.
# It models ordered line blueprint IDs for current renderer fixtures.

fn fixture_first() -> tryte:
    return 0

fn fixture_simple_call() -> tryte:
    return 1

fn fixture_sign() -> tryte:
    return 2

fn unknown_blueprint() -> tryte:
    return -1

fn blueprint_s3asm_header() -> tryte:
    return 0

fn blueprint_function_header() -> tryte:
    return 1

fn blueprint_param() -> tryte:
    return 2

fn blueprint_register() -> tryte:
    return 3

fn blueprint_memory() -> tryte:
    return 4

fn blueprint_label() -> tryte:
    return 5

fn blueprint_instruction() -> tryte:
    return 6

fn blueprint_instruction_with_source() -> tryte:
    return 7

fn blueprint_end() -> tryte:
    return 8

fn blueprint_blank_line() -> tryte:
    return 9

fn line_blueprint_kind_count() -> tryte:
    return blueprint_blank_line() + 1

fn same_tryte(left: tryte, right: tryte) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn same_trit(left: trit, right: trit) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn all_passed(left: trit, right: trit) -> trit:
    match left <=> 1:
        -1:
            return 0

        0:
            match right <=> 1:
                -1:
                    return 0

                0:
                    return 1

                1:
                    return 0

        1:
            return 0

fn any_passed(left: trit, right: trit) -> trit:
    match left <=> 1:
        -1:
            match right <=> 1:
                -1:
                    return 0

                0:
                    return 1

                1:
                    return 0

        0:
            return 1

        1:
            return 1

fn status_from_check(check: trit, failure: tryte) -> tryte:
    match check <=> 1:
        -1:
            return failure

        0:
            return 0

        1:
            return failure

fn fixture_metric(fixture: tryte, first_value: tryte, simple_value: tryte, sign_value: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return first_value

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return simple_value

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return sign_value

                        1:
                            return -1

fn in_range(value: tryte, lower: tryte, upper: tryte) -> trit:
    match value <=> lower:
        -1:
            return 0

        0:
            return 1

        1:
            match value <=> upper:
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_known_fixture(fixture: tryte) -> trit:
    match fixture <=> fixture_first():
        -1:
            return 0

        0:
            return 1

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return 0

                0:
                    return 1

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return 0

                        0:
                            return 1

                        1:
                            return 0

fn is_known_blueprint(blueprint: tryte) -> trit:
    match blueprint <=> blueprint_s3asm_header():
        -1:
            return 0

        0:
            return 1

        1:
            match blueprint <=> blueprint_blank_line():
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_directive_blueprint(blueprint: tryte) -> trit:
    match blueprint <=> blueprint_s3asm_header():
        -1:
            return 0

        0:
            return 1

        1:
            match blueprint <=> blueprint_label():
                -1:
                    return 1

                0:
                    return 1

                1:
                    return same_tryte(blueprint, blueprint_end())

fn is_instruction_blueprint(blueprint: tryte) -> trit:
    return any_passed(
        same_tryte(blueprint, blueprint_instruction()),
        same_tryte(blueprint, blueprint_instruction_with_source())
    )

fn is_blank_blueprint(blueprint: tryte) -> trit:
    return same_tryte(blueprint, blueprint_blank_line())

fn is_valid_index(index: tryte, count: tryte) -> trit:
    match index <=> 0:
        -1:
            return 0

        0:
            match index <=> count:
                -1:
                    return 1

                0:
                    return 0

                1:
                    return 0

        1:
            match index <=> count:
                -1:
                    return 1

                0:
                    return 0

                1:
                    return 0

fn expected_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 18, 21, 36)

fn expected_blueprint_count(fixture: tryte) -> tryte:
    return expected_line_count(fixture)

fn expected_transition_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 17, 20, 35)

fn expected_function_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 2)

fn expected_function_boundary_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 2, 4, 4)

fn expected_instruction_run_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 5)

fn expected_longest_instruction_run_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 7, 4, 4)

fn expected_blank_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 2)

fn expected_memory_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 0, 0, 0)

fn expected_instruction_blueprint_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 7, 6, 14)

fn expected_directive_blueprint_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 10, 13, 20)

fn expected_directives_before_first_label_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 7, 4, 8)

fn expected_first_label_index(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 9, 6, 10)

fn expected_sequence_signature(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 72, 83, 152)

fn modeled_sequence_signature(fixture: tryte) -> tryte:
    return expected_sequence_signature(fixture)

