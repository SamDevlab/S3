fn validate_function_boundaries(fixture: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            mut ok: trit = 1

            ok = all_passed(ok, same_tryte(expected_blueprint_at(fixture, expected_function_start_index(fixture, 0)), blueprint_function_header()))
            ok = all_passed(ok, same_tryte(expected_blueprint_at(fixture, expected_function_end_index(fixture, 0)), blueprint_end()))

            match expected_function_count(fixture) <=> 2:
                -1:
                    ok = all_passed(ok, same_tryte(expected_function_start_index(fixture, 1), -1))

                0:
                    ok = all_passed(ok, same_tryte(expected_blueprint_at(fixture, expected_function_start_index(fixture, 1)), blueprint_function_header()))
                    ok = all_passed(ok, same_tryte(expected_blueprint_at(fixture, expected_function_end_index(fixture, 1)), blueprint_end()))

                1:
                    ok = all_passed(ok, same_tryte(expected_function_start_index(fixture, 1), -1))

            return ok

        1:
            return 0

fn validate_fixture_line_sequences(fixture: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            mut ok: trit = 1

            ok = all_passed(ok, validate_fixture_sequence(fixture))
            ok = all_passed(ok, validate_fixture_transitions(fixture))
            ok = all_passed(ok, validate_function_boundaries(fixture))
            ok = all_passed(ok, validate_sequence_signature(fixture))
            ok = all_passed(ok, same_tryte(expected_blueprint_count(fixture), expected_line_count(fixture)))
            ok = all_passed(ok, same_trit(is_known_blueprint(expected_blueprint_at(fixture, 0)), 1))
            ok = all_passed(ok, same_tryte(expected_blueprint_at(fixture, expected_line_count(fixture)), unknown_blueprint()))

            return ok

        1:
            return 0

fn total_line_count() -> tryte:
    return expected_line_count(fixture_first()) + expected_line_count(fixture_simple_call()) + expected_line_count(fixture_sign())

fn total_blueprint_count() -> tryte:
    return total_line_count()

fn total_transition_count() -> tryte:
    return expected_transition_count(fixture_first()) + expected_transition_count(fixture_simple_call()) + expected_transition_count(fixture_sign())

fn total_function_boundary_count() -> tryte:
    return expected_function_boundary_count(fixture_first()) + expected_function_boundary_count(fixture_simple_call()) + expected_function_boundary_count(fixture_sign())

fn total_instruction_blueprint_count() -> tryte:
    return expected_instruction_blueprint_count(fixture_first()) + expected_instruction_blueprint_count(fixture_simple_call()) + expected_instruction_blueprint_count(fixture_sign())

fn total_directive_blueprint_count() -> tryte:
    return expected_directive_blueprint_count(fixture_first()) + expected_directive_blueprint_count(fixture_simple_call()) + expected_directive_blueprint_count(fixture_sign())

fn total_blank_blueprint_count() -> tryte:
    return expected_blank_line_count(fixture_first()) + expected_blank_line_count(fixture_simple_call()) + expected_blank_line_count(fixture_sign())

fn total_sequence_signature() -> tryte:
    return expected_sequence_signature(fixture_first()) + expected_sequence_signature(fixture_simple_call()) + expected_sequence_signature(fixture_sign())

fn validate_total_line_sequences() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(total_line_count(), 75))
    ok = all_passed(ok, same_tryte(total_blueprint_count(), 75))
    ok = all_passed(ok, same_tryte(total_transition_count(), 72))
    ok = all_passed(ok, same_tryte(total_function_boundary_count(), 10))
    ok = all_passed(ok, same_tryte(total_instruction_blueprint_count(), 27))
    ok = all_passed(ok, same_tryte(total_directive_blueprint_count(), 43))
    ok = all_passed(ok, same_tryte(total_blank_blueprint_count(), 5))
    ok = all_passed(ok, same_tryte(total_sequence_signature(), 307))

    return ok

fn validate_invalid_transition_probes() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_trit(is_valid_blueprint_transition(blueprint_blank_line(), blueprint_blank_line()), 0))
    ok = all_passed(ok, same_trit(is_valid_blueprint_transition(blueprint_s3asm_header(), blueprint_s3asm_header()), 0))
    ok = all_passed(ok, same_trit(is_valid_blueprint_transition(blueprint_end(), blueprint_instruction_with_source()), 0))
    ok = all_passed(ok, same_trit(is_valid_blueprint_transition(blueprint_label(), blueprint_register()), 0))
    ok = all_passed(ok, same_trit(is_valid_blueprint_transition(blueprint_function_header(), blueprint_end()), 0))
    ok = all_passed(ok, same_trit(is_valid_blueprint_transition(blueprint_param(), blueprint_label()), 0))
    ok = all_passed(ok, same_trit(is_valid_blueprint_transition(99, blueprint_label()), 0))

    return ok

fn validate_all_fixture_sequences() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, validate_fixture_line_sequences(fixture_first()))
    ok = all_passed(ok, validate_fixture_line_sequences(fixture_simple_call()))
    ok = all_passed(ok, validate_fixture_line_sequences(fixture_sign()))
    ok = all_passed(ok, same_trit(validate_fixture_line_sequences(99), 0))
    ok = all_passed(ok, same_tryte(expected_blueprint_at(99, 0), unknown_blueprint()))
    ok = all_passed(ok, same_trit(is_known_blueprint(99), 0))
    ok = all_passed(ok, validate_invalid_transition_probes())
    ok = all_passed(ok, validate_total_line_sequences())

    return ok

fn line_sequences_first_probe() -> tryte:
    return status_from_check(validate_fixture_line_sequences(fixture_first()), 1)

fn line_sequences_simple_call_probe() -> tryte:
    return status_from_check(validate_fixture_line_sequences(fixture_simple_call()), 1)

fn line_sequences_sign_probe() -> tryte:
    return status_from_check(validate_fixture_line_sequences(fixture_sign()), 1)

fn line_sequences_unknown_fixture_probe() -> tryte:
    return status_from_check(same_trit(validate_fixture_line_sequences(99), 0), 1)

fn line_sequences_invalid_index_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, same_trit(validate_blueprint_index(fixture_first(), -1), 0))
    ok = all_passed(ok, same_trit(validate_blueprint_index(fixture_first(), 18), 0))
    ok = all_passed(ok, same_tryte(expected_blueprint_at(fixture_first(), 18), unknown_blueprint()))

    return status_from_check(ok, 1)

fn line_sequences_unknown_blueprint_probe() -> tryte:
    return status_from_check(same_trit(is_known_blueprint(99), 0), 1)

fn line_sequences_invalid_transition_probe() -> tryte:
    return status_from_check(validate_invalid_transition_probes(), 1)

fn line_sequences_transition_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, is_valid_blueprint_transition(blueprint_s3asm_header(), blueprint_blank_line()))
    ok = all_passed(ok, is_valid_blueprint_transition(blueprint_blank_line(), blueprint_function_header()))
    ok = all_passed(ok, is_valid_blueprint_transition(blueprint_function_header(), blueprint_param()))
    ok = all_passed(ok, is_valid_blueprint_transition(blueprint_register(), blueprint_memory()))
    ok = all_passed(ok, is_valid_blueprint_transition(blueprint_memory(), blueprint_label()))
    ok = all_passed(ok, is_valid_blueprint_transition(blueprint_instruction_with_source(), blueprint_label()))

    return status_from_check(ok, 1)

fn line_sequences_signature_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, validate_sequence_signature(fixture_first()))
    ok = all_passed(ok, validate_sequence_signature(fixture_simple_call()))
    ok = all_passed(ok, validate_sequence_signature(fixture_sign()))
    ok = all_passed(ok, same_tryte(total_sequence_signature(), 307))

    return status_from_check(ok, 1)

fn line_sequences_totals_probe() -> tryte:
    return status_from_check(validate_total_line_sequences(), 1)

fn line_sequence_model_self_check() -> tryte:
    return status_from_check(validate_all_fixture_sequences(), 1)

fn main() -> tryte:
    return line_sequence_model_self_check()
