# Bootstrap line blueprint model for a future S3 Assembly renderer.
# Each rendered assembly line maps to one primary blueprint kind.
# Source metadata is represented by the instruction with source blueprint.

fn fixture_first() -> tryte:
    return 0

fn fixture_simple_call() -> tryte:
    return 1

fn fixture_sign() -> tryte:
    return 2

fn blueprint_s3asm_header() -> tryte:
    return 0

fn blueprint_function_header() -> tryte:
    return 1

fn blueprint_param() -> tryte:
    return 2

fn blueprint_register() -> tryte:
    return 3

fn blueprint_memory() -> tryte:
    return 4

fn blueprint_label() -> tryte:
    return 5

fn blueprint_instruction() -> tryte:
    return 6

fn blueprint_instruction_with_source() -> tryte:
    return 7

fn blueprint_end() -> tryte:
    return 8

fn blueprint_blank_line() -> tryte:
    return 9

fn line_blueprint_kind_count() -> tryte:
    return blueprint_blank_line() + 1

fn same_tryte(left: tryte, right: tryte) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn same_trit(left: trit, right: trit) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn all_passed(left: trit, right: trit) -> trit:
    match left <=> 1:
        -1:
            return 0

        0:
            match right <=> 1:
                -1:
                    return 0

                0:
                    return 1

                1:
                    return 0

        1:
            return 0

fn status_from_check(check: trit, failure: tryte) -> tryte:
    match check <=> 1:
        -1:
            return failure

        0:
            return 0

        1:
            return failure

fn fixture_metric(fixture: tryte, first_value: tryte, simple_value: tryte, sign_value: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return first_value

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return simple_value

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return sign_value

                        1:
                            return -1

fn is_known_fixture(fixture: tryte) -> trit:
    match fixture <=> fixture_first():
        -1:
            return 0

        0:
            return 1

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return 0

                0:
                    return 1

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return 0

                        0:
                            return 1

                        1:
                            return 0

fn is_known_blueprint(blueprint: tryte) -> trit:
    match blueprint <=> blueprint_s3asm_header():
        -1:
            return 0

        0:
            return 1

        1:
            match blueprint <=> blueprint_blank_line():
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_directive_blueprint(blueprint: tryte) -> trit:
    match blueprint <=> blueprint_s3asm_header():
        -1:
            return 0

        0:
            return 1

        1:
            match blueprint <=> blueprint_label():
                -1:
                    return 1

                0:
                    return 1

                1:
                    return same_tryte(blueprint, blueprint_end())

fn is_instruction_blueprint(blueprint: tryte) -> trit:
    match blueprint <=> blueprint_instruction():
        -1:
            return 0

        0:
            return 1

        1:
            match blueprint <=> blueprint_instruction_with_source():
                -1:
                    return 0

                0:
                    return 1

                1:
                    return 0

fn is_blank_blueprint(blueprint: tryte) -> trit:
    return same_tryte(blueprint, blueprint_blank_line())

fn expected_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 18, 21, 36)

fn expected_blueprint_count(fixture: tryte) -> tryte:
    return expected_line_count(fixture)

fn expected_s3asm_header_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 1, 1)

fn expected_function_header_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 2)

fn expected_param_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 0, 2, 1)

fn expected_register_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 6, 4, 9)

fn expected_memory_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 0, 0, 0)

fn expected_label_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 5)

fn expected_instruction_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 7, 6, 14)

fn expected_instruction_with_source_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 7, 6, 14)

fn expected_instruction_without_source_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 0, 0, 0)

fn expected_end_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 2)

fn expected_blank_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 2)

fn expected_directive_blueprint_count(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return -1

        0:
            mut count: tryte = expected_s3asm_header_count(fixture)

            count = count + expected_function_header_count(fixture)
            count = count + expected_param_line_count(fixture)
            count = count + expected_register_line_count(fixture)
            count = count + expected_memory_line_count(fixture)
            count = count + expected_label_line_count(fixture)
            count = count + expected_end_line_count(fixture)

            return count

        1:
            return -1

fn modeled_blueprint_count(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return -1

        0:
            mut count: tryte = expected_directive_blueprint_count(fixture)

            count = count + expected_instruction_line_count(fixture)
            count = count + expected_blank_line_count(fixture)

            return count

        1:
            return -1

fn first_line_count() -> tryte:
    return expected_line_count(fixture_first())

fn simple_call_line_count() -> tryte:
    return expected_line_count(fixture_simple_call())

fn sign_line_count() -> tryte:
    return expected_line_count(fixture_sign())

fn first_blueprint_count() -> tryte:
    return expected_blueprint_count(fixture_first())

fn simple_call_blueprint_count() -> tryte:
    return expected_blueprint_count(fixture_simple_call())

fn sign_blueprint_count() -> tryte:
