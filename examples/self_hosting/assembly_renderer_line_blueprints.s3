fn total_instruction_blueprint_count() -> tryte:
    return total_instruction_line_count()

fn total_blank_blueprint_count() -> tryte:
    return total_blank_line_count()

fn validate_blueprint_ids() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(line_blueprint_kind_count(), 10))
    ok = all_passed(ok, is_known_blueprint(blueprint_s3asm_header()))
    ok = all_passed(ok, is_known_blueprint(blueprint_function_header()))
    ok = all_passed(ok, is_known_blueprint(blueprint_param()))
    ok = all_passed(ok, is_known_blueprint(blueprint_register()))
    ok = all_passed(ok, is_known_blueprint(blueprint_memory()))
    ok = all_passed(ok, is_known_blueprint(blueprint_label()))
    ok = all_passed(ok, is_known_blueprint(blueprint_instruction()))
    ok = all_passed(ok, is_known_blueprint(blueprint_instruction_with_source()))
    ok = all_passed(ok, is_known_blueprint(blueprint_end()))
    ok = all_passed(ok, is_known_blueprint(blueprint_blank_line()))
    ok = all_passed(ok, same_trit(is_known_blueprint(99), 0))
    ok = all_passed(ok, is_directive_blueprint(blueprint_s3asm_header()))
    ok = all_passed(ok, is_directive_blueprint(blueprint_function_header()))
    ok = all_passed(ok, is_directive_blueprint(blueprint_memory()))
    ok = all_passed(ok, is_directive_blueprint(blueprint_end()))
    ok = all_passed(ok, same_trit(is_directive_blueprint(blueprint_instruction()), 0))
    ok = all_passed(ok, same_trit(is_directive_blueprint(blueprint_instruction_with_source()), 0))
    ok = all_passed(ok, same_trit(is_directive_blueprint(blueprint_blank_line()), 0))
    ok = all_passed(ok, is_instruction_blueprint(blueprint_instruction()))
    ok = all_passed(ok, is_instruction_blueprint(blueprint_instruction_with_source()))
    ok = all_passed(ok, same_trit(is_instruction_blueprint(blueprint_label()), 0))
    ok = all_passed(ok, is_blank_blueprint(blueprint_blank_line()))
    ok = all_passed(ok, same_trit(is_blank_blueprint(blueprint_end()), 0))

    return ok

fn validate_fixture_line_blueprints(fixture: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            mut ok: trit = 1

            ok = all_passed(ok, same_tryte(expected_blueprint_count(fixture), modeled_blueprint_count(fixture)))
            ok = all_passed(ok, same_tryte(expected_blueprint_count(fixture), expected_line_count(fixture)))
            ok = all_passed(
                ok,
                same_tryte(
                    expected_instruction_line_count(fixture),
                    expected_instruction_with_source_line_count(fixture) + expected_instruction_without_source_line_count(fixture)
                )
            )
            ok = all_passed(ok, same_tryte(expected_instruction_without_source_line_count(fixture), 0))
            ok = all_passed(ok, same_tryte(expected_memory_line_count(fixture), 0))
            ok = all_passed(ok, same_tryte(expected_s3asm_header_count(fixture), 1))

            return ok

        1:
            return 0

fn validate_total_line_blueprints() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(total_line_count(), 75))
    ok = all_passed(ok, same_tryte(total_blueprint_count(), 75))
    ok = all_passed(ok, same_tryte(total_s3asm_header_count(), 3))
    ok = all_passed(ok, same_tryte(total_function_header_count(), 5))
    ok = all_passed(ok, same_tryte(total_param_line_count(), 3))
    ok = all_passed(ok, same_tryte(total_register_line_count(), 19))
    ok = all_passed(ok, same_tryte(total_memory_line_count(), 0))
    ok = all_passed(ok, same_tryte(total_label_line_count(), 8))
    ok = all_passed(ok, same_tryte(total_instruction_line_count(), 27))
    ok = all_passed(ok, same_tryte(total_instruction_with_source_line_count(), 27))
    ok = all_passed(ok, same_tryte(total_instruction_without_source_line_count(), 0))
    ok = all_passed(ok, same_tryte(total_end_line_count(), 5))
    ok = all_passed(ok, same_tryte(total_blank_line_count(), 5))
    ok = all_passed(ok, same_tryte(total_directive_blueprint_count(), 43))
    ok = all_passed(ok, same_tryte(total_instruction_blueprint_count(), 27))
    ok = all_passed(ok, same_tryte(total_blank_blueprint_count(), 5))

    return ok

fn validate_all_fixture_line_blueprints() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, validate_fixture_line_blueprints(fixture_first()))
    ok = all_passed(ok, validate_fixture_line_blueprints(fixture_simple_call()))
    ok = all_passed(ok, validate_fixture_line_blueprints(fixture_sign()))
    ok = all_passed(ok, same_trit(validate_fixture_line_blueprints(99), 0))
    ok = all_passed(ok, validate_blueprint_ids())
    ok = all_passed(ok, validate_total_line_blueprints())

    return ok

fn line_blueprints_first_probe() -> tryte:
    return status_from_check(validate_fixture_line_blueprints(fixture_first()), 1)

fn line_blueprints_simple_call_probe() -> tryte:
    return status_from_check(
        validate_fixture_line_blueprints(fixture_simple_call()),
        1
    )

fn line_blueprints_sign_probe() -> tryte:
    return status_from_check(validate_fixture_line_blueprints(fixture_sign()), 1)

fn line_blueprints_unknown_fixture_probe() -> tryte:
    return status_from_check(same_trit(validate_fixture_line_blueprints(99), 0), 1)

fn line_blueprints_known_blueprint_probe() -> tryte:
    return status_from_check(is_known_blueprint(blueprint_memory()), 1)

fn line_blueprints_unknown_blueprint_probe() -> tryte:
    return status_from_check(same_trit(is_known_blueprint(99), 0), 1)

fn line_blueprints_directive_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, is_directive_blueprint(blueprint_function_header()))
    ok = all_passed(ok, is_directive_blueprint(blueprint_end()))
    ok = all_passed(ok, same_trit(is_directive_blueprint(blueprint_instruction()), 0))

    return status_from_check(ok, 1)

fn line_blueprints_instruction_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, is_instruction_blueprint(blueprint_instruction()))
    ok = all_passed(ok, is_instruction_blueprint(blueprint_instruction_with_source()))
    ok = all_passed(ok, same_trit(is_instruction_blueprint(blueprint_blank_line()), 0))

    return status_from_check(ok, 1)

fn line_blueprints_blank_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, is_known_blueprint(blueprint_blank_line()))
    ok = all_passed(ok, is_blank_blueprint(blueprint_blank_line()))

    return status_from_check(ok, 1)

fn line_blueprints_totals_probe() -> tryte:
    return status_from_check(validate_total_line_blueprints(), 1)

fn line_blueprint_model_self_check() -> tryte:
    return status_from_check(validate_all_fixture_line_blueprints(), 1)

fn main() -> tryte:
    return line_blueprint_model_self_check()
