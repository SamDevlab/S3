fn pipeline_first_probe() -> tryte:
    return status_from_check(validate_fixture_pipeline(fixture_first()), 1)

fn pipeline_simple_call_probe() -> tryte:
    return status_from_check(validate_fixture_pipeline(fixture_simple_call()), 1)

