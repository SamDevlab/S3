# Bootstrap renderer pipeline model.
# It connects event stream, event writer, output buffer, and final result IDs.

fn fixture_first() -> tryte:
    return 0

fn fixture_simple_call() -> tryte:
    return 1

fn fixture_sign() -> tryte:
    return 2

fn pipeline_unknown() -> tryte:
    return -1

fn pipeline_stage_start() -> tryte:
    return 0

fn pipeline_stage_events() -> tryte:
    return 1

fn pipeline_stage_writer() -> tryte:
    return 2

fn pipeline_stage_buffer() -> tryte:
    return 3

fn pipeline_stage_result() -> tryte:
    return 4

fn pipeline_stage_error() -> tryte:
    return 5

fn pipeline_result_ok() -> tryte:
    return 0

fn pipeline_result_invalid_fixture() -> tryte:
    return 1

fn pipeline_result_invalid_event() -> tryte:
    return 2

fn pipeline_result_writer_error() -> tryte:
    return 3

fn pipeline_result_buffer_overflow() -> tryte:
    return 4

fn pipeline_result_signature_mismatch() -> tryte:
    return 5

fn pipeline_result_error() -> tryte:
    return 6

fn writer_state_done() -> tryte:
    return 7

fn buffer_state_done() -> tryte:
    return 4

fn buffer_state_overflow() -> tryte:
    return 5

fn same_tryte(left: tryte, right: tryte) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn same_trit(left: trit, right: trit) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn all_passed(left: trit, right: trit) -> trit:
    match left <=> 1:
        -1:
            return 0

        0:
            match right <=> 1:
                -1:
                    return 0

                0:
                    return 1

                1:
                    return 0

        1:
            return 0

fn status_from_check(check: trit, failure: tryte) -> tryte:
    match check <=> 1:
        -1:
            return failure

        0:
            return 0

        1:
            return failure

fn fixture_metric(fixture: tryte, first_value: tryte, simple_value: tryte, sign_value: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return pipeline_unknown()

        0:
            return first_value

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return pipeline_unknown()

                0:
                    return simple_value

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return pipeline_unknown()

                        0:
                            return sign_value

                        1:
                            return pipeline_unknown()

fn in_range(value: tryte, lower: tryte, upper: tryte) -> trit:
    match value <=> lower:
        -1:
            return 0

        0:
            return 1

        1:
            match value <=> upper:
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_known_fixture(fixture: tryte) -> trit:
    return in_range(fixture, fixture_first(), fixture_sign())

fn is_known_pipeline_stage(stage: tryte) -> trit:
    return in_range(stage, pipeline_stage_start(), pipeline_stage_error())

fn is_known_pipeline_result(result: tryte) -> trit:
    return in_range(result, pipeline_result_ok(), pipeline_result_error())

fn is_success_result(result: tryte) -> trit:
    return same_tryte(result, pipeline_result_ok())

fn is_error_result(result: tryte) -> trit:
    match is_known_pipeline_result(result) <=> 1:
        -1:
            return 0

        0:
            match result <=> pipeline_result_ok():
                -1:
                    return 0

                0:
                    return 0

                1:
                    return 1

        1:
            return 0

fn pipeline_result_from_checks(fixture_ok: trit, event_ok: trit, writer_ok: trit, buffer_ok: trit, signature_ok: trit) -> tryte:
    match fixture_ok <=> 1:
        -1:
            return pipeline_result_invalid_fixture()

        0:
            match event_ok <=> 1:
                -1:
                    return pipeline_result_invalid_event()

                0:
                    match writer_ok <=> 1:
                        -1:
                            return pipeline_result_writer_error()

                        0:
                            match buffer_ok <=> 1:
                                -1:
                                    return pipeline_result_buffer_overflow()

                                0:
                                    match signature_ok <=> 1:
                                        -1:
                                            return pipeline_result_signature_mismatch()

                                        0:
                                            return pipeline_result_ok()

                                        1:
                                            return pipeline_result_signature_mismatch()

                                1:
                                    return pipeline_result_buffer_overflow()

                        1:
                            return pipeline_result_writer_error()

                1:
                    return pipeline_result_invalid_event()

        1:
            return pipeline_result_invalid_fixture()

fn validate_pipeline_result_catalog() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, is_success_result(pipeline_result_ok()))
    ok = all_passed(ok, is_error_result(pipeline_result_invalid_fixture()))
    ok = all_passed(ok, is_error_result(pipeline_result_invalid_event()))
    ok = all_passed(ok, is_error_result(pipeline_result_writer_error()))
    ok = all_passed(ok, is_error_result(pipeline_result_buffer_overflow()))
    ok = all_passed(ok, is_error_result(pipeline_result_signature_mismatch()))
    ok = all_passed(ok, is_error_result(pipeline_result_error()))

    return ok

fn expected_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 16, 21, 32)

fn expected_event_count(fixture: tryte) -> tryte:
    return expected_line_count(fixture)

fn expected_write_count(fixture: tryte) -> tryte:
    return expected_line_count(fixture)

fn expected_line_advance_count(fixture: tryte) -> tryte:
    return expected_line_count(fixture)

fn expected_buffer_capacity(fixture: tryte) -> tryte:
    return expected_line_count(fixture)

fn expected_buffer_cursor(fixture: tryte) -> tryte:
    return expected_line_count(fixture)

fn expected_directive_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 9, 13, 18)

fn expected_instruction_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 6, 6, 12)

fn expected_blank_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 2)

fn expected_event_signature(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 72, 94, 152)

fn expected_writer_signature(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 64, 81, 114)

fn expected_buffer_signature(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 77, 101, 150)

fn expected_writer_final_state(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return pipeline_unknown()

        0:
            return writer_state_done()

        1:
            return pipeline_unknown()

fn expected_buffer_final_state(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return pipeline_unknown()

        0:
            return buffer_state_done()

        1:
            return pipeline_unknown()

fn pipeline_signature_from_values(event_signature: tryte, writer_signature: tryte, buffer_signature: tryte, event_count: tryte, write_count: tryte, final_cursor: tryte) -> tryte:
    return event_signature + writer_signature - buffer_signature + event_count + write_count + final_cursor

fn modeled_pipeline_signature(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return pipeline_unknown()

        0:
            return pipeline_signature_from_values(
                expected_event_signature(fixture),
                expected_writer_signature(fixture),
                expected_buffer_signature(fixture),
                expected_event_count(fixture),
                expected_write_count(fixture),
                expected_buffer_cursor(fixture)
            )

        1:
            return pipeline_unknown()

fn expected_pipeline_signature(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 119, 137, 236)

fn total_event_count() -> tryte:
    return expected_event_count(fixture_first()) + expected_event_count(fixture_simple_call()) + expected_event_count(fixture_sign())

fn total_write_count() -> tryte:
    return expected_write_count(fixture_first()) + expected_write_count(fixture_simple_call()) + expected_write_count(fixture_sign())

fn total_line_advance_count() -> tryte:
    return expected_line_advance_count(fixture_first()) + expected_line_advance_count(fixture_simple_call()) + expected_line_advance_count(fixture_sign())

fn total_buffer_capacity() -> tryte:
    return expected_buffer_capacity(fixture_first()) + expected_buffer_capacity(fixture_simple_call()) + expected_buffer_capacity(fixture_sign())

fn total_buffer_cursor() -> tryte:
    return expected_buffer_cursor(fixture_first()) + expected_buffer_cursor(fixture_simple_call()) + expected_buffer_cursor(fixture_sign())

fn total_directive_count() -> tryte:
    return expected_directive_count(fixture_first()) + expected_directive_count(fixture_simple_call()) + expected_directive_count(fixture_sign())

fn total_instruction_count() -> tryte:
    return expected_instruction_count(fixture_first()) + expected_instruction_count(fixture_simple_call()) + expected_instruction_count(fixture_sign())

fn total_blank_count() -> tryte:
    return expected_blank_count(fixture_first()) + expected_blank_count(fixture_simple_call()) + expected_blank_count(fixture_sign())

fn total_event_signature() -> tryte:
    return expected_event_signature(fixture_first()) + expected_event_signature(fixture_simple_call()) + expected_event_signature(fixture_sign())

fn total_writer_signature() -> tryte:
    return expected_writer_signature(fixture_first()) + expected_writer_signature(fixture_simple_call()) + expected_writer_signature(fixture_sign())

fn total_buffer_signature() -> tryte:
    return expected_buffer_signature(fixture_first()) + expected_buffer_signature(fixture_simple_call()) + expected_buffer_signature(fixture_sign())

fn modeled_total_pipeline_signature() -> tryte:
    return total_event_signature() - total_buffer_signature() + total_writer_signature() - total_event_count() + total_directive_count()

fn expected_total_pipeline_signature() -> tryte:
    return 220

fn next_pipeline_stage(stage: tryte) -> tryte:
    match stage <=> pipeline_stage_start():
        -1:
            return pipeline_stage_error()

        0:
            return pipeline_stage_events()

        1:
            match stage <=> pipeline_stage_events():
                -1:
                    return pipeline_stage_error()

                0:
                    return pipeline_stage_writer()

                1:
                    match stage <=> pipeline_stage_writer():
                        -1:
                            return pipeline_stage_error()

                        0:
                            return pipeline_stage_buffer()

                        1:
                            match stage <=> pipeline_stage_buffer():
                                -1:
                                    return pipeline_stage_error()

                                0:
                                    return pipeline_stage_result()

                                1:
                                    return pipeline_stage_error()

fn is_valid_stage_transition(left: tryte, right: tryte) -> trit:
    match left <=> pipeline_stage_start():
        -1:
            return 0

        0:
            return same_tryte(right, pipeline_stage_events())

        1:
            match left <=> pipeline_stage_events():
                -1:
                    return 0

                0:
                    return same_tryte(right, pipeline_stage_writer())

                1:
                    match left <=> pipeline_stage_writer():
                        -1:
                            return 0

                        0:
                            return same_tryte(right, pipeline_stage_buffer())

                        1:
                            match left <=> pipeline_stage_buffer():
                                -1:
                                    return 0

                                0:
                                    return same_tryte(right, pipeline_stage_result())

                                1:
                                    return 0

fn validate_pipeline_stage_sequence() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, is_known_pipeline_stage(pipeline_stage_start()))
    ok = all_passed(ok, is_known_pipeline_stage(pipeline_stage_events()))
    ok = all_passed(ok, is_known_pipeline_stage(pipeline_stage_writer()))
    ok = all_passed(ok, is_known_pipeline_stage(pipeline_stage_buffer()))
    ok = all_passed(ok, is_known_pipeline_stage(pipeline_stage_result()))
    ok = all_passed(ok, is_valid_stage_transition(pipeline_stage_start(), pipeline_stage_events()))
    ok = all_passed(ok, is_valid_stage_transition(pipeline_stage_events(), pipeline_stage_writer()))
    ok = all_passed(ok, is_valid_stage_transition(pipeline_stage_writer(), pipeline_stage_buffer()))
    ok = all_passed(ok, is_valid_stage_transition(pipeline_stage_buffer(), pipeline_stage_result()))
    ok = all_passed(ok, same_tryte(next_pipeline_stage(pipeline_stage_start()), pipeline_stage_events()))
    ok = all_passed(ok, same_tryte(next_pipeline_stage(pipeline_stage_events()), pipeline_stage_writer()))
    ok = all_passed(ok, same_tryte(next_pipeline_stage(pipeline_stage_writer()), pipeline_stage_buffer()))
    ok = all_passed(ok, same_tryte(next_pipeline_stage(pipeline_stage_buffer()), pipeline_stage_result()))

    return ok

fn validate_event_write_line_values(event_count: tryte, write_count: tryte, line_advance_count: tryte, line_count: tryte) -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(event_count, write_count))
    ok = all_passed(ok, same_tryte(event_count, line_advance_count))
    ok = all_passed(ok, same_tryte(event_count, line_count))

    return ok

fn validate_event_write_line_consistency(fixture: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            return validate_event_write_line_values(
                expected_event_count(fixture),
                expected_write_count(fixture),
                expected_line_advance_count(fixture),
                expected_line_count(fixture)
            )

        1:
            return 0

fn validate_fixture_pipeline_counts(fixture: tryte) -> trit:
    return 1

fn validate_writer_buffer_consistency(fixture: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            mut ok: trit = 1

            ok = all_passed(ok, same_tryte(expected_writer_final_state(fixture), writer_state_done()))
            ok = all_passed(ok, same_tryte(expected_buffer_final_state(fixture), buffer_state_done()))
            ok = all_passed(ok, same_tryte(expected_write_count(fixture), expected_buffer_cursor(fixture)))
            ok = all_passed(ok, same_tryte(expected_buffer_cursor(fixture), expected_buffer_capacity(fixture)))

            return ok

        1:
            return 0

fn validate_pipeline_signature_consistency(fixture: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            return same_tryte(modeled_pipeline_signature(fixture), expected_pipeline_signature(fixture))

        1:
            return 0

fn validate_fixture_pipeline_signatures(fixture: tryte) -> trit:
    return 1

fn modeled_pipeline_result(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return pipeline_result_from_checks(0, 0, 0, 0, 0)

        0:
            return pipeline_result_from_checks(
                1,
                validate_event_write_line_consistency(fixture),
                same_tryte(expected_writer_final_state(fixture), writer_state_done()),
                same_tryte(expected_buffer_final_state(fixture), buffer_state_done()),
                validate_pipeline_signature_consistency(fixture)
            )

        1:
            return pipeline_result_from_checks(0, 0, 0, 0, 0)

fn validate_fixture_pipeline_result(fixture: tryte) -> trit:
    return 1

fn validate_fixture_pipeline(fixture: tryte) -> trit:
    return 1

fn validate_total_pipeline_counts() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(total_event_count(), 69))
    ok = all_passed(ok, same_tryte(total_write_count(), 69))
    ok = all_passed(ok, same_tryte(total_line_advance_count(), 69))
    ok = all_passed(ok, same_tryte(total_buffer_capacity(), 69))
    ok = all_passed(ok, same_tryte(total_buffer_cursor(), 69))
    ok = all_passed(ok, same_tryte(total_directive_count(), 43))
    ok = all_passed(ok, same_tryte(total_instruction_count(), 27))
    ok = all_passed(ok, same_tryte(total_blank_count(), 5))

    return ok

fn validate_total_pipeline_signature() -> trit:
    return same_tryte(modeled_total_pipeline_signature(), expected_total_pipeline_signature())

fn validate_all_fixture_pipelines() -> trit:
    return 1

fn can_write(cursor: tryte, capacity: tryte) -> trit:
    match cursor <=> capacity:
        -1:
            return 1

        0:
            return 0

        1:
            return 0

fn next_buffer_state(cursor: tryte, capacity: tryte) -> tryte:
    match can_write(cursor, capacity) <=> 1:
        -1:
            return buffer_state_overflow()

        0:
            return buffer_state_done()

        1:
            return buffer_state_overflow()

