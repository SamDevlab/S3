fn sign_end_segment_count() -> tryte:
    return expected_end_segment_count(fixture_sign())

fn total_line_count() -> tryte:
    return (
        expected_line_count(fixture_first()) +
        expected_line_count(fixture_simple_call()) +
        expected_line_count(fixture_sign())
    )

fn total_segment_count() -> tryte:
    return first_segment_count() + simple_call_segment_count() + sign_segment_count()

fn total_directive_segment_count() -> tryte:
    return (
        first_directive_segment_count() +
        simple_call_directive_segment_count() +
        sign_directive_segment_count()
    )

fn total_instruction_segment_count() -> tryte:
    return (
        first_instruction_segment_count() +
        simple_call_instruction_segment_count() +
        sign_instruction_segment_count()
    )

fn total_label_segment_count() -> tryte:
    return (
        first_label_segment_count() +
        simple_call_label_segment_count() +
        sign_label_segment_count()
    )

fn total_blank_line_segment_count() -> tryte:
    return (
        first_blank_line_segment_count() +
        simple_call_blank_line_segment_count() +
        sign_blank_line_segment_count()
    )

fn total_source_segment_count() -> tryte:
    return (
        first_source_segment_count() +
        simple_call_source_segment_count() +
        sign_source_segment_count()
    )

fn total_end_segment_count() -> tryte:
    return (
        first_end_segment_count() +
        simple_call_end_segment_count() +
        sign_end_segment_count()
    )

fn total_line_kind_segment_count() -> tryte:
    return total_line_count()

fn validate_segment_ids() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(text_segment_kind_count(), 10))
    ok = all_passed(ok, is_known_segment(segment_s3asm()))
    ok = all_passed(ok, is_known_segment(segment_function()))
    ok = all_passed(ok, is_known_segment(segment_param()))
    ok = all_passed(ok, is_known_segment(segment_register()))
    ok = all_passed(ok, is_known_segment(segment_memory()))
    ok = all_passed(ok, is_known_segment(segment_label()))
    ok = all_passed(ok, is_known_segment(segment_instruction()))
    ok = all_passed(ok, is_known_segment(segment_end()))
    ok = all_passed(ok, is_known_segment(segment_blank_line()))
    ok = all_passed(ok, is_known_segment(segment_source_metadata()))
    ok = all_passed(ok, same_trit(is_known_segment(99), 0))
    ok = all_passed(ok, is_directive_segment(segment_s3asm()))
    ok = all_passed(ok, is_directive_segment(segment_function()))
    ok = all_passed(ok, is_directive_segment(segment_memory()))
    ok = all_passed(ok, is_directive_segment(segment_end()))
    ok = all_passed(ok, same_trit(is_directive_segment(segment_instruction()), 0))
    ok = all_passed(ok, same_trit(is_directive_segment(segment_blank_line()), 0))
    ok = all_passed(ok, is_render_line_segment(segment_instruction()))
    ok = all_passed(ok, is_render_line_segment(segment_blank_line()))
    ok = all_passed(ok, same_trit(is_render_line_segment(segment_source_metadata()), 0))
    ok = all_passed(ok, is_source_metadata_segment(segment_source_metadata()))

    return ok

fn validate_fixture_text_segments(fixture: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            mut ok: trit = 1

            ok = all_passed(ok, same_tryte(expected_segment_count(fixture), modeled_segment_count(fixture)))
            ok = all_passed(ok, same_tryte(expected_line_kind_segment_count(fixture), expected_line_count(fixture)))
            ok = all_passed(ok, same_tryte(expected_memory_segment_count(fixture), 0))
            ok = all_passed(ok, same_tryte(expected_source_segment_count(fixture), expected_instruction_segment_count(fixture)))
            ok = all_passed(ok, same_tryte(expected_s3asm_segment_count(fixture), 1))

            return ok

        1:
            return 0

fn validate_total_text_segments() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(total_line_count(), 75))
    ok = all_passed(ok, same_tryte(total_segment_count(), 102))
    ok = all_passed(ok, same_tryte(total_directive_segment_count(), 43))
    ok = all_passed(ok, same_tryte(total_instruction_segment_count(), 27))
    ok = all_passed(ok, same_tryte(total_label_segment_count(), 8))
    ok = all_passed(ok, same_tryte(total_blank_line_segment_count(), 5))
    ok = all_passed(ok, same_tryte(total_source_segment_count(), 27))
    ok = all_passed(ok, same_tryte(total_end_segment_count(), 5))
    ok = all_passed(ok, same_tryte(total_line_kind_segment_count(), 75))

    return ok

fn validate_all_fixture_text_segments() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, validate_fixture_text_segments(fixture_first()))
    ok = all_passed(ok, validate_fixture_text_segments(fixture_simple_call()))
    ok = all_passed(ok, validate_fixture_text_segments(fixture_sign()))
    ok = all_passed(ok, same_trit(validate_fixture_text_segments(99), 0))
    ok = all_passed(ok, validate_segment_ids())
    ok = all_passed(ok, validate_total_text_segments())

    return ok

fn text_segments_first_probe() -> tryte:
    return status_from_check(validate_fixture_text_segments(fixture_first()), 1)

fn text_segments_simple_call_probe() -> tryte:
    return status_from_check(
        validate_fixture_text_segments(fixture_simple_call()),
        1
    )

fn text_segments_sign_probe() -> tryte:
    return status_from_check(validate_fixture_text_segments(fixture_sign()), 1)

fn text_segments_unknown_fixture_probe() -> tryte:
    return status_from_check(same_trit(validate_fixture_text_segments(99), 0), 1)

fn text_segments_known_segment_probe() -> tryte:
    return status_from_check(is_known_segment(segment_memory()), 1)

fn text_segments_unknown_segment_probe() -> tryte:
    return status_from_check(same_trit(is_known_segment(99), 0), 1)

fn text_segments_directive_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, is_directive_segment(segment_function()))
    ok = all_passed(ok, same_trit(is_directive_segment(segment_instruction()), 0))

    return status_from_check(ok, 1)

fn text_segments_instruction_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, is_known_segment(segment_instruction()))
    ok = all_passed(ok, is_render_line_segment(segment_instruction()))

    return status_from_check(ok, 1)

fn text_segments_blank_line_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, is_known_segment(segment_blank_line()))
    ok = all_passed(ok, is_render_line_segment(segment_blank_line()))

    return status_from_check(ok, 1)

fn text_segments_totals_probe() -> tryte:
    return status_from_check(validate_total_text_segments(), 1)

fn text_segment_model_self_check() -> tryte:
    return status_from_check(validate_all_fixture_text_segments(), 1)

fn main() -> tryte:
    return text_segment_model_self_check()
