    return expected_register_segment_count(fixture_first())

fn simple_call_register_segment_count() -> tryte:
    return expected_register_segment_count(fixture_simple_call())

fn sign_register_segment_count() -> tryte:
    return expected_register_segment_count(fixture_sign())

