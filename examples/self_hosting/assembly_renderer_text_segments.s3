# Bootstrap text segment model for a future S3 Assembly renderer.
# It models renderer text pieces as numeric IDs without rendering text.

fn fixture_first() -> tryte:
    return 0

fn fixture_simple_call() -> tryte:
    return 1

fn fixture_sign() -> tryte:
    return 2

fn segment_s3asm() -> tryte:
    return 0

fn segment_function() -> tryte:
    return 1

fn segment_param() -> tryte:
    return 2

fn segment_register() -> tryte:
    return 3

fn segment_memory() -> tryte:
    return 4

fn segment_label() -> tryte:
    return 5

fn segment_end() -> tryte:
    return 6

fn segment_instruction() -> tryte:
    return 7

fn segment_blank_line() -> tryte:
    return 8

fn segment_source_metadata() -> tryte:
    return 9

fn text_segment_kind_count() -> tryte:
    return segment_source_metadata() + 1

fn same_tryte(left: tryte, right: tryte) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn same_trit(left: trit, right: trit) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn all_passed(left: trit, right: trit) -> trit:
    match left <=> 1:
        -1:
            return 0

        0:
            match right <=> 1:
                -1:
                    return 0

                0:
                    return 1

                1:
                    return 0

        1:
            return 0

fn status_from_check(check: trit, failure: tryte) -> tryte:
    match check <=> 1:
        -1:
            return failure

        0:
            return 0

        1:
            return failure

fn is_known_fixture(fixture: tryte) -> trit:
    match fixture <=> fixture_first():
        -1:
            return 0

        0:
            return 1

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return 0

                0:
                    return 1

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return 0

                        0:
                            return 1

                        1:
                            return 0

fn is_known_segment(segment: tryte) -> trit:
    match segment <=> segment_s3asm():
        -1:
            return 0

        0:
            return 1

        1:
            match segment <=> segment_source_metadata():
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_directive_segment(segment: tryte) -> trit:
    match segment <=> segment_s3asm():
        -1:
            return 0

        0:
            return 1

        1:
            match segment <=> segment_end():
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_render_line_segment(segment: tryte) -> trit:
    match segment <=> segment_s3asm():
        -1:
            return 0

        0:
            return 1

        1:
            match segment <=> segment_blank_line():
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_source_metadata_segment(segment: tryte) -> trit:
    return same_tryte(segment, segment_source_metadata())

fn expected_line_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 18

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 21

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 36

                        1:
                            return -1

fn expected_s3asm_segment_count(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return -1

        0:
            return 1

        1:
            return -1

fn expected_function_segment_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 1

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 2

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 2

                        1:
                            return -1

fn expected_param_segment_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 0

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 2

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 1

                        1:
                            return -1

fn expected_register_segment_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 6

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 4

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 9

                        1:
                            return -1

fn expected_memory_segment_count(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return -1

        0:
            return 0

        1:
            return -1

fn expected_label_segment_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 1

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 2

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 5

                        1:
                            return -1

fn expected_instruction_segment_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 7

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 6

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 14

                        1:
                            return -1

fn expected_blank_line_segment_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 1

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 2

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 2

                        1:
                            return -1

fn expected_source_segment_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 7

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 6

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 14

                        1:
                            return -1

fn expected_end_segment_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 1

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 2

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 2

                        1:
                            return -1

fn expected_directive_segment_count(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return -1

        0:
            mut count: tryte = expected_s3asm_segment_count(fixture)

            count = count + expected_function_segment_count(fixture)
            count = count + expected_param_segment_count(fixture)
            count = count + expected_register_segment_count(fixture)
            count = count + expected_memory_segment_count(fixture)
            count = count + expected_label_segment_count(fixture)
            count = count + expected_end_segment_count(fixture)

            return count

        1:
            return -1

fn expected_line_kind_segment_count(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return -1

        0:
            mut count: tryte = expected_directive_segment_count(fixture)

            count = count + expected_instruction_segment_count(fixture)
            count = count + expected_blank_line_segment_count(fixture)

            return count

        1:
            return -1

fn expected_segment_count(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return -1

        0:
            mut count: tryte = expected_line_kind_segment_count(fixture)

            count = count + expected_source_segment_count(fixture)

            return count

        1:
            return -1

fn modeled_segment_count(fixture: tryte) -> tryte:
    return expected_segment_count(fixture)

fn first_line_count() -> tryte:
    return expected_line_count(fixture_first())

fn simple_call_line_count() -> tryte:
    return expected_line_count(fixture_simple_call())

fn sign_line_count() -> tryte:
    return expected_line_count(fixture_sign())

fn first_segment_count() -> tryte:
    return expected_segment_count(fixture_first())

fn simple_call_segment_count() -> tryte:
    return expected_segment_count(fixture_simple_call())

fn sign_segment_count() -> tryte:
    return expected_segment_count(fixture_sign())

fn first_directive_segment_count() -> tryte:
    return expected_directive_segment_count(fixture_first())

fn simple_call_directive_segment_count() -> tryte:
    return expected_directive_segment_count(fixture_simple_call())

fn sign_directive_segment_count() -> tryte:
    return expected_directive_segment_count(fixture_sign())

fn first_function_segment_count() -> tryte:
    return expected_function_segment_count(fixture_first())

fn simple_call_function_segment_count() -> tryte:
    return expected_function_segment_count(fixture_simple_call())

fn sign_function_segment_count() -> tryte:
    return expected_function_segment_count(fixture_sign())

