    return expected_param_segment_count(fixture_first())

fn simple_call_param_segment_count() -> tryte:
    return expected_param_segment_count(fixture_simple_call())

fn sign_param_segment_count() -> tryte:
    return expected_param_segment_count(fixture_sign())

