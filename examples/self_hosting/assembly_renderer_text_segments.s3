    return expected_memory_segment_count(fixture_first())

fn simple_call_memory_segment_count() -> tryte:
    return expected_memory_segment_count(fixture_simple_call())

fn sign_memory_segment_count() -> tryte:
    return expected_memory_segment_count(fixture_sign())

fn first_label_segment_count() -> tryte:
    return expected_label_segment_count(fixture_first())

fn simple_call_label_segment_count() -> tryte:
    return expected_label_segment_count(fixture_simple_call())

fn sign_label_segment_count() -> tryte:
    return expected_label_segment_count(fixture_sign())

fn first_instruction_segment_count() -> tryte:
    return expected_instruction_segment_count(fixture_first())

fn simple_call_instruction_segment_count() -> tryte:
    return expected_instruction_segment_count(fixture_simple_call())

fn sign_instruction_segment_count() -> tryte:
    return expected_instruction_segment_count(fixture_sign())

fn first_blank_line_segment_count() -> tryte:
    return expected_blank_line_segment_count(fixture_first())

fn simple_call_blank_line_segment_count() -> tryte:
    return expected_blank_line_segment_count(fixture_simple_call())

fn sign_blank_line_segment_count() -> tryte:
    return expected_blank_line_segment_count(fixture_sign())

fn first_source_segment_count() -> tryte:
    return expected_source_segment_count(fixture_first())

fn simple_call_source_segment_count() -> tryte:
    return expected_source_segment_count(fixture_simple_call())

fn sign_source_segment_count() -> tryte:
    return expected_source_segment_count(fixture_sign())

fn first_end_segment_count() -> tryte:
