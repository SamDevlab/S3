                            return fragment_command_unknown()

                        0:
                            return fragment_command_blank_line()

                        1:
                            match index <=> 3:
                                -1:
                                    return fragment_command_unknown()

                                0:
                                    return fragment_command_function_line()

                                1:
                                    return expected_simple_call_fragment_command_body_at(index)

fn expected_simple_call_fragment_command_body_at(index: tryte) -> tryte:
    match in_range(index, 4, 5) <=> 1:
        -1:
            match index <=> 6:
                -1:
                    return fragment_command_unknown()

                0:
                    return fragment_command_register_line()

