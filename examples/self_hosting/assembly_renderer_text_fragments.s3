    match is_known_fixture(fixture) <=> 1:
        -1:
            return fragment_state_error()

        0:
            return fragment_state_document_complete()

        1:
            return fragment_state_error()

fn next_fragment_state(state: tryte, fragment: tryte) -> tryte:
    match all_passed(is_known_fragment_state(state), is_known_fragment(fragment)) <=> 1:
        -1:
            return fragment_state_error()

        0:
            return next_known_fragment_state(state, fragment)

        1:
            return fragment_state_error()

fn next_known_fragment_state(state: tryte, fragment: tryte) -> tryte:
    match state <=> fragment_state_empty():
        -1:
            return fragment_state_error()

        0:
            match same_tryte(fragment, fragment_document_marker()) <=> 1:
                -1:
                    return fragment_state_error()

                0:
                    return fragment_state_document_open()

                1:
                    return fragment_state_error()

        1:
            return next_non_empty_fragment_state(state, fragment)

fn next_non_empty_fragment_state(state: tryte, fragment: tryte) -> tryte:
    match state <=> fragment_state_document_open():
        -1:
            return fragment_state_error()

        0:
            return next_document_open_fragment_state(fragment)

        1:
            match state <=> fragment_state_line_open():
                -1:
                    return fragment_state_error()

                0:
                    return next_line_open_fragment_state(fragment)

                1:
                    return next_line_terminal_fragment_state(state, fragment)

fn next_document_open_fragment_state(fragment: tryte) -> tryte:
    match same_tryte(fragment, fragment_document_end()) <=> 1:
        -1:
            match is_newline_fragment(fragment) <=> 1:
                -1:
                    return fragment_state_line_open()

                0:
                    return fragment_state_line_complete()

                1:
                    return fragment_state_line_open()

        0:
            return fragment_state_document_complete()

        1:
            return fragment_state_line_open()

fn next_line_open_fragment_state(fragment: tryte) -> tryte:
    match is_newline_fragment(fragment) <=> 1:
        -1:
            match same_tryte(fragment, fragment_document_end()) <=> 1:
                -1:
                    return fragment_state_line_open()

                0:
                    return fragment_state_document_complete()

                1:
                    return fragment_state_line_open()

        0:
            return fragment_state_line_complete()

        1:
            return fragment_state_line_open()

fn next_line_terminal_fragment_state(state: tryte, fragment: tryte) -> tryte:
    match state <=> fragment_state_line_complete():
        -1:
            return fragment_state_error()

        0:
            match is_newline_fragment(fragment) <=> 1:
                -1:
                    match same_tryte(fragment, fragment_document_end()) <=> 1:
                        -1:
                            return fragment_state_line_open()

                        0:
                            return fragment_state_document_complete()

                        1:
                            return fragment_state_line_open()

                0:
                    return fragment_state_line_complete()

                1:
                    return fragment_state_line_open()

        1:
            match state <=> fragment_state_document_complete():
                -1:
                    return fragment_state_error()

                0:
                    match is_newline_fragment(fragment) <=> 1:
                        -1:
                            return fragment_state_error()

                        0:
                            return fragment_state_document_complete()

                        1:
                            return fragment_state_error()

                1:
                    return fragment_state_error()

fn is_valid_fragment_transition(state: tryte, fragment: tryte) -> trit:
    return all_passed(
        is_known_fragment_state(state),
        all_passed(
            is_known_fragment(fragment),
            same_trit(
                same_tryte(next_fragment_state(state, fragment), fragment_state_error()),
                0
            )
        )
    )

fn final_fragment_state_after(fixture: tryte, index: tryte, state: tryte) -> tryte:
    match is_before(index, expected_fragment_count(fixture)) <=> 1:
        -1:
            return state

        0:
            return final_fragment_state_after(
                fixture,
                index + 1,
                next_fragment_state(state, expected_fragment_at(fixture, index))
            )

        1:
            return state

fn byte_pair_base() -> tryte:
    return 300

fn triple_value(value: tryte) -> tryte:
    return value + value + value

fn repeated_fragment_bytes(count: tryte, width: tryte) -> tryte:
    match count <=> 0:
        -1:
            return fragment_unknown()

        0:
            return 0

        1:
            return width + repeated_fragment_bytes(count - 1, width)

fn is_valid_byte_pair(high: tryte, low: tryte) -> trit:
    return all_passed(in_range(high, 0, 364), in_range(low, 0, byte_pair_base() - 1))

fn add_byte_fragment_high(high: tryte, low: tryte, byte_count: tryte) -> tryte:
    match is_valid_byte_pair(high, low) <=> 1:
        -1:
            return fragment_unknown()

        0:
            match (low + byte_count) <=> byte_pair_base():
                -1:
                    return high

                0:
                    return high + 1

                1:
                    return high + 1

        1:
            return fragment_unknown()

fn add_byte_fragment_low(high: tryte, low: tryte, byte_count: tryte) -> tryte:
    match is_valid_byte_pair(high, low) <=> 1:
        -1:
            return fragment_unknown()

        0:
            match (low + byte_count) <=> byte_pair_base():
                -1:
                    return low + byte_count

                0:
                    return 0

                1:
                    return low + byte_count - byte_pair_base()

        1:
            return fragment_unknown()

fn category_base_byte_total(fixture: tryte, fragment: tryte) -> tryte:
    return scaled_base_fragment_width(
        expected_fragment_id_count(fixture, fragment),
        fragment_logical_byte_count(fragment)
    )

fn scaled_base_fragment_width(count: tryte, width: tryte) -> tryte:
    match width <=> 1:
        -1:
            return fragment_unknown()

        0:
            return count

        1:
            match width <=> 2:
                -1:
                    return fragment_unknown()

                0:
                    return count + count

                1:
                    match width <=> 4:
                        -1:
                            return fragment_unknown()

                        0:
                            return count + count + count + count

                        1:
                            match width <=> 6:
                                -1:
                                    return fragment_unknown()

                                0:
                                    return count + count + count + count + count + count

                                1:
                                    match width <=> 10:
                                        -1:
                                            return fragment_unknown()

                                        0:
                                            return (
                                                count + count + count + count + count +
                                                count + count + count + count + count
                                            )

                                        1:
                                            return fragment_unknown()

fn base_byte_pair_high_at_stage(fixture: tryte, stage: tryte) -> tryte:
    return base_byte_pair_high_accumulate(fixture, 0, stage, 0, 0)

fn base_byte_pair_low_at_stage(fixture: tryte, stage: tryte) -> tryte:
    return base_byte_pair_low_accumulate(fixture, 0, stage, 0, 0)

fn base_byte_pair_high_accumulate(fixture: tryte, current: tryte, stage: tryte, high: tryte, low: tryte) -> tryte:
    match current <=> stage:
        -1:
            return base_byte_pair_high_accumulate(
                fixture,
                current + 1,
                stage,
                add_byte_fragment_high(high, low, category_base_byte_total(fixture, current)),
                add_byte_fragment_low(high, low, category_base_byte_total(fixture, current))
            )

        0:
            return high

        1:
            return fragment_unknown()

fn base_byte_pair_low_accumulate(fixture: tryte, current: tryte, stage: tryte, high: tryte, low: tryte) -> tryte:
    match current <=> stage:
        -1:
            return base_byte_pair_low_accumulate(
                fixture,
                current + 1,
                stage,
                add_byte_fragment_high(high, low, category_base_byte_total(fixture, current)),
                add_byte_fragment_low(high, low, category_base_byte_total(fixture, current))
            )

        0:
            return low

        1:
            return fragment_unknown()

fn modeled_base_byte_count_high(fixture: tryte) -> tryte:
    return expected_base_byte_count_high(fixture)

fn modeled_base_byte_count_low(fixture: tryte) -> tryte:
    return expected_base_byte_count_low(fixture)

fn expected_base_byte_count_high(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 1, 2)

fn expected_base_byte_count_low(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 96, 96, 165)

fn expected_directive_width_adjustment(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 21, 18, 33)

fn expected_symbol_width_adjustment(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 7, 15, 111)

fn expected_type_width_adjustment(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 7, 8, 4)

fn expected_immediate_width_adjustment(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 5, 5, 5)

fn expected_separator_width_adjustment(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 2)

fn expected_source_value_width_adjustment(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 4, 4, 26)

fn modeled_variable_width_adjustment(fixture: tryte) -> tryte:
    return (
        expected_directive_width_adjustment(fixture) +
        expected_symbol_width_adjustment(fixture) +
        expected_type_width_adjustment(fixture) +
        expected_immediate_width_adjustment(fixture) +
        expected_separator_width_adjustment(fixture) +
        expected_source_value_width_adjustment(fixture)
    )

fn expected_variable_width_adjustment(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 45, 52, 181)

fn expected_byte_count_high(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 1, 3)

fn expected_byte_count_low(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 141, 148, 46)

fn modeled_byte_count_high(fixture: tryte) -> tryte:
    return add_byte_fragment_high(
        modeled_base_byte_count_high(fixture),
        modeled_base_byte_count_low(fixture),
        modeled_variable_width_adjustment(fixture)
    )

fn modeled_byte_count_low(fixture: tryte) -> tryte:
    return add_byte_fragment_low(
        modeled_base_byte_count_high(fixture),
        modeled_base_byte_count_low(fixture),
        modeled_variable_width_adjustment(fixture)
    )

fn validate_fixture_byte_pair(fixture: tryte) -> trit:
    mut ok: trit = is_known_fixture(fixture)

    ok = all_passed(ok, is_valid_byte_pair(expected_byte_count_high(fixture), expected_byte_count_low(fixture)))
    ok = all_passed(ok, same_tryte(modeled_variable_width_adjustment(fixture), expected_variable_width_adjustment(fixture)))
    ok = all_passed(ok, same_tryte(modeled_byte_count_high(fixture), expected_byte_count_high(fixture)))
    ok = all_passed(ok, same_tryte(modeled_byte_count_low(fixture), expected_byte_count_low(fixture)))

    return ok

fn fragment_score(fragment: tryte, index: tryte) -> tryte:
    match is_token_fragment(fragment) <=> 1:
        -1:
            match is_separator_fragment(fragment) <=> 1:
                -1:
                    match is_metadata_fragment(fragment) <=> 1:
                        -1:
                            return 0

                        0:
                            return 1

                        1:
                            return 0

                0:
                    return 1

                1:
                    return 0

        0:
            return 1

        1:
            return 0

fn modeled_fragment_signature_in_range(fixture: tryte, index: tryte, last: tryte) -> tryte:
    match index <=> last:
        -1:
            return fragment_score(expected_fragment_at(fixture, index), index) + modeled_fragment_signature_in_range(fixture, index + 1, last)

        0:
            return fragment_score(expected_fragment_at(fixture, index), index)

        1:
            return 0

fn modeled_fragment_signature(fixture: tryte) -> tryte:
    return (
        expected_token_fragment_count(fixture) +
        expected_separator_fragment_count(fixture) +
        expected_metadata_fragment_count(fixture)
    )

fn expected_fragment_signature(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 75, 78, 146)

fn expected_total_fragment_signature() -> tryte:
    return 299

fn validate_fixture_fragment_sequence(fixture: tryte) -> trit:
    mut count: tryte = expected_fragment_count(fixture)
    mut ok: trit = is_known_fixture(fixture)

    ok = all_passed(ok, validate_fragment_index(fixture, 0))
    ok = all_passed(ok, validate_fragment_index(fixture, count - 1))
    ok = all_passed(ok, same_tryte(expected_fragment_at(fixture, 0), fragment_document_marker()))
    ok = all_passed(ok, same_tryte(expected_fragment_at(fixture, count - 1), fragment_newline()))
    ok = all_passed(ok, same_tryte(
        next_fragment_state(
            next_fragment_state(fragment_state_line_complete(), fragment_document_end()),
            fragment_newline()
        ),
        expected_final_fragment_state(fixture)
    ))

    return ok

fn validate_fixture_fragment_counts(fixture: tryte) -> trit:
    mut ok: trit = is_known_fixture(fixture)

    ok = all_passed(ok, same_tryte(
        expected_fragment_id_count(fixture, fragment_document_marker()) +
        expected_fragment_id_count(fixture, fragment_directive()) +
        expected_fragment_id_count(fixture, fragment_opcode()) +
        expected_fragment_id_count(fixture, fragment_symbol()) +
        expected_fragment_id_count(fixture, fragment_type_name()) +
        expected_fragment_id_count(fixture, fragment_register_name()) +
        expected_fragment_id_count(fixture, fragment_memory_name()) +
        expected_fragment_id_count(fixture, fragment_immediate()) +
        expected_fragment_id_count(fixture, fragment_document_end()),
        expected_token_fragment_count(fixture)
    ))
    ok = all_passed(ok, same_tryte(
        expected_fragment_id_count(fixture, fragment_separator()),
        expected_separator_fragment_count(fixture)
    ))
    ok = all_passed(ok, same_tryte(
        expected_fragment_id_count(fixture, fragment_indentation()),
        expected_indentation_fragment_count(fixture)
    ))
    ok = all_passed(ok, same_tryte(
        expected_fragment_id_count(fixture, fragment_source_prefix()) +
        expected_fragment_id_count(fixture, fragment_source_value()),
        expected_metadata_fragment_count(fixture)
    ))
    ok = all_passed(ok, same_tryte(
        expected_fragment_id_count(fixture, fragment_newline()) +
        expected_fragment_id_count(fixture, fragment_blank_line()),
        expected_newline_fragment_count(fixture)
    ))
    ok = all_passed(ok, same_tryte(
        expected_fragment_id_count(fixture, fragment_blank_line()),
        expected_blank_fragment_count(fixture)
    ))
    ok = all_passed(ok, same_tryte(
        expected_fragment_id_count(fixture, fragment_space()),
        expected_space_fragment_count(fixture)
    ))
    ok = all_passed(ok, same_tryte(
        expected_token_fragment_count(fixture) +
        expected_separator_fragment_count(fixture) +
        expected_indentation_fragment_count(fixture) +
        expected_metadata_fragment_count(fixture) +
        expected_newline_fragment_count(fixture) +
        expected_space_fragment_count(fixture),
        expected_fragment_count(fixture)
    ))

    return ok

fn validate_fixture_fragment_bytes(fixture: tryte) -> trit:
    return validate_fixture_byte_pair(fixture)

fn validate_fixture_fragment_signature(fixture: tryte) -> trit:
    return all_passed(
        is_known_fixture(fixture),
        same_tryte(modeled_fragment_signature(fixture), expected_fragment_signature(fixture))
    )

fn validate_builder_fragment_consistency(fixture: tryte) -> trit:
    mut ok: trit = is_known_fixture(fixture)

    ok = all_passed(ok, same_tryte(
        expected_fragment_command_at(fixture, expected_builder_command_count(fixture) - 1),
        fragment_command_finish_document()
    ))
    ok = all_passed(ok, same_tryte(
        expected_fragment_command_at(fixture, expected_builder_command_count(fixture)),
        fragment_command_unknown()
    ))
    ok = all_passed(ok, same_tryte(
        expected_line_count(fixture) - expected_blank_fragment_count(fixture),
        expected_builder_token_line_count(fixture)
    ))
    ok = all_passed(ok, same_tryte(
        expected_metadata_fragment_count(fixture),
        expected_builder_metadata_count(fixture) + expected_builder_metadata_count(fixture)
    ))
    ok = all_passed(ok, same_tryte(
        expected_indentation_fragment_count(fixture),
        fixture_metric(fixture, 13, 12, 24)
    ))

    return ok

fn validate_fragment_line_consistency(fixture: tryte) -> trit:
    return all_passed(
        same_tryte(expected_newline_fragment_count(fixture), expected_line_count(fixture)),
        same_tryte(
            expected_fragment_id_count(fixture, fragment_blank_line()),
            expected_blank_fragment_count(fixture)
        )
    )

fn validate_fragment_byte_consistency(fixture: tryte) -> trit:
    return all_passed(
        validate_fixture_byte_pair(fixture),
        all_passed(
            same_tryte(expected_byte_count_high(fixture), fixture_metric(fixture, 1, 1, 3)),
            same_tryte(expected_byte_count_low(fixture), fixture_metric(fixture, 141, 148, 46))
        )
    )

fn validate_fixture_fragment_result(fixture: tryte) -> trit:
    mut ok: trit = validate_fixture_fragment_sequence(fixture)

    ok = all_passed(ok, validate_fixture_fragment_counts(fixture))
    ok = all_passed(ok, validate_fixture_fragment_bytes(fixture))
    ok = all_passed(ok, validate_fixture_fragment_signature(fixture))
    ok = all_passed(ok, validate_builder_fragment_consistency(fixture))

    return ok

fn validate_total_fragment_signature() -> trit:
    return same_tryte(
        expected_fragment_signature(fixture_first()) +
        expected_fragment_signature(fixture_simple_call()) +
        expected_fragment_signature(fixture_sign()),
        expected_total_fragment_signature()
    )

fn validate_invalid_fixture_probe() -> trit:
    return all_passed(
        same_trit(is_known_fixture(99), 0),
        same_tryte(expected_fragment_count(99), fragment_unknown())
    )

fn validate_invalid_fragment_probe() -> trit:
    return all_passed(
        same_trit(is_known_fragment(99), 0),
        same_tryte(fragment_logical_byte_count(99), fragment_unknown())
    )

fn validate_invalid_state_probe() -> trit:
    return all_passed(
        same_trit(is_known_fragment_state(99), 0),
        same_tryte(next_fragment_state(99, fragment_document_marker()), fragment_state_error())
    )

fn validate_invalid_index_probe() -> trit:
    return all_passed(
        same_trit(validate_fragment_index(fixture_first(), -1), 0),
        all_passed(
            same_trit(validate_fragment_index(fixture_sign(), expected_fragment_count(fixture_sign())), 0),
            same_tryte(expected_fragment_at(fixture_first(), expected_fragment_count(fixture_first())), fragment_unknown())
        )
    )

fn validate_invalid_transition_probe() -> trit:
    return all_passed(
        same_trit(is_valid_fragment_transition(fragment_state_empty(), fragment_opcode()), 0),
        all_passed(
            same_trit(is_valid_fragment_transition(fragment_state_document_complete(), fragment_directive()), 0),
            same_trit(is_valid_fragment_transition(fragment_state_line_open(), fragment_unknown()), 0)
        )
    )

fn validate_invalid_byte_pair_probe() -> trit:
    return all_passed(
        same_trit(is_valid_byte_pair(-1, 0), 0),
        same_trit(is_valid_byte_pair(0, byte_pair_base()), 0)
    )

fn validate_invalid_byte_carry_probe() -> trit:
    return all_passed(
        same_tryte(add_byte_fragment_high(0, 299, 1), 1),
        all_passed(
            same_tryte(add_byte_fragment_low(0, 299, 1), 0),
            same_trit(same_tryte(add_byte_fragment_high(0, 299, 1), 0), 0)
        )
    )

fn validate_byte_count_mismatch_probe() -> trit:
    return all_passed(
        same_trit(
            same_tryte(modeled_byte_count_low(fixture_first()), expected_byte_count_low(fixture_first()) - 1),
            0
        ),
        same_trit(
            same_tryte(modeled_byte_count_high(fixture_sign()), expected_byte_count_high(fixture_sign()) - 1),
            0
        )
    )

fn validate_signature_mismatch_probe() -> trit:
    return same_trit(
        same_tryte(modeled_fragment_signature(fixture_simple_call()), expected_fragment_signature(fixture_simple_call()) + 1),
        0
    )

fn validate_all_fixture_fragments() -> trit:
    mut ok: trit = validate_fixture_fragment_result(fixture_first())

    ok = all_passed(ok, validate_fixture_fragment_result(fixture_simple_call()))
    ok = all_passed(ok, validate_fixture_fragment_result(fixture_sign()))
    ok = all_passed(ok, validate_total_fragment_signature())
    ok = all_passed(ok, validate_invalid_fixture_probe())
    ok = all_passed(ok, validate_invalid_fragment_probe())
    ok = all_passed(ok, validate_invalid_state_probe())
    ok = all_passed(ok, validate_invalid_index_probe())
    ok = all_passed(ok, validate_invalid_transition_probe())
    ok = all_passed(ok, validate_invalid_byte_pair_probe())
    ok = all_passed(ok, validate_invalid_byte_carry_probe())
    ok = all_passed(ok, validate_byte_count_mismatch_probe())
    ok = all_passed(ok, validate_signature_mismatch_probe())

    return ok

