fn expected_fragment_command_at(fixture: tryte, index: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return fragment_command_unknown()

        0:
            return expected_first_fragment_command_at(index)

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return fragment_command_unknown()

                0:
                    return expected_simple_call_fragment_command_at(index)

                1:
