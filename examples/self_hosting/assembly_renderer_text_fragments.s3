                        0:
                            return fragment_command_label_line()

                        1:
                            return expected_simple_call_fragment_command_tail_at(index)

        0:
            return fragment_command_param_line()

        1:
            return fragment_command_unknown()

fn expected_simple_call_fragment_command_tail_at(index: tryte) -> tryte:
    match in_range(index, 8, 11) <=> 1:
        -1:
            match index <=> 12:
                -1:
                    return fragment_command_unknown()

                0:
                    return fragment_command_end_line()

                1:
                    match index <=> 13:
