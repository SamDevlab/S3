    return base_byte_pair_high_at_stage(fixture_sign(), 16)

fn sign_accumulated_base_byte_count_low() -> tryte:
    return base_byte_pair_low_at_stage(fixture_sign(), 16)

fn text_fragment_model_self_check() -> tryte:
    return status_from_check(validate_all_fixture_fragments(), 1)

fn main() -> tryte:
    return text_fragment_model_self_check()
