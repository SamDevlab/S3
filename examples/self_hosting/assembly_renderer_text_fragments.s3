# Static text fragment model for the future Assembly renderer.
# Fragment ids describe syntax only; no source text is stored in this program.
# Base widths are accumulated as base-300 high/low pairs.  Variable-width
# text (symbols, directives, types, immediates, separators, and source values)
# is represented by fixture-derived numeric adjustments.

fn fixture_first() -> tryte:
    return 0

fn fixture_simple_call() -> tryte:
    return 1

fn fixture_sign() -> tryte:
    return 2

fn fragment_unknown() -> tryte:
    return -1

fn fragment_document_marker() -> tryte:
    return 0

fn fragment_directive() -> tryte:
    return 1

fn fragment_opcode() -> tryte:
    return 2

fn fragment_symbol() -> tryte:
    return 3

fn fragment_type_name() -> tryte:
    return 4

fn fragment_register_name() -> tryte:
    return 5

fn fragment_memory_name() -> tryte:
    return 6

fn fragment_immediate() -> tryte:
    return 7

fn fragment_separator() -> tryte:
    return 8

fn fragment_space() -> tryte:
    return 9

fn fragment_indentation() -> tryte:
    return 10

fn fragment_source_prefix() -> tryte:
    return 11

fn fragment_source_value() -> tryte:
    return 12

fn fragment_newline() -> tryte:
    return 13

fn fragment_blank_line() -> tryte:
    return 14

fn fragment_document_end() -> tryte:
    return 15

fn fragment_state_error() -> tryte:
    return -1

fn fragment_state_empty() -> tryte:
    return 0

fn fragment_state_document_open() -> tryte:
    return 1

fn fragment_state_line_open() -> tryte:
    return 2

fn fragment_state_line_complete() -> tryte:
    return 3

fn fragment_state_document_complete() -> tryte:
    return 4

fn fragment_command_unknown() -> tryte:
    return -1

fn fragment_command_start_document() -> tryte:
    return 0

fn fragment_command_header_line() -> tryte:
    return 1

fn fragment_command_function_line() -> tryte:
    return 2

fn fragment_command_param_line() -> tryte:
    return 3

fn fragment_command_register_line() -> tryte:
    return 4

fn fragment_command_memory_line() -> tryte:
    return 5

fn fragment_command_label_line() -> tryte:
    return 6

fn fragment_command_instruction_line() -> tryte:
    return 7

fn fragment_command_source_metadata() -> tryte:
    return 8

fn fragment_command_end_line() -> tryte:
    return 9

fn fragment_command_blank_line() -> tryte:
    return 10

fn fragment_command_finish_document() -> tryte:
    return 11

fn same_tryte(left: tryte, right: tryte) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn same_trit(left: trit, right: trit) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn all_passed(left: trit, right: trit) -> trit:
    match left <=> 1:
        -1:
            return 0

        0:
            match right <=> 1:
                -1:
                    return 0

                0:
                    return 1

                1:
                    return 0

        1:
            return 0

fn any_passed(left: trit, right: trit) -> trit:
    match left <=> 1:
        -1:
            return right

        0:
            return 1

        1:
            return 1

fn status_from_check(check: trit, failure: tryte) -> tryte:
    match check <=> 1:
        -1:
            return failure

        0:
            return 0

        1:
            return failure

fn tryte_from_check(check: trit) -> tryte:
    match check <=> 1:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn in_range(value: tryte, lower: tryte, upper: tryte) -> trit:
    match value <=> lower:
        -1:
            return 0

        0:
            return 1

        1:
            match value <=> upper:
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_before(value: tryte, boundary: tryte) -> trit:
    match value <=> boundary:
        -1:
            return 1

        0:
            return 0

        1:
            return 0

fn fixture_metric(fixture: tryte, first_value: tryte, simple_value: tryte, sign_value: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return fragment_unknown()

        0:
            return first_value

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return fragment_unknown()

                0:
                    return simple_value

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return fragment_unknown()

                        0:
                            return sign_value

                        1:
                            return fragment_unknown()

fn is_even(value: tryte) -> trit:
    match value <=> 0:
        -1:
            return 0

        0:
            return 1

        1:
            return is_odd(value - 1)

fn is_odd(value: tryte) -> trit:
    match value <=> 0:
        -1:
            return 0

        0:
            return 0

        1:
            return is_even(value - 1)

fn paired_command_at(index: tryte, start: tryte) -> tryte:
    match is_even(index - start) <=> 1:
        -1:
            return fragment_command_source_metadata()

        0:
            return fragment_command_instruction_line()

        1:
            return fragment_command_source_metadata()

fn is_known_fixture(fixture: tryte) -> trit:
    return in_range(fixture, fixture_first(), fixture_sign())

fn is_known_fragment(fragment: tryte) -> trit:
    return in_range(fragment, fragment_document_marker(), fragment_document_end())

fn is_known_fragment_state(state: tryte) -> trit:
    return in_range(state, fragment_state_empty(), fragment_state_document_complete())

fn is_known_fragment_command(command: tryte) -> trit:
    return in_range(command, fragment_command_start_document(), fragment_command_finish_document())

fn is_token_fragment(fragment: tryte) -> trit:
    match in_range(fragment, fragment_document_marker(), fragment_immediate()) <=> 1:
        -1:
            return same_tryte(fragment, fragment_document_end())

        0:
            return 1

        1:
            return same_tryte(fragment, fragment_document_end())

fn is_separator_fragment(fragment: tryte) -> trit:
    return same_tryte(fragment, fragment_separator())

fn is_indentation_fragment(fragment: tryte) -> trit:
    return same_tryte(fragment, fragment_indentation())

fn is_metadata_fragment(fragment: tryte) -> trit:
    return in_range(fragment, fragment_source_prefix(), fragment_source_value())

fn is_newline_fragment(fragment: tryte) -> trit:
    return in_range(fragment, fragment_newline(), fragment_blank_line())

fn is_space_fragment(fragment: tryte) -> trit:
    return same_tryte(fragment, fragment_space())

fn is_line_content_fragment(fragment: tryte) -> trit:
    match is_known_fragment(fragment) <=> 1:
        -1:
            return 0

        0:
            return all_passed(
                same_trit(is_newline_fragment(fragment), 0),
                all_passed(
                    same_trit(same_tryte(fragment, fragment_document_marker()), 0),
                    same_trit(same_tryte(fragment, fragment_document_end()), 0)
                )
            )

        1:
            return 0

fn fragment_logical_byte_count(fragment: tryte) -> tryte:
    match fragment <=> fragment_document_marker():
        -1:
            return fragment_unknown()

        0:
            return 6

        1:
            match fragment <=> fragment_directive():
                -1:
                    return fragment_unknown()

                0:
                    return 6

                1:
                    match fragment <=> fragment_opcode():
                        -1:
                            return fragment_unknown()

                        0:
                            return 6

                        1:
                            match fragment <=> fragment_symbol():
                                -1:
                                    return fragment_unknown()

                                0:
                                    return 1

                                1:
                                    match fragment <=> fragment_type_name():
                                        -1:
                                            return fragment_unknown()

                                        0:
                                            return 4

                                        1:
                                            return fragment_logical_byte_count_tail(fragment)

fn fragment_logical_byte_count_tail(fragment: tryte) -> tryte:
    match fragment <=> fragment_register_name():
        -1:
            return fragment_unknown()

        0:
            return 2

        1:
            match fragment <=> fragment_memory_name():
                -1:
                    return fragment_unknown()

                0:
                    return 2

                1:
                    match fragment <=> fragment_immediate():
                        -1:
                            return fragment_unknown()

                        0:
                            return 1

                        1:
                            match fragment <=> fragment_separator():
                                -1:
                                    return fragment_unknown()

                                0:
                                    return 1

                                1:
                                    return fragment_logical_byte_count_layout(fragment)

fn fragment_logical_byte_count_layout(fragment: tryte) -> tryte:
    match fragment <=> fragment_space():
        -1:
            return fragment_unknown()

        0:
            return 1

        1:
            match fragment <=> fragment_indentation():
                -1:
                    return fragment_unknown()

                0:
                    return 4

                1:
                    match fragment <=> fragment_source_prefix():
                        -1:
                            return fragment_unknown()

                        0:
                            return 10

                        1:
                            match fragment <=> fragment_source_value():
                                -1:
                                    return fragment_unknown()

                                0:
                                    return 6

                                1:
                                    return fragment_logical_byte_count_finish(fragment)

fn fragment_logical_byte_count_finish(fragment: tryte) -> tryte:
    match fragment <=> fragment_newline():
        -1:
            return fragment_unknown()

        0:
            return 1

        1:
            match fragment <=> fragment_blank_line():
                -1:
                    return fragment_unknown()

                0:
                    return 1

                1:
                    match fragment <=> fragment_document_end():
                        -1:
                            return fragment_unknown()

                        0:
                            return 4

                        1:
                            return fragment_unknown()

fn expected_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 18, 21, 36)

fn expected_fragment_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 137, 145, 266)

fn expected_token_fragment_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 47, 51, 92)

fn expected_separator_fragment_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 14, 15, 26)

fn expected_indentation_fragment_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 13, 12, 24)

fn expected_metadata_fragment_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 14, 12, 28)

fn expected_newline_fragment_count(fixture: tryte) -> tryte:
    return expected_line_count(fixture)

fn expected_blank_fragment_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 2)

fn expected_space_fragment_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 31, 34, 60)

fn expected_builder_command_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 27, 29, 52)

fn expected_builder_token_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 17, 19, 34)

fn expected_builder_metadata_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 7, 6, 14)

fn expected_fragment_id_count(fixture: tryte, fragment: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return fragment_unknown()

        0:
            return expected_fragment_id_count_known(fixture, fragment)

        1:
            return fragment_unknown()

fn expected_fragment_id_count_known(fixture: tryte, fragment: tryte) -> tryte:
    match fragment <=> fragment_document_marker():
        -1:
            return fragment_unknown()

        0:
            return 1

        1:
            match fragment <=> fragment_directive():
                -1:
                    return fragment_unknown()

                0:
                    return fixture_metric(fixture, 8, 10, 17)

                1:
                    match fragment <=> fragment_opcode():
                        -1:
                            return fragment_unknown()

                        0:
                            return fixture_metric(fixture, 7, 6, 14)

                        1:
                            match fragment <=> fragment_symbol():
                                -1:
                                    return fragment_unknown()

                                0:
                                    return fixture_metric(fixture, 2, 5, 11)

                                1:
                                    return expected_fragment_id_count_tokens(fixture, fragment)

fn expected_fragment_id_count_tokens(fixture: tryte, fragment: tryte) -> tryte:
    match fragment <=> fragment_type_name():
        -1:
            return fragment_unknown()

        0:
            return fixture_metric(fixture, 7, 8, 12)

        1:
            match fragment <=> fragment_register_name():
                -1:
                    return fragment_unknown()

                0:
                    return fixture_metric(fixture, 18, 16, 29)

                1:
                    match fragment <=> fragment_memory_name():
                        -1:
                            return fragment_unknown()

                        0:
                            return 0

                        1:
                            match fragment <=> fragment_immediate():
                                -1:
                                    return fragment_unknown()

                                0:
                                    return fixture_metric(fixture, 3, 3, 6)

                                1:
                                    return expected_fragment_id_count_layout(fixture, fragment)

fn expected_fragment_id_count_layout(fixture: tryte, fragment: tryte) -> tryte:
    match fragment <=> fragment_separator():
        -1:
            return fragment_unknown()

        0:
            return expected_separator_fragment_count(fixture)

        1:
            match fragment <=> fragment_space():
                -1:
                    return fragment_unknown()

                0:
                    return expected_space_fragment_count(fixture)

                1:
                    match fragment <=> fragment_indentation():
                        -1:
                            return fragment_unknown()

                        0:
                            return expected_indentation_fragment_count(fixture)

                        1:
                            match fragment <=> fragment_source_prefix():
                                -1:
                                    return fragment_unknown()

                                0:
                                    return expected_builder_metadata_count(fixture)

                                1:
                                    return expected_fragment_id_count_finish(fixture, fragment)

fn expected_fragment_id_count_finish(fixture: tryte, fragment: tryte) -> tryte:
    match fragment <=> fragment_source_value():
        -1:
            return fragment_unknown()

        0:
            return expected_builder_metadata_count(fixture)

        1:
            match fragment <=> fragment_newline():
                -1:
                    return fragment_unknown()

                0:
                    return expected_line_count(fixture) - expected_blank_fragment_count(fixture)

                1:
                    match fragment <=> fragment_blank_line():
                        -1:
                            return fragment_unknown()

                        0:
                            return expected_blank_fragment_count(fixture)

                        1:
                            match fragment <=> fragment_document_end():
                                -1:
                                    return fragment_unknown()

                                0:
                                    return fixture_metric(fixture, 1, 2, 2)

                                1:
                                    return fragment_unknown()

fn expected_first_fragment_command_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return fragment_command_unknown()

        0:
            return fragment_command_start_document()

        1:
            match index <=> 1:
                -1:
                    return fragment_command_unknown()

                0:
                    return fragment_command_header_line()

                1:
                    match index <=> 2:
                        -1:
                            return fragment_command_unknown()

                        0:
                            return fragment_command_blank_line()

                        1:
                            match index <=> 3:
                                -1:
                                    return fragment_command_unknown()

                                0:
                                    return fragment_command_function_line()

                                1:
                                    return expected_first_fragment_command_body_at(index)

fn expected_first_fragment_command_body_at(index: tryte) -> tryte:
    match in_range(index, 4, 9) <=> 1:
        -1:
            match index <=> 10:
                -1:
                    return fragment_command_unknown()

                0:
                    return fragment_command_label_line()

                1:
                    match in_range(index, 11, 24) <=> 1:
                        -1:
                            match index <=> 25:
                                -1:
                                    return fragment_command_unknown()

                                0:
                                    return fragment_command_end_line()

                                1:
                                    match index <=> 26:
                                        -1:
                                            return fragment_command_unknown()

                                        0:
                                            return fragment_command_finish_document()

                                        1:
                                            return fragment_command_unknown()

                        0:
                            return paired_command_at(index, 11)

                        1:
                            return fragment_command_unknown()

        0:
            return fragment_command_register_line()

        1:
            return fragment_command_unknown()

fn expected_simple_call_fragment_command_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return fragment_command_unknown()

        0:
            return fragment_command_start_document()

        1:
            match index <=> 1:
                -1:
                    return fragment_command_unknown()

                0:
                    return fragment_command_header_line()

