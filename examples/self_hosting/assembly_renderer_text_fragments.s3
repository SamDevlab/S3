fn expected_instruction_operand_count(fixture: tryte, command_index: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return fragment_unknown()

        0:
            return expected_first_instruction_operand_count(command_index)

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return fragment_unknown()

                0:
                    return expected_simple_call_instruction_operand_count(command_index)

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return fragment_unknown()

                        0:
                            return expected_sign_instruction_operand_count(command_index)

                        1:
                            return fragment_unknown()

fn expected_first_instruction_operand_count(command_index: tryte) -> tryte:
