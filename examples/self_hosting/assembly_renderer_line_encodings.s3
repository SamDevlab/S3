fn simple_call_modeled_encoding_signature() -> tryte:
    return expected_fixture_encoding_signature(fixture_simple_call())

fn sign_modeled_encoding_signature() -> tryte:
    return expected_fixture_encoding_signature(fixture_sign())

fn modeled_fixture_encoding_signature(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return unknown_encoding()

        0:
            return first_modeled_encoding_signature()

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return unknown_encoding()

                0:
                    return simple_call_modeled_encoding_signature()

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return unknown_encoding()

                        0:
                            return sign_modeled_encoding_signature()

                        1:
                            return unknown_encoding()

