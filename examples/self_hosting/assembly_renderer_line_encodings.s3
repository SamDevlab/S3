fn line_encodings_flag_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, same_trit(expected_has_immediate_at(fixture_first(), 10), 1))
    ok = all_passed(ok, same_trit(expected_has_immediate_at(fixture_first(), 11), 0))
    ok = all_passed(ok, same_trit(expected_has_callee_at(fixture_simple_call(), 18), 1))
    ok = all_passed(ok, same_trit(expected_has_labels_at(fixture_sign(), 13), 1))
    ok = all_passed(ok, same_trit(expected_has_memory_operand_at(fixture_sign(), 13), 0))
