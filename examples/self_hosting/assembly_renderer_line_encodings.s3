fn expected_first_blueprint_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return unknown_encoding()

        0:
            return blueprint_s3asm_header()

        1:
            match index <=> 1:
                -1:
                    return unknown_encoding()

                0:
                    return blueprint_blank_line()

                1:
                    match index <=> 2:
                        -1:
                            return unknown_encoding()

                        0:
                            return blueprint_function_header()

                        1:
                            match in_range(index, 3, 8) <=> 1:
                                -1:
                                    match index <=> 9:
                                        -1:
                                            return unknown_encoding()

                                        0:
                                            return blueprint_label()

                                        1:
                                            match in_range(index, 10, 16) <=> 1:
                                                -1:
                                                    match index <=> 17:
                                                        -1:
                                                            return unknown_encoding()

                                                        0:
                                                            return blueprint_end()

                                                        1:
                                                            return unknown_encoding()

                                                0:
                                                    return blueprint_instruction_with_source()

                                                1:
                                                    return unknown_encoding()

                                0:
                                    return blueprint_register()

                                1:
                                    return unknown_encoding()

fn expected_simple_call_blueprint_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return unknown_encoding()

        0:
            return blueprint_s3asm_header()

        1:
            match index <=> 1:
                -1:
                    return unknown_encoding()

                0:
                    return blueprint_blank_line()

                1:
                    match index <=> 2:
                        -1:
                            return unknown_encoding()

                        0:
                            return blueprint_function_header()

                        1:
                            match in_range(index, 3, 4) <=> 1:
                                -1:
                                    match index <=> 5:
                                        -1:
                                            return unknown_encoding()

                                        0:
                                            return blueprint_register()

                                        1:
                                            match index <=> 6:
                                                -1:
                                                    return unknown_encoding()

                                                0:
                                                    return blueprint_label()

                                                1:
                                                    match in_range(index, 7, 8) <=> 1:
                                                        -1:
                                                            match index <=> 9:
                                                                -1:
                                                                    return unknown_encoding()

                                                                0:
                                                                    return blueprint_end()

                                                                1:
                                                                    match index <=> 10:
                                                                        -1:
                                                                            return unknown_encoding()

                                                                        0:
                                                                            return blueprint_blank_line()

                                                                        1:
                                                                            match index <=> 11:
                                                                                -1:
                                                                                    return unknown_encoding()

                                                                                0:
                                                                                    return blueprint_function_header()

                                                                                1:
                                                                                    match in_range(index, 12, 14) <=> 1:
                                                                                        -1:
                                                                                            match index <=> 15:
                                                                                                -1:
                                                                                                    return unknown_encoding()

                                                                                                0:
                                                                                                    return blueprint_label()

                                                                                                1:
                                                                                                    match in_range(index, 16, 19) <=> 1:
                                                                                                        -1:
                                                                                                            match index <=> 20:
                                                                                                                -1:
                                                                                                                    return unknown_encoding()

                                                                                                                0:
                                                                                                                    return blueprint_end()

                                                                                                                1:
                                                                                                                    return unknown_encoding()

                                                                                                        0:
                                                                                                            return blueprint_instruction_with_source()

                                                                                                        1:
                                                                                                            return unknown_encoding()

                                                                                        0:
                                                                                            return blueprint_register()

                                                                                        1:
                                                                                            return unknown_encoding()

                                                        0:
                                                            return blueprint_instruction_with_source()

                                                        1:
                                                            return unknown_encoding()

                                0:
                                    return blueprint_param()

                                1:
                                    return unknown_encoding()

fn expected_sign_blueprint_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return unknown_encoding()

        0:
            return blueprint_s3asm_header()

        1:
            match index <=> 1:
                -1:
                    return unknown_encoding()

                0:
                    return blueprint_blank_line()

                1:
                    match index <=> 2:
                        -1:
                            return unknown_encoding()

                        0:
                            return blueprint_function_header()

                        1:
                            match index <=> 3:
                                -1:
                                    return unknown_encoding()

                                0:
                                    return blueprint_param()

                                1:
                                    match in_range(index, 4, 9) <=> 1:
                                        -1:
                                            match index <=> 10:
                                                -1:
                                                    return unknown_encoding()

                                                0:
                                                    return blueprint_label()

                                                1:
                                                    match in_range(index, 11, 13) <=> 1:
                                                        -1:
                                                            match index <=> 14:
                                                                -1:
                                                                    return unknown_encoding()

                                                                0:
                                                                    return blueprint_label()

                                                                1:
                                                                    match in_range(index, 15, 17) <=> 1:
                                                                        -1:
                                                                            match index <=> 18:
                                                                                -1:
                                                                                    return unknown_encoding()

                                                                                0:
                                                                                    return blueprint_label()

                                                                                1:
                                                                                    match in_range(index, 19, 20) <=> 1:
                                                                                        -1:
                                                                                            match index <=> 21:
                                                                                                -1:
                                                                                                    return unknown_encoding()

                                                                                                0:
                                                                                                    return blueprint_label()

                                                                                                1:
                                                                                                    match in_range(index, 22, 23) <=> 1:
                                                                                                        -1:
                                                                                                            match index <=> 24:
                                                                                                                -1:
                                                                                                                    return unknown_encoding()

                                                                                                                0:
                                                                                                                    return blueprint_end()

                                                                                                                1:
                                                                                                                    match index <=> 25:
                                                                                                                        -1:
                                                                                                                            return unknown_encoding()

                                                                                                                        0:
                                                                                                                            return blueprint_blank_line()

                                                                                                                        1:
                                                                                                                            match index <=> 26:
                                                                                                                                -1:
                                                                                                                                    return unknown_encoding()

                                                                                                                                0:
                                                                                                                                    return blueprint_function_header()

                                                                                                                                1:
                                                                                                                                    match in_range(index, 27, 29) <=> 1:
                                                                                                                                        -1:
                                                                                                                                            match index <=> 30:
                                                                                                                                                -1:
                                                                                                                                                    return unknown_encoding()

                                                                                                                                                0:
                                                                                                                                                    return blueprint_label()

                                                                                                                                                1:
                                                                                                                                                    match in_range(index, 31, 34) <=> 1:
                                                                                                                                                        -1:
                                                                                                                                                            match index <=> 35:
                                                                                                                                                                -1:
                                                                                                                                                                    return unknown_encoding()

                                                                                                                                                                0:
                                                                                                                                                                    return blueprint_end()

                                                                                                                                                                1:
                                                                                                                                                                    return unknown_encoding()

                                                                                                                                                        0:
                                                                                                                                                            return blueprint_instruction_with_source()

                                                                                                                                                        1:
                                                                                                                                                            return unknown_encoding()

                                                                                                                                        0:
                                                                                                                                            return blueprint_register()

                                                                                                                                        1:
                                                                                                                                            return unknown_encoding()

                                                                                                        0:
                                                                                                            return blueprint_instruction_with_source()

                                                                                                        1:
                                                                                                            return unknown_encoding()

                                                                                        0:
                                                                                            return blueprint_instruction_with_source()

                                                                                        1:
                                                                                            return unknown_encoding()

                                                                        0:
                                                                            return blueprint_instruction_with_source()

                                                                        1:
                                                                            return unknown_encoding()

                                                        0:
                                                            return blueprint_instruction_with_source()

                                                        1:
                                                            return unknown_encoding()

                                        0:
                                            return blueprint_register()

                                        1:
                                            return unknown_encoding()

fn expected_blueprint_at(fixture: tryte, index: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return unknown_encoding()

        0:
            return expected_first_blueprint_at(index)

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return unknown_encoding()

                0:
                    return expected_simple_call_blueprint_at(index)

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return unknown_encoding()

                        0:
                            return expected_sign_blueprint_at(index)

                        1:
                            return unknown_encoding()

fn category_for_blueprint(blueprint: tryte) -> tryte:
    match same_tryte(blueprint, blueprint_blank_line()) <=> 1:
        -1:
            match same_tryte(blueprint, blueprint_instruction()) <=> 1:
                -1:
                    match same_tryte(blueprint, blueprint_instruction_with_source()) <=> 1:
                        -1:
                            match is_known_blueprint(blueprint) <=> 1:
                                -1:
                                    return unknown_encoding()

                                0:
                                    return category_directive()

                                1:
                                    return unknown_encoding()

                        0:
                            return category_instruction()

                        1:
                            return category_directive()

                0:
                    return category_instruction()

                1:
                    return category_directive()

        0:
            return category_blank()

        1:
            return unknown_encoding()

fn directive_for_blueprint(blueprint: tryte) -> tryte:
    match same_tryte(blueprint, blueprint_s3asm_header()) <=> 1:
        -1:
            match same_tryte(blueprint, blueprint_function_header()) <=> 1:
                -1:
                    match same_tryte(blueprint, blueprint_param()) <=> 1:
                        -1:
                            match same_tryte(blueprint, blueprint_register()) <=> 1:
                                -1:
                                    match same_tryte(blueprint, blueprint_memory()) <=> 1:
                                        -1:
                                            match same_tryte(blueprint, blueprint_label()) <=> 1:
                                                -1:
                                                    match same_tryte(blueprint, blueprint_instruction()) <=> 1:
                                                        -1:
                                                            match same_tryte(blueprint, blueprint_instruction_with_source()) <=> 1:
                                                                -1:
                                                                    match same_tryte(blueprint, blueprint_end()) <=> 1:
                                                                        -1:
                                                                            match same_tryte(blueprint, blueprint_blank_line()) <=> 1:
                                                                                -1:
                                                                                    return unknown_encoding()

                                                                                0:
                                                                                    return directive_blank()

                                                                                1:
                                                                                    return unknown_encoding()

                                                                        0:
                                                                            return directive_end()

                                                                        1:
                                                                            return unknown_encoding()

                                                                0:
                                                                    return directive_none()

                                                                1:
                                                                    return unknown_encoding()

                                                        0:
                                                            return directive_none()

                                                        1:
                                                            return unknown_encoding()

                                                0:
                                                    return directive_label()

                                                1:
                                                    return unknown_encoding()

                                        0:
                                            return directive_memory()

                                        1:
                                            return unknown_encoding()

                                0:
                                    return directive_register()

                                1:
                                    return unknown_encoding()

                        0:
                            return directive_param()

                        1:
                            return unknown_encoding()

                0:
                    return directive_function()

                1:
                    return unknown_encoding()

        0:
            return directive_s3asm()

        1:
            return unknown_encoding()

fn expected_line_category_at(fixture: tryte, index: tryte) -> tryte:
    return category_for_blueprint(expected_blueprint_at(fixture, index))

fn expected_directive_at(fixture: tryte, index: tryte) -> tryte:
    return directive_for_blueprint(expected_blueprint_at(fixture, index))

fn expected_first_opcode_at(index: tryte) -> tryte:
    match index <=> 10:
        -1:
            return opcode_none()

        0:
            return opcode_tconst()

        1:
            match index <=> 11:
                -1:
                    return opcode_none()

                0:
                    return opcode_tmov()

                1:
                    match index <=> 12:
                        -1:
                            return opcode_none()

                        0:
                            return opcode_tconst()

                        1:
                            match index <=> 13:
                                -1:
                                    return opcode_none()

                                0:
                                    return opcode_tmov()

                                1:
                                    match index <=> 14:
                                        -1:
                                            return opcode_none()

                                        0:
                                            return opcode_tinv()

                                        1:
                                            match index <=> 15:
                                                -1:
                                                    return opcode_none()

                                                0:
                                                    return opcode_tadd()

                                                1:
                                                    match index <=> 16:
                                                        -1:
                                                            return opcode_none()

                                                        0:
                                                            return opcode_tret()

                                                        1:
                                                            return opcode_none()

fn expected_simple_call_opcode_at(index: tryte) -> tryte:
    match index <=> 7:
        -1:
            return opcode_none()

        0:
            return opcode_tadd()

        1:
            match index <=> 8:
                -1:
                    return opcode_none()

                0:
                    return opcode_tret()

                1:
                    match index <=> 16:
                        -1:
                            return opcode_none()

                        0:
