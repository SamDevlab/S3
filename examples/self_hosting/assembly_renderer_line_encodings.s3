fn expected_callee_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 0, 1, 1)

fn expected_label_operand_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 6)

fn expected_memory_operand_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 0, 0, 0)

fn expected_source_metadata_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 6, 6, 12)

fn expected_fixture_encoding_signature(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 61, 73, 156)

