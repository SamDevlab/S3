fn expected_line_encoding_score_at(fixture: tryte, index: tryte) -> tryte:
    match is_valid_index(index, expected_line_count(fixture)) <=> 1:
        -1:
            return unknown_encoding()

        0:
            mut score: tryte = expected_line_category_at(fixture, index)

            score = score + expected_opcode_at(fixture, index)
            score = score + expected_register_operand_count_at(fixture, index)
            score = score + flag_score(expected_has_immediate_at(fixture, index))
            score = score + flag_score(expected_has_callee_at(fixture, index))
            score = score + flag_score(expected_has_labels_at(fixture, index))
            score = score + flag_score(expected_has_memory_operand_at(fixture, index))
            score = score + flag_score(expected_has_source_metadata_at(fixture, index))

            return score

        1:
            return unknown_encoding()

fn first_modeled_encoding_signature() -> tryte:
