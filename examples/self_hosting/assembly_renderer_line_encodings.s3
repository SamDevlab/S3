# Bootstrap line content encoding model for a future S3 Assembly renderer.
# It models structural line content with numeric IDs and flags only.

fn fixture_first() -> tryte:
    return 0

fn fixture_simple_call() -> tryte:
    return 1

fn fixture_sign() -> tryte:
    return 2

fn unknown_encoding() -> tryte:
    return -1

fn blueprint_s3asm_header() -> tryte:
    return 0

fn blueprint_function_header() -> tryte:
    return 1

fn blueprint_param() -> tryte:
    return 2

fn blueprint_register() -> tryte:
    return 3

fn blueprint_memory() -> tryte:
    return 4

fn blueprint_label() -> tryte:
    return 5

fn blueprint_instruction() -> tryte:
    return 6

fn blueprint_instruction_with_source() -> tryte:
    return 7

fn blueprint_end() -> tryte:
    return 8

fn blueprint_blank_line() -> tryte:
    return 9

fn directive_none() -> tryte:
    return 0

fn directive_s3asm() -> tryte:
    return 1

fn directive_function() -> tryte:
    return 2

fn directive_param() -> tryte:
    return 3

fn directive_register() -> tryte:
    return 4

fn directive_memory() -> tryte:
    return 5

fn directive_label() -> tryte:
    return 6

fn directive_end() -> tryte:
    return 7

fn directive_blank() -> tryte:
    return 8

fn opcode_none() -> tryte:
    return 0

fn opcode_tconst() -> tryte:
    return 1

fn opcode_tmov() -> tryte:
    return 2

fn opcode_tinv() -> tryte:
    return 3

fn opcode_tadd() -> tryte:
    return 4

fn opcode_tmin() -> tryte:
    return 5

fn opcode_tmax() -> tryte:
    return 6

fn opcode_tcmp() -> tryte:
    return 7

fn opcode_tcall() -> tryte:
    return 8

fn opcode_tload() -> tryte:
    return 9

fn opcode_tstore() -> tryte:
    return 10

fn opcode_tret() -> tryte:
    return 11

fn opcode_tjmp() -> tryte:
    return 12

fn opcode_tbr3() -> tryte:
    return 13

fn category_directive() -> tryte:
    return 0

fn category_instruction() -> tryte:
    return 1

fn category_blank() -> tryte:
    return 2

fn flag_false() -> trit:
    return 0

fn flag_true() -> trit:
    return 1

fn same_tryte(left: tryte, right: tryte) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn same_trit(left: trit, right: trit) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn all_passed(left: trit, right: trit) -> trit:
    match left <=> 1:
        -1:
            return 0

        0:
            match right <=> 1:
                -1:
                    return 0

                0:
                    return 1

                1:
                    return 0

        1:
            return 0

fn any_passed(left: trit, right: trit) -> trit:
    match left <=> 1:
        -1:
            match right <=> 1:
                -1:
                    return 0

                0:
                    return 1

                1:
                    return 0

        0:
            return 1

        1:
            return 1

fn status_from_check(check: trit, failure: tryte) -> tryte:
    match check <=> 1:
        -1:
            return failure

        0:
            return 0

        1:
            return failure

fn flag_score(flag: trit) -> tryte:
    match flag <=> 1:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn fixture_metric(fixture: tryte, first_value: tryte, simple_value: tryte, sign_value: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return unknown_encoding()

        0:
            return first_value

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return unknown_encoding()

                0:
                    return simple_value

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return unknown_encoding()

                        0:
                            return sign_value

                        1:
                            return unknown_encoding()

fn in_range(value: tryte, lower: tryte, upper: tryte) -> trit:
    match value <=> lower:
        -1:
            return 0

        0:
            return 1

        1:
            match value <=> upper:
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_known_fixture(fixture: tryte) -> trit:
    match fixture <=> fixture_first():
        -1:
            return 0

        0:
            return 1

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return 0

                0:
                    return 1

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return 0

                        0:
                            return 1

                        1:
                            return 0

fn is_known_blueprint(blueprint: tryte) -> trit:
    match blueprint <=> blueprint_s3asm_header():
        -1:
            return 0

        0:
            return 1

        1:
            match blueprint <=> blueprint_blank_line():
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_known_directive(directive: tryte) -> trit:
    match directive <=> directive_none():
        -1:
            return 0

        0:
            return 1

        1:
            match directive <=> directive_blank():
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_known_opcode(opcode: tryte) -> trit:
    match opcode <=> opcode_none():
        -1:
            return 0

        0:
            return 1

        1:
            match opcode <=> opcode_tbr3():
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_real_opcode(opcode: tryte) -> trit:
    match opcode <=> opcode_none():
        -1:
            return 0

        0:
            return 0

        1:
            return is_known_opcode(opcode)

fn is_valid_index(index: tryte, count: tryte) -> trit:
    match index <=> 0:
        -1:
            return 0

        0:
            match index <=> count:
                -1:
                    return 1

                0:
                    return 0

                1:
                    return 0

        1:
            match index <=> count:
                -1:
                    return 1

                0:
                    return 0

                1:
                    return 0

fn expected_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 16, 21, 32)

fn expected_encoded_line_count(fixture: tryte) -> tryte:
    return expected_line_count(fixture)

fn expected_instruction_encoding_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 6, 6, 12)

fn expected_directive_encoding_count(fixture: tryte) -> tryte:
