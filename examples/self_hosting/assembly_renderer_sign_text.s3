            match n <=> 9:
                0:
                    return 57
                -1:
                    skip_digit_9: tryte = 0
                1:
                    skip_digit_9: tryte = 0
            return 48
        0:
            return 57
        1:
            return decimal_ones_byte(n - 10)

fn decimal_length(n: tryte) -> tryte:
    match n <=> 9:
        -1:
            return 1
        0:
            return 1
        1:
            return 2

