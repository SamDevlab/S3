# Decimal formatter: converts 0-99 to ASCII digits
fn decimal_tens_byte(n: tryte) -> tryte:
    match n <=> 9:
        -1:
            return 48
        0:
            return 48
        1:
            return decimal_tens_byte(n - 10) + 1

fn decimal_ones_byte(n: tryte) -> tryte:
    match n <=> 9:
        -1:
            match n <=> 0:
                0:
                    return 48
                -1:
                    skip_digit_0: tryte = 0
                1:
                    skip_digit_0: tryte = 0
            match n <=> 1:
                0:
                    return 49
                -1:
                    skip_digit_1: tryte = 0
                1:
                    skip_digit_1: tryte = 0
            match n <=> 2:
