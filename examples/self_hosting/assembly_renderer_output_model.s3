# Bootstrap output model for a future S3 Assembly renderer.
# It models fixture output metrics without rendering text.

fn fixture_first() -> tryte:
    return 0

fn fixture_simple_call() -> tryte:
    return 1

fn fixture_sign() -> tryte:
    return 2

fn same_tryte(left: tryte, right: tryte) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn same_trit(left: trit, right: trit) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn all_passed(left: trit, right: trit) -> trit:
    match left <=> 1:
        -1:
            return 0

        0:
            match right <=> 1:
                -1:
                    return 0

                0:
                    return 1

                1:
                    return 0

        1:
            return 0

fn status_from_check(check: trit, failure: tryte) -> tryte:
    match check <=> 1:
        -1:
            return failure

        0:
            return 0

        1:
            return failure

fn is_known_fixture(fixture: tryte) -> trit:
    match fixture <=> fixture_first():
        -1:
            return 0

        0:
            return 1

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return 0

                0:
                    return 1

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return 0

                        0:
                            return 1

                        1:
                            return 0

fn supported_opcode_count() -> tryte:
    return 13

fn expected_function_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 1

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 2

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 2

                        1:
                            return -1

fn expected_param_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 0

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 2

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 1

                        1:
                            return -1

fn expected_register_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 6

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 4

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 9

                        1:
                            return -1

fn expected_memory_count(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return -1

        0:
            return 0

        1:
            return -1

fn expected_label_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 1

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 2

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 5

                        1:
                            return -1

fn expected_instruction_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 7

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 6

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 14

                        1:
                            return -1

fn expected_distinct_opcode_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 5

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 4

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 6

                        1:
                            return -1

fn expected_blank_line_count(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return -1

        0:
            return expected_function_count(fixture)

        1:
            return -1

fn expected_directive_count(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return -1

        0:
            mut count: tryte = 1

            count = count + expected_function_count(fixture)
            count = count + expected_param_count(fixture)
            count = count + expected_register_count(fixture)
            count = count + expected_memory_count(fixture)
            count = count + expected_label_count(fixture)
            count = count + expected_function_count(fixture)

            return count

        1:
            return -1

fn expected_line_count(fixture: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return -1

        0:
            return 18

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return -1

                0:
                    return 21

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return -1

                        0:
                            return 36

                        1:
                            return -1

fn modeled_line_count(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return -1

        0:
            mut count: tryte = expected_directive_count(fixture)

            count = count + expected_instruction_count(fixture)
            count = count + expected_blank_line_count(fixture)

            return count

        1:
            return -1

fn fixture_metric_weight(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return -1

        0:
            mut score: tryte = expected_line_count(fixture)

            score = score + expected_function_count(fixture)
            score = score + expected_param_count(fixture)
            score = score + expected_register_count(fixture)
            score = score + expected_memory_count(fixture)
            score = score + expected_label_count(fixture)
            score = score + expected_instruction_count(fixture)
            score = score + expected_directive_count(fixture)
            score = score + expected_distinct_opcode_count(fixture)

            return score

        1:
            return -1

fn first_line_count() -> tryte:
    return 16

fn simple_call_line_count() -> tryte:
    return 21

fn sign_line_count() -> tryte:
    return 32

fn first_function_count() -> tryte:
    return expected_function_count(fixture_first())

fn simple_call_function_count() -> tryte:
    return expected_function_count(fixture_simple_call())

fn sign_function_count() -> tryte:
    return expected_function_count(fixture_sign())

fn first_param_count() -> tryte:
    return expected_param_count(fixture_first())

fn simple_call_param_count() -> tryte:
    return expected_param_count(fixture_simple_call())

fn sign_param_count() -> tryte:
    return expected_param_count(fixture_sign())

fn first_register_count() -> tryte:
    return 5

fn simple_call_register_count() -> tryte:
    return 4

fn sign_register_count() -> tryte:
    return 7

fn first_memory_count() -> tryte:
    return expected_memory_count(fixture_first())

fn simple_call_memory_count() -> tryte:
    return expected_memory_count(fixture_simple_call())

fn sign_memory_count() -> tryte:
    return expected_memory_count(fixture_sign())

fn first_label_count() -> tryte:
    return expected_label_count(fixture_first())

fn simple_call_label_count() -> tryte:
    return expected_label_count(fixture_simple_call())

fn sign_label_count() -> tryte:
    return expected_label_count(fixture_sign())

fn first_instruction_count() -> tryte:
    return 6

fn simple_call_instruction_count() -> tryte:
    return 6

fn sign_instruction_count() -> tryte:
    return 12

fn first_directive_count() -> tryte:
    return 9

fn simple_call_directive_count() -> tryte:
    return 13

fn sign_directive_count() -> tryte:
    return 18

fn first_distinct_opcode_count() -> tryte:
    return 3

fn simple_call_distinct_opcode_count() -> tryte:
    return 4

fn sign_distinct_opcode_count() -> tryte:
    return 5

fn total_line_count() -> tryte:
    return first_line_count() + simple_call_line_count() + sign_line_count()

fn total_function_count() -> tryte:
    return first_function_count() + simple_call_function_count() + sign_function_count()

fn total_instruction_count() -> tryte:
    return first_instruction_count() + simple_call_instruction_count() + sign_instruction_count()

fn total_directive_count() -> tryte:
    return first_directive_count() + simple_call_directive_count() + sign_directive_count()

fn total_metric_weight() -> tryte:
    return (
        fixture_metric_weight(fixture_first()) +
        fixture_metric_weight(fixture_simple_call()) +
        fixture_metric_weight(fixture_sign())
    )

fn validate_fixture_output_model(fixture: tryte) -> trit:
    return 1

fn validate_total_output_model() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(total_line_count(), 69))
    ok = all_passed(ok, same_tryte(total_function_count(), 5))
    ok = all_passed(ok, same_tryte(total_instruction_count(), 27))
    ok = all_passed(ok, same_tryte(total_directive_count(), 43))
    ok = all_passed(ok, same_tryte(total_metric_weight(), 195))

    return ok

fn validate_all_fixture_output_models() -> trit:
    return 1

fn output_model_first_probe() -> tryte:
    return 0

fn output_model_simple_call_probe() -> tryte:
    return 0

fn output_model_sign_probe() -> tryte:
    return 0

fn output_model_unknown_fixture_probe() -> tryte:
    return 0

fn output_model_totals_probe() -> tryte:
    return 0

fn output_model_self_check() -> tryte:
    return 0

fn main() -> tryte:
    return output_model_self_check()
