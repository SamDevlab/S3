fn fragment_length(fragment_id: tryte) -> tryte:
    match fragment_id <=> 1:
        0:
            return 6
        -1:
            skip_len_1: tryte = 0
        1:
            skip_len_1: tryte = 0
    match fragment_id <=> 2:
        0:
            return 9
        -1:
            skip_len_2: tryte = 0
        1:
            skip_len_2: tryte = 0
    match fragment_id <=> 3:
        0:
            return 6
        -1:
            skip_len_3: tryte = 0
        1:
            skip_len_3: tryte = 0
    match fragment_id <=> 4:
        0:
            return 9
        -1:
            skip_len_4: tryte = 0
        1:
            skip_len_4: tryte = 0
    match fragment_id <=> 5:
        0:
            return 7
        -1:
            skip_len_5: tryte = 0
        1:
            skip_len_5: tryte = 0
    match fragment_id <=> 6:
        0:
            return 6
        -1:
            skip_len_6: tryte = 0
        1:
            skip_len_6: tryte = 0
    match fragment_id <=> 7:
        0:
            return 4
        -1:
            skip_len_7: tryte = 0
        1:
            skip_len_7: tryte = 0
    match fragment_id <=> 8:
        0:
            return 1
        -1:
            skip_len_8: tryte = 0
        1:
            skip_len_8: tryte = 0
    match fragment_id <=> 9:
        0:
            return 1
        -1:
            skip_len_9: tryte = 0
        1:
            skip_len_9: tryte = 0
    match fragment_id <=> 10:
        0:
            return 2
        -1:
            skip_len_10: tryte = 0
        1:
            skip_len_10: tryte = 0
    match fragment_id <=> 11:
        0:
            return 1
        -1:
            skip_len_11: tryte = 0
        1:
            skip_len_11: tryte = 0
    return -1

