fn output_buffer_transition_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(write_score(buffer_state_empty(), 0, write_header()), 0))
    ok = all_passed(ok, same_tryte(write_score(buffer_state_open(), 1, write_blank()), 10))
    ok = all_passed(ok, same_tryte(write_score(buffer_state_written(), 10, write_instruction()), 18))
    ok = all_passed(ok, validate_invalid_buffer_transition_probe())

    return status_from_check(ok, 1)

fn output_buffer_model_self_check() -> tryte:
