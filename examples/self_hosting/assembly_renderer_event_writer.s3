fn fixed_register_operand_count_for_opcode(opcode: tryte) -> tryte:
    match same_tryte(opcode, opcode_none()) <=> 1:
        -1:
            match same_tryte(opcode, opcode_tconst()) <=> 1:
                -1:
                    match same_tryte(opcode, opcode_tmov()) <=> 1:
                        -1:
                            match same_tryte(opcode, opcode_tinv()) <=> 1:
                                -1:
                                    match same_tryte(opcode, opcode_tadd()) <=> 1:
                                        -1:
                                            match same_tryte(opcode, opcode_tmin()) <=> 1:
                                                -1:
                                                    match same_tryte(opcode, opcode_tmax()) <=> 1:
                                                        -1:
                                                            match same_tryte(opcode, opcode_tcmp()) <=> 1:
                                                                -1:
                                                                    match same_tryte(opcode, opcode_tload()) <=> 1:
                                                                        -1:
                                                                            match same_tryte(opcode, opcode_tstore()) <=> 1:
                                                                                -1:
                                                                                    match same_tryte(opcode, opcode_tret()) <=> 1:
                                                                                        -1:
                                                                                            match same_tryte(opcode, opcode_tjmp()) <=> 1:
                                                                                                -1:
                                                                                                    match same_tryte(opcode, opcode_tbr3()) <=> 1:
                                                                                                        -1:
                                                                                                            return unknown_encoding()

                                                                                                        0:
                                                                                                            return 1

                                                                                                        1:
                                                                                                            return unknown_encoding()

                                                                                                0:
                                                                                                    return 0

                                                                                                1:
                                                                                                    return unknown_encoding()

                                                                                        0:
                                                                                            return 1

                                                                                        1:
                                                                                            return unknown_encoding()

                                                                                0:
                                                                                    return 2

                                                                                1:
                                                                                    return unknown_encoding()

                                                                        0:
                                                                            return 2

                                                                        1:
                                                                            return unknown_encoding()

                                                                0:
                                                                    return 3

                                                                1:
                                                                    return unknown_encoding()

                                                        0:
                                                            return 3

                                                        1:
                                                            return unknown_encoding()

                                                0:
                                                    return 3

                                                1:
                                                    return unknown_encoding()

                                        0:
                                            return 3

                                        1:
                                            return unknown_encoding()

                                0:
                                    return 2

                                1:
                                    return unknown_encoding()

                        0:
                            return 2

                        1:
                            return unknown_encoding()

                0:
                    return 1

                1:
                    return unknown_encoding()

        0:
            return 0

        1:
            return unknown_encoding()

fn expected_register_operand_count_at(fixture: tryte, index: tryte) -> tryte:
    match same_tryte(expected_blueprint_at(fixture, index), blueprint_param()) <=> 1:
        -1:
            match same_tryte(expected_blueprint_at(fixture, index), blueprint_register()) <=> 1:
                -1:
                    match same_tryte(expected_opcode_at(fixture, index), opcode_tcall()) <=> 1:
                        -1:
                            return fixed_register_operand_count_for_opcode(expected_opcode_at(fixture, index))

                        0:
                            match same_tryte(fixture, fixture_simple_call()) <=> 1:
                                -1:
                                    match same_tryte(fixture, fixture_sign()) <=> 1:
                                        -1:
                                            return unknown_encoding()

                                        0:
                                            return 2

                                        1:
                                            return unknown_encoding()

                                0:
                                    return 3

                                1:
                                    return unknown_encoding()

                        1:
                            return fixed_register_operand_count_for_opcode(expected_opcode_at(fixture, index))

                0:
                    return 1

                1:
                    return fixed_register_operand_count_for_opcode(expected_opcode_at(fixture, index))

        0:
            return 1

        1:
            return fixed_register_operand_count_for_opcode(expected_opcode_at(fixture, index))

fn expected_has_immediate_at(fixture: tryte, index: tryte) -> trit:
    return same_tryte(expected_opcode_at(fixture, index), opcode_tconst())

fn expected_has_callee_at(fixture: tryte, index: tryte) -> trit:
    return same_tryte(expected_opcode_at(fixture, index), opcode_tcall())

fn expected_has_labels_at(fixture: tryte, index: tryte) -> trit:
    return any_passed(
        same_tryte(expected_directive_at(fixture, index), directive_label()),
        any_passed(
            same_tryte(expected_opcode_at(fixture, index), opcode_tjmp()),
            same_tryte(expected_opcode_at(fixture, index), opcode_tbr3())
        )
    )

fn expected_has_memory_operand_at(fixture: tryte, index: tryte) -> trit:
    return any_passed(
        same_tryte(expected_directive_at(fixture, index), directive_memory()),
        any_passed(
            same_tryte(expected_opcode_at(fixture, index), opcode_tload()),
            same_tryte(expected_opcode_at(fixture, index), opcode_tstore())
        )
    )

fn expected_has_source_metadata_at(fixture: tryte, index: tryte) -> trit:
    return same_tryte(
        expected_blueprint_at(fixture, index),
        blueprint_instruction_with_source()
    )

