fn validate_fixture_line_encodings(fixture: tryte) -> trit:
    match fixture <=> fixture_first():
        -1:
            return 0

        0:
            return validate_first_line_encodings()

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return 0

                0:
                    return validate_simple_call_line_encodings()

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return 0

                        0:
                            return validate_sign_line_encodings()

                        1:
                            return 0

fn validate_fixture_encoding_metrics(fixture: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            mut ok: trit = 1

            ok = all_passed(ok, same_tryte(expected_encoded_line_count(fixture), expected_line_count(fixture)))
            ok = all_passed(ok, same_tryte(modeled_fixture_encoding_signature(fixture), expected_fixture_encoding_signature(fixture)))

            return ok

        1:
            return 0

fn total_encoded_line_count() -> tryte:
    return expected_encoded_line_count(fixture_first()) + expected_encoded_line_count(fixture_simple_call()) + expected_encoded_line_count(fixture_sign())

fn total_instruction_encoding_count() -> tryte:
    return expected_instruction_encoding_count(fixture_first()) + expected_instruction_encoding_count(fixture_simple_call()) + expected_instruction_encoding_count(fixture_sign())

fn total_directive_encoding_count() -> tryte:
    return expected_directive_encoding_count(fixture_first()) + expected_directive_encoding_count(fixture_simple_call()) + expected_directive_encoding_count(fixture_sign())

fn total_blank_encoding_count() -> tryte:
    return expected_blank_encoding_count(fixture_first()) + expected_blank_encoding_count(fixture_simple_call()) + expected_blank_encoding_count(fixture_sign())

fn total_opcode_encoding_count() -> tryte:
    return expected_opcode_encoding_count(fixture_first()) + expected_opcode_encoding_count(fixture_simple_call()) + expected_opcode_encoding_count(fixture_sign())

fn total_register_operand_line_count() -> tryte:
    return expected_register_operand_line_count(fixture_first()) + expected_register_operand_line_count(fixture_simple_call()) + expected_register_operand_line_count(fixture_sign())

fn total_immediate_line_count() -> tryte:
    return expected_immediate_line_count(fixture_first()) + expected_immediate_line_count(fixture_simple_call()) + expected_immediate_line_count(fixture_sign())

fn total_callee_line_count() -> tryte:
    return expected_callee_line_count(fixture_first()) + expected_callee_line_count(fixture_simple_call()) + expected_callee_line_count(fixture_sign())

fn total_label_operand_line_count() -> tryte:
    return expected_label_operand_line_count(fixture_first()) + expected_label_operand_line_count(fixture_simple_call()) + expected_label_operand_line_count(fixture_sign())

fn total_memory_operand_line_count() -> tryte:
    return expected_memory_operand_line_count(fixture_first()) + expected_memory_operand_line_count(fixture_simple_call()) + expected_memory_operand_line_count(fixture_sign())

fn total_source_metadata_line_count() -> tryte:
    return expected_source_metadata_line_count(fixture_first()) + expected_source_metadata_line_count(fixture_simple_call()) + expected_source_metadata_line_count(fixture_sign())

fn total_encoding_signature() -> tryte:
    return modeled_fixture_encoding_signature(fixture_first()) + modeled_fixture_encoding_signature(fixture_simple_call()) + modeled_fixture_encoding_signature(fixture_sign())

fn validate_total_line_encodings() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(total_encoded_line_count(), 75))
    ok = all_passed(ok, same_tryte(total_instruction_encoding_count(), 27))
    ok = all_passed(ok, same_tryte(total_directive_encoding_count(), 43))
    ok = all_passed(ok, same_tryte(total_blank_encoding_count(), 5))
    ok = all_passed(ok, same_tryte(total_opcode_encoding_count(), 27))
    ok = all_passed(ok, same_tryte(total_register_operand_line_count(), 49))
    ok = all_passed(ok, same_tryte(total_immediate_line_count(), 9))
    ok = all_passed(ok, same_tryte(total_callee_line_count(), 2))
    ok = all_passed(ok, same_tryte(total_label_operand_line_count(), 9))
    ok = all_passed(ok, same_tryte(total_memory_operand_line_count(), 0))
    ok = all_passed(ok, same_tryte(total_source_metadata_line_count(), 27))
    ok = all_passed(ok, same_tryte(total_encoding_signature(), 290))

    return ok

fn validate_all_fixture_line_encodings() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, validate_line_encoding_at(fixture_first(), 0))
    ok = all_passed(ok, validate_line_encoding_at(fixture_first(), 1))
    ok = all_passed(ok, validate_line_encoding_at(fixture_first(), 2))
    ok = all_passed(ok, validate_line_encoding_at(fixture_first(), 10))
    ok = all_passed(ok, validate_line_encoding_at(fixture_simple_call(), 7))
    ok = all_passed(ok, validate_line_encoding_at(fixture_simple_call(), 18))
    ok = all_passed(ok, validate_line_encoding_at(fixture_sign(), 13))
    ok = all_passed(ok, validate_line_encoding_at(fixture_sign(), 33))
    ok = all_passed(ok, validate_first_key_lines())
    ok = all_passed(ok, validate_simple_call_key_lines())
    ok = all_passed(ok, validate_sign_key_lines())
    ok = all_passed(ok, validate_fixture_encoding_metrics(fixture_first()))
    ok = all_passed(ok, validate_fixture_encoding_metrics(fixture_simple_call()))
    ok = all_passed(ok, validate_fixture_encoding_metrics(fixture_sign()))
    ok = all_passed(ok, same_trit(validate_line_encoding_at(fixture_first(), 99), 0))
    ok = all_passed(ok, same_tryte(expected_blueprint_at(99, 0), unknown_encoding()))
    ok = all_passed(ok, validate_total_line_encodings())

    return ok

fn line_encodings_first_probe() -> tryte:
    return status_from_check(validate_fixture_line_encodings(fixture_first()), 1)

fn line_encodings_simple_call_probe() -> tryte:
    return status_from_check(validate_fixture_line_encodings(fixture_simple_call()), 1)

fn line_encodings_sign_probe() -> tryte:
    return status_from_check(validate_fixture_line_encodings(fixture_sign()), 1)

fn line_encodings_unknown_fixture_probe() -> tryte:
    return status_from_check(same_trit(validate_fixture_line_encodings(99), 0), 1)

fn line_encodings_unknown_line_probe() -> tryte:
    return status_from_check(same_trit(validate_line_encoding_at(fixture_first(), 99), 0), 1)

fn line_encodings_opcode_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, validate_first_key_lines())
    ok = all_passed(ok, validate_simple_call_key_lines())
    ok = all_passed(ok, validate_sign_key_lines())

    return status_from_check(ok, 1)

fn line_encodings_flag_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, same_trit(expected_has_immediate_at(fixture_first(), 10), 1))
    ok = all_passed(ok, same_trit(expected_has_immediate_at(fixture_first(), 11), 0))
    ok = all_passed(ok, same_trit(expected_has_callee_at(fixture_simple_call(), 18), 1))
    ok = all_passed(ok, same_trit(expected_has_labels_at(fixture_sign(), 13), 1))
    ok = all_passed(ok, same_trit(expected_has_memory_operand_at(fixture_sign(), 13), 0))
    ok = all_passed(ok, same_trit(expected_has_source_metadata_at(fixture_sign(), 34), 1))

    return status_from_check(ok, 1)

fn line_encodings_signature_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(modeled_fixture_encoding_signature(fixture_first()), 61))
    ok = all_passed(ok, same_tryte(modeled_fixture_encoding_signature(fixture_simple_call()), 73))
    ok = all_passed(ok, same_tryte(modeled_fixture_encoding_signature(fixture_sign()), 156))
    ok = all_passed(ok, same_tryte(total_encoding_signature(), 290))

    return status_from_check(ok, 1)

fn line_encodings_totals_probe() -> tryte:
    return status_from_check(validate_total_line_encodings(), 1)

fn event_for_blueprint(blueprint: tryte) -> tryte:
    match same_tryte(blueprint, blueprint_s3asm_header()) <=> 1:
        -1:
            match same_tryte(blueprint, blueprint_function_header()) <=> 1:
                -1:
                    match same_tryte(blueprint, blueprint_param()) <=> 1:
                        -1:
                            match same_tryte(blueprint, blueprint_register()) <=> 1:
                                -1:
                                    match same_tryte(blueprint, blueprint_memory()) <=> 1:
                                        -1:
                                            match same_tryte(blueprint, blueprint_label()) <=> 1:
                                                -1:
                                                    match same_tryte(blueprint, blueprint_instruction()) <=> 1:
                                                        -1:
                                                            match same_tryte(blueprint, blueprint_instruction_with_source()) <=> 1:
                                                                -1:
                                                                    match same_tryte(blueprint, blueprint_end()) <=> 1:
                                                                        -1:
                                                                            match same_tryte(blueprint, blueprint_blank_line()) <=> 1:
                                                                                -1:
                                                                                    return event_unknown()

                                                                                0:
                                                                                    return event_emit_blank()

                                                                                1:
                                                                                    return event_unknown()

                                                                        0:
                                                                            return event_emit_end()

                                                                        1:
                                                                            return event_unknown()

                                                                0:
                                                                    return event_emit_instruction()

                                                                1:
                                                                    return event_unknown()

                                                        0:
                                                            return event_emit_instruction()

                                                        1:
                                                            return event_unknown()

                                                0:
                                                    return event_emit_label()

                                                1:
                                                    return event_unknown()

                                        0:
                                            return event_emit_memory()

                                        1:
                                            return event_unknown()

                                0:
                                    return event_emit_register()

                                1:
                                    return event_unknown()

                        0:
                            return event_emit_param()

                        1:
                            return event_unknown()

                0:
                    return event_emit_function()

                1:
                    return event_unknown()

        0:
            return event_emit_header()

        1:
            return event_unknown()

fn payload_for_instruction_opcode(opcode: tryte) -> tryte:
    match same_tryte(opcode, opcode_tconst()) <=> 1:
        -1:
            match same_tryte(opcode, opcode_tcall()) <=> 1:
                -1:
                    match same_tryte(opcode, opcode_tjmp()) <=> 1:
                        -1:
                            match same_tryte(opcode, opcode_tbr3()) <=> 1:
                                -1:
                                    match same_tryte(opcode, opcode_tload()) <=> 1:
                                        -1:
                                            match same_tryte(opcode, opcode_tstore()) <=> 1:
                                                -1:
                                                    match is_real_opcode(opcode) <=> 1:
                                                        -1:
                                                            return payload_none()

                                                        0:
                                                            return payload_instruction_registers()

                                                        1:
                                                            return payload_none()

                                                0:
                                                    return payload_instruction_memory()

                                                1:
                                                    return payload_none()

                                        0:
                                            return payload_instruction_memory()

                                        1:
                                            return payload_none()

                                0:
                                    return payload_instruction_branch()

                                1:
                                    return payload_none()

                        0:
                            return payload_instruction_branch()

                        1:
                            return payload_none()

                0:
                    return payload_instruction_call()

                1:
                    return payload_none()

        0:
            return payload_instruction_immediate()

        1:
            return payload_none()

fn payload_for_event(event: tryte, opcode: tryte) -> tryte:
    match same_tryte(event, event_emit_header()) <=> 1:
        -1:
            match same_tryte(event, event_emit_function()) <=> 1:
                -1:
                    match same_tryte(event, event_emit_param()) <=> 1:
                        -1:
                            match same_tryte(event, event_emit_register()) <=> 1:
                                -1:
                                    match same_tryte(event, event_emit_memory()) <=> 1:
                                        -1:
                                            match same_tryte(event, event_emit_label()) <=> 1:
                                                -1:
                                                    match same_tryte(event, event_emit_instruction()) <=> 1:
                                                        -1:
                                                            match same_tryte(event, event_emit_end()) <=> 1:
                                                                -1:
                                                                    match same_tryte(event, event_emit_blank()) <=> 1:
                                                                        -1:
                                                                            return payload_none()

                                                                        0:
                                                                            return payload_blank()

                                                                        1:
                                                                            return payload_none()

                                                                0:
                                                                    return payload_directive()

                                                                1:
                                                                    return payload_none()

                                                        0:
                                                            return payload_for_instruction_opcode(opcode)

                                                        1:
                                                            return payload_none()

                                                0:
                                                    return payload_symbol()

                                                1:
                                                    return payload_none()

                                        0:
                                            return payload_memory_decl()

                                        1:
                                            return payload_none()

                                0:
                                    return payload_register_decl()

                                1:
                                    return payload_none()

                        0:
                            return payload_register_decl()

                        1:
                            return payload_none()

                0:
                    return payload_symbol()

                1:
                    return payload_none()

        0:
            return payload_directive()

        1:
            return payload_none()

fn expected_event_at(fixture: tryte, index: tryte) -> tryte:
    return event_for_blueprint(expected_blueprint_at(fixture, index))

fn expected_payload_at(fixture: tryte, index: tryte) -> tryte:
    return payload_for_event(
        expected_event_at(fixture, index),
        expected_opcode_at(fixture, index)
    )

fn is_known_event(event: tryte) -> trit:
    return in_range(event, event_emit_header(), event_emit_blank())

fn is_known_payload(payload: tryte) -> trit:
    return in_range(payload, payload_none(), payload_blank())

fn is_emit_directive_event(event: tryte) -> trit:
    return any_passed(
        same_tryte(event, event_emit_header()),
        any_passed(
            same_tryte(event, event_emit_function()),
            any_passed(
                same_tryte(event, event_emit_param()),
                any_passed(
                    same_tryte(event, event_emit_register()),
                    any_passed(
                        same_tryte(event, event_emit_memory()),
                        any_passed(
                            same_tryte(event, event_emit_label()),
                            same_tryte(event, event_emit_end())
                        )
                    )
                )
            )
        )
    )

fn is_emit_instruction_event(event: tryte) -> trit:
    return same_tryte(event, event_emit_instruction())

fn is_emit_blank_event(event: tryte) -> trit:
    return same_tryte(event, event_emit_blank())

fn event_allows_opcode(event: tryte) -> trit:
    return is_emit_instruction_event(event)

fn event_allows_directive(event: tryte) -> trit:
    return any_passed(is_emit_directive_event(event), is_emit_blank_event(event))

fn event_allows_labels(event: tryte) -> trit:
    return any_passed(
        same_tryte(event, event_emit_label()),
        same_tryte(event, event_emit_instruction())
    )

fn event_allows_memory_operand(event: tryte) -> trit:
    return any_passed(
        same_tryte(event, event_emit_memory()),
        same_tryte(event, event_emit_instruction())
    )

fn event_allows_source_metadata(event: tryte) -> trit:
    return same_tryte(event, event_emit_instruction())

fn payload_allows_registers(payload: tryte) -> trit:
    return any_passed(
        same_tryte(payload, payload_register_decl()),
        any_passed(
            same_tryte(payload, payload_instruction_registers()),
            any_passed(
                same_tryte(payload, payload_instruction_immediate()),
                any_passed(
                    same_tryte(payload, payload_instruction_call()),
                    any_passed(
                        same_tryte(payload, payload_instruction_branch()),
                        same_tryte(payload, payload_instruction_memory())
                    )
                )
            )
        )
    )

fn payload_allows_immediate(payload: tryte) -> trit:
    return same_tryte(payload, payload_instruction_immediate())

fn payload_allows_callee(payload: tryte) -> trit:
    return same_tryte(payload, payload_instruction_call())

fn payload_allows_labels(payload: tryte) -> trit:
    return same_tryte(payload, payload_instruction_branch())

fn payload_allows_memory_operand(payload: tryte) -> trit:
    return any_passed(
        same_tryte(payload, payload_memory_decl()),
        same_tryte(payload, payload_instruction_memory())
    )

fn payload_allows_source_metadata(payload: tryte) -> trit:
    return any_passed(
        same_tryte(payload, payload_instruction_no_operands()),
        any_passed(
            same_tryte(payload, payload_instruction_registers()),
            any_passed(
                same_tryte(payload, payload_instruction_immediate()),
                any_passed(
                    same_tryte(payload, payload_instruction_call()),
                    any_passed(
                        same_tryte(payload, payload_instruction_branch()),
                        same_tryte(payload, payload_instruction_memory())
                    )
                )
            )
        )
    )

fn payload_allowed_for_event(event: tryte, payload: tryte) -> trit:
    match same_tryte(event, event_emit_header()) <=> 1:
        -1:
            match same_tryte(event, event_emit_function()) <=> 1:
                -1:
                    match same_tryte(event, event_emit_param()) <=> 1:
                        -1:
                            match same_tryte(event, event_emit_register()) <=> 1:
                                -1:
                                    match same_tryte(event, event_emit_memory()) <=> 1:
                                        -1:
                                            match same_tryte(event, event_emit_label()) <=> 1:
                                                -1:
                                                    match same_tryte(event, event_emit_instruction()) <=> 1:
                                                        -1:
                                                            match same_tryte(event, event_emit_end()) <=> 1:
                                                                -1:
                                                                    match same_tryte(event, event_emit_blank()) <=> 1:
                                                                        -1:
                                                                            return 0

                                                                        0:
                                                                            return same_tryte(payload, payload_blank())

                                                                        1:
                                                                            return 0

                                                                0:
                                                                    return same_tryte(payload, payload_directive())

                                                                1:
                                                                    return 0

                                                        0:
                                                            return any_passed(
                                                                payload_allows_source_metadata(payload),
                                                                same_tryte(payload, payload_source_metadata())
                                                            )

                                                        1:
                                                            return 0

                                                0:
                                                    return same_tryte(payload, payload_symbol())

                                                1:
                                                    return 0

                                        0:
                                            return same_tryte(payload, payload_memory_decl())

                                        1:
                                            return 0

                                0:
                                    return same_tryte(payload, payload_register_decl())

                                1:
                                    return 0

                        0:
                            return same_tryte(payload, payload_register_decl())

                        1:
                            return 0

                0:
                    return same_tryte(payload, payload_symbol())

                1:
                    return 0

        0:
            return same_tryte(payload, payload_directive())

        1:
            return 0

fn validate_event_index(fixture: tryte, index: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            return is_valid_index(index, expected_line_count(fixture))

        1:
            return 0

fn validate_event_payload(fixture: tryte, index: tryte) -> trit:
    match validate_event_index(fixture, index) <=> 1:
        -1:
            return 0

        0:
            mut ok: trit = 1
            mut event: tryte = expected_event_at(fixture, index)
            mut payload: tryte = expected_payload_at(fixture, index)

            ok = all_passed(ok, is_known_event(event))
            ok = all_passed(ok, is_known_payload(payload))
            ok = all_passed(ok, payload_allowed_for_event(event, payload))

            return ok

        1:
            return 0

fn validate_event_encoding(fixture: tryte, index: tryte) -> trit:
    match validate_event_index(fixture, index) <=> 1:
        -1:
            return 0

        0:
            mut ok: trit = 1
            mut event: tryte = expected_event_at(fixture, index)
            mut payload: tryte = expected_payload_at(fixture, index)

            ok = all_passed(ok, validate_event_payload(fixture, index))
            ok = all_passed(ok, same_tryte(event, event_for_blueprint(expected_blueprint_at(fixture, index))))
            ok = all_passed(ok, same_tryte(payload, payload_for_event(event, expected_opcode_at(fixture, index))))
            ok = all_passed(ok, same_trit(event_allows_opcode(event), same_tryte(expected_line_category_at(fixture, index), category_instruction())))
            ok = all_passed(ok, same_trit(event_allows_directive(event), any_passed(same_tryte(expected_line_category_at(fixture, index), category_directive()), same_tryte(expected_line_category_at(fixture, index), category_blank()))))
            ok = all_passed(ok, same_trit(payload_allows_immediate(payload), expected_has_immediate_at(fixture, index)))
            ok = all_passed(ok, same_trit(payload_allows_callee(payload), expected_has_callee_at(fixture, index)))
            ok = all_passed(ok, same_trit(expected_has_labels_at(fixture, index), any_passed(same_tryte(event, event_emit_label()), payload_allows_labels(payload))))
            ok = all_passed(ok, same_trit(expected_has_memory_operand_at(fixture, index), any_passed(same_tryte(event, event_emit_memory()), same_tryte(payload, payload_instruction_memory()))))
            ok = all_passed(ok, same_trit(expected_has_source_metadata_at(fixture, index), all_passed(event_allows_source_metadata(event), payload_allows_source_metadata(payload))))

            return ok

        1:
            return 0

