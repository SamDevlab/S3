fn validate_invalid_event_transition_probes() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_trit(is_valid_event_transition(event_emit_blank(), event_emit_blank()), 0))
    ok = all_passed(ok, same_trit(is_valid_event_transition(event_emit_header(), event_emit_header()), 0))
    ok = all_passed(ok, same_trit(is_valid_event_transition(event_emit_end(), event_emit_instruction()), 0))
    ok = all_passed(ok, same_trit(is_valid_event_transition(event_emit_label(), event_emit_register()), 0))
    ok = all_passed(ok, same_trit(is_valid_event_transition(event_emit_function(), event_emit_end()), 0))
    ok = all_passed(ok, same_trit(is_valid_event_transition(event_emit_param(), event_emit_label()), 0))
    ok = all_passed(ok, same_trit(is_valid_event_transition(event_unknown(), event_emit_header()), 0))

    return ok

fn expected_event_count(fixture: tryte) -> tryte:
    return expected_line_count(fixture)

fn expected_emit_header_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 1, 1)

fn expected_emit_function_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 2)

fn expected_emit_param_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 0, 2, 1)

fn expected_emit_register_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 6, 4, 9)

fn expected_emit_memory_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 0, 0, 0)

fn expected_emit_label_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 5)

fn expected_emit_instruction_count(fixture: tryte) -> tryte:
    return expected_instruction_encoding_count(fixture)

fn expected_emit_end_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 2)

fn expected_emit_blank_count(fixture: tryte) -> tryte:
    return expected_blank_encoding_count(fixture)

fn expected_event_transition_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 17, 20, 35)

fn expected_fixture_event_signature(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 81, 94, 170)

fn expected_fixture_payload_signature(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 80, 93, 165)

fn event_score(fixture: tryte, index: tryte) -> tryte:
    match validate_event_index(fixture, index) <=> 1:
        -1:
            return unknown_encoding()

        0:
            return expected_event_at(fixture, index)

        1:
            return unknown_encoding()

fn payload_score(fixture: tryte, index: tryte) -> tryte:
    match validate_event_index(fixture, index) <=> 1:
        -1:
            return unknown_encoding()

        0:
            return expected_payload_at(fixture, index)

        1:
            return unknown_encoding()

fn modeled_fixture_event_signature(fixture: tryte) -> tryte:
    return expected_fixture_event_signature(fixture)

fn modeled_fixture_payload_signature(fixture: tryte) -> tryte:
    return expected_fixture_payload_signature(fixture)

fn total_event_count() -> tryte:
    return expected_event_count(fixture_first()) + expected_event_count(fixture_simple_call()) + expected_event_count(fixture_sign())

fn total_emit_header_count() -> tryte:
    return expected_emit_header_count(fixture_first()) + expected_emit_header_count(fixture_simple_call()) + expected_emit_header_count(fixture_sign())

