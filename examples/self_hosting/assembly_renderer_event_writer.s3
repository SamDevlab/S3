    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(total_event_count(), 75))
    ok = all_passed(ok, same_tryte(total_emit_header_count(), 3))
    ok = all_passed(ok, same_tryte(total_emit_function_count(), 5))
    ok = all_passed(ok, same_tryte(total_emit_param_count(), 3))
    ok = all_passed(ok, same_tryte(total_emit_register_count(), 19))
