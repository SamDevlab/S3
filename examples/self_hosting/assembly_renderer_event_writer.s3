    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            return is_valid_index(index, expected_line_count(fixture))

        1:
            return 0

fn validate_opcode_shape(fixture: tryte, index: tryte) -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, is_known_opcode(expected_opcode_at(fixture, index)))
    match expected_line_category_at(fixture, index) <=> category_instruction():
        -1:
            ok = all_passed(ok, same_tryte(expected_opcode_at(fixture, index), opcode_none()))

        0:
            ok = all_passed(ok, is_real_opcode(expected_opcode_at(fixture, index)))

        1:
            ok = all_passed(ok, same_tryte(expected_opcode_at(fixture, index), opcode_none()))

    return ok

fn validate_flag_derivations(fixture: tryte, index: tryte) -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_trit(expected_has_immediate_at(fixture, index), same_tryte(expected_opcode_at(fixture, index), opcode_tconst())))
    ok = all_passed(ok, same_trit(expected_has_callee_at(fixture, index), same_tryte(expected_opcode_at(fixture, index), opcode_tcall())))
    ok = all_passed(ok, same_trit(expected_has_source_metadata_at(fixture, index), same_tryte(expected_blueprint_at(fixture, index), blueprint_instruction_with_source())))
    ok = all_passed(ok, same_trit(expected_has_memory_operand_at(fixture, index), 0))

    return ok

fn validate_line_encoding_at(fixture: tryte, index: tryte) -> trit:
    match validate_encoding_index(fixture, index) <=> 1:
        -1:
            return 0

        0:
            mut ok: trit = 1

            ok = all_passed(ok, is_known_blueprint(expected_blueprint_at(fixture, index)))
            ok = all_passed(ok, is_known_directive(expected_directive_at(fixture, index)))
            ok = all_passed(ok, same_tryte(expected_line_category_at(fixture, index), category_for_blueprint(expected_blueprint_at(fixture, index))))
            ok = all_passed(ok, same_tryte(expected_directive_at(fixture, index), directive_for_blueprint(expected_blueprint_at(fixture, index))))
            ok = all_passed(ok, validate_opcode_shape(fixture, index))
            ok = all_passed(ok, validate_flag_derivations(fixture, index))

            return ok

        1:
            return 0

