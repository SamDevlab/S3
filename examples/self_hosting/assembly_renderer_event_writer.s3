fn flag_false() -> trit:
    return 0

fn flag_true() -> trit:
    return 1

fn same_tryte(left: tryte, right: tryte) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn same_trit(left: trit, right: trit) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn all_passed(left: trit, right: trit) -> trit:
    match left <=> 1:
        -1:
            return 0

        0:
            match right <=> 1:
                -1:
                    return 0

                0:
                    return 1

                1:
                    return 0

        1:
            return 0

fn any_passed(left: trit, right: trit) -> trit:
    match left <=> 1:
        -1:
            match right <=> 1:
                -1:
                    return 0

                0:
                    return 1

                1:
                    return 0

        0:
            return 1

        1:
            return 1

fn status_from_check(check: trit, failure: tryte) -> tryte:
    match check <=> 1:
        -1:
            return failure

        0:
            return 0

        1:
            return failure

fn flag_score(flag: trit) -> tryte:
    match flag <=> 1:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn fixture_metric(fixture: tryte, first_value: tryte, simple_value: tryte, sign_value: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return unknown_encoding()

        0:
            return first_value

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return unknown_encoding()

                0:
                    return simple_value

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return unknown_encoding()

                        0:
                            return sign_value

                        1:
                            return unknown_encoding()

fn in_range(value: tryte, lower: tryte, upper: tryte) -> trit:
    match value <=> lower:
        -1:
            return 0

        0:
            return 1

        1:
            match value <=> upper:
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_known_fixture(fixture: tryte) -> trit:
    match fixture <=> fixture_first():
        -1:
            return 0

        0:
            return 1

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return 0

                0:
                    return 1

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return 0

                        0:
                            return 1

                        1:
                            return 0

fn is_known_blueprint(blueprint: tryte) -> trit:
    match blueprint <=> blueprint_s3asm_header():
        -1:
            return 0

        0:
            return 1

        1:
            match blueprint <=> blueprint_blank_line():
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_known_directive(directive: tryte) -> trit:
    match directive <=> directive_none():
        -1:
            return 0

        0:
            return 1

        1:
            match directive <=> directive_blank():
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_known_opcode(opcode: tryte) -> trit:
    match opcode <=> opcode_none():
        -1:
            return 0

        0:
            return 1

        1:
            match opcode <=> opcode_tbr3():
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn is_real_opcode(opcode: tryte) -> trit:
    match opcode <=> opcode_none():
        -1:
            return 0

        0:
            return 0

        1:
            return is_known_opcode(opcode)

fn is_valid_index(index: tryte, count: tryte) -> trit:
    match index <=> 0:
        -1:
            return 0

        0:
            match index <=> count:
                -1:
                    return 1

                0:
                    return 0

                1:
                    return 0

        1:
            match index <=> count:
                -1:
                    return 1

                0:
                    return 0

                1:
                    return 0

fn expected_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 18, 21, 36)

