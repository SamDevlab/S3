    ok = all_passed(ok, same_tryte(total_emit_instruction_count(), 27))
    ok = all_passed(ok, same_tryte(total_emit_end_count(), 5))
    ok = all_passed(ok, same_tryte(total_emit_blank_count(), 5))
    ok = all_passed(ok, same_tryte(total_event_transition_count(), 72))

    return ok

fn validate_fixture_event_signature(fixture: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            mut ok: trit = 1

            ok = all_passed(ok, same_tryte(modeled_fixture_event_signature(fixture), expected_fixture_event_signature(fixture)))
            ok = all_passed(ok, same_tryte(modeled_fixture_payload_signature(fixture), expected_fixture_payload_signature(fixture)))

            return ok

        1:
            return 0

fn validate_total_event_signature() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(total_event_signature(), 345))
    ok = all_passed(ok, same_tryte(total_payload_signature(), 338))

    return ok

fn validate_event_stream_invalid_fixture_probe() -> trit:
    return same_trit(validate_fixture_event_stream(99), 0)

fn validate_event_stream_invalid_index_probe() -> trit:
    return same_trit(validate_event_encoding(fixture_first(), 99), 0)

fn validate_event_stream_unknown_event_probe() -> trit:
    return all_passed(
        same_trit(is_known_event(event_unknown()), 0),
        same_trit(payload_allowed_for_event(event_unknown(), payload_directive()), 0)
    )

fn validate_event_stream_invalid_payload_probe() -> trit:
    return all_passed(
        same_trit(is_known_payload(99), 0),
        same_trit(payload_allowed_for_event(event_emit_header(), payload_instruction_call()), 0)
    )

fn validate_all_fixture_event_streams() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, validate_event_encoding(fixture_first(), 0))
    ok = all_passed(ok, validate_event_encoding(fixture_first(), 1))
    ok = all_passed(ok, validate_event_encoding(fixture_first(), 10))
    ok = all_passed(ok, validate_event_encoding(fixture_simple_call(), 18))
    ok = all_passed(ok, validate_event_encoding(fixture_sign(), 13))
    ok = all_passed(ok, validate_event_encoding(fixture_sign(), 33))
    ok = all_passed(ok, validate_fixture_event_counts(fixture_first()))
    ok = all_passed(ok, validate_fixture_event_counts(fixture_simple_call()))
    ok = all_passed(ok, validate_fixture_event_counts(fixture_sign()))
    ok = all_passed(ok, validate_fixture_event_signature(fixture_first()))
    ok = all_passed(ok, validate_fixture_event_signature(fixture_simple_call()))
    ok = all_passed(ok, validate_fixture_event_signature(fixture_sign()))
    ok = all_passed(ok, validate_total_event_counts())
    ok = all_passed(ok, validate_total_event_signature())
    ok = all_passed(ok, validate_event_stream_invalid_fixture_probe())
    ok = all_passed(ok, validate_event_stream_invalid_index_probe())
    ok = all_passed(ok, validate_event_stream_unknown_event_probe())
    ok = all_passed(ok, validate_event_stream_invalid_payload_probe())
    ok = all_passed(ok, validate_invalid_event_transition_probes())

    return ok

fn event_stream_first_probe() -> tryte:
    return status_from_check(validate_fixture_event_stream(fixture_first()), 1)

fn event_stream_simple_call_probe() -> tryte:
    return status_from_check(validate_fixture_event_stream(fixture_simple_call()), 1)

fn event_stream_sign_probe() -> tryte:
    return status_from_check(validate_fixture_event_stream(fixture_sign()), 1)

fn event_stream_transition_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, validate_fixture_event_transitions(fixture_first()))
    ok = all_passed(ok, validate_fixture_event_transitions(fixture_simple_call()))
    ok = all_passed(ok, validate_fixture_event_transitions(fixture_sign()))
    ok = all_passed(ok, validate_invalid_event_transition_probes())

    return status_from_check(ok, 1)

fn event_stream_payload_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(expected_payload_at(fixture_first(), 10), payload_instruction_immediate()))
    ok = all_passed(ok, same_tryte(expected_payload_at(fixture_first(), 15), payload_instruction_registers()))
    ok = all_passed(ok, same_tryte(expected_payload_at(fixture_simple_call(), 18), payload_instruction_call()))
    ok = all_passed(ok, same_tryte(expected_payload_at(fixture_sign(), 13), payload_instruction_branch()))
    ok = all_passed(ok, same_tryte(expected_payload_at(fixture_sign(), 33), payload_instruction_call()))
    ok = all_passed(ok, validate_event_stream_invalid_payload_probe())

    return status_from_check(ok, 1)

fn event_stream_signature_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(modeled_fixture_event_signature(fixture_first()), 81))
    ok = all_passed(ok, same_tryte(modeled_fixture_event_signature(fixture_simple_call()), 94))
    ok = all_passed(ok, same_tryte(modeled_fixture_event_signature(fixture_sign()), 170))
    ok = all_passed(ok, same_tryte(total_event_signature(), 345))
    ok = all_passed(ok, same_tryte(total_payload_signature(), 338))

    return status_from_check(ok, 1)

fn event_stream_totals_probe() -> tryte:
    return status_from_check(validate_total_event_counts(), 1)

fn event_stream_model_self_check() -> tryte:
    return status_from_check(validate_all_fixture_event_streams(), 1)

fn writer_state_error() -> tryte:
    return -1

fn writer_state_start() -> tryte:
    return 0

fn writer_state_after_header() -> tryte:
    return 1

fn writer_state_in_function() -> tryte:
    return 2

fn writer_state_after_label() -> tryte:
    return 3

fn writer_state_after_instruction() -> tryte:
    return 4

fn writer_state_after_end() -> tryte:
    return 5

fn writer_state_after_blank() -> tryte:
    return 6

fn writer_state_done() -> tryte:
    return 7

fn is_known_writer_state(state: tryte) -> trit:
    return in_range(state, writer_state_start(), writer_state_done())

fn is_writer_declaration_event(event: tryte) -> trit:
    return any_passed(
        same_tryte(event, event_emit_param()),
        any_passed(
            same_tryte(event, event_emit_register()),
            same_tryte(event, event_emit_memory())
        )
    )

fn next_writer_state_from_in_function(event: tryte) -> tryte:
    match is_writer_declaration_event(event) <=> 1:
        -1:
            match same_tryte(event, event_emit_label()) <=> 1:
                -1:
                    return writer_state_error()

                0:
                    return writer_state_after_label()

                1:
                    return writer_state_error()

        0:
            return writer_state_in_function()

        1:
            return writer_state_error()

fn next_writer_state_from_after_instruction(event: tryte) -> tryte:
    match same_tryte(event, event_emit_instruction()) <=> 1:
        -1:
            match same_tryte(event, event_emit_label()) <=> 1:
                -1:
                    match same_tryte(event, event_emit_end()) <=> 1:
                        -1:
                            return writer_state_error()

                        0:
                            return writer_state_after_end()

                        1:
                            return writer_state_error()

                0:
                    return writer_state_after_label()

                1:
                    return writer_state_error()

        0:
            return writer_state_after_instruction()

        1:
            return writer_state_error()

fn next_writer_state(state: tryte, event: tryte) -> tryte:
    match is_known_writer_state(state) <=> 1:
        -1:
            return writer_state_error()

        0:
            match is_known_event(event) <=> 1:
                -1:
                    return writer_state_error()

                0:
                    match same_tryte(state, writer_state_start()) <=> 1:
                        -1:
                            match same_tryte(state, writer_state_after_header()) <=> 1:
                                -1:
                                    match same_tryte(state, writer_state_after_blank()) <=> 1:
                                        -1:
                                            match same_tryte(state, writer_state_in_function()) <=> 1:
                                                -1:
                                                    match same_tryte(state, writer_state_after_label()) <=> 1:
                                                        -1:
                                                            match same_tryte(state, writer_state_after_instruction()) <=> 1:
                                                                -1:
                                                                    match same_tryte(state, writer_state_after_end()) <=> 1:
                                                                        -1:
                                                                            return writer_state_error()

                                                                        0:
                                                                            match same_tryte(event, event_emit_blank()) <=> 1:
                                                                                -1:
                                                                                    return writer_state_error()

                                                                                0:
                                                                                    return writer_state_after_blank()

                                                                                1:
                                                                                    return writer_state_error()

                                                                        1:
                                                                            return writer_state_error()

                                                                0:
                                                                    return next_writer_state_from_after_instruction(event)

                                                                1:
                                                                    return writer_state_error()

                                                        0:
                                                            match same_tryte(event, event_emit_instruction()) <=> 1:
                                                                -1:
                                                                    return writer_state_error()

                                                                0:
                                                                    return writer_state_after_instruction()

                                                                1:
                                                                    return writer_state_error()

                                                        1:
                                                            return writer_state_error()

                                                0:
                                                    return next_writer_state_from_in_function(event)

                                                1:
                                                    return writer_state_error()

                                        0:
                                            match same_tryte(event, event_emit_function()) <=> 1:
                                                -1:
                                                    return writer_state_error()

                                                0:
                                                    return writer_state_in_function()

                                                1:
                                                    return writer_state_error()

                                        1:
                                            return writer_state_error()

                                0:
                                    match same_tryte(event, event_emit_blank()) <=> 1:
                                        -1:
                                            return writer_state_error()

                                        0:
                                            return writer_state_after_blank()

                                        1:
                                            return writer_state_error()

                                1:
                                    return writer_state_error()

                        0:
                            match same_tryte(event, event_emit_header()) <=> 1:
                                -1:
                                    return writer_state_error()

                                0:
                                    return writer_state_after_header()

                                1:
                                    return writer_state_error()

                        1:
                            return writer_state_error()

                1:
                    return writer_state_error()

        1:
            return writer_state_error()

fn is_valid_writer_transition(state: tryte, event: tryte) -> trit:
    return is_known_writer_state(next_writer_state(state, event))

fn finalize_writer_state(state: tryte) -> tryte:
    match same_tryte(state, writer_state_after_end()) <=> 1:
        -1:
            return writer_state_error()

        0:
            return writer_state_done()

        1:
            return writer_state_error()

fn writer_event_score(state: tryte, event: tryte) -> tryte:
    match is_valid_writer_transition(state, event) <=> 1:
        -1:
            return unknown_encoding()

        0:
            return state + event + next_writer_state(state, event)

        1:
            return unknown_encoding()

fn expected_first_writer_state_before_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return writer_state_error()

        0:
            return writer_state_start()

        1:
            match index <=> 1:
                -1:
                    return writer_state_error()

                0:
                    return writer_state_after_header()

                1:
                    match index <=> 2:
                        -1:
                            return writer_state_error()

                        0:
                            return writer_state_after_blank()

                        1:
                            match in_range(index, 3, 9) <=> 1:
                                -1:
                                    match index <=> 10:
                                        -1:
                                            return writer_state_error()

                                        0:
                                            return writer_state_after_label()

                                        1:
                                            match in_range(index, 11, 17) <=> 1:
                                                -1:
                                                    return writer_state_error()

                                                0:
                                                    return writer_state_after_instruction()

                                                1:
                                                    return writer_state_error()

                                0:
                                    return writer_state_in_function()

                                1:
                                    return writer_state_error()

fn expected_simple_call_writer_state_before_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return writer_state_error()

        0:
            return writer_state_start()

        1:
            match index <=> 1:
                -1:
                    return writer_state_error()

                0:
                    return writer_state_after_header()

                1:
                    match index <=> 2:
                        -1:
                            return writer_state_error()

                        0:
                            return writer_state_after_blank()

                        1:
                            match in_range(index, 3, 6) <=> 1:
                                -1:
                                    match index <=> 7:
                                        -1:
                                            return writer_state_error()

                                        0:
                                            return writer_state_after_label()

                                        1:
                                            match in_range(index, 8, 9) <=> 1:
                                                -1:
                                                    match index <=> 10:
                                                        -1:
                                                            return writer_state_error()

                                                        0:
                                                            return writer_state_after_end()

                                                        1:
                                                            match index <=> 11:
                                                                -1:
                                                                    return writer_state_error()

                                                                0:
                                                                    return writer_state_after_blank()

                                                                1:
                                                                    match in_range(index, 12, 15) <=> 1:
                                                                        -1:
                                                                            match index <=> 16:
                                                                                -1:
                                                                                    return writer_state_error()

                                                                                0:
                                                                                    return writer_state_after_label()

                                                                                1:
                                                                                    match in_range(index, 17, 20) <=> 1:
                                                                                        -1:
                                                                                            return writer_state_error()

                                                                                        0:
                                                                                            return writer_state_after_instruction()

                                                                                        1:
                                                                                            return writer_state_error()

                                                                        0:
                                                                            return writer_state_in_function()

                                                                        1:
                                                                            return writer_state_error()

                                                0:
                                                    return writer_state_after_instruction()

                                                1:
                                                    return writer_state_error()

                                0:
                                    return writer_state_in_function()

                                1:
                                    return writer_state_error()

fn expected_sign_writer_state_before_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return writer_state_error()

        0:
            return writer_state_start()

        1:
            match index <=> 1:
                -1:
                    return writer_state_error()

                0:
                    return writer_state_after_header()

                1:
                    match index <=> 2:
                        -1:
                            return writer_state_error()

                        0:
                            return writer_state_after_blank()

                        1:
                            match in_range(index, 3, 10) <=> 1:
                                -1:
                                    match index <=> 11:
                                        -1:
                                            return writer_state_error()

                                        0:
                                            return writer_state_after_label()

                                        1:
                                            match in_range(index, 12, 14) <=> 1:
                                                -1:
                                                    match index <=> 15:
                                                        -1:
                                                            return writer_state_error()

                                                        0:
                                                            return writer_state_after_label()

                                                        1:
                                                            match in_range(index, 16, 18) <=> 1:
                                                                -1:
                                                                    match index <=> 19:
                                                                        -1:
                                                                            return writer_state_error()

                                                                        0:
                                                                            return writer_state_after_label()

                                                                        1:
                                                                            match in_range(index, 20, 21) <=> 1:
                                                                                -1:
                                                                                    match index <=> 22:
                                                                                        -1:
                                                                                            return writer_state_error()

                                                                                        0:
                                                                                            return writer_state_after_label()

                                                                                        1:
                                                                                            match in_range(index, 23, 24) <=> 1:
                                                                                                -1:
                                                                                                    match index <=> 25:
                                                                                                        -1:
                                                                                                            return writer_state_error()

                                                                                                        0:
                                                                                                            return writer_state_after_end()

                                                                                                        1:
                                                                                                            match index <=> 26:
                                                                                                                -1:
                                                                                                                    return writer_state_error()

                                                                                                                0:
                                                                                                                    return writer_state_after_blank()

                                                                                                                1:
                                                                                                                    match in_range(index, 27, 30) <=> 1:
                                                                                                                        -1:
                                                                                                                            match index <=> 31:
                                                                                                                                -1:
                                                                                                                                    return writer_state_error()

                                                                                                                                0:
                                                                                                                                    return writer_state_after_label()

                                                                                                                                1:
                                                                                                                                    match in_range(index, 32, 35) <=> 1:
                                                                                                                                        -1:
                                                                                                                                            return writer_state_error()

                                                                                                                                        0:
                                                                                                                                            return writer_state_after_instruction()

                                                                                                                                        1:
                                                                                                                                            return writer_state_error()

                                                                                                                        0:
                                                                                                                            return writer_state_in_function()

                                                                                                                        1:
                                                                                                                            return writer_state_error()

                                                                                                0:
                                                                                                    return writer_state_after_instruction()

                                                                                                1:
                                                                                                    return writer_state_error()

                                                                                0:
                                                                                    return writer_state_after_instruction()

                                                                                1:
                                                                                    return writer_state_error()

                                                                0:
                                                                    return writer_state_after_instruction()

                                                                1:
                                                                    return writer_state_error()

                                                0:
                                                    return writer_state_after_instruction()

                                                1:
                                                    return writer_state_error()

                                0:
                                    return writer_state_in_function()

                                1:
                                    return writer_state_error()

fn expected_writer_state_before_at(fixture: tryte, index: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return writer_state_error()

        0:
            return expected_first_writer_state_before_at(index)

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return writer_state_error()

                0:
                    return expected_simple_call_writer_state_before_at(index)

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return writer_state_error()

                        0:
                            return expected_sign_writer_state_before_at(index)

                        1:
                            return writer_state_error()

fn expected_writer_state_after_at(fixture: tryte, index: tryte) -> tryte:
    match validate_writer_index(fixture, index) <=> 1:
        -1:
            return writer_state_error()

        0:
            return next_writer_state(
                expected_writer_state_before_at(fixture, index),
                expected_event_at(fixture, index)
            )

        1:
            return writer_state_error()

fn expected_final_state(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return writer_state_error()

        0:
            return writer_state_done()

        1:
            return writer_state_error()

fn expected_line_advance_count(fixture: tryte) -> tryte:
    return expected_line_count(fixture)

fn expected_directive_event_count(fixture: tryte) -> tryte:
    return expected_directive_encoding_count(fixture)

fn expected_instruction_event_count(fixture: tryte) -> tryte:
    return expected_emit_instruction_count(fixture)

fn expected_blank_event_count(fixture: tryte) -> tryte:
    return expected_emit_blank_count(fixture)

fn expected_function_event_count(fixture: tryte) -> tryte:
    return expected_emit_function_count(fixture)

fn expected_end_event_count(fixture: tryte) -> tryte:
    return expected_emit_end_count(fixture)

fn expected_open_function_count(fixture: tryte) -> tryte:
    return expected_function_event_count(fixture)

fn expected_closed_function_count(fixture: tryte) -> tryte:
    return expected_end_event_count(fixture)

fn expected_open_function_balance(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return unknown_encoding()

        0:
            return expected_open_function_count(fixture) - expected_closed_function_count(fixture)

        1:
            return unknown_encoding()

fn expected_last_event(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return event_unknown()

        0:
            return event_emit_end()

        1:
            return event_unknown()

fn expected_writer_signature(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 70, 81, 126)

fn modeled_fixture_writer_signature(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return unknown_encoding()

        0:
            return expected_final_state(fixture) + expected_line_advance_count(fixture) + expected_event_count(fixture) + expected_directive_event_count(fixture) + expected_instruction_event_count(fixture) + expected_blank_event_count(fixture) + expected_function_event_count(fixture) + expected_end_event_count(fixture) + expected_last_event(fixture) + expected_open_function_balance(fixture)

        1:
            return unknown_encoding()

fn total_line_advance_count() -> tryte:
    return expected_line_advance_count(fixture_first()) + expected_line_advance_count(fixture_simple_call()) + expected_line_advance_count(fixture_sign())

fn total_directive_event_count() -> tryte:
    return expected_directive_event_count(fixture_first()) + expected_directive_event_count(fixture_simple_call()) + expected_directive_event_count(fixture_sign())

fn total_instruction_event_count() -> tryte:
    return expected_instruction_event_count(fixture_first()) + expected_instruction_event_count(fixture_simple_call()) + expected_instruction_event_count(fixture_sign())

fn total_blank_event_count() -> tryte:
    return expected_blank_event_count(fixture_first()) + expected_blank_event_count(fixture_simple_call()) + expected_blank_event_count(fixture_sign())

fn total_function_event_count() -> tryte:
    return expected_function_event_count(fixture_first()) + expected_function_event_count(fixture_simple_call()) + expected_function_event_count(fixture_sign())

fn total_end_event_count() -> tryte:
    return expected_end_event_count(fixture_first()) + expected_end_event_count(fixture_simple_call()) + expected_end_event_count(fixture_sign())

fn total_writer_signature() -> tryte:
    return modeled_fixture_writer_signature(fixture_first()) + modeled_fixture_writer_signature(fixture_simple_call()) + modeled_fixture_writer_signature(fixture_sign())

fn first_writer_final_state() -> tryte:
    return modeled_final_state(fixture_first())

fn simple_call_writer_final_state() -> tryte:
    return modeled_final_state(fixture_simple_call())

fn sign_writer_final_state() -> tryte:
    return modeled_final_state(fixture_sign())

fn first_writer_signature() -> tryte:
    return modeled_fixture_writer_signature(fixture_first())

fn simple_call_writer_signature() -> tryte:
    return modeled_fixture_writer_signature(fixture_simple_call())

fn sign_writer_signature() -> tryte:
    return modeled_fixture_writer_signature(fixture_sign())

fn validate_writer_index(fixture: tryte, index: tryte) -> trit:
    return all_passed(
        is_known_fixture(fixture),
        is_valid_index(index, expected_line_count(fixture))
    )

fn validate_writer_step(fixture: tryte, index: tryte) -> trit:
    match validate_writer_index(fixture, index) <=> 1:
        -1:
            return 0

        0:
            mut state: tryte = expected_writer_state_before_at(fixture, index)
            mut event: tryte = expected_event_at(fixture, index)
            mut next: tryte = expected_writer_state_after_at(fixture, index)
            mut ok: trit = 1

            ok = all_passed(ok, is_known_writer_state(state))
            ok = all_passed(ok, is_known_event(event))
            ok = all_passed(ok, is_valid_writer_transition(state, event))
            ok = all_passed(ok, same_tryte(next_writer_state(state, event), next))
            ok = all_passed(ok, same_tryte(1, 1))

            return ok

        1:
            return 0

fn validate_writer_continuity_at(fixture: tryte, index: tryte) -> trit:
    match is_valid_index(index, expected_line_count(fixture) - 1) <=> 1:
        -1:
            return 0

        0:
            return same_tryte(
                expected_writer_state_after_at(fixture, index),
                expected_writer_state_before_at(fixture, index + 1)
            )

        1:
            return 0

fn validate_writer_step_range(fixture: tryte, index: tryte, last: tryte) -> trit:
    match index <=> last:
        -1:
            return all_passed(
                validate_writer_step(fixture, index),
                validate_writer_step_range(fixture, index + 1, last)
            )

        0:
            return validate_writer_step(fixture, index)

        1:
            return 0

fn validate_writer_continuity_range(fixture: tryte, index: tryte, last: tryte) -> trit:
    match index <=> last:
        -1:
            return all_passed(
                validate_writer_continuity_at(fixture, index),
                validate_writer_continuity_range(fixture, index + 1, last)
            )

        0:
            return validate_writer_continuity_at(fixture, index)

        1:
            return 0

fn modeled_final_state(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return writer_state_error()

        0:
            return finalize_writer_state(
                expected_writer_state_after_at(fixture, expected_line_count(fixture) - 1)
            )

        1:
            return writer_state_error()

fn validate_fixture_writer_states(fixture: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            mut ok: trit = 1

            ok = all_passed(ok, validate_writer_step_range(fixture, 0, expected_line_count(fixture) - 1))
            ok = all_passed(ok, validate_writer_continuity_range(fixture, 0, expected_line_count(fixture) - 2))
            ok = all_passed(ok, same_tryte(modeled_final_state(fixture), expected_final_state(fixture)))
            ok = all_passed(ok, same_tryte(expected_last_event(fixture), expected_event_at(fixture, expected_line_count(fixture) - 1)))

            return ok

        1:
            return 0

fn validate_fixture_writer_counts(fixture: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            mut ok: trit = 1

            ok = all_passed(ok, same_tryte(expected_event_count(fixture), expected_line_count(fixture)))
            ok = all_passed(ok, same_tryte(expected_line_advance_count(fixture), expected_event_count(fixture)))
            ok = all_passed(ok, same_tryte(expected_directive_event_count(fixture), expected_emit_header_count(fixture) + expected_emit_function_count(fixture) + expected_emit_param_count(fixture) + expected_emit_register_count(fixture) + expected_emit_memory_count(fixture) + expected_emit_label_count(fixture) + expected_emit_end_count(fixture)))
            ok = all_passed(ok, same_tryte(expected_instruction_event_count(fixture), expected_emit_instruction_count(fixture)))
            ok = all_passed(ok, same_tryte(expected_blank_event_count(fixture), expected_emit_blank_count(fixture)))
            ok = all_passed(ok, same_tryte(expected_open_function_count(fixture), expected_closed_function_count(fixture)))
            ok = all_passed(ok, same_tryte(expected_open_function_balance(fixture), 0))

            return ok

        1:
            return 0

fn validate_total_writer_counts() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(total_line_advance_count(), 75))
    ok = all_passed(ok, same_tryte(total_directive_event_count(), 43))
    ok = all_passed(ok, same_tryte(total_instruction_event_count(), 27))
    ok = all_passed(ok, same_tryte(total_blank_event_count(), 5))
    ok = all_passed(ok, same_tryte(total_function_event_count(), 5))
    ok = all_passed(ok, same_tryte(total_end_event_count(), 5))

    return ok

fn validate_fixture_writer_signature(fixture: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            return same_tryte(modeled_fixture_writer_signature(fixture), expected_writer_signature(fixture))

        1:
            return 0

fn validate_total_writer_signature() -> trit:
    return same_tryte(total_writer_signature(), 277)

fn validate_invalid_fixture_probe() -> trit:
    return all_passed(
        same_trit(validate_fixture_writer_states(99), 0),
        same_trit(validate_fixture_writer_counts(99), 0)
    )

fn validate_invalid_index_probe() -> trit:
    return all_passed(
        same_trit(validate_writer_step(fixture_first(), 99), 0),
        same_trit(validate_writer_continuity_at(fixture_first(), 17), 0)
    )

fn validate_unknown_event_probe() -> trit:
    return all_passed(
        same_trit(is_known_event(event_unknown()), 0),
        same_trit(is_valid_writer_transition(writer_state_start(), event_unknown()), 0)
    )

fn validate_unknown_state_probe() -> trit:
    return all_passed(
        same_trit(is_known_writer_state(writer_state_error()), 0),
        same_trit(is_valid_writer_transition(writer_state_error(), event_emit_header()), 0)
    )

fn validate_invalid_writer_transition_probe() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, same_trit(is_valid_writer_transition(writer_state_start(), event_emit_instruction()), 0))
    ok = all_passed(ok, same_trit(is_valid_writer_transition(writer_state_after_header(), event_emit_function()), 0))
    ok = all_passed(ok, same_trit(is_valid_writer_transition(writer_state_in_function(), event_emit_end()), 0))
    ok = all_passed(ok, same_trit(is_valid_writer_transition(writer_state_after_label(), event_emit_register()), 0))
    ok = all_passed(ok, same_trit(is_valid_writer_transition(writer_state_after_end(), event_emit_instruction()), 0))
    ok = all_passed(ok, same_trit(is_valid_writer_transition(writer_state_done(), event_emit_blank()), 0))

    return ok

fn validate_all_fixture_writer_models() -> trit:
    mut ok: trit = 1

    ok = all_passed(ok, validate_writer_step(fixture_first(), 0))
    ok = all_passed(ok, validate_writer_step(fixture_first(), 1))
    ok = all_passed(ok, validate_writer_step(fixture_first(), 10))
    ok = all_passed(ok, validate_writer_step(fixture_simple_call(), 10))
    ok = all_passed(ok, validate_writer_step(fixture_simple_call(), 18))
    ok = all_passed(ok, validate_writer_step(fixture_sign(), 14))
    ok = all_passed(ok, validate_writer_step(fixture_sign(), 25))
    ok = all_passed(ok, validate_writer_step(fixture_sign(), 33))
    ok = all_passed(ok, validate_writer_continuity_at(fixture_first(), 1))
    ok = all_passed(ok, validate_writer_continuity_at(fixture_simple_call(), 10))
    ok = all_passed(ok, validate_writer_continuity_at(fixture_sign(), 25))
    ok = all_passed(ok, validate_fixture_writer_counts(fixture_first()))
    ok = all_passed(ok, validate_fixture_writer_counts(fixture_simple_call()))
    ok = all_passed(ok, validate_fixture_writer_counts(fixture_sign()))
    ok = all_passed(ok, validate_fixture_writer_signature(fixture_first()))
    ok = all_passed(ok, validate_fixture_writer_signature(fixture_simple_call()))
    ok = all_passed(ok, validate_fixture_writer_signature(fixture_sign()))
    ok = all_passed(ok, validate_total_writer_counts())
    ok = all_passed(ok, validate_total_writer_signature())
    ok = all_passed(ok, validate_invalid_fixture_probe())
    ok = all_passed(ok, validate_invalid_index_probe())
    ok = all_passed(ok, validate_unknown_event_probe())
    ok = all_passed(ok, validate_unknown_state_probe())
    ok = all_passed(ok, validate_invalid_writer_transition_probe())

    return ok

fn event_writer_first_probe() -> tryte:
    return status_from_check(validate_fixture_writer_states(fixture_first()), 1)

fn event_writer_simple_call_probe() -> tryte:
    return status_from_check(validate_fixture_writer_states(fixture_simple_call()), 1)

fn event_writer_sign_probe() -> tryte:
    return status_from_check(validate_fixture_writer_states(fixture_sign()), 1)

fn event_writer_counts_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, validate_fixture_writer_counts(fixture_first()))
    ok = all_passed(ok, validate_fixture_writer_counts(fixture_simple_call()))
    ok = all_passed(ok, validate_fixture_writer_counts(fixture_sign()))
    ok = all_passed(ok, validate_total_writer_counts())

    return status_from_check(ok, 1)

fn event_writer_signature_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(modeled_fixture_writer_signature(fixture_first()), 70))
    ok = all_passed(ok, same_tryte(modeled_fixture_writer_signature(fixture_simple_call()), 81))
    ok = all_passed(ok, same_tryte(modeled_fixture_writer_signature(fixture_sign()), 126))
    ok = all_passed(ok, same_tryte(total_writer_signature(), 277))

    return status_from_check(ok, 1)

fn event_writer_transition_probe() -> tryte:
    mut ok: trit = 1

    ok = all_passed(ok, same_tryte(writer_event_score(writer_state_start(), event_emit_header()), 1))
    ok = all_passed(ok, same_tryte(writer_event_score(writer_state_after_header(), event_emit_blank()), 15))
    ok = all_passed(ok, same_tryte(writer_event_score(writer_state_in_function(), event_emit_register()), 7))
    ok = all_passed(ok, same_tryte(writer_event_score(writer_state_after_instruction(), event_emit_end()), 16))
    ok = all_passed(ok, validate_invalid_writer_transition_probe())

    return status_from_check(ok, 1)

fn event_writer_model_self_check() -> tryte:
    return status_from_check(validate_all_fixture_writer_models(), 1)

fn line_content_encoding_model_self_check() -> tryte:
    return status_from_check(validate_all_fixture_line_encodings(), 1)

fn main() -> tryte:
    return event_writer_model_self_check()
