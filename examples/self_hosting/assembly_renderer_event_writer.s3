fn validate_fixture_event_counts(fixture: tryte) -> trit:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return 0

        0:
            mut ok: trit = 1

            ok = all_passed(ok, same_tryte(expected_event_count(fixture), expected_line_count(fixture)))
            ok = all_passed(ok, same_tryte(expected_emit_instruction_count(fixture), expected_instruction_encoding_count(fixture)))
            ok = all_passed(ok, same_tryte(expected_emit_blank_count(fixture), expected_blank_encoding_count(fixture)))

            return ok

        1:
            return 0

