fn validate_fixture_event_stream(fixture: tryte) -> trit:
    match fixture <=> fixture_first():
        -1:
            return 0

        0:
            return validate_first_event_stream()

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return 0

                0:
                    return validate_simple_call_event_stream()

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return 0

                        0:
                            return validate_sign_event_stream()

                        1:
                            return 0

fn is_valid_event_transition(left: tryte, right: tryte) -> trit:
    match same_tryte(left, event_emit_header()) <=> 1:
        -1:
            match same_tryte(left, event_emit_blank()) <=> 1:
                -1:
                    match same_tryte(left, event_emit_function()) <=> 1:
                        -1:
                            match same_tryte(left, event_emit_param()) <=> 1:
                                -1:
                                    match same_tryte(left, event_emit_register()) <=> 1:
                                        -1:
                                            match same_tryte(left, event_emit_label()) <=> 1:
                                                -1:
                                                    match same_tryte(left, event_emit_instruction()) <=> 1:
                                                        -1:
                                                            match same_tryte(left, event_emit_end()) <=> 1:
                                                                -1:
                                                                    return 0

                                                                0:
                                                                    return same_tryte(right, event_emit_blank())

                                                                1:
                                                                    return 0

                                                        0:
                                                            return any_passed(
                                                                same_tryte(right, event_emit_instruction()),
                                                                any_passed(
                                                                    same_tryte(right, event_emit_label()),
                                                                    same_tryte(right, event_emit_end())
                                                                )
                                                            )

                                                        1:
                                                            return 0

                                                0:
                                                    return same_tryte(right, event_emit_instruction())

                                                1:
                                                    return 0

                                        0:
                                            return any_passed(
                                                same_tryte(right, event_emit_register()),
                                                same_tryte(right, event_emit_label())
                                            )

                                        1:
                                            return 0

                                0:
                                    return any_passed(
                                        same_tryte(right, event_emit_param()),
                                        same_tryte(right, event_emit_register())
                                    )

                                1:
                                    return 0

                        0:
                            return any_passed(
                                same_tryte(right, event_emit_param()),
                                same_tryte(right, event_emit_register())
                            )

                        1:
                            return 0

                0:
                    return same_tryte(right, event_emit_function())

                1:
                    return 0

        0:
            return same_tryte(right, event_emit_blank())

        1:
            return 0

fn validate_event_transition_at(fixture: tryte, index: tryte) -> trit:
    match is_valid_index(index, expected_line_count(fixture) - 1) <=> 1:
        -1:
            return 0

        0:
            return is_valid_event_transition(
                expected_event_at(fixture, index),
                expected_event_at(fixture, index + 1)
            )

        1:
            return 0

