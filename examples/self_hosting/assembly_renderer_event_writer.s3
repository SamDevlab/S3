fn expected_first_blueprint_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return unknown_encoding()

        0:
            return blueprint_s3asm_header()

        1:
            match index <=> 1:
                -1:
                    return unknown_encoding()

                0:
                    return blueprint_blank_line()

                1:
                    match index <=> 2:
                        -1:
                            return unknown_encoding()

                        0:
                            return blueprint_function_header()

                        1:
                            match in_range(index, 3, 8) <=> 1:
                                -1:
                                    match index <=> 9:
                                        -1:
                                            return unknown_encoding()

                                        0:
                                            return blueprint_label()

                                        1:
                                            match in_range(index, 10, 16) <=> 1:
                                                -1:
                                                    match index <=> 17:
                                                        -1:
                                                            return unknown_encoding()

                                                        0:
                                                            return blueprint_end()

                                                        1:
                                                            return unknown_encoding()

                                                0:
                                                    return blueprint_instruction_with_source()

                                                1:
                                                    return unknown_encoding()

                                0:
                                    return blueprint_register()

                                1:
                                    return unknown_encoding()

fn expected_simple_call_blueprint_at(index: tryte) -> tryte:
    match index <=> 0:
