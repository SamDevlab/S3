# Bootstrap event writer state model for a future S3 Assembly renderer.
# It consumes modeled render events and updates writer state with numeric IDs only.

fn fixture_first() -> tryte:
    return 0

fn fixture_simple_call() -> tryte:
    return 1

fn fixture_sign() -> tryte:
    return 2

fn unknown_encoding() -> tryte:
    return -1

fn blueprint_s3asm_header() -> tryte:
    return 0

fn blueprint_function_header() -> tryte:
    return 1

fn blueprint_param() -> tryte:
    return 2

fn blueprint_register() -> tryte:
    return 3

fn blueprint_memory() -> tryte:
    return 4

fn blueprint_label() -> tryte:
    return 5

fn blueprint_instruction() -> tryte:
    return 6

fn blueprint_instruction_with_source() -> tryte:
    return 7

fn blueprint_end() -> tryte:
    return 8

fn blueprint_blank_line() -> tryte:
    return 9

fn directive_none() -> tryte:
    return 0

fn directive_s3asm() -> tryte:
    return 1

fn directive_function() -> tryte:
    return 2

fn directive_param() -> tryte:
