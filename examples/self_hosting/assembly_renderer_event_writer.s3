                                -1:
                                    match index <=> 5:
                                        -1:
                                            return unknown_encoding()

                                        0:
                                            return blueprint_register()

                                        1:
                                            match index <=> 6:
                                                -1:
                                                    return unknown_encoding()

                                                0:
                                                    return blueprint_label()

                                                1:
                                                    match in_range(index, 7, 8) <=> 1:
                                                        -1:
                                                            match index <=> 9:
                                                                -1:
                                                                    return unknown_encoding()

                                                                0:
                                                                    return blueprint_end()

                                                                1:
                                                                    match index <=> 10:
                                                                        -1:
                                                                            return unknown_encoding()

                                                                        0:
                                                                            return blueprint_blank_line()

                                                                        1:
                                                                            match index <=> 11:
                                                                                -1:
                                                                                    return unknown_encoding()

                                                                                0:
                                                                                    return blueprint_function_header()

                                                                                1:
                                                                                    match in_range(index, 12, 14) <=> 1:
                                                                                        -1:
                                                                                            match index <=> 15:
                                                                                                -1:
                                                                                                    return unknown_encoding()

                                                                                                0:
                                                                                                    return blueprint_label()

                                                                                                1:
                                                                                                    match in_range(index, 16, 19) <=> 1:
                                                                                                        -1:
                                                                                                            match index <=> 20:
                                                                                                                -1:
                                                                                                                    return unknown_encoding()

                                                                                                                0:
                                                                                                                    return blueprint_end()

                                                                                                                1:
                                                                                                                    return unknown_encoding()

                                                                                                        0:
                                                                                                            return blueprint_instruction_with_source()

                                                                                                        1:
                                                                                                            return unknown_encoding()

                                                                                        0:
                                                                                            return blueprint_register()

                                                                                        1:
                                                                                            return unknown_encoding()

                                                        0:
                                                            return blueprint_instruction_with_source()

                                                        1:
                                                            return unknown_encoding()

                                0:
                                    return blueprint_param()

                                1:
                                    return unknown_encoding()

fn expected_sign_blueprint_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return unknown_encoding()

        0:
            return blueprint_s3asm_header()

        1:
            match index <=> 1:
                -1:
                    return unknown_encoding()

                0:
                    return blueprint_blank_line()

                1:
                    match index <=> 2:
                        -1:
                            return unknown_encoding()

                        0:
                            return blueprint_function_header()

                        1:
                            match index <=> 3:
                                -1:
                                    return unknown_encoding()

                                0:
                                    return blueprint_param()

                                1:
                                    match in_range(index, 4, 9) <=> 1:
                                        -1:
                                            match index <=> 10:
                                                -1:
                                                    return unknown_encoding()

                                                0:
                                                    return blueprint_label()

                                                1:
                                                    match in_range(index, 11, 13) <=> 1:
                                                        -1:
                                                            match index <=> 14:
                                                                -1:
                                                                    return unknown_encoding()

                                                                0:
                                                                    return blueprint_label()

                                                                1:
                                                                    match in_range(index, 15, 17) <=> 1:
                                                                        -1:
                                                                            match index <=> 18:
                                                                                -1:
                                                                                    return unknown_encoding()

                                                                                0:
                                                                                    return blueprint_label()

                                                                                1:
                                                                                    match in_range(index, 19, 20) <=> 1:
                                                                                        -1:
                                                                                            match index <=> 21:
                                                                                                -1:
                                                                                                    return unknown_encoding()

                                                                                                0:
                                                                                                    return blueprint_label()

                                                                                                1:
