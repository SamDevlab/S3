        0:
            return first_modeled_encoding_signature()

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return unknown_encoding()

                0:
                    return simple_call_modeled_encoding_signature()

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return unknown_encoding()

                        0:
                            return sign_modeled_encoding_signature()

                        1:
                            return unknown_encoding()

