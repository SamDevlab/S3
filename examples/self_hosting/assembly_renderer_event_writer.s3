fn opcode_tjmp() -> tryte:
    return 12

fn opcode_tbr3() -> tryte:
    return 13

fn category_directive() -> tryte:
    return 0

fn category_instruction() -> tryte:
    return 1

fn category_blank() -> tryte:
    return 2

fn event_unknown() -> tryte:
    return -1

