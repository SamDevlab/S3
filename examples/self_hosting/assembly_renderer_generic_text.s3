fn symbol_length(id: tryte) -> tryte:
    match id <=> 1:
        -1:
            skip_symbol_length_0n: tryte = 0
        0:
            return 4
        1:
            skip_symbol_length_0p: tryte = 0
    match id <=> 2:
        -1:
            skip_symbol_length_1n: tryte = 0
        0:
            return 5
        1:
            skip_symbol_length_1p: tryte = 0
    match id <=> 3:
        -1:
            skip_symbol_length_2n: tryte = 0
        0:
            return 2
        1:
            skip_symbol_length_2p: tryte = 0
    match id <=> 4:
        -1:
            skip_symbol_length_3n: tryte = 0
        0:
            return 2
        1:
            skip_symbol_length_3p: tryte = 0
    match id <=> 5:
