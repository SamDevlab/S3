                -1:
                    return 1
                0:
                    return 2
                1:
                    return 3
        0:
            return 2
        1:
            return 2

fn decimal_byte_at(value: tryte, idx: tryte) -> tryte:
    match value <=> 10:
        -1:
            match value <=> 100:
                -1:
                    match idx <=> 0:
                        -1:
                            return 0
                        0:
                            return value + 48
                        1:
                            return 0
                0:
                    match idx <=> 0:
                        -1:
                            return 0
                        0:
                            return 49
                        1:
                            match idx <=> 1:
                                -1:
                                    return 0
                                0:
                                    return value - 10 + 48
                                1:
                                    return 0
                1:
                    match idx <=> 0:
                        -1:
                            return 0
                        0:
                            return 49
                        1:
                            match idx <=> 1:
                                -1:
                                    return 0
                                0:
                                    return 48
                                1:
                                    match idx <=> 2:
                                        -1:
                                            return 0
                                        0:
                                            return value - 100 + 48
                                        1:
                                            return 0
        0:
            match idx <=> 0:
                -1:
                    return 0
                0:
                    return 49
                1:
                    match idx <=> 1:
                        -1:
                            return 0
                        0:
                            return 48
                        1:
                            return 0
        1:
            match idx <=> 0:
                -1:
                    return 0
                0:
                    return 49
                1:
                    match idx <=> 1:
                        -1:
                            return 0
                        0:
                            return 48
                        1:
                            return 0

