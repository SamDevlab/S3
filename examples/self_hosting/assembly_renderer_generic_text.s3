                -1:
                    skip_buf: tryte = 0
                0:
                    buffer_low[buf_offset] = byte_val
                1:
                    buffer_high[buf_offset] = byte_val
            buf_offset = buf_offset + 1
            match buf_offset <=> 300:
                0:
                    buffer_idx = 1
                    buf_offset = 0
                -1:
                    skip_switch: tryte = 0
                1:
                    skip_switch: tryte = 0
            byte_idx = byte_idx + 1
        evt_idx = evt_idx + 1
    return 0

