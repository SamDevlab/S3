# Scalar text builder command model for the future Assembly renderer.
# Logical byte totals use a base-300 block and remainder pair for tryte safety.

fn fixture_first() -> tryte:
    return 0

fn fixture_simple_call() -> tryte:
    return 1

fn fixture_sign() -> tryte:
    return 2

fn builder_unknown() -> tryte:
    return -1

fn builder_cmd_unknown() -> tryte:
    return -1

fn builder_cmd_start_document() -> tryte:
    return 0

fn builder_cmd_emit_header_line() -> tryte:
    return 1

fn builder_cmd_emit_function_line() -> tryte:
    return 2

fn builder_cmd_emit_param_line() -> tryte:
    return 3

fn builder_cmd_emit_register_line() -> tryte:
    return 4

fn builder_cmd_emit_memory_line() -> tryte:
    return 5

fn builder_cmd_emit_label_line() -> tryte:
    return 6

fn builder_cmd_emit_instruction_line() -> tryte:
    return 7

fn builder_cmd_emit_source_metadata() -> tryte:
    return 8

fn builder_cmd_emit_end_line() -> tryte:
    return 9

fn builder_cmd_emit_blank_line() -> tryte:
    return 10

fn builder_cmd_finish_document() -> tryte:
    return 11

fn builder_state_error() -> tryte:
    return -1

fn builder_state_empty() -> tryte:
    return 0

fn builder_state_document_open() -> tryte:
    return 1

fn builder_state_line_open() -> tryte:
    return 2

fn builder_state_line_closed() -> tryte:
    return 3

fn builder_state_document_done() -> tryte:
    return 4

fn same_tryte(left: tryte, right: tryte) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn same_trit(left: trit, right: trit) -> trit:
    match left <=> right:
        -1:
            return 0

        0:
            return 1

        1:
            return 0

fn all_passed(left: trit, right: trit) -> trit:
    match left <=> 1:
        -1:
            return 0

        0:
            match right <=> 1:
                -1:
                    return 0

                0:
                    return 1

                1:
                    return 0

        1:
            return 0

fn any_passed(left: trit, right: trit) -> trit:
    match left <=> 1:
        -1:
            return right

        0:
            return 1

        1:
            return 1

fn status_from_check(check: trit, failure: tryte) -> tryte:
    match check <=> 1:
        -1:
            return failure

        0:
            return 0

        1:
            return failure

fn in_range(value: tryte, lower: tryte, upper: tryte) -> trit:
    match value <=> lower:
        -1:
            return 0

        0:
            return 1

        1:
            match value <=> upper:
                -1:
                    return 1

                0:
                    return 1

                1:
                    return 0

fn fixture_metric(fixture: tryte, first_value: tryte, simple_value: tryte, sign_value: tryte) -> tryte:
    match fixture <=> fixture_first():
        -1:
            return builder_unknown()

        0:
            return first_value

        1:
            match fixture <=> fixture_simple_call():
                -1:
                    return builder_unknown()

                0:
                    return simple_value

                1:
                    match fixture <=> fixture_sign():
                        -1:
                            return builder_unknown()

                        0:
                            return sign_value

                        1:
                            return builder_unknown()

fn is_even(value: tryte) -> trit:
    match value <=> 0:
        -1:
            return 0

        0:
            return 1

        1:
            return is_odd(value - 1)

fn is_odd(value: tryte) -> trit:
    match value <=> 0:
        -1:
            return 0

        0:
            return 0

        1:
            return is_even(value - 1)

fn paired_command_at(index: tryte, start: tryte) -> tryte:
    match is_even(index - start) <=> 1:
        -1:
            return builder_cmd_emit_source_metadata()

        0:
            return builder_cmd_emit_instruction_line()

        1:
            return builder_cmd_emit_source_metadata()

fn is_known_fixture(fixture: tryte) -> trit:
    return in_range(fixture, fixture_first(), fixture_sign())

fn is_known_builder_command(command: tryte) -> trit:
    return in_range(command, builder_cmd_start_document(), builder_cmd_finish_document())

fn is_known_builder_state(state: tryte) -> trit:
    return in_range(state, builder_state_empty(), builder_state_document_done())

fn is_line_command(command: tryte) -> trit:
    match in_range(command, builder_cmd_emit_header_line(), builder_cmd_emit_instruction_line()) <=> 1:
        -1:
            return in_range(command, builder_cmd_emit_end_line(), builder_cmd_emit_blank_line())

        0:
            return 1

        1:
            return in_range(command, builder_cmd_emit_end_line(), builder_cmd_emit_blank_line())

fn is_document_command(command: tryte) -> trit:
    return all_passed(
        same_trit(is_known_builder_command(command), 1),
        all_passed(same_trit(is_line_command(command), 0), same_trit(is_metadata_command(command), 0))
    )

fn is_metadata_command(command: tryte) -> trit:
    return same_tryte(command, builder_cmd_emit_source_metadata())

fn expected_line_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 18, 21, 36)

fn expected_command_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 27, 29, 52)

fn expected_newline_count(fixture: tryte) -> tryte:
    return expected_line_count(fixture)

fn expected_indentation_write_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 13, 12, 24)

fn expected_token_write_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 17, 19, 34)

fn expected_source_metadata_write_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 7, 6, 14)

fn expected_blank_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 2, 2)

fn logical_byte_chunk_size() -> tryte:
    return 300

fn expected_logical_byte_chunk_count(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 1, 1, 3)

fn expected_logical_byte_remainder(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 141, 148, 46)

fn builder_signature_from_counts(line_count: tryte, command_count: tryte, newline_count: tryte, source_metadata_count: tryte, token_count: tryte) -> tryte:
    return line_count + command_count + newline_count + source_metadata_count + token_count

fn expected_builder_signature(fixture: tryte) -> tryte:
    return fixture_metric(fixture, 87, 96, 172)

fn modeled_builder_signature(fixture: tryte) -> tryte:
    match is_known_fixture(fixture) <=> 1:
        -1:
            return builder_unknown()

        0:
            return builder_signature_from_counts(
                expected_line_count(fixture),
                expected_command_count(fixture),
                expected_newline_count(fixture),
                expected_source_metadata_write_count(fixture),
                expected_token_write_count(fixture)
            )

        1:
            return builder_unknown()

fn total_line_count() -> tryte:
    return expected_line_count(fixture_first()) + expected_line_count(fixture_simple_call()) + expected_line_count(fixture_sign())

fn total_command_count() -> tryte:
    return expected_command_count(fixture_first()) + expected_command_count(fixture_simple_call()) + expected_command_count(fixture_sign())

fn total_newline_count() -> tryte:
    return expected_newline_count(fixture_first()) + expected_newline_count(fixture_simple_call()) + expected_newline_count(fixture_sign())

fn total_indentation_write_count() -> tryte:
    return expected_indentation_write_count(fixture_first()) + expected_indentation_write_count(fixture_simple_call()) + expected_indentation_write_count(fixture_sign())

fn total_token_write_count() -> tryte:
    return expected_token_write_count(fixture_first()) + expected_token_write_count(fixture_simple_call()) + expected_token_write_count(fixture_sign())

fn total_source_metadata_write_count() -> tryte:
    return expected_source_metadata_write_count(fixture_first()) + expected_source_metadata_write_count(fixture_simple_call()) + expected_source_metadata_write_count(fixture_sign())

fn total_logical_byte_chunk_count() -> tryte:
    return expected_logical_byte_chunk_count(fixture_first()) + expected_logical_byte_chunk_count(fixture_simple_call()) + expected_logical_byte_chunk_count(fixture_sign())

fn total_logical_byte_remainder() -> tryte:
    return expected_logical_byte_remainder(fixture_first()) + expected_logical_byte_remainder(fixture_simple_call()) + expected_logical_byte_remainder(fixture_sign())

fn total_builder_signature() -> tryte:
    return expected_builder_signature(fixture_first()) + expected_builder_signature(fixture_simple_call()) + expected_builder_signature(fixture_sign())

fn expected_total_builder_signature() -> tryte:
    return 355

fn expected_first_builder_command_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return builder_cmd_unknown()

        0:
            return builder_cmd_start_document()

        1:
            match index <=> 1:
                -1:
                    return builder_cmd_unknown()

                0:
                    return builder_cmd_emit_header_line()

                1:
                    match index <=> 2:
                        -1:
                            return builder_cmd_unknown()

                        0:
                            return builder_cmd_emit_blank_line()

                        1:
                            match index <=> 3:
                                -1:
                                    return builder_cmd_unknown()

                                0:
                                    return builder_cmd_emit_function_line()

                                1:
                                    return expected_first_builder_body_command_at(index)

fn expected_first_builder_body_command_at(index: tryte) -> tryte:
    match in_range(index, 4, 9) <=> 1:
        -1:
            match index <=> 10:
                -1:
                    return builder_cmd_unknown()

                0:
                    return builder_cmd_emit_label_line()

                1:
                    match in_range(index, 11, 24) <=> 1:
                        -1:
                            match index <=> 25:
                                -1:
                                    return builder_cmd_unknown()

                                0:
                                    return builder_cmd_emit_end_line()

                                1:
                                    match index <=> 26:
                                        -1:
                                            return builder_cmd_unknown()

                                        0:
                                            return builder_cmd_finish_document()

                                        1:
                                            return builder_cmd_unknown()

                        0:
                            return paired_command_at(index, 11)

                        1:
                            return builder_cmd_unknown()

        0:
            return builder_cmd_emit_register_line()

        1:
            return builder_cmd_unknown()

fn expected_simple_call_builder_command_at(index: tryte) -> tryte:
    match index <=> 0:
        -1:
            return builder_cmd_unknown()

        0:
            return builder_cmd_start_document()

        1:
            match index <=> 1:
                -1:
                    return builder_cmd_unknown()

                0:
                    return builder_cmd_emit_header_line()

                1:
                    match index <=> 2:
                        -1:
                            return builder_cmd_unknown()

                        0:
                            return builder_cmd_emit_blank_line()

                        1:
                            match index <=> 3:
                                -1:
                                    return builder_cmd_unknown()

                                0:
                                    return builder_cmd_emit_function_line()

                                1:
                                    return expected_simple_call_builder_body_command_at(index)

fn expected_simple_call_builder_body_command_at(index: tryte) -> tryte:
    match in_range(index, 4, 5) <=> 1:
        -1:
            match index <=> 6:
                -1:
                    return builder_cmd_unknown()

                0:
                    return builder_cmd_emit_register_line()

                1:
                    match index <=> 7:
                        -1:
                            return builder_cmd_unknown()

                        0:
                            return builder_cmd_emit_label_line()

                        1:
                            return expected_simple_call_builder_tail_command_at(index)

        0:
            return builder_cmd_emit_param_line()

        1:
            return builder_cmd_unknown()

fn expected_simple_call_builder_tail_command_at(index: tryte) -> tryte:
    match in_range(index, 8, 11) <=> 1:
        -1:
            match index <=> 12:
                -1:
                    return builder_cmd_unknown()

                0:
                    return builder_cmd_emit_end_line()

                1:
                    match index <=> 13:
                        -1:
                            return builder_cmd_unknown()

                        0:
                            return builder_cmd_emit_blank_line()

                        1:
                            match index <=> 14:
                                -1:
                                    return builder_cmd_unknown()

                                0:
                                    return builder_cmd_emit_function_line()

                                1:
                                    return expected_simple_call_builder_second_command_at(index)

        0:
            return paired_command_at(index, 8)

        1:
            return builder_cmd_unknown()

fn expected_simple_call_builder_second_command_at(index: tryte) -> tryte:
    match in_range(index, 15, 17) <=> 1:
        -1:
            match index <=> 18:
                -1:
                    return builder_cmd_unknown()

                0:
                    return builder_cmd_emit_label_line()

                1:
                    match in_range(index, 19, 26) <=> 1:
                        -1:
                            match index <=> 27:
                                -1:
                                    return builder_cmd_unknown()

                                0:
                                    return builder_cmd_emit_end_line()

                                1:
                                    match index <=> 28:
                                        -1:
                                            return builder_cmd_unknown()

                                        0:
                                            return builder_cmd_finish_document()

                                        1:
                                            return builder_cmd_unknown()

                        0:
                            return paired_command_at(index, 19)

                        1:
                            return builder_cmd_unknown()

        0:
            return builder_cmd_emit_register_line()

        1:
            return builder_cmd_unknown()

