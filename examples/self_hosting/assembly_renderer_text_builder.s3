            return builder_cmd_unknown()

fn expected_sign_builder_second_function_command_at(index: tryte) -> tryte:
    match in_range(index, 26, 29) <=> 1:
        -1:
            match index <=> 30:
                -1:
                    return builder_cmd_unknown()

                0:
                    return builder_cmd_emit_label_line()

