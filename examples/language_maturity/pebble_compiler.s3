record PebbleStep:
    valid: trit
    next: i64
    node: i64

fn pebble_digit(code: i64) -> trit:
    match code <=> 48:
        -1:
            return 0
        0:
            return -1
        1:
            match code <=> 58:
                -1:
                    return -1
                0:
                    return 0
                1:
                    return 0

fn pebble_space(code: i64) -> trit:
    match code <=> 32:
        -1:
            return 0
        0:
            return -1
        1:
            match code <=> 33:
                -1:
                    return 0
                0:
                    return 0
                1:
                    match code <=> 112:
                        -1:
                            match code <=> 10:
                                -1:
                                    return 0
                                0:
                                    return -1
                                1:
                                    match code <=> 13:
                                        -1:
                                            return 0
                                        0:
                                            return -1
                                        1:
                                            return 0
                        0:
                            return 0
                        1:
                            return 0

fn pebble_identifier(code: i64) -> trit:
    match code <=> 97:
        -1:
            return 0
        0:
            return -1
        1:
            match code <=> 112:
                -1:
                    return -1
                0:
                    return -1
                1:
                    return 0

fn pebble_token(kinds: &mut i64_vector, values: &mut i64_vector, kind: i64, value: i64) -> tryte:
    discard i64_vector_push(kinds, kind)
    discard i64_vector_push(values, value)
    return 0

fn tokenize_pebble(input: &text, kinds: &mut i64_vector, values: &mut i64_vector) -> trit:
    mut source: bytes = bytes_from_text(input)
    mut length: i64 = bytes_len(&source)
    mut cursor: i64 = 0
    while cursor < length:
        mut code: i64 = to_i64(bytes_get(&source, cursor))
        match pebble_space(code):
            -1:
                cursor = cursor + 1
            0:
                match pebble_digit(code):
                    -1:
                        mut number: i64 = 0
                        while cursor < length:
                            mut digit_code: i64 = to_i64(bytes_get(&source, cursor))
                            match pebble_digit(digit_code):
                                -1:
                                    number = number * 10 + digit_code - 48
                                    cursor = cursor + 1
                                0:
                                    break
                                1:
                                    break
                        discard pebble_token(kinds, values, 1, number)
                    0:
                        match pebble_identifier(code):
                            -1:
                                discard pebble_token(kinds, values, 2, code - 97)
                                cursor = cursor + 1
                            0:
                                match code <=> 33:
                                    -1:
                                        return 0
                                    0:
                                        discard pebble_token(kinds, values, 6, 0)
                                        cursor = cursor + 1
                                    1:
                                        match code <=> 43:
                                            -1:
                                                return 0
                                            0:
                                                discard pebble_token(kinds, values, 4, 0)
                                                cursor = cursor + 1
                                            1:
                                                match code <=> 45:
                                                    -1:
                                                        return 0
                                                    0:
                                                        discard pebble_token(kinds, values, 5, 0)
                                                        cursor = cursor + 1
                                                    1:
                                                        match code <=> 59:
                                                            -1:
                                                                return 0
                                                            0:
                                                                discard pebble_token(kinds, values, 7, 0)
                                                                cursor = cursor + 1
                                                            1:
                                                                match code <=> 61:
                                                                    -1:
                                                                        return 0
                                                                    0:
                                                                        discard pebble_token(kinds, values, 3, 0)
                                                                        cursor = cursor + 1
                                                                    1:
                                                                        return 0
                            1:
                                return 0
                    1:
                        return 0
            1:
                return 0
    discard pebble_token(kinds, values, 0, 0)
    return -1

fn pebble_append_node(
    kinds: &mut i64_vector,
    values: &mut i64_vector,
    left: &mut i64_vector,
    right: &mut i64_vector,
    kind: i64,
    value: i64,
    left_node: i64,
    right_node: i64
) -> i64:
    mut node: i64 = i64_vector_len(&*kinds)
    discard i64_vector_push(kinds, kind)
    discard i64_vector_push(values, value)
    discard i64_vector_push(left, left_node)
    discard i64_vector_push(right, right_node)
    return node

fn parse_pebble_primary(
    token_kinds: &i64_vector,
    token_values: &i64_vector,
    cursor: i64,
    node_kinds: &mut i64_vector,
    node_values: &mut i64_vector,
    node_left: &mut i64_vector,
    node_right: &mut i64_vector
) -> PebbleStep:
    mut kind: i64 = i64_vector_get(token_kinds, cursor)
    match kind <=> 1:
        -1:
            return PebbleStep(valid=0, next=cursor, node=0)
        0:
            mut node: i64 = pebble_append_node(
                node_kinds, node_values, node_left, node_right,
                1, i64_vector_get(token_values, cursor), -1, -1
            )
            return PebbleStep(valid=-1, next=cursor + 1, node=node)
        1:
            match kind <=> 2:
                -1:
                    return PebbleStep(valid=0, next=cursor, node=0)
                0:
                    mut node: i64 = pebble_append_node(
                        node_kinds, node_values, node_left, node_right,
                        2, i64_vector_get(token_values, cursor), -1, -1
                    )
                    return PebbleStep(valid=-1, next=cursor + 1, node=node)
                1:
                    return PebbleStep(valid=0, next=cursor, node=0)

fn parse_pebble_expression(
    token_kinds: &i64_vector,
    token_values: &i64_vector,
    start: i64,
    node_kinds: &mut i64_vector,
    node_values: &mut i64_vector,
    node_left: &mut i64_vector,
    node_right: &mut i64_vector
) -> PebbleStep:
    mut first: PebbleStep = parse_pebble_primary(
        token_kinds, token_values, start, node_kinds, node_values, node_left, node_right
    )
    match first.valid <=> -1:
        -1:
            return PebbleStep(valid=0, next=start, node=0)
        0:
            mut cursor: i64 = first.next
            mut root: i64 = first.node
            while cursor < i64_vector_len(token_kinds):
                mut operator: i64 = i64_vector_get(token_kinds, cursor)
                match operator <=> 4:
                    -1:
                        break
                    0:
                        cursor = cursor + 1
                        mut operand: PebbleStep = parse_pebble_primary(
                            token_kinds, token_values, cursor,
                            node_kinds, node_values, node_left, node_right
                        )
                        match operand.valid <=> -1:
                            -1:
                                return PebbleStep(valid=0, next=start, node=0)
                            0:
                                root = pebble_append_node(
                                    node_kinds, node_values, node_left, node_right,
                                    3, 0, root, operand.node
                                )
                                cursor = operand.next
                            1:
                                return PebbleStep(valid=0, next=start, node=0)
                    1:
                        match operator <=> 5:
                            -1:
                                break
                            0:
                                cursor = cursor + 1
                                mut operand: PebbleStep = parse_pebble_primary(
                                    token_kinds, token_values, cursor,
                                    node_kinds, node_values, node_left, node_right
                                )
                                match operand.valid <=> -1:
                                    -1:
                                        return PebbleStep(valid=0, next=start, node=0)
                                    0:
                                        root = pebble_append_node(
                                            node_kinds, node_values, node_left, node_right,
                                            4, 0, root, operand.node
                                        )
                                        cursor = operand.next
                                    1:
                                        return PebbleStep(valid=0, next=start, node=0)
                            1:
                                break
            return PebbleStep(valid=-1, next=cursor, node=root)
        1:
            return PebbleStep(valid=0, next=start, node=0)

fn parse_pebble_program(
    token_kinds: &i64_vector,
    token_values: &i64_vector,
    node_kinds: &mut i64_vector,
    node_values: &mut i64_vector,
    node_left: &mut i64_vector,
    node_right: &mut i64_vector,
    statements: &mut i64_vector
) -> trit:
    mut cursor: i64 = 0
    mut token_count: i64 = i64_vector_len(token_kinds)
    mut saw_output: i64 = 0
    while cursor < token_count:
        mut kind: i64 = i64_vector_get(token_kinds, cursor)
        match kind <=> 2:
            -1:
                return 0
            0:
                match saw_output <=> 0:
                    -1:
                        return 0
                    0:
                        match i64_vector_get(token_kinds, cursor + 1) <=> 3:
                            -1:
                                return 0
                            0:
                                mut expression: PebbleStep = parse_pebble_expression(
                                    token_kinds, token_values, cursor + 2,
                                    node_kinds, node_values, node_left, node_right
                                )
                                match expression.valid <=> -1:
                                    -1:
                                        return 0
                                    0:
                                        match i64_vector_get(token_kinds, expression.next) <=> 7:
                                            -1:
                                                return 0
                                            0:
                                                mut statement: i64 = pebble_append_node(
                                                    node_kinds, node_values, node_left, node_right,
                                                    5, i64_vector_get(token_values, cursor), expression.node, -1
                                                )
                                                discard i64_vector_push(statements, statement)
                                                cursor = expression.next + 1
                                            1:
                                                return 0
                                    1:
                                        return 0
                            1:
                                return 0
                    1:
                        return 0
            1:
                match kind <=> 6:
                    -1:
                        return 0
                    0:
                        match saw_output <=> 0:
                            -1:
                                return 0
                            0:
                                mut expression: PebbleStep = parse_pebble_expression(
                                    token_kinds, token_values, cursor + 1,
                                    node_kinds, node_values, node_left, node_right
                                )
                                match expression.valid <=> -1:
                                    -1:
                                        return 0
                                    0:
                                        match i64_vector_get(token_kinds, expression.next) <=> 7:
                                            -1:
                                                return 0
                                            0:
                                                mut statement: i64 = pebble_append_node(
                                                    node_kinds, node_values, node_left, node_right,
                                                    6, 0, expression.node, -1
                                                )
                                                match i64_vector_get(token_kinds, expression.next + 1) <=> 0:
                                                    -1:
                                                        return 0
                                                    0:
                                                        discard i64_vector_push(statements, statement)
                                                        return -1
                                                    1:
                                                        return 0
                                            1:
                                                return 0
                                    1:
                                        return 0
                            1:
                                return 0
                    1:
                        return 0
    match saw_output <=> 1:
        -1:
            return 0
        0:
            return -1
        1:
            return 0

fn pebble_check_expression(
    node_kinds: &i64_vector,
    node_values: &i64_vector,
    node_left: &i64_vector,
    node_right: &i64_vector,
    node: i64,
    defined: &i64_vector
) -> trit:
    mut kind: i64 = i64_vector_get(node_kinds, node)
    match kind <=> 1:
        -1:
            return 0
        0:
            return -1
        1:
            match kind <=> 2:
                -1:
                    return 0
                0:
                    mut id: i64 = i64_vector_get(node_values, node)
                    match i64_vector_get(defined, id) <=> 1:
                        -1:
                            return 0
                        0:
                            return -1
                        1:
                            return 0
                1:
                    match kind <=> 4:
                        -1:
                            mut first: trit = pebble_check_expression(
                                node_kinds, node_values, node_left, node_right,
                                i64_vector_get(node_left, node), defined
                            )
                            match first <=> -1:
                                -1:
                                    return 0
                                0:
                                    return pebble_check_expression(
                                        node_kinds, node_values, node_left, node_right,
                                        i64_vector_get(node_right, node), defined
                                    )
                                1:
                                    return 0
                        0:
                            mut first: trit = pebble_check_expression(
                                node_kinds, node_values, node_left, node_right,
                                i64_vector_get(node_left, node), defined
                            )
                            match first <=> -1:
                                -1:
                                    return 0
                                0:
                                    return pebble_check_expression(
                                        node_kinds, node_values, node_left, node_right,
                                        i64_vector_get(node_right, node), defined
                                    )
                                1:
                                    return 0
                        1:
                            return 0

fn pebble_semantic_check(
    node_kinds: &i64_vector,
    node_values: &i64_vector,
    node_left: &i64_vector,
    node_right: &i64_vector,
    statements: &i64_vector
) -> trit:
    mut defined: i64_vector = i64_vector_new(16)
    mut slot: i64 = 0
    while slot < 16:
        discard i64_vector_push(&mut defined, 0)
        slot = slot + 1
    mut cursor: i64 = 0
    while cursor < i64_vector_len(statements):
        mut statement: i64 = i64_vector_get(statements, cursor)
        mut kind: i64 = i64_vector_get(node_kinds, statement)
        mut expression: trit = pebble_check_expression(
            node_kinds, node_values, node_left, node_right,
            i64_vector_get(node_left, statement), &defined
        )
        match expression <=> -1:
            -1:
                return 0
            0:
                match kind <=> 5:
                    -1:
                        return 0
                    0:
                        mut id: i64 = i64_vector_get(node_values, statement)
                        match id <=> 0:
                            -1:
                                return 0
                            0:
                                discard i64_vector_set(&mut defined, id, 1)
                                cursor = cursor + 1
                            1:
                                match id <=> 15:
                                    -1:
                                        discard i64_vector_set(&mut defined, id, 1)
                                        cursor = cursor + 1
                                    0:
                                        discard i64_vector_set(&mut defined, id, 1)
                                        cursor = cursor + 1
                                    1:
                                        return 0
                    1:
                        match kind <=> 6:
                            -1:
                                return 0
                            0:
                                cursor = cursor + 1
                            1:
                                return 0
            1:
                return 0
    return -1

fn pebble_lower_binary(
    node_kinds: &i64_vector,
    node_values: &i64_vector,
    node_left: &i64_vector,
    node_right: &i64_vector,
    node: i64,
    defined: &i64_vector,
    ir_ops: &mut i64_vector,
    ir_results: &mut i64_vector,
    ir_a: &mut i64_vector,
    ir_b: &mut i64_vector,
    next_value: i64,
    opcode: i64
) -> PebbleStep:
    mut lhs: PebbleStep = pebble_lower_expression(
        node_kinds, node_values, node_left, node_right,
        i64_vector_get(node_left, node), defined,
        ir_ops, ir_results, ir_a, ir_b, next_value
    )
    match lhs.valid <=> -1:
        -1:
            return PebbleStep(valid=0, next=next_value, node=0)
        0:
            mut rhs: PebbleStep = pebble_lower_expression(
                node_kinds, node_values, node_left, node_right,
                i64_vector_get(node_right, node), defined,
                ir_ops, ir_results, ir_a, ir_b, lhs.next
            )
            match rhs.valid <=> -1:
                -1:
                    return PebbleStep(valid=0, next=next_value, node=0)
                0:
                    discard i64_vector_push(ir_ops, opcode)
                    discard i64_vector_push(ir_results, rhs.next)
                    discard i64_vector_push(ir_a, lhs.node)
                    discard i64_vector_push(ir_b, rhs.node)
                    return PebbleStep(valid=-1, next=rhs.next + 1, node=rhs.next)
                1:
                    return PebbleStep(valid=0, next=next_value, node=0)
        1:
            return PebbleStep(valid=0, next=next_value, node=0)

fn pebble_lower_expression(
    node_kinds: &i64_vector,
    node_values: &i64_vector,
    node_left: &i64_vector,
    node_right: &i64_vector,
    node: i64,
    defined: &i64_vector,
    ir_ops: &mut i64_vector,
    ir_results: &mut i64_vector,
    ir_a: &mut i64_vector,
    ir_b: &mut i64_vector,
    next_value: i64
) -> PebbleStep:
    mut kind: i64 = i64_vector_get(node_kinds, node)
    match kind <=> 1:
        -1:
            return PebbleStep(valid=0, next=next_value, node=0)
        0:
            discard i64_vector_push(ir_ops, 1)
            discard i64_vector_push(ir_results, next_value)
            discard i64_vector_push(ir_a, i64_vector_get(node_values, node))
            discard i64_vector_push(ir_b, 0)
            return PebbleStep(valid=-1, next=next_value + 1, node=next_value)
        1:
            match kind <=> 2:
                -1:
                    return PebbleStep(valid=0, next=next_value, node=0)
                0:
                    mut id: i64 = i64_vector_get(node_values, node)
                    discard i64_vector_push(ir_ops, 2)
                    discard i64_vector_push(ir_results, next_value)
                    discard i64_vector_push(ir_a, id)
                    discard i64_vector_push(ir_b, 0)
                    return PebbleStep(valid=-1, next=next_value + 1, node=next_value)
                1:
                    match kind <=> 4:
                        -1:
                            return pebble_lower_binary(
                                node_kinds, node_values, node_left, node_right, node, defined,
                                ir_ops, ir_results, ir_a, ir_b, next_value, 4
                            )
                        0:
                            return pebble_lower_binary(
                                node_kinds, node_values, node_left, node_right, node, defined,
                                ir_ops, ir_results, ir_a, ir_b, next_value, 5
                            )
                        1:
                            return PebbleStep(valid=0, next=next_value, node=0)

fn pebble_lower_program(
    node_kinds: &i64_vector,
    node_values: &i64_vector,
    node_left: &i64_vector,
    node_right: &i64_vector,
    statements: &i64_vector,
    ir_ops: &mut i64_vector,
    ir_results: &mut i64_vector,
    ir_a: &mut i64_vector,
    ir_b: &mut i64_vector
) -> trit:
    mut defined: i64_vector = i64_vector_new(16)
    mut slot: i64 = 0
    while slot < 16:
        discard i64_vector_push(&mut defined, 0)
        slot = slot + 1
    mut next_value: i64 = 0
    mut cursor: i64 = 0
    while cursor < i64_vector_len(statements):
        mut statement: i64 = i64_vector_get(statements, cursor)
        mut kind: i64 = i64_vector_get(node_kinds, statement)
        mut expression: PebbleStep = pebble_lower_expression(
            node_kinds, node_values, node_left, node_right,
            i64_vector_get(node_left, statement), &defined,
            ir_ops, ir_results, ir_a, ir_b, next_value
        )
        match expression.valid <=> -1:
            -1:
                return 0
            0:
                next_value = expression.next
                match kind <=> 5:
                    -1:
                        return 0
                    0:
                        mut id: i64 = i64_vector_get(node_values, statement)
                        discard i64_vector_push(ir_ops, 3)
                        discard i64_vector_push(ir_results, -1)
                        discard i64_vector_push(ir_a, id)
                        discard i64_vector_push(ir_b, expression.node)
                        discard i64_vector_set(&mut defined, id, 1)
                        cursor = cursor + 1
                    1:
                        match kind <=> 6:
                            -1:
                                return 0
                            0:
                                discard i64_vector_push(ir_ops, 6)
                                discard i64_vector_push(ir_results, -1)
                                discard i64_vector_push(ir_a, expression.node)
                                discard i64_vector_push(ir_b, 0)
                                cursor = cursor + 1
                            1:
                                return 0
            1:
                return 0
    return -1

fn pebble_ir_id_state_in_bounds(
    defined: &i64_vector,
    id: i64,
    capacity: i64,
    expected: i64
) -> trit:
    match id <=> capacity:
        -1:
            match i64_vector_get(defined, id) <=> expected:
                -1:
                    return 0
                0:
                    return -1
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn pebble_ir_id_state(defined: &i64_vector, id: i64, capacity: i64, expected: i64) -> trit:
    match id <=> 0:
        -1:
            return 0
        0:
            return pebble_ir_id_state_in_bounds(defined, id, capacity, expected)
        1:
            return pebble_ir_id_state_in_bounds(defined, id, capacity, expected)

fn pebble_local_id_valid(id: i64) -> trit:
    match id <=> 0:
        -1:
            return 0
        0:
            return -1
        1:
            match id <=> 16:
                -1:
                    return -1
                0:
                    return 0
                1:
                    return 0

fn pebble_verify_binary(result: i64, lhs: i64, rhs: i64, defined: &mut i64_vector, capacity: i64) -> trit:
    match pebble_ir_id_state(&*defined, result, capacity, 0) <=> -1:
        -1:
            return 0
        0:
            match pebble_ir_id_state(&*defined, lhs, capacity, 1) <=> -1:
                -1:
                    return 0
                0:
                    match pebble_ir_id_state(&*defined, rhs, capacity, 1) <=> -1:
                        -1:
                            return 0
                        0:
                            discard i64_vector_set(defined, result, 1)
                            return -1
                        1:
                            return 0
                1:
                    return 0
        1:
            return 0

fn pebble_verify_instruction(
    cursor: i64,
    count: i64,
    value_capacity: i64,
    ops: &i64_vector,
    results: &i64_vector,
    operands_a: &i64_vector,
    operands_b: &i64_vector,
    defined: &mut i64_vector,
    saw_return: &mut i64_vector
) -> trit:
    mut op: i64 = i64_vector_get(ops, cursor)
    mut result: i64 = i64_vector_get(results, cursor)
    mut a: i64 = i64_vector_get(operands_a, cursor)
    mut b: i64 = i64_vector_get(operands_b, cursor)
    match op <=> 1:
        -1:
            return 0
        0:
            match pebble_ir_id_state(&*defined, result, value_capacity, 0) <=> -1:
                -1:
                    return 0
                0:
                    discard i64_vector_set(defined, result, 1)
                    return -1
                1:
                    return 0
        1:
            match op <=> 2:
                -1:
                    return 0
                0:
                    match pebble_local_id_valid(a) <=> -1:
                        -1:
                            return 0
                        0:
                            match pebble_ir_id_state(&*defined, result, value_capacity, 0) <=> -1:
                                -1:
                                    return 0
                                0:
                                    discard i64_vector_set(defined, result, 1)
                                    return -1
                                1:
                                    return 0
                        1:
                            return 0
                1:
                    match op <=> 3:
                        -1:
                            return 0
                        0:
                            match result <=> -1:
                                -1:
                                    return 0
                                0:
                                    match pebble_local_id_valid(a) <=> -1:
                                        -1:
                                            return 0
                                        0:
                                            return pebble_ir_id_state(&*defined, b, value_capacity, 1)
                                        1:
                                            return 0
                                1:
                                    return 0
                        1:
                            match op <=> 4:
                                -1:
                                    return 0
                                0:
                                    return pebble_verify_binary(result, a, b, defined, value_capacity)
                                1:
                                    match op <=> 5:
                                        -1:
                                            return 0
                                        0:
                                            return pebble_verify_binary(result, a, b, defined, value_capacity)
                                        1:
                                            match op <=> 6:
                                                -1:
                                                    return 0
                                                0:
                                                    match result <=> -1:
                                                        -1:
                                                            return 0
                                                        0:
                                                            match cursor <=> count - 1:
                                                                -1:
                                                                    return 0
                                                                0:
                                                                    match i64_vector_get(&*saw_return, 0) <=> 0:
                                                                        -1:
                                                                            return 0
                                                                        0:
                                                                            match pebble_ir_id_state(&*defined, a, value_capacity, 1) <=> -1:
                                                                                -1:
                                                                                    return 0
                                                                                0:
                                                                                    discard i64_vector_set(saw_return, 0, 1)
                                                                                    return -1
                                                                                1:
                                                                                    return 0
                                                                        1:
                                                                            return 0
                                                                1:
                                                                    return 0
                                                        1:
                                                            return 0
                                                1:
                                                    return 0

fn pebble_verify_ir(
    ops: &i64_vector,
    results: &i64_vector,
    operands_a: &i64_vector,
    operands_b: &i64_vector
) -> trit:
    match i64_vector_len(ops) <=> i64_vector_len(results):
        -1:
            return 0
        0:
            match i64_vector_len(ops) <=> i64_vector_len(operands_a):
                -1:
                    return 0
                0:
                    match i64_vector_len(ops) <=> i64_vector_len(operands_b):
                        -1:
                            return 0
                        0:
                            mut count: i64 = i64_vector_len(ops)
                            mut defined: i64_vector = i64_vector_new(count)
                            mut slot: i64 = 0
                            while slot < count:
                                discard i64_vector_push(&mut defined, 0)
                                slot = slot + 1
                            mut saw_return: i64_vector = i64_vector_new(1)
                            discard i64_vector_push(&mut saw_return, 0)
                            mut cursor: i64 = 0
                            while cursor < count:
                                match pebble_verify_instruction(
                                    cursor, count, count,
                                    ops, results, operands_a, operands_b,
                                    &mut defined, &mut saw_return
                                ) <=> -1:
                                    -1:
                                        return 0
                                    0:
                                        cursor = cursor + 1
                                    1:
                                        return 0
                            match i64_vector_get(&saw_return, 0) <=> 1:
                                -1:
                                    return 0
                                0:
                                    return -1
                                1:
                                    return 0
                        1:
                            return 0
                1:
                    return 0
        1:
            return 0

fn pebble_emit_instruction(op: i64, a: i64, output: &mut i64_vector) -> trit:
    match op <=> 1:
        -1:
            return 0
        0:
            discard i64_vector_push(output, -1)
            discard i64_vector_push(output, a)
            return -1
        1:
            match op <=> 2:
                -1:
                    return 0
                0:
                    discard i64_vector_push(output, 1)
                    discard i64_vector_push(output, 1)
                    discard i64_vector_push(output, 0)
                    discard i64_vector_push(output, a)
                    return -1
                1:
                    match op <=> 3:
                        -1:
                            return 0
                        0:
                            discard i64_vector_push(output, 1)
                            discard i64_vector_push(output, 1)
                            discard i64_vector_push(output, -1)
                            discard i64_vector_push(output, a)
                            return -1
                        1:
                            match op <=> 4:
                                -1:
                                    return 0
                                0:
                                    discard i64_vector_push(output, 1)
                                    discard i64_vector_push(output, -1)
                                    return -1
                                1:
                                    match op <=> 5:
                                        -1:
                                            return 0
                                        0:
                                            discard i64_vector_push(output, 1)
                                            discard i64_vector_push(output, 0)
                                            return -1
                                        1:
                                            match op <=> 6:
                                                -1:
                                                    return 0
                                                0:
                                                    discard i64_vector_push(output, 0)
                                                    return -1
                                                1:
                                                    return 0

fn pebble_emit_bytecode(
    ir_ops: &i64_vector,
    ir_a: &i64_vector,
    output: &mut i64_vector
) -> trit:
    mut cursor: i64 = 0
    while cursor < i64_vector_len(ir_ops):
        match pebble_emit_instruction(
            i64_vector_get(ir_ops, cursor),
            i64_vector_get(ir_a, cursor),
            output
        ) <=> -1:
            -1:
                return 0
            0:
                cursor = cursor + 1
            1:
                return 0
    return -1

fn compile_pebble(input: &text, output: &mut i64_vector) -> trit:
    match i64_vector_capacity(&*output) < text_len(input) * 8 + 8:
        -1:
            return 0
        0:
            mut token_kinds: i64_vector = i64_vector_new(text_len(input) + 1)
            mut token_values: i64_vector = i64_vector_new(text_len(input) + 1)
            match tokenize_pebble(input, &mut token_kinds, &mut token_values) <=> -1:
                -1:
                    return 0
                0:
                    mut node_capacity: i64 = text_len(input) + 1
                    mut node_kinds: i64_vector = i64_vector_new(node_capacity)
                    mut node_values: i64_vector = i64_vector_new(node_capacity)
                    mut node_left: i64_vector = i64_vector_new(node_capacity)
                    mut node_right: i64_vector = i64_vector_new(node_capacity)
                    mut statements: i64_vector = i64_vector_new(node_capacity)
                    match parse_pebble_program(
                        &token_kinds, &token_values, &mut node_kinds, &mut node_values,
                        &mut node_left, &mut node_right, &mut statements
                    ) <=> -1:
                        -1:
                            return 0
                        0:
                            match pebble_semantic_check(
                                &node_kinds, &node_values, &node_left, &node_right, &statements
                            ) <=> -1:
                                -1:
                                    return 0
                                0:
                                    mut ir_ops: i64_vector = i64_vector_new(node_capacity * 2 + 1)
                                    mut ir_results: i64_vector = i64_vector_new(node_capacity * 2 + 1)
                                    mut ir_a: i64_vector = i64_vector_new(node_capacity * 2 + 1)
                                    mut ir_b: i64_vector = i64_vector_new(node_capacity * 2 + 1)
                                    match pebble_lower_program(
                                        &node_kinds, &node_values, &node_left, &node_right,
                                        &statements, &mut ir_ops, &mut ir_results,
                                        &mut ir_a, &mut ir_b
                                    ) <=> -1:
                                        -1:
                                            return 0
                                        0:
                                            match pebble_verify_ir(
                                                &ir_ops, &ir_results, &ir_a, &ir_b
                                            ) <=> -1:
                                                -1:
                                                    return 0
                                                0:
                                                    return pebble_emit_bytecode(&ir_ops, &ir_a, output)
                                                1:
                                                    return 0
                                        1:
                                            return 0
                                1:
                                    return 0
                        1:
                            return 0
                1:
                    return 0
        1:
            return 0
