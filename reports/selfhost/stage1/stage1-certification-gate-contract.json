{
  "schema": "s3.selfhost.stage1-certification-gate-contract.v3",
  "output_schema": "s3.selfhost.stage1-certification-gate.v2",
  "output_path": "reports/selfhost/stage1/stage1-certification-gate.json",
  "purpose": "Provide the only machine-readable Stage2 authorization. Every required report is re-opened, re-hashed, schema-checked, assertion-checked, and where applicable rebound to the exact final canonical source and Stage1 artifact.",
  "required_document_shape": {
    "schema": "s3.selfhost.stage1-certification-gate.v2",
    "canonical_source": {"sha256": "<exact final canonical SHA256>", "bytes": "<exact final canonical byte count>", "commit": "<commit containing exact final canonical source>"},
    "stage1_artifact": {"path": "<path to exact executable used by evidence>", "sha256": "<exact executable SHA256>", "bytes": "<exact executable byte count>"},
    "evidence": {"<required role>": {"path": "<repository-relative JSON path>", "sha256": "<exact report SHA256>"}},
    "qualification": {"stage1_certified_for_stage2": true, "self_emit": "PASS", "semantic_ir": "PASS_CODEGEN_COMPLETE_BOOTSTRAP_SUBSET", "verifier_v2": "PASS", "general_emitter": "PASS_BOOTSTRAP_REQUIRED_OPCODES"}
  },
  "required_evidence_roles": {
    "native_source_coverage": {
      "schema": "s3.selfhost.packed-token-lane-native-full-coverage.v1",
      "assertions": [
        {"path": "qualification.token_lane_full_coverage", "equals": "PASS_NATIVE_FULL_SOURCE_COVERAGE"},
        {"path": "native_source_coverage.status", "equals": "PASS"}
      ],
      "canonical_source_sha256_path": "native_source_coverage.candidate_sha256"
    },
    "representation_epoch": {
      "schema": "s3.selfhost.stage1-representation-epoch.v1",
      "assertions": [
        {"path": "status", "equals": "PASS_REPRESENTATION_EPOCH_CLASSIFIED"},
        {"path": "representation.explicit_parameter_metadata_complete", "equals": true},
        {"path": "representation.explicit_local_metadata_complete", "equals": true},
        {"path": "representation.packed_parameter_record_present", "equals": false},
        {"path": "representation.packed_local_record_present", "equals": false}
      ],
      "canonical_source_sha256_path": "source.sha256"
    },
    "reference_current_call_inventory": {
      "schema": "s3.selfhost.reference-current-call-inventory.v1",
      "assertions": [
        {"path": "status", "equals": "PASS_HOSTED_CURRENT_SOURCE_CALL_INVENTORY"},
        {"path": "native_evidence", "equals": false},
        {"path": "historical_closure.calls_656_arguments_736_authoritative_for_this_source", "equals": false},
        {"path": "qualification.native_stage1_call_high_water_required", "equals": true},
        {"path": "qualification.native_stage1_call_argument_high_water_required", "equals": true},
        {"path": "qualification.physical_capacity_selected_by_this_report", "equals": false}
      ],
      "canonical_source_sha256_path": "source.sha256"
    },
    "native_call_reconciliation": {
      "schema": "s3.selfhost.stage1-native-call-reconciliation.v1",
      "assertions": [
        {"path": "status", "equals": "PASS_NATIVE_CURRENT_SOURCE_CALL_RECONCILIATION"},
        {"path": "native_evidence", "equals": true},
        {"path": "historical_closure.calls_656_arguments_736_reused", "equals": false},
        {"path": "qualification.native_call_capacity", "equals": "PASS"},
        {"path": "qualification.native_call_argument_capacity", "equals": "PASS"},
        {"path": "qualification.semantic_call_linkage_complete_from_this_report_alone", "equals": false}
      ],
      "canonical_source_sha256_path": "canonical_source.sha256",
      "stage1_artifact_sha256_path": "stage1.sha256"
    },
    "reference_opcode_inventory": {
      "schema": "s3.selfhost.reference-bootstrap-opcode-inventory.v1",
      "assertions": [
        {"path": "status", "equals": "PASS_HOSTED_REFERENCE_OPCODE_RECONCILIATION"},
        {"path": "reconciliation.legacy_emitter_requirements_stale", "equals": false}
      ],
      "canonical_source_sha256_path": "canonical_source.sha256"
    },
    "hosted_fixture_opcode_coverage": {
      "schema": "s3.selfhost.stage1-codegen-fixture-opcode-coverage.v1",
      "assertions": [
        {"path": "status", "equals": "PASS_HOSTED_FIXTURE_OPCODE_COVERAGE"},
        {"path": "qualification.hosted_fixture_coverage", "equals": true}
      ],
      "canonical_source_sha256_path": "reference_canonical_source_sha256"
    },
    "native_codegen_fixtures": {
      "schema": "s3.selfhost.stage1-codegen-complete-fixtures-native.v1",
      "assertions": [
        {"path": "qualification.codegen_complete_representative_fixtures", "equals": "PASS"},
        {"path": "qualification.native_evidence", "equals": true}
      ],
      "stage1_artifact_sha256_path": "stage1.sha256"
    },
    "final_capacity": {
      "schema": "s3.selfhost.stage1-final-capacity.v1",
      "assertions": [
        {"path": "authority", "equals": "STAGE1_FINAL_CAPACITY_V2_CONVERGED"},
        {"path": "qualification.all_capacities_no_truncation", "equals": "PASS"},
        {"path": "qualification.selfhost_capacity_convergence", "equals": "PASS"},
        {"path": "selfhost_capacity_convergence.status", "equals": "PASS_SELFHOST_CAPACITY_CONVERGENCE"},
        {"path": "selfhost_capacity_convergence.same_canonical_source", "equals": true},
        {"path": "selfhost_capacity_convergence.same_stage1_artifact", "equals": true}
      ],
      "canonical_source_sha256_path": "canonical_source.sha256",
      "stage1_artifact_sha256_path": "stage1.sha256"
    },
    "final_semantic_ir_verifier": {
      "schema": "s3.selfhost.stage1-final-semantic-ir-verifier.v1",
      "assertions": [
        {"path": "qualification.semantic_ir", "equals": "PASS_CODEGEN_COMPLETE_BOOTSTRAP_SUBSET"},
        {"path": "qualification.verifier_v2", "equals": "PASS"},
        {"path": "qualification.general_emitter", "equals": "PASS_BOOTSTRAP_REQUIRED_OPCODES"},
        {"path": "emitter_boundary.status", "equals": "PASS_VERIFIED_IR_ONLY"},
        {"path": "emitter_boundary.raw_source_accesses_after_verifier", "equals": 0}
      ],
      "canonical_source_sha256_path": "canonical_source.sha256",
      "stage1_artifact_sha256_path": "stage1.sha256"
    },
    "final_self_emit": {
      "schema": "s3.selfhost.stage1-final-self-emit.v1",
      "assertions": [
        {"path": "qualification.self_emit", "equals": "PASS"},
        {"path": "qualification.stage1_certified_candidate", "equals": true},
        {"path": "qualification.stage2_certified", "equals": false},
        {"path": "link_recipe.mode", "equals": "STATIC_FREESTANDING_FINAL_AUTHORITY"},
        {"path": "stage2.freestanding_elf_audit.status", "equals": "PASS_FREESTANDING_STATIC_ELF"},
        {"path": "stage2_smoke.status", "equals": "PASS"}
      ],
      "canonical_source_sha256_path": "canonical_source.sha256",
      "stage1_artifact_sha256_path": "stage1.sha256"
    }
  },
  "mandatory_evidence_before_emission": [
    "100 percent native token/source byte coverage tied to the final canonical source SHA",
    "the final source representation epoch has explicit parameter/local metadata and no legacy packed parameter/local records",
    "a fresh source-bound hosted call inventory replaces the historical 656/736 closure",
    "native call/call-argument high-water, classification closure and slice/addressability guards pass on the same exact source and Stage1 artifact",
    "typed reference opcode inventory reconciled with emitter requirements",
    "hosted fixture corpus covers every bootstrap-required reference opcode",
    "native codegen-complete fixture corpus passes using the exact Stage1 artifact",
    "recursive parameter/local capacity convergence is proven after the final source/capacity edit",
    "all measured capacities pass without truncation",
    "parameter/local/storage metadata are native-qualified",
    "explicit semantic value namespace and verified def-use",
    "mutable locals/fixed arrays are storage identities with explicit LOAD/STORE/index operands",
    "instruction operands/results and deterministic order are complete",
    "call argument/result linkage and terminator condition/return/target linkage are complete",
    "verifier v2 rejects malformed def-use/storage/CFG fixtures",
    "general emitter consumes verified IR only and covers every required semantic opcode",
    "Stage1 self-emits the exact final canonical source twice deterministically using the static freestanding final link recipe",
    "the resulting Stage2 candidate is freestanding static ELF and passes its own strict compile/execute smoke",
    "all evidence reports are content-hash bound and revalidated by the Stage2 consumer"
  ],
  "prohibited": [
    "creating the gate from static projections alone",
    "creating the gate before native self-emit",
    "setting stage1_certified_for_stage2 by operator override",
    "using historical 656/736 call closure as current evidence after source bytes changed",
    "using a hosted AST/O0 call inventory as physical native capacity evidence",
    "accepting native call high-water without internal+foreign closure or call/argument slice guards",
    "using a pre-convergence or stale parameter/local capacity report",
    "using a representation-epoch report for different source bytes",
    "reapplying historical packed parameter/local transforms to a source that already materializes explicit lanes",
    "using raw-source codegen or Python compiler delegation to satisfy self-emit",
    "accepting a dynamic/PT_INTERP Stage2 self-emit artifact",
    "reusing the gate after canonical source bytes change",
    "reusing native evidence produced by a different Stage1 artifact where artifact binding is required",
    "trusting report paths without re-hashing their current contents",
    "allowing an evidence entry to choose its own schema/assertion policy"
  ],
  "producer": "tools/emit_stage1_certification_gate.py",
  "final_consumer": "tools/qualify_stage2_stage3_certified_static.py",
  "legacy_internal_consumers_not_final_authority": [
    "tools/qualify_stage2_stage3_fixed_point.py",
    "tools/qualify_stage2_stage3_strict_sandbox.py",
    "tools/qualify_stage2_stage3_certified_strict.py"
  ]
}
