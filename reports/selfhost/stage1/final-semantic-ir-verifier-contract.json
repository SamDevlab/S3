{
  "schema": "s3.selfhost.stage1-final-semantic-ir-verifier-contract.v2",
  "measurement_schema": "s3.selfhost.stage1-semantic-ir-measurement.v1",
  "output_schema": "s3.selfhost.stage1-final-semantic-ir-verifier.v1",
  "purpose": "Certify emitter-complete semantic IR and verifier-v2 on the exact Stage1/source pair that already passed final capacity. The typed Stage0 reference IR supplies required semantic capabilities only; Stage1 may use a different physical encoding.",
  "required_platform": {"system": "Linux", "machine": "x86_64"},
  "required_measurement_flags": {
    "native_evidence": true,
    "inventory_complete": true,
    "verified_ir_only": true,
    "raw_source_reread": false,
    "source_pattern_codegen": false,
    "python_codegen": false,
    "embedded_stage2_assembly": false,
    "instruction_order_deterministic": true,
    "semantic_value_namespace_complete": true,
    "storage_model_complete": true,
    "call_linkage_complete": true,
    "terminator_linkage_complete": true,
    "wide_literal_extensions_verified": true,
    "no_truncation": true
  },
  "required_semantic_features": [
    "PARAMETER_VALUE",
    "LOCAL_STORAGE_IDENTITY",
    "TYPED_CONSTANT_INLINE",
    "TYPED_CONSTANT_WIDE",
    "INSTRUCTION_RESULT",
    "EXPLICIT_LOAD_STORAGE_AND_INDEX",
    "EXPLICIT_STORE_STORAGE_INDEX_AND_VALUE",
    "INTERNAL_CALL_ARGUMENT_AND_RESULT_LINKAGE",
    "FOREIGN_CALL_ARGUMENT_AND_RESULT_LINKAGE",
    "RETURN_VALUE_LINKAGE",
    "JUMP_TARGET_LINKAGE",
    "BRANCH_CONDITION_AND_TARGET_LINKAGE",
    "DETERMINISTIC_BLOCK_INSTRUCTION_ORDER",
    "WIDE_EXTENSION_SLOT_NOT_VALUE_ID"
  ],
  "minimum_inventory_counts": [
    "functions",
    "parameters",
    "storage_objects",
    "blocks",
    "instructions",
    "semantic_values",
    "calls",
    "call_arguments",
    "terminators",
    "operand_uses",
    "instruction_results"
  ],
  "strict_positive_inventory_counts": [
    "functions",
    "parameters",
    "storage_objects",
    "blocks",
    "instructions",
    "semantic_values",
    "calls",
    "call_arguments",
    "terminators",
    "operand_uses",
    "instruction_results"
  ],
  "required_verifier_checks": [
    "function_block_ownership",
    "parameter_local_storage_ownership",
    "value_id_ranges",
    "extension_slots_not_semantic_values",
    "single_definition",
    "use_after_definition",
    "dominance",
    "operand_type_compatibility",
    "storage_index_type_and_bounds",
    "storage_mutability",
    "load_result_type",
    "store_value_type",
    "call_callee_kind",
    "call_argument_slice_bounds",
    "call_argument_order",
    "call_argument_types",
    "call_result_linkage",
    "return_value_linkage",
    "return_type_compatibility",
    "terminator_exactly_one_per_block",
    "terminator_condition_type",
    "same_function_targets",
    "cfg_target_ranges",
    "namespace_collision",
    "packed_record_overflow"
  ],
  "required_negative_fixtures": [
    "duplicate_value_definition",
    "use_before_definition",
    "non_dominating_definition_use",
    "cross_function_value_use",
    "cross_function_storage_use",
    "extension_slot_used_as_value",
    "load_wrong_index_type",
    "load_wrong_result_type",
    "store_wrong_value_type",
    "store_immutable_storage",
    "constant_index_out_of_bounds",
    "call_argument_slice_overflow",
    "call_argument_order_or_type_mismatch",
    "call_result_mismatch",
    "return_type_mismatch",
    "missing_terminator",
    "multiple_terminators",
    "branch_condition_wrong_type",
    "cross_function_or_missing_target",
    "packed_metadata_overflow"
  ],
  "reference_opcode_policy": {
    "required_capabilities_source": "reference_ir.required_capabilities values",
    "reference_physical_ir_is_authority": false,
    "every_required_capability_must_be_native_stage1_supported": true,
    "every_required_capability_must_have_general_emitter_PASS": true
  },
  "capacity_dependency": {
    "schema": "s3.selfhost.stage1-final-capacity.v1",
    "required_qualification": "PASS",
    "same_canonical_source_required": true,
    "same_stage1_artifact_required": true
  },
  "output_qualification": {
    "semantic_ir": "PASS_CODEGEN_COMPLETE_BOOTSTRAP_SUBSET",
    "verifier_v2": "PASS",
    "general_emitter": "PASS_BOOTSTRAP_REQUIRED_OPCODES",
    "stage2_allowed_from_this_report_alone": false,
    "full_self_hosting": false
  }
}
