fn main() -> tryte:
    mut output: tryte[8] = [0, 0, 0, 0, 0, 0, 0, 0]
    mut cursor: tryte = 0

    output[cursor] = 46
    cursor = cursor + 1

    output[cursor] = 115
    cursor = cursor + 1

    match output[0] <=> 46:
        0:
            match output[1] <=> 115:
                0:
                    return cursor
                -1:
                    return -1
                1:
                    return -1
        -1:
            return -1
        1:
            return -1
