fn sum(xs: &[tryte]) -> tryte:
    return xs[0] + xs[1]
fn mutate(xs: &mut [i64]) -> trit:
    xs[0] = 9
    return xs[0] == 9
fn check_small(ys: &[tryte], zs: &[trit]) -> trit:
    return (ys[1] == 20) & (zs[0] == -1)
fn main() -> trit:
    mut values: i64[2] = [1, 2]
    small: tryte[2] = [10, 20]
    flags: trit[1] = [-1]
    return (mutate(&mut values) == -1) & (sum(&small) == 30) & check_small(&small, &flags)
