+def test_direct_scan_program_completion_does_not_require_z() -> None:
+    source = b"fn alpha() -> i64:\n    return 1\n"
+    records = {"F": [(0, 1, 3, 5, 0, 1)]}
+
+    diagnostic = fast_probe._canonical_diagnostic(records, source, 7)
+
+    assert diagnostic["FIRST_LOSS"] == "NONE"
+    assert diagnostic["DIAGNOSTIC_CODE"] == "S3IR2_SCAN_PROGRAM_COMPLETE"
+    assert diagnostic["RULE_ID"] == "NONE"
+    assert diagnostic["SCAN_PROGRAM_RESULT"] == 7
+    assert diagnostic["Z_AUTHORITY"] == "NOT_APPLICABLE_DIRECT_SCAN_PROGRAM"
+
+
+def test_failed_direct_scan_does_not_guess_semantic_rule_from_record_counts() -> None:
