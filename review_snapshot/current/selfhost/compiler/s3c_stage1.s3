foreign fn s3_stage1_source_length() -> i64
foreign fn s3_stage1_read_byte(index: i64) -> tryte
foreign fn s3_stage1_write_byte(value: tryte) -> tryte
foreign fn s3_stage1_write_error_byte(value: tryte) -> tryte
foreign fn s3_stage1_exit(status: i64) -> i64

fn read_at(index: i64) -> tryte:
    return s3_stage1_read_byte(index)

fn write_byte(value: tryte) -> tryte:
    return s3_stage1_write_byte(value)

fn write_error_byte(value: tryte) -> tryte:
    return s3_stage1_write_error_byte(value)

fn is_digit(unit: tryte) -> trit:
    match unit <=> 48:
        -1:
            return 0
        0:
            return -1
        1:
            match unit <=> 57:
                -1:
                    return -1
                0:
                    return -1
                1:
                    return 0

fn is_identifier_start(unit: tryte) -> trit:
    match unit == 95:
        -1:
            return -1
        0:
            match unit <=> 65:
                -1:
                    match unit <=> 97:
                        -1:
                            return 0
                        0:
                            return -1
                        1:
                            match unit <=> 122:
                                -1:
                                    return -1
                                0:
                                    return -1
                                1:
                                    return 0
                0:
                    return -1
                1:
                    match unit <=> 90:
                        -1:
                            return -1
                        0:
                            return -1
                        1:
                            match unit <=> 97:
                                -1:
                                    return 0
                                0:
                                    return -1
                                1:
                                    match unit <=> 122:
                                        -1:
                                            return -1
                                        0:
                                            return -1
                                        1:
                                            return 0
        1:
            return -1

fn is_identifier_continue(unit: tryte) -> trit:
    match is_identifier_start(unit):
        -1:
            return -1
        0:
            return is_digit(unit)
        1:
            return is_digit(unit)

fn identifier_hash(start: i64, end: i64) -> i64:
    mut cursor: i64 = start
    mut result: i64 = 0
    while cursor < end:
        result = result * 31 + to_i64(read_at(cursor))
        while result >= 365:
            result = result - 365
        cursor += 1
    return result

fn pack_token(next_cursor: i64, kind: i64, value: i64) -> i64:
    return next_cursor * 1000000 + kind * 1000 + value + 500

fn is_space_unit(unit: tryte) -> trit:
    match unit == 32:
        -1:
            return -1
        0:
            match unit == 9:
                -1:
                    return -1
                0:
                    match unit == 13:
                        -1:
                            return -1
                        0:
                            return 0
                        1:
                            return 0
                1:
                    match unit == 13:
                        -1:
                            return -1
                        0:
                            return 0
                        1:
                            return 0
        1:
            match unit == 9:
                -1:
                    return -1
                0:
                    match unit == 13:
                        -1:
                            return -1
                        0:
                            return 0
                        1:
                            return 0
                1:
                    match unit == 13:
                        -1:
                            return -1
                        0:
                            return 0
                        1:
                            return 0

fn scan_token(cursor: i64, length: i64) -> i64:
    mut position: i64 = cursor
    mut skipping: trit = -1
    while skipping == -1:
        match position < length:
            -1:
                mut unit: tryte = read_at(position)
                match is_space_unit(unit):
                    -1:
                        position += 1
                    0:
                        skipping = 0
                    1:
                        skipping = 0
            0:
                skipping = 0
            1:
                skipping = 0
    match position >= length:
        -1:
            return pack_token(position, 0, 0)
        0:
            discard 0
        1:
            return pack_token(position, 0, 0)
    mut unit: tryte = read_at(position)
    match unit == 10:
        -1:
            return pack_token(position + 1, 3, 0)
        0:
            discard 0
        1:
            discard 0
    match is_identifier_start(unit):
        -1:
            mut end: i64 = position + 1
            while end < length:
                match is_identifier_continue(read_at(end)):
                    -1:
                        end += 1
                    0:
                        break
                    1:
                        break
            return pack_token(end, 1, identifier_hash(position, end))
        0:
            discard 0
        1:
            discard 0
    mut negative: i64 = 1
    match unit == 45:
        -1:
            match position + 1 < length:
                -1:
                    match is_digit(read_at(position + 1)):
                        -1:
                            negative = -1
                            position += 1
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
        0:
            discard 0
        1:
            discard 0
    match is_digit(read_at(position)):
        -1:
            mut number: i64 = 0
            while position < length:
                match is_digit(read_at(position)):
                    -1:
                        number = number * 10 + (to_i64(read_at(position)) - 48)
                        position += 1
                    0:
                        break
                    1:
                        break
            return pack_token(position, 2, 0)
        0:
            discard 0
        1:
            discard 0
    match unit == 45:
        -1:
            match position + 1 < length:
                -1:
                    match read_at(position + 1) == 62:
                        -1:
                            return pack_token(position + 2, 4, 12)
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
            return pack_token(position + 1, 4, 7)
        0:
            discard 0
        1:
            discard 0
    match unit == 61:
        -1:
            match position + 1 < length:
                -1:
                    match read_at(position + 1) == 61:
                        -1:
                            return pack_token(position + 2, 4, 13)
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
            return pack_token(position + 1, 4, 5)
        0:
            discard 0
        1:
            discard 0
    match unit == 43:
        -1:
            match position + 1 < length:
                -1:
                    match read_at(position + 1) == 61:
                        -1:
                            return pack_token(position + 2, 4, 14)
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
            return pack_token(position + 1, 4, 6)
        0:
            discard 0
        1:
            discard 0
    match unit == 60:
        -1:
            match position + 2 < length:
                -1:
                    match read_at(position + 1) == 61:
                        -1:
                            match read_at(position + 2) == 62:
                                -1:
                                    return pack_token(position + 3, 4, 15)
                                0:
                                    discard 0
                                1:
                                    discard 0
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
            return pack_token(position + 1, 4, 16)
        0:
            discard 0
        1:
            discard 0
    match unit == 62:
        -1:
            return pack_token(position + 1, 4, 17)
        0:
            discard 0
        1:
            discard 0
    match unit == 58:
        -1:
            return pack_token(position + 1, 4, 3)
        0:
            discard 0
        1:
            discard 0
    match unit == 40:
        -1:
            return pack_token(position + 1, 4, 1)
        0:
            discard 0
        1:
            discard 0
    match unit == 41:
        -1:
            return pack_token(position + 1, 4, 2)
        0:
            discard 0
        1:
            discard 0
    match unit == 44:
        -1:
            return pack_token(position + 1, 4, 4)
        0:
            discard 0
        1:
            discard 0
    match unit == 91:
        -1:
            return pack_token(position + 1, 4, 10)
        0:
            discard 0
        1:
            discard 0
    match unit == 93:
        -1:
            return pack_token(position + 1, 4, 11)
        0:
            discard 0
        1:
            discard 0
    match unit == 42:
        -1:
            return pack_token(position + 1, 4, 8)
        0:
            discard 0
        1:
            discard 0
    match unit == 47:
        -1:
            return pack_token(position + 1, 4, 9)
        0:
            discard 0
        1:
            discard 0
    return pack_token(position + 1, 9, to_i64(unit))

fn valid_type_name(value: i64) -> trit:
    match value == 66:
        -1:
            return -1
        0:
            match value == 313:
                -1:
                    return -1
                0:
                    match value == 76:
                        -1:
                            return -1
                        0:
                            return 0
                        1:
                            return -1
                1:
                    return 0
        1:
            return 0

fn is_statement_name(value: i64) -> trit:
    match value == 342:
        -1:
            return -1
        0:
            match value == 87:
                -1:
                    return -1
                0:
                    match value == 135:
                        -1:
                            return -1
                        0:
                            match value == 162:
                                -1:
                                    return -1
                                0:
                                    match value == 37:
                                        -1:
                                            return -1
                                        0:
                                            match value == 220:
                                                -1:
                                                    return -1
                                                0:
                                                    return 0
                                                1:
                                                    return -1
                                        1:
                                            return -1
                                1:
                                    return -1
                        1:
                            return -1
                1:
                    return -1
        1:
            return -1

fn simple_next(state: i64, kind: i64, value: i64) -> i64:
    mut next: i64 = -1
    match state == 0:
        -1:
            match kind == 1:
                -1:
                    match value == 352:
                        -1:
                            next = 1
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
        0:
            match state == 1:
                -1:
                    match kind == 1:
                        -1:
                            match value == 36:
                                -1:
                                    next = 2
                                0:
                                    discard 0
                                1:
                                    discard 0
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    match state == 2:
                        -1:
                            match kind == 4:
                                -1:
                                    match value == 1:
                                        -1:
                                            next = 3
                                        0:
                                            discard 0
                                        1:
                                            discard 0
                                0:
                                    discard 0
                                1:
                                    discard 0
                        0:
                            match state == 3:
                                -1:
                                    match kind == 4:
                                        -1:
                                            match value == 2:
                                                -1:
                                                    next = 4
                                                0:
                                                    discard 0
                                                1:
                                                    discard 0
                                        0:
                                            discard 0
                                        1:
                                            discard 0
                                0:
                                    match state == 4:
                                        -1:
                                            match kind == 4:
                                                -1:
                                                    match value == 12:
                                                        -1:
                                                            next = 5
                                                        0:
                                                            discard 0
                                                        1:
                                                            discard 0
                                                0:
                                                    discard 0
                                                1:
                                                    discard 0
                                        0:
                                            match state == 5:
                                                -1:
                                                    match kind == 1:
                                                        -1:
                                                            match value == 313:
                                                                -1:
                                                                    next = 6
                                                                0:
                                                                    discard 0
                                                                1:
                                                                    discard 0
                                                        0:
                                                            discard 0
                                                        1:
                                                            discard 0
                                                0:
                                                    match state == 6:
                                                        -1:
                                                            match kind == 4:
                                                                -1:
                                                                    match value == 3:
                                                                        -1:
                                                                            next = 7
                                                                        0:
                                                                            discard 0
                                                                        1:
                                                                            discard 0
                                                                0:
                                                                    discard 0
                                                                1:
                                                                    discard 0
                                                        0:
                                                            match state == 7:
                                                                -1:
                                                                    match kind == 2:
                                                                        -1:
                                                                            next = 8
                                                                        0:
                                                                            discard 0
                                                                        1:
                                                                            discard 0
                                                                0:
                                                                    match state == 8:
                                                                        -1:
                                                                            match kind == 3:
                                                                                -1:
                                                                                    next = 9
                                                                                0:
                                                                                    discard 0
                                                                                1:
                                                                                    discard 0
                                                                        0:
                                                                            discard 0
                                                                        1:
                                                                            discard 0
                                                                1:
                                                                    discard 0
                                                        1:
                                                            discard 0
                                                1:
                                                    discard 0
                                        1:
                                            discard 0
                                1:
                                    discard 0
                        1:
                            discard 0
                1:
                    discard 0
        1:
            discard 0
    return next

fn decimal_digit(number: i64, divisor: i64) -> tryte:
    mut quotient: i64 = number / divisor
    mut ascii: i64 = quotient + 48
    return to_tryte(ascii)

fn remainder_digit(number: i64, divisor: i64) -> tryte:
    mut quotient: i64 = number / divisor
    mut remainder: i64 = number - quotient * divisor
    mut ascii: i64 = remainder + 48
    return to_tryte(ascii)

fn emit_decimal(value: i64) -> trit:
    mut number: i64 = value
    match number < 0:
        -1:
            discard write_byte(45)
            number = 0 - number
        0:
            discard 0
        1:
            discard 0
    match number <=> 10:
        -1:
            discard write_byte(to_tryte(number + 48))
        0:
            discard write_byte(49)
            discard write_byte(48)
        1:
            match number <=> 100:
                -1:
                    discard write_byte(decimal_digit(number, 10))
                    discard write_byte(remainder_digit(number, 10))
                0:
                    discard write_byte(49)
                    discard write_byte(48)
                    discard write_byte(48)
                1:
                    mut hundreds: i64 = number / 100
                    mut remainder: i64 = number - hundreds * 100
                    discard write_byte(to_tryte(hundreds + 48))
                    discard write_byte(decimal_digit(remainder, 10))
                    discard write_byte(remainder_digit(remainder, 10))
    return -1

fn emit_general_name(name: i64) -> trit:
    discard write_byte(115)
    discard write_byte(51)
    discard write_byte(95)
    discard write_byte(102)
    discard write_byte(110)
    discard write_byte(95)
    discard emit_decimal(name)
    return -1

