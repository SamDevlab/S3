fn check(x: tryte) -> tryte:
    mut result: tryte = 0
    match x <=> 0:
        -1:
            result = 10
        0:
            result = 20
        1:
            result = 30
    return result

fn main() -> tryte:
    mut a: tryte = check(1)
    mut b: tryte = check(5)
    mut sum: tryte = a + b

    match sum <=> 60:
        0:
            return 1
        1:
            return 0
        -1:
            return 0
