module agent_raster_valid_mean

export fn agent_raster_valid_mean(values: &[f64], valid_mask: &[i64], cell_count: i64, output: &mut [f64]) -> i64:
    mut status: i64 = 0
    match cell_count <= 0:
        -1:
            status = 1
        0:
            status = status
        1:
            status = status
    match cell_count > 364:
        -1:
            status = 1
        0:
            status = status
        1:
            status = status

    match status == 0:
        -1:
            match len(values) == cell_count:
                -1:
                    status = status
                0:
                    status = 1
                1:
                    status = 1
            match len(valid_mask) == cell_count:
                -1:
                    status = status
                0:
                    status = 1
                1:
                    status = 1
        0:
            status = status
        1:
            status = status

    match len(output) < to_i64(1):
        -1:
            match status == 0:
                -1:
                    status = 2
                0:
                    status = status
                1:
                    status = status
        0:
            status = status
        1:
            status = status
    match len(output) > to_i64(1):
        -1:
            status = 1
        0:
            status = status
        1:
            status = status

    match status == 0:
        -1:
            mut sum: f64 = 0.0
            mut valid_count: i64 = 0
            mut index: i64 = 0
            while index < cell_count:
                match valid_mask[index] == 1:
                    -1:
                        sum = sum + values[index]
                        valid_count = valid_count + 1
                    0:
                        valid_count = valid_count
                    1:
                        valid_count = valid_count
                index = index + 1

            match valid_count > 0:
                -1:
                    mut divisor: f64 = 0.0
                    mut divisor_index: i64 = 0
                    while divisor_index < valid_count:
                        divisor = divisor + 1.0
                        divisor_index = divisor_index + 1
                    output[0] = sum / divisor
                    return 0
                0:
                    return 1
                1:
                    return 1
        0:
            return status
        1:
            return status

fn main() -> i64:
    return 0
