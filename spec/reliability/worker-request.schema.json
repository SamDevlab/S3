{
  "$id": "https://samdevlab.github.io/s3/spec/reliability/worker-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "backend": {"enum": ["hosted", "linux-x86_64-native"]},
    "case_id": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "compiler_head": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "operation": {"enum": ["CHECK", "RUN_HOSTED", "RUN_NATIVE"]},
    "optimization": {"enum": ["O0", "O1"]},
    "options": {
      "additionalProperties": {
        "oneOf": [
          {"type": "string"}, {"type": "integer"}, {"type": "number"},
          {"type": "boolean"}, {"type": "null"}
        ]
      },
      "type": "object"
    },
    "schema": {"const": "s3.reliability.worker-request.v1"},
    "source_b64": {"contentEncoding": "base64", "type": "string"},
    "source_bytes": {"maximum": 32768, "minimum": 0, "type": "integer"},
    "source_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
  },
  "required": [
    "schema", "case_id", "compiler_head", "source_b64", "source_sha256",
    "source_bytes", "operation", "optimization", "backend", "options"
  ],
  "title": "S3 Reliability Lab v2 worker request",
  "type": "object"
}
