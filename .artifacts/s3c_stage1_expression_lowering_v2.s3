    match op == 24:
        -1:
            relation = 5
        0:
            discard 0
        1:
            discard 0
    return relation

# STAGE1_SEMANTIC_LOWERING_V2_STAGE04
fn stage04_nonnegative(value: i64) -> trit:
    match value < 0:
        -1:
            return 0
        0:
            return -1
        1:
            return -1

fn stage04_cast_code(start: i64, end: i64) -> i64:
    match stage04_word(start, end, 33, 6):
        -1:
            return 25
        0:
            match stage04_word(start, end, 70, 6):
                -1:
                    return 26
                0:
                    match stage04_word(start, end, 355, 8):
                        -1:
                            return 27
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 0
        1:
            return 0

fn stage04_cast_type(op: i64) -> i64:
    match op == 25:
        -1:
            return 3
        0:
            match op == 26:
                -1:
                    return 4
                0:
                    match op == 27:
                        -1:
                            return 2
                        0:
                            return 0
                        1:
                            return 0
                1:
