                                            return 0
                                        1:
                                            return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 0
        0:
            match op == 19:
                -1:
                    match left_type == 1:
                        -1:
                            match right_type == 1:
                                -1:
                                    return -1
                                0:
                                    match right_type == 2:
                                        -1:
                                            return -1
                                        0:
                                            return 0
                                        1:
                                            return 0
                                1:
                                    return 0
                        0:
                            match left_type == 2:
                                -1:
                                    match right_type == 1:
                                        -1:
                                            return -1
                                        0:
                                            match right_type == 2:
                                                -1:
                                                    return -1
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        1:
                            return 0
                0:
                    return -1
                1:
                    return -1
        1:
            return -1

fn stage04_mutable_flag(value: trit) -> trit:
    match value == -1:
