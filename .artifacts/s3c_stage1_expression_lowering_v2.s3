fn emit_ir_return(opcode: tryte, return_type: tryte, value: i64) -> trit:
    match opcode == 1:
        -1:
            match valid_type_name(to_i64(return_type)):
                -1:
                    return emit_assembly(value)
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0
