fn emit_audit_decimal(value: i64) -> trit:
    mut number: i64 = value
    match number < 0:
        -1:
            discard write_error_byte(45)
            number = 0 - number
        0:
            discard 0
        1:
            discard 0
    mut divisor: i64 = 100000
    mut started: trit = 0
    while divisor > 0:
        mut digit: i64 = number / divisor
        match digit > 0:
            -1:
                discard write_error_byte(to_tryte(digit + 48))
                started = -1
            0:
                match started == -1:
                    -1:
                        discard write_error_byte(48)
                    0:
                        discard 0
                    1:
                        discard 0
            1:
                match started == -1:
                    -1:
                        discard write_error_byte(to_tryte(digit + 48))
                        started = -1
                    0:
                        discard 0
                    1:
                        discard 0
        number = number - digit * divisor
        divisor = divisor / 10
    match started == -1:
        -1:
            discard 0
        0:
            discard write_error_byte(48)
        1:
            discard write_error_byte(48)
    return -1

fn emit_audit_value(value: i64) -> trit:
    discard emit_audit_decimal(value)
    discard write_error_byte(32)
    return -1

fn emit_audit_snapshot(v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, v8: i64, v9: i64, v10: i64, v11: i64, v12: i64, v13: i64, v14: i64, v15: i64, v16: i64, v17: i64, v18: i64, v19: i64, v20: i64, v21: i64, v22: i64, v23: i64, v24: i64, v25: i64) -> trit:
    discard emit_audit_header()
    discard emit_audit_value(v0)
    discard emit_audit_value(v1)
    discard emit_audit_value(v2)
    discard emit_audit_value(v3)
    discard emit_audit_value(v4)
    discard emit_audit_value(v5)
    discard emit_audit_value(v6)
    discard emit_audit_value(v7)
    discard emit_audit_value(v8)
    discard emit_audit_value(v9)
    discard emit_audit_value(v10)
    discard emit_audit_value(v11)
    discard emit_audit_value(v12)
    discard emit_audit_value(v13)
    discard emit_audit_value(v14)
    discard emit_audit_value(v15)
    discard emit_audit_value(v16)
    discard emit_audit_value(v17)
    discard emit_audit_value(v18)
    discard emit_audit_value(v19)
    discard emit_audit_value(v20)
    discard emit_audit_value(v21)
    discard emit_audit_value(v22)
    discard emit_audit_value(v23)
    discard emit_audit_value(v24)
    discard emit_audit_value(v25)
    discard write_error_byte(10)
    return -1

fn pack_ir_record(opcode: i64, operand_a: i64, operand_b: i64, immediate: i64) -> i64:
    return opcode * 1000000000000 + operand_a * 1000000000 + operand_b * 1000000 + immediate

fn is_foreign_name(value: i64) -> trit:
    match value == 361:
        -1:
            return -1
        0:
            match value == 360:
                -1:
                    return -1
                0:
                    match value == 193:
                        -1:
                            return -1
                        0:
                            match value == 282:
                                -1:
                                    return -1
                                0:
                                    match value == 259:
                                        -1:
                                            return -1
                                        0:
                                            return 0
                                        1:
                                            return -1
                                1:
                                    return -1
                        1:
                            return -1
                1:
                    return -1
        1:
            return -1

fn semantic_v2_write(value: tryte) -> tryte:
    return s3_stage1_write_byte(value)

fn semantic_v2_emit_nonnegative(value: i64) -> trit:
    mut number: i64 = value
    match number < 0:
        -1:
            return 0
        0:
            discard 0
        1:
            discard 0
    match number == 0:
        -1:
            discard semantic_v2_write(48)
            return -1
        0:
            discard 0
        1:
            discard 0
    mut divisor: i64 = 1
    mut probe: i64 = number
    while probe >= 10:
        probe = probe / 10
        divisor = divisor * 10
    while divisor > 0:
        mut digit: i64 = number / divisor
        discard semantic_v2_write(to_tryte(digit + 48))
        number = number - digit * divisor
        divisor = divisor / 10
    return -1

fn semantic_v2_emit_signed(value: i64) -> trit:
    match value < 0:
        -1:
            discard semantic_v2_write(45)
            return semantic_v2_emit_nonnegative(0 - value)
        0:
            return semantic_v2_emit_nonnegative(value)
        1:
            return semantic_v2_emit_nonnegative(value)

fn semantic_v2_field(value: i64) -> trit:
    discard semantic_v2_write(32)
    return semantic_v2_emit_signed(value)

fn semantic_v2_eol() -> trit:
    discard semantic_v2_write(10)
    return -1

fn semantic_v2_header() -> trit:
    # S3IR2 2\n
    discard semantic_v2_write(83)
    discard semantic_v2_write(51)
    discard semantic_v2_write(73)
    discard semantic_v2_write(82)
    discard semantic_v2_write(50)
    discard semantic_v2_write(32)
    discard semantic_v2_write(50)
    discard semantic_v2_write(10)
    return -1

fn semantic_v2_function(function_id: i64, kind: i64, name_start: i64, name_length: i64, parameter_count: i64, result_count: i64) -> trit:
    # F function kind name_start name_length params results\n
    discard semantic_v2_write(70)
    discard semantic_v2_field(function_id)
    discard semantic_v2_field(kind)
    discard semantic_v2_field(name_start)
    discard semantic_v2_field(name_length)
    discard semantic_v2_field(parameter_count)
    discard semantic_v2_field(result_count)
    return semantic_v2_eol()

fn semantic_v2_block(function_id: i64, block_id: i64, ordinal: i64, instruction_count: i64, terminator_instruction_id: i64) -> trit:
    # B function block ordinal instructions terminator\n
    discard semantic_v2_write(66)
    discard semantic_v2_field(function_id)
    discard semantic_v2_field(block_id)
    discard semantic_v2_field(ordinal)
    discard semantic_v2_field(instruction_count)
    discard semantic_v2_field(terminator_instruction_id)
    return semantic_v2_eol()

fn semantic_v2_value(value_id: i64, function_id: i64, kind: i64, type_code: i64, anchor_start: i64, anchor_length: i64, mutable_flag: i64, storage_id: i64) -> trit:
    # V value function kind type anchor_start anchor_length mutable storage\n
    discard semantic_v2_write(86)
    discard semantic_v2_field(value_id)
    discard semantic_v2_field(function_id)
    discard semantic_v2_field(kind)
    discard semantic_v2_field(type_code)
    discard semantic_v2_field(anchor_start)
    discard semantic_v2_field(anchor_length)
    discard semantic_v2_field(mutable_flag)
    discard semantic_v2_field(storage_id)
    return semantic_v2_eol()

fn semantic_v2_memory(function_id: i64, storage_id: i64, type_code: i64, length: i64, mutable_flag: i64) -> trit:
    # M function storage type length mutable\n
    discard semantic_v2_write(77)
    discard semantic_v2_field(function_id)
    discard semantic_v2_field(storage_id)
    discard semantic_v2_field(type_code)
    discard semantic_v2_field(length)
    discard semantic_v2_field(mutable_flag)
    return semantic_v2_eol()

fn semantic_v2_instruction(instruction_id: i64, function_id: i64, block_id: i64, ordinal: i64, opcode: i64, result_count: i64, operand_count: i64, aux_a: i64, aux_b: i64) -> trit:
    # I instruction function block ordinal opcode results operands aux_a aux_b\n
    discard semantic_v2_write(73)
    discard semantic_v2_field(instruction_id)
    discard semantic_v2_field(function_id)
    discard semantic_v2_field(block_id)
    discard semantic_v2_field(ordinal)
    discard semantic_v2_field(opcode)
    discard semantic_v2_field(result_count)
    discard semantic_v2_field(operand_count)
    discard semantic_v2_field(aux_a)
    discard semantic_v2_field(aux_b)
    return semantic_v2_eol()

fn semantic_v2_operand(instruction_id: i64, ordinal: i64, value_id: i64) -> trit:
    discard semantic_v2_write(79)
    discard semantic_v2_field(instruction_id)
    discard semantic_v2_field(ordinal)
    discard semantic_v2_field(value_id)
    return semantic_v2_eol()

fn semantic_v2_result(instruction_id: i64, ordinal: i64, value_id: i64) -> trit:
    discard semantic_v2_write(82)
    discard semantic_v2_field(instruction_id)
    discard semantic_v2_field(ordinal)
    discard semantic_v2_field(value_id)
    return semantic_v2_eol()

fn semantic_v2_call(instruction_id: i64, callee_kind: i64, callee_function_id: i64, callee_name_start: i64, callee_name_length: i64, argument_count: i64, result_count: i64) -> trit:
    discard semantic_v2_write(67)
    discard semantic_v2_field(instruction_id)
    discard semantic_v2_field(callee_kind)
    discard semantic_v2_field(callee_function_id)
    discard semantic_v2_field(callee_name_start)
    discard semantic_v2_field(callee_name_length)
    discard semantic_v2_field(argument_count)
    discard semantic_v2_field(result_count)
    return semantic_v2_eol()

fn semantic_v2_call_argument(instruction_id: i64, ordinal: i64, value_id: i64) -> trit:
    discard semantic_v2_write(65)
    discard semantic_v2_field(instruction_id)
    discard semantic_v2_field(ordinal)
    discard semantic_v2_field(value_id)
    return semantic_v2_eol()

fn semantic_v2_terminator(instruction_id: i64, kind: i64, condition_value_id: i64, target_negative: i64, target_zero: i64, target_positive: i64, return_value_id: i64) -> trit:
    # JUMP uses target_negative as its single target. BRANCH3 uses all three.
    discard semantic_v2_write(84)
    discard semantic_v2_field(instruction_id)
    discard semantic_v2_field(kind)
    discard semantic_v2_field(condition_value_id)
    discard semantic_v2_field(target_negative)
    discard semantic_v2_field(target_zero)
    discard semantic_v2_field(target_positive)
    discard semantic_v2_field(return_value_id)
    return semantic_v2_eol()

fn semantic_v2_complete(mask: i64) -> trit:
    # 31 means S1|S2|S3|S4|S5. Any partial candidate must emit a smaller mask.
    discard semantic_v2_write(90)
    discard semantic_v2_field(mask)
    return semantic_v2_eol()

fn stage04_binary_opcode(op: i64) -> i64:
    mut opcode: i64 = 0
    match op == 6:
        -1:
            opcode = 5
        0:
            discard 0
        1:
            discard 0
    match op == 7:
        -1:
            opcode = 6
        0:
            discard 0
        1:
            discard 0
    match op == 18:
        -1:
            opcode = 11
        0:
            discard 0
        1:
            discard 0
    match op == 19:
        -1:
            opcode = 12
        0:
            discard 0
        1:
            discard 0
    match op == 15:
        -1:
            opcode = 13
        0:
            discard 0
        1:
            discard 0
    match op == 13:
        -1:
            opcode = 9
        0:
            discard 0
        1:
            discard 0
    match op == 21:
        -1:
            opcode = 9
        0:
            discard 0
        1:
            discard 0
    match op == 16:
        -1:
            opcode = 9
        0:
            discard 0
        1:
            discard 0
    match op == 23:
        -1:
            opcode = 9
        0:
            discard 0
        1:
            discard 0
    match op == 17:
        -1:
            opcode = 9
        0:
            discard 0
        1:
            discard 0
    match op == 24:
        -1:
            opcode = 9
        0:
            discard 0
        1:
            discard 0
    return opcode

fn stage04_relation_aux(op: i64) -> i64:
    mut relation: i64 = -1
    match op == 13:
        -1:
            relation = 0
        0:
            discard 0
        1:
            discard 0
    match op == 21:
        -1:
            relation = 1
        0:
            discard 0
        1:
            discard 0
    match op == 16:
        -1:
            relation = 2
        0:
