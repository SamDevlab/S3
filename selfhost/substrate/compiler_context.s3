module selfhost.substrate.compiler_context

record Span:
    file_id: i64
    start: i64
    end: i64

record Token:
    span: Span
    kind: i64
    symbol_id: i64

record Node:
    span: Span
    kind: i64
    first_child_id: i64

record Value:
    type_id: i64
    storage_id: i64

record Instruction:
    opcode: i64
    result_id: i64
    first_operand_id: i64

record Block:
    first_instruction_id: i64
    successor_id: i64

record CompilerContextShape:
    files: vector<i64>
    symbols: map<text, i64>
    scopes: vector<i64>
    declarations: vector<i64>
    types: vector<i64>
    functions: vector<i64>
    storage: vector<i64>
    nodes: vector<i64>
    blocks: vector<i64>
    values: vector<i64>
    instructions: vector<i64>
    token_ids: vector<i64>
    node_ids: vector<i64>
    value_ids: vector<i64>
    block_ids: vector<i64>
    instruction_ids: vector<i64>

export fn compiler_context_shape_anchor() -> i64:
    return 0

export fn syntax_shape_anchor() -> i64:
    span: Span = Span(file_id=0, start=0, end=1)
    mut tokens: vector<Token> = vector_new<Token>(1)
    discard vector_push<Token>(&mut tokens, Token(span=span, kind=1, symbol_id=2))
    mut nodes: vector<Node> = vector_new<Node>(1)
    discard vector_push<Node>(&mut nodes, Node(span=span, kind=3, first_child_id=0))
    return vector_len<Token>(&tokens) + vector_len<Node>(&nodes)

export fn ir_shape_anchor() -> i64:
    mut values: vector<Value> = vector_new<Value>(1)
    discard vector_push<Value>(&mut values, Value(type_id=1, storage_id=2))
    mut instructions: vector<Instruction> = vector_new<Instruction>(1)
    discard vector_push<Instruction>(&mut instructions, Instruction(opcode=3, result_id=4, first_operand_id=5))
    mut blocks: vector<Block> = vector_new<Block>(1)
    discard vector_push<Block>(&mut blocks, Block(first_instruction_id=0, successor_id=1))
    return vector_len<Value>(&values) + vector_len<Instruction>(&instructions) + vector_len<Block>(&blocks)
