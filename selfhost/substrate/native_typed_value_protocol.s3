export fn native_typed_f64_case() -> trit:
    mut source: vector<i64> = vector_new<i64>(256)
    discard native_typed_append_f64_fixture(&mut source)
    mut result: NativeTypedResult = native_typed_execute_source(&source)
    match result.status == 1:
        -1:
            match result.value.kind == 2:
                -1:
                    match result.value.f64_value <=> 4.75:
                        -1:
                            return 0
                        0:
                            return -1
                        1:
                            return 1
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

export fn native_typed_mixed_binary_case() -> trit:
