export fn generic_native_parser_program_digest(source: &vector<i64>) -> i64:
    mut ids: vector<i64> = vector_new<i64>(256)
    mut kinds: vector<i64> = vector_new<i64>(256)
    mut starts: vector<i64> = vector_new<i64>(256)
    mut ends: vector<i64> = vector_new<i64>(256)
    mut token_count: i64 = generic_lexer_scan_tokens(source, &mut ids, &mut kinds, &mut starts, &mut ends)
    mut cursor: i64 = 0
    mut function_count: i64 = 0
    mut program_digest: i64 = 0
    mut scanning: i64 = 1
    while scanning == 1:
        match generic_native_parser_kind(&kinds, cursor) == 0:
            -1:
                scanning = 0
            0:
                match generic_native_parser_kind(&kinds, cursor) == 6:
                    -1:
                        cursor = cursor + 1
                    0:
                        match generic_native_parser_program_indent(source, vector_get<i64>(&starts, cursor)) == 0:
                            -1:
                                mut function_result: vector<i64> = vector_new<i64>(4)
                                match generic_native_parser_program_function(
                                    source,
                                    &kinds,
                                    &starts,
                                    &ends,
                                    cursor,
                                    &mut function_result
                                ) == 1:
                                    -1:
                                        cursor = vector_get<i64>(&function_result, 0)
                                        program_digest = program_digest * 131 + vector_get<i64>(&function_result, 1)
                                        function_count = function_count + 1
                                    0:
                                        return -1
                                    1:
                                        return -1
                            0:
                                return -1
                            1:
                                return -1
                    1:
                        scanning = 0
            1:
                scanning = 0
    match function_count == 0:
        -1:
            return -1
        0:
            discard 0
        1:
            discard 0
    match generic_native_parser_take(&kinds, cursor, 0):
        -1:
            cursor = cursor + 1
        0:
            return -1
        1:
            return -1
    match cursor == token_count:
        -1:
            return program_digest + function_count * 47
        0:
            return -1
        1:
            return -1

