module selfhost.substrate.generic_lexer_state

record GenericLexerState:
    source_bytes: vector<i64>
    cursor: i64
    line: i64
    column: i64
    indent_stack: vector<i64>
    delimiter_stack: vector<i64>
    token_ids: vector<i64>
    token_kinds: vector<i64>
    token_starts: vector<i64>
    token_ends: vector<i64>

export fn generic_lexer_state_case(case_id: i64) -> i64:
    mut source: vector<i64> = vector_new<i64>(16)
    discard vector_push<i64>(&mut source, 102)
    discard vector_push<i64>(&mut source, 110)
    discard vector_push<i64>(&mut source, 32)
    discard vector_push<i64>(&mut source, 109)
    discard vector_push<i64>(&mut source, 97)
    discard vector_push<i64>(&mut source, 105)
    discard vector_push<i64>(&mut source, 110)
    discard vector_push<i64>(&mut source, 10)
    discard vector_push<i64>(&mut source, 49)
    discard vector_push<i64>(&mut source, 50)
    discard vector_push<i64>(&mut source, 51)

    mut cursor: i64 = 0
    mut line: i64 = 1
    mut column: i64 = 1
    mut digest: i64 = 0

    while cursor < vector_len<i64>(&source):
        mut value: i64 = vector_get<i64>(&source, cursor)
        digest = digest + value * (cursor + 1)
        match value <=> 10:
            -1:
                column = column + 1
            0:
                line = line + 1
                column = 1
            1:
                column = column + 1
        cursor = cursor + 1

    return digest + line * 1000 + column * 10 + case_id

export fn generic_lexer_state_anchor() -> i64:
    return generic_lexer_state_case(0)

fn generic_is_lower_alpha(unit: i64) -> trit:
    match unit <=> 97:
        -1:
            return 0
        0:
            return 1
        1:
            match unit <=> 122:
                -1:
                    return 1
                0:
                    return 1
                1:
                    return 0

fn generic_is_upper_alpha(unit: i64) -> trit:
    match unit <=> 65:
        -1:
            return 0
        0:
            return 1
        1:
            match unit <=> 90:
                -1:
                    return 1
                0:
                    return 1
                1:
                    return 0

fn generic_is_alpha(unit: i64) -> trit:
    match generic_is_lower_alpha(unit):
        -1:
            return -1
        0:
            return generic_is_upper_alpha(unit)
        1:
            return 1

fn generic_is_digit(unit: i64) -> trit:
    match unit <=> 48:
        -1:
            return 0
        0:
            return 1
        1:
            match unit <=> 57:
                -1:
                    return 1
                0:
                    return 1
                1:
                    return 0

fn generic_is_word_char(unit: i64) -> trit:
    match generic_is_alpha(unit):
        -1:
            match generic_is_digit(unit):
                -1:
                    match unit == 95:
                        -1:
                            return 1
                        0:
                            return 0
                        1:
                            return 0
                0:
                    match unit == 95:
                        -1:
                            return 1
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 1
        0:
            match generic_is_digit(unit):
                -1:
                    match unit == 95:
                        -1:
                            return 1
                        0:
                            return 0
                        1:
                            return 0
                0:
                    match unit == 95:
                        -1:
                            return 1
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 1
        1:
            return 1

fn generic_word_kind(source: &vector<i64>, start: i64, end: i64) -> i64:
    mut length: i64 = end - start

    match length == 2:
        -1:
            match vector_get<i64>(source, start) == 102:
                -1:
                    match vector_get<i64>(source, start + 1) == 110:
                        -1:
                            return 2
                        0:
                            length = length
                        1:
                            length = length
                0:
                    length = length
                1:
                    length = length
        0:
            length = length
        1:
            length = length

    match length == 6:
        -1:
            match vector_get<i64>(source, start) == 114:
                -1:
                    match vector_get<i64>(source, start + 1) == 101:
                        -1:
                            match vector_get<i64>(source, start + 2) == 116:
                                -1:
                                    match vector_get<i64>(source, start + 3) == 117:
                                        -1:
                                            match vector_get<i64>(source, start + 4) == 114:
                                                -1:
                                                    match vector_get<i64>(source, start + 5) == 110:
                                                        -1:
                                                            return 3
                                                        0:
                                                            length = length
                                                        1:
                                                            length = length
                                                0:
                                                    length = length
                                                1:
                                                    length = length
                                        0:
                                            length = length
                                        1:
                                            length = length
                                0:
                                    length = length
                                1:
                                    length = length
                        0:
                            length = length
                        1:
                            length = length
                0:
                    length = length
                1:
                    length = length
        0:
            length = length
        1:
            length = length

    return 1

fn generic_unit_class(unit: i64) -> trit:
    match unit == 32:
        -1:
            return 1
        0:
            match unit == 9:
                -1:
                    return 1
                0:
                    match unit <=> 10:
                        -1:
                            return -1
                        0:
                            return 0
                        1:
                            return -1
                1:
                    match unit <=> 10:
                        -1:
                            return -1
                        0:
                            return 0
                        1:
                            return -1
        1:
            return -1

fn generic_scan_kind(unit: i64) -> trit:
    match generic_is_digit(unit):
        -1:
            match generic_is_alpha(unit):
                -1:
                    return -1
                0:
                    return -1
                1:
                    return 1
        0:
            match generic_is_alpha(unit):
                -1:
                    return -1
                0:
                    return -1
                1:
                    return 1
        1:
            return 0

fn generic_punctuation_kind(unit: i64) -> i64:
    match unit == 40:
        -1:
            return 7
        0:
            match unit == 41:
                -1:
                    return 8
                0:
                    return 100 + unit
                1:
                    return 100 + unit
        1:
            return 100 + unit

export fn generic_lexer_scan_tokens(source: &vector<i64>, ids: &mut vector<i64>, kinds: &mut vector<i64>, starts: &mut vector<i64>, ends: &mut vector<i64>) -> i64:
    mut cursor: i64 = 0
    mut length: i64 = vector_len<i64>(source)
    mut token_count: i64 = 0

    while cursor < length:
        mut unit: i64 = vector_get<i64>(source, cursor)
        match generic_unit_class(unit):
            -1:
                match generic_scan_kind(unit):
                    -1:
                        mut token_id: i64 = token_count
                        discard vector_push<i64>(ids, token_id)
                        discard vector_push<i64>(kinds, generic_punctuation_kind(unit))
                        discard vector_push<i64>(starts, cursor)
                        discard vector_push<i64>(ends, cursor + 1)
                        token_count = token_count + 1
                        cursor = cursor + 1
                    0:
                        mut start: i64 = cursor
                        mut end: i64 = cursor
                        mut token_kind: i64 = 5
                        mut scanning: i64 = 1
                        while scanning == 1:
                            match end < length:
                                -1:
                                    match generic_is_digit(vector_get<i64>(source, end)):
                                        -1:
                                            scanning = 0
                                        0:
                                            scanning = 0
                                        1:
                                            end = end + 1
                                0:
                                    scanning = 0
                                1:
                                    scanning = 0
                        match end + 1 < length:
                            -1:
                                match vector_get<i64>(source, end) == 46:
                                    -1:
                                        match generic_is_digit(vector_get<i64>(source, end + 1)):
                                            -1:
                                                end = end
                                            0:
                                                end = end
                                            1:
                                                token_kind = 9
                                                end = end + 2
                                                mut scanning_fraction: i64 = 1
                                                while scanning_fraction == 1:
                                                    match end < length:
                                                        -1:
                                                            match generic_is_digit(vector_get<i64>(source, end)):
                                                                -1:
                                                                    scanning_fraction = 0
                                                                0:
                                                                    scanning_fraction = 0
                                                                1:
                                                                    end = end + 1
                                                        0:
                                                            scanning_fraction = 0
                                                        1:
                                                            scanning_fraction = 0
                                    0:
                                        end = end
                                    1:
                                        end = end
                            0:
                                end = end
                            1:
                                end = end
                        mut token_id: i64 = token_count
                        discard vector_push<i64>(ids, token_id)
                        discard vector_push<i64>(kinds, token_kind)
                        discard vector_push<i64>(starts, start)
                        discard vector_push<i64>(ends, end)
                        token_count = token_count + 1
                        cursor = end
                    1:
                        mut start: i64 = cursor
                        mut end: i64 = cursor
                        mut scanning: i64 = 1
                        while scanning == 1:
                            match end < length:
                                -1:
                                    match generic_is_word_char(vector_get<i64>(source, end)):
                                        -1:
                                            scanning = 0
                                        0:
                                            scanning = 0
                                        1:
                                            end = end + 1
                                0:
                                    scanning = 0
                                1:
                                    scanning = 0
                        mut token_id: i64 = token_count
                        discard vector_push<i64>(ids, token_id)
                        discard vector_push<i64>(kinds, generic_word_kind(source, start, end))
                        discard vector_push<i64>(starts, start)
                        discard vector_push<i64>(ends, end)
                        token_count = token_count + 1
                        cursor = end
            0:
                mut token_id: i64 = token_count
                discard vector_push<i64>(ids, token_id)
                discard vector_push<i64>(kinds, 6)
                discard vector_push<i64>(starts, cursor)
                discard vector_push<i64>(ends, cursor)
                token_count = token_count + 1
                cursor = cursor + 1
            1:
                cursor = cursor + 1

    mut token_id: i64 = token_count
    discard vector_push<i64>(ids, token_id)
    discard vector_push<i64>(kinds, 0)
    discard vector_push<i64>(starts, length)
    discard vector_push<i64>(ends, length)
    return token_count + 1

export fn generic_lexer_scan(source: &vector<i64>) -> vector<i64>:
    mut ids: vector<i64> = vector_new<i64>(1025)
    mut kinds: vector<i64> = vector_new<i64>(1025)
    mut starts: vector<i64> = vector_new<i64>(1025)
    mut ends: vector<i64> = vector_new<i64>(1025)
    mut count: i64 = generic_lexer_scan_tokens(source, &mut ids, &mut kinds, &mut starts, &mut ends)
    mut stream: vector<i64> = vector_new<i64>(1 + count * 3)
    discard vector_push<i64>(&mut stream, count)
    mut index: i64 = 0
    while index < count:
        discard vector_push<i64>(&mut stream, vector_get<i64>(&kinds, index))
        discard vector_push<i64>(&mut stream, vector_get<i64>(&starts, index))
        discard vector_push<i64>(&mut stream, vector_get<i64>(&ends, index))
        index = index + 1
    return stream

export fn generic_token_count(stream: &vector<i64>) -> i64:
    match vector_len<i64>(stream) > 0:
        -1:
            mut count: i64 = vector_get<i64>(stream, 0)
            match count >= 0:
                -1:
                    match vector_len<i64>(stream) == 1 + count * 3:
                        -1:
                            return count
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return 0
        1:
            return 0

export fn generic_token_kind(stream: &vector<i64>, index: i64) -> i64:
    match index >= 0:
        -1:
            match index < generic_token_count(stream):
                -1:
                    return vector_get<i64>(stream, 1 + index * 3)
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

export fn generic_token_start(stream: &vector<i64>, index: i64) -> i64:
    match index >= 0:
        -1:
            match index < generic_token_count(stream):
                -1:
                    return vector_get<i64>(stream, 2 + index * 3)
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

export fn generic_token_end(stream: &vector<i64>, index: i64) -> i64:
    match index >= 0:
        -1:
            match index < generic_token_count(stream):
                -1:
                    return vector_get<i64>(stream, 3 + index * 3)
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

export fn generic_lexer_scan_digest(source: &vector<i64>) -> i64:
    mut ids: vector<i64> = vector_new<i64>(64)
    mut kinds: vector<i64> = vector_new<i64>(64)
    mut starts: vector<i64> = vector_new<i64>(64)
    mut ends: vector<i64> = vector_new<i64>(64)
    discard generic_lexer_scan_tokens(source, &mut ids, &mut kinds, &mut starts, &mut ends)

    mut index: i64 = 0
    mut digest: i64 = 0
    while index < vector_len<i64>(&ids):
        digest = digest + vector_get<i64>(&ids, index) * 3
        digest = digest + vector_get<i64>(&kinds, index) * 5
        digest = digest + vector_get<i64>(&starts, index) * 7
        digest = digest + vector_get<i64>(&ends, index) * 11
        index = index + 1
    return digest

export fn generic_lexer_native_case(case_id: i64) -> i64:
    mut source: vector<i64> = vector_new<i64>(32)
    discard vector_push<i64>(&mut source, 102)
    discard vector_push<i64>(&mut source, 110)
    discard vector_push<i64>(&mut source, 32)
    match case_id == 2:
        -1:
            discard vector_push<i64>(&mut source, 101)
            discard vector_push<i64>(&mut source, 110)
            discard vector_push<i64>(&mut source, 116)
            discard vector_push<i64>(&mut source, 114)
            discard vector_push<i64>(&mut source, 121)
        0:
            match case_id == 3:
                -1:
                    discard vector_push<i64>(&mut source, 119)
                    discard vector_push<i64>(&mut source, 111)
                    discard vector_push<i64>(&mut source, 114)
                    discard vector_push<i64>(&mut source, 107)
                    discard vector_push<i64>(&mut source, 101)
                    discard vector_push<i64>(&mut source, 114)
                0:
                    discard vector_push<i64>(&mut source, 109)
                    discard vector_push<i64>(&mut source, 97)
                    discard vector_push<i64>(&mut source, 105)
                    discard vector_push<i64>(&mut source, 110)
                1:
                    discard vector_push<i64>(&mut source, 109)
                    discard vector_push<i64>(&mut source, 97)
                    discard vector_push<i64>(&mut source, 105)
                    discard vector_push<i64>(&mut source, 110)
        1:
            discard vector_push<i64>(&mut source, 109)
            discard vector_push<i64>(&mut source, 97)
            discard vector_push<i64>(&mut source, 105)
            discard vector_push<i64>(&mut source, 110)
    match case_id == 0:
        -1:
            discard 0
        0:
            discard vector_push<i64>(&mut source, 40)
            discard vector_push<i64>(&mut source, 41)
        1:
            discard vector_push<i64>(&mut source, 40)
            discard vector_push<i64>(&mut source, 41)
    discard vector_push<i64>(&mut source, 10)
    discard vector_push<i64>(&mut source, 114)
    discard vector_push<i64>(&mut source, 101)
    discard vector_push<i64>(&mut source, 116)
    discard vector_push<i64>(&mut source, 117)
    discard vector_push<i64>(&mut source, 114)
    discard vector_push<i64>(&mut source, 110)
    discard vector_push<i64>(&mut source, 32)
    match case_id == 2:
        -1:
            discard vector_push<i64>(&mut source, 52)
            discard vector_push<i64>(&mut source, 50)
        0:
            match case_id == 3:
                -1:
                    discard vector_push<i64>(&mut source, 55)
                0:
                    discard vector_push<i64>(&mut source, 48)
                1:
                    discard vector_push<i64>(&mut source, 48)
        1:
            discard vector_push<i64>(&mut source, 48)
    discard vector_push<i64>(&mut source, 10)
    return generic_lexer_scan_digest(&source)

export fn generic_native_parser_kind(kinds: &vector<i64>, cursor: i64) -> i64:
    match cursor <=> vector_len<i64>(kinds):
        -1:
            return vector_get<i64>(kinds, cursor)
        0:
            return -1
        1:
            return -1

export fn generic_native_parser_take(kinds: &vector<i64>, cursor: i64, wanted: i64) -> trit:
    match generic_native_parser_kind(kinds, cursor) == wanted:
        -1:
            return -1
        0:
            return 0
        1:
            return 1

fn generic_native_parser_skip_newlines(kinds: &vector<i64>, cursor: i64) -> i64:
    mut current: i64 = cursor
    while generic_native_parser_kind(kinds, current) == 6:
        current = current + 1
    return current

fn generic_native_parser_name_digest(source: &vector<i64>, start: i64, end: i64) -> i64:
    mut cursor: i64 = start
    mut digest: i64 = 0
    while cursor < end:
        mut scaled: i64 = digest * 31 + vector_get<i64>(source, cursor)
        mut quotient: i64 = scaled / 1000000000039
        digest = scaled - quotient * 1000000000039
        cursor = cursor + 1
    return digest

export fn generic_native_parser_integer_value(source: &vector<i64>, start: i64, end: i64) -> i64:
    mut cursor: i64 = start
    mut value: i64 = 0
    while cursor < end:
        value = value * 10 + vector_get<i64>(source, cursor) - 48
        cursor = cursor + 1
    return value

fn generic_native_parser_pack(cursor: i64, node: i64) -> i64:
    return cursor * 64 + node + 1

export fn generic_native_parser_packed_cursor(packed: i64) -> i64:
    mut cursor: i64 = 0
    mut remainder: i64 = packed
    while remainder >= 64:
        remainder = remainder - 64
        cursor = cursor + 1
    return cursor

export fn generic_native_parser_packed_node(packed: i64) -> i64:
    mut remainder: i64 = packed
    while remainder >= 64:
        remainder = remainder - 64
    return remainder - 1

fn generic_native_parser_add_node(
    node_kinds: &mut vector<i64>,
    node_operators: &mut vector<i64>,
    node_left: &mut vector<i64>,
    node_right: &mut vector<i64>,
    node_starts: &mut vector<i64>,
    node_ends: &mut vector<i64>,
    node_values: &mut vector<i64>,
    kind: i64,
    operator: i64,
    left: i64,
    right: i64,
    start: i64,
    end: i64,
    value: i64
) -> i64:
    mut node_id: i64 = vector_len<i64>(&*node_kinds)
    discard vector_push<i64>(node_kinds, kind)
    discard vector_push<i64>(node_operators, operator)
    discard vector_push<i64>(node_left, left)
    discard vector_push<i64>(node_right, right)
    discard vector_push<i64>(node_starts, start)
    discard vector_push<i64>(node_ends, end)
    discard vector_push<i64>(node_values, value)
    return node_id

fn generic_native_parser_span_is_mut(
    source: &vector<i64>,
    start: i64,
    end: i64
) -> i64:
    match end - start == 3:
        -1:
            match vector_get<i64>(source, start) == 109:
                -1:
                    match vector_get<i64>(source, start + 1) == 117:
                        -1:
                            match vector_get<i64>(source, start + 2) == 116:
                                -1:
                                    return 1
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn generic_native_parser_has_named_argument(
    kinds: &vector<i64>, cursor: i64
) -> i64:
    match generic_native_parser_kind(kinds, cursor) == 1:
        -1:
            match generic_native_parser_kind(kinds, cursor + 1) == 161:
                -1:
                    match generic_native_parser_kind(kinds, cursor + 2) == 161:
                        -1:
                            return 0
                        0:
                            match generic_native_parser_kind(kinds, cursor + 2) == 162:
                                -1:
                                    return 0
                                0:
                                    return 1
                                1:
                                    return 1
                        1:
                            match generic_native_parser_kind(kinds, cursor + 2) == 162:
                                -1:
                                    return 0
                                0:
                                    return 1
                                1:
                                    return 1
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

export fn generic_native_parser_expression(
    source: &vector<i64>,
    kinds: &vector<i64>,
    starts: &vector<i64>,
    ends: &vector<i64>,
    cursor: i64,
    minimum_precedence: i64,
    node_kinds: &mut vector<i64>,
    node_operators: &mut vector<i64>,
    node_left: &mut vector<i64>,
    node_right: &mut vector<i64>,
    node_starts: &mut vector<i64>,
    node_ends: &mut vector<i64>,
    node_values: &mut vector<i64>
) -> i64:
    mut expression_cursor: i64 = cursor
    mut negative_integer_literal: i64 = 0
    mut reference_flag: i64 = 0
    mut left_result: i64 = -1
    match generic_native_parser_kind(kinds, expression_cursor) == 138:
        -1:
            expression_cursor = expression_cursor + 1
            reference_flag = 1
            match generic_native_parser_kind(kinds, expression_cursor) == 1:
                -1:
                    match generic_native_parser_span_is_mut(
                        source,
                        vector_get<i64>(starts, expression_cursor),
                        vector_get<i64>(ends, expression_cursor)
                    ) == 1:
                        -1:
                            expression_cursor = expression_cursor + 1
                            reference_flag = 2
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
        0:
            discard 0
        1:
            discard 0
    match generic_native_parser_kind(kinds, expression_cursor) == 145:
        -1:
            match generic_native_parser_kind(kinds, expression_cursor + 1) == 5:
                -1:
                    expression_cursor = expression_cursor + 1
                    negative_integer_literal = 1
                0:
                    discard 0
                1:
                    discard 0
        0:
            discard 0
        1:
            discard 0
    match generic_native_parser_kind(kinds, expression_cursor) == 5:
        -1:
            mut integer_start: i64 = vector_get<i64>(starts, expression_cursor)
            mut integer_end: i64 = vector_get<i64>(ends, expression_cursor)
            mut integer_value: i64 = generic_native_parser_integer_value(source, integer_start, integer_end)
            match negative_integer_literal == 1:
                -1:
                    integer_value = 0 - integer_value
                0:
                    discard 0
                1:
                    discard 0
            mut integer_node: i64 = generic_native_parser_add_node(
                node_kinds,
                node_operators,
                node_left,
                node_right,
                node_starts,
                node_ends,
                node_values,
                1,
                0,
                -1,
                -1,
                integer_start,
                integer_end,
                integer_value
            )
            left_result = generic_native_parser_pack(expression_cursor + 1, integer_node)
        0:
            match generic_native_parser_kind(kinds, expression_cursor) == 1:
                -1:
                    mut identifier_start: i64 = vector_get<i64>(starts, expression_cursor)
                    mut identifier_end: i64 = vector_get<i64>(ends, expression_cursor)
