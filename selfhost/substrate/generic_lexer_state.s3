export fn generic_native_parser_parse_expression(
    source: &vector<i64>,
    stream: &vector<i64>,
    cursor: i64,
    minimum_precedence: i64
) -> vector<i64>:
    mut token_count: i64 = generic_token_count(stream)
    mut kinds: vector<i64> = vector_new<i64>(token_count)
    mut starts: vector<i64> = vector_new<i64>(token_count)
    mut ends: vector<i64> = vector_new<i64>(token_count)
    mut token_index: i64 = 0
    while token_index < token_count:
        discard vector_push<i64>(&mut kinds, generic_token_kind(stream, token_index))
        discard vector_push<i64>(&mut starts, generic_token_start(stream, token_index))
        discard vector_push<i64>(&mut ends, generic_token_end(stream, token_index))
        token_index = token_index + 1
    mut node_kinds: vector<i64> = vector_new<i64>(64)
    mut node_operators: vector<i64> = vector_new<i64>(64)
    mut node_left: vector<i64> = vector_new<i64>(64)
    mut node_right: vector<i64> = vector_new<i64>(64)
    mut node_starts: vector<i64> = vector_new<i64>(64)
    mut node_ends: vector<i64> = vector_new<i64>(64)
    mut node_values: vector<i64> = vector_new<i64>(64)
    mut packed_result: i64 = generic_native_parser_expression(
        source,
        &kinds,
        &starts,
        &ends,
        cursor,
        minimum_precedence,
        &mut node_kinds,
        &mut node_operators,
        &mut node_left,
        &mut node_right,
        &mut node_starts,
        &mut node_ends,
        &mut node_values
    )
    mut node_count: i64 = vector_len<i64>(&node_kinds)
    mut tree: vector<i64> = vector_new<i64>(2 + node_count * 7)
    discard vector_push<i64>(&mut tree, packed_result)
    discard vector_push<i64>(&mut tree, node_count)
    mut node: i64 = 0
    while node < node_count:
        discard vector_push<i64>(&mut tree, vector_get<i64>(&node_kinds, node))
        discard vector_push<i64>(&mut tree, vector_get<i64>(&node_operators, node))
        discard vector_push<i64>(&mut tree, vector_get<i64>(&node_left, node))
        discard vector_push<i64>(&mut tree, vector_get<i64>(&node_right, node))
        discard vector_push<i64>(&mut tree, vector_get<i64>(&node_starts, node))
        discard vector_push<i64>(&mut tree, vector_get<i64>(&node_ends, node))
        discard vector_push<i64>(&mut tree, vector_get<i64>(&node_values, node))
        node = node + 1
    return tree

export fn generic_expression_packed_result(tree: &vector<i64>) -> i64:
    match vector_len<i64>(tree) >= 2:
        -1:
            return vector_get<i64>(tree, 0)
        0:
            return -1
        1:
            return -1

export fn generic_expression_node_count(tree: &vector<i64>) -> i64:
    match vector_len<i64>(tree) >= 2:
        -1:
            mut count: i64 = vector_get<i64>(tree, 1)
            match count >= 0:
                -1:
                    match vector_len<i64>(tree) == 2 + count * 7:
                        -1:
                            return count
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn generic_expression_field(tree: &vector<i64>, index: i64, field: i64) -> i64:
    match index >= 0:
        -1:
            match index < generic_expression_node_count(tree):
                -1:
                    match field >= 0:
                        -1:
                            match field < 7:
                                -1:
                                    return vector_get<i64>(tree, 2 + index * 7 + field)
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

export fn generic_expression_node_kind(tree: &vector<i64>, index: i64) -> i64:
    return generic_expression_field(tree, index, 0)

export fn generic_expression_node_operator(tree: &vector<i64>, index: i64) -> i64:
    return generic_expression_field(tree, index, 1)

export fn generic_expression_node_left(tree: &vector<i64>, index: i64) -> i64:
    return generic_expression_field(tree, index, 2)

export fn generic_expression_node_right(tree: &vector<i64>, index: i64) -> i64:
    return generic_expression_field(tree, index, 3)

export fn generic_expression_node_value(tree: &vector<i64>, index: i64) -> i64:
    return generic_expression_field(tree, index, 6)

export fn generic_expression_node_start(tree: &vector<i64>, index: i64) -> i64:
    return generic_expression_field(tree, index, 4)

export fn generic_expression_node_end(tree: &vector<i64>, index: i64) -> i64:
    return generic_expression_field(tree, index, 5)

export fn generic_native_parser_program_type_code_for_token(
    source: &vector<i64>,
    stream: &vector<i64>,
    token_index: i64
) -> i64:
    mut token_count: i64 = generic_token_count(stream)
    mut starts: vector<i64> = vector_new<i64>(token_count)
    mut ends: vector<i64> = vector_new<i64>(token_count)
    mut index: i64 = 0
    while index < token_count:
        discard vector_push<i64>(&mut starts, generic_token_start(stream, index))
        discard vector_push<i64>(&mut ends, generic_token_end(stream, index))
        index = index + 1
    return generic_native_parser_program_type_code(source, &starts, &ends, token_index)

fn generic_native_parser_tree_digest(
    node: i64,
    node_kinds: &vector<i64>,
    node_operators: &vector<i64>,
    node_left: &vector<i64>,
    node_right: &vector<i64>,
    node_starts: &vector<i64>,
    node_ends: &vector<i64>,
    node_values: &vector<i64>
) -> i64:
    mut kind: i64 = vector_get<i64>(node_kinds, node)
    mut operator: i64 = vector_get<i64>(node_operators, node)
    mut start: i64 = vector_get<i64>(node_starts, node)
    mut end: i64 = vector_get<i64>(node_ends, node)
    mut digest: i64 = kind * 97 + operator * 101 + start * 103 + end * 107
    match kind == 4:
        -1:
            mut callee_digest: i64 = generic_native_parser_tree_digest(
                vector_get<i64>(node_left, node),
                node_kinds,
                node_operators,
                node_left,
                node_right,
                node_starts,
                node_ends,
                node_values
            )
            match vector_get<i64>(node_right, node) <=> 0:
                -1:
                    return digest + callee_digest * 113
                0:
                    return digest + callee_digest * 113
                1:
                    mut arguments_digest: i64 = generic_native_parser_tree_digest(
                        vector_get<i64>(node_right, node),
                        node_kinds,
                        node_operators,
                        node_left,
                        node_right,
                        node_starts,
                        node_ends,
                        node_values
                    )
                    return digest + callee_digest * 113 + arguments_digest * 127
        0:
            match kind == 5:
                -1:
                    mut argument_digest: i64 = generic_native_parser_tree_digest(
                        vector_get<i64>(node_left, node),
                        node_kinds,
                        node_operators,
                        node_left,
                        node_right,
                        node_starts,
                        node_ends,
                        node_values
                    )
                    match vector_get<i64>(node_right, node) <=> 0:
                        -1:
                            return digest + argument_digest * 113
                        0:
                            return digest + argument_digest * 113
                        1:
                            mut next_argument_digest: i64 = generic_native_parser_tree_digest(
                                vector_get<i64>(node_right, node),
                                node_kinds,
                                node_operators,
                                node_left,
                                node_right,
                                node_starts,
                                node_ends,
                                node_values
                            )
                            return digest + argument_digest * 113 + next_argument_digest * 127
                0:
                    discard 0
                1:
                    discard 0
        1:
            discard 0
    match kind == 1:
        -1:
            digest = digest + vector_get<i64>(node_values, node) * 109
        0:
            match kind == 3:
                -1:
                    digest = digest + vector_get<i64>(node_values, node) * 109
                0:
                    mut left_digest: i64 = generic_native_parser_tree_digest(
                        vector_get<i64>(node_left, node),
                        node_kinds,
                        node_operators,
                        node_left,
                        node_right,
                        node_starts,
                        node_ends,
                        node_values
                    )
                    mut right_digest: i64 = generic_native_parser_tree_digest(
                        vector_get<i64>(node_right, node),
                        node_kinds,
                        node_operators,
                        node_left,
                        node_right,
                        node_starts,
                        node_ends,
                        node_values
                    )
                    digest = digest + left_digest * 113 + right_digest * 127
                1:
