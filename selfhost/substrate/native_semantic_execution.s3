
fn native_semantic_find_function(
    source: &vector<i64>,
    kinds: &vector<i64>,
    starts: &vector<i64>,
    ends: &vector<i64>,
    token_count: i64,
    wanted_name: i64
) -> i64:
    mut cursor: i64 = 0
    while cursor < token_count:
        match generic_native_parser_kind(kinds, cursor) == 2:
            -1:
                match generic_native_parser_name_digest(
                    source,
                    vector_get<i64>(starts, cursor + 1),
                    vector_get<i64>(ends, cursor + 1)
                ) == wanted_name:
                    -1:
                        return cursor
                    0:
                        cursor = cursor + 1
                    1:
                        cursor = cursor + 1
            0:
                cursor = cursor + 1
            1:
                cursor = cursor + 1
        cursor = cursor + 1
    return -1

fn native_semantic_lookup(
    names: &i64_vector,
    values: &i64_vector,
    wanted_name: i64,
    result: &mut vector<i64>
) -> i64:
    mut index: i64 = 0
    while index < i64_vector_len(names):
        match i64_vector_get(names, index) == wanted_name:
            -1:
                discard vector_push<i64>(result, i64_vector_get(values, index))
                return 1
            0:
                index = index
            1:
                index = index
        index = index + 1
    return 0

fn native_semantic_expression(
    source: &vector<i64>,
    kinds: &vector<i64>,
    starts: &vector<i64>,
    ends: &vector<i64>,
    token_count: i64,
    cursor: i64,
    minimum_precedence: i64,
    names: &i64_vector,
    values: &i64_vector,
    result: &mut vector<i64>
) -> i64:
    mut left_cursor: i64 = cursor
    mut left_value: i64 = 0
    match generic_native_parser_kind(kinds, left_cursor) == 5:
        -1:
            left_value = generic_native_parser_integer_value(
                source,
                vector_get<i64>(starts, left_cursor),
                vector_get<i64>(ends, left_cursor)
            )
            left_cursor = left_cursor + 1
        0:
            match generic_native_parser_kind(kinds, left_cursor) == 1:
                -1:
                    mut name: i64 = generic_native_parser_name_digest(
                        source,
                        vector_get<i64>(starts, left_cursor),
                        vector_get<i64>(ends, left_cursor)
                    )
                    match generic_native_parser_kind(kinds, left_cursor + 1) == 7:
                        -1:
                            mut argument_cursor: i64 = left_cursor + 2
                            mut arguments: i64_vector = i64_vector_new<i64>(64)
                            mut parsing_arguments: i64 = 1
                            while parsing_arguments == 1:
                                match generic_native_parser_kind(kinds, argument_cursor) == 8:
                                    -1:
                                        parsing_arguments = 0
                                    0:
                                        mut argument_result: vector<i64> = vector_new<i64>(4)
                                        match native_semantic_expression(
                                            source,
                                            kinds,
                                            starts,
                                            ends,
                                            token_count,
                                            argument_cursor,
                                            0,
                                            names,
                                            values,
                                            &mut argument_result
                                        ) == 1:
                                            -1:
                                                discard i64_vector_push(
                                                    &mut arguments,
                                                    vector_get<i64>(&argument_result, 1)
                                                )
                                                argument_cursor = vector_get<i64>(&argument_result, 0)
                                                match generic_native_parser_kind(kinds, argument_cursor) == 144:
                                                    -1:
                                                        argument_cursor = argument_cursor + 1
                                                    0:
                                                        parsing_arguments = 0
                                                    1:
                                                        parsing_arguments = 0
                                            0:
                                                return -1
                                            1:
                                                return -1
                                    1:
                                        return -1
                            match generic_native_parser_kind(kinds, argument_cursor) == 8:
                                -1:
                                    mut function_result: vector<i64> = vector_new<i64>(4)
                                    mut function_start: i64 = native_semantic_find_function(
                                        source,
                                        kinds,
                                        starts,
                                        ends,
                                        token_count,
                                        name
                                    )
                                    match function_start <=> -1:
                                        -1:
                                            return -1
                                        0:
                                            return -1
                                        1:
                                            match native_semantic_function(
                                                source,
                                                kinds,
                                                starts,
                                                ends,
                                                token_count,
                                                function_start,
                                                &arguments,
                                                &mut function_result
                                            ) == 1:
                                                -1:
                                                    left_value = vector_get<i64>(&function_result, 1)
                                                    left_cursor = argument_cursor + 1
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            mut lookup_result: vector<i64> = vector_new<i64>(2)
                            match native_semantic_lookup(names, values, name, &mut lookup_result) == 1:
                                -1:
                                    left_value = vector_get<i64>(&lookup_result, 0)
                                    left_cursor = left_cursor + 1
                                0:
                                    return -1
                                1:
                                    return -1
                        1:
                            return -1
                0:
                    match generic_native_parser_kind(kinds, left_cursor) == 7:
                        -1:
                            mut grouped_result: vector<i64> = vector_new<i64>(4)
                            match native_semantic_expression(
                                source,
                                kinds,
                                starts,
                                ends,
                                token_count,
                                left_cursor + 1,
                                0,
                                names,
                                values,
                                &mut grouped_result
                            ) == 1:
                                -1:
                                    left_cursor = vector_get<i64>(&grouped_result, 0)
                                    left_value = vector_get<i64>(&grouped_result, 1)
                                    match generic_native_parser_kind(kinds, left_cursor) == 8:
                                        -1:
                                            left_cursor = left_cursor + 1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                1:
                    return -1
        1:
            return -1

    mut scanning: i64 = 1
    while scanning == 1:
        mut operator: i64 = 0
        mut precedence: i64 = 0
        match generic_native_parser_kind(kinds, left_cursor) == 143:
            -1:
                operator = 1
                precedence = 1
            0:
                match generic_native_parser_kind(kinds, left_cursor) == 142:
                    -1:
                        operator = 2
                        precedence = 2
                    0:
                        match generic_native_parser_kind(kinds, left_cursor) == 160:
                            -1:
                                operator = 3
                                precedence = 1
                            0:
                                scanning = 0
                            1:
                                scanning = 0
                    1:
                        scanning = 0
            1:
                scanning = 0
        match scanning == 1:
            -1:
                match precedence < minimum_precedence:
                    -1:
                        scanning = 0
                    0:
                        mut right_result: vector<i64> = vector_new<i64>(4)
                        match native_semantic_expression(
                            source,
                            kinds,
                            starts,
                            ends,
                            token_count,
                            left_cursor + 1,
                            precedence + 1,
                            names,
                            values,
                            &mut right_result
                        ) == 1:
                            -1:
                                match operator == 1:
                                    -1:
                                        left_value = left_value + vector_get<i64>(&right_result, 1)
                                    0:
                                        match operator == 2:
                                            -1:
                                                left_value = left_value * vector_get<i64>(&right_result, 1)
                                            0:
                                                match left_value <=> vector_get<i64>(&right_result, 1):
                                                    -1:
                                                        left_value = -1
                                                    0:
                                                        left_value = 0
                                                    1:
                                                        left_value = 1
                                            1:
                                                left_value = left_value
                                    1:
                                        left_value = left_value
                                left_cursor = vector_get<i64>(&right_result, 0)
                            0:
                                return -1
                            1:
                                return -1
                    1:
                        scanning = 0
            0:
                scanning = 0
            1:
                scanning = 0
    discard vector_push<i64>(result, left_cursor)
    discard vector_push<i64>(result, left_value)
    return 1

fn native_semantic_while_single_assignment(
    source: &vector<i64>,
    kinds: &vector<i64>,
    starts: &vector<i64>,
    ends: &vector<i64>,
    token_count: i64,
    while_cursor: i64,
    names: &i64_vector,
    values: &mut i64_vector,
    result: &mut vector<i64>
) -> i64:
    mut condition_start: i64 = while_cursor + 1
    mut condition_cursor: i64 = condition_start
    mut condition_result: vector<i64> = vector_new<i64>(4)
    match native_semantic_expression(
        source,
        kinds,
        starts,
        ends,
        token_count,
        condition_start,
        0,
        &*names,
        &*values,
        &mut condition_result
    ) == 1:
        -1:
            condition_cursor = vector_get<i64>(&condition_result, 0)
        0:
            return -1
        1:
            return -1
    match generic_native_parser_kind(kinds, condition_cursor) == 158:
        -1:
            condition_cursor = condition_cursor
        0:
            return -1
        1:
            return -1
    match generic_native_parser_kind(kinds, condition_cursor + 1) == 6:
        -1:
            condition_cursor = condition_cursor
        0:
            return -1
        1:
            return -1
    mut body_start: i64 = condition_cursor + 2
    mut body_indent: i64 = generic_native_parser_program_indent(
        source,
        vector_get<i64>(starts, body_start)
    )
    mut searching: i64 = 1
    mut iterations: i64 = 0
    mut next_cursor: i64 = body_start
    while searching == 1:
        match iterations < 64:
            -1:
                mut current_condition: vector<i64> = vector_new<i64>(4)
                match native_semantic_expression(
                    source,
                    kinds,
                    starts,
                    ends,
                    token_count,
                    condition_start,
                    0,
                    &*names,
                    &*values,
                    &mut current_condition
                ) == 1:
                    -1:
                        match vector_get<i64>(&current_condition, 1) <=> -1:
                            -1:
                                return -1
                            0:
                                match generic_native_parser_kind(
                                    kinds,
                                    vector_get<i64>(&current_condition, 0)
                                ) == 158:
                                    -1:
                                        match generic_native_parser_kind(
                                            kinds,
                                            vector_get<i64>(&current_condition, 0) + 1
                                        ) == 6:
                                            -1:
                                                mut body_name: i64 = generic_native_parser_name_digest(
                                                    source,
                                                    vector_get<i64>(starts, body_start),
                                                    vector_get<i64>(ends, body_start)
                                                )
                                                match generic_native_parser_kind(
                                                    kinds,
                                                    body_start
                                                ) == 1:
                                                    -1:
                                                        match generic_native_parser_kind(
                                                            kinds,
                                                            body_start + 1
                                                        ) == 161:
                                                            -1:
                                                                mut assignment_result: vector<i64> = vector_new<i64>(4)
                                                                match native_semantic_expression(
                                                                    source,
                                                                    kinds,
                                                                    starts,
                                                                    ends,
                                                                    token_count,
                                                                    body_start + 2,
                                                                    0,
                                                                    &*names,
                                                                    &*values,
                                                                    &mut assignment_result
                                                                ) == 1:
                                                                    -1:
                                                                        match generic_native_parser_kind(
                                                                            kinds,
                                                                            vector_get<i64>(&assignment_result, 0)
                                                                        ) == 6:
                                                                            -1:
                                                                                mut name_index: i64 = 0
                                                                                mut found: i64 = 0
                                                                                while name_index < i64_vector_len(&*names):
                                                                                    match i64_vector_get(&*names, name_index) == body_name:
                                                                                        -1:
                                                                                            discard i64_vector_set(
                                                                                                values,
                                                                                                name_index,
                                                                                                vector_get<i64>(&assignment_result, 1)
                                                                                            )
                                                                                            found = 1
                                                                                            name_index = i64_vector_len(&*names)
                                                                                        0:
                                                                                            name_index = name_index + 1
                                                                                        1:
                                                                                            name_index = name_index + 1
                                                                                match found == 1:
                                                                                    -1:
                                                                                        match vector_get<i64>(&assignment_result, 0) + 1 < token_count:
                                                                                            -1:
                                                                                                next_cursor = vector_get<i64>(&assignment_result, 0) + 1
                                                                                                match generic_native_parser_program_indent(
                                                                                                    source,
                                                                                                    vector_get<i64>(starts, next_cursor)
                                                                                                ) < body_indent:
                                                                                                    -1:
                                                                                                        iterations = iterations + 1
                                                                                                    0:
                                                                                                        return -1
                                                                                                    1:
                                                                                                        return -1
                                                                                            0:
                                                                                                return -1
                                                                                            1:
                                                                                                return -1
                                                                                    0:
                                                                                        return -1
                                                                                    1:
                                                                                        return -1
                                                                            0:
                                                                                return -1
                                                                            1:
                                                                                return -1
                                                                    0:
                                                                        return -1
                                                                    1:
                                                                        return -1
                                                            0:
                                                                return -1
                                                            1:
                                                                return -1
                                                    0:
                                                        return -1
                                                    1:
                                                        return -1
                                            0:
                                                return -1
                                            1:
                                                return -1
                                    0:
                                        return -1
                                    1:
                                        return -1
                            1:
                                searching = 0
                    0:
                        return -1
                    1:
                        return -1
            0:
                return -1
            1:
                return -1
    discard vector_push<i64>(result, next_cursor)
    return 1

fn native_semantic_function(
    source: &vector<i64>,
    kinds: &vector<i64>,
    starts: &vector<i64>,
    ends: &vector<i64>,
    token_count: i64,
    function_start: i64,
    arguments: &i64_vector,
    result: &mut vector<i64>
) -> i64:
    mut current: i64 = function_start + 2
    mut names: i64_vector = i64_vector_new<i64>(64)
    mut values: i64_vector = i64_vector_new<i64>(64)
    mut argument_index: i64 = 0
    match generic_native_parser_kind(kinds, current) == 7:
        -1:
            current = current + 1
            mut parsing_parameters: i64 = 1
            while parsing_parameters == 1:
                match generic_native_parser_kind(kinds, current) == 8:
                    -1:
                        parsing_parameters = 0
                    0:
                        match generic_native_parser_kind(kinds, current) == 1:
                            -1:
                                discard i64_vector_push(
                                    &mut names,
                                    generic_native_parser_name_digest(
                                        source,
                                        vector_get<i64>(starts, current),
                                        vector_get<i64>(ends, current)
                                    )
                                )
                                current = current + 1
                                match generic_native_parser_take(kinds, current, 158):
                                    -1:
                                        current = current + 1
                                    0:
                                        return -1
                                    1:
                                        return -1
                                current = current + 1
                                match argument_index < i64_vector_len(arguments):
                                    -1:
                                        discard i64_vector_push(
                                            &mut values,
                                            i64_vector_get(arguments, argument_index)
                                        )
                                    0:
                                        return -1
                                    1:
                                        return -1
                                argument_index = argument_index + 1
                                match generic_native_parser_kind(kinds, current) == 144:
                                    -1:
                                        current = current + 1
                                    0:
                                        parsing_parameters = 0
                                    1:
                                        parsing_parameters = 0
                            0:
                                return -1
                            1:
                                return -1
                    1:
                        return -1
        0:
            return -1
        1:
            return -1
    match generic_native_parser_take(kinds, current, 8):
        -1:
            current = current + 1
        0:
            return -1
        1:
            return -1
    match generic_native_parser_take(kinds, current, 145):
        -1:
            current = current + 1
        0:
            return -1
        1:
            return -1
    current = current + 1
    match generic_native_parser_take(kinds, current, 1):
        -1:
            current = current + 1
        0:
            return -1
        1:
            return -1
    match generic_native_parser_take(kinds, current, 158):
        -1:
            current = current + 1
        0:
            return -1
        1:
            return -1
    match generic_native_parser_take(kinds, current, 6):
        -1:
            current = current + 1
        0:
            return -1
        1:
            return -1
    mut scanning: i64 = 1
    while scanning == 1:
        match generic_native_parser_program_word_code(
            source,
            starts,
            ends,
            current
        ) == 4:
            -1:
                mut while_result: vector<i64> = vector_new<i64>(2)
                match native_semantic_while_single_assignment(
                    source,
                    kinds,
                    starts,
                    ends,
                    token_count,
                    current,
                    &names,
                    &mut values,
                    &mut while_result
                ) == 1:
                    -1:
                        current = vector_get<i64>(&while_result, 0)
                    0:
                        return -1
                    1:
                        return -1
            0:
                match generic_native_parser_kind(kinds, current) == 6:
                    0:
                        match generic_native_parser_kind(kinds, current) == 3:
                            -1:
                                mut expression_result: vector<i64> = vector_new<i64>(4)
                                match native_semantic_expression(
                                    source,
                                    kinds,
                                    starts,
                                    ends,
                                    token_count,
                                    current + 1,
                                    0,
                                    &names,
                                    &values,
                                    &mut expression_result
                                ) == 1:
                                    -1:
                                        match generic_native_parser_kind(
                                            kinds,
                                            vector_get<i64>(&expression_result, 0)
                                        ) == 6:
                                            -1:
                                                discard vector_push<i64>(result, function_start)
                                                discard vector_push<i64>(
                                                    result,
                                                    vector_get<i64>(&expression_result, 1)
                                                )
                                                return 1
                                            0:
                                                return -1
                                            1:
                                                return -1
                                    0:
                                        return -1
                                    1:
                                        return -1
                            0:
                                match generic_native_parser_kind(kinds, current) == 1:
                                    -1:
                                        mut name: i64 = generic_native_parser_name_digest(
                                            source,
                                            vector_get<i64>(starts, current),
                                            vector_get<i64>(ends, current)
                                        )
                                        match generic_native_parser_kind(
                                            kinds,
                                            current + 1
                                        ) == 158:
                                            -1:
                                                current = current + 3
                                                match generic_native_parser_kind(
                                                    kinds,
                                                    current
                                                ) == 161:
                                                    -1:
                                                        mut expression_result: vector<i64> = vector_new<i64>(4)
                                                        match native_semantic_expression(
                                                            source,
                                                            kinds,
                                                            starts,
                                                            ends,
                                                            token_count,
                                                            current + 1,
                                                            0,
                                                            &names,
                                                            &values,
                                                            &mut expression_result
                                                        ) == 1:
                                                            -1:
                                                                match generic_native_parser_kind(
                                                                    kinds,
                                                                    vector_get<i64>(&expression_result, 0)
                                                                ) == 6:
                                                                    -1:
                                                                        discard i64_vector_push(&mut names, name)
                                                                        discard i64_vector_push(
                                                                            &mut values,
                                                                            vector_get<i64>(&expression_result, 1)
                                                                        )
                                                                        current = vector_get<i64>(&expression_result, 0) + 1
                                                                    0:
                                                                        return -1
                                                                    1:
                                                                        return -1
                                                            0:
                                                                return -1
                                                            1:
                                                                return -1
                                                    0:
                                                        return -1
                                                    1:
                                                        return -1
                                            1:
                                                return -1
                                            0:
                                                current = current + 2
                                                mut expression_result: vector<i64> = vector_new<i64>(4)
                                                match native_semantic_expression(
                                                    source,
                                                    kinds,
                                                    starts,
                                                    ends,
                                                    token_count,
                                                    current,
                                                    0,
                                                    &names,
                                                    &values,
                                                    &mut expression_result
                                                ) == 1:
                                                    -1:
                                                        mut name_index: i64 = 0
                                                        mut found: i64 = 0
                                                        while name_index < i64_vector_len(&names):
                                                            match i64_vector_get(&names, name_index) == name:
                                                                -1:
                                                                    discard i64_vector_set(
                                                                        &mut values,
                                                                        name_index,
                                                                        vector_get<i64>(&expression_result, 1)
                                                                    )
                                                                    found = 1
                                                                    name_index = i64_vector_len(&names)
                                                                0:
                                                                    name_index = name_index + 1
                                                                1:
                                                                    name_index = name_index + 1
                                                        match found == 1:
                                                            -1:
                                                                match generic_native_parser_kind(
                                                                    kinds,
                                                                    vector_get<i64>(&expression_result, 0)
                                                                ) == 6:
                                                                    -1:
                                                                        current = vector_get<i64>(&expression_result, 0) + 1
                                                                    0:
                                                                        return -1
                                                                    1:
                                                                        return -1
                                                            0:
                                                                return -1
                                                            1:
                                                                return -1
                                                    0:
                                                        return -1
                                                    1:
                                                        return -1
                                    0:
                                        return -1
                                    1:
                                        return -1
                            1:
                                return -1
                    -1:
                        current = current + 1
                    1:
                        return -1
            1:
                return -1
    return -1
fn native_semantic_program_call_names(
    source: &mut vector<i64>,
    first_name_id: i64,
    second_name_id: i64
) -> i64:
    discard generic_native_program_word(source, 7)
    discard generic_native_program_byte(source, 58)
    discard generic_native_program_byte(source, 32)
    discard generic_native_program_word(source, 12)
    discard generic_native_program_byte(source, 32)
    discard generic_native_program_byte(source, 61)
    discard generic_native_program_byte(source, 32)
    discard generic_native_program_word(source, 4)
    discard generic_native_program_byte(source, 40)
    discard generic_native_program_word(source, first_name_id)
    discard generic_native_program_byte(source, 44)
    discard generic_native_program_byte(source, 32)
    discard generic_native_program_word(source, second_name_id)
    discard generic_native_program_byte(source, 41)
    discard generic_native_program_byte(source, 10)
    return generic_native_program_indent(source)

fn native_semantic_build_case(source: &mut vector<i64>, case_id: i64) -> i64:
    match case_id <=> 0:
        -1:
            discard generic_native_program_v2_header(source, 1)
            discard generic_native_program_v2_return_literal(source, 42)
        0:
            discard generic_native_program_v2_header(source, 1)
            discard generic_native_program_v2_binding(source, 7, 40, 0, 1)
            discard generic_native_program_v2_add_words(source, 9, 7, 0, 2, 1)
            discard generic_native_program_v2_return(source, 9)
        1:
            match case_id <=> 1:
                -1:
                    return -1
                0:
                    discard generic_native_program_v2_add_parameter_header(source)
                    discard generic_native_program_v2_add_words(source, 3, 10, 11, 0, 0)
                    discard generic_native_program_v2_return(source, 3)
                    discard generic_native_program_byte(source, 10)
                    discard generic_native_program_v2_header(source, 1)
                    discard generic_native_program_v2_binding(source, 10, 40, 0, 1)
                    discard generic_native_program_v2_binding(source, 11, 2, 0, 1)
                    discard native_semantic_program_call_names(source, 10, 11)
                    discard generic_native_program_v2_return(source, 7)
                1:
                    match case_id <=> 2:
                        -1:
                            return -1
                        0:
                            discard generic_native_program_v2_header(source, 1)
                            discard generic_native_program_v2_binding(source, 10, 40, 0, 1)
                            discard generic_native_program_word(source, 15)
                            discard generic_native_program_byte(source, 32)
                            discard generic_native_program_word(source, 10)
                            discard generic_native_program_byte(source, 32)
                            discard generic_native_program_byte(source, 60)
                            discard generic_native_program_byte(source, 32)
                            discard generic_native_program_v2_literal(source, 42)
                            discard generic_native_program_byte(source, 58)
                            discard generic_native_program_byte(source, 10)
                            discard generic_native_program_indent(source)
                            discard generic_native_program_indent(source)
                            discard generic_native_program_v2_assignment_plus_one(source, 10)
                            discard generic_native_program_v2_return(source, 10)
                        1:
                            match case_id <=> 3:
                                -1:
                                    return -1
                                0:
                                    discard generic_native_program_v2_header(source, 1)
                                    discard generic_native_program_v2_binding(source, 7, 40, 0, 1)
                                    discard generic_native_program_word(source, 7)
                                    discard generic_native_program_byte(source, 32)
                                    discard generic_native_program_byte(source, 61)
                                    discard generic_native_program_byte(source, 32)
                                    discard generic_native_program_word(source, 7)
                                    discard generic_native_program_byte(source, 32)
                                    discard generic_native_program_byte(source, 43)
                                    discard generic_native_program_byte(source, 32)
                                    discard generic_native_program_v2_literal(source, 2)
                                    discard generic_native_program_byte(source, 10)
                                    discard generic_native_program_indent(source)
                                    discard generic_native_program_v2_return(source, 7)
                                1:
                                    discard generic_native_program_v2_header(source, 1)
                                    discard generic_native_program_word(source, 7)
                                    discard generic_native_program_byte(source, 58)
                                    discard generic_native_program_byte(source, 32)
                                    discard generic_native_program_word(source, 12)
                                    discard generic_native_program_byte(source, 32)
                                    discard generic_native_program_byte(source, 61)
                                    discard generic_native_program_byte(source, 32)
                                    discard generic_native_program_byte(source, 40)
                                    discard generic_native_program_v2_literal(source, 40)
                                    discard generic_native_program_byte(source, 32)
                                    discard generic_native_program_byte(source, 43)
                                    discard generic_native_program_byte(source, 32)
                                    discard generic_native_program_v2_literal(source, 2)
                                    discard generic_native_program_byte(source, 41)
                                    discard generic_native_program_byte(source, 10)
                                    discard generic_native_program_indent(source)
                                    discard generic_native_program_v2_return(source, 7)
    return 0

fn native_semantic_execute_source(source: &vector<i64>) -> i64:
    mut ids: vector<i64> = vector_new<i64>(128)
    mut kinds: vector<i64> = vector_new<i64>(128)
    mut starts: vector<i64> = vector_new<i64>(128)
    mut ends: vector<i64> = vector_new<i64>(128)
    mut token_count: i64 = generic_lexer_scan_tokens(
        source,
        &mut ids,
        &mut kinds,
        &mut starts,
        &mut ends
    )
    mut main_name: vector<i64> = vector_new<i64>(4)
    discard generic_native_program_word(&mut main_name, 1)
    mut main_name_digest: i64 = generic_native_parser_name_digest(
        &main_name,
        0,
        vector_len<i64>(&main_name)
    )
    mut function_start: i64 = native_semantic_find_function(
        source,
        &kinds,
        &starts,
        &ends,
        token_count,
        main_name_digest
    )
    match function_start <=> -1:
        -1:
            return -1
        0:
            return -1
        1:
            mut arguments: i64_vector = i64_vector_new<i64>(1)
            mut result: vector<i64> = vector_new<i64>(4)
            match native_semantic_function(
                source,
                &kinds,
                &starts,
                &ends,
                token_count,
                function_start,
                &arguments,
                &mut result
            ) == 1:
                -1:
                    return vector_get<i64>(&result, 1)
                0:
                    return -1
                1:
                    return -1

fn native_semantic_build_literal(source: &mut vector<i64>, value: i64) -> i64:
    discard generic_native_program_v2_header(source, 1)
    return generic_native_program_v2_return_literal(source, value)

export fn native_semantic_literal(value: i64) -> i64:
    mut source: vector<i64> = vector_new<i64>(512)
    match native_semantic_build_literal(&mut source, value) == -1:
        -1:
            return -1
        0:
            discard 0
        1:
            return -1
    return native_semantic_execute_source(&source)

export fn native_semantic_case(case_id: i64) -> i64:
    mut source: vector<i64> = vector_new<i64>(512)
    match native_semantic_build_case(&mut source, case_id) == -1:
        -1:
            return -1
        0:
            discard 0
        1:
            return -1
    return native_semantic_execute_source(&source)
