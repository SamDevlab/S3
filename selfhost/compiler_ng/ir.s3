fn ng_emit_vector_push_expression(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, variables: &vector<NgIRVariable>, first_parameter: i64, parameter_count: i64, node: NgAstNode, call_arguments: &mut vector<i64>, registers: &mut vector<NgIRRegister>, instructions: &mut vector<NgIRInstruction>) -> i64:
    mut builtin_id: i64 = ng_ir_vector_new_builtin_id(types, fields, node.right)
    mut first_argument_node: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut value_argument_node: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut reference_register: i64 = -1
    mut value_register: i64 = -1
    mut reference_info: NgIRRegister = NgIRRegister(type_kind=0)
    mut reference_type: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut vector_type: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut first_pool_index: i64 = 0
    mut result_register: i64 = -1
    match builtin_id <=> 4:
        0:
            return ng_emit_record_vector_value_push_expression(source, types, fields, functions, nodes, parameters, variables, first_parameter, parameter_count, node, call_arguments, registers, instructions)
        -1:
            builtin_id = builtin_id
        1:
            builtin_id = builtin_id
    match ng_ir_span_matches_text(source, node.start, node.operation, text_from_static("vector_push")):
        -1:
            match builtin_id > 0:
                -1:
                    match node.left >= 0:
                        -1:
                            first_argument_node = vector_get<NgAstNode>(nodes, node.left)
                            match first_argument_node.kind <=> 6:
                                0:
                                    match first_argument_node.right >= 0:
                                        -1:
                                            value_argument_node = vector_get<NgAstNode>(nodes, first_argument_node.right)
                                            match value_argument_node.kind <=> 6:
                                                0:
                                                    match value_argument_node.right <=> -1:
                                                        0:
                                                            reference_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, first_parameter, parameter_count, first_argument_node.left, call_arguments, registers, instructions)
                                                            match reference_register >= 0:
                                                                -1:
                                                                    reference_info = vector_get<NgIRRegister>(&*registers, reference_register)
                                                                    match reference_info.type_kind > 0:
                                                                        -1:
                                                                            match reference_info.type_kind <= vector_len<NgTypeDescriptor>(types):
                                                                                -1:
                                                                                    reference_type = vector_get<NgTypeDescriptor>(types, reference_info.type_kind - 1)
                                                                                    match reference_type.kind <=> 9:
                                                                                        0:
                                                                                            match reference_type.mutable <=> 1:
                                                                                                0:
                                                                                                    match reference_type.target_type > 0:
                                                                                                        -1:
                                                                                                            match reference_type.target_type <= vector_len<NgTypeDescriptor>(types):
                                                                                                                -1:
                                                                                                                    vector_type = vector_get<NgTypeDescriptor>(types, reference_type.target_type - 1)
                                                                                                                    match vector_type.kind <=> 8:
                                                                                                                        0:
                                                                                                                            match ng_type_equal(source, types, vector_type.element_type, node.right) <=> -1:
                                                                                                                                0:
                                                                                                                                    value_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, first_parameter, parameter_count, value_argument_node.left, call_arguments, registers, instructions)
                                                                                                                                    match value_register >= 0:
                                                                                                                                        -1:
                                                                                                                                            discard ng_set_contextual_literal_type(nodes, value_argument_node.left, node.right, registers, value_register)
                                                                                                                                            reference_info = vector_get<NgIRRegister>(&*registers, value_register)
                                                                                                                                            match ng_type_equal(source, types, reference_info.type_kind, node.right) <=> -1:
                                                                                                                                                0:
                                                                                                                                                    first_pool_index = vector_len<i64>(&*call_arguments)
                                                                                                                                                    discard vector_push<i64>(call_arguments, reference_register)
                                                                                                                                                    discard vector_push<i64>(call_arguments, value_register)
                                                                                                                                                    result_register = vector_len<NgIRRegister>(&*registers)
                                                                                                                                                    discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=3))
                                                                                                                                                    discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=7, result=result_register, operand_count=2, operand0=-3, operand1=first_pool_index, immediate=node.right, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
                                                                                                                                                    return result_register
                                                                                                                                                -1:
                                                                                                                                                    return -14
                                                                                                                                                1:
                                                                                                                                                    return -14
                                                                                                                                        0:
                                                                                                                                            return value_register
                                                                                                                                        1:
                                                                                                                                            return value_register
                                                                                                                                -1:
                                                                                                                                    return -14
                                                                                                                                1:
                                                                                                                                    return -14
                                                                                                                        -1:
                                                                                                                            return -14
                                                                                                                        1:
                                                                                                                            return -14
                                                                                                                0:
                                                                                                                    return -14
                                                                                                                1:
                                                                                                                    return -14
                                                                                                        0:
                                                                                                            return -14
                                                                                                        1:
                                                                                                            return -14
                                                                                                -1:
                                                                                                    return -14
                                                                                                1:
                                                                                                    return -14
                                                                                        -1:
                                                                                            return -14
                                                                                        1:
                                                                                            return -14
                                                                                0:
                                                                                    return -14
                                                                                1:
                                                                                    return -14
                                                                        0:
                                                                            return -14
                                                                        1:
                                                                            return -14
                                                                0:
                                                                    return reference_register
                                                                1:
                                                                    return reference_register
                                                        -1:
                                                            return -14
                                                        1:
                                                            return -14
                                                -1:
                                                    return -14
                                                1:
                                                    return -14
                                        0:
                                            return -14
                                        1:
                                            return -14
                                -1:
                                    return -14
                                1:
                                    return -14
                        0:
                            return -14
                        1:
                            return -14
                0:
                    return -13
                1:
                    return -13
        0:
            return -13
        1:
            return -13

fn ng_emit_builtin_call_expression(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, variables: &vector<NgIRVariable>, first_parameter: i64, parameter_count: i64, node: NgAstNode, call_arguments: &mut vector<i64>, registers: &mut vector<NgIRRegister>, instructions: &mut vector<NgIRInstruction>) -> i64:
    mut builtin_kind: i64 = ng_builtin_call_kind(source, node.start, node.operation)
    mut result_type: i64 = ng_builtin_result_type(builtin_kind)
    mut argument_list: i64 = node.left
    mut argument: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut argument_register: i64 = -1
    mut expected_type: i64 = 0
    mut argument_index: i64 = 0
    mut evaluated_arguments: vector<i64> = vector_new<i64>(vector_len<NgAstNode>(nodes) + 1)
    mut first_argument: i64 = 0
    mut result_register: i64 = -1
    match builtin_kind > 0:
        -1:
            match result_type < 0:
                -1:
                    return result_type
                0:
                    result_type = result_type
                1:
                    return result_type
            match builtin_kind <= 3:
                -1:
                    argument = vector_get<NgAstNode>(nodes, argument_list)
                    argument_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, first_parameter, parameter_count, argument.left, call_arguments, registers, instructions)
                    match argument_register >= 0:
                        -1:
                            result_register = vector_len<NgIRRegister>(&*registers)
                            discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=result_type))
                            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=17, result=result_register, operand_count=1, operand0=argument_register, operand1=-1, immediate=0, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
                            return result_register
                        0:
                            return argument_register
                        1:
                            return argument_register
                0:
                    while argument_list >= 0:
                        argument = vector_get<NgAstNode>(nodes, argument_list)
                        expected_type = ng_builtin_argument_type(builtin_kind, argument_index)
                        argument_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, first_parameter, parameter_count, argument.left, call_arguments, registers, instructions)
                        match argument_register >= 0:
                            -1:
                                match expected_type > 0:
                                    -1:
                                        discard ng_set_contextual_literal_type(nodes, argument.left, expected_type, registers, argument_register)
                                    0:
                                        expected_type = expected_type
                                    1:
                                        expected_type = expected_type
                                discard vector_push<i64>(&mut evaluated_arguments, argument_register)
                                argument_list = argument.right
                                argument_index = argument_index + 1
                            0:
                                return argument_register
                            1:
                                return argument_register
                    first_argument = vector_len<i64>(&*call_arguments)
                    argument_index = 0
                    while argument_index < vector_len<i64>(&evaluated_arguments):
                        argument_register = vector_get<i64>(&evaluated_arguments, argument_index)
                        discard vector_push<i64>(call_arguments, argument_register)
                        argument_index = argument_index + 1
                    result_register = vector_len<NgIRRegister>(&*registers)
                    discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=result_type))
                    discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=7, result=result_register, operand_count=vector_len<i64>(&evaluated_arguments), operand0=-7, operand1=first_argument, immediate=node.start, memory=node.operation, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
                    return result_register
                1:
                    return -13
        0:
            return -13
        1:
            return -13

fn ng_ir_value_cell_count(types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, type_id: i64) -> i64:
    mut descriptor: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut field: NgField = NgField(record_index=0, name_start=0, name_end=0, type_id=0, order=0)
    mut field_index: i64 = 0
    mut field_cells: i64 = 0
    mut total_cells: i64 = 0
    match type_id > 0:
        -1:
            match type_id <= vector_len<NgTypeDescriptor>(types):
                -1:
                    descriptor = vector_get<NgTypeDescriptor>(types, type_id - 1)
                    match descriptor.kind <=> 7:
                        0:
                            match descriptor.field_count > 0:
                                -1:
                                    match descriptor.first_field + descriptor.field_count <= vector_len<NgField>(fields):
                                        -1:
                                            field_index = descriptor.first_field
                                            while field_index < descriptor.first_field + descriptor.field_count:
                                                field = vector_get<NgField>(fields, field_index)
                                                field_cells = ng_ir_value_cell_count(types, fields, field.type_id)
                                                match field_cells > 0:
                                                    -1:
                                                        total_cells = total_cells + field_cells
                                                        field_index = field_index + 1
                                                    0:
                                                        return -14
                                                    1:
                                                        return -14
                                            return total_cells
                                        0:
                                            return -14
                                        1:
                                            return -14
                                0:
                                    return -14
                                1:
                                    return -14
                        -1:
                            return 1
                        1:
                            return 1
                0:
                    return -14
                1:
                    return -14
        0:
            return -14
        1:
            return -14

fn ng_ir_parameter_variable_count(types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, type_id: i64) -> i64:
    mut descriptor: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut field: NgField = NgField(record_index=0, name_start=0, name_end=0, type_id=0, order=0)
    mut field_index: i64 = 0
    mut child_count: i64 = 0
    mut total_count: i64 = 1
    match type_id > 0:
        -1:
            match type_id <= vector_len<NgTypeDescriptor>(types):
                -1:
                    descriptor = vector_get<NgTypeDescriptor>(types, type_id - 1)
                    match descriptor.kind <=> 7:
                        0:
                            match descriptor.first_field + descriptor.field_count <= vector_len<NgField>(fields):
                                -1:
                                    field_index = descriptor.first_field
                                    while field_index < descriptor.first_field + descriptor.field_count:
                                        field = vector_get<NgField>(fields, field_index)
                                        child_count = ng_ir_parameter_variable_count(types, fields, field.type_id)
                                        match child_count > 0:
                                            -1:
                                                total_count = total_count + child_count
                                                field_index = field_index + 1
                                            0:
                                                return -14
                                            1:
                                                return -14
                                    return total_count
                                0:
                                    return -14
                                1:
                                    return -14
                        -1:
                            return 1
                        1:
                            return 1
                0:
                    return -14
                1:
                    return -14
        0:
            return -14
        1:
            return -14

fn ng_ir_add_parameter_record_children(types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, type_id: i64, parent_index: i64, variables: &mut vector<NgIRVariable>, registers: &mut vector<NgIRRegister>) -> i64:
    mut descriptor: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut field: NgField = NgField(record_index=0, name_start=0, name_end=0, type_id=0, order=0)
    mut field_type: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut field_index: i64 = 0
    mut child_index: i64 = -1
    mut register_index: i64 = -1
    mut status: i64 = 0
    match type_id > 0:
        -1:
            match type_id <= vector_len<NgTypeDescriptor>(types):
                -1:
                    descriptor = vector_get<NgTypeDescriptor>(types, type_id - 1)
                    match descriptor.kind == 7:
                        -1:
                            field_index = descriptor.first_field
                            while field_index < descriptor.first_field + descriptor.field_count:
                                field = vector_get<NgField>(fields, field_index)
                                field_type = vector_get<NgTypeDescriptor>(types, field.type_id - 1)
                                child_index = vector_len<NgIRVariable>(&*variables)
                                match field_type.kind == 7:
                                    -1:
                                        discard vector_push<NgIRVariable>(&mut *variables, NgIRVariable(name_start=0, name_end=0, name_fingerprint=0, type_kind=field.type_id, mutable=0, register=-1, memory=-1, parent_index=parent_index, field_name_start=field.name_start, field_name_end=field.name_end))
                                        status = ng_ir_add_parameter_record_children(types, fields, field.type_id, child_index, variables, registers)
                                        match status <=> 0:
                                            0:
                                                field_index = field_index + 1
                                            -1:
                                                return status
                                            1:
                                                return status
                                    0:
                                        register_index = vector_len<NgIRRegister>(&*registers)
                                        discard vector_push<NgIRRegister>(&mut *registers, NgIRRegister(type_kind=field.type_id))
                                        discard vector_push<NgIRVariable>(&mut *variables, NgIRVariable(name_start=0, name_end=0, name_fingerprint=0, type_kind=field.type_id, mutable=0, register=register_index, memory=-1, parent_index=parent_index, field_name_start=field.name_start, field_name_end=field.name_end))
                                        field_index = field_index + 1
                                    1:
                                        register_index = vector_len<NgIRRegister>(&*registers)
                                        discard vector_push<NgIRRegister>(&mut *registers, NgIRRegister(type_kind=field.type_id))
                                        discard vector_push<NgIRVariable>(&mut *variables, NgIRVariable(name_start=0, name_end=0, name_fingerprint=0, type_kind=field.type_id, mutable=0, register=register_index, memory=-1, parent_index=parent_index, field_name_start=field.name_start, field_name_end=field.name_end))
                                        field_index = field_index + 1
                            return 0
                        0:
                            return -14
                        1:
                            return -14
                0:
                    return -14
                1:
                    return -14
        0:
            return -14
        1:
            return -14

fn ng_ir_add_parameter_variable(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, parameter: NgParameter, variables: &mut vector<NgIRVariable>, registers: &mut vector<NgIRRegister>) -> i64:
    mut descriptor: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut variable_index: i64 = vector_len<NgIRVariable>(&*variables)
    mut register_index: i64 = -1
    match parameter.type_kind > 0:
        -1:
            match parameter.type_kind <= vector_len<NgTypeDescriptor>(types):
                -1:
                    descriptor = vector_get<NgTypeDescriptor>(types, parameter.type_kind - 1)
                    match descriptor.kind == 7:
                        -1:
                            discard vector_push<NgIRVariable>(&mut *variables, NgIRVariable(name_start=parameter.name_start, name_end=parameter.name_end, name_fingerprint=ng_span_fingerprint(source, parameter.name_start, parameter.name_end), type_kind=parameter.type_kind, mutable=0, register=-1, memory=-1, parent_index=-1, field_name_start=-1, field_name_end=-1))
                            return ng_ir_add_parameter_record_children(types, fields, parameter.type_kind, variable_index, variables, registers)
                        0:
                            register_index = vector_len<NgIRRegister>(&*registers)
                            discard vector_push<NgIRRegister>(&mut *registers, NgIRRegister(type_kind=parameter.type_kind))
                            discard vector_push<NgIRVariable>(&mut *variables, NgIRVariable(name_start=parameter.name_start, name_end=parameter.name_end, name_fingerprint=ng_span_fingerprint(source, parameter.name_start, parameter.name_end), type_kind=parameter.type_kind, mutable=0, register=register_index, memory=-1, parent_index=-1, field_name_start=-1, field_name_end=-1))
                            return 0
                        1:
                            register_index = vector_len<NgIRRegister>(&*registers)
                            discard vector_push<NgIRRegister>(&mut *registers, NgIRRegister(type_kind=parameter.type_kind))
                            discard vector_push<NgIRVariable>(&mut *variables, NgIRVariable(name_start=parameter.name_start, name_end=parameter.name_end, name_fingerprint=ng_span_fingerprint(source, parameter.name_start, parameter.name_end), type_kind=parameter.type_kind, mutable=0, register=register_index, memory=-1, parent_index=-1, field_name_start=-1, field_name_end=-1))
                            return 0
                0:
                    return -14
                1:
                    return -14
