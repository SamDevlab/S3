                                                                                                                                                                                                                            discard vector_push<i64>(&mut value_registers, value_register)
                                                                                                                                                                                                                        -1:
                                                                                                                                                                                                                            return -14
                                                                                                                                                                                                                        1:
                                                                                                                                                                                                                            return -14
                                                                                                                                                                                                                0:
