                                                                                                                                                                                                        1:
                                                                                                                                                                                                            return -14
                                                                                                                                                                                                0:
                                                                                                                                                                                                    argument_id = argument_id
                                                                                                                                                                                                1:
                                                                                                                                                                                                    argument_id = argument_id
                                                                                                                                                                                            argument_id = argument_link.right
                                                                                                                                                                                        -1:
                                                                                                                                                                                            return -14
                                                                                                                                                                                        1:
                                                                                                                                                                                            return -14
                                                                                                                                                                                -1:
                                                                                                                                                                                    return -14
                                                                                                                                                                                1:
                                                                                                                                                                                    return -14
                                                                                                                                                                        match field_matches <=> 1:
                                                                                                                                                                            0:
                                                                                                                                                                                field_index = field_index + 1
                                                                                                                                                                            -1:
                                                                                                                                                                                return -14
                                                                                                                                                                            1:
                                                                                                                                                                                return -14
                                                                                                                                                                    pool_start = vector_len<i64>(&*call_arguments)
                                                                                                                                                                    discard vector_push<i64>(call_arguments, reference_register)
                                                                                                                                                                    field_index = 0
                                                                                                                                                                    while field_index < vector_len<i64>(&value_registers):
                                                                                                                                                                        value_register = vector_get<i64>(&value_registers, field_index)
                                                                                                                                                                        discard vector_push<i64>(call_arguments, value_register)
                                                                                                                                                                        field_index = field_index + 1
                                                                                                                                                                    result_register = vector_len<NgIRRegister>(&*registers)
                                                                                                                                                                    discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=3))
                                                                                                                                                                    discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=7, result=result_register, operand_count=vector_len<i64>(&value_registers) + 1, operand0=-6, operand1=pool_start, immediate=node.right, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
                                                                                                                                                                    return result_register
                                                                                                                                                                -1:
                                                                                                                                                                    return -14
                                                                                                                                                                1:
                                                                                                                                                                    return -14
                                                                                                                                                        -1:
                                                                                                                                                            return -14
                                                                                                                                                        1:
                                                                                                                                                            return -14
                                                                                                                                                -1:
                                                                                                                                                    return -14
                                                                                                                                                1:
                                                                                                                                                    return -14
                                                                                                                                        -1:
                                                                                                                                            return -14
                                                                                                                                        1:
                                                                                                                                            return -14
                                                                                                                                0:
                                                                                                                                    return -14
                                                                                                                                1:
                                                                                                                                    return -14
