module selfhost.compiler_ng.ir

from selfhost.compiler_ng.parser import NgAstNode, NgField, NgFunction, NgParameter, NgRecord, ng_relational_operator_code
from selfhost.compiler_ng.semantic import ng_check_program_typed, ng_find_function, ng_spans_equal
from selfhost.compiler_ng.types import NgTypeDescriptor

export record NgIRMemory:
    type_kind: i64
    length: i64
    mutable: i64

export record NgIRVariable:
    name_start: i64
    name_end: i64
    type_kind: i64
    mutable: i64
    register: i64
    memory: i64

export record NgIRRegister:
    type_kind: i64

export record NgIRBlock:
    index: i64

export record NgIRInstruction:
    opcode: i64
    result: i64
    operand_count: i64
    operand0: i64
    operand1: i64
    immediate: i64
    memory: i64
    initialization: i64
    block: i64
    target0: i64
    target1: i64
    target2: i64

record NgIntegerResult:
    value: i64
    valid: i64

fn ng_ir_event(events: &mut vector<i64>, kind: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> i64:
    discard vector_push<i64>(events, kind)
    discard vector_push<i64>(events, a)
    discard vector_push<i64>(events, b)
    discard vector_push<i64>(events, c)
    discard vector_push<i64>(events, d)
    discard vector_push<i64>(events, e)
    discard vector_push<i64>(events, f)
    discard vector_push<i64>(events, g)
    return 0

fn ng_parameter_register(source: &bytes, parameters: &vector<NgParameter>, first_parameter: i64, parameter_count: i64, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = 0
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    while index < parameter_count:
        parameter = vector_get<NgParameter>(parameters, first_parameter + index)
        match ng_spans_equal(source, name_start, name_end, parameter.name_start, parameter.name_end):
            -1:
                return index
            0:
                index = index + 1
            1:
                index = index + 1
    return -12

fn ng_ir_variable_index(source: &bytes, variables: &vector<NgIRVariable>, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = vector_len<NgIRVariable>(variables)
    mut variable: NgIRVariable = NgIRVariable(name_start=0, name_end=0, type_kind=0, mutable=0, register=-1, memory=-1)
    while index > 0:
        index = index - 1
        variable = vector_get<NgIRVariable>(variables, index)
        match ng_spans_equal(source, name_start, name_end, variable.name_start, variable.name_end):
            -1:
                return index
            0:
                index = index
            1:
                index = index
    return -12

fn ng_integer_value(source: &bytes, start: i64, end: i64) -> NgIntegerResult:
    mut index: i64 = start
    mut value: i64 = 0
    mut digit: i64 = 0
    mut negative: i64 = 0
    match index < end:
        -1:
            match to_i64(bytes_get(source, index)) <=> 45:
                -1:
                    negative = 0
                0:
                    negative = 1
                    index = index + 1
                1:
                    negative = 0
        0:
            return NgIntegerResult(value=0, valid=0)
        1:
            return NgIntegerResult(value=0, valid=0)
    match index < end:
        -1:
            value = value
        0:
            return NgIntegerResult(value=0, valid=0)
        1:
            value = value
    while index < end:
        digit = to_i64(bytes_get(source, index)) - 48
        match digit < 0:
            -1:
                return NgIntegerResult(value=0, valid=0)
            0:
                match digit > 9:
                    -1:
                        return NgIntegerResult(value=0, valid=0)
                    0:
                        digit = digit
                    1:
                        return NgIntegerResult(value=0, valid=0)
            1:
                return NgIntegerResult(value=0, valid=0)
        match value <=> 922337203685477580:
            -1:
                value = value * 10 + digit
            0:
                match digit <=> 7:
                    -1:
                        value = value * 10 + digit
                    0:
                        value = value * 10 + digit
                    1:
                        return NgIntegerResult(value=0, valid=0)
            1:
                return NgIntegerResult(value=0, valid=0)
        index = index + 1
    match negative <=> 1:
        -1:
            return NgIntegerResult(value=value, valid=1)
        0:
            return NgIntegerResult(value=0 - value, valid=1)
        1:
            return NgIntegerResult(value=value, valid=1)

fn ng_set_contextual_literal_type(nodes: &vector<NgAstNode>, node_id: i64, expected_type: i64, registers: &mut vector<NgIRRegister>, register_id: i64) -> i64:
    mut node: NgAstNode = vector_get<NgAstNode>(nodes, node_id)
    mut register: NgIRRegister = NgIRRegister(type_kind=0)
    match node.kind <=> 1:
        -1:
            return 0
        0:
            match expected_type <=> 2:
                -1:
                    return 0
                0:
                    register = vector_get<NgIRRegister>(&*registers, register_id)
                    register.type_kind = expected_type
                    discard vector_set<NgIRRegister>(&mut *registers, register_id, register)
                    return 0
                1:
                    match expected_type <=> 3:
                        -1:
                            return 0
                        0:
                            register = vector_get<NgIRRegister>(&*registers, register_id)
                            register.type_kind = expected_type
                            discard vector_set<NgIRRegister>(&mut *registers, register_id, register)
                            return 0
                        1:
                            return 0
        1:
            return 0

fn ng_ir_span_matches_text(source: &bytes, start: i64, end: i64, wanted: text) -> trit:
    mut expected: bytes = bytes_from_text(&wanted)
    mut index: i64 = 0
    match end - start <=> bytes_len(&expected):
        -1:
            return 0
        0:
            while index < bytes_len(&expected):
                match to_i64(bytes_get(source, start + index)) <=> to_i64(bytes_get(&expected, index)):
                    -1:
                        return 0
                    0:
                        index = index + 1
                    1:
                        return 0
            return -1
        1:
            return 0

fn ng_ir_vector_type_id(types: &vector<NgTypeDescriptor>, element_type: i64) -> i64:
    mut index: i64 = 0
    mut descriptor: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    while index < vector_len<NgTypeDescriptor>(types):
        descriptor = vector_get<NgTypeDescriptor>(types, index)
        match descriptor.kind <=> 8:
            0:
                match descriptor.element_type <=> element_type:
                    0:
                        return index + 1
                    -1:
                        index = index + 1
                    1:
                        index = index + 1
            -1:
                index = index + 1
            1:
                index = index + 1
    return -1

fn ng_ir_vector_new_builtin_id(types: &vector<NgTypeDescriptor>, element_type: i64) -> i64:
    mut descriptor: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    match element_type > 0:
        -1:
            match element_type <= vector_len<NgTypeDescriptor>(types):
                -1:
                    descriptor = vector_get<NgTypeDescriptor>(types, element_type - 1)
                    match descriptor.kind <=> 1:
                        0:
                            return 1
                        -1:
                            return -1
                        1:
                            match descriptor.kind <=> 3:
                                0:
                                    return 2
                                -1:
                                    return -1
                                1:
                                    match descriptor.kind <=> 4:
                                        0:
                                            return 3
                                        -1:
                                            return -1
                                        1:
                                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn ng_ir_call_vector_element(types: &vector<NgTypeDescriptor>, registers: &vector<NgIRRegister>, call_arguments: &vector<i64>, argument_pool_index: i64) -> i64:
    mut argument_register: i64 = -1
    mut argument_info: NgIRRegister = NgIRRegister(type_kind=0)
    mut reference_type: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut vector_type: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    match argument_pool_index >= 0:
        -1:
            match argument_pool_index < vector_len<i64>(call_arguments):
                -1:
                    argument_register = vector_get<i64>(call_arguments, argument_pool_index)
                    match argument_register >= 0:
                        -1:
                            match argument_register < vector_len<NgIRRegister>(registers):
                                -1:
                                    argument_info = vector_get<NgIRRegister>(registers, argument_register)
                                    match argument_info.type_kind > 0:
                                        -1:
                                            match argument_info.type_kind <= vector_len<NgTypeDescriptor>(types):
                                                -1:
                                                    reference_type = vector_get<NgTypeDescriptor>(types, argument_info.type_kind - 1)
                                                    match reference_type.kind <=> 9:
                                                        0:
                                                            match reference_type.target_type > 0:
                                                                -1:
                                                                    match reference_type.target_type <= vector_len<NgTypeDescriptor>(types):
                                                                        -1:
                                                                            vector_type = vector_get<NgTypeDescriptor>(types, reference_type.target_type - 1)
                                                                            match vector_type.kind <=> 8:
                                                                                0:
                                                                                    match ng_ir_vector_new_builtin_id(types, vector_type.element_type) > 0:
                                                                                        -1:
                                                                                            return vector_type.element_type
                                                                                        0:
                                                                                            return -1
                                                                                        1:
                                                                                            return -1
                                                                                -1:
                                                                                    return -1
                                                                                1:
                                                                                    return -1
                                                                        0:
                                                                            return -1
                                                                        1:
                                                                            return -1
                                                                0:
                                                                    return -1
                                                                1:
                                                                    return -1
                                                        -1:
                                                            return -1
                                                        1:
                                                            return -1
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn ng_emit_vector_new_expression(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, variables: &vector<NgIRVariable>, first_parameter: i64, parameter_count: i64, node: NgAstNode, call_arguments: &mut vector<i64>, registers: &mut vector<NgIRRegister>, instructions: &mut vector<NgIRInstruction>) -> i64:
    mut builtin_id: i64 = ng_ir_vector_new_builtin_id(types, node.right)
    mut result_type: i64 = ng_ir_vector_type_id(types, node.right)
    mut argument_node: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut argument_register: i64 = -1
    mut argument_info: NgIRRegister = NgIRRegister(type_kind=0)
    mut first_argument: i64 = 0
    mut result_register: i64 = -1
    match ng_ir_span_matches_text(source, node.start, node.operation, text_from_static("vector_new")):
        -1:
            match node.right > 0:
                -1:
                    match builtin_id > 0:
                        -1:
                            match result_type > 0:
                                -1:
                                    match node.left >= 0:
                                        -1:
                                            argument_node = vector_get<NgAstNode>(nodes, node.left)
                                            match argument_node.kind <=> 6:
                                                0:
                                                    match argument_node.right <=> -1:
                                                        0:
                                                            argument_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, first_parameter, parameter_count, argument_node.left, call_arguments, registers, instructions)
                                                            match argument_register >= 0:
                                                                -1:
                                                                    discard ng_set_contextual_literal_type(nodes, argument_node.left, 1, registers, argument_register)
                                                                    argument_info = vector_get<NgIRRegister>(&*registers, argument_register)
                                                                    match argument_info.type_kind <=> 1:
                                                                        0:
                                                                            first_argument = vector_len<i64>(&*call_arguments)
                                                                            discard vector_push<i64>(call_arguments, argument_register)
                                                                            result_register = vector_len<NgIRRegister>(&*registers)
                                                                            discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=result_type))
                                                                            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=7, result=result_register, operand_count=1, operand0=-1, operand1=first_argument, immediate=0, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
                                                                            return result_register
                                                                        -1:
                                                                            return -14
                                                                        1:
                                                                            return -14
                                                                0:
                                                                    return argument_register
                                                                1:
                                                                    return argument_register
                                                        -1:
                                                            return -14
                                                        1:
                                                            return -14
                                                -1:
                                                    return -14
                                                1:
                                                    return -14
                                        0:
                                            return -14
                                        1:
                                            return -14
                                0:
                                    return -14
                                1:
                                    return -14
                        0:
                            return -14
                        1:
                            return -14
                0:
                    return -13
                1:
                    return -13
        0:
            return -13
        1:
            return -13

