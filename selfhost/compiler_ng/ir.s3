module selfhost.compiler_ng.ir

from selfhost.compiler_ng.parser import NgAstNode, NgField, NgFunction, NgParameter, NgRecord, ng_relational_operator_code
from selfhost.compiler_ng.semantic import ng_builtin_argument_type, ng_builtin_call_kind, ng_builtin_result_type, ng_check_program_typed, ng_find_function, ng_is_resolved_builtin_call, ng_named_spans_equal, ng_resolved_call_function_index, ng_spans_equal
from selfhost.compiler_ng.types import NgTypeDescriptor, ng_type_equal
from selfhost.compiler_ng.lexer import ng_span_fingerprint

export record NgIRMemory:
    type_kind: i64
    length: i64
    mutable: i64

export record NgIRVariable:
    name_start: i64
    name_end: i64
    name_fingerprint: i64
    type_kind: i64
    mutable: i64
    register: i64
    memory: i64
    parent_index: i64
    field_name_start: i64
    field_name_end: i64

export record NgIRRegister:
    type_kind: i64

export record NgIRBlock:
    index: i64

export record NgIRInstruction:
    opcode: i64
    result: i64
    operand_count: i64
    operand0: i64
    operand1: i64
    immediate: i64
    memory: i64
    initialization: i64
    block: i64
    target0: i64
    target1: i64
    target2: i64

record NgIntegerResult:
    value: i64
    valid: i64

fn ng_ir_event(events: &mut vector<i64>, kind: i64, a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64) -> i64:
    discard vector_push<i64>(events, kind)
    discard vector_push<i64>(events, a)
    discard vector_push<i64>(events, b)
    discard vector_push<i64>(events, c)
    discard vector_push<i64>(events, d)
    discard vector_push<i64>(events, e)
    discard vector_push<i64>(events, f)
    discard vector_push<i64>(events, g)
    return 0

fn ng_parameter_register(source: &bytes, parameters: &vector<NgParameter>, first_parameter: i64, parameter_count: i64, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = 0
    mut name_length: i64 = name_end - name_start
    mut name_fingerprint: i64 = ng_span_fingerprint(source, name_start, name_end)
    mut parameter_name_length: i64 = 0
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, name_fingerprint=0, type_kind=0)
    while index < parameter_count:
        parameter = vector_get<NgParameter>(parameters, first_parameter + index)
        parameter_name_length = parameter.name_end - parameter.name_start
        match name_length <=> parameter_name_length:
            -1:
                index = index + 1
            0:
                match ng_named_spans_equal(source, name_start, name_end, name_fingerprint, parameter.name_start, parameter.name_end, parameter.name_fingerprint):
                    -1:
                        return index
                    0:
                        index = index + 1
                    1:
                        index = index + 1
            1:
                index = index + 1
    return -12

fn ng_ir_variable_index(source: &bytes, variables: &vector<NgIRVariable>, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = vector_len<NgIRVariable>(variables)
    mut name_fingerprint: i64 = 0
    mut fingerprint_ready: i64 = 0
    mut variable: NgIRVariable = NgIRVariable(name_start=0, name_end=0, name_fingerprint=0, type_kind=0, mutable=0, register=-1, memory=-1, parent_index=-1, field_name_start=-1, field_name_end=-1)
    while index > 0:
        index = index - 1
        variable = vector_get<NgIRVariable>(variables, index)
        match variable.parent_index >= 0:
            -1:
                match variable.parent_index < index:
                    -1:
                        index = variable.parent_index + 1
                    0:
                        return -14
                    1:
                        return -14
            0:
                match name_end - name_start <=> variable.name_end - variable.name_start:
                    -1:
                        index = index
                    0:
                        match fingerprint_ready <=> 0:
                            -1:
                                name_fingerprint = name_fingerprint
                            0:
                                name_fingerprint = ng_span_fingerprint(source, name_start, name_end)
                                fingerprint_ready = 1
                            1:
                                name_fingerprint = name_fingerprint
                        match variable.name_fingerprint <=> name_fingerprint:
                            -1:
                                index = index
                            0:
                                match ng_spans_equal(source, name_start, name_end, variable.name_start, variable.name_end):
                                    -1:
                                        return index
                                    0:
                                        index = index
                                    1:
                                        index = index
                            1:
                                index = index
                    1:
                        index = index
            1:
                return -14
    return -12

fn ng_ir_variable_field_index(source: &bytes, variables: &vector<NgIRVariable>, parent_index: i64, field_start: i64, field_end: i64) -> i64:
    mut index: i64 = 0
    mut variable_count: i64 = vector_len<NgIRVariable>(variables)
    mut variable: NgIRVariable = NgIRVariable(name_start=0, name_end=0, name_fingerprint=0, type_kind=0, mutable=0, register=-1, memory=-1, parent_index=-1, field_name_start=-1, field_name_end=-1)
    mut ancestor_index: i64 = -1
    mut ancestor: NgIRVariable = NgIRVariable(name_start=0, name_end=0, name_fingerprint=0, type_kind=0, mutable=0, register=-1, memory=-1, parent_index=-1, field_name_start=-1, field_name_end=-1)
    match parent_index >= 0:
        -1:
            match parent_index < variable_count:
                -1:
                    index = parent_index + 1
                    while index < variable_count:
                        variable = vector_get<NgIRVariable>(variables, index)
                        match variable.parent_index < index:
                            -1:
                                match variable.parent_index <=> parent_index:
                                    0:
                                        match ng_spans_equal(source, field_start, field_end, variable.field_name_start, variable.field_name_end):
                                            -1:
                                                return index
                                            0:
                                                index = index + 1
                                            1:
                                                index = index + 1
                                    -1:
                                        return -12
                                    1:
                                        ancestor_index = variable.parent_index
                                        while ancestor_index > parent_index:
                                            match ancestor_index < index:
                                                -1:
                                                    ancestor = vector_get<NgIRVariable>(variables, ancestor_index)
                                                    match ancestor.parent_index < ancestor_index:
                                                        -1:
                                                            ancestor_index = ancestor.parent_index
                                                        0:
                                                            return -14
                                                        1:
                                                            return -14
                                                0:
                                                    return -14
                                                1:
                                                    return -14
                                        match ancestor_index <=> parent_index:
                                            0:
                                                index = index + 1
                                            -1:
                                                return -12
                                            1:
                                                return -14
                            0:
                                return -14
                            1:
                                return -14
                    return -12
                0:
                    return -14
                1:
                    return -14
        0:
            return -14
        1:
            return -14
fn ng_ir_field_variable_index(source: &bytes, nodes: &vector<NgAstNode>, variables: &vector<NgIRVariable>, node_id: i64) -> i64:
    mut node: NgAstNode = vector_get<NgAstNode>(nodes, node_id)
    mut base: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut parent_index: i64 = -1
    match node.kind <=> 14:
        0:
            base = vector_get<NgAstNode>(nodes, node.left)
            match base.kind <=> 14:
                0:
                    parent_index = ng_ir_field_variable_index(source, nodes, variables, node.left)
                -1:
                    match base.kind <=> 2:
                        0:
                            parent_index = ng_ir_variable_index(source, variables, base.start, base.end)
                        -1:
                            return -12
                        1:
                            return -12
                1:
                    return -12
            match parent_index >= 0:
                -1:
                    return ng_ir_variable_field_index(source, variables, parent_index, node.start, node.end)
                0:
                    return -12
                1:
                    return -12
        -1:
            return -12
        1:
            return -12

fn ng_emit_record_local_fields(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, function: NgFunction, constructor_id: i64, parent_index: i64, variable_name_start: i64, variable_name_end: i64, mutable: i64, variables: &mut vector<NgIRVariable>, registers: &mut vector<NgIRRegister>, instructions: &mut vector<NgIRInstruction>, call_arguments: &mut vector<i64>) -> i64:
    mut constructor: NgAstNode = vector_get<NgAstNode>(nodes, constructor_id)
    mut field: NgField = NgField(record_index=0, name_start=0, name_end=0, type_id=0, order=0)
    mut field_type: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut argument_id: i64 = constructor.left
    mut argument_link: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut named_argument: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut selected_argument: i64 = -1
    mut match_count: i64 = 0
    mut value_register: i64 = -1
    mut field_index: i64 = 0
    mut child_index: i64 = -1
    mut value_info: NgIRRegister = NgIRRegister(type_kind=0)
    match constructor.kind <=> 5:
        0:
            match constructor.right > 0:
                -1:
                    match constructor.right <= vector_len<NgTypeDescriptor>(types):
                        -1:
                            field_type = vector_get<NgTypeDescriptor>(types, constructor.right - 1)
                            match field_type.kind <=> 7:
                                0:
                                    field_index = field_type.first_field
                                    while field_index < field_type.first_field + field_type.field_count:
                                        field = vector_get<NgField>(fields, field_index)
                                        argument_id = constructor.left
                                        selected_argument = -1
                                        match_count = 0
                                        while argument_id >= 0:
                                            argument_link = vector_get<NgAstNode>(nodes, argument_id)
                                            match argument_link.kind <=> 6:
                                                0:
                                                    named_argument = vector_get<NgAstNode>(nodes, argument_link.left)
                                                    match named_argument.kind <=> 16:
                                                        0:
                                                            match ng_spans_equal(source, field.name_start, field.name_end, named_argument.start, named_argument.end):
                                                                -1:
                                                                    match_count = match_count + 1
                                                                    selected_argument = named_argument.left
                                                                0:
                                                                    argument_id = argument_link.right
                                                                1:
                                                                    argument_id = argument_link.right
                                                        -1:
                                                            return -14
                                                        1:
                                                            return -14
                                                    argument_id = argument_link.right
                                                -1:
                                                    return -14
                                                1:
                                                    return -14
                                        match match_count <=> 1:
                                            0:
                                                field_type = vector_get<NgTypeDescriptor>(types, field.type_id - 1)
                                                match field_type.kind == 7:
                                                    -1:
                                                        child_index = vector_len<NgIRVariable>(&*variables)
                                                        discard vector_push<NgIRVariable>(&mut *variables, NgIRVariable(name_start=variable_name_start, name_end=variable_name_end, name_fingerprint=ng_span_fingerprint(source, variable_name_start, variable_name_end), type_kind=field.type_id, mutable=mutable, register=-1, memory=-1, parent_index=parent_index, field_name_start=field.name_start, field_name_end=field.name_end))
                                                        value_register = ng_emit_record_local_fields(source, types, fields, functions, nodes, parameters, function, selected_argument, child_index, variable_name_start, variable_name_end, mutable, variables, registers, instructions, call_arguments)
                                                        match value_register <=> 0:
                                                            0:
                                                                field_index = field_index + 1
                                                            -1:
                                                                return value_register
                                                            1:
                                                                return value_register
                                                    0:
                                                        value_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, &*variables, function.first_parameter, function.parameter_count, selected_argument, call_arguments, registers, instructions)
                                                        match value_register >= 0:
                                                            -1:
                                                                discard ng_set_contextual_literal_type(nodes, selected_argument, field.type_id, registers, value_register)
                                                                value_info = vector_get<NgIRRegister>(&*registers, value_register)
                                                                match ng_type_equal(source, types, value_info.type_kind, field.type_id) <=> -1:
                                                                    0:
                                                                        discard vector_push<NgIRVariable>(&mut *variables, NgIRVariable(name_start=variable_name_start, name_end=variable_name_end, name_fingerprint=ng_span_fingerprint(source, variable_name_start, variable_name_end), type_kind=field.type_id, mutable=mutable, register=value_register, memory=-1, parent_index=parent_index, field_name_start=field.name_start, field_name_end=field.name_end))
                                                                        field_index = field_index + 1
                                                                    -1:
                                                                        return -14
                                                                    1:
                                                                        return -14
                                                            0:
                                                                return value_register
                                                            1:
                                                                return value_register
                                                    1:
                                                        return -14
                                            -1:
                                                return -14
                                            1:
                                                return -14
                                    return 0
                                -1:
                                    return -14
                                1:
                                    return -14
                        0:
                            return -14
                        1:
                            return -14
                0:
                    return -14
                1:
                    return -14
        -1:
            return -14
        1:
            return -14

fn ng_emit_record_local_value_cells(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, type_id: i64, parent_index: i64, variable_name_start: i64, variable_name_end: i64, mutable: i64, value_registers: &vector<i64>, first_cell: i64, variables: &mut vector<NgIRVariable>) -> i64:
    mut descriptor: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut field: NgField = NgField(record_index=0, name_start=0, name_end=0, type_id=0, order=0)
    mut field_type: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut field_index: i64 = 0
    mut cell_index: i64 = first_cell
    mut child_index: i64 = -1
    mut nested_index: i64 = -1
    match type_id > 0:
        -1:
            match type_id <= vector_len<NgTypeDescriptor>(types):
                -1:
                    descriptor = vector_get<NgTypeDescriptor>(types, type_id - 1)
                    match descriptor.kind <=> 7:
                        0:
                            match descriptor.field_count > 0:
                                -1:
                                    field_index = descriptor.first_field
                                    while field_index < descriptor.first_field + descriptor.field_count:
                                        field = vector_get<NgField>(fields, field_index)
                                        field_type = vector_get<NgTypeDescriptor>(types, field.type_id - 1)
                                        child_index = vector_len<NgIRVariable>(&*variables)
                                        match field_type.kind <=> 7:
                                            0:
                                                discard vector_push<NgIRVariable>(&mut *variables, NgIRVariable(name_start=variable_name_start, name_end=variable_name_end, name_fingerprint=ng_span_fingerprint(source, variable_name_start, variable_name_end), type_kind=field.type_id, mutable=mutable, register=-1, memory=-1, parent_index=parent_index, field_name_start=field.name_start, field_name_end=field.name_end))
                                                nested_index = ng_emit_record_local_value_cells(source, types, fields, field.type_id, child_index, variable_name_start, variable_name_end, mutable, value_registers, cell_index, variables)
                                                match nested_index >= cell_index:
                                                    -1:
                                                        cell_index = nested_index
                                                        field_index = field_index + 1
                                                    0:
                                                        return nested_index
                                                    1:
                                                        return nested_index
                                            -1:
                                                match cell_index < vector_len<i64>(value_registers):
                                                    -1:
                                                        discard vector_push<NgIRVariable>(&mut *variables, NgIRVariable(name_start=variable_name_start, name_end=variable_name_end, name_fingerprint=ng_span_fingerprint(source, variable_name_start, variable_name_end), type_kind=field.type_id, mutable=mutable, register=vector_get<i64>(value_registers, cell_index), memory=-1, parent_index=parent_index, field_name_start=field.name_start, field_name_end=field.name_end))
                                                        cell_index = cell_index + 1
                                                        field_index = field_index + 1
                                                    0:
                                                        return -14
                                                    1:
                                                        return -14
                                            1:
                                                return -14
                                    return cell_index
                                0:
                                    return -14
                                1:
                                    return -14
                        -1:
                            return -14
                        1:
                            return -14
                0:
                    return -14
                1:
                    return -14
        0:
            return -14
        1:
            return -14

fn ng_emit_local_declaration(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, function: NgFunction, statement: NgAstNode, variables: &mut vector<NgIRVariable>, memories: &mut vector<NgIRMemory>, registers: &mut vector<NgIRRegister>, instructions: &mut vector<NgIRInstruction>, call_arguments: &mut vector<i64>) -> i64:
    mut statement_type: i64 = statement.operation
    mut mutable: i64 = 0
    mut storage_mode: i64 = 0
    mut value_register: i64 = -1
    mut index_register: i64 = -1
    mut descriptor: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut constructor: NgAstNode = vector_get<NgAstNode>(nodes, statement.left)
    mut variable_index: i64 = vector_len<NgIRVariable>(&*variables)
    mut record_registers: vector<i64> = vector_new<i64>(0)
    mut status: i64 = 0
    mut expected_cells: i64 = 0
    mut next_cell: i64 = -1
    match statement_type < 0:
        -1:
            statement_type = 0 - statement_type
            mutable = 1
        0:
            mutable = 0
        1:
            mutable = 0
    match statement_type > 0:
        -1:
            match statement_type <= vector_len<NgTypeDescriptor>(types):
                -1:
                    descriptor = vector_get<NgTypeDescriptor>(types, statement_type - 1)
                    match descriptor.kind == 7:
                        -1:
                            expected_cells = ng_ir_value_cell_count(types, fields, statement_type)
                            record_registers = vector_new<i64>(expected_cells)
                            status = ng_ir_emit_value_cells(source, types, fields, functions, nodes, parameters, &*variables, function.first_parameter, function.parameter_count, statement_type, statement.left, call_arguments, registers, instructions, &mut record_registers)
                            match status <=> 0:
                                0:
                                    expected_cells = ng_ir_value_cell_count(types, fields, statement_type)
                                    match vector_len<i64>(&record_registers) <=> expected_cells:
                                        0:
                                            discard vector_push<NgIRVariable>(&mut *variables, NgIRVariable(name_start=statement.start, name_end=statement.end, name_fingerprint=ng_span_fingerprint(source, statement.start, statement.end), type_kind=statement_type, mutable=mutable, register=-1, memory=-1, parent_index=-1, field_name_start=-1, field_name_end=-1))
                                            next_cell = ng_emit_record_local_value_cells(source, types, fields, statement_type, variable_index, statement.start, statement.end, mutable, &record_registers, 0, variables)
                                            match next_cell <=> expected_cells:
                                                0:
                                                    return 0
                                                -1:
                                                    return -14
                                                1:
                                                    return -14
                                        -1:
                                            return -14
                                        1:
                                            return -14
                                -1:
                                    return status
                                1:
                                    return status
                        0:
                            return ng_emit_nonrecord_local_declaration(source, types, fields, functions, nodes, parameters, function, statement, statement_type, mutable, descriptor, variables, memories, registers, instructions, call_arguments)
                        1:
                            return -14
                0:
                    return -14
                1:
                    return -14
        0:
            return -14
        1:
            return -14

fn ng_emit_nonrecord_local_declaration(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, function: NgFunction, statement: NgAstNode, statement_type: i64, mutable: i64, descriptor: NgTypeDescriptor, variables: &mut vector<NgIRVariable>, memories: &mut vector<NgIRMemory>, registers: &mut vector<NgIRRegister>, instructions: &mut vector<NgIRInstruction>, call_arguments: &mut vector<i64>) -> i64:
    mut storage_mode: i64 = 0
    mut value_register: i64 = -1
    mut index_register: i64 = -1
    mut variable_index: i64 = -1
    match mutable == 1:
        -1:
            match descriptor.kind <= 4:
                -1:
                    storage_mode = 1
                0:
                    storage_mode = 0
                1:
                    storage_mode = 0
        0:
            storage_mode = 0
        1:
            storage_mode = 0
    value_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, &*variables, function.first_parameter, function.parameter_count, statement.left, call_arguments, registers, instructions)
    match value_register < 0:
        -1:
            return value_register
        0:
            value_register = value_register
        1:
            value_register = value_register
    discard ng_set_contextual_literal_type(nodes, statement.left, statement_type, registers, value_register)
    match storage_mode == 1:
        -1:
            variable_index = vector_len<NgIRMemory>(&*memories)
            discard vector_push<NgIRMemory>(memories, NgIRMemory(type_kind=statement_type, length=1, mutable=1))
            index_register = vector_len<NgIRRegister>(&*registers)
            discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=3))
            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=1, result=index_register, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=10, result=-1, operand_count=2, operand0=index_register, operand1=value_register, immediate=variable_index, memory=variable_index, initialization=1, block=0, target0=-1, target1=-1, target2=-1))
            discard vector_push<NgIRVariable>(&mut *variables, NgIRVariable(name_start=statement.start, name_end=statement.end, name_fingerprint=ng_span_fingerprint(source, statement.start, statement.end), type_kind=statement_type, mutable=1, register=-1, memory=variable_index, parent_index=-1, field_name_start=-1, field_name_end=-1))
        0:
            variable_index = vector_len<NgIRRegister>(&*registers)
            discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=statement_type))
            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=8, result=variable_index, operand_count=1, operand0=value_register, operand1=-1, immediate=0, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
            discard vector_push<NgIRVariable>(&mut *variables, NgIRVariable(name_start=statement.start, name_end=statement.end, name_fingerprint=ng_span_fingerprint(source, statement.start, statement.end), type_kind=statement_type, mutable=mutable, register=variable_index, memory=-1, parent_index=-1, field_name_start=-1, field_name_end=-1))
        1:
            return -14
    return 0

fn ng_integer_value(source: &bytes, start: i64, end: i64) -> NgIntegerResult:
    mut index: i64 = start
    mut value: i64 = 0
    mut digit: i64 = 0
    mut negative: i64 = 0
    match index < end:
        -1:
            match to_i64(bytes_get(source, index)) <=> 45:
                -1:
                    negative = 0
                0:
                    negative = 1
                    index = index + 1
                1:
                    negative = 0
        0:
            return NgIntegerResult(value=0, valid=0)
        1:
            return NgIntegerResult(value=0, valid=0)
    match index < end:
        -1:
            value = value
        0:
            return NgIntegerResult(value=0, valid=0)
        1:
            value = value
    while index < end:
        digit = to_i64(bytes_get(source, index)) - 48
        match digit < 0:
            -1:
                return NgIntegerResult(value=0, valid=0)
            0:
                match digit > 9:
                    -1:
