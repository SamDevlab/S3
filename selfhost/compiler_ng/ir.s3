fn ng_emit_call_expression(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, variables: &vector<NgIRVariable>, first_parameter: i64, parameter_count: i64, node: NgAstNode, call_arguments: &mut vector<i64>, registers: &mut vector<NgIRRegister>, instructions: &mut vector<NgIRInstruction>) -> i64:
    mut function_index: i64 = ng_find_function(source, functions, node.start, node.operation)
    mut function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, local_name_start=0, local_name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0, module_index=0, exported=0)
    mut argument_list: i64 = node.left
    mut argument_node: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    mut argument_register: i64 = -1
    mut evaluated_arguments: vector<i64> = vector_new<i64>(vector_len<NgAstNode>(nodes) + 1)
    mut argument_index: i64 = 0
    mut first_argument: i64 = 0
    mut result_register: i64 = -1
    match function_index < 0:
        -1:
            match ng_ir_span_matches_text(source, node.start, node.operation, text_from_static("vector_len")):
                -1:
                    return ng_emit_vector_len_expression(source, types, fields, functions, nodes, parameters, variables, first_parameter, parameter_count, node, call_arguments, registers, instructions)
                0:
                    match ng_ir_span_matches_text(source, node.start, node.operation, text_from_static("vector_push")):
                        -1:
                            return ng_emit_vector_push_expression(source, types, fields, functions, nodes, parameters, variables, first_parameter, parameter_count, node, call_arguments, registers, instructions)
                        0:
                            return ng_emit_vector_new_expression(source, types, fields, functions, nodes, parameters, variables, first_parameter, parameter_count, node, call_arguments, registers, instructions)
                        1:
                            return -13
                1:
                    return -13
        0:
            function = vector_get<NgFunction>(functions, function_index)
        1:
            return -13
    while argument_list >= 0:
        argument_node = vector_get<NgAstNode>(nodes, argument_list)
        parameter = vector_get<NgParameter>(parameters, function.first_parameter + argument_index)
        argument_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, first_parameter, parameter_count, argument_node.left, call_arguments, registers, instructions)
        match argument_register <=> -1:
            -1:
                return argument_register
            0:
                return argument_register
            1:
                discard ng_set_contextual_literal_type(nodes, argument_node.left, parameter.type_kind, registers, argument_register)
                discard vector_push<i64>(&mut evaluated_arguments, argument_register)
                argument_list = argument_node.right
                argument_index = argument_index + 1
    first_argument = vector_len<i64>(&*call_arguments)
    argument_index = 0
    while argument_index < vector_len<i64>(&evaluated_arguments):
        argument_register = vector_get<i64>(&evaluated_arguments, argument_index)
        discard vector_push<i64>(call_arguments, argument_register)
        argument_index = argument_index + 1
    result_register = vector_len<NgIRRegister>(&*registers)
    discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=function.return_type))
    discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=7, result=result_register, operand_count=vector_len<i64>(&evaluated_arguments), operand0=function_index, operand1=first_argument, immediate=0, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
    return result_register

fn ng_mark_discarded_call_result(nodes: &vector<NgAstNode>, expression_id: i64, instructions: &mut vector<NgIRInstruction>) -> i64:
    mut expression: NgAstNode = vector_get<NgAstNode>(nodes, expression_id)
    mut instruction_index: i64 = -1
    mut instruction: NgIRInstruction = NgIRInstruction(opcode=0, result=-1, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1)
    match expression.kind <=> 5:
        -1:
            return 0
        0:
            instruction_index = vector_len<NgIRInstruction>(&*instructions) - 1
            match instruction_index >= 0:
                -1:
                    instruction = vector_get<NgIRInstruction>(&*instructions, instruction_index)
                    match instruction.opcode <=> 7:
                        0:
                            instruction.result = -1
                            discard vector_set<NgIRInstruction>(instructions, instruction_index, instruction)
                            return 0
                        -1:
                            return 0
                        1:
                            return 0
                0:
                    return -1
                1:
                    return -1
        1:
            return 0

fn ng_emit_expression(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, variables: &vector<NgIRVariable>, first_parameter: i64, parameter_count: i64, node_id: i64, call_arguments: &mut vector<i64>, registers: &mut vector<NgIRRegister>, instructions: &mut vector<NgIRInstruction>) -> i64:
