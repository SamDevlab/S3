                                                                    value_info = vector_get<NgIRRegister>(&*registers, value_register)
                                                                    match ng_type_equal(source, types, value_info.type_kind, reference_type.target_type) <=> -1:
                                                                        0:
                                                                            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=21, result=-1, operand_count=2, operand0=reference_register, operand1=value_register, immediate=0, memory=-1, initialization=0, block=block, target0=-1, target1=-1, target2=-1))
                                                                            return 0
                                                                        -1:
                                                                            return -14
                                                                        1:
                                                                            return -14
                                                                0:
                                                                    return value_register
                                                                1:
                                                                    return value_register
                                                        -1:
                                                            return -14
                                                        1:
                                                            return -14
                                                -1:
                                                    return -16
                                                1:
                                                    return -16
                                        -1:
                                            return -14
                                        1:
                                            return -14
                                0:
                                    return -14
                                1:
                                    return -14
                        0:
                            return -14
                        1:
                            return -14
                0:
                    return reference_register
                1:
                    return reference_register
        -1:
            return -14
        1:
            return -14

fn ng_emit_assignment(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, function: NgFunction, statement: NgAstNode, variables: &mut vector<NgIRVariable>, call_arguments: &mut vector<i64>, registers: &mut vector<NgIRRegister>, instructions: &mut vector<NgIRInstruction>, block: i64) -> i64:
    mut variable_index: i64 = -1
    mut target: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut variable: NgIRVariable = NgIRVariable(name_start=0, name_end=0, name_fingerprint=0, type_kind=0, mutable=0, register=-1, memory=-1, parent_index=-1, field_name_start=-1, field_name_end=-1)
    mut value_register: i64 = -1
    mut value_info: NgIRRegister = NgIRRegister(type_kind=0)
    mut variable_type: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut index_register: i64 = -1
    match statement.right >= 0:
        -1:
            target = vector_get<NgAstNode>(nodes, statement.right)
            match target.kind <=> 14:
                0:
                    variable_index = ng_ir_field_variable_index(source, nodes, &*variables, statement.right)
                -1:
                    return -14
                1:
                    return ng_emit_dereference_assignment(source, types, fields, functions, nodes, parameters, function, statement, &*variables, call_arguments, registers, instructions, block)
        0:
            variable_index = ng_ir_variable_index(source, &*variables, statement.start, statement.end)
        1:
            return -14
    match variable_index >= 0:
        -1:
            variable = vector_get<NgIRVariable>(&*variables, variable_index)
            variable_type = vector_get<NgTypeDescriptor>(types, variable.type_kind - 1)
            match variable_type.kind <=> 7:
                0:
                    match variable.mutable <=> 1:
                        0:
                            return ng_emit_record_assignment(source, types, fields, functions, nodes, parameters, function, statement, variables, variable_index, call_arguments, registers, instructions)
                        -1:
                            return -16
                        1:
                            return -16
                -1:
                    variable = variable
                1:
                    variable = variable
            match variable.mutable <=> 1:
                -1:
                    return -16
                0:
                    value_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, &*variables, function.first_parameter, function.parameter_count, statement.left, call_arguments, registers, instructions)
                    match value_register >= 0:
                        -1:
                            discard ng_set_contextual_literal_type(nodes, statement.left, variable.type_kind, registers, value_register)
                            value_info = vector_get<NgIRRegister>(&*registers, value_register)
                            match ng_type_equal(source, types, value_info.type_kind, variable.type_kind) <=> -1:
                                0:
                                    match variable.memory <=> -1:
                                        -1:
                                            return -14
                                        0:
                                            match variable.register <=> -1:
                                                -1:
                                                    return -14
                                                0:
                                                    return -14
                                                1:
                                                    variable.register = value_register
                                                    discard vector_set<NgIRVariable>(&mut *variables, variable_index, variable)
                                        1:
                                            index_register = vector_len<NgIRRegister>(&*registers)
                                            discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=3))
                                            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=1, result=index_register, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=block, target0=-1, target1=-1, target2=-1))
                                            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=10, result=-1, operand_count=2, operand0=index_register, operand1=value_register, immediate=variable.memory, memory=variable.memory, initialization=0, block=block, target0=-1, target1=-1, target2=-1))
                                    return 0
                                -1:
                                    return -14
                                1:
                                    return -14
                        0:
                            return value_register
                        1:
                            return value_register
                1:
                    return -16
        0:
            return -12
        1:
            return -12

fn ng_emit_function_return(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, variables: &vector<NgIRVariable>, function: NgFunction, statement: NgAstNode, first_instruction: i64, block: i64, call_arguments: &mut vector<i64>, return_values: &mut vector<i64>, registers: &mut vector<NgIRRegister>, instructions: &mut vector<NgIRInstruction>) -> i64:
    mut result_count: i64 = ng_ir_value_cell_count(types, fields, function.return_type)
    mut result_registers: vector<i64> = vector_new<i64>(0)
    mut result_register: i64 = -1
    mut return_pool_start: i64 = 0
    mut cell_index: i64 = 0
    mut status: i64 = 0
    match result_count > 0:
        -1:
            result_registers = vector_new<i64>(result_count)
            status = ng_ir_emit_value_cells(source, types, fields, functions, nodes, parameters, variables, function.first_parameter, function.parameter_count, function.return_type, statement.left, call_arguments, registers, instructions, &mut result_registers)
            match status <=> 0:
                -1:
                    return status
                0:
                    match vector_len<i64>(&result_registers) <=> result_count:
                        0:
                            result_register = vector_get<i64>(&result_registers, 0)
                            return_pool_start = vector_len<i64>(&*return_values)
                            cell_index = 0
                            while cell_index < result_count:
                                discard vector_push<i64>(return_values, vector_get<i64>(&result_registers, cell_index))
                                cell_index = cell_index + 1
                            discard ng_mark_instruction_block(instructions, first_instruction, block)
                            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=6, result=-1, operand_count=result_count, operand0=result_register, operand1=return_pool_start, immediate=0, memory=-1, initialization=0, block=block, target0=-1, target1=-1, target2=-1))
                            return 0
                        -1:
                            return -14
                        1:
                            return -14
                1:
                    return status
        0:
            return -14
        1:
            return -14

fn ng_ir_relation_result(relation_code: i64, ordering: i64) -> i64:
    mut result: i64 = 0
    match relation_code <=> 0:
        -1:
            return -21
        0:
            match ordering <=> 0:
                -1:
                    result = 0
                0:
                    result = -1
                1:
                    result = 0
        1:
            match relation_code <=> 1:
                -1:
                    return -21
                0:
                    match ordering <=> 0:
                        -1:
                            result = -1
                        0:
                            result = 0
                        1:
                            result = -1
                1:
                    match relation_code <=> 2:
                        -1:
                            return -21
                        0:
                            match ordering <=> 0:
                                -1:
                                    result = -1
                                0:
                                    result = 0
                                1:
                                    result = 0
                        1:
                            match relation_code <=> 3:
                                -1:
                                    return -21
                                0:
                                    match ordering <=> 0:
                                        -1:
                                            result = -1
                                        0:
                                            result = -1
                                        1:
                                            result = 0
                                1:
                                    match relation_code <=> 4:
                                        -1:
                                            return -21
                                        0:
                                            match ordering <=> 0:
                                                -1:
                                                    result = 0
                                                0:
                                                    result = 0
                                                1:
                                                    result = -1
                                        1:
                                            match relation_code <=> 5:
                                                -1:
                                                    return -21
                                                0:
                                                    match ordering <=> 0:
                                                        -1:
                                                            result = 0
                                                        0:
                                                            result = -1
                                                        1:
                                                            result = -1
                                                1:
                                                    return -21
    return result

fn ng_emit_relation_value(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, variables: &vector<NgIRVariable>, function: NgFunction, node_id: i64, memories: &mut vector<NgIRMemory>, call_arguments: &mut vector<i64>, registers: &mut vector<NgIRRegister>, instructions: &mut vector<NgIRInstruction>, blocks: &mut vector<NgIRBlock>, current_block: &mut i64, expanded: &mut i64) -> i64:
    mut node: NgAstNode = vector_get<NgAstNode>(nodes, node_id)
    mut relation_code: i64 = -1
    mut first_instruction: i64 = vector_len<NgIRInstruction>(&*instructions)
    mut left: i64 = -1
    mut right: i64 = -1
    mut left_info: NgIRRegister = NgIRRegister(type_kind=0)
    mut right_info: NgIRRegister = NgIRRegister(type_kind=0)
    mut compare_register: i64 = -1
    mut memory_index: i64 = -1
    mut first_relation_block: i64 = -1
    mut continuation_block: i64 = -1
    mut block_index: i64 = 0
    mut relation_block: i64 = -1
    mut ordering: i64 = 0
    mut relation_value: i64 = 0
    mut index_register: i64 = -1
    mut value_register: i64 = -1
    mut result_register: i64 = -1
    match node.kind <=> 4:
        -1:
            return ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, function.first_parameter, function.parameter_count, node_id, call_arguments, registers, instructions)
        0:
            relation_code = ng_relational_operator_code(node.operation)
            match relation_code <=> -1:
                -1:
                    return -21
                0:
                    return ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, function.first_parameter, function.parameter_count, node_id, call_arguments, registers, instructions)
                1:
                    left = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, function.first_parameter, function.parameter_count, node.left, call_arguments, registers, instructions)
                    match left < 0:
                        -1:
                            return left
                        0:
                            left = left
                        1:
                            left = left
                    right = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, function.first_parameter, function.parameter_count, node.right, call_arguments, registers, instructions)
                    match right < 0:
                        -1:
                            return right
                        0:
                            right = right
                        1:
                            right = right
                    left_info = vector_get<NgIRRegister>(&*registers, left)
                    discard ng_set_contextual_literal_type(nodes, node.right, left_info.type_kind, registers, right)
                    right_info = vector_get<NgIRRegister>(&*registers, right)
                    match left_info.type_kind <=> right_info.type_kind:
                        -1:
                            return -21
                        0:
                            left_info = left_info
                        1:
                            return -21
                    match left_info.type_kind <=> 4:
                        -1:
                            compare_register = vector_len<NgIRRegister>(&*registers)
                            discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=2))
                            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=13, result=compare_register, operand_count=2, operand0=left, operand1=right, immediate=0, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
                            memory_index = vector_len<NgIRMemory>(&*memories)
                            discard vector_push<NgIRMemory>(memories, NgIRMemory(type_kind=2, length=1, mutable=1))
                            first_relation_block = vector_len<NgIRBlock>(&*blocks)
                            continuation_block = first_relation_block + 3
                            discard vector_push<NgIRBlock>(blocks, NgIRBlock(index=first_relation_block))
                            discard vector_push<NgIRBlock>(blocks, NgIRBlock(index=first_relation_block + 1))
                            discard vector_push<NgIRBlock>(blocks, NgIRBlock(index=first_relation_block + 2))
                            discard vector_push<NgIRBlock>(blocks, NgIRBlock(index=continuation_block))
                            discard ng_mark_instruction_block(instructions, first_instruction, *current_block)
                            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=11, result=-1, operand_count=1, operand0=compare_register, operand1=-1, immediate=0, memory=-1, initialization=0, block=*current_block, target0=first_relation_block, target1=first_relation_block + 1, target2=first_relation_block + 2))
                            block_index = 0
                            while block_index < 3:
                                relation_block = first_relation_block + block_index
                                match block_index <=> 0:
                                    -1:
                                        return -16
                                    0:
                                        ordering = -1
                                    1:
                                        match block_index <=> 1:
                                            -1:
                                                return -16
                                            0:
                                                ordering = 0
                                            1:
                                                ordering = 1
                                relation_value = ng_ir_relation_result(relation_code, ordering)
                                match relation_value < -1:
                                    -1:
                                        return relation_value
                                    0:
                                        relation_value = relation_value
                                    1:
                                        relation_value = relation_value
                                index_register = vector_len<NgIRRegister>(&*registers)
                                discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=3))
                                discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=1, result=index_register, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=relation_block, target0=-1, target1=-1, target2=-1))
                                value_register = vector_len<NgIRRegister>(&*registers)
                                discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=2))
                                discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=1, result=value_register, operand_count=0, operand0=-1, operand1=-1, immediate=relation_value, memory=-1, initialization=0, block=relation_block, target0=-1, target1=-1, target2=-1))
                                discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=10, result=-1, operand_count=2, operand0=index_register, operand1=value_register, immediate=0, memory=memory_index, initialization=1, block=relation_block, target0=-1, target1=-1, target2=-1))
                                discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=12, result=-1, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=relation_block, target0=continuation_block, target1=-1, target2=-1))
                                block_index = block_index + 1
                            *current_block = continuation_block
                            index_register = vector_len<NgIRRegister>(&*registers)
                            discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=3))
                            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=1, result=index_register, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=*current_block, target0=-1, target1=-1, target2=-1))
                            result_register = vector_len<NgIRRegister>(&*registers)
                            discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=2))
                            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=9, result=result_register, operand_count=1, operand0=index_register, operand1=-1, immediate=0, memory=memory_index, initialization=0, block=*current_block, target0=-1, target1=-1, target2=-1))
                            *expanded = 1
                            return result_register
                        0:
                            result_register = vector_len<NgIRRegister>(&*registers)
                            discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=2))
                            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=15, result=result_register, operand_count=2, operand0=left, operand1=right, immediate=relation_code, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
                            return result_register
                        1:
                            return -21
        1:
            return ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, function.first_parameter, function.parameter_count, node_id, call_arguments, registers, instructions)

fn ng_emit_match_arms(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, variables: &mut vector<NgIRVariable>, memories: &mut vector<NgIRMemory>, function: NgFunction, statement: NgAstNode, loop_exit_block: i64, call_arguments: &mut vector<i64>, return_values: &mut vector<i64>, registers: &mut vector<NgIRRegister>, instructions: &mut vector<NgIRInstruction>, blocks: &mut vector<NgIRBlock>, current_block: &mut i64) -> i64:
    mut selector_first_instruction: i64 = vector_len<NgIRInstruction>(&*instructions)
    mut selector_register: i64 = -1
    mut selector_expanded: i64 = 0
    mut block_index: i64 = 0
    mut first_arm_block: i64 = 0
    mut arm_end_block: i64 = 0
    mut join_block: i64 = 0
    mut arm_id: i64 = -1
    mut matching_arm_id: i64 = -1
    mut negative_arm_id: i64 = -1
    mut neutral_arm_id: i64 = -1
    mut positive_arm_id: i64 = -1
    mut arm_label: i64 = 0
    mut arm: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut body_link: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut body_statement: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut body_link_id: i64 = -1
    mut body_returned: i64 = 0
    mut any_fallthrough: i64 = 0
    mut arm_exit_block: i64 = -1
    mut arm_exit_blocks: vector<i64> = vector_new<i64>(3)
    mut variable_index: i64 = -1
    mut variable: NgIRVariable = NgIRVariable(name_start=0, name_end=0, name_fingerprint=0, type_kind=0, mutable=0, register=-1, memory=-1, parent_index=-1, field_name_start=-1, field_name_end=-1)
    mut first_instruction: i64 = 0
    mut value_register: i64 = -1
    mut index_register: i64 = -1
    mut status: i64 = 0
    selector_register = ng_emit_relation_value(source, types, fields, functions, nodes, parameters, &*variables, function, statement.left, memories, call_arguments, registers, instructions, blocks, current_block, &mut selector_expanded)
    match selector_register < 0:
        -1:
            return selector_register
        0:
            selector_register = selector_register
        1:
            selector_register = selector_register
    arm_id = statement.right
    while arm_id >= 0:
        arm = vector_get<NgAstNode>(nodes, arm_id)
        match arm.operation <=> -1:
            -1:
                arm_id = arm.right
            0:
                match negative_arm_id < 0:
                    -1:
                        negative_arm_id = arm_id
                    0:
                        negative_arm_id = negative_arm_id
                    1:
                        negative_arm_id = negative_arm_id
            1:
                match arm.operation <=> 0:
                    -1:
                        arm_id = arm.right
                    0:
                        match neutral_arm_id < 0:
                            -1:
                                neutral_arm_id = arm_id
                            0:
                                neutral_arm_id = neutral_arm_id
                            1:
                                neutral_arm_id = neutral_arm_id
                    1:
                        match arm.operation <=> 1:
                            -1:
                                arm_id = arm.right
                            0:
                                match positive_arm_id < 0:
                                    -1:
                                        positive_arm_id = arm_id
                                    0:
                                        positive_arm_id = positive_arm_id
                                    1:
                                        positive_arm_id = positive_arm_id
                            1:
                                arm_id = arm.right
        arm_id = arm.right
    first_arm_block = vector_len<NgIRBlock>(&*blocks)
    arm_end_block = first_arm_block + 3
    block_index = first_arm_block
    while block_index < arm_end_block:
        discard vector_push<NgIRBlock>(blocks, NgIRBlock(index=block_index))
        arm_label = block_index - first_arm_block - 1
        matching_arm_id = -1
        match arm_label <=> -1:
            -1:
                return -16
            0:
                matching_arm_id = negative_arm_id
            1:
                match arm_label <=> 0:
                    -1:
                        return -16
                    0:
                        matching_arm_id = neutral_arm_id
                    1:
                        match arm_label <=> 1:
                            -1:
                                return -16
                            0:
                                matching_arm_id = positive_arm_id
                            1:
                                return -16
        match matching_arm_id < 0:
            -1:
                return -16
            0:
                arm = vector_get<NgAstNode>(nodes, matching_arm_id)
                body_returned = ng_ir_statement_list_terminates(nodes, arm.left)
                match body_returned < 0:
                    -1:
                        return body_returned
                    0:
                        match body_returned <=> 1:
                            -1:
                                body_returned = body_returned
                            0:
                                body_returned = body_returned
                            1:
                                return -16
                    1:
                        return -16
            1:
                return -16
        block_index = block_index + 1
    block_index = 0
    while block_index < 3:
        discard vector_push<i64>(&mut arm_exit_blocks, -1)
        block_index = block_index + 1
    match selector_expanded <=> 0:
        -1:
            return -16
        0:
            discard ng_mark_instruction_block(instructions, selector_first_instruction, *current_block)
        1:
            selector_expanded = selector_expanded
    discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=11, result=-1, operand_count=1, operand0=selector_register, operand1=-1, immediate=0, memory=-1, initialization=0, block=*current_block, target0=first_arm_block, target1=first_arm_block + 1, target2=first_arm_block + 2))
    block_index = first_arm_block
    while block_index < arm_end_block:
        arm_label = block_index - first_arm_block - 1
        matching_arm_id = -1
        match arm_label <=> -1:
            -1:
                return -16
            0:
                matching_arm_id = negative_arm_id
            1:
                match arm_label <=> 0:
                    -1:
                        return -16
                    0:
                        matching_arm_id = neutral_arm_id
                    1:
                        match arm_label <=> 1:
                            -1:
                                return -16
                            0:
                                matching_arm_id = positive_arm_id
                            1:
                                return -16
        match matching_arm_id < 0:
            -1:
                return -16
            0:
                arm = vector_get<NgAstNode>(nodes, matching_arm_id)
                body_link_id = arm.left
                body_returned = 0
                variable_index = vector_len<NgIRVariable>(&*variables)
                *current_block = block_index
                while body_link_id >= 0:
                    body_link = vector_get<NgAstNode>(nodes, body_link_id)
                    body_statement = vector_get<NgAstNode>(nodes, body_link.left)
                    match body_statement.kind == 8:
                        -1:
                            first_instruction = vector_len<NgIRInstruction>(&*instructions)
                            status = ng_emit_assignment(source, types, fields, functions, nodes, parameters, function, body_statement, variables, call_arguments, registers, instructions, *current_block)
                            match status <=> 0:
                                0:
