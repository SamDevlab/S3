fn ng_mark_instruction_block(instructions: &mut vector<NgIRInstruction>, first_instruction: i64, block_index: i64) -> i64:
    mut instruction_index: i64 = first_instruction
    mut instruction: NgIRInstruction = NgIRInstruction(opcode=0, result=-1, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1)
    while instruction_index < vector_len<NgIRInstruction>(&*instructions):
        instruction = vector_get<NgIRInstruction>(&*instructions, instruction_index)
        instruction.block = block_index
        discard vector_set<NgIRInstruction>(&mut *instructions, instruction_index, instruction)
        instruction_index = instruction_index + 1
    return 0

fn ng_emit_match_arms(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, variables: &vector<NgIRVariable>, function: NgFunction, statement: NgAstNode, call_arguments: &mut vector<i64>, registers: &mut vector<NgIRRegister>, instructions: &mut vector<NgIRInstruction>, blocks: &mut vector<NgIRBlock>, current_block: &mut i64) -> i64:
    mut selector_first_instruction: i64 = vector_len<NgIRInstruction>(&*instructions)
    mut selector_register: i64 = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, function.first_parameter, function.parameter_count, statement.left, call_arguments, registers, instructions)
    mut block_index: i64 = 0
    mut first_arm_block: i64 = 0
    mut join_block: i64 = 0
    mut arm_id: i64 = -1
    mut matching_arm_id: i64 = -1
    mut arm_label: i64 = 0
    mut arm: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut body_link: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut body_statement: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut body_link_id: i64 = -1
    mut body_returned: i64 = 0
    mut any_fallthrough: i64 = 0
    mut variable_index: i64 = -1
    mut variable: NgIRVariable = NgIRVariable(name_start=0, name_end=0, type_kind=0, mutable=0, register=-1, memory=-1)
    mut first_instruction: i64 = 0
    mut return_register: i64 = -1
    mut value_register: i64 = -1
    mut index_register: i64 = -1
    match selector_register < 0:
        -1:
            return selector_register
        0:
            selector_register = selector_register
        1:
            selector_register = selector_register
    first_arm_block = vector_len<NgIRBlock>(&*blocks)
    join_block = first_arm_block + 3
    block_index = first_arm_block
    while block_index < join_block:
        discard vector_push<NgIRBlock>(blocks, NgIRBlock(index=block_index))
        arm_label = block_index - first_arm_block - 1
        arm_id = statement.right
        matching_arm_id = -1
        while arm_id >= 0:
            arm = vector_get<NgAstNode>(nodes, arm_id)
            match arm.operation <=> arm_label:
                -1:
                    arm_id = arm.right
                0:
                    matching_arm_id = arm_id
                    arm_id = -1
                1:
                    arm_id = arm.right
        match matching_arm_id < 0:
            -1:
                return -16
            0:
                arm = vector_get<NgAstNode>(nodes, matching_arm_id)
                body_link_id = arm.left
                body_returned = 0
                while body_link_id >= 0:
                    body_link = vector_get<NgAstNode>(nodes, body_link_id)
                    body_statement = vector_get<NgAstNode>(nodes, body_link.left)
                    match body_statement.kind <=> 9:
                        -1:
                            body_returned = 0
                        0:
                            match body_link.right <=> -1:
                                -1:
                                    return -17
                                0:
                                    body_returned = 1
                                1:
                                    return -17
                        1:
                            body_returned = 0
                    body_link_id = body_link.right
                match body_returned <=> 0:
                    -1:
                        return -16
                    0:
                        any_fallthrough = 1
                    1:
                        any_fallthrough = any_fallthrough
            1:
                return -16
        block_index = block_index + 1
    match any_fallthrough <=> 1:
        -1:
            block_index = block_index
        0:
            discard vector_push<NgIRBlock>(blocks, NgIRBlock(index=join_block))
        1:
            block_index = block_index
    discard ng_mark_instruction_block(instructions, selector_first_instruction, *current_block)
    discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=11, result=-1, operand_count=1, operand0=selector_register, operand1=-1, immediate=0, memory=-1, initialization=0, block=*current_block, target0=first_arm_block, target1=first_arm_block + 1, target2=first_arm_block + 2))
    block_index = first_arm_block
    while block_index < join_block:
        arm_label = block_index - first_arm_block - 1
        arm_id = statement.right
        matching_arm_id = -1
        while arm_id >= 0:
            arm = vector_get<NgAstNode>(nodes, arm_id)
            match arm.operation <=> arm_label:
                -1:
                    arm_id = arm.right
                0:
                    matching_arm_id = arm_id
                    arm_id = -1
                1:
                    arm_id = arm.right
        match matching_arm_id < 0:
            -1:
                return -16
            0:
                arm = vector_get<NgAstNode>(nodes, matching_arm_id)
                body_link_id = arm.left
                body_returned = 0
                while body_link_id >= 0:
                    body_link = vector_get<NgAstNode>(nodes, body_link_id)
                    body_statement = vector_get<NgAstNode>(nodes, body_link.left)
                    match body_statement.kind == 8:
                        -1:
                            variable_index = ng_ir_variable_index(source, variables, body_statement.start, body_statement.end)
                            match variable_index >= 0:
                                -1:
                                    variable = vector_get<NgIRVariable>(variables, variable_index)
                                    match variable.mutable <=> 1:
                                        -1:
                                            return -16
                                        0:
                                            first_instruction = vector_len<NgIRInstruction>(&*instructions)
                                        1:
                                            return -16
                                    value_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, function.first_parameter, function.parameter_count, body_statement.left, call_arguments, registers, instructions)
                                    match value_register < 0:
                                        -1:
                                            return value_register
                                        0:
                                            value_register = value_register
                                        1:
                                            value_register = value_register
                                    discard ng_set_contextual_literal_type(nodes, body_statement.left, variable.type_kind, registers, value_register)
                                    index_register = vector_len<NgIRRegister>(&*registers)
                                    discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=3))
                                    discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=1, result=index_register, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=block_index, target0=-1, target1=-1, target2=-1))
                                    discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=10, result=-1, operand_count=2, operand0=index_register, operand1=value_register, immediate=variable.memory, memory=variable.memory, initialization=0, block=block_index, target0=-1, target1=-1, target2=-1))
                                    discard ng_mark_instruction_block(instructions, first_instruction, block_index)
                                0:
                                    return -12
                                1:
                                    return -12
                        0:
                            match body_statement.kind == 9:
                                -1:
                                    match body_link.right <=> -1:
                                        -1:
                                            return -17
                                        0:
                                            body_returned = 1
                                        1:
                                            return -17
                                    first_instruction = vector_len<NgIRInstruction>(&*instructions)
                                    return_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, function.first_parameter, function.parameter_count, body_statement.left, call_arguments, registers, instructions)
                                    match return_register < 0:
                                        -1:
                                            return return_register
                                        0:
                                            return_register = return_register
                                        1:
                                            return_register = return_register
                                    discard ng_set_contextual_literal_type(nodes, body_statement.left, function.return_type, registers, return_register)
                                    discard ng_mark_instruction_block(instructions, first_instruction, block_index)
                                    discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=6, result=-1, operand_count=1, operand0=return_register, operand1=-1, immediate=0, memory=-1, initialization=0, block=block_index, target0=-1, target1=-1, target2=-1))
                                0:
                                    return -16
                                1:
                                    return -16
                        1:
                            return -16
                    body_link_id = body_link.right
                match body_returned <=> 0:
                    -1:
                        return -16
                    0:
                        discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=12, result=-1, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=block_index, target0=join_block, target1=-1, target2=-1))
                    1:
                        body_returned = body_returned
            1:
                return -16
        block_index = block_index + 1
    match any_fallthrough <=> 1:
        -1:
            *current_block = -1
        0:
            *current_block = join_block
        1:
            *current_block = join_block
    return 0

fn ng_emit_while(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, variables: &vector<NgIRVariable>, function: NgFunction, statement: NgAstNode, call_arguments: &mut vector<i64>, registers: &mut vector<NgIRRegister>, instructions: &mut vector<NgIRInstruction>, blocks: &mut vector<NgIRBlock>, current_block: &mut i64) -> i64:
    mut header_block: i64 = vector_len<NgIRBlock>(&*blocks)
    mut body_block: i64 = 0
    mut exit_zero_block: i64 = 0
    mut exit_positive_block: i64 = 0
    mut exit_block: i64 = 0
    mut condition_register: i64 = -1
    mut first_instruction: i64 = 0
    mut body_link_id: i64 = statement.right
    mut body_link: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut body_statement: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut variable_index: i64 = -1
    mut variable: NgIRVariable = NgIRVariable(name_start=0, name_end=0, type_kind=0, mutable=0, register=-1, memory=-1)
    mut value_register: i64 = -1
    mut index_register: i64 = -1
    mut status: i64 = 0
    match *current_block <=> -1:
        -1:
            return -16
        0:
            return -16
        1:
            body_block = header_block + 1
            exit_zero_block = header_block + 2
            exit_positive_block = header_block + 3
            exit_block = header_block + 4
    discard vector_push<NgIRBlock>(blocks, NgIRBlock(index=header_block))
    discard vector_push<NgIRBlock>(blocks, NgIRBlock(index=body_block))
    discard vector_push<NgIRBlock>(blocks, NgIRBlock(index=exit_zero_block))
    discard vector_push<NgIRBlock>(blocks, NgIRBlock(index=exit_positive_block))
    discard vector_push<NgIRBlock>(blocks, NgIRBlock(index=exit_block))
    discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=12, result=-1, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=*current_block, target0=header_block, target1=-1, target2=-1))
    first_instruction = vector_len<NgIRInstruction>(&*instructions)
    condition_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, function.first_parameter, function.parameter_count, statement.left, call_arguments, registers, instructions)
    match condition_register <=> -1:
        -1:
            return condition_register
        0:
            return condition_register
        1:
            discard ng_mark_instruction_block(instructions, first_instruction, header_block)
    discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=11, result=-1, operand_count=1, operand0=condition_register, operand1=-1, immediate=0, memory=-1, initialization=0, block=header_block, target0=body_block, target1=exit_zero_block, target2=exit_positive_block))
    *current_block = body_block
    while body_link_id >= 0:
        match *current_block <=> -1:
            -1:
                return -17
            0:
                return -17
            1:
                body_link = vector_get<NgAstNode>(nodes, body_link_id)
                body_statement = vector_get<NgAstNode>(nodes, body_link.left)
                first_instruction = vector_len<NgIRInstruction>(&*instructions)
                match body_statement.kind == 8:
                    -1:
                        variable_index = ng_ir_variable_index(source, variables, body_statement.start, body_statement.end)
                        match variable_index >= 0:
                            -1:
                                variable = vector_get<NgIRVariable>(variables, variable_index)
                                match variable.mutable <=> 1:
                                    -1:
                                        return -16
                                    0:
                                        value_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, function.first_parameter, function.parameter_count, body_statement.left, call_arguments, registers, instructions)
                                        match value_register < 0:
                                            -1:
                                                return value_register
                                            0:
                                                return value_register
                                            1:
                                                discard ng_set_contextual_literal_type(nodes, body_statement.left, variable.type_kind, registers, value_register)
                                                index_register = vector_len<NgIRRegister>(&*registers)
                                                discard vector_push<NgIRRegister>(registers, NgIRRegister(type_kind=3))
                                                discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=1, result=index_register, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=*current_block, target0=-1, target1=-1, target2=-1))
                                                discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=10, result=-1, operand_count=2, operand0=index_register, operand1=value_register, immediate=variable.memory, memory=variable.memory, initialization=0, block=*current_block, target0=-1, target1=-1, target2=-1))
                                                discard ng_mark_instruction_block(instructions, first_instruction, *current_block)
                                    1:
                                        return -16
                            0:
                                return -12
                            1:
                                return -12
                    0:
                        match body_statement.kind == 9:
                            -1:
                                match body_link.right <=> -1:
                                    -1:
                                        return -17
                                    0:
                                        value_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, function.first_parameter, function.parameter_count, body_statement.left, call_arguments, registers, instructions)
                                        match value_register <=> -1:
                                            -1:
                                                return value_register
                                            0:
                                                return value_register
                                            1:
                                                discard ng_set_contextual_literal_type(nodes, body_statement.left, function.return_type, registers, value_register)
                                                discard ng_mark_instruction_block(instructions, first_instruction, *current_block)
                                                discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=6, result=-1, operand_count=1, operand0=value_register, operand1=-1, immediate=0, memory=-1, initialization=0, block=*current_block, target0=-1, target1=-1, target2=-1))
                                                *current_block = -1
                                    1:
                                        return -17
                            0:
                                match body_statement.kind == 12:
                                    -1:
                                        status = ng_emit_match_arms(source, types, fields, functions, nodes, parameters, variables, function, body_statement, call_arguments, registers, instructions, blocks, current_block)
                                        match status <=> 0:
                                            -1:
                                                return status
                                            0:
                                                status = status
                                            1:
                                                return status
                                    0:
                                        match body_statement.kind == 15:
                                            -1:
                                                value_register = ng_emit_expression(source, types, fields, functions, nodes, parameters, variables, function.first_parameter, function.parameter_count, body_statement.left, call_arguments, registers, instructions)
                                                match value_register <=> -1:
                                                    -1:
                                                        return value_register
                                                    0:
                                                        return value_register
                                                    1:
                                                        discard ng_mark_discarded_call_result(nodes, body_statement.left, instructions)
                                                        discard ng_mark_instruction_block(instructions, first_instruction, *current_block)
                                            0:
                                                match body_statement.kind == 17:
                                                    -1:
                                                        status = ng_emit_while(source, types, fields, functions, nodes, parameters, variables, function, body_statement, call_arguments, registers, instructions, blocks, current_block)
                                                        match status <=> 0:
                                                            -1:
                                                                return status
                                                            0:
                                                                status = status
                                                            1:
                                                                return status
                                                    0:
                                                        return -16
                                                    1:
                                                        return -16
                                            1:
                                                return -16
                                    1:
                                        return -16
                            1:
                                return -16
                    1:
                        return -16
                body_link_id = body_link.right
    match *current_block <=> -1:
        -1:
            *current_block = -1
        0:
            *current_block = -1
        1:
            discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=12, result=-1, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=*current_block, target0=header_block, target1=-1, target2=-1))
    discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=12, result=-1, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=exit_zero_block, target0=exit_block, target1=-1, target2=-1))
    discard vector_push<NgIRInstruction>(instructions, NgIRInstruction(opcode=12, result=-1, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=exit_positive_block, target0=exit_block, target1=-1, target2=-1))
    *current_block = exit_block
    return 0

export fn ng_emit_program(source: &bytes, types: &vector<NgTypeDescriptor>, records: &vector<NgRecord>, fields: &vector<NgField>, functions: &vector<NgFunction>, parameters: &vector<NgParameter>, nodes: &mut vector<NgAstNode>, events: &mut vector<i64>) -> i64:
    mut status: i64 = ng_check_program_typed(source, types, records, fields, functions, parameters, nodes)
    mut function_index: i64 = 0
    mut parameter_index: i64 = 0
    mut register_index: i64 = 0
    mut memory_index: i64 = 0
    mut block_index: i64 = 0
    mut instruction_index: i64 = 0
    mut call_argument_index: i64 = 0
    mut call_argument_register: i64 = -1
    mut link_id: i64 = -1
    mut variable_index: i64 = -1
    mut statement_type: i64 = 0
    mut mutable: i64 = 0
    mut value_register: i64 = -1
    mut index_register: i64 = -1
    mut event_operand1: i64 = -1
    mut event_immediate: i64 = 0
    mut function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, local_name_start=0, local_name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0, module_index=0, exported=0)
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    mut link: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut statement: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut register: NgIRRegister = NgIRRegister(type_kind=0)
    mut instruction: NgIRInstruction = NgIRInstruction(opcode=0, result=-1, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1)
    mut node_capacity: i64 = vector_len<NgAstNode>(&*nodes)
    mut registers: vector<NgIRRegister> = vector_new<NgIRRegister>(node_capacity * 4 + 16)
    mut memories: vector<NgIRMemory> = vector_new<NgIRMemory>(node_capacity + 1)
    mut variables: vector<NgIRVariable> = vector_new<NgIRVariable>(node_capacity + 1)
    mut variable: NgIRVariable = NgIRVariable(name_start=0, name_end=0, type_kind=0, mutable=0, register=-1, memory=-1)
    mut memory: NgIRMemory = NgIRMemory(type_kind=0, length=0, mutable=0)
    mut block: NgIRBlock = NgIRBlock(index=0)
    mut blocks: vector<NgIRBlock> = vector_new<NgIRBlock>(node_capacity + 5)
    mut instructions: vector<NgIRInstruction> = vector_new<NgIRInstruction>(node_capacity * 4 + 16)
    mut call_arguments: vector<i64> = vector_new<i64>(node_capacity + 1)
    mut result_register: i64 = -1
    mut current_block: i64 = 0
    mut statement_first_instruction: i64 = 0
    mut type_index: i64 = 0
    mut type_descriptor: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut field_index: i64 = 0
    mut field: NgField = NgField(record_index=0, name_start=0, name_end=0, type_id=0, order=0)
    mut record_item: NgRecord = NgRecord(module_index=0, name_start=0, name_end=0, type_id=0, first_field=0, field_count=0, exported=0)
    match status <=> 0:
        -1:
            return status
        0:
            discard ng_ir_event(events, 0, 8, 8, 0, 0, 0, 0, 0)
            while type_index < vector_len<NgTypeDescriptor>(types):
                type_descriptor = vector_get<NgTypeDescriptor>(types, type_index)
                discard ng_ir_event(events, 12, type_index + 1, type_descriptor.kind, type_descriptor.module_start, type_descriptor.module_end, type_descriptor.name_start, type_descriptor.name_end, type_descriptor.element_type)
                discard ng_ir_event(events, 13, type_index + 1, type_descriptor.target_type, type_descriptor.mutable, type_descriptor.first_field, type_descriptor.field_count, 0, 0)
                type_index = type_index + 1
            while field_index < vector_len<NgField>(fields):
                field = vector_get<NgField>(fields, field_index)
                record_item = vector_get<NgRecord>(records, field.record_index)
                discard ng_ir_event(events, 14, record_item.type_id, field.order, field.name_start, field.name_end, field.type_id, 0, 0)
                field_index = field_index + 1
        1:
            return status
    while function_index < vector_len<NgFunction>(functions):
        function = vector_get<NgFunction>(functions, function_index)
        registers = vector_new<NgIRRegister>(node_capacity * 4 + 16)
        memories = vector_new<NgIRMemory>(node_capacity + 1)
        blocks = vector_new<NgIRBlock>(node_capacity + 5)
        discard vector_push<NgIRBlock>(&mut blocks, NgIRBlock(index=0))
        variables = vector_new<NgIRVariable>(node_capacity + 1)
        instructions = vector_new<NgIRInstruction>(node_capacity * 4 + 16)
        call_arguments = vector_new<i64>(node_capacity + 1)
        current_block = 0
        parameter_index = 0
        while parameter_index < function.parameter_count:
            parameter = vector_get<NgParameter>(parameters, function.first_parameter + parameter_index)
            discard vector_push<NgIRRegister>(&mut registers, NgIRRegister(type_kind=parameter.type_kind))
            parameter_index = parameter_index + 1
        link_id = function.body_node
        while link_id >= 0:
            link = vector_get<NgAstNode>(&*nodes, link_id)
            statement = vector_get<NgAstNode>(&*nodes, link.left)
            statement_first_instruction = vector_len<NgIRInstruction>(&instructions)
            match statement.kind == 7:
                -1:
                    statement_type = statement.operation
                    mutable = 0
                    match statement_type < 0:
                        -1:
                            statement_type = 0 - statement_type
                            mutable = 1
                        0:
                            mutable = 0
                        1:
                            mutable = 0
                    value_register = ng_emit_expression(source, types, fields, functions, &*nodes, parameters, &variables, function.first_parameter, function.parameter_count, statement.left, &mut call_arguments, &mut registers, &mut instructions)
                    match value_register <=> -1:
                        -1:
                            return value_register
                        0:
                            mutable = mutable
                        1:
                            mutable = mutable
                    discard ng_set_contextual_literal_type(&*nodes, statement.left, statement_type, &mut registers, value_register)
                    match mutable == 1:
                        -1:
                            memory_index = vector_len<NgIRMemory>(&memories)
                            discard vector_push<NgIRMemory>(&mut memories, NgIRMemory(type_kind=statement_type, length=1, mutable=1))
                            index_register = vector_len<NgIRRegister>(&registers)
                            discard vector_push<NgIRRegister>(&mut registers, NgIRRegister(type_kind=3))
                            discard vector_push<NgIRInstruction>(&mut instructions, NgIRInstruction(opcode=1, result=index_register, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
                            discard vector_push<NgIRInstruction>(&mut instructions, NgIRInstruction(opcode=10, result=-1, operand_count=2, operand0=index_register, operand1=value_register, immediate=memory_index, memory=memory_index, initialization=1, block=0, target0=-1, target1=-1, target2=-1))
                            discard vector_push<NgIRVariable>(&mut variables, NgIRVariable(name_start=statement.start, name_end=statement.end, type_kind=statement_type, mutable=1, register=-1, memory=memory_index))
                        0:
                            register_index = vector_len<NgIRRegister>(&registers)
                            discard vector_push<NgIRRegister>(&mut registers, NgIRRegister(type_kind=statement_type))
                            discard vector_push<NgIRInstruction>(&mut instructions, NgIRInstruction(opcode=8, result=register_index, operand_count=1, operand0=value_register, operand1=-1, immediate=0, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
                            discard vector_push<NgIRVariable>(&mut variables, NgIRVariable(name_start=statement.start, name_end=statement.end, type_kind=statement_type, mutable=0, register=register_index, memory=-1))
                        1:
                            mutable = mutable
                0:
                    match statement.kind == 8:
                        -1:
                            variable_index = ng_ir_variable_index(source, &variables, statement.start, statement.end)
                            match variable_index >= 0:
                                -1:
                                    variable = vector_get<NgIRVariable>(&variables, variable_index)
                                    match variable.mutable == 1:
                                        -1:
                                            value_register = ng_emit_expression(source, types, fields, functions, &*nodes, parameters, &variables, function.first_parameter, function.parameter_count, statement.left, &mut call_arguments, &mut registers, &mut instructions)
                                            match value_register < 0:
                                                -1:
                                                    return value_register
                                                0:
                                                    index_register = vector_len<NgIRRegister>(&registers)
                                                    discard vector_push<NgIRRegister>(&mut registers, NgIRRegister(type_kind=3))
                                                    discard vector_push<NgIRInstruction>(&mut instructions, NgIRInstruction(opcode=1, result=index_register, operand_count=0, operand0=-1, operand1=-1, immediate=0, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
                                                    discard vector_push<NgIRInstruction>(&mut instructions, NgIRInstruction(opcode=10, result=-1, operand_count=2, operand0=index_register, operand1=value_register, immediate=variable.memory, memory=variable.memory, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
                                                1:
                                                    return value_register
                                            discard ng_set_contextual_literal_type(&*nodes, statement.left, variable.type_kind, &mut registers, value_register)
                                        0:
                                            return -16
                                        1:
                                            return -16
                                0:
                                    return -12
                                1:
                                    return -12
                        0:
                            match statement.kind == 9:
                                -1:
                                    result_register = ng_emit_expression(source, types, fields, functions, &*nodes, parameters, &variables, function.first_parameter, function.parameter_count, statement.left, &mut call_arguments, &mut registers, &mut instructions)
                                    match result_register < 0:
                                        -1:
                                            return result_register
                                        0:
                                            discard vector_push<NgIRInstruction>(&mut instructions, NgIRInstruction(opcode=6, result=-1, operand_count=1, operand0=result_register, operand1=-1, immediate=0, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
                                        1:
                                            discard vector_push<NgIRInstruction>(&mut instructions, NgIRInstruction(opcode=6, result=-1, operand_count=1, operand0=result_register, operand1=-1, immediate=0, memory=-1, initialization=0, block=0, target0=-1, target1=-1, target2=-1))
                                    discard ng_set_contextual_literal_type(&*nodes, statement.left, function.return_type, &mut registers, result_register)
                                0:
                                    match statement.kind == 12:
                                        -1:
                                            status = ng_emit_match_arms(source, types, fields, functions, &*nodes, parameters, &variables, function, statement, &mut call_arguments, &mut registers, &mut instructions, &mut blocks, &mut current_block)
                                            match status <=> 0:
                                                -1:
                                                    return status
                                                0:
                                                    link_id = link.right
                                                1:
                                                    return status
                                        0:
                                            match statement.kind == 15:
                                                -1:
                                                    value_register = ng_emit_expression(source, types, fields, functions, &*nodes, parameters, &variables, function.first_parameter, function.parameter_count, statement.left, &mut call_arguments, &mut registers, &mut instructions)
                                                    match value_register < 0:
                                                        -1:
                                                            return value_register
                                                        0:
                                                            value_register = value_register
                                                        1:
                                                            value_register = value_register
                                                    discard ng_mark_discarded_call_result(&*nodes, statement.left, &mut instructions)
                                                0:
                                                    match statement.kind == 17:
                                                        -1:
                                                            status = ng_emit_while(source, types, fields, functions, &*nodes, parameters, &variables, function, statement, &mut call_arguments, &mut registers, &mut instructions, &mut blocks, &mut current_block)
                                                            match status <=> 0:
                                                                -1:
                                                                    return status
                                                                0:
                                                                    status = status
                                                                1:
                                                                    return status
                                                        0:
                                                            return -16
                                                        1:
                                                            return -16
                                                1:
                                                    return -16
                                        1:
                                            return -16
                                1:
                                    return -16
                        1:
                            return -16
                1:
                    return -16
            match statement.kind == 17:
                -1:
                    statement_first_instruction = statement_first_instruction
                0:
                    match statement.kind <=> 12:
                        -1:
                            discard ng_mark_instruction_block(&mut instructions, statement_first_instruction, current_block)
                        0:
                            statement_first_instruction = statement_first_instruction
                        1:
                            discard ng_mark_instruction_block(&mut instructions, statement_first_instruction, current_block)
                1:
                    return -16
            link_id = link.right
        discard ng_ir_event(events, 1, function_index, function.return_type, function.parameter_count, function.name_start, function.name_end, 1, function.exported * 2)
        parameter_index = 0
        while parameter_index < function.parameter_count:
            parameter = vector_get<NgParameter>(parameters, function.first_parameter + parameter_index)
            discard ng_ir_event(events, 2, function_index, parameter_index, parameter.type_kind, parameter_index, parameter.name_start, parameter.name_end, 0)
            parameter_index = parameter_index + 1
        register_index = 0
        while register_index < vector_len<NgIRRegister>(&registers):
            register = vector_get<NgIRRegister>(&registers, register_index)
            discard ng_ir_event(events, 3, function_index, register_index, register.type_kind, 0, 0, 0, 0)
            register_index = register_index + 1
        memory_index = 0
        while memory_index < vector_len<NgIRMemory>(&memories):
            memory = vector_get<NgIRMemory>(&memories, memory_index)
            discard ng_ir_event(events, 7, function_index, memory_index, memory.type_kind, memory.length, memory.mutable, 0, 0)
            memory_index = memory_index + 1
        block_index = 0
        while block_index < vector_len<NgIRBlock>(&blocks):
            block = vector_get<NgIRBlock>(&blocks, block_index)
            discard ng_ir_event(events, 9, function_index, block.index, 0, 0, 0, 0, 0)
            block_index = block_index + 1
        instruction_index = 0
        while instruction_index < vector_len<NgIRInstruction>(&instructions):
            instruction = vector_get<NgIRInstruction>(&instructions, instruction_index)
            event_operand1 = instruction.operand1
            event_immediate = instruction.immediate
            match instruction.opcode <=> 9:
                -1:
                    instruction_index = instruction_index
                0:
                    event_operand1 = instruction.memory
                1:
                    match instruction.opcode <=> 10:
                        -1:
                            instruction_index = instruction_index
                        0:
                            event_immediate = instruction.memory
                        1:
                            instruction_index = instruction_index
            match instruction.opcode <=> 7:
                0:
                    match instruction.operand0 <=> -3:
                        0:
                            event_immediate = 0
                        -1:
                            event_immediate = event_immediate
                        1:
                            event_immediate = event_immediate
                -1:
                    instruction_index = instruction_index
                1:
                    instruction_index = instruction_index
            discard ng_ir_event(events, 4, function_index, instruction.opcode, instruction.result, instruction.operand_count, instruction.operand0, event_operand1, event_immediate)
            match instruction.opcode <=> 7:
                -1:
                    instruction_index = instruction_index
                0:
                    call_argument_index = 0
                    while call_argument_index < instruction.operand_count:
                        call_argument_register = vector_get<i64>(&call_arguments, instruction.operand1 + call_argument_index)
                        discard ng_ir_event(events, 6, function_index, instruction_index, call_argument_index, call_argument_register, 0, 0, 0)
                        call_argument_index = call_argument_index + 1
                    match instruction.operand0 <=> -1:
                        0:
                            register = vector_get<NgIRRegister>(&registers, instruction.result)
                            type_descriptor = vector_get<NgTypeDescriptor>(types, register.type_kind - 1)
                            event_operand1 = ng_ir_vector_new_builtin_id(types, type_descriptor.element_type)
                            match event_operand1 > 0:
                                -1:
                                    discard ng_ir_event(events, 16, function_index, instruction_index, event_operand1, type_descriptor.element_type, 0, 0, 0)
                                0:
                                    return -14
                                1:
                                    return -14
                        -1:
                            instruction_index = instruction_index
                        1:
                            instruction_index = instruction_index
                    match instruction.operand0 <=> -2:
                        0:
                            event_operand1 = ng_ir_call_vector_element(types, &registers, &call_arguments, instruction.operand1)
                            match event_operand1 > 0:
                                -1:
                                    discard ng_ir_event(events, 17, function_index, instruction_index, 1, event_operand1, 0, 0, 0)
                                0:
                                    return -14
                                1:
                                    return -14
                        -1:
                            instruction_index = instruction_index
                        1:
                            instruction_index = instruction_index
                    match instruction.operand0 <=> -3:
                        0:
                            discard ng_ir_event(events, 18, function_index, instruction_index, 1, instruction.immediate, 0, 0, 0)
                        -1:
                            instruction_index = instruction_index
                        1:
                            instruction_index = instruction_index
                    instruction_index = instruction_index
                1:
                    match instruction.opcode <=> 10:
                        -1:
                            instruction_index = instruction_index
                        0:
                            discard ng_ir_event(events, 8, function_index, instruction_index, instruction.initialization, 0, 0, 0, 0)
                            instruction_index = instruction_index
                        1:
                            instruction_index = instruction_index
            match instruction.opcode <=> 14:
                -1:
                    instruction_index = instruction_index
                0:
                    discard ng_ir_event(events, 15, function_index, instruction_index, instruction.memory, 0, 0, 0, 0)
                1:
                    instruction_index = instruction_index
            discard ng_ir_event(events, 10, function_index, instruction_index, instruction.block, 0, 0, 0, 0)
            match instruction.opcode <=> 11:
                -1:
                    instruction_index = instruction_index
                0:
                    discard ng_ir_event(events, 11, function_index, instruction_index, instruction.target0, instruction.target1, instruction.target2, 0, 0)
                1:
                    match instruction.opcode <=> 12:
                        -1:
                            instruction_index = instruction_index
                        0:
                            discard ng_ir_event(events, 11, function_index, instruction_index, instruction.target0, 0, 0, 0, 0)
                        1:
                            instruction_index = instruction_index
            instruction_index = instruction_index + 1
        discard ng_ir_event(events, 5, function_index, 0, 0, 0, 0, 0, 0)
        function_index = function_index + 1
    return 0
