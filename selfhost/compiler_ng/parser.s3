module selfhost.compiler_ng.parser

from selfhost.compiler_ng.lexer import NgToken

export record NgAstNode:
    kind: i64
    start: i64
    end: i64
    left: i64
    right: i64
    operation: i64

export record NgParameter:
    name_start: i64
    name_end: i64
    type_kind: i64

export record NgFunction:
    start: i64
    end: i64
    name_start: i64
    name_end: i64
    first_parameter: i64
    parameter_count: i64
    return_type: i64
    body_node: i64

fn ng_token_at(tokens: &vector<NgToken>, cursor: &mut vector<i64>) -> NgToken:
    return vector_get<NgToken>(tokens, vector_get<i64>(&*cursor, 0))

fn ng_advance(cursor: &mut vector<i64>) -> i64:
    mut next: i64 = vector_get<i64>(&*cursor, 0) + 1
    discard vector_set<i64>(&mut *cursor, 0, next)
    return next

fn ng_expect_kind(tokens: &vector<NgToken>, cursor: &mut vector<i64>, wanted: i64) -> trit:
    mut token: NgToken = ng_token_at(tokens, cursor)
    match token.kind <=> wanted:
        -1:
            return -1
        0:
            return 0
        1:
            return -1

fn ng_token_spells(source: &bytes, token: NgToken, wanted: text) -> trit:
    mut expected: bytes = bytes_from_text(&wanted)
    mut expected_length: i64 = bytes_len(&expected)
    mut source_index: i64 = token.start
    mut expected_index: i64 = 0
    match token.end - token.start <=> expected_length:
        -1:
            return 0
        0:
            while expected_index < expected_length:
                match to_i64(bytes_get(source, source_index)) <=> to_i64(bytes_get(&expected, expected_index)):
                    -1:
                        return 0
                    0:
                        source_index = source_index + 1
                        expected_index = expected_index + 1
                    1:
                        return 0
            return -1
        1:
            return 0

fn ng_expect_word(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, wanted: text) -> trit:
    mut token: NgToken = ng_token_at(tokens, cursor)
    match token.kind <=> 1:
        -1:
            return -1
        0:
            match ng_token_spells(source, token, wanted):
                -1:
                    discard ng_advance(cursor)
                    return 0
                0:
                    return -1
                1:
                    return -1
        1:
            return -1

fn ng_parse_type(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>) -> i64:
    mut token: NgToken = ng_token_at(tokens, cursor)
    match token.kind <=> 1:
        -1:
            return -1
        0:
            match ng_token_spells(source, token, text_from_static("i64")):
                -1:
                    discard ng_advance(cursor)
                    return 1
                0:
                    match ng_token_spells(source, token, text_from_static("trit")):
                        -1:
                            discard ng_advance(cursor)
                            return 2
                        0:
                            match ng_token_spells(source, token, text_from_static("tryte")):
                                -1:
                                    discard ng_advance(cursor)
                                    return 3
                                0:
                                    match ng_token_spells(source, token, text_from_static("f64")):
                                        -1:
                                            discard ng_advance(cursor)
                                            return 4
                                        0:
                                            return -1
                                        1:
                                            return -1
                                1:
                                    return -1
                        1:
                            return -1
                1:
                    return -1
        1:
            return -1

fn ng_append_node(nodes: &mut vector<NgAstNode>, node: NgAstNode) -> i64:
    mut node_id: i64 = vector_len<NgAstNode>(&*nodes)
    discard vector_push<NgAstNode>(nodes, node)
    return node_id

fn ng_token_indent(source: &bytes, token: NgToken) -> i64:
    mut line_start: i64 = token.start
    mut column: i64 = 0
    mut unit: i64 = 0
    mut scanning: i64 = 1
    while scanning == 1:
        match line_start > 0:
            -1:
                match to_i64(bytes_get(source, line_start - 1)) == 10:
                    -1:
                        scanning = 0
                    0:
                        line_start = line_start - 1
                    1:
                        line_start = line_start - 1
            0:
                scanning = 0
            1:
                scanning = 0
    while line_start + column < token.start:
        unit = to_i64(bytes_get(source, line_start + column))
        match unit == 32:
            -1:
                column = column + 1
            0:
                return -1
            1:
                column = column + 1
    return column

fn ng_build_statement_links(statement_ids: &vector<i64>, index: i64, nodes: &mut vector<NgAstNode>) -> i64:
    mut statement_id: i64 = -1
    mut statement: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut next: i64 = -1
    match index < vector_len<i64>(statement_ids):
        -1:
            next = ng_build_statement_links(statement_ids, index + 1, nodes)
            statement_id = vector_get<i64>(statement_ids, index)
            statement = vector_get<NgAstNode>(&*nodes, statement_id)
            return ng_append_node(nodes, NgAstNode(kind=11, start=statement.start, end=statement.end, left=statement_id, right=next, operation=0))
        0:
            return -1
        1:
            return -1

fn ng_parse_declaration(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, nodes: &mut vector<NgAstNode>, name: NgToken, mutable: i64) -> i64:
    mut type_kind: i64 = 0
    mut expression: i64 = -1
    mut token: NgToken = NgToken(kind=0, start=0, end=0)
    match ng_expect_kind(tokens, cursor, 358):
        -1:
            return -1
        0:
            discard ng_advance(cursor)
            type_kind = ng_parse_type(source, tokens, cursor)
            match type_kind <=> 0:
                -1:
                    return -1
                0:
                    return -1
                1:
                    token = ng_token_at(tokens, cursor)
                    match token.kind <=> 361:
                        -1:
                            return -1
                        0:
                            discard ng_advance(cursor)
                            expression = ng_parse_expression(source, tokens, cursor, nodes)
                            match expression <=> -1:
                                -1:
                                    return -1
                                0:
                                    return -1
                                1:
                                    return ng_append_node(nodes, NgAstNode(kind=7, start=name.start, end=name.end, left=expression, right=-1, operation=type_kind + mutable * 100))
                        1:
                            return -1
        1:
            return -1

fn ng_parse_statement(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, nodes: &mut vector<NgAstNode>) -> i64:
    mut token: NgToken = ng_token_at(tokens, cursor)
    mut name: NgToken = NgToken(kind=0, start=0, end=0)
    mut following: NgToken = NgToken(kind=0, start=0, end=0)
    mut expression: i64 = -1
    mut mutable: i64 = 0
    mut expression_node: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    match ng_token_spells(source, token, text_from_static("match")):
        -1:
            return ng_parse_match_statement(source, tokens, cursor, nodes, token)
        0:
            match ng_token_spells(source, token, text_from_static("return")):
                -1:
                    discard ng_advance(cursor)
                    expression = ng_parse_expression(source, tokens, cursor, nodes)
                    match expression <=> -1:
                        -1:
                            return -1
                        0:
                            return -1
                        1:
                            expression_node = vector_get<NgAstNode>(&*nodes, expression)
                            return ng_append_node(nodes, NgAstNode(kind=9, start=token.start, end=expression_node.end, left=expression, right=-1, operation=0))
                0:
                    match ng_token_spells(source, token, text_from_static("mut")):
                        -1:
                            mutable = 1
                            discard ng_advance(cursor)
                            name = ng_token_at(tokens, cursor)
                            match ng_expect_kind(tokens, cursor, 1):
                                -1:
                                    return -1
                                0:
                                    discard ng_advance(cursor)
                                    return ng_parse_declaration(source, tokens, cursor, nodes, name, mutable)
                                1:
                                    return -1
                        0:
                            match token.kind <=> 1:
                                -1:
                                    return -1
                                0:
                                    name = token
                                    discard ng_advance(cursor)
                                    following = ng_token_at(tokens, cursor)
                                    match following.kind == 358:
                                        -1:
                                            return ng_parse_declaration(source, tokens, cursor, nodes, name, 0)
                                        0:
                                            match following.kind == 361:
                                                -1:
                                                    discard ng_advance(cursor)
                                                    expression = ng_parse_expression(source, tokens, cursor, nodes)
                                                    match expression <=> -1:
                                                        -1:
                                                            return -1
                                                        0:
                                                            return -1
                                                        1:
                                                            return ng_append_node(nodes, NgAstNode(kind=8, start=name.start, end=name.end, left=expression, right=-1, operation=361))
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        1:
                                            return -1
                                1:
                                    return -1
                        1:
                            return -1
                1:
                    return -1
        1:
            return -1

fn ng_parse_block(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, nodes: &mut vector<NgAstNode>, parent_indent: i64) -> i64:
    mut token: NgToken = ng_token_at(tokens, cursor)
    mut block_indent: i64 = ng_token_indent(source, token)
    mut token_indent: i64 = 0
    mut statement_id: i64 = -1
    mut statement_ids: vector<i64> = vector_new<i64>(8)
    mut scanning: i64 = 1
    match block_indent <=> parent_indent:
        -1:
            return -1
        0:
            return -1
        1:
            while scanning == 1:
                token = ng_token_at(tokens, cursor)
                match token.kind > 0:
                    -1:
                        token_indent = ng_token_indent(source, token)
                        match token_indent < 0:
                            -1:
                                return -1
                            0:
                                token_indent = token_indent
                            1:
                                token_indent = token_indent
                        match token_indent < block_indent:
                            -1:
                                scanning = 0
                            0:
                                match token_indent < 0:
                                    -1:
                                        scanning = 0
                                    0:
                                        statement_id = ng_parse_statement(source, tokens, cursor, nodes)
                                        match statement_id <=> -1:
                                            -1:
                                                return -1
                                            0:
                                                return -1
                                            1:
                                                discard vector_push<i64>(&mut statement_ids, statement_id)
                                                token = ng_token_at(tokens, cursor)
                                                match token.kind > 0:
                                                    -1:
                                                        token_indent = ng_token_indent(source, token)
                                                        match token_indent > block_indent:
                                                            -1:
                                                                return -1
                                                            0:
                                                                scanning = 1
                                                            1:
                                                                return -1
                                                    0:
                                                        scanning = 0
                                                    1:
                                                        scanning = 0
                                    1:
                                        scanning = 0
                            1:
                                return -1
                    0:
                        scanning = 0
                    1:
                        scanning = 0
            match vector_len<i64>(&statement_ids) <=> 0:
                -1:
                    return -1
                0:
                    return -1
                1:
                    return ng_build_statement_links(&statement_ids, 0, nodes)

fn ng_build_match_arm_links(arm_ids: &vector<i64>, index: i64, nodes: &mut vector<NgAstNode>) -> i64:
    mut arm_id: i64 = -1
    mut arm: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut next: i64 = -1
    match index < vector_len<i64>(arm_ids):
        -1:
            next = ng_build_match_arm_links(arm_ids, index + 1, nodes)
            arm_id = vector_get<i64>(arm_ids, index)
            arm = vector_get<NgAstNode>(&*nodes, arm_id)
            return ng_append_node(nodes, NgAstNode(kind=13, start=arm.start, end=arm.end, left=arm.left, right=next, operation=arm.operation))
        0:
            return -1
        1:
            return -1

fn ng_parse_match_arm(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, nodes: &mut vector<NgAstNode>, arm_indent: i64) -> i64:
    mut label_token: NgToken = ng_token_at(tokens, cursor)
    mut digit_token: NgToken = NgToken(kind=0, start=0, end=0)
    mut label_start: i64 = label_token.start
    mut label_value: i64 = 0
    mut digit: i64 = 0
    mut body: i64 = -1
    mut body_link: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    match label_token.kind == 345:
        -1:
            label_start = label_token.start
            discard ng_advance(cursor)
            digit_token = ng_token_at(tokens, cursor)
            match digit_token.kind <=> 2:
                -1:
                    return -1
                0:
                    match digit_token.end - digit_token.start <=> 1:
                        -1:
                            return -1
                        0:
                            digit = to_i64(bytes_get(source, digit_token.start))
                            match digit <=> 49:
                                -1:
                                    return -1
                                0:
                                    label_value = -1
                                    discard ng_advance(cursor)
                                1:
                                    return -1
                        1:
                            return -1
                1:
                    return -1
        0:
            match label_token.kind <=> 2:
                -1:
                    return -1
                0:
                    match label_token.end - label_token.start <=> 1:
                        -1:
                            return -1
                        0:
                            digit = to_i64(bytes_get(source, label_token.start))
                            match digit <=> 48:
                                -1:
                                    return -1
                                0:
                                    label_value = 0
                                    discard ng_advance(cursor)
                                1:
                                    match digit <=> 49:
                                        -1:
                                            label_value = 1
                                            discard ng_advance(cursor)
                                        0:
                                            label_value = 1
                                            discard ng_advance(cursor)
                                        1:
                                            return -1
                        1:
                            return -1
                1:
                    return -1
        1:
            return -1
    match ng_expect_kind(tokens, cursor, 358):
        -1:
            return -1
        0:
            discard ng_advance(cursor)
            body = ng_parse_block(source, tokens, cursor, nodes, arm_indent)
            match body <=> -1:
                -1:
                    return -1
                0:
                    return -1
                1:
                    body_link = vector_get<NgAstNode>(&*nodes, body)
                    return ng_append_node(nodes, NgAstNode(kind=13, start=label_start, end=body_link.end, left=body, right=-1, operation=label_value))
        1:
            return -1

fn ng_parse_match_statement(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, nodes: &mut vector<NgAstNode>, start_token: NgToken) -> i64:
    mut selector: i64 = -1
    mut parent_indent: i64 = ng_token_indent(source, start_token)
    mut arm_indent: i64 = -1
    mut current_indent: i64 = 0
    mut arm_id: i64 = -1
    mut arm_head: i64 = -1
    mut arm_count: i64 = 0
    mut scanning: i64 = 1
    mut arm_ids: vector<i64> = vector_new<i64>(3)
    mut token: NgToken = NgToken(kind=0, start=0, end=0)
    mut last_arm: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    discard ng_advance(cursor)
    selector = ng_parse_expression(source, tokens, cursor, nodes)
    match selector <=> -1:
        -1:
            return -1
        0:
            return -1
        1:
            match ng_expect_kind(tokens, cursor, 358):
                -1:
                    return -1
                0:
                    discard ng_advance(cursor)
                1:
                    return -1
    while scanning == 1:
        token = ng_token_at(tokens, cursor)
        match token.kind > 0:
            -1:
                current_indent = ng_token_indent(source, token)
                match current_indent <=> parent_indent:
                    -1:
                        scanning = 0
                    0:
                        scanning = 0
                    1:
                        match arm_indent < 0:
                            -1:
                                arm_indent = current_indent
                            0:
                                match current_indent <=> arm_indent:
                                    -1:
                                        return -1
                                    0:
                                        arm_indent = arm_indent
                                    1:
                                        return -1
                            1:
                                arm_indent = current_indent
                        arm_id = ng_parse_match_arm(source, tokens, cursor, nodes, arm_indent)
                        match arm_id <=> -1:
                            -1:
                                return -1
                            0:
                                return -1
                            1:
                                discard vector_push<i64>(&mut arm_ids, arm_id)
                                arm_count = arm_count + 1
            0:
                scanning = 0
            1:
                scanning = 0
    match arm_count <=> 0:
        -1:
            return -1
        0:
            return -1
        1:
            arm_head = ng_build_match_arm_links(&arm_ids, 0, nodes)
            last_arm = vector_get<NgAstNode>(&*nodes, vector_get<i64>(&arm_ids, arm_count - 1))
            return ng_append_node(nodes, NgAstNode(kind=12, start=start_token.start, end=last_arm.end, left=selector, right=arm_head, operation=0))

fn ng_build_argument_nodes(argument_ids: &vector<i64>, index: i64, nodes: &mut vector<NgAstNode>) -> i64:
    mut argument_id: i64 = -1
    mut argument_node: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut next: i64 = -1
    match index < vector_len<i64>(argument_ids):
        -1:
            next = ng_build_argument_nodes(argument_ids, index + 1, nodes)
            argument_id = vector_get<i64>(argument_ids, index)
            argument_node = vector_get<NgAstNode>(&*nodes, argument_id)
            return ng_append_node(nodes, NgAstNode(kind=6, start=argument_node.start, end=argument_node.end, left=argument_id, right=next, operation=0))
        0:
            return -1
        1:
            return -1

fn ng_parse_group(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, nodes: &mut vector<NgAstNode>) -> i64:
    mut opening: NgToken = ng_token_at(tokens, cursor)
    mut closing: NgToken = NgToken(kind=0, start=0, end=0)
    mut nested: i64 = -1
    match ng_expect_kind(tokens, cursor, 340):
        -1:
            return -1
        0:
            discard ng_advance(cursor)
            nested = ng_parse_expression(source, tokens, cursor, nodes)
            match nested <=> -1:
                -1:
                    return -1
                0:
                    return -1
                1:
                    closing = ng_token_at(tokens, cursor)
                    match ng_expect_kind(tokens, cursor, 341):
                        -1:
                            return -1
                        0:
                            discard ng_advance(cursor)
                            return ng_append_node(nodes, NgAstNode(kind=3, start=opening.start, end=closing.end, left=nested, right=-1, operation=0))
                        1:
                            return -1
        1:
            return -1

fn ng_parse_call(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, nodes: &mut vector<NgAstNode>, name: NgToken) -> i64:
    mut argument_ids: vector<i64> = vector_new<i64>(8)
    mut argument_id: i64 = -1
    mut argument_node: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut token: NgToken = NgToken(kind=0, start=0, end=0)
    mut closing: NgToken = NgToken(kind=0, start=0, end=0)
    mut scanning: i64 = 1
    mut list_head: i64 = -1
    discard ng_advance(cursor)
    token = ng_token_at(tokens, cursor)
    match token.kind <=> 341:
        -1:
            scanning = 1
        0:
            discard ng_advance(cursor)
            scanning = 0
        1:
            scanning = 1
    while scanning == 1:
        argument_id = ng_parse_expression(source, tokens, cursor, nodes)
        match argument_id <=> -1:
            -1:
                return -1
            0:
                return -1
            1:
                discard vector_push<i64>(&mut argument_ids, argument_id)
                token = ng_token_at(tokens, cursor)
                match token.kind <=> 341:
                    -1:
                        return -1
                    0:
                        discard ng_advance(cursor)
                        scanning = 0
                    1:
                        match token.kind <=> 344:
                            -1:
                                return -1
                            0:
                                discard ng_advance(cursor)
                                token = ng_token_at(tokens, cursor)
                                match token.kind <=> 341:
                                    -1:
                                        scanning = 1
                                    0:
                                        return -1
                                    1:
                                        return -1
                            1:
                                return -1
    closing = vector_get<NgToken>(tokens, vector_get<i64>(&*cursor, 0) - 1)
    list_head = ng_build_argument_nodes(&argument_ids, 0, nodes)
    return ng_append_node(nodes, NgAstNode(kind=5, start=name.start, end=closing.end, left=list_head, right=-1, operation=name.end))

fn ng_parse_identifier_or_call(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, nodes: &mut vector<NgAstNode>, name: NgToken) -> i64:
    mut following: NgToken = NgToken(kind=0, start=0, end=0)
    discard ng_advance(cursor)
    following = ng_token_at(tokens, cursor)
    match following.kind <=> 340:
        -1:
            return ng_append_node(nodes, NgAstNode(kind=2, start=name.start, end=name.end, left=-1, right=-1, operation=0))
        0:
            return ng_parse_call(source, tokens, cursor, nodes, name)
        1:
            return ng_append_node(nodes, NgAstNode(kind=2, start=name.start, end=name.end, left=-1, right=-1, operation=0))

fn ng_parse_primary(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, nodes: &mut vector<NgAstNode>) -> i64:
    mut token: NgToken = ng_token_at(tokens, cursor)
    match token.kind <=> 2:
        -1:
            match token.kind <=> 1:
                -1:
                    return -1
                0:
                    return ng_parse_identifier_or_call(source, tokens, cursor, nodes, token)
                1:
                    return -1
        0:
            discard ng_advance(cursor)
            return ng_append_node(nodes, NgAstNode(kind=1, start=token.start, end=token.end, left=-1, right=-1, operation=0))
        1:
            return ng_parse_group(source, tokens, cursor, nodes)

fn ng_append_binary_node(nodes: &mut vector<NgAstNode>, left_id: i64, right_id: i64, operator_token: NgToken) -> i64:
    mut left_node: NgAstNode = vector_get<NgAstNode>(&*nodes, left_id)
    mut right_node: NgAstNode = vector_get<NgAstNode>(&*nodes, right_id)
    return ng_append_node(nodes, NgAstNode(kind=4, start=left_node.start, end=right_node.end, left=left_id, right=right_id, operation=operator_token.kind))

fn ng_parse_term_step(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, nodes: &mut vector<NgAstNode>, left_id: i64, operator_token: NgToken) -> i64:
    mut right_id: i64 = -1
    discard ng_advance(cursor)
    right_id = ng_parse_primary(source, tokens, cursor, nodes)
    match right_id <=> -1:
        -1:
            return -1
        0:
            return -1
        1:
            return ng_append_binary_node(nodes, left_id, right_id, operator_token)

fn ng_parse_term(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, nodes: &mut vector<NgAstNode>) -> i64:
    mut left_id: i64 = ng_parse_primary(source, tokens, cursor, nodes)
    mut operator_token: NgToken = NgToken(kind=0, start=0, end=0)
    mut next_left: i64 = -1
    mut scanning: i64 = 1
    match left_id <=> -1:
        -1:
            return -1
        0:
            return -1
        1:
            while scanning == 1:
                operator_token = ng_token_at(tokens, cursor)
                match operator_token.kind <=> 342:
                    -1:
                        scanning = 0
                    0:
                        next_left = ng_parse_term_step(source, tokens, cursor, nodes, left_id, operator_token)
                        match next_left <=> -1:
                            -1:
                                return -1
                            0:
                                return -1
                            1:
                                left_id = next_left
                    1:
                        match operator_token.kind <=> 347:
                            -1:
                                scanning = 0
                            0:
                                next_left = ng_parse_term_step(source, tokens, cursor, nodes, left_id, operator_token)
                                match next_left <=> -1:
                                    -1:
                                        return -1
                                    0:
                                        return -1
                                    1:
                                        left_id = next_left
                            1:
                                scanning = 0
            return left_id

fn ng_parse_expression_step(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, nodes: &mut vector<NgAstNode>, left_id: i64, operator_token: NgToken) -> i64:
    mut right_id: i64 = -1
    discard ng_advance(cursor)
    right_id = ng_parse_term(source, tokens, cursor, nodes)
    match right_id <=> -1:
        -1:
            return -1
        0:
            return -1
        1:
            return ng_append_binary_node(nodes, left_id, right_id, operator_token)

fn ng_parse_expression(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, nodes: &mut vector<NgAstNode>) -> i64:
    mut left_id: i64 = ng_parse_term(source, tokens, cursor, nodes)
    mut operator_token: NgToken = NgToken(kind=0, start=0, end=0)
    mut next_left: i64 = -1
    mut scanning: i64 = 1
    match left_id <=> -1:
        -1:
            return -1
        0:
            return -1
        1:
            while scanning == 1:
                operator_token = ng_token_at(tokens, cursor)
                match operator_token.kind <=> 343:
                    -1:
                        scanning = 0
                    0:
                        next_left = ng_parse_expression_step(source, tokens, cursor, nodes, left_id, operator_token)
                        match next_left <=> -1:
                            -1:
                                return -1
                            0:
                                return -1
                            1:
                                left_id = next_left
                    1:
                        match operator_token.kind <=> 345:
                            -1:
                                scanning = 0
                            0:
                                next_left = ng_parse_expression_step(source, tokens, cursor, nodes, left_id, operator_token)
                                match next_left <=> -1:
                                    -1:
                                        return -1
                                    0:
                                        return -1
                                    1:
                                        left_id = next_left
                            1:
                                scanning = 0
            return left_id

fn ng_parse_parameter(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, parameters: &mut vector<NgParameter>) -> i64:
    mut name: NgToken = ng_token_at(tokens, cursor)
    mut type_kind: i64 = 0
    match ng_expect_kind(tokens, cursor, 1):
        -1:
            return -1
        0:
            discard ng_advance(cursor)
        1:
            return -1
    name = vector_get<NgToken>(tokens, vector_get<i64>(&*cursor, 0) - 1)
    match ng_expect_kind(tokens, cursor, 358):
        -1:
            return -1
        0:
            discard ng_advance(cursor)
            type_kind = ng_parse_type(source, tokens, cursor)
            match type_kind <=> -1:
                -1:
                    return -1
                0:
                    return -1
                1:
                    discard vector_push<NgParameter>(parameters, NgParameter(name_start=name.start, name_end=name.end, type_kind=type_kind))
                    return 0
        1:
            return -1

fn ng_parse_parameters(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, parameters: &mut vector<NgParameter>) -> trit:
    mut token: NgToken = ng_token_at(tokens, cursor)
    mut status: i64 = 0
    while token.kind != 341:
        status = ng_parse_parameter(source, tokens, cursor, parameters)
        match status <=> -1:
            -1:
                return -1
            0:
                return -1
            1:
                token = ng_token_at(tokens, cursor)
                match token.kind <=> 344:
                    -1:
                        return 0
                    0:
                        discard ng_advance(cursor)
                        token = ng_token_at(tokens, cursor)
                    1:
                        return 0
    return 0

fn ng_parse_function(source: &bytes, tokens: &vector<NgToken>, cursor: &mut vector<i64>, parameters: &mut vector<NgParameter>, nodes: &mut vector<NgAstNode>, functions: &mut vector<NgFunction>) -> i64:
    mut start: NgToken = ng_token_at(tokens, cursor)
    mut name: NgToken = NgToken(kind=0, start=0, end=0)
    mut first_parameter: i64 = 0
    mut parameter_count: i64 = 0
    mut return_type: i64 = 0
    mut body_node: i64 = -1
    mut body: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut last_body_token: NgToken = NgToken(kind=0, start=0, end=0)
    match ng_expect_word(source, tokens, cursor, text_from_static("fn")):
        -1:
            return -1
        0:
            name = ng_token_at(tokens, cursor)
            match ng_expect_kind(tokens, cursor, 1):
                -1:
                    return -1
                0:
                    discard ng_advance(cursor)
                1:
                    return -1
            match ng_expect_kind(tokens, cursor, 340):
                -1:
                    return -1
                0:
                    discard ng_advance(cursor)
                1:
                    return -1
            first_parameter = vector_len<NgParameter>(&*parameters)
            match ng_parse_parameters(source, tokens, cursor, parameters):
                -1:
                    return -1
                0:
                    parameter_count = vector_len<NgParameter>(&*parameters) - first_parameter
                1:
                    return -1
            match ng_expect_kind(tokens, cursor, 341):
                -1:
                    return -1
                0:
                    discard ng_advance(cursor)
                1:
                    return -1
            match ng_expect_kind(tokens, cursor, 201):
                -1:
                    return -1
                0:
                    discard ng_advance(cursor)
                1:
                    return -1
            return_type = ng_parse_type(source, tokens, cursor)
            match return_type <=> -1:
                -1:
                    return -1
                0:
                    return -1
                1:
                    match ng_expect_kind(tokens, cursor, 358):
                        -1:
                            return -1
                        0:
                            discard ng_advance(cursor)
                            body_node = ng_parse_block(source, tokens, cursor, nodes, ng_token_indent(source, start))
                            match body_node <=> -1:
                                -1:
                                    return -1
                                0:
                                    return -1
                                1:
                                    body = vector_get<NgAstNode>(&*nodes, body_node)
                                    last_body_token = vector_get<NgToken>(tokens, vector_get<i64>(&*cursor, 0) - 1)
                                    discard vector_push<NgFunction>(functions, NgFunction(start=start.start, end=last_body_token.end, name_start=name.start, name_end=name.end, first_parameter=first_parameter, parameter_count=parameter_count, return_type=return_type, body_node=body_node))
                                    return 0
                        1:
                            return -1
        1:
            return -1

export fn ng_parse_program(source: &bytes, tokens: &vector<NgToken>, functions: &mut vector<NgFunction>, parameters: &mut vector<NgParameter>, nodes: &mut vector<NgAstNode>) -> i64:
    mut cursor: vector<i64> = vector_new<i64>(1)
    mut current: NgToken = NgToken(kind=0, start=0, end=0)
    mut status: i64 = 0
    mut scanning: i64 = 1
    discard vector_push<i64>(&mut cursor, 0)
    while scanning == 1:
        current = ng_token_at(tokens, &mut cursor)
        match current.kind <=> 0:
            -1:
                return -1
            0:
                scanning = 0
            1:
                status = ng_parse_function(source, tokens, &mut cursor, parameters, nodes, functions)
                match status <=> 0:
                    -1:
                        return -1
                    0:
                        status = 0
                    1:
                        return -1
    match vector_len<NgFunction>(&*functions) <=> 0:
        -1:
            return -1
        0:
            return -1
        1:
            return 0
