                        1:
                            return -12
                1:
                    return -12
        -1:
            return -14
        1:
            match expression.kind <=> 3:
                0:
                    return ng_address_value_type(source, functions, parameters, nodes, function, address, expression.left)
                -1:
                    return -14
                1:
                    match expression.kind <=> 5:
                        0:
                            while function_index < vector_len<NgFunction>(functions):
                                candidate = vector_get<NgFunction>(functions, function_index)
                                match candidate.name_start <=> expression.start:
                                    0:
                                        match candidate.name_end <=> expression.operation:
                                            0:
                                                return candidate.return_type
                                            -1:
                                                function_index = function_index + 1
                                            1:
                                                function_index = function_index + 1
                                    -1:
                                        function_index = function_index + 1
                                    1:
                                        function_index = function_index + 1
                            return -14
                        -1:
                            return -14
                        1:
                            match expression.kind <=> 14:
                                0:
                                    match expression.right > 0:
                                        -1:
                                            return expression.right
                                        0:
                                            return -14
                                        1:
                                            return -14
                                -1:
                                    return -14
                                1:
                                    match expression.kind <=> 18:
                                        0:
                                            match expression.right > 0:
                                                -1:
                                                    return expression.right
                                                0:
                                                    return -14
                                                1:
                                                    return -14
                                        -1:
                                            return -14
                                        1:
                                            match expression.kind <=> 19:
                                                0:
                                                    match expression.right > 0:
                                                        -1:
