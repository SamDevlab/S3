    return 0

fn ng_prior_local_declaration(source: &bytes, nodes: &vector<NgAstNode>, function: NgFunction, before_node: NgAstNode, target: NgAstNode) -> i64:
    mut index: i64 = function.body_node
    mut best_index: i64 = -1
    mut best_start: i64 = -1
    mut declaration: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    while index >= function.first_node:
        declaration = vector_get<NgAstNode>(nodes, index)
        match declaration.kind <=> 7:
            0:
                match declaration.start >= function.start:
                    -1:
                        match declaration.end <= function.end:
                            -1:
                                match declaration.start < before_node.start:
                                    -1:
                                        match ng_spans_equal(source, declaration.start, declaration.end, target.start, target.end):
                                            -1:
                                                match declaration.start > best_start:
                                                    -1:
                                                        best_index = index
                                                        best_start = declaration.start
                                                    0:
                                                        best_index = best_index
                                                    1:
                                                        best_index = best_index
                                            0:
                                                best_index = best_index
                                            1:
                                                best_index = best_index
                                    0:
                                        best_index = best_index
                                    1:
                                        best_index = best_index
                            0:
                                best_index = best_index
                            1:
                                best_index = best_index
                    0:
                        best_index = best_index
                    1:
                        best_index = best_index
            -1:
                best_index = best_index
            1:
                best_index = best_index
        index = index - 1
    return best_index

fn ng_address_value_type(source: &bytes, functions: &vector<NgFunction>, parameters: &vector<NgParameter>, nodes: &vector<NgAstNode>, function: NgFunction, address: NgAstNode, expression_id: i64) -> i64:
    mut expression: NgAstNode = vector_get<NgAstNode>(nodes, expression_id)
    mut declaration_index: i64 = -1
    mut declaration: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut parameter_type: i64 = -12
    mut function_index: i64 = 0
    mut candidate: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, local_name_start=0, local_name_end=0, first_parameter=0, parameter_count=0, return_type=0, first_node=0, body_node=0, module_index=0, exported=0)
    match expression.kind <=> 2:
        0:
            parameter_type = ng_parameter_type(source, parameters, function.first_parameter, function.parameter_count, expression.start, expression.end)
            match parameter_type > 0:
                -1:
