module selfhost.compiler_ng.semantic

from selfhost.compiler_ng.parser import NgAstNode, NgFunction, NgParameter

export fn ng_spans_equal(source: &bytes, left_start: i64, left_end: i64, right_start: i64, right_end: i64) -> trit:
    mut left: i64 = left_start
    mut right: i64 = right_start
    match left_end - left_start <=> right_end - right_start:
        -1:
            return 0
        0:
            while left < left_end:
                match to_i64(bytes_get(source, left)) <=> to_i64(bytes_get(source, right)):
                    -1:
                        return 0
                    0:
                        left = left + 1
                        right = right + 1
                    1:
                        return 0
            return -1
        1:
            return 0

fn ng_parameter_type(source: &bytes, parameters: &vector<NgParameter>, first_parameter: i64, parameter_count: i64, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = first_parameter
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    while index < first_parameter + parameter_count:
        parameter = vector_get<NgParameter>(parameters, index)
        match ng_spans_equal(source, name_start, name_end, parameter.name_start, parameter.name_end):
            -1:
                return parameter.type_kind
            0:
                index = index + 1
            1:
                index = index + 1
    return -12

fn ng_supported_i64_binary(operation: i64) -> trit:
    match operation == 342:
        -1:
            return -1
        0:
            match operation == 343:
                -1:
                    return -1
                0:
                    match operation == 345:
                        -1:
                            return -1
                        0:
                            match operation == 347:
                                -1:
                                    return -1
                                0:
                                    return 0
                                1:
                                    return 0
                        1:
                            return 0
                1:
                    return 0
        1:
            return 0

export fn ng_find_function(source: &bytes, functions: &vector<NgFunction>, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = 0
    mut function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0)
    while index < vector_len<NgFunction>(functions):
        function = vector_get<NgFunction>(functions, index)
        match ng_spans_equal(source, name_start, name_end, function.name_start, function.name_end):
            -1:
                return index
            0:
                index = index + 1
            1:
                index = index + 1
    return -13

fn ng_call_type(source: &bytes, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, caller_first_parameter: i64, caller_parameter_count: i64, call_node: NgAstNode) -> i64:
    mut callee_index: i64 = ng_find_function(source, functions, call_node.start, call_node.operation)
    mut callee: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0)
    mut argument_list: i64 = call_node.left
    mut argument: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut argument_type: i64 = 0
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    mut argument_index: i64 = 0
    match callee_index < 0:
        -1:
            return -13
        0:
            callee = vector_get<NgFunction>(functions, callee_index)
        1:
            return -13
    while argument_list >= 0:
        match argument_index <=> callee.parameter_count:
            -1:
                argument = vector_get<NgAstNode>(nodes, argument_list)
                match argument.kind <=> 6:
                    -1:
                        return -14
                    0:
                        argument_type = ng_expression_type(source, functions, nodes, parameters, caller_first_parameter, caller_parameter_count, argument.left)
                        match argument_type <=> 0:
                            -1:
                                return argument_type
                            0:
                                return -14
                            1:
                                parameter = vector_get<NgParameter>(parameters, callee.first_parameter + argument_index)
                                match argument_type <=> parameter.type_kind:
                                    -1:
                                        return -14
                                    0:
                                        argument_list = argument.right
                                        argument_index = argument_index + 1
                                    1:
                                        return -14
                    1:
                        return -14
            0:
                return -14
            1:
                return -14
    match argument_index <=> callee.parameter_count:
        -1:
            return -14
        0:
            return callee.return_type
        1:
            return -14

fn ng_expression_type(source: &bytes, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, first_parameter: i64, parameter_count: i64, node_id: i64) -> i64:
    mut node: NgAstNode = vector_get<NgAstNode>(nodes, node_id)
    mut left_type: i64 = 0
    mut right_type: i64 = 0
    match node.kind <=> 1:
        -1:
            return -11
        0:
            return 1
        1:
            match node.kind <=> 2:
                -1:
                    return -11
                0:
                    return ng_parameter_type(source, parameters, first_parameter, parameter_count, node.start, node.end)
                1:
                    match node.kind <=> 3:
                        -1:
                            return -11
                        0:
                            return ng_expression_type(source, functions, nodes, parameters, first_parameter, parameter_count, node.left)
                        1:
                            match node.kind <=> 4:
                                -1:
                                    return -11
                                0:
                                    left_type = ng_expression_type(source, functions, nodes, parameters, first_parameter, parameter_count, node.left)
                                    match left_type <=> 0:
                                        -1:
                                            return left_type
                                        0:
                                            return -14
                                        1:
                                            match left_type <=> 1:
                                                -1:
                                                    return -14
                                                0:
                                                    right_type = ng_expression_type(source, functions, nodes, parameters, first_parameter, parameter_count, node.right)
                                                    match right_type <=> 0:
                                                        -1:
                                                            return right_type
                                                        0:
                                                            return -14
                                                        1:
                                                            match right_type <=> 1:
                                                                -1:
                                                                    return -14
                                                                0:
                                                                    match ng_supported_i64_binary(node.operation):
                                                                        -1:
                                                                            return 1
                                                                        0:
                                                                            return -14
                                                                        1:
                                                                            return -14
                                                                1:
                                                                    return -14
                                                1:
                                                    return -14
                                1:
                                    match node.kind <=> 5:
                                        -1:
                                            return -11
                                        0:
                                            return ng_call_type(source, functions, nodes, parameters, first_parameter, parameter_count, node)
                                        1:
                                            return -11

export fn ng_check_program(source: &bytes, functions: &vector<NgFunction>, parameters: &vector<NgParameter>, nodes: &vector<NgAstNode>) -> i64:
    mut function_index: i64 = 0
    mut prior_function_index: i64 = 0
    mut parameter_index: i64 = 0
    mut prior_parameter_index: i64 = 0
    mut function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0)
    mut prior_function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0)
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    mut prior_parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    mut body_type: i64 = 0
    while function_index < vector_len<NgFunction>(functions):
        function = vector_get<NgFunction>(functions, function_index)
        prior_function_index = 0
        while prior_function_index < function_index:
            prior_function = vector_get<NgFunction>(functions, prior_function_index)
            match ng_spans_equal(source, function.name_start, function.name_end, prior_function.name_start, prior_function.name_end):
                -1:
                    return -10
                0:
                    prior_function_index = prior_function_index + 1
                1:
                    prior_function_index = prior_function_index + 1
        parameter_index = function.first_parameter
        while parameter_index < function.first_parameter + function.parameter_count:
            parameter = vector_get<NgParameter>(parameters, parameter_index)
            prior_parameter_index = function.first_parameter
            while prior_parameter_index < parameter_index:
                prior_parameter = vector_get<NgParameter>(parameters, prior_parameter_index)
                match ng_spans_equal(source, parameter.name_start, parameter.name_end, prior_parameter.name_start, prior_parameter.name_end):
                    -1:
                        return -11
                    0:
                        prior_parameter_index = prior_parameter_index + 1
                    1:
                        prior_parameter_index = prior_parameter_index + 1
            parameter_index = parameter_index + 1
        body_type = ng_expression_type(source, functions, nodes, parameters, function.first_parameter, function.parameter_count, function.body_node)
        match body_type <=> 0:
            -1:
                return body_type
            0:
                return -15
            1:
                match body_type <=> function.return_type:
                    -1:
                        return -15
                    0:
                        function_index = function_index + 1
                    1:
                        return -15
    return 0
