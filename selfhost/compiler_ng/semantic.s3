                                            -1:
                                                return -14
                                            1:
                                                return -14
                                    1:
                                        return -14
                            0:
                                return -12
                            1:
                                return -12
                    0:
                        node_index = node_index
                    1:
                        return -14
            -1:
                node_index = node_index
            1:
                node_index = node_index
        node_index = node_index + 1
    return 0

export fn ng_resolve_address_nodes(source: &bytes, types: &mut vector<NgTypeDescriptor>, functions: &vector<NgFunction>, parameters: &vector<NgParameter>, nodes: &mut vector<NgAstNode>) -> i64:
    mut declaration_indices: vector<i64> = vector_new<i64>(vector_len<NgAstNode>(&*nodes))
    mut node_scope_ids: vector<i64> = vector_new<i64>(vector_len<NgAstNode>(&*nodes))
    mut scope_parents: vector<i64> = vector_new<i64>(vector_len<NgAstNode>(&*nodes) + vector_len<NgFunction>(functions) + 1)
    mut local_symbols: vector<NgLocalLookupSymbol> = vector_new<NgLocalLookupSymbol>(vector_len<NgAstNode>(&*nodes))
    mut local_buckets: vector<i64> = vector_new<i64>(vector_len<NgAstNode>(&*nodes) * 2 + 1)
    mut local_offsets: vector<i64> = vector_new<i64>(vector_len<NgAstNode>(&*nodes) + 1)
    mut local_occurrences: vector<i64> = vector_new<i64>(vector_len<NgAstNode>(&*nodes))
    mut status: i64 = ng_build_resolution_context(source, functions, &*nodes, &mut declaration_indices, &mut node_scope_ids, &mut scope_parents, &mut local_symbols, &mut local_buckets, &mut local_offsets, &mut local_occurrences)
    match status <=> 0:
        -1:
            return status
        0:
            return ng_resolve_address_nodes_indexed(source, types, functions, parameters, nodes, &declaration_indices, &node_scope_ids, &scope_parents, &mut local_symbols, &mut local_buckets, &mut local_offsets, &mut local_occurrences)
        1:
            return status

export fn ng_resolve_semantic_nodes(source: &bytes, types: &mut vector<NgTypeDescriptor>, records: &vector<NgRecord>, fields: &vector<NgField>, functions: &vector<NgFunction>, parameters: &vector<NgParameter>, nodes: &mut vector<NgAstNode>) -> i64:
    mut declaration_indices: vector<i64> = vector_new<i64>(vector_len<NgAstNode>(&*nodes))
    mut node_scope_ids: vector<i64> = vector_new<i64>(vector_len<NgAstNode>(&*nodes))
    mut scope_parents: vector<i64> = vector_new<i64>(vector_len<NgAstNode>(&*nodes) + vector_len<NgFunction>(functions) + 1)
    mut local_symbols: vector<NgLocalLookupSymbol> = vector_new<NgLocalLookupSymbol>(vector_len<NgAstNode>(&*nodes))
    mut local_buckets: vector<i64> = vector_new<i64>(vector_len<NgAstNode>(&*nodes) * 2 + 1)
    mut local_offsets: vector<i64> = vector_new<i64>(vector_len<NgAstNode>(&*nodes) + 1)
    mut local_occurrences: vector<i64> = vector_new<i64>(vector_len<NgAstNode>(&*nodes))
    mut status: i64 = ng_build_resolution_context(source, functions, &*nodes, &mut declaration_indices, &mut node_scope_ids, &mut scope_parents, &mut local_symbols, &mut local_buckets, &mut local_offsets, &mut local_occurrences)
    match status <=> 0:
        -1:
            return status
        0:
            status = ng_resolve_record_field_nodes_indexed(source, &*types, records, fields, functions, parameters, nodes, &declaration_indices, &node_scope_ids, &scope_parents, &mut local_symbols, &mut local_buckets, &mut local_offsets, &mut local_occurrences)
            match status <=> 0:
                -1:
                    return status
                0:
                    return ng_resolve_address_nodes_indexed(source, types, functions, parameters, nodes, &declaration_indices, &node_scope_ids, &scope_parents, &mut local_symbols, &mut local_buckets, &mut local_offsets, &mut local_occurrences)
                1:
                    return status
        1:
            return status

fn ng_assignment_root_node(nodes: &vector<NgAstNode>, target_node_id: i64) -> i64:
    mut current: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    match target_node_id >= 0:
        -1:
            match target_node_id < vector_len<NgAstNode>(nodes):
                -1:
                    current = vector_get<NgAstNode>(nodes, target_node_id)
                    match current.kind <=> 14:
                        0:
                            return ng_assignment_root_node(nodes, current.left)
                        -1:
                            match current.kind <=> 2:
                                0:
                                    return target_node_id
                                -1:
                                    return -1
                                1:
                                    return -1
                        1:
                            match current.kind <=> 2:
                                0:
                                    return target_node_id
                                -1:
                                    return -1
                                1:
                                    return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn ng_check_assignment(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, function: NgFunction, statement: NgAstNode) -> i64:
    mut root_id: i64 = -1
    mut root: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut target_type: i64 = -1
    mut local_id: i64 = -1
    mut local_binding: NgLocal = NgLocal(name_start=0, name_end=0, type_kind=0, mutable=0)
    mut value_type: i64 = -1
    match statement.right >= 0:
        -1:
            root = vector_get<NgAstNode>(nodes, statement.right)
            match root.kind <=> 14:
                0:
                    root_id = ng_assignment_root_node(nodes, statement.right)
                    match root_id >= 0:
                        -1:
                            root = vector_get<NgAstNode>(nodes, root_id)
                            local_id = ng_local_index(source, locals, root.start, root.end)
                        0:
                            return -12
                        1:
                            return -12
                -1:
                    return -16
                1:
                    return -16
        0:
            local_id = ng_local_index(source, locals, statement.start, statement.end)
        1:
            return -16
    match local_id >= 0:
        -1:
            local_binding = vector_get<NgLocal>(locals, local_id)
            match local_binding.mutable <=> 1:
                -1:
                    return -16
                0:
                    match statement.right >= 0:
                        -1:
                            target_type = ng_expression_type(source, types, fields, functions, nodes, parameters, locals, function.first_parameter, function.parameter_count, statement.right)
                            match target_type >= 0:
                                -1:
                                    value_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, locals, function.first_parameter, function.parameter_count, statement.left, target_type)
                                    match value_type <=> target_type:
                                        0:
                                            return 0
                                        -1:
                                            return -14
                                        1:
                                            return -14
                                0:
                                    return target_type
                                1:
                                    return target_type
                        0:
                            value_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, locals, function.first_parameter, function.parameter_count, statement.left, local_binding.type_kind)
                            match value_type <=> local_binding.type_kind:
                                0:
                                    return 0
                                -1:
                                    return -14
                                1:
                                    return -14
                        1:
                            return -16
                1:
                    return -16
        0:
            return -12
        1:
            return -12

fn ng_check_control_statement(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, function: NgFunction, link: NgAstNode, statement: NgAstNode, loop_depth: i64) -> i64:
    mut value_type: i64 = 0
    mut nested_flow: i64 = 0
    mut status: i64 = 0
    match statement.kind == 8:
        -1:
            status = ng_check_assignment(source, types, fields, functions, nodes, parameters, locals, function, statement)
            match status <=> 0:
                0:
                    return 1
                -1:
                    return status
                1:
                    return status
        0:
            match statement.kind == 9:
                -1:
                    value_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, locals, function.first_parameter, function.parameter_count, statement.left, function.return_type)
                    match ng_type_equal(source, types, value_type, function.return_type) <=> -1:
                        -1:
                            return -15
                        0:
                            match link.right <=> -1:
                                0:
                                    return 0
                                -1:
                                    return -17
                                1:
                                    return -17
                        1:
                            return -15
                0:
                    match statement.kind == 12:
                        -1:
                            nested_flow = ng_check_match_arms(source, types, fields, functions, nodes, parameters, locals, function, statement, loop_depth)
                            match nested_flow < 0:
                                -1:
                                    return nested_flow
                                0:
                                    match nested_flow <=> 0:
                                        -1:
                                            return nested_flow
                                        0:
                                            match link.right <=> -1:
                                                0:
                                                    return 0
                                                -1:
                                                    return -17
                                                1:
                                                    return -17
                                        1:
                                            match nested_flow <=> 2:
                                                -1:
                                                    return 1
                                                0:
                                                    match link.right <=> -1:
                                                        0:
                                                            return 2
                                                        -1:
                                                            return -17
                                                        1:
                                                            return -17
                                                1:
                                                    return -16
                                1:
                                    return -16
                        0:
                            match statement.kind == 15:
                                -1:
                                    value_type = ng_expression_type(source, types, fields, functions, nodes, parameters, locals, function.first_parameter, function.parameter_count, statement.left)
                                    match value_type < 0:
                                        -1:
                                            return value_type
                                        0:
                                            return 1
                                        1:
                                            return 1
                                0:
                                    match statement.kind == 17:
                                        -1:
                                            value_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, locals, function.first_parameter, function.parameter_count, statement.left, 2)
                                            match value_type <=> 2:
                                                -1:
                                                    return -14
                                                0:
                                                    nested_flow = ng_check_control_body(source, types, fields, functions, nodes, parameters, locals, function, statement.right, loop_depth + 1)
                                                    match nested_flow < 0:
                                                        -1:
                                                            return nested_flow
                                                        0:
                                                            return 1
                                                        1:
                                                            return 1
                                                1:
                                                    return -14
                                        0:
                                            return -16
                                        1:
                                            return -16
                                1:
                                    return -16
                        1:
                            return -16
                1:
                    return -16
        1:
            return -16

fn ng_check_control_body(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, function: NgFunction, body_head: i64, loop_depth: i64) -> i64:
    mut scoped_locals: vector<NgLocal> = vector_new<NgLocal>(function.end - function.start + vector_len<NgLocal>(locals) + 1)
    mut inherited_index: i64 = 0
    mut local_scope_start: i64 = vector_len<NgLocal>(locals)
    mut link_id: i64 = body_head
    mut link: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut statement: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut local_id: i64 = -1
    mut declared_type: i64 = 0
    mut mutable: i64 = 0
    mut parameter_type: i64 = 0
    mut value_type: i64 = 0
    mut status: i64 = 0
    while inherited_index < local_scope_start:
        discard vector_push<NgLocal>(&mut scoped_locals, vector_get<NgLocal>(locals, inherited_index))
        inherited_index = inherited_index + 1
    while link_id >= 0:
        link = vector_get<NgAstNode>(nodes, link_id)
        match link.kind <=> 11:
            -1:
                return -16
            0:
                statement = vector_get<NgAstNode>(nodes, link.left)
                match statement.kind <=> 21:
                    0:
                        match loop_depth > 0:
                            -1:
                                match link.right <=> -1:
                                    0:
                                        return 2
                                    -1:
                                        return -17
                                    1:
                                        return -17
                            0:
                                return -16
                            1:
                                return -16
                    -1:
                        statement = statement
                    1:
                        statement = statement
                match statement.kind == 7:
                    -1:
                        declared_type = statement.operation
                        mutable = 0
                        match declared_type < 0:
                            -1:
                                declared_type = 0 - declared_type
                                mutable = 1
                            0:
                                mutable = 0
                            1:
                                mutable = 0
                        parameter_type = ng_parameter_type(source, parameters, function.first_parameter, function.parameter_count, statement.start, statement.end)
                        local_id = ng_local_index_from(source, &scoped_locals, local_scope_start, statement.start, statement.end)
                        match parameter_type >= 0:
                            -1:
                                return -11
                            0:
                                match local_id >= 0:
                                    -1:
                                        return -11
                                    0:
                                        value_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, &scoped_locals, function.first_parameter, function.parameter_count, statement.left, declared_type)
                                        match ng_type_equal(source, types, value_type, declared_type) <=> -1:
                                            -1:
                                                return -14
                                            0:
                                                discard vector_push<NgLocal>(&mut scoped_locals, NgLocal(name_start=statement.start, name_end=statement.end, type_kind=declared_type, mutable=mutable))
                                            1:
                                                return -14
                                    1:
                                        return -11
                            1:
                                return -11
                    0:
                        status = ng_check_control_statement(source, types, fields, functions, nodes, parameters, &scoped_locals, function, link, statement, loop_depth)
                        match status < 0:
                            -1:
                                return status
                            0:
                                match status <=> 0:
                                    -1:
                                        return status
                                    0:
                                        return 0
                                    1:
                                        match status <=> 2:
                                            -1:
                                                status = status
                                            0:
                                                return 2
                                            1:
                                                return -16
                            1:
                                return -16
                    1:
                        return -16
            1:
                return -16
        link_id = link.right
    return 1

fn ng_check_match_arms(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, function: NgFunction, statement: NgAstNode, loop_depth: i64) -> i64:
    mut selector_type: i64 = ng_expression_type(source, types, fields, functions, nodes, parameters, locals, function.first_parameter, function.parameter_count, statement.left)
    mut arm_id: i64 = statement.right
    mut arm: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut body_returned: i64 = 0
    mut has_fallthrough: i64 = 0
    mut seen_negative: i64 = 0
    mut seen_neutral: i64 = 0
    mut seen_positive: i64 = 0
    mut has_break: i64 = 0
    match selector_type <=> 2:
        -1:
            return -14
        0:
            selector_type = selector_type
        1:
            return -14
    while arm_id >= 0:
        arm = vector_get<NgAstNode>(nodes, arm_id)
        match arm.kind <=> 13:
            -1:
                return -16
            0:
                match arm.operation <=> -1:
                    -1:
                        match seen_negative <=> 0:
                            -1:
                                return -18
                            0:
                                seen_negative = 1
                            1:
                                return -18
                    0:
                        match arm.operation <=> 0:
                            -1:
                                match seen_negative <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_negative = 1
                                    1:
                                        return -18
                            0:
                                match seen_neutral <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_neutral = 1
                                    1:
                                        return -18
                            1:
                                match seen_positive <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_positive = 1
                                    1:
                                        return -18
                    1:
                        match arm.operation <=> 0:
                            -1:
                                match seen_negative <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_negative = 1
                                    1:
                                        return -18
                            0:
                                match seen_neutral <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_neutral = 1
                                    1:
                                        return -18
                            1:
                                match seen_positive <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_positive = 1
                                    1:
                                        return -18
                body_returned = ng_check_control_body(source, types, fields, functions, nodes, parameters, locals, function, arm.left, loop_depth)
                match body_returned < 0:
                    -1:
                        return body_returned
                    0:
                        match body_returned <=> 0:
                            -1:
                                return -16
                            0:
                                body_returned = body_returned
                            1:
                                match body_returned <=> 2:
                                    -1:
                                        has_fallthrough = 1
                                    0:
                                        has_break = 1
                                    1:
                                        return -16
                    1:
                        return -16
            1:
                return -16
        arm_id = arm.right
    match seen_negative == 1:
        -1:
            match seen_neutral == 1:
                -1:
                    match seen_positive == 1:
                        -1:
                            match has_fallthrough == 1:
                                -1:
                                    return 1
                                0:
                                    match has_break == 1:
                                        -1:
                                            return 2
                                        0:
                                            return 0
                                        1:
                                            return -16
                                1:
                                    return -16
                        0:
                            return -18
                        1:
                            return -18
                0:
                    return -18
                1:
                    return -18
        0:
            return -18
        1:
            return -18

fn ng_check_function_body(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, function: NgFunction) -> i64:
    mut locals: vector<NgLocal> = vector_new<NgLocal>(function.end - function.start + 1)
    mut link_id: i64 = function.body_node
    mut link: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut statement: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut local_binding: NgLocal = NgLocal(name_start=0, name_end=0, type_kind=0, mutable=0)
    mut parameter_type: i64 = 0
    mut local_id: i64 = -1
    mut declared_type: i64 = 0
    mut mutable: i64 = 0
    mut value_type: i64 = 0
    mut saw_return: i64 = 0
    mut status: i64 = 0
    while link_id >= 0:
        link = vector_get<NgAstNode>(nodes, link_id)
        match link.kind <=> 11:
            -1:
                return -16
            0:
                statement = vector_get<NgAstNode>(nodes, link.left)
                match statement.kind == 7:
                    -1:
                        declared_type = statement.operation
                        mutable = 0
                        match declared_type < 0:
                            -1:
                                declared_type = 0 - declared_type
                                mutable = 1
                            0:
                                mutable = 0
                            1:
                                mutable = 0
                        parameter_type = ng_parameter_type(source, parameters, function.first_parameter, function.parameter_count, statement.start, statement.end)
                        local_id = ng_local_index(source, &locals, statement.start, statement.end)
                        match parameter_type >= 0:
                            -1:
                                return -11
                            0:
                                match local_id >= 0:
                                    -1:
                                        return -11
                                    0:
                                        value_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, &locals, function.first_parameter, function.parameter_count, statement.left, declared_type)
                                        match ng_type_equal(source, types, value_type, declared_type) <=> -1:
                                            -1:
                                                return -14
                                            0:
                                                discard vector_push<NgLocal>(&mut locals, NgLocal(name_start=statement.start, name_end=statement.end, type_kind=declared_type, mutable=mutable))
                                            1:
                                                return -14
                                    1:
                                        return -11
                            1:
                                return -11
                    0:
                        match statement.kind == 8:
                            -1:
                                status = ng_check_assignment(source, types, fields, functions, nodes, parameters, &locals, function, statement)
                                match status <=> 0:
                                    0:
                                        status = status
                                    -1:
                                        return status
                                    1:
                                        return status
                            0:
                                match statement.kind == 9:
                                    -1:
                                        value_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, &locals, function.first_parameter, function.parameter_count, statement.left, function.return_type)
                                        match value_type < 0:
                                            -1:
                                                return value_type
                                            0:
                                                match ng_type_equal(source, types, value_type, function.return_type) <=> -1:
                                                    -1:
                                                        return -15
                                                    0:
                                                        saw_return = 1
                                                        match link.right >= 0:
                                                            -1:
                                                                return -17
                                                            0:
                                                                link_id = link.right
                                                            1:
                                                                link_id = link.right
                                                    1:
                                                        return -15
                                            1:
                                                return -15
                                    0:
                                        match statement.kind == 12:
                                            -1:
                                                value_type = ng_check_match_arms(source, types, fields, functions, nodes, parameters, &locals, function, statement, 0)
                                                match value_type <=> 0:
                                                    -1:
                                                        return value_type
                                                    0:
                                                        match link.right <=> -1:
                                                            -1:
                                                                return -17
                                                            0:
                                                                saw_return = 1
                                                                link_id = link.right
                                                            1:
                                                                return -17
                                                    1:
                                                        link_id = link.right
                                            0:
                                                match statement.kind == 15:
                                                    -1:
                                                        value_type = ng_expression_type(source, types, fields, functions, nodes, parameters, &locals, function.first_parameter, function.parameter_count, statement.left)
                                                        match value_type < 0:
                                                            -1:
                                                                return value_type
                                                            0:
                                                                value_type = value_type
                                                            1:
                                                                value_type = value_type
                                                    0:
                                                        match statement.kind == 17:
                                                            -1:
                                                                value_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, &locals, function.first_parameter, function.parameter_count, statement.left, 2)
                                                                match value_type <=> 2:
                                                                    -1:
                                                                        return -14
                                                                    0:
                                                                        value_type = ng_check_control_body(source, types, fields, functions, nodes, parameters, &locals, function, statement.right, 1)
                                                                        match value_type < 0:
                                                                            -1:
                                                                                return value_type
                                                                            0:
                                                                                link_id = link.right
                                                                            1:
                                                                                link_id = link.right
                                                                    1:
                                                                        return -14
                                                            0:
                                                                return -16
                                                            1:
                                                                return -16
                                                    1:
                                                        return -16
                                            1:
                                                return -16
                                    1:
                                        return -16
                            1:
                                return -16
                    1:
                        return -16
            1:
                return -16
        link_id = link.right
    match saw_return == 1:
        -1:
            return 0
        0:
            return -15
        1:
            return -15

fn ng_check_program_core(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, parameters: &vector<NgParameter>, nodes: &vector<NgAstNode>) -> i64:
    mut function_index: i64 = 0
    mut prior_function_index: i64 = 0
    mut parameter_index: i64 = 0
    mut prior_parameter_index: i64 = 0
    mut function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, local_name_start=0, local_name_end=0, first_parameter=0, parameter_count=0, return_type=0, first_node=0, body_node=0, module_index=0, exported=0, name_fingerprint=0, local_name_fingerprint=0)
    mut prior_function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, local_name_start=0, local_name_end=0, first_parameter=0, parameter_count=0, return_type=0, first_node=0, body_node=0, module_index=0, exported=0, name_fingerprint=0, local_name_fingerprint=0)
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, name_fingerprint=0, type_kind=0)
    mut prior_parameter: NgParameter = NgParameter(name_start=0, name_end=0, name_fingerprint=0, type_kind=0)
    mut body_status: i64 = 0
    while function_index < vector_len<NgFunction>(functions):
        function = vector_get<NgFunction>(functions, function_index)
        prior_function_index = 0
        while prior_function_index < function_index:
            prior_function = vector_get<NgFunction>(functions, prior_function_index)
            match ng_named_spans_equal(source, function.name_start, function.name_end, function.name_fingerprint, prior_function.name_start, prior_function.name_end, prior_function.name_fingerprint):
                -1:
                    return -10
                0:
                    prior_function_index = prior_function_index + 1
                1:
                    prior_function_index = prior_function_index + 1
        parameter_index = function.first_parameter
        while parameter_index < function.first_parameter + function.parameter_count:
            parameter = vector_get<NgParameter>(parameters, parameter_index)
            prior_parameter_index = function.first_parameter
            while prior_parameter_index < parameter_index:
                prior_parameter = vector_get<NgParameter>(parameters, prior_parameter_index)
                match ng_spans_equal(source, parameter.name_start, parameter.name_end, prior_parameter.name_start, prior_parameter.name_end):
                    -1:
                        return -11
                    0:
                        prior_parameter_index = prior_parameter_index + 1
                    1:
                        prior_parameter_index = prior_parameter_index + 1
            parameter_index = parameter_index + 1
        body_status = ng_check_function_body(source, types, fields, functions, nodes, parameters, function)
        match body_status <=> 0:
            -1:
                return body_status
            0:
                function_index = function_index + 1
            1:
                return body_status
    return 0

export fn ng_check_program(source: &bytes, functions: &vector<NgFunction>, parameters: &vector<NgParameter>, nodes: &vector<NgAstNode>) -> i64:
    mut types: vector<NgTypeDescriptor> = vector_new<NgTypeDescriptor>(bytes_len(source) + 6)
    mut fields: vector<NgField> = vector_new<NgField>(1)
    mut status: i64 = ng_initialize_type_table(&mut types)
    match status <=> 0:
        -1:
            return status
        0:
            return ng_check_program_core(source, &types, &fields, functions, parameters, nodes)
        1:
            return status

export fn ng_check_program_typed(source: &bytes, types: &vector<NgTypeDescriptor>, records: &vector<NgRecord>, fields: &vector<NgField>, functions: &vector<NgFunction>, parameters: &vector<NgParameter>, nodes: &mut vector<NgAstNode>) -> i64:
    mut status: i64 = ng_resolve_record_field_nodes(source, types, records, fields, functions, parameters, nodes)
    match status <=> 0:
        -1:
            return status
        0:
            return ng_check_program_core(source, types, fields, functions, parameters, &*nodes)
        1:
            return status
