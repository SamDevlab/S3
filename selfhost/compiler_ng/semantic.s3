module selfhost.compiler_ng.semantic

from selfhost.compiler_ng.parser import NgAstNode, NgFunction, NgParameter

export record NgLocal:
    name_start: i64
    name_end: i64
    type_kind: i64
    mutable: i64

export fn ng_spans_equal(source: &bytes, left_start: i64, left_end: i64, right_start: i64, right_end: i64) -> trit:
    mut left: i64 = left_start
    mut right: i64 = right_start
    match left_end - left_start <=> right_end - right_start:
        -1:
            return 0
        0:
            while left < left_end:
                match to_i64(bytes_get(source, left)) <=> to_i64(bytes_get(source, right)):
                    -1:
                        return 0
                    0:
                        left = left + 1
                        right = right + 1
                    1:
                        return 0
            return -1
        1:
            return 0

fn ng_parameter_type(source: &bytes, parameters: &vector<NgParameter>, first_parameter: i64, parameter_count: i64, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = first_parameter
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    while index < first_parameter + parameter_count:
        parameter = vector_get<NgParameter>(parameters, index)
        match ng_spans_equal(source, name_start, name_end, parameter.name_start, parameter.name_end):
            -1:
                return parameter.type_kind
            0:
                index = index + 1
            1:
                index = index + 1
    return -12

fn ng_local_type(source: &bytes, locals: &vector<NgLocal>, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = vector_len<NgLocal>(locals)
    mut local: NgLocal = NgLocal(name_start=0, name_end=0, type_kind=0, mutable=0)
    while index > 0:
        index = index - 1
        local = vector_get<NgLocal>(locals, index)
        match ng_spans_equal(source, name_start, name_end, local.name_start, local.name_end):
            -1:
                return local.type_kind
            0:
                index = index
            1:
                index = index
    return -12

fn ng_local_index(source: &bytes, locals: &vector<NgLocal>, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = vector_len<NgLocal>(locals)
    mut local: NgLocal = NgLocal(name_start=0, name_end=0, type_kind=0, mutable=0)
    while index > 0:
        index = index - 1
        local = vector_get<NgLocal>(locals, index)
        match ng_spans_equal(source, name_start, name_end, local.name_start, local.name_end):
            -1:
                return index
            0:
                index = index
            1:
                index = index
    return -12

fn ng_resolved_value_type(source: &bytes, parameters: &vector<NgParameter>, first_parameter: i64, parameter_count: i64, locals: &vector<NgLocal>, name_start: i64, name_end: i64) -> i64:
    mut result: i64 = ng_parameter_type(source, parameters, first_parameter, parameter_count, name_start, name_end)
    match result <=> -12:
        -1:
            return result
        0:
            return ng_local_type(source, locals, name_start, name_end)
        1:
            return result

fn ng_supported_i64_binary(operation: i64) -> trit:
    match operation == 342:
        -1:
            return -1
        0:
            match operation == 343:
                -1:
                    return -1
                0:
                    match operation == 345:
                        -1:
                            return -1
                        0:
                            match operation == 347:
                                -1:
                                    return -1
                                0:
                                    return 0
                                1:
                                    return 0
                        1:
                            return 0
                1:
                    return 0
        1:
            return 0

export fn ng_find_function(source: &bytes, functions: &vector<NgFunction>, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = 0
    mut function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0)
    while index < vector_len<NgFunction>(functions):
        function = vector_get<NgFunction>(functions, index)
        match ng_spans_equal(source, name_start, name_end, function.name_start, function.name_end):
            -1:
                return index
            0:
                index = index + 1
            1:
                index = index + 1
    return -13

fn ng_call_type(source: &bytes, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, caller_first_parameter: i64, caller_parameter_count: i64, call_node: NgAstNode) -> i64:
    mut callee_index: i64 = ng_find_function(source, functions, call_node.start, call_node.operation)
    mut callee: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0)
    mut argument_list: i64 = call_node.left
    mut argument: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut argument_type: i64 = 0
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    mut argument_index: i64 = 0
    match callee_index < 0:
        -1:
            return -13
        0:
            callee = vector_get<NgFunction>(functions, callee_index)
        1:
            return -13
    while argument_list >= 0:
        match argument_index <=> callee.parameter_count:
            -1:
                argument = vector_get<NgAstNode>(nodes, argument_list)
                match argument.kind <=> 6:
                    -1:
                        return -14
                    0:
                        argument_type = ng_expression_type(source, functions, nodes, parameters, locals, caller_first_parameter, caller_parameter_count, argument.left)
                        match argument_type <=> 0:
                            -1:
                                return argument_type
                            0:
                                return -14
                            1:
                                parameter = vector_get<NgParameter>(parameters, callee.first_parameter + argument_index)
                                match argument_type <=> parameter.type_kind:
                                    -1:
                                        return -14
                                    0:
                                        argument_list = argument.right
                                        argument_index = argument_index + 1
                                    1:
                                        return -14
                    1:
                        return -14
            0:
                return -14
            1:
                return -14
    match argument_index <=> callee.parameter_count:
        -1:
            return -14
        0:
            return callee.return_type
        1:
            return -14

fn ng_expression_type(source: &bytes, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, first_parameter: i64, parameter_count: i64, node_id: i64) -> i64:
    mut node: NgAstNode = vector_get<NgAstNode>(nodes, node_id)
    mut left_type: i64 = 0
    mut right_type: i64 = 0
    match node.kind <=> 1:
        -1:
            return -11
        0:
            return 1
        1:
            match node.kind <=> 2:
                -1:
                    return -11
                0:
                    return ng_resolved_value_type(source, parameters, first_parameter, parameter_count, locals, node.start, node.end)
                1:
                    match node.kind <=> 3:
                        -1:
                            return -11
                        0:
                            return ng_expression_type(source, functions, nodes, parameters, locals, first_parameter, parameter_count, node.left)
                        1:
                            match node.kind <=> 4:
                                -1:
                                    return -11
                                0:
                                    left_type = ng_expression_type(source, functions, nodes, parameters, locals, first_parameter, parameter_count, node.left)
                                    match left_type <=> 0:
                                        -1:
                                            return left_type
                                        0:
                                            return -14
                                        1:
                                            match left_type <=> 1:
                                                -1:
                                                    return -14
                                                0:
                                                    right_type = ng_expression_type(source, functions, nodes, parameters, locals, first_parameter, parameter_count, node.right)
                                                    match right_type <=> 0:
                                                        -1:
                                                            return right_type
                                                        0:
                                                            return -14
                                                        1:
                                                            match right_type <=> 1:
                                                                -1:
                                                                    return -14
                                                                0:
                                                                    match ng_supported_i64_binary(node.operation):
                                                                        -1:
                                                                            return 1
                                                                        0:
                                                                            return -14
                                                                        1:
                                                                            return -14
                                                                1:
                                                                    return -14
                                                1:
                                                    return -14
                                1:
                                    match node.kind <=> 5:
                                        -1:
                                            return -11
                                        0:
                                            return ng_call_type(source, functions, nodes, parameters, locals, first_parameter, parameter_count, node)
                                        1:
                                            return -11

fn ng_check_match_return_arms(source: &bytes, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, function: NgFunction, statement: NgAstNode) -> i64:
    mut selector_type: i64 = ng_expression_type(source, functions, nodes, parameters, locals, function.first_parameter, function.parameter_count, statement.left)
    mut arm_id: i64 = statement.right
    mut arm: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut body_link: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut arm_return: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut return_type: i64 = 0
    mut seen_negative: i64 = 0
    mut seen_neutral: i64 = 0
    mut seen_positive: i64 = 0
    match selector_type <=> 2:
        -1:
            return -14
        0:
            selector_type = selector_type
        1:
            return -14
    while arm_id >= 0:
        arm = vector_get<NgAstNode>(nodes, arm_id)
        match arm.kind <=> 13:
            -1:
                return -16
            0:
                match arm.operation <=> -1:
                    -1:
                        match seen_negative <=> 0:
                            -1:
                                return -18
                            0:
                                seen_negative = 1
                            1:
                                return -18
                    0:
                        match arm.operation <=> 0:
                            -1:
                                match seen_negative <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_negative = 1
                                    1:
                                        return -18
                            0:
                                match seen_neutral <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_neutral = 1
                                    1:
                                        return -18
                            1:
                                match seen_positive <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_positive = 1
                                    1:
                                        return -18
                    1:
                        match arm.operation <=> 0:
                            -1:
                                match seen_negative <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_negative = 1
                                    1:
                                        return -18
                            0:
                                match seen_neutral <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_neutral = 1
                                    1:
                                        return -18
                            1:
                                match seen_positive <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_positive = 1
                                    1:
                                        return -18
                body_link = vector_get<NgAstNode>(nodes, arm.left)
                match body_link.kind <=> 11:
                    -1:
                        return -16
                    0:
                        match body_link.right < 0:
                            -1:
                                arm_return = vector_get<NgAstNode>(nodes, body_link.left)
                                match arm_return.kind <=> 9:
                                    -1:
                                        return -16
                                    0:
                                        return_type = ng_expression_type(source, functions, nodes, parameters, locals, function.first_parameter, function.parameter_count, arm_return.left)
                                        match return_type < 0:
                                            -1:
                                                return return_type
                                            0:
                                                match return_type <=> function.return_type:
                                                    -1:
                                                        return -15
                                                    0:
                                                        arm_id = arm.right
                                                    1:
                                                        return -15
                                            1:
                                                return -15
                                    1:
                                        return -16
                            0:
                                return -16
                            1:
                                return -16
                    1:
                        return -16
            1:
                return -16
        arm_id = arm.right
    match seen_negative == 1:
        -1:
            match seen_neutral == 1:
                -1:
                    match seen_positive == 1:
                        -1:
                            return 0
                        0:
                            return -18
                        1:
                            return -18
                0:
                    return -18
                1:
                    return -18
        0:
            return -18
        1:
            return -18

fn ng_check_function_body(source: &bytes, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, function: NgFunction) -> i64:
    mut locals: vector<NgLocal> = vector_new<NgLocal>(8)
    mut link_id: i64 = function.body_node
    mut link: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut statement: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut local_binding: NgLocal = NgLocal(name_start=0, name_end=0, type_kind=0, mutable=0)
    mut parameter_type: i64 = 0
    mut local_id: i64 = -1
    mut declared_type: i64 = 0
    mut mutable: i64 = 0
    mut value_type: i64 = 0
    mut saw_return: i64 = 0
    while link_id >= 0:
        link = vector_get<NgAstNode>(nodes, link_id)
        match link.kind <=> 11:
            -1:
                return -16
            0:
                statement = vector_get<NgAstNode>(nodes, link.left)
                match statement.kind == 7:
                    -1:
                        declared_type = statement.operation
                        mutable = 0
                        match declared_type >= 100:
                            -1:
                                declared_type = declared_type - 100
                                mutable = 1
                            0:
                                mutable = 0
                            1:
                                mutable = 0
                        parameter_type = ng_parameter_type(source, parameters, function.first_parameter, function.parameter_count, statement.start, statement.end)
                        local_id = ng_local_index(source, &locals, statement.start, statement.end)
                        match parameter_type >= 0:
                            -1:
                                return -11
                            0:
                                match local_id >= 0:
                                    -1:
                                        return -11
                                    0:
                                        value_type = ng_expression_type(source, functions, nodes, parameters, &locals, function.first_parameter, function.parameter_count, statement.left)
                                        match value_type <=> declared_type:
                                            -1:
                                                return -14
                                            0:
                                                discard vector_push<NgLocal>(&mut locals, NgLocal(name_start=statement.start, name_end=statement.end, type_kind=declared_type, mutable=mutable))
                                            1:
                                                return -14
                                    1:
                                        return -11
                            1:
                                return -11
                    0:
                        match statement.kind == 8:
                            -1:
                                local_id = ng_local_index(source, &locals, statement.start, statement.end)
                                match local_id >= 0:
                                    -1:
                                        local_binding = vector_get<NgLocal>(&locals, local_id)
                                        match local_binding.mutable <=> 1:
                                            -1:
                                                return -16
                                            0:
                                                value_type = ng_expression_type(source, functions, nodes, parameters, &locals, function.first_parameter, function.parameter_count, statement.left)
                                                local_binding = vector_get<NgLocal>(&locals, local_id)
                                                match value_type <=> local_binding.type_kind:
                                                    -1:
                                                        return -14
                                                    0:
                                                        value_type = 0
                                                    1:
                                                        return -14
                                            1:
                                                return -16
                                    0:
                                        return -12
                                    1:
                                        return -12
                            0:
                                match statement.kind == 9:
                                    -1:
                                        value_type = ng_expression_type(source, functions, nodes, parameters, &locals, function.first_parameter, function.parameter_count, statement.left)
                                        match value_type < 0:
                                            -1:
                                                return value_type
                                            0:
                                                match value_type <=> function.return_type:
                                                    -1:
                                                        return -15
                                                    0:
                                                        saw_return = 1
                                                        match link.right >= 0:
                                                            -1:
                                                                return -17
                                                            0:
                                                                link_id = link.right
                                                            1:
                                                                link_id = link.right
                                                    1:
                                                        return -15
                                            1:
                                                return -15
                                    0:
                                        match statement.kind == 12:
                                            -1:
                                                value_type = ng_check_match_return_arms(source, functions, nodes, parameters, &locals, function, statement)
                                                match value_type <=> 0:
                                                    -1:
                                                        return value_type
                                                    0:
                                                        match link.right >= 0:
                                                            -1:
                                                                return -17
                                                            0:
                                                                saw_return = 1
                                                                link_id = link.right
                                                            1:
                                                                link_id = link.right
                                                    1:
                                                        return value_type
                                            0:
                                                return -16
                                            1:
                                                return -16
                                    1:
                                        return -16
                            1:
                                return -16
                    1:
                        return -16
            1:
                return -16
        link_id = link.right
    match saw_return == 1:
        -1:
            return 0
        0:
            return -15
        1:
            return -15

export fn ng_check_program(source: &bytes, functions: &vector<NgFunction>, parameters: &vector<NgParameter>, nodes: &vector<NgAstNode>) -> i64:
    mut function_index: i64 = 0
    mut prior_function_index: i64 = 0
    mut parameter_index: i64 = 0
    mut prior_parameter_index: i64 = 0
    mut function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0)
    mut prior_function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0)
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    mut prior_parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    mut body_status: i64 = 0
    while function_index < vector_len<NgFunction>(functions):
        function = vector_get<NgFunction>(functions, function_index)
        prior_function_index = 0
        while prior_function_index < function_index:
            prior_function = vector_get<NgFunction>(functions, prior_function_index)
            match ng_spans_equal(source, function.name_start, function.name_end, prior_function.name_start, prior_function.name_end):
                -1:
                    return -10
                0:
                    prior_function_index = prior_function_index + 1
                1:
                    prior_function_index = prior_function_index + 1
        parameter_index = function.first_parameter
        while parameter_index < function.first_parameter + function.parameter_count:
            parameter = vector_get<NgParameter>(parameters, parameter_index)
            prior_parameter_index = function.first_parameter
            while prior_parameter_index < parameter_index:
                prior_parameter = vector_get<NgParameter>(parameters, prior_parameter_index)
                match ng_spans_equal(source, parameter.name_start, parameter.name_end, prior_parameter.name_start, prior_parameter.name_end):
                    -1:
                        return -11
                    0:
                        prior_parameter_index = prior_parameter_index + 1
                    1:
                        prior_parameter_index = prior_parameter_index + 1
            parameter_index = parameter_index + 1
        body_status = ng_check_function_body(source, functions, nodes, parameters, function)
        match body_status <=> 0:
            -1:
                return body_status
            0:
                function_index = function_index + 1
            1:
                return body_status
    return 0
