module selfhost.compiler_ng.semantic

from selfhost.compiler_ng.parser import NgAstNode, NgField, NgFunction, NgParameter, NgRecord, ng_is_relational_operator
from selfhost.compiler_ng.types import NgTypeDescriptor, ng_initialize_type_table, ng_intern_reference_type, ng_type_equal
from selfhost.compiler_ng.lexer import ng_span_fingerprint, ng_spans_equal

export record NgLocal:
    name_start: i64
    name_end: i64
    type_kind: i64
    mutable: i64

export record NgLocalLookupSymbol:
    function_first_node: i64
    scope_id: i64
    name_start: i64
    name_end: i64
    first_occurrence: i64
    occurrence_count: i64

export record NgLocalLookupResult:
    index: i64
    probes: i64

record NgScopeTask:
    node_index: i64
    scope_id: i64
    create_scope: i64

export fn ng_named_spans_equal(source: &bytes, left_start: i64, left_end: i64, left_fingerprint: i64, right_start: i64, right_end: i64, right_fingerprint: i64) -> trit:
    match left_fingerprint > 0:
        -1:
            match right_fingerprint > 0:
                -1:
                    match left_fingerprint <=> right_fingerprint:
                        -1:
                            return 0
                        0:
                            match left_end - left_start <=> right_end - right_start:
                                -1:
                                    return 0
                                0:
                                    match left_end - left_start < 8:
                                        -1:
                                            # Short fingerprints encode the complete span and its length.
                                            return -1
                                        0:
                                            return ng_spans_equal(source, left_start, left_end, right_start, right_end)
                                        1:
                                            return ng_spans_equal(source, left_start, left_end, right_start, right_end)
                                1:
                                    return 0
                        1:
                            return 0
                0:
                    return ng_spans_equal(source, left_start, left_end, right_start, right_end)
                1:
                    return ng_spans_equal(source, left_start, left_end, right_start, right_end)
        0:
            return ng_spans_equal(source, left_start, left_end, right_start, right_end)
        1:
            return ng_spans_equal(source, left_start, left_end, right_start, right_end)

fn ng_parameter_type(source: &bytes, parameters: &vector<NgParameter>, first_parameter: i64, parameter_count: i64, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = first_parameter
    mut name_length: i64 = name_end - name_start
    mut name_fingerprint: i64 = ng_span_fingerprint(source, name_start, name_end)
    mut parameter_name_length: i64 = 0
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, name_fingerprint=0, type_kind=0)
    while index < first_parameter + parameter_count:
        parameter = vector_get<NgParameter>(parameters, index)
        parameter_name_length = parameter.name_end - parameter.name_start
        match name_length <=> parameter_name_length:
            -1:
                index = index + 1
            0:
                match ng_named_spans_equal(source, name_start, name_end, name_fingerprint, parameter.name_start, parameter.name_end, parameter.name_fingerprint):
                    -1:
                        return parameter.type_kind
                    0:
                        index = index + 1
                    1:
                        index = index + 1
            1:
                index = index + 1
    return -12

fn ng_local_type(source: &bytes, locals: &vector<NgLocal>, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = vector_len<NgLocal>(locals)
    mut name_length: i64 = name_end - name_start
    mut local_name_length: i64 = 0
    mut local: NgLocal = NgLocal(name_start=0, name_end=0, type_kind=0, mutable=0)
    while index > 0:
        index = index - 1
        local = vector_get<NgLocal>(locals, index)
        local_name_length = local.name_end - local.name_start
        match name_length <=> local_name_length:
            -1:
                index = index
            0:
                match ng_spans_equal(source, name_start, name_end, local.name_start, local.name_end):
                    -1:
                        return local.type_kind
                    0:
                        index = index
                    1:
                        index = index
            1:
                index = index
    return -12

