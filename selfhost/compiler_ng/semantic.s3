                                                                match descriptor.kind <= 6:
                                                                    -1:
                                                                        descriptor = descriptor
                                                                    0:
                                                                        match descriptor.kind <=> 8:
                                                                            0:
                                                                                descriptor = descriptor
                                                                            -1:
                                                                                return -14
                                                                            1:
                                                                                return -14
                                                                    1:
                                                                        return -14
                                                                match node.operation <=> 0:
                                                                    0:
                                                                        reference_type = ng_intern_reference_type(types, target_type, node.operation)
                                                                    1:
                                                                        match is_parameter <=> 1:
                                                                            0:
                                                                                reference_type = ng_intern_reference_type(types, target_type, node.operation)
                                                                            -1:
                                                                                match local_mutable <=> 1:
                                                                                    0:
                                                                                        reference_type = ng_intern_reference_type(types, target_type, node.operation)
                                                                                    -1:
                                                                                        return -14
                                                                                    1:
                                                                                        return -14
                                                                            1:
                                                                                return -14
                                                                    -1:
                                                                        return -14
                                                                match reference_type > 0:
