                                        match target.kind <=> 2:
                                            0:
                                                parameter_type = ng_parameter_type(source, parameters, function.first_parameter, function.parameter_count, target.start, target.end)
                                                is_parameter = 0
                                                local_mutable = 0
                                                match parameter_type > 0:
                                                    -1:
                                                        target_type = parameter_type
                                                        is_parameter = 1
                                                    0:
                                                        lookup_result = ng_prior_local_declaration(source, &*nodes, function, node, node_index, target, node_scope_ids, scope_parents, local_symbols, local_buckets, local_offsets, local_occurrences)
                                                        declaration_index = lookup_result.index
                                                        match declaration_index >= 0:
                                                            -1:
                                                                declaration = vector_get<NgAstNode>(&*nodes, declaration_index)
                                                                target_type = declaration.operation
                                                                match target_type < 0:
                                                                    -1:
                                                                        target_type = 0 - target_type
                                                                        local_mutable = 1
                                                                    0:
                                                                        local_mutable = 0
                                                                    1:
                                                                        local_mutable = 0
                                                            0:
                                                                return -12
                                                            1:
                                                                return -12
                                                    1:
                                                        return -12
                                                match target_type > 0:
