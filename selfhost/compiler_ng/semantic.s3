                                                    0:
                                                        return -14
                                                    1:
                                                        return -14
                                            -1:
                                                return -14
                                            1:
                                                return -14
                                    0:
                                        return -14
                                    1:
                                        return -14
                            0:
                                return source_type_id
                            1:
                                return source_type_id
                    0:
                        return -12
                    1:
                        return -12
            -1:
                node = node
            1:
                node = node
        node_index = node_index + 1
    return 0

fn ng_resolve_reborrow_addresses(types: &mut vector<NgTypeDescriptor>, nodes: &mut vector<NgAstNode>) -> i64:
    mut node_index: i64 = 0
