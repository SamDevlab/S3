                0:
                    match ng_span_matches_text(source, name_start, name_end, text_from_static("to_tryte")):
                        -1:
                            return 3
                        0:
                            match ng_span_matches_text(source, name_start, name_end, text_from_static("bytes_new")):
                                -1:
                                    return 4
                                0:
                                    match ng_span_matches_text(source, name_start, name_end, text_from_static("bytes_len")):
                                        -1:
                                            return 5
                                        0:
