module selfhost.compiler_ng.semantic

from selfhost.compiler_ng.parser import NgAstNode, NgField, NgFunction, NgParameter, NgRecord, ng_is_relational_operator
from selfhost.compiler_ng.types import NgTypeDescriptor, ng_initialize_type_table, ng_intern_reference_type, ng_type_equal

export record NgLocal:
    name_start: i64
    name_end: i64
    type_kind: i64
    mutable: i64

export fn ng_spans_equal(source: &bytes, left_start: i64, left_end: i64, right_start: i64, right_end: i64) -> trit:
    mut left: i64 = left_start
    mut right: i64 = right_start
    match left_end - left_start <=> right_end - right_start:
        -1:
            return 0
        0:
            while left < left_end:
                match to_i64(bytes_get(source, left)) <=> to_i64(bytes_get(source, right)):
                    -1:
                        return 0
                    0:
                        left = left + 1
                        right = right + 1
                    1:
                        return 0
            return -1
        1:
            return 0

fn ng_parameter_type(source: &bytes, parameters: &vector<NgParameter>, first_parameter: i64, parameter_count: i64, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = first_parameter
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    while index < first_parameter + parameter_count:
        parameter = vector_get<NgParameter>(parameters, index)
        match ng_spans_equal(source, name_start, name_end, parameter.name_start, parameter.name_end):
            -1:
                return parameter.type_kind
            0:
                index = index + 1
            1:
                index = index + 1
    return -12

fn ng_local_type(source: &bytes, locals: &vector<NgLocal>, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = vector_len<NgLocal>(locals)
    mut local: NgLocal = NgLocal(name_start=0, name_end=0, type_kind=0, mutable=0)
    while index > 0:
        index = index - 1
        local = vector_get<NgLocal>(locals, index)
        match ng_spans_equal(source, name_start, name_end, local.name_start, local.name_end):
            -1:
                return local.type_kind
            0:
                index = index
            1:
                index = index
    return -12

fn ng_local_index(source: &bytes, locals: &vector<NgLocal>, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = vector_len<NgLocal>(locals)
    mut local: NgLocal = NgLocal(name_start=0, name_end=0, type_kind=0, mutable=0)
    while index > 0:
        index = index - 1
        local = vector_get<NgLocal>(locals, index)
        match ng_spans_equal(source, name_start, name_end, local.name_start, local.name_end):
            -1:
                return index
            0:
                index = index
            1:
                index = index
    return -12

fn ng_resolved_value_type(source: &bytes, parameters: &vector<NgParameter>, first_parameter: i64, parameter_count: i64, locals: &vector<NgLocal>, name_start: i64, name_end: i64) -> i64:
    mut result: i64 = ng_parameter_type(source, parameters, first_parameter, parameter_count, name_start, name_end)
    match result <=> -12:
        -1:
            return result
        0:
            return ng_local_type(source, locals, name_start, name_end)
        1:
            return result

fn ng_supported_numeric_binary(operation: i64) -> trit:
    match operation == 342:
        -1:
            return -1
        0:
            match operation == 343:
                -1:
                    return -1
                0:
                    match operation == 345:
                        -1:
                            return -1
                        0:
                            match operation == 347:
                                -1:
                                    return -1
                                0:
                                    return 0
                                1:
                                    return 0
                        1:
                            return 0
                1:
                    return 0
        1:
            return 0

fn ng_literal_magnitude_fits(source: &bytes, node: NgAstNode, maximum_prefix: i64, maximum_last_digit: i64) -> trit:
    mut index: i64 = node.start
    mut value: i64 = 0
    mut digit: i64 = 0
    match index < node.end:
        -1:
            match to_i64(bytes_get(source, index)) <=> 45:
                -1:
                    value = value
                0:
                    index = index + 1
                1:
                    value = value
        0:
            return 0
        1:
            return 0
    match index < node.end:
        -1:
            while index < node.end:
                digit = to_i64(bytes_get(source, index)) - 48
                match digit < 0:
                    -1:
                        return 0
                    0:
                        match digit > 9:
                            -1:
                                digit = digit
                            0:
                                digit = digit
                            1:
                                return 0
                        match value <=> maximum_prefix:
                            -1:
                                value = value * 10 + digit
                            0:
                                match digit <=> maximum_last_digit:
                                    -1:
                                        value = value * 10 + digit
                                    0:
                                        value = value * 10 + digit
                                    1:
                                        return 0
                            1:
                                return 0
                        index = index + 1
                    1:
                        return 0
            return -1
        0:
            return 0
        1:
            return 0

fn ng_trit_literal_fits(source: &bytes, node: NgAstNode) -> trit:
    return ng_literal_magnitude_fits(source, node, 0, 1)

fn ng_tryte_literal_fits(source: &bytes, node: NgAstNode) -> trit:
    return ng_literal_magnitude_fits(source, node, 36, 4)

fn ng_i64_literal_fits(source: &bytes, node: NgAstNode) -> trit:
    return ng_literal_magnitude_fits(source, node, 922337203685477580, 7)

fn ng_span_matches_text(source: &bytes, start: i64, end: i64, wanted: text) -> trit:
    mut expected: bytes = bytes_from_text(&wanted)
    mut index: i64 = 0
    match end - start <=> bytes_len(&expected):
        -1:
            return 0
        0:
            while index < bytes_len(&expected):
                match to_i64(bytes_get(source, start + index)) <=> to_i64(bytes_get(&expected, index)):
                    -1:
                        return 0
                    0:
                        index = index + 1
                    1:
                        return 0
            return -1
        1:
            return 0

fn ng_vector_element_supported(types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, element_type: i64) -> trit:
    mut element: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut field: NgField = NgField(record_index=0, name_start=0, name_end=0, type_id=0, order=0)
    mut field_type: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut field_index: i64 = 0
    match element_type > 0:
        -1:
            match element_type <= vector_len<NgTypeDescriptor>(types):
                -1:
                    element = vector_get<NgTypeDescriptor>(types, element_type - 1)
                    match element.kind <= 4:
                        -1:
                            return -1
                        0:
                            match element.kind <=> 7:
                                0:
                                    match element.field_count > 0:
                                        -1:
                                            match element.first_field >= 0:
                                                -1:
                                                    match element.first_field + element.field_count <= vector_len<NgField>(fields):
                                                        -1:
                                                            field_index = element.first_field
                                                            while field_index < element.first_field + element.field_count:
                                                                field = vector_get<NgField>(fields, field_index)
                                                                match field.type_id > 0:
                                                                    -1:
                                                                        match field.type_id <= vector_len<NgTypeDescriptor>(types):
                                                                            -1:
                                                                                field_type = vector_get<NgTypeDescriptor>(types, field.type_id - 1)
                                                                                match field_type.kind <= 4:
                                                                                    -1:
                                                                                        field_index = field_index + 1
                                                                                    0:
                                                                                        return 0
                                                                                    1:
                                                                                        return 0
                                                                            0:
                                                                                return 0
                                                                            1:
                                                                                return 0
                                                                    0:
                                                                        return 0
                                                                    1:
                                                                        return 0
                                                            return -1
                                                        0:
                                                            return 0
                                                        1:
                                                            return 0
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                -1:
                                    return 0
                                1:
                                    return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn ng_record_constructor_type(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, first_parameter: i64, parameter_count: i64, call_node: NgAstNode, expected_type: i64) -> i64:
    mut descriptor: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut field: NgField = NgField(record_index=0, name_start=0, name_end=0, type_id=0, order=0)
    mut argument_link: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut named_argument: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut argument_id: i64 = call_node.left
    mut field_index: i64 = 0
    mut argument_count: i64 = 0
    mut matching_count: i64 = 0
    mut value_type: i64 = -1
    match call_node.right > 0:
        -1:
            match call_node.right <= vector_len<NgTypeDescriptor>(types):
                -1:
                    descriptor = vector_get<NgTypeDescriptor>(types, call_node.right - 1)
                    match descriptor.kind <=> 7:
                        0:
                            match expected_type > 0:
                                -1:
                                    match ng_type_equal(source, types, expected_type, call_node.right) <=> -1:
                                        0:
                                            descriptor = descriptor
                                        -1:
                                            return -14
                                        1:
                                            return -14
                                0:
                                    descriptor = descriptor
                                1:
                                    descriptor = descriptor
                            argument_id = call_node.left
                            argument_count = 0
                            while argument_id >= 0:
                                argument_link = vector_get<NgAstNode>(nodes, argument_id)
                                match argument_link.kind <=> 6:
                                    0:
                                        argument_count = argument_count + 1
                                        argument_id = argument_link.right
                                    -1:
                                        return -14
                                    1:
                                        return -14
                            field_index = descriptor.first_field
                            while field_index < descriptor.first_field + descriptor.field_count:
                                field = vector_get<NgField>(fields, field_index)
                                argument_id = call_node.left
                                matching_count = 0
                                while argument_id >= 0:
                                    argument_link = vector_get<NgAstNode>(nodes, argument_id)
                                    match argument_link.kind <=> 6:
                                        0:
                                            named_argument = vector_get<NgAstNode>(nodes, argument_link.left)
                                            match named_argument.kind <=> 16:
                                                0:
                                                    match ng_spans_equal(source, field.name_start, field.name_end, named_argument.start, named_argument.end):
                                                        -1:
                                                            matching_count = matching_count + 1
                                                            match matching_count <=> 1:
                                                                0:
                                                                    value_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, named_argument.left, field.type_id)
                                                                    match ng_type_equal(source, types, value_type, field.type_id) <=> -1:
                                                                        0:
                                                                            value_type = value_type
                                                                        -1:
                                                                            return -14
                                                                        1:
                                                                            return -14
                                                                -1:
                                                                    return -14
                                                                1:
                                                                    return -14
                                                        0:
                                                            matching_count = matching_count
                                                        1:
                                                            matching_count = matching_count
                                                -1:
                                                    return -14
                                                1:
                                                    return -14
                                        -1:
                                            return -14
                                        1:
                                            return -14
                                    argument_id = argument_link.right
                                match matching_count <=> 1:
                                    0:
                                        field_index = field_index + 1
                                    -1:
                                        return -14
                                    1:
                                        return -14
                            match argument_count <=> descriptor.field_count:
                                0:
                                    match ng_spans_equal(source, call_node.start, call_node.operation, descriptor.name_start, descriptor.name_end):
                                        -1:
                                            return call_node.right
                                        0:
                                            return -14
                                        1:
                                            return -14
                                -1:
                                    return -14
                                1:
                                    return -14
                        -1:
                            return -14
                        1:
                            return -14
                0:
                    return -14
                1:
                    return -14
        0:
            return -14
        1:
            return -14

fn ng_contextual_expression_type(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, first_parameter: i64, parameter_count: i64, node_id: i64, expected_type: i64) -> i64:
    mut node: NgAstNode = vector_get<NgAstNode>(nodes, node_id)
    mut descriptor: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut base: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut constructor_type: i64 = -1
    match node.kind <=> 14:
        0:
            base = vector_get<NgAstNode>(nodes, node.left)
            match base.kind <=> 5:
                0:
                    constructor_type = ng_record_constructor_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, base, base.right)
                    match constructor_type <=> base.right:
                        0:
                            return node.right
                        -1:
                            return constructor_type
                        1:
                            return -14
                -1:
                    node = node
                1:
                    node = node
        -1:
            node = node
        1:
            node = node
    match node.kind <=> 5:
        0:
            match node.right > 0:
                -1:
                    match node.right <= vector_len<NgTypeDescriptor>(types):
                        -1:
                            descriptor = vector_get<NgTypeDescriptor>(types, node.right - 1)
                            match descriptor.kind <=> 7:
                                0:
                                    match ng_spans_equal(source, node.start, node.operation, descriptor.name_start, descriptor.name_end):
                                        -1:
                                            return ng_record_constructor_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node, expected_type)
                                        0:
                                            return ng_generic_call_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node, expected_type)
                                        1:
                                            return ng_generic_call_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node, expected_type)
                                -1:
                                    return ng_generic_call_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node, expected_type)
                                1:
                                    return ng_generic_call_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node, expected_type)
                        0:
                            return -14
                        1:
                            return -14
                0:
                    return ng_call_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node)
                1:
                    return -14
        -1:
            node = node
        1:
            node = node
    match node.kind <=> 1:
        -1:
            return ng_expression_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node_id)
        0:
            match expected_type <=> 2:
                -1:
                    match ng_i64_literal_fits(source, node):
                        -1:
                            return 1
                        0:
                            return -14
                        1:
                            return -14
                0:
                    match ng_trit_literal_fits(source, node):
                        -1:
                            return 2
                        0:
                            return -14
                        1:
                            return -14
                1:
                    match expected_type <=> 3:
                        -1:
                            return 1
                        0:
                            match ng_tryte_literal_fits(source, node):
                                -1:
                                    return 3
                                0:
                                    return -14
                                1:
                                    return -14
                        1:
                            return 1
        1:
            return ng_expression_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node_id)

export fn ng_find_function(source: &bytes, functions: &vector<NgFunction>, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = 0
    mut function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, local_name_start=0, local_name_end=0, first_parameter=0, parameter_count=0, return_type=0, first_node=0, body_node=0, module_index=0, exported=0)
    while index < vector_len<NgFunction>(functions):
        function = vector_get<NgFunction>(functions, index)
        match ng_spans_equal(source, name_start, name_end, function.name_start, function.name_end):
            -1:
                return index
            0:
                index = index + 1
            1:
                index = index + 1
    return -13

fn ng_vector_reference_matches(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, reference_type_id: i64, element_type_id: i64) -> trit:
    mut reference_type: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
