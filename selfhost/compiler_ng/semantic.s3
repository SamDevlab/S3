module selfhost.compiler_ng.semantic

from selfhost.compiler_ng.parser import NgAstNode, NgField, NgFunction, NgParameter, NgRecord
from selfhost.compiler_ng.types import NgTypeDescriptor, ng_initialize_type_table

export record NgLocal:
    name_start: i64
    name_end: i64
    type_kind: i64
    mutable: i64

export fn ng_spans_equal(source: &bytes, left_start: i64, left_end: i64, right_start: i64, right_end: i64) -> trit:
    mut left: i64 = left_start
    mut right: i64 = right_start
    match left_end - left_start <=> right_end - right_start:
        -1:
            return 0
        0:
            while left < left_end:
                match to_i64(bytes_get(source, left)) <=> to_i64(bytes_get(source, right)):
                    -1:
                        return 0
                    0:
                        left = left + 1
                        right = right + 1
                    1:
                        return 0
            return -1
        1:
            return 0

fn ng_parameter_type(source: &bytes, parameters: &vector<NgParameter>, first_parameter: i64, parameter_count: i64, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = first_parameter
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    while index < first_parameter + parameter_count:
        parameter = vector_get<NgParameter>(parameters, index)
        match ng_spans_equal(source, name_start, name_end, parameter.name_start, parameter.name_end):
            -1:
                return parameter.type_kind
            0:
                index = index + 1
            1:
                index = index + 1
    return -12

fn ng_local_type(source: &bytes, locals: &vector<NgLocal>, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = vector_len<NgLocal>(locals)
    mut local: NgLocal = NgLocal(name_start=0, name_end=0, type_kind=0, mutable=0)
    while index > 0:
        index = index - 1
        local = vector_get<NgLocal>(locals, index)
        match ng_spans_equal(source, name_start, name_end, local.name_start, local.name_end):
            -1:
                return local.type_kind
            0:
                index = index
            1:
                index = index
    return -12

fn ng_local_index(source: &bytes, locals: &vector<NgLocal>, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = vector_len<NgLocal>(locals)
    mut local: NgLocal = NgLocal(name_start=0, name_end=0, type_kind=0, mutable=0)
    while index > 0:
        index = index - 1
        local = vector_get<NgLocal>(locals, index)
        match ng_spans_equal(source, name_start, name_end, local.name_start, local.name_end):
            -1:
                return index
            0:
                index = index
            1:
                index = index
    return -12

fn ng_resolved_value_type(source: &bytes, parameters: &vector<NgParameter>, first_parameter: i64, parameter_count: i64, locals: &vector<NgLocal>, name_start: i64, name_end: i64) -> i64:
    mut result: i64 = ng_parameter_type(source, parameters, first_parameter, parameter_count, name_start, name_end)
    match result <=> -12:
        -1:
            return result
        0:
            return ng_local_type(source, locals, name_start, name_end)
        1:
            return result

fn ng_supported_numeric_binary(operation: i64) -> trit:
    match operation == 342:
        -1:
            return -1
        0:
            match operation == 343:
                -1:
                    return -1
                0:
                    match operation == 345:
                        -1:
                            return -1
                        0:
                            match operation == 347:
                                -1:
                                    return -1
                                0:
                                    return 0
                                1:
                                    return 0
                        1:
                            return 0
                1:
                    return 0
        1:
            return 0

fn ng_literal_magnitude_fits(source: &bytes, node: NgAstNode, maximum_prefix: i64, maximum_last_digit: i64) -> trit:
    mut index: i64 = node.start
    mut value: i64 = 0
    mut digit: i64 = 0
    match index < node.end:
        -1:
            match to_i64(bytes_get(source, index)) <=> 45:
                -1:
                    value = value
                0:
                    index = index + 1
                1:
                    value = value
        0:
            return 0
        1:
            return 0
    match index < node.end:
        -1:
            while index < node.end:
                digit = to_i64(bytes_get(source, index)) - 48
                match digit < 0:
                    -1:
                        return 0
                    0:
                        match digit > 9:
                            -1:
                                digit = digit
                            0:
                                digit = digit
                            1:
                                return 0
                        match value <=> maximum_prefix:
                            -1:
                                value = value * 10 + digit
                            0:
                                match digit <=> maximum_last_digit:
                                    -1:
                                        value = value * 10 + digit
                                    0:
                                        value = value * 10 + digit
                                    1:
                                        return 0
                            1:
                                return 0
                        index = index + 1
                    1:
                        return 0
            return -1
        0:
            return 0
        1:
            return 0

fn ng_trit_literal_fits(source: &bytes, node: NgAstNode) -> trit:
    return ng_literal_magnitude_fits(source, node, 0, 1)

fn ng_tryte_literal_fits(source: &bytes, node: NgAstNode) -> trit:
    return ng_literal_magnitude_fits(source, node, 36, 4)

fn ng_i64_literal_fits(source: &bytes, node: NgAstNode) -> trit:
    return ng_literal_magnitude_fits(source, node, 922337203685477580, 7)

fn ng_span_matches_text(source: &bytes, start: i64, end: i64, wanted: text) -> trit:
    mut expected: bytes = bytes_from_text(&wanted)
    mut index: i64 = 0
    match end - start <=> bytes_len(&expected):
        -1:
            return 0
        0:
            while index < bytes_len(&expected):
                match to_i64(bytes_get(source, start + index)) <=> to_i64(bytes_get(&expected, index)):
                    -1:
                        return 0
                    0:
                        index = index + 1
                    1:
                        return 0
            return -1
        1:
            return 0

fn ng_vector_element_supported(types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, element_type: i64) -> trit:
    mut element: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut field: NgField = NgField(record_index=0, name_start=0, name_end=0, type_id=0, order=0)
    mut field_type: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut field_index: i64 = 0
    match element_type > 0:
        -1:
            match element_type <= vector_len<NgTypeDescriptor>(types):
                -1:
                    element = vector_get<NgTypeDescriptor>(types, element_type - 1)
                    match element.kind <= 4:
                        -1:
                            return -1
                        0:
                            match element.kind <=> 7:
                                0:
                                    match element.field_count > 0:
                                        -1:
                                            match element.first_field >= 0:
                                                -1:
                                                    match element.first_field + element.field_count <= vector_len<NgField>(fields):
                                                        -1:
                                                            field_index = element.first_field
                                                            while field_index < element.first_field + element.field_count:
                                                                field = vector_get<NgField>(fields, field_index)
                                                                match field.type_id > 0:
                                                                    -1:
                                                                        match field.type_id <= vector_len<NgTypeDescriptor>(types):
                                                                            -1:
                                                                                field_type = vector_get<NgTypeDescriptor>(types, field.type_id - 1)
                                                                                match field_type.kind <= 4:
                                                                                    -1:
                                                                                        field_index = field_index + 1
                                                                                    0:
                                                                                        return 0
                                                                                    1:
                                                                                        return 0
                                                                            0:
                                                                                return 0
                                                                            1:
                                                                                return 0
                                                                    0:
                                                                        return 0
                                                                    1:
                                                                        return 0
                                                            return -1
                                                        0:
                                                            return 0
                                                        1:
                                                            return 0
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                -1:
                                    return 0
                                1:
                                    return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn ng_contextual_expression_type(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, first_parameter: i64, parameter_count: i64, node_id: i64, expected_type: i64) -> i64:
    mut node: NgAstNode = vector_get<NgAstNode>(nodes, node_id)
    match node.kind <=> 5:
        0:
            match node.right > 0:
                -1:
                    return ng_generic_call_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node, expected_type)
                0:
                    return ng_call_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node)
                1:
                    return -14
        -1:
            node = node
        1:
            node = node
    match node.kind <=> 1:
        -1:
            return ng_expression_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node_id)
        0:
            match expected_type <=> 2:
                -1:
                    match ng_i64_literal_fits(source, node):
                        -1:
                            return 1
                        0:
                            return -14
                        1:
                            return -14
                0:
                    match ng_trit_literal_fits(source, node):
                        -1:
                            return 2
                        0:
                            return -14
                        1:
                            return -14
                1:
                    match expected_type <=> 3:
                        -1:
                            return 1
                        0:
                            match ng_tryte_literal_fits(source, node):
                                -1:
                                    return 3
                                0:
                                    return -14
                                1:
                                    return -14
                        1:
                            return 1
        1:
            return ng_expression_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node_id)

export fn ng_find_function(source: &bytes, functions: &vector<NgFunction>, name_start: i64, name_end: i64) -> i64:
    mut index: i64 = 0
    mut function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, local_name_start=0, local_name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0, module_index=0, exported=0)
    while index < vector_len<NgFunction>(functions):
        function = vector_get<NgFunction>(functions, index)
        match ng_spans_equal(source, name_start, name_end, function.name_start, function.name_end):
            -1:
                return index
            0:
                index = index + 1
            1:
                index = index + 1
    return -13

fn ng_generic_call_type(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, caller_first_parameter: i64, caller_parameter_count: i64, call_node: NgAstNode, expected_type: i64) -> i64:
    mut argument: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut expected: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut argument_type: i64 = 0
    match ng_span_matches_text(source, call_node.start, call_node.operation, text_from_static("vector_new")):
        -1:
            match call_node.right > 0:
                -1:
                    match call_node.right <= vector_len<NgTypeDescriptor>(types):
                        -1:
                            match expected_type > 0:
                                -1:
                                    match expected_type <= vector_len<NgTypeDescriptor>(types):
                                        -1:
                                            expected = vector_get<NgTypeDescriptor>(types, expected_type - 1)
                                            match expected.kind <=> 8:
                                                0:
                                                    match expected.element_type <=> call_node.right:
                                                        0:
                                                            match ng_vector_element_supported(types, fields, call_node.right):
                                                                -1:
                                                                    match call_node.left >= 0:
                                                                        -1:
                                                                            argument = vector_get<NgAstNode>(nodes, call_node.left)
                                                                            match argument.kind <=> 6:
                                                                                0:
                                                                                    match argument.right <=> -1:
                                                                                        0:
                                                                                            argument_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, locals, caller_first_parameter, caller_parameter_count, argument.left, 1)
                                                                                            match argument_type <=> 1:
                                                                                                0:
                                                                                                    return expected_type
                                                                                                -1:
                                                                                                    return argument_type
                                                                                                1:
                                                                                                    return -14
                                                                                        -1:
                                                                                            return -14
                                                                                        1:
                                                                                            return -14
                                                                                -1:
                                                                                    return -14
                                                                                1:
                                                                                    return -14
                                                                        0:
                                                                            return -14
                                                                        1:
                                                                            return -14
                                                                0:
                                                                    return -14
                                                                1:
                                                                    return -14
                                                        -1:
                                                            return -14
                                                        1:
                                                            return -14
                                                -1:
                                                    return -14
                                                1:
                                                    return -14
                                        0:
                                            return -14
                                        1:
                                            return -14
                                0:
                                    return -14
                                1:
                                    return -14
                        0:
                            return -14
                        1:
                            return -14
                0:
                    return -14
                1:
                    return -14
        0:
            return -13
        1:
            return -13

fn ng_call_type(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, caller_first_parameter: i64, caller_parameter_count: i64, call_node: NgAstNode) -> i64:
    mut callee_index: i64 = ng_find_function(source, functions, call_node.start, call_node.operation)
    mut callee: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, local_name_start=0, local_name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0, module_index=0, exported=0)
    mut argument_list: i64 = call_node.left
    mut argument: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut argument_type: i64 = 0
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    mut argument_index: i64 = 0
    match callee_index < 0:
        -1:
            return -13
        0:
            callee = vector_get<NgFunction>(functions, callee_index)
        1:
            return -13
    while argument_list >= 0:
        match argument_index <=> callee.parameter_count:
            -1:
                argument = vector_get<NgAstNode>(nodes, argument_list)
                match argument.kind <=> 6:
                    -1:
                        return -14
                    0:
                        parameter = vector_get<NgParameter>(parameters, callee.first_parameter + argument_index)
                        argument_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, locals, caller_first_parameter, caller_parameter_count, argument.left, parameter.type_kind)
                        match argument_type <=> 0:
                            -1:
                                return argument_type
                            0:
                                return -14
                            1:
                                match argument_type <=> parameter.type_kind:
                                    -1:
                                        return -14
                                    0:
                                        argument_list = argument.right
                                        argument_index = argument_index + 1
                                    1:
                                        return -14
                    1:
                        return -14
            0:
                return -14
            1:
                return -14
    match argument_index <=> callee.parameter_count:
        -1:
            return -14
        0:
            return callee.return_type
        1:
            return -14

fn ng_is_numeric_type(type_kind: i64) -> trit:
    match type_kind <=> 1:
        -1:
            return 0
        0:
            return -1
        1:
            match type_kind <=> 3:
                -1:
                    return 0
                0:
                    return -1
                1:
                    return 0

fn ng_binary_expression_type(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, first_parameter: i64, parameter_count: i64, node: NgAstNode) -> i64:
    mut left_type: i64 = ng_expression_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node.left)
    mut right_type: i64 = 0
    match left_type <=> 0:
        -1:
            return left_type
        0:
            return -14
        1:
            match ng_is_numeric_type(left_type):
                -1:
                    right_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node.right, left_type)
                    match right_type <=> left_type:
                        -1:
                            return -14
                        0:
                            match node.operation <=> 202:
                                -1:
                                    return -14
                                0:
                                    return 2
                                1:
                                    match ng_supported_numeric_binary(node.operation):
                                        -1:
                                            return left_type
                                        0:
                                            return -14
                                        1:
                                            return -14
                        1:
                            return -14
                1:
                    return -14
                0:
                    return -14

fn ng_expression_type(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, first_parameter: i64, parameter_count: i64, node_id: i64) -> i64:
    mut node: NgAstNode = vector_get<NgAstNode>(nodes, node_id)
    match node.kind <=> 1:
        -1:
            return -11
        0:
            return 1
        1:
            match node.kind <=> 2:
                -1:
                    return -11
                0:
                    return ng_resolved_value_type(source, parameters, first_parameter, parameter_count, locals, node.start, node.end)
                1:
                    match node.kind <=> 3:
                        -1:
                            return -11
                        0:
                            return ng_expression_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node.left)
                        1:
                            match node.kind <=> 4:
                                -1:
                                    return -11
                                0:
                                    return ng_binary_expression_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node)
                                1:
                                    match node.kind <=> 5:
                                        -1:
                                            return -11
                                        0:
                                            match node.right > 0:
                                                -1:
                                                    return -14
                                                0:
                                                    return ng_call_type(source, types, fields, functions, nodes, parameters, locals, first_parameter, parameter_count, node)
                                                1:
                                                    return -14
                                        1:
                                            match node.kind <=> 14:
                                                -1:
                                                    return -11
                                                0:
                                                    match node.right > 0:
                                                        -1:
                                                            return node.right
                                                        0:
                                                            return -14
                                                        1:
                                                            return -14
                                                1:
                                                    return -11

fn ng_resolve_record_field_node(source: &bytes, types: &vector<NgTypeDescriptor>, records: &vector<NgRecord>, fields: &vector<NgField>, function: NgFunction, parameters: &vector<NgParameter>, nodes: &mut vector<NgAstNode>, node_index: i64) -> i64:
    mut node: NgAstNode = vector_get<NgAstNode>(&*nodes, node_index)
    mut target: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut descriptor: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut owner: NgTypeDescriptor = NgTypeDescriptor(kind=0, module_start=0, module_end=0, name_start=0, name_end=0, element_type=0, target_type=0, mutable=0, first_field=0, field_count=0)
    mut record_item: NgRecord = NgRecord(module_index=0, name_start=0, name_end=0, type_id=0, first_field=0, field_count=0, exported=0)
    mut field: NgField = NgField(record_index=0, name_start=0, name_end=0, type_id=0, order=0)
    mut target_type_id: i64 = -1
    mut owner_type_id: i64 = -1
    mut record_index: i64 = 0
    mut field_index: i64 = 0
    match node.right > 0:
        -1:
            return 0
        0:
            target = vector_get<NgAstNode>(&*nodes, node.left)
            match target.kind <=> 2:
                -1:
                    return -14
                0:
                    target_type_id = ng_parameter_type(source, parameters, function.first_parameter, function.parameter_count, target.start, target.end)
                1:
                    match target.kind <=> 14:
                        -1:
                            return -14
                        0:
                            target_type_id = target.right
                        1:
                            return -14
            match target_type_id > 0:
                -1:
                    match target_type_id <= vector_len<NgTypeDescriptor>(types):
                        -1:
                            descriptor = vector_get<NgTypeDescriptor>(types, target_type_id - 1)
                        0:
                            return -14
                        1:
                            return -14
                0:
                    return -14
                1:
                    return -14
            match descriptor.kind <=> 9:
                -1:
                    return -14
                0:
                    owner_type_id = descriptor.target_type
                1:
                    return -14
            match owner_type_id > 0:
                -1:
                    match owner_type_id <= vector_len<NgTypeDescriptor>(types):
                        -1:
                            owner = vector_get<NgTypeDescriptor>(types, owner_type_id - 1)
                        0:
                            return -14
                        1:
                            return -14
                0:
                    return -14
                1:
                    return -14
            match owner.kind <=> 7:
                -1:
                    return -14
                0:
                    record_index = 0
                    while record_index < vector_len<NgRecord>(records):
                        record_item = vector_get<NgRecord>(records, record_index)
                        match record_item.type_id <=> owner_type_id:
                            -1:
                                record_index = record_index + 1
                            0:
                                field_index = record_item.first_field
                                while field_index < record_item.first_field + record_item.field_count:
                                    field = vector_get<NgField>(fields, field_index)
                                    match ng_spans_equal(source, field.name_start, field.name_end, node.operation, node.end):
                                        -1:
                                            node.start = node.operation
                                            node.operation = owner_type_id
                                            node.right = field.type_id
                                            discard vector_set<NgAstNode>(&mut *nodes, node_index, node)
                                            return 0
                                        0:
                                            field_index = field_index + 1
                                        1:
                                            field_index = field_index + 1
                                return -15
                            1:
                                record_index = record_index + 1
                    return -14
                1:
                    return -14
        1:
            return -14

export fn ng_resolve_record_field_nodes(source: &bytes, types: &vector<NgTypeDescriptor>, records: &vector<NgRecord>, fields: &vector<NgField>, functions: &vector<NgFunction>, parameters: &vector<NgParameter>, nodes: &mut vector<NgAstNode>) -> i64:
    mut function_index: i64 = 0
    mut node_index: i64 = 0
    mut function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, local_name_start=0, local_name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0, module_index=0, exported=0)
    mut node: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut status: i64 = 0
    while function_index < vector_len<NgFunction>(functions):
        function = vector_get<NgFunction>(functions, function_index)
        node_index = 0
        while node_index < vector_len<NgAstNode>(&*nodes):
            node = vector_get<NgAstNode>(&*nodes, node_index)
            match node.kind <=> 14:
                -1:
                    node_index = node_index + 1
                0:
                    match node.right < 0:
                        -1:
                            match node.start >= function.start:
                                -1:
                                    match node.end <= function.end:
                                        -1:
                                            status = ng_resolve_record_field_node(source, types, records, fields, function, parameters, nodes, node_index)
                                            match status <=> 0:
                                                -1:
                                                    return status
                                                0:
                                                    node_index = node_index + 1
                                                1:
                                                    return status
                                        0:
                                            node_index = node_index + 1
                                        1:
                                            node_index = node_index + 1
                                0:
                                    node_index = node_index + 1
                                1:
                                    node_index = node_index + 1
                        0:
                            node_index = node_index + 1
                        1:
                            node_index = node_index + 1
                1:
                    node_index = node_index + 1
        function_index = function_index + 1
    return 0

fn ng_check_match_arms(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, locals: &vector<NgLocal>, function: NgFunction, statement: NgAstNode) -> i64:
    mut selector_type: i64 = ng_expression_type(source, types, fields, functions, nodes, parameters, locals, function.first_parameter, function.parameter_count, statement.left)
    mut arm_id: i64 = statement.right
    mut arm: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut body_link: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut body_statement: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut return_type: i64 = 0
    mut local_id: i64 = -1
    mut local_binding: NgLocal = NgLocal(name_start=0, name_end=0, type_kind=0, mutable=0)
    mut body_link_id: i64 = -1
    mut body_returned: i64 = 0
    mut has_fallthrough: i64 = 0
    mut seen_negative: i64 = 0
    mut seen_neutral: i64 = 0
    mut seen_positive: i64 = 0
    match selector_type <=> 2:
        -1:
            return -14
        0:
            selector_type = selector_type
        1:
            return -14
    while arm_id >= 0:
        arm = vector_get<NgAstNode>(nodes, arm_id)
        match arm.kind <=> 13:
            -1:
                return -16
            0:
                match arm.operation <=> -1:
                    -1:
                        match seen_negative <=> 0:
                            -1:
                                return -18
                            0:
                                seen_negative = 1
                            1:
                                return -18
                    0:
                        match arm.operation <=> 0:
                            -1:
                                match seen_negative <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_negative = 1
                                    1:
                                        return -18
                            0:
                                match seen_neutral <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_neutral = 1
                                    1:
                                        return -18
                            1:
                                match seen_positive <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_positive = 1
                                    1:
                                        return -18
                    1:
                        match arm.operation <=> 0:
                            -1:
                                match seen_negative <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_negative = 1
                                    1:
                                        return -18
                            0:
                                match seen_neutral <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_neutral = 1
                                    1:
                                        return -18
                            1:
                                match seen_positive <=> 0:
                                    -1:
                                        return -18
                                    0:
                                        seen_positive = 1
                                    1:
                                        return -18
                body_link_id = arm.left
                body_returned = 0
                while body_link_id >= 0:
                    body_link = vector_get<NgAstNode>(nodes, body_link_id)
                    match body_link.kind <=> 11:
                        -1:
                            return -16
                        0:
                            body_statement = vector_get<NgAstNode>(nodes, body_link.left)
                            match body_statement.kind == 8:
                                -1:
                                    local_id = ng_local_index(source, locals, body_statement.start, body_statement.end)
                                    match local_id < 0:
                                        -1:
                                            return -12
                                        0:
                                            local_binding = vector_get<NgLocal>(locals, local_id)
                                            match local_binding.mutable <=> 1:
                                                -1:
                                                    return -16
                                                0:
                                                    return_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, locals, function.first_parameter, function.parameter_count, body_statement.left, local_binding.type_kind)
                                                    match return_type <=> local_binding.type_kind:
                                                        -1:
                                                            return -14
                                                        0:
                                                            body_returned = body_returned
                                                        1:
                                                            return -14
                                                1:
                                                    return -16
                                        1:
                                            return -12
                                0:
                                    match body_statement.kind == 9:
                                        -1:
                                            return_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, locals, function.first_parameter, function.parameter_count, body_statement.left, function.return_type)
                                            match return_type <=> function.return_type:
                                                -1:
                                                    return -15
                                                0:
                                                    match body_link.right <=> -1:
                                                        -1:
                                                            return -17
                                                        0:
                                                            body_returned = 1
                                                        1:
                                                            return -17
                                                1:
                                                    return -15
                                        0:
                                            return -16
                                        1:
                                            return -16
                                1:
                                    return -16
                        1:
                            return -16
                    body_link_id = body_link.right
                match body_returned <=> 0:
                    -1:
                        return -16
                    0:
                        has_fallthrough = 1
                    1:
                        body_returned = body_returned
            1:
                return -16
        arm_id = arm.right
    match seen_negative == 1:
        -1:
            match seen_neutral == 1:
                -1:
                    match seen_positive == 1:
                        -1:
                            return has_fallthrough
                        0:
                            return -18
                        1:
                            return -18
                0:
                    return -18
                1:
                    return -18
        0:
            return -18
        1:
            return -18

fn ng_check_function_body(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, nodes: &vector<NgAstNode>, parameters: &vector<NgParameter>, function: NgFunction) -> i64:
    mut locals: vector<NgLocal> = vector_new<NgLocal>(8)
    mut link_id: i64 = function.body_node
    mut link: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut statement: NgAstNode = NgAstNode(kind=0, start=0, end=0, left=-1, right=-1, operation=0)
    mut local_binding: NgLocal = NgLocal(name_start=0, name_end=0, type_kind=0, mutable=0)
    mut parameter_type: i64 = 0
    mut local_id: i64 = -1
    mut declared_type: i64 = 0
    mut mutable: i64 = 0
    mut value_type: i64 = 0
    mut saw_return: i64 = 0
    while link_id >= 0:
        link = vector_get<NgAstNode>(nodes, link_id)
        match link.kind <=> 11:
            -1:
                return -16
            0:
                statement = vector_get<NgAstNode>(nodes, link.left)
                match statement.kind == 7:
                    -1:
                        declared_type = statement.operation
                        mutable = 0
                        match declared_type < 0:
                            -1:
                                declared_type = 0 - declared_type
                                mutable = 1
                            0:
                                mutable = 0
                            1:
                                mutable = 0
                        parameter_type = ng_parameter_type(source, parameters, function.first_parameter, function.parameter_count, statement.start, statement.end)
                        local_id = ng_local_index(source, &locals, statement.start, statement.end)
                        match parameter_type >= 0:
                            -1:
                                return -11
                            0:
                                match local_id >= 0:
                                    -1:
                                        return -11
                                    0:
                                        value_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, &locals, function.first_parameter, function.parameter_count, statement.left, declared_type)
                                        match value_type <=> declared_type:
                                            -1:
                                                return -14
                                            0:
                                                discard vector_push<NgLocal>(&mut locals, NgLocal(name_start=statement.start, name_end=statement.end, type_kind=declared_type, mutable=mutable))
                                            1:
                                                return -14
                                    1:
                                        return -11
                            1:
                                return -11
                    0:
                        match statement.kind == 8:
                            -1:
                                local_id = ng_local_index(source, &locals, statement.start, statement.end)
                                match local_id >= 0:
                                    -1:
                                        local_binding = vector_get<NgLocal>(&locals, local_id)
                                        match local_binding.mutable <=> 1:
                                            -1:
                                                return -16
                                            0:
                                                value_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, &locals, function.first_parameter, function.parameter_count, statement.left, local_binding.type_kind)
                                                local_binding = vector_get<NgLocal>(&locals, local_id)
                                                match value_type <=> local_binding.type_kind:
                                                    -1:
                                                        return -14
                                                    0:
                                                        value_type = 0
                                                    1:
                                                        return -14
                                            1:
                                                return -16
                                    0:
                                        return -12
                                    1:
                                        return -12
                            0:
                                match statement.kind == 9:
                                    -1:
                                        value_type = ng_contextual_expression_type(source, types, fields, functions, nodes, parameters, &locals, function.first_parameter, function.parameter_count, statement.left, function.return_type)
                                        match value_type < 0:
                                            -1:
                                                return value_type
                                            0:
                                                match value_type <=> function.return_type:
                                                    -1:
                                                        return -15
                                                    0:
                                                        saw_return = 1
                                                        match link.right >= 0:
                                                            -1:
                                                                return -17
                                                            0:
                                                                link_id = link.right
                                                            1:
                                                                link_id = link.right
                                                    1:
                                                        return -15
                                            1:
                                                return -15
                                    0:
                                        match statement.kind == 12:
                                            -1:
                                                value_type = ng_check_match_arms(source, types, fields, functions, nodes, parameters, &locals, function, statement)
                                                match value_type <=> 0:
                                                    -1:
                                                        return value_type
                                                    0:
                                                        match link.right <=> -1:
                                                            -1:
                                                                return -17
                                                            0:
                                                                saw_return = 1
                                                                link_id = link.right
                                                            1:
                                                                return -17
                                                    1:
                                                        link_id = link.right
                                            0:
                                                return -16
                                            1:
                                                return -16
                                    1:
                                        return -16
                            1:
                                return -16
                    1:
                        return -16
            1:
                return -16
        link_id = link.right
    match saw_return == 1:
        -1:
            return 0
        0:
            return -15
        1:
            return -15

fn ng_check_program_core(source: &bytes, types: &vector<NgTypeDescriptor>, fields: &vector<NgField>, functions: &vector<NgFunction>, parameters: &vector<NgParameter>, nodes: &vector<NgAstNode>) -> i64:
    mut function_index: i64 = 0
    mut prior_function_index: i64 = 0
    mut parameter_index: i64 = 0
    mut prior_parameter_index: i64 = 0
    mut function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, local_name_start=0, local_name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0, module_index=0, exported=0)
    mut prior_function: NgFunction = NgFunction(start=0, end=0, name_start=0, name_end=0, local_name_start=0, local_name_end=0, first_parameter=0, parameter_count=0, return_type=0, body_node=0, module_index=0, exported=0)
    mut parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    mut prior_parameter: NgParameter = NgParameter(name_start=0, name_end=0, type_kind=0)
    mut body_status: i64 = 0
    while function_index < vector_len<NgFunction>(functions):
        function = vector_get<NgFunction>(functions, function_index)
        prior_function_index = 0
        while prior_function_index < function_index:
            prior_function = vector_get<NgFunction>(functions, prior_function_index)
            match ng_spans_equal(source, function.name_start, function.name_end, prior_function.name_start, prior_function.name_end):
                -1:
                    return -10
                0:
                    prior_function_index = prior_function_index + 1
                1:
                    prior_function_index = prior_function_index + 1
        parameter_index = function.first_parameter
        while parameter_index < function.first_parameter + function.parameter_count:
            parameter = vector_get<NgParameter>(parameters, parameter_index)
            prior_parameter_index = function.first_parameter
            while prior_parameter_index < parameter_index:
                prior_parameter = vector_get<NgParameter>(parameters, prior_parameter_index)
                match ng_spans_equal(source, parameter.name_start, parameter.name_end, prior_parameter.name_start, prior_parameter.name_end):
                    -1:
                        return -11
                    0:
                        prior_parameter_index = prior_parameter_index + 1
                    1:
                        prior_parameter_index = prior_parameter_index + 1
            parameter_index = parameter_index + 1
        body_status = ng_check_function_body(source, types, fields, functions, nodes, parameters, function)
        match body_status <=> 0:
            -1:
                return body_status
            0:
                function_index = function_index + 1
            1:
                return body_status
    return 0

export fn ng_check_program(source: &bytes, functions: &vector<NgFunction>, parameters: &vector<NgParameter>, nodes: &vector<NgAstNode>) -> i64:
    mut types: vector<NgTypeDescriptor> = vector_new<NgTypeDescriptor>(6)
    mut fields: vector<NgField> = vector_new<NgField>(1)
    mut status: i64 = ng_initialize_type_table(&mut types)
    match status <=> 0:
        -1:
            return status
        0:
            return ng_check_program_core(source, &types, &fields, functions, parameters, nodes)
        1:
            return status

export fn ng_check_program_typed(source: &bytes, types: &vector<NgTypeDescriptor>, records: &vector<NgRecord>, fields: &vector<NgField>, functions: &vector<NgFunction>, parameters: &vector<NgParameter>, nodes: &mut vector<NgAstNode>) -> i64:
    mut status: i64 = ng_resolve_record_field_nodes(source, types, records, fields, functions, parameters, nodes)
    match status <=> 0:
        -1:
            return status
        0:
            return ng_check_program_core(source, types, fields, functions, parameters, &*nodes)
        1:
            return status
