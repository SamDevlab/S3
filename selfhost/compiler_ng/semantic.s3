                                                -1:
                                                    return 6
                                                0:
                                                    match ng_span_matches_text(source, name_start, name_end, text_from_static("bytes_push")):
                                                        -1:
                                                            return 7
                                                        0:
                                                            match ng_span_matches_text(source, name_start, name_end, text_from_static("text_from_static")):
                                                                -1:
                                                                    return 8
                                                                0:
                                                                    match ng_span_matches_text(source, name_start, name_end, text_from_static("bytes_from_text")):
                                                                        -1:
                                                                            return 9
                                                                        0:
                                                                            return -13
                                                                        1:
                                                                            return -13
