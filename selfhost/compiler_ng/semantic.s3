fn ng_resolve_address_nodes_indexed(source: &bytes, types: &mut vector<NgTypeDescriptor>, functions: &vector<NgFunction>, parameters: &vector<NgParameter>, nodes: &mut vector<NgAstNode>, declaration_indices: &vector<i64>, node_scope_ids: &vector<i64>, scope_parents: &vector<i64>, local_symbols: &mut vector<NgLocalLookupSymbol>, local_buckets: &mut vector<i64>, local_offsets: &mut vector<i64>, local_occurrences: &mut vector<i64>) -> i64:
    mut node_index: i64 = 0
