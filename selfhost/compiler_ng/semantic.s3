    resolution_status = ng_resolve_dereference_nodes(source, &*types, functions, parameters, &mut *nodes, declaration_indices, node_scope_ids, scope_parents, local_symbols, local_buckets, local_offsets, local_occurrences)
    match resolution_status <=> 0:
        0:
