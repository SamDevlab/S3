                match node.right < 0:
                    -1:
                        function_index = 0
                        while function_index < function_count:
                            function = vector_get<NgFunction>(functions, function_index)
                            match node.start >= function.start:
                                -1:
                                    match node.end <= function.end:
                                        -1:
                                            status = ng_resolve_record_field_node(source, types, records, fields, function, parameters, nodes, node_index)
                                            match status <=> 0:
