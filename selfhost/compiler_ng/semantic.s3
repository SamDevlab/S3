                                    return 0
                                1:
                                    return 0
                        -1:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

export fn ng_builtin_call_kind(source: &bytes, name_start: i64, name_end: i64) -> i64:
    match ng_span_matches_text(source, name_start, name_end, text_from_static("to_i64")):
        -1:
