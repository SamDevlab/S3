fn ng_prior_local_declaration(source: &bytes, nodes: &vector<NgAstNode>, function: NgFunction, before_node: NgAstNode, before_node_index: i64, target: NgAstNode, node_scope_ids: &vector<i64>, scope_parents: &vector<i64>, symbols: &mut vector<NgLocalLookupSymbol>, bucket_slots: &mut vector<i64>, symbol_offsets: &mut vector<i64>, occurrence_nodes: &mut vector<i64>) -> NgLocalLookupResult:
