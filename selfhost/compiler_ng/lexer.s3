module selfhost.compiler_ng.lexer

from selfhost.compiler_ng.character_classes import ng_is_digit

export record NgToken:
    kind: i64
    start: i64
    end: i64
    indent: i64

export fn ng_span_fingerprint(source: &bytes, start: i64, end: i64) -> i64:
    mut span_length: i64 = end - start
    mut second: i64 = 0
    mut quarter: i64 = 0
    mut middle: i64 = 0
    mut three_quarter: i64 = 0
    mut penultimate: i64 = 0
    mut fingerprint: i64 = 0
    mut packed_bytes: i64 = 0
    mut byte_index: i64 = start
    match span_length > 0:
        -1:
            match span_length < 8:
                -1:
                    while byte_index < end:
                        packed_bytes = packed_bytes * 256 + to_i64(bytes_get(source, byte_index))
                        byte_index = byte_index + 1
                    # Length-separated packed bytes are injective for spans up to seven bytes.
                    return span_length * 72057594037927936 + packed_bytes
                0:
                    span_length = span_length
                1:
                    span_length = span_length
            middle = to_i64(bytes_get(source, start + span_length / 2))
            second = to_i64(bytes_get(source, start + 1))
            quarter = to_i64(bytes_get(source, start + span_length / 4))
            three_quarter = to_i64(bytes_get(source, start + span_length * 3 / 4))
            penultimate = to_i64(bytes_get(source, end - 2))
            # For longer spans this fingerprint is only a prefilter; exact equality remains authoritative.
            fingerprint = span_length * 4294967296 + to_i64(bytes_get(source, start)) * 16777216 + second * 65536 + quarter * 16384 + middle * 4096 + three_quarter * 1024 + penultimate * 256 + to_i64(bytes_get(source, end - 1))
            return fingerprint
        0:
            return 0
        1:
            return 0

export fn ng_spans_equal(source: &bytes, left_start: i64, left_end: i64, right_start: i64, right_end: i64) -> trit:
    mut left: i64 = left_start
    mut right: i64 = right_start
    mut span_length: i64 = left_end - left_start
    mut last_left: i64 = left_end - 1
    mut last_right: i64 = right_end - 1
    mut source_length: i64 = 0
    match left_start <=> right_start:
        0:
            match left_end <=> right_end:
                0:
                    match span_length > 0:
                        -1:
                            source_length = bytes_len(source)
                            match left_start >= 0:
                                -1:
                                    match left_end <= source_length:
                                        -1:
                                            return -1
                                        0:
                                            source_length = source_length
                                        1:
                                            source_length = source_length
                                0:
                                    source_length = source_length
                                1:
                                    source_length = source_length
                        0:
                            source_length = source_length
                        1:
                            source_length = source_length
                -1:
                    source_length = source_length
                1:
                    source_length = source_length
        -1:
            source_length = source_length
        1:
            source_length = source_length
    match left_end - left_start <=> right_end - right_start:
        -1:
            return 0
        0:
            match span_length > 0:
                -1:
                    match to_i64(bytes_get(source, left_start)) <=> to_i64(bytes_get(source, right_start)):
                        -1:
                            return 0
                        0:
                            match span_length <=> 1:
                                -1:
                                    return -1
                                0:
                                    return -1
                                1:
                                    match to_i64(bytes_get(source, last_left)) <=> to_i64(bytes_get(source, last_right)):
                                        -1:
                                            return 0
                                        0:
                                            match span_length > 3:
                                                -1:
                                                    match to_i64(bytes_get(source, left_start + 1)) <=> to_i64(bytes_get(source, right_start + 1)):
                                                        -1:
                                                            return 0
                                                        0:
                                                            match to_i64(bytes_get(source, last_left - 1)) <=> to_i64(bytes_get(source, last_right - 1)):
                                                                -1:
                                                                    return 0
                                                                0:
                                                                    left = left_start + 2
                                                                    right = right_start + 2
                                                                    last_left = last_left - 1
                                                                    last_right = last_right - 1
                                                                1:
                                                                    return 0
                                                        1:
                                                            return 0
                                                0:
                                                    left = left_start + 1
                                                    right = right_start + 1
                                                1:
                                                    left = left_start + 1
                                                    right = right_start + 1
                                            while left < last_left:
                                                match to_i64(bytes_get(source, left)) <=> to_i64(bytes_get(source, right)):
                                                    -1:
                                                        return 0
                                                    0:
                                                        left = left + 1
                                                        right = right + 1
                                                    1:
                                                        return 0
                                            return -1
                                        1:
                                            return 0
                        1:
                            return 0
                0:
                    return -1
                1:
                    return -1
        1:
            return 0

fn ng_advance_line_indent(source: &bytes, start: i64, end: i64, initial_indent: i64, initial_prefix_open: i64, state: &mut vector<i64>) -> i64:
    mut cursor: i64 = start
    mut unit: i64 = 0
    mut indent: i64 = initial_indent
    mut prefix_open: i64 = initial_prefix_open
    while cursor < end:
        unit = to_i64(bytes_get(source, cursor))
        match unit <=> 10:
            0:
                indent = 0
                prefix_open = 1
            -1:
                match prefix_open <=> 1:
                    0:
                        match unit <=> 32:
                            0:
                                indent = indent + 1
                            -1:
                                match unit <=> 9:
                                    0:
                                        indent = -1
                                    -1:
                                        prefix_open = 0
                                    1:
                                        prefix_open = 0
                                prefix_open = 0
                            1:
                                match unit <=> 9:
                                    0:
                                        indent = -1
                                    -1:
                                        prefix_open = 0
                                    1:
                                        prefix_open = 0
                                prefix_open = 0
                    -1:
                        prefix_open = 0
                    1:
                        prefix_open = 0
            1:
                match prefix_open <=> 1:
                    0:
                        match unit <=> 32:
                            0:
                                indent = indent + 1
                            -1:
                                match unit <=> 9:
                                    0:
                                        indent = -1
                                    -1:
                                        prefix_open = 0
                                    1:
                                        prefix_open = 0
                                prefix_open = 0
                            1:
                                match unit <=> 9:
                                    0:
                                        indent = -1
                                    -1:
                                        prefix_open = 0
                                    1:
                                        prefix_open = 0
                                prefix_open = 0
                    -1:
                        prefix_open = 0
                    1:
                        prefix_open = 0
        cursor = cursor + 1
    discard vector_set<i64>(&mut *state, 0, indent)
    discard vector_set<i64>(&mut *state, 1, prefix_open)
    return 0

fn ng_emit_at(tokens: &mut vector<NgToken>, kind: i64, start: i64, end: i64, indent: i64, base: i64) -> i64:
    discard vector_push<NgToken>(tokens, NgToken(kind=kind, start=start + base, end=end + base, indent=indent))
    return end

fn ng_emit(tokens: &mut vector<NgToken>, kind: i64, start: i64, end: i64, indent: i64) -> i64:
    return ng_emit_at(tokens, kind, start, end, indent, 0)

fn ng_is_alpha(unit: i64) -> trit:
    match unit <=> 91:
        -1:
            match unit <=> 65:
                -1:
                    return 0
                0:
                    return -1
                1:
                    return -1
        0:
            return 0
        1:
            match unit <=> 97:
                -1:
                    return 0
                0:
                    return -1
                1:
                    match unit <=> 123:
                        -1:
                            return -1
                        0:
                            return 0
                        1:
                            return 0

fn ng_is_identifier_start(unit: i64) -> trit:
    match ng_is_alpha(unit):
        -1:
            return -1
        0:
            match unit == 95:
                -1:
                    return -1
                0:
                    return 0
                1:
                    return 0
        1:
            return -1

fn ng_is_identifier_continue(unit: i64) -> trit:
    match ng_is_identifier_start(unit):
        -1:
            return -1
        0:
            return ng_is_digit(unit)
        1:
            return -1

fn ng_is_space(unit: i64) -> trit:
    match unit <=> 32:
        -1:
            match unit == 9:
                -1:
                    return -1
                0:
                    match unit == 10:
                        -1:
                            return -1
                        0:
                            match unit == 13:
                                -1:
                                    return -1
                                0:
                                    return 0
                                1:
                                    return 0
                        1:
                            return 0
                1:
                    return 0
        0:
            return -1
        1:
            return 0

fn ng_is_multi_symbol_start(unit: i64) -> trit:
    match unit <=> 60:
        -1:
            match unit == 33:
                -1:
                    return -1
                0:
                    match unit == 42:
                        -1:
                            return -1
                        0:
                            match unit == 43:
                                -1:
                                    return -1
                                0:
                                    match unit == 45:
                                        -1:
                                            return -1
                                        0:
                                            return 0
                                        1:
                                            return -1
                                1:
                                    return -1
                        1:
                            return -1
                1:
                    return -1
        0:
            return -1
        1:
            match unit <=> 62:
                -1:
                    return -1
                0:
                    return -1
                1:
                    return 0

fn ng_printable_symbol_class(unit: i64) -> i64:
    match ng_is_multi_symbol_start(unit):
        -1:
            return 8
        0:
            return 9
        1:
            return 9

fn ng_other_symbol_class(unit: i64) -> i64:
    match unit < 32:
        -1:
            return 10
        0:
            match unit < 127:
                -1:
                    return ng_printable_symbol_class(unit)
                0:
                    return 10
                1:
                    return 10
        1:
            match unit < 127:
                -1:
                    return ng_printable_symbol_class(unit)
                0:
                    return 10
                1:
                    return 10

fn ng_character_class(unit: i64) -> i64:
    return ng_character_class_exact(unit)

fn ng_character_class_exact(unit: i64) -> i64:
    mut unused: i64 = 0
    match ng_is_digit(unit):
        -1:
            return 1
        0:
            unused = unused
        1:
            unused = unused
    match ng_is_alpha(unit):
        -1:
            return 2
        0:
            unused = unused
        1:
            unused = unused
    match unit <=> 95:
        -1:
            unused = unused
        0:
            return 3
        1:
            unused = unused
    match ng_is_space(unit):
        -1:
            return 4
        0:
            unused = unused
        1:
            unused = unused
    match unit <=> 35:
        -1:
            unused = unused
        0:
            return 5
        1:
            unused = unused
    match unit <=> 47:
        -1:
            unused = unused
        0:
            return 6
        1:
            unused = unused
    match unit <=> 34:
        -1:
            unused = unused
        0:
            return 7
        1:
            unused = unused
    return ng_other_symbol_class(unit)

fn ng_build_character_class_table(classes: &mut vector<i64>) -> i64:
    mut unit: i64 = 0
    mut character_class: i64 = 0
    while unit < 256:
        character_class = ng_character_class_exact(unit)
        match character_class <=> 9:
            0:
                match ng_is_supported_single_symbol(unit) < 0:
                    -1:
                        character_class = character_class
                    0:
                        character_class = 10
                    1:
                        character_class = 10
            -1:
                character_class = character_class
            1:
                character_class = character_class
        discard vector_push<i64>(&mut *classes, character_class)
        unit = unit + 1
    return 0

fn ng_skip_line_comment(source: &bytes, cursor: i64, length: i64) -> i64:
    mut next: i64 = cursor
    mut scanning: i64 = 1
    while scanning == 1:
        match next < length:
            -1:
                match to_i64(bytes_get(source, next)) == 10:
                    -1:
                        scanning = 0
                    0:
                        next = next + 1
                    1:
                        next = next + 1
            0:
                scanning = 0
            1:
                scanning = 0
    return next

fn ng_scan_identifier(source: &bytes, cursor: i64, length: i64, classes: &vector<i64>, tokens: &mut vector<NgToken>, indent: i64, base: i64) -> i64:
    mut next: i64 = cursor + 1
    mut character_class: i64 = 0
    while next < length:
        character_class = vector_get<i64>(classes, to_i64(bytes_get(source, next)))
        match character_class < 4:
            -1:
                next = next + 1
            0:
                return ng_emit_at(tokens, 1, cursor, next, indent, base)
            1:
                return ng_emit_at(tokens, 1, cursor, next, indent, base)
    return ng_emit_at(tokens, 1, cursor, next, indent, base)

fn ng_scan_integer(source: &bytes, cursor: i64, length: i64, classes: &vector<i64>, tokens: &mut vector<NgToken>, indent: i64, base: i64) -> i64:
    mut next: i64 = cursor + 1
    mut scanning: i64 = 1
    mut character_class: i64 = 0
    while scanning == 1:
        match next < length:
            -1:
                character_class = vector_get<i64>(classes, to_i64(bytes_get(source, next)))
                match character_class <=> 1:
                    -1:
                        scanning = 0
                    0:
                        next = next + 1
                    1:
                        scanning = 0
            0:
                scanning = 0
            1:
                scanning = 0
    return ng_emit_at(tokens, 2, cursor, next, indent, base)

fn ng_scan_string(source: &bytes, cursor: i64, length: i64, tokens: &mut vector<NgToken>, indent: i64, base: i64) -> i64:
    mut next: i64 = cursor + 1
    mut escaped: i64 = 0
    mut closed: i64 = 0
    mut scanning: i64 = 1
    while scanning == 1:
        match next < length:
            -1:
                match escaped == 1:
                    -1:
                        escaped = 0
                        next = next + 1
                    0:
                        match to_i64(bytes_get(source, next)) == 92:
                            -1:
                                escaped = 1
                                next = next + 1
                            0:
                                match to_i64(bytes_get(source, next)) == 34:
                                    -1:
                                        closed = 1
                                        next = next + 1
                                        scanning = 0
                                    0:
                                        next = next + 1
                                    1:
                                        next = next + 1
                            1:
                                next = next + 1
                    1:
                        escaped = 0
                        next = next + 1
            0:
                scanning = 0
            1:
                scanning = 0
    match closed == 1:
        -1:
            return ng_emit_at(tokens, 3, cursor, next, indent, base)
        0:
            return -1
        1:
            return ng_emit_at(tokens, 3, cursor, next, indent, base)

fn ng_symbol_kind(source: &bytes, cursor: i64, length: i64) -> i64:
    mut first: i64 = to_i64(bytes_get(source, cursor))
    mut second: i64 = 0
    mut third: i64 = 0
    mut kind: i64 = 0
    match first < 128:
        -1:
            kind = 300 + first
        0:
            return -1
        1:
            return -1
    match cursor + 1 < length:
        -1:
            second = to_i64(bytes_get(source, cursor + 1))
        0:
            second = 0
        1:
            second = 0
    match first <=> 60:
        -1:
            match first <=> 42:
                -1:
                    match first == 33:
                        -1:
                            match second == 61:
                                -1:
                                    return 204
                                0:
                                    return kind
                                1:
                                    return kind
                        0:
                            return kind
                        1:
                            return kind
                0:
                    match second == 61:
                        -1:
                            return 208
                        0:
                            return kind
                        1:
                            return kind
                1:
                    match first <=> 43:
                        -1:
                            return kind
                        0:
                            match second == 61:
                                -1:
                                    return 207
                                0:
                                    return kind
                                1:
                                    return kind
                        1:
                            match first <=> 45:
                                0:
                                    match second == 62:
                                        -1:
                                            return 201
                                        0:
                                            return kind
                                        1:
                                            return kind
                                -1:
                                    return kind
                                1:
                                    return kind
        0:
            match second == 61:
                -1:
                    match cursor + 2 < length:
                        -1:
                            third = to_i64(bytes_get(source, cursor + 2))
                            match third == 62:
                                -1:
                                    return 202
                                0:
                                    return 205
                                1:
                                    return 205
                        0:
                            return 205
                        1:
                            return 205
                0:
                    return kind
                1:
                    return kind
        1:
            match first <=> 61:
                -1:
                    return kind
                0:
                    match second == 61:
                        -1:
                            return 203
                        0:
                            return kind
                        1:
                            return kind
                1:
                    match first <=> 62:
                        0:
                            match second == 61:
                                -1:
                                    return 206
                                0:
                                    return kind
                                1:
                                    return kind
                        -1:
                            return kind
                        1:
                            return kind

fn ng_is_supported_single_symbol(unit: i64) -> trit:
    mut supported: trit = 0
    match unit <=> 38:
        -1:
            supported = supported
        0:
            supported = -1
        1:
            supported = supported
    match unit <=> 91:
        -1:
            supported = supported
        0:
            supported = -1
        1:
            supported = supported
    match unit <=> 93:
        -1:
            supported = supported
        0:
            supported = -1
        1:
            supported = supported
    match unit <=> 40:
        -1:
            supported = supported
        0:
            supported = -1
        1:
            match unit <=> 48:
                -1:
                    supported = -1
                0:
                    supported = supported
                1:
                    supported = supported
    match unit <=> 58:
        -1:
            supported = supported
        0:
            supported = -1
        1:
            match unit <=> 63:
                -1:
                    supported = -1
                0:
                    supported = supported
                1:
                    supported = supported
    match unit <=> 123:
        -1:
            supported = supported
        0:
            supported = -1
        1:
            match unit <=> 127:
                -1:
                    supported = -1
                0:
                    supported = supported
                1:
                    supported = supported
    return supported

fn ng_scan_symbol(source: &bytes, cursor: i64, length: i64, tokens: &mut vector<NgToken>, indent: i64, base: i64) -> i64:
    mut kind: i64 = ng_symbol_kind(source, cursor, length)
    mut width: i64 = 1
    mut supported: trit = 0
    match kind < 300:
        -1:
            supported = -1
        0:
            supported = ng_is_supported_single_symbol(to_i64(bytes_get(source, cursor)))
        1:
            supported = ng_is_supported_single_symbol(to_i64(bytes_get(source, cursor)))
    match supported < 0:
        -1:
            width = 1
        0:
            return -1
        1:
            return -1
    match kind < 0:
        -1:
            return -1
        0:
            match kind < 300:
                -1:
                    match kind == 202:
                        -1:
                            width = 3
                        0:
                            width = 2
                        1:
                            width = 2
                0:
                    width = 1
                1:
                    width = 1
        1:
            match kind < 300:
                -1:
                    match kind == 202:
                        -1:
                            width = 3
                        0:
                            width = 2
                        1:
                            width = 2
                0:
                    width = 1
                1:
                    width = 1
    return ng_emit_at(tokens, kind, cursor, cursor + width, indent, base)

fn ng_scan_single_symbol(source: &bytes, cursor: i64, tokens: &mut vector<NgToken>, indent: i64, base: i64) -> i64:
    mut kind: i64 = 300 + to_i64(bytes_get(source, cursor))
    return ng_emit_at(tokens, kind, cursor, cursor + 1, indent, base)

fn ng_scan_next(source: &bytes, cursor: i64, length: i64, classes: &vector<i64>, tokens: &mut vector<NgToken>, state: &mut vector<i64>, base: i64) -> i64:
    mut next: i64 = cursor
    mut token_start: i64 = cursor
    mut unit: i64 = to_i64(bytes_get(source, cursor))
    mut character_class: i64 = 0
    mut indent: i64 = vector_get<i64>(&*state, 0)
    mut prefix_open: i64 = 0
    character_class = vector_get<i64>(classes, unit)
    match character_class <=> 4:
        0:
            prefix_open = vector_get<i64>(&*state, 1)
            while character_class == 4:
                match unit <=> 10:
                    -1:
                        indent = indent
                    0:
                        indent = 0
                        prefix_open = 1
                    1:
                        match unit <=> 32:
                            -1:
                                indent = indent
                            0:
                                indent = indent + prefix_open
                            1:
                                indent = indent
                next = next + 1
                match next < length:
                    -1:
                        unit = to_i64(bytes_get(source, next))
                        character_class = vector_get<i64>(classes, unit)
                    0:
                        discard vector_set<i64>(&mut *state, 0, indent)
                        discard vector_set<i64>(&mut *state, 1, prefix_open)
                        return next
                    1:
                        discard vector_set<i64>(&mut *state, 0, indent)
                        discard vector_set<i64>(&mut *state, 1, prefix_open)
                        return next
            discard vector_set<i64>(&mut *state, 0, indent)
            discard vector_set<i64>(&mut *state, 1, prefix_open)
            token_start = next
        -1:
            token_start = cursor
        1:
            token_start = cursor
    match character_class < 4:
        -1:
            match character_class <=> 1:
                -1:
                    discard vector_set<i64>(&mut *state, 1, 0)
                    return ng_scan_symbol(source, token_start, length, tokens, indent, base)
                0:
                    discard vector_set<i64>(&mut *state, 1, 0)
                    return ng_scan_integer(source, token_start, length, classes, tokens, indent, base)
                1:
                    discard vector_set<i64>(&mut *state, 1, 0)
                    return ng_scan_identifier(source, token_start, length, classes, tokens, indent, base)
        0:
            character_class = character_class
        1:
            character_class = character_class
    match character_class <=> 8:
        -1:
            match character_class <=> 6:
                -1:
                    discard vector_set<i64>(&mut *state, 1, 0)
                    return ng_skip_line_comment(source, token_start + 1, length)
                0:
                    discard vector_set<i64>(&mut *state, 1, 0)
                    match token_start + 1 < length:
                        -1:
                            match to_i64(bytes_get(source, token_start + 1)) == 47:
                                -1:
                                    return ng_skip_line_comment(source, token_start + 2, length)
                                0:
                                    return ng_scan_single_symbol(source, token_start, tokens, indent, base)
                                1:
                                    return ng_scan_single_symbol(source, token_start, tokens, indent, base)
                        0:
                            return ng_scan_single_symbol(source, token_start, tokens, indent, base)
                        1:
                            return ng_scan_single_symbol(source, token_start, tokens, indent, base)
                1:
                    next = ng_scan_string(source, token_start, length, tokens, indent, base)
                    match next < 0:
                        -1:
                            return -1
                        0:
                            discard ng_advance_line_indent(source, token_start, next, indent, prefix_open, state)
                            return next
                        1:
                            discard ng_advance_line_indent(source, token_start, next, indent, prefix_open, state)
                            return next
        0:
            discard vector_set<i64>(&mut *state, 1, 0)
            return ng_scan_symbol(source, token_start, length, tokens, indent, base)
        1:
            match character_class < 10:
                -1:
                    discard vector_set<i64>(&mut *state, 1, 0)
                    return ng_scan_single_symbol(source, token_start, tokens, indent, base)
                0:
                    return -1
                1:
                    return -1

fn ng_utf8_failure_width(lead_byte: i64) -> i64:
    mut width: i64 = 1
    match lead_byte >= 194:
        -1:
            width = 2
        0:
            width = 1
        1:
            width = width
    match lead_byte >= 224:
        -1:
            width = 3
        0:
            width = width
        1:
            width = width
    match lead_byte >= 240:
        -1:
            width = 4
        0:
            width = width
        1:
            width = width
    return width

fn ng_record_lex_failure(source: &bytes, cursor: i64, length: i64, base: i64, failure: &mut vector<i64>) -> i64:
    mut code: i64 = 10
    mut start: i64 = cursor
    mut end: i64 = cursor + 1
    mut unit: i64 = to_i64(bytes_get(source, cursor))
    mut escaped: i64 = 0
    mut scanning: i64 = 1
    while scanning == 1:
        match start < length:
            -1:
                unit = to_i64(bytes_get(source, start))
                match unit == 32:
                    -1:
                        start = start + 1
                    0:
                        match unit == 9:
                            -1:
                                start = start + 1
                            0:
                                match unit == 10:
                                    -1:
                                        start = start + 1
                                    0:
                                        match unit == 13:
                                            -1:
                                                start = start + 1
                                            0:
                                                scanning = 0
                                            1:
                                                scanning = 0
                                    1:
                                        scanning = 0
                            1:
                                scanning = 0
                    1:
                        scanning = 0
            0:
                scanning = 0
            1:
                scanning = 0
    unit = to_i64(bytes_get(source, start))
    end = start + 1
    match unit <=> 34:
        0:
            code = 11
            end = start + 1
            scanning = 1
            while scanning == 1:
                match end < length:
                    -1:
                        unit = to_i64(bytes_get(source, end))
                        match escaped == 1:
                            -1:
                                escaped = 0
                                end = end + 1
                            0:
                                match unit == 92:
                                    -1:
                                        escaped = 1
                                        end = end + 1
                                    0:
                                        match unit == 10:
                                            -1:
                                                scanning = 0
                                            0:
                                                match unit == 13:
                                                    -1:
                                                        scanning = 0
                                                    0:
                                                        end = end + 1
                                                    1:
                                                        end = end + 1
                                            1:
                                                end = end + 1
                                    1:
                                        end = end + 1
                            1:
                                escaped = 0
                                end = end + 1
                    0:
                        scanning = 0
                    1:
                        scanning = 0
        -1:
            end = start + ng_utf8_failure_width(unit)
        1:
            end = start + ng_utf8_failure_width(unit)
    match end > length:
        -1:
            end = length
        0:
            end = end
        1:
            end = end
    discard vector_push<i64>(failure, code)
    discard vector_push<i64>(failure, start + base)
    discard vector_push<i64>(failure, end + base)
    return 0

export fn ng_lex(source: &bytes, tokens: &mut vector<NgToken>) -> i64:
    return ng_lex_at(source, tokens, 0)

export fn ng_lex_at(source: &bytes, tokens: &mut vector<NgToken>, base: i64) -> i64:
    mut failure: vector<i64> = vector_new<i64>(3)
    return ng_lex_at_with_error(source, tokens, base, &mut failure)

export fn ng_lex_at_with_error(source: &bytes, tokens: &mut vector<NgToken>, base: i64, failure: &mut vector<i64>) -> i64:
    mut cursor: i64 = 0
    mut length: i64 = bytes_len(source)
    mut next: i64 = 0
    mut indent_state: vector<i64> = vector_new<i64>(2)
    mut character_classes: vector<i64> = vector_new<i64>(256)
    mut failed: i64 = 0
    discard ng_build_character_class_table(&mut character_classes)
    discard vector_push<i64>(&mut indent_state, 0)
    discard vector_push<i64>(&mut indent_state, 1)
    while cursor < length:
        next = ng_scan_next(source, cursor, length, &character_classes, tokens, &mut indent_state, base)
        match next < 0:
            -1:
                discard ng_record_lex_failure(source, cursor, length, base, failure)
                failed = 1
                cursor = length
            0:
                cursor = next
            1:
                cursor = next
    match failed == 1:
        -1:
            return -1
        0:
            discard ng_emit_at(tokens, 0, length, length, vector_get<i64>(&indent_state, 0), base)
            return 0
        1:
            return -1
