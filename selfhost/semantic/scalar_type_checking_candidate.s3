fn valid_scalar_type(type_id: tryte) -> trit:
    match type_id <=> 1:
        -1:
            return 0
        0:
            return -1
        1:
            match type_id <=> 4:
                -1:
                    return -1
                0:
                    return -1
                1:
                    return 0

fn accepted(result_type: tryte) -> tryte:
    return 100 + result_type

fn rejected(reason: tryte) -> tryte:
    return 200 + reason

fn same_scalar(left_type: tryte, right_type: tryte) -> trit:
    match valid_scalar_type(left_type):
        -1:
            discard 0
        0:
            return 0
        1:
            discard 0
    match valid_scalar_type(right_type):
        -1:
            discard 0
        0:
            return 0
        1:
            discard 0
    match left_type == right_type:
        -1:
            return -1
        0:
            return 0
        1:
            return 0

fn check_scalar_type(
    operation: tryte,
    left_type: tryte,
    right_type: tryte,
    target_type: tryte
) -> tryte:
    match operation <=> 1:
        -1:
            return rejected(1)
        0:
            match left_type == target_type:
                -1:
                    match valid_scalar_type(left_type):
                        -1:
                            return accepted(target_type)
                        0:
                            return rejected(2)
                        1:
                            return rejected(2)
                0:
                    return rejected(3)
                1:
                    return rejected(3)
        1:
            discard 0

    match operation <=> 2:
        -1:
            discard 0
        0:
            match same_scalar(left_type, right_type):
                -1:
                    return accepted(left_type)
                0:
                    return rejected(4)
                1:
                    return rejected(2)
        1:
            discard 0

    match operation <=> 3:
        -1:
            discard 0
        0:
            match same_scalar(left_type, right_type):
                -1:
                    match left_type <=> 2:
                        -1:
                            return rejected(5)
                        0:
                            return rejected(5)
                        1:
                            return accepted(left_type)
                0:
                    return rejected(4)
                1:
                    return rejected(2)
        1:
            discard 0

    match operation <=> 4:
        -1:
            discard 0
        0:
            match same_scalar(left_type, right_type):
                -1:
                    match left_type <=> 2:
                        -1:
                            return accepted(left_type)
                        0:
                            return accepted(left_type)
                        1:
                            return rejected(5)
                0:
                    return rejected(4)
                1:
                    return rejected(2)
        1:
            discard 0

    match operation <=> 5:
        -1:
            discard 0
        0:
            match same_scalar(left_type, right_type):
                -1:
                    return accepted(1)
                0:
                    return rejected(4)
                1:
                    return rejected(2)
        1:
            discard 0

    match operation <=> 6:
        -1:
            discard 0
        0:
            match left_type <=> 2:
                -1:
                    return accepted(3)
                0:
                    return accepted(3)
                1:
                    return rejected(7)
        1:
            discard 0

    match operation <=> 7:
        -1:
            discard 0
        0:
            match left_type <=> 3:
                -1:
                    return accepted(4)
                0:
                    return accepted(4)
                1:
                    return rejected(7)
        1:
            discard 0

    match operation <=> 8:
        -1:
            return rejected(1)
        0:
            match left_type <=> 3:
                -1:
                    return rejected(7)
                0:
                    return accepted(2)
                1:
                    return rejected(7)
        1:
            return rejected(1)
