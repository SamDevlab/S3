fn add_mod(left: tryte, right: tryte) -> tryte:
    mut result: tryte = left
    match right <=> 0:
        -1:
            mut threshold: tryte = -364 - right
            match left <=> threshold:
                -1:
                    result = left - threshold
                    result += 364
                    result += 1
                0:
                    result = left + right
                1:
                    result = left + right
        0:
            return result
        1:
            mut threshold: tryte = 364 - right
            match left <=> threshold:
                -1:
                    result = left + right
                0:
                    result = left + right
                1:
                    result = left - threshold
                    result = result - 364
                    result = result - 1
    return result

fn fold_identity(value: tryte) -> tryte:
    mut result: tryte = value
    while result < 0:
        result += 181
    while result > 180:
        result = result - 181
    return result

fn compose_ir(expression_identity: tryte, call_identity: tryte) -> tryte:
    mut result: tryte = add_mod(expression_identity, call_identity)
    result = add_mod(result, 285)
    return fold_identity(result)
