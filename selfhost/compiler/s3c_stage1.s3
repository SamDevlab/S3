fn emit_error() -> trit:
    discard write_error_byte(83)
    discard write_error_byte(51)
    discard write_error_byte(95)
    discard write_error_byte(83)
    discard write_error_byte(84)
    discard write_error_byte(65)
    discard write_error_byte(71)
    discard write_error_byte(69)
    discard write_error_byte(49)
    discard write_error_byte(95)
    discard write_error_byte(69)
    discard write_error_byte(82)
    discard write_error_byte(82)
    discard write_error_byte(79)
    discard write_error_byte(82)
    discard write_error_byte(10)
    return -1

fn main() -> tryte:
    mut length: i64 = s3_stage1_source_length()
    mut valid: trit = -1
    match length < 32:
        -1:
            valid = 0
        0:
            discard 0
        1:
            discard 0
    match length > 16384:
        -1:
            valid = 0
        0:
            discard 0
        1:
            discard 0
    valid = merge_check(valid, source_is_valid(length))
    match valid:
        -1:
            mut value: i64 = parsed_number(length)
            match value < -180:
                -1:
                    valid = 0
                0:
                    discard 0
                1:
                    discard 0
            match value > 180:
                -1:
                    discard 0
                0:
                    discard 0
                1:
                    valid = 0
            match valid:
                -1:
                    discard emit_assembly(value)
                    discard s3_stage1_exit(0)
                0:
                    discard emit_error()
                    discard s3_stage1_exit(1)
                1:
                    discard emit_error()
                    discard s3_stage1_exit(1)
        0:
            discard emit_error()
            discard s3_stage1_exit(1)
        1:
            discard emit_error()
            discard s3_stage1_exit(1)
    return 1
