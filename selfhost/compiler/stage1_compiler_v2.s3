fn stage1_function_header_failure() -> Stage1FunctionHeader:
    return Stage1FunctionHeader(
        next_cursor=-1,
        name_start=-1,
        name_end=-1,
        expression_cursor=-1,
        parameter_name_starts=vector_new<i64>(0),
        parameter_name_ends=vector_new<i64>(0),
        parameter_type_codes=vector_new<i64>(0),
        result_type_code=-1,
        accepted=0
    )

fn stage1_parameter_parse_failure() -> Stage1ParameterParse:
    return Stage1ParameterParse(
        next_cursor=-1,
        name_starts=vector_new<i64>(0),
        name_ends=vector_new<i64>(0),
        type_codes=vector_new<i64>(0),
        accepted=0
    )

fn stage1_parameter_type_parse_failure() -> Stage1ParameterTypeParse:
    return Stage1ParameterTypeParse(next_cursor=-1, type_code=-1, accepted=0)

fn stage1_parse_parameter_type(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64
) -> Stage1ParameterTypeParse:
    match generic_native_parser_program_type_code_for_token(source, tokens, cursor) == 2:
        -1:
            return Stage1ParameterTypeParse(
                next_cursor=cursor + 1, type_code=0, accepted=1
            )
        0:
            match generic_native_parser_program_type_code_for_token(source, tokens, cursor) == 6:
                -1:
                    return Stage1ParameterTypeParse(
                        next_cursor=cursor + 1, type_code=2, accepted=1
                    )
                0:
                    match generic_token_kind(tokens, cursor) == 138:
                        -1:
                            match generic_native_parser_program_type_code_for_token(
                                source, tokens, cursor + 1
                            ) == 5:
                                -1:
                                    match generic_token_kind(tokens, cursor + 2) == 160:
                                        -1:
                                            match generic_native_parser_program_type_code_for_token(
                                                source, tokens, cursor + 3
                                            ) == 2:
                                                -1:
                                                    match generic_token_kind(tokens, cursor + 4) == 162:
                                                        -1:
                                                            return Stage1ParameterTypeParse(
                                                                next_cursor=cursor + 5,
                                                                type_code=1,
                                                                accepted=1
                                                            )
                                                        0:
                                                            return stage1_parameter_type_parse_failure()
                                                        1:
                                                            return stage1_parameter_type_parse_failure()
                                                0:
                                                    return stage1_parameter_type_parse_failure()
                                                1:
                                                    return stage1_parameter_type_parse_failure()
                                        0:
                                            return stage1_parameter_type_parse_failure()
                                        1:
                                            return stage1_parameter_type_parse_failure()
                                0:
                                    return stage1_parameter_type_parse_failure()
                                1:
                                    return stage1_parameter_type_parse_failure()
                        0:
                            return stage1_parameter_type_parse_failure()
                        1:
                            return stage1_parameter_type_parse_failure()
                1:
                    return stage1_parameter_type_parse_failure()
        1:
            return stage1_parameter_type_parse_failure()

fn stage1_parameter_name_seen(
    source: &vector<i64>,
    name_starts: &vector<i64>,
    name_ends: &vector<i64>,
    wanted_start: i64,
    wanted_end: i64,
    index: i64
) -> i64:
    match index < vector_len<i64>(name_starts):
        -1:
            match stage1_source_spans_equal(
                source,
                wanted_start,
                wanted_end,
                vector_get<i64>(name_starts, index),
                vector_get<i64>(name_ends, index)
            ):
                -1:
                    return 1
                0:
                    return stage1_parameter_name_seen(
                        source, name_starts, name_ends,
                        wanted_start, wanted_end, index + 1
                    )
                1:
                    return stage1_parameter_name_seen(
                        source, name_starts, name_ends,
                        wanted_start, wanted_end, index + 1
                    )
        0:
            return 0
        1:
            return 0

fn stage1_parameter_names_unique(
    source: &vector<i64>,
    name_starts: &vector<i64>,
    name_ends: &vector<i64>,
    index: i64
) -> i64:
    match index < vector_len<i64>(name_starts):
        -1:
            match stage1_parameter_name_seen(
                source,
                name_starts,
                name_ends,
                vector_get<i64>(name_starts, index),
                vector_get<i64>(name_ends, index),
                index + 1
            ) == 0:
                -1:
                    return stage1_parameter_names_unique(
                        source, name_starts, name_ends, index + 1
                    )
                0:
                    return 0
                1:
                    return 0
        0:
            return 1
        1:
            return 1

fn stage1_parse_parameters(
    source: &vector<i64>,
    tokens: &vector<i64>,
    start_cursor: i64
) -> Stage1ParameterParse:
    mut token_count: i64 = generic_token_count(tokens)
    mut cursor: i64 = start_cursor
    mut name_starts: vector<i64> = vector_new<i64>(64)
    mut name_ends: vector<i64> = vector_new<i64>(64)
    mut type_codes: vector<i64> = vector_new<i64>(64)
    match cursor < token_count:
        -1:
            discard 0
        0:
            return stage1_parameter_parse_failure()
        1:
            return stage1_parameter_parse_failure()
    match generic_token_kind(tokens, cursor) == 8:
        -1:
            return Stage1ParameterParse(
                next_cursor=cursor + 1,
                name_starts=name_starts,
                name_ends=name_ends,
                type_codes=type_codes,
                accepted=1
            )
        0:
            discard 0
        1:
            discard 0
    mut parsing: i64 = 1
    mut accepted: i64 = 1
    while parsing == 1:
        match cursor < token_count:
            -1:
                discard 0
            0:
                accepted = 0
                parsing = 0
            1:
                accepted = 0
                parsing = 0
        match accepted == 1:
            -1:
                match generic_token_kind(tokens, cursor) == 1:
                    -1:
                        discard vector_push<i64>(
                            &mut name_starts, generic_token_start(tokens, cursor)
                        )
                        discard vector_push<i64>(
                            &mut name_ends, generic_token_end(tokens, cursor)
                        )
                        cursor = cursor + 1
                        match generic_token_kind(tokens, cursor) == 158:
                            -1:
                                cursor = cursor + 1
                                mut parsed_type: Stage1ParameterTypeParse = stage1_parse_parameter_type(
                                    source, tokens, cursor
                                )
                                match parsed_type.accepted == 1:
                                    -1:
                                        cursor = parsed_type.next_cursor
                                        discard vector_push<i64>(
                                            &mut type_codes, parsed_type.type_code
                                        )
                                    0:
                                        accepted = 0
                                    1:
                                        accepted = 0
                            0:
                                accepted = 0
                            1:
                                accepted = 0
                        match accepted == 1:
                            -1:
                                match generic_token_kind(tokens, cursor) == 144:
                                    -1:
                                        cursor = cursor + 1
                                    0:
                                        match generic_token_kind(tokens, cursor) == 8:
                                            -1:
                                                return Stage1ParameterParse(
                                                    next_cursor=cursor + 1,
                                                    name_starts=name_starts,
                                                    name_ends=name_ends,
                                                    type_codes=type_codes,
                                                    accepted=1
                                                )
                                            0:
                                                accepted = 0
                                                parsing = 0
                                            1:
                                                accepted = 0
                                                parsing = 0
                                    1:
                                        accepted = 0
                                        parsing = 0
                            0:
                                parsing = 0
                            1:
                                parsing = 0
                    0:
                        accepted = 0
                        parsing = 0
                    1:
                        accepted = 0
                        parsing = 0
            0:
                parsing = 0
            1:
                parsing = 0
    return stage1_parameter_parse_failure()

fn stage1_function_body_end(
    source: &vector<i64>,
    tokens: &vector<i64>,
    body_cursor: i64
) -> i64:
    mut token_count: i64 = generic_token_count(tokens)
    mut cursor: i64 = body_cursor
    mut line_count: i64 = 0
    mut finished: i64 = 0
    while cursor < token_count:
        match finished == 0:
            -1:
                match generic_token_kind(tokens, cursor) == 6:
                    -1:
                        cursor = cursor + 1
                    0:
                        mut indent: i64 = generic_native_parser_program_indent(
                            source, generic_token_start(tokens, cursor)
                        )
                        match indent == 4:
                            -1:
                                mut line_end: i64 = cursor
                                mut next_line_cursor: i64 = -1
                                while line_end < token_count:
                                    match generic_token_kind(tokens, line_end) == 6:
                                        -1:
                                            next_line_cursor = line_end + 1
                                            line_end = token_count
                                        0:
                                            line_end = line_end + 1
                                        1:
                                            line_end = line_end + 1
                                match next_line_cursor >= 0:
                                    -1:
                                        cursor = next_line_cursor
                                        line_count = line_count + 1
                                    0:
                                        return -1
                                    1:
                                        return -1
                            0:
                                match indent < 4:
                                    -1:
                                        finished = 1
                                    0:
                                        return -1
                                    1:
                                        return -1
                            1:
                                match indent < 4:
                                    -1:
                                        finished = 1
                                    0:
                                        return -1
                                    1:
                                        return -1
                    1:
                        mut indent: i64 = generic_native_parser_program_indent(
                            source, generic_token_start(tokens, cursor)
                        )
                        match indent == 4:
                            -1:
                                mut line_end: i64 = cursor
                                mut next_line_cursor: i64 = -1
                                while line_end < token_count:
                                    match generic_token_kind(tokens, line_end) == 6:
                                        -1:
                                            next_line_cursor = line_end + 1
                                            line_end = token_count
                                        0:
                                            line_end = line_end + 1
                                        1:
                                            line_end = line_end + 1
                                match next_line_cursor >= 0:
                                    -1:
                                        cursor = next_line_cursor
                                        line_count = line_count + 1
                                    0:
                                        return -1
                                    1:
                                        return -1
                            0:
                                match indent < 4:
                                    -1:
                                        finished = 1
                                    0:
                                        return -1
                                    1:
                                        return -1
                            1:
                                match indent < 4:
                                    -1:
                                        finished = 1
                                    0:
                                        return -1
                                    1:
                                        return -1
            0:
                return cursor
            1:
                return cursor
    match line_count > 0:
        -1:
            return cursor
        0:
            return -1
        1:
            return -1

fn stage1_parse_function_header_core(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64
) -> Stage1FunctionHeader:
    mut token_count: i64 = generic_token_count(tokens)
    mut valid: i64 = 1
    match cursor >= 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match generic_token_kind(tokens, cursor) == 2:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match generic_token_kind(tokens, cursor + 1) == 1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match generic_token_kind(tokens, cursor + 2) == 7:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    mut parameters: Stage1ParameterParse = stage1_parse_parameters(
        source, tokens, cursor + 3
    )
    match parameters.accepted == 1:
        -1:
            match stage1_parameter_names_unique(
                source,
                &parameters.name_starts,
                &parameters.name_ends,
                0
            ) == 1:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    mut suffix: i64 = parameters.next_cursor
    mut result_type_code: i64 = -1
    match generic_token_kind(tokens, suffix) == 145:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match generic_token_kind(tokens, suffix + 1) == 162:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match generic_native_parser_program_type_code_for_token(source, tokens, suffix + 2) == 2:
        -1:
            result_type_code = 0
        0:
            match generic_native_parser_program_type_code_for_token(
                source, tokens, suffix + 2
            ) == 6:
                -1:
                    result_type_code = 1
                0:
                    valid = 0
                1:
                    valid = 0
        1:
            valid = 0
    match generic_token_kind(tokens, suffix + 3) == 158:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match generic_token_kind(tokens, suffix + 4) == 6:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    mut body_cursor: i64 = suffix + 5
    match valid == 1:
        -1:
            mut next_cursor: i64 = stage1_function_body_end(source, tokens, body_cursor)
            match next_cursor >= 0:
                -1:
                    return Stage1FunctionHeader(
                        next_cursor=next_cursor,
                        name_start=generic_token_start(tokens, cursor + 1),
                        name_end=generic_token_end(tokens, cursor + 1),
                        expression_cursor=body_cursor,
                        parameter_name_starts=parameters.name_starts,
                        parameter_name_ends=parameters.name_ends,
                        parameter_type_codes=parameters.type_codes,
                        result_type_code=result_type_code,
                        accepted=1
                    )
                0:
                    return stage1_function_header_failure()
                1:
                    return stage1_function_header_failure()
        0:
            return stage1_function_header_failure()
        1:
            return stage1_function_header_failure()

fn stage1_parse_function_header(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64
) -> Stage1FunctionHeader:
    return stage1_parse_function_header_core(source, tokens, cursor)

fn stage1_source_spans_equal(
    source: &vector<i64>,
    first_start: i64,
    first_end: i64,
    second_start: i64,
    second_end: i64
) -> trit:
    match first_end - first_start == second_end - second_start:
        -1:
            mut offset: i64 = 0
            while offset < first_end - first_start:
                match vector_get<i64>(source, first_start + offset) == vector_get<i64>(source, second_start + offset):
                    -1:
                        offset = offset + 1
                    0:
                        return 0
                    1:
                        return 0
            return -1
        0:
            return 0
        1:
            return 0

fn stage1_find_function_id_by_source_name(
    function_ids: &vector<i64>,
    function_name_first: &vector<i64>,
    function_name_count: &vector<i64>,
    function_name_bytes: &vector<i64>,
    source: &vector<i64>,
    name_start: i64,
    name_end: i64
) -> i64:
    mut function_index: i64 = 0
    mut source_name_length: i64 = name_end - name_start
    while function_index < i64_vector_len(function_ids):
        match i64_vector_get(function_name_count, function_index) == source_name_length:
            -1:
                mut offset: i64 = 0
                mut equal: i64 = 1
                mut first: i64 = i64_vector_get(function_name_first, function_index)
                while offset < source_name_length:
                    match vector_get<i64>(source, name_start + offset) == i64_vector_get(function_name_bytes, first + offset):
                        -1:
                            discard 0
                        0:
                            equal = 0
                        1:
                            equal = 0
                    offset = offset + 1
                match equal == 1:
                    -1:
                        return i64_vector_get(function_ids, function_index)
                    0:
                        function_index = function_index + 1
                    1:
                        function_index = function_index + 1
            0:
                function_index = function_index + 1
            1:
                function_index = function_index + 1
    return -1

export fn stage1_output_chunk(output: &vector<i64>, start: i64) -> i64:
    mut index: i64 = 0
    mut packed: i64 = 0
    mut scanning: i64 = 1
    while scanning == 1:
        match index < 8:
            -1:
                match start + index < vector_len<i64>(output):
                    -1:
                        packed = packed * 128 + vector_get<i64>(output, start + index)
                        index = index + 1
                    0:
                        scanning = 0
                    1:
                        scanning = 0
            0:
                scanning = 0
            1:
                scanning = 0
    return packed

fn stage1_compile_single_main(source: vector<i64>) -> Stage1CompileResult:
    mut source_length: i64 = vector_len<i64>(&source)
    match source_length <= 4096:
        -1:
            discard 0
        0:
            return stage1_empty_result(1, 1)
        1:
            return stage1_empty_result(1, 1)
    mut tokens: vector<i64> = generic_lexer_scan(&source)
    mut token_count: i64 = generic_token_count(&tokens)
    match token_count <= 1025:
        -1:
            discard 0
        0:
            return stage1_empty_result(2, 2)
        1:
            return stage1_empty_result(2, 2)
    match generic_token_kind(&tokens, 0) == 2:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 3)
        1:
            return stage1_empty_result(3, 3)
    match generic_token_kind(&tokens, 1) == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 4)
        1:
            return stage1_empty_result(3, 4)
    match generic_token_end(&tokens, 1) - generic_token_start(&tokens, 1) == 4:
        -1:
            match vector_get<i64>(&source, generic_token_start(&tokens, 1)) == 109:
                -1:
                    match vector_get<i64>(&source, generic_token_start(&tokens, 1) + 1) == 97:
                        -1:
                            match vector_get<i64>(&source, generic_token_start(&tokens, 1) + 2) == 105:
                                -1:
                                    match vector_get<i64>(&source, generic_token_start(&tokens, 1) + 3) == 110:
                                        -1:
                                            discard 0
                                        0:
                                            return stage1_empty_result(3, 4)
                                        1:
                                            return stage1_empty_result(3, 4)
                                0:
                                    return stage1_empty_result(3, 4)
                                1:
                                    return stage1_empty_result(3, 4)
                        0:
                            return stage1_empty_result(3, 4)
                        1:
                            return stage1_empty_result(3, 4)
                0:
                    return stage1_empty_result(3, 4)
                1:
                    return stage1_empty_result(3, 4)
        0:
            return stage1_empty_result(3, 4)
        1:
            return stage1_empty_result(3, 4)
    match generic_token_kind(&tokens, 2) == 7:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 5)
        1:
            return stage1_empty_result(3, 5)
    match generic_token_kind(&tokens, 3) == 8:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 6)
        1:
            return stage1_empty_result(3, 6)
    match generic_token_kind(&tokens, 4) == 145:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 7)
        1:
            return stage1_empty_result(3, 7)
    match generic_token_kind(&tokens, 5) == 162:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 8)
        1:
            return stage1_empty_result(3, 8)
    match generic_native_parser_program_type_code_for_token(&source, &tokens, 6) == 2:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 9)
        1:
            return stage1_empty_result(3, 9)
    match generic_token_kind(&tokens, 7) == 158:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 10)
        1:
            return stage1_empty_result(3, 10)
    match generic_token_kind(&tokens, 8) == 6:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 11)
        1:
            return stage1_empty_result(3, 11)
    match generic_native_parser_program_indent(&source, generic_token_start(&tokens, 9)) == 4:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 12)
        1:
            return stage1_empty_result(3, 12)
    match generic_token_kind(&tokens, 9) == 3:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 13)
        1:
            return stage1_empty_result(3, 13)
    mut expression_tree: vector<i64> = generic_native_parser_parse_expression(
        &source, &tokens, 10, 0
    )
    mut expression_result: i64 = generic_expression_packed_result(&expression_tree)
    match expression_result <=> 0:
        -1:
            return stage1_empty_result(3, 14)
        0:
            return stage1_empty_result(3, 14)
        1:
            discard 0
    mut root_node: i64 = generic_native_parser_packed_node(expression_result)
    mut cursor: i64 = generic_native_parser_packed_cursor(expression_result)
    match generic_token_kind(&tokens, cursor) == 6:
        -1:
            cursor = cursor + 1
        0:
            return stage1_empty_result(3, 15)
        1:
            return stage1_empty_result(3, 15)
    match generic_token_kind(&tokens, cursor) == 0:
        -1:
            cursor = cursor + 1
        0:
            return stage1_empty_result(3, 16)
        1:
            return stage1_empty_result(3, 16)
    match cursor == token_count:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 17)
        1:
            return stage1_empty_result(3, 17)
    match generic_expression_node_count(&expression_tree) <= 63:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 18)
        1:
            return stage1_empty_result(3, 18)
    mut program: NativeIR = native_ir_empty()
    mut function_append: NativeIRAppendResult = native_ir_append_function(program, 0, 1)
    match function_append.accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(4, 18)
        1:
            return stage1_empty_result(4, 18)
    program = function_append.program
    mut block_append: NativeIRAppendResult = native_ir_append_block(program, 0, 1)
    match block_append.accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(4, 18)
        1:
            return stage1_empty_result(4, 18)
    program = block_append.program
    mut empty_symbol_name_starts: vector<i64> = vector_new<i64>(0)
    mut empty_symbol_name_ends: vector<i64> = vector_new<i64>(0)
    mut empty_symbol_value_ids: vector<i64> = vector_new<i64>(0)
    mut lowered: Stage1LowerResult = stage1_lower_expression(
        root_node, &source, &expression_tree, program, 0, 0,
        &empty_symbol_name_starts, &empty_symbol_name_ends, &empty_symbol_value_ids
    )
    match lowered.accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(4, 19)
        1:
            return stage1_empty_result(4, 19)
    mut return_value: i64 = lowered.value_id
    program = lowered.program
    mut return_append: NativeIRAppendResult = native_ir_append_instruction(
        program, 1, 0, return_value, -1
    )
    match return_append.accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(4, 20)
        1:
            return stage1_empty_result(4, 20)
    program = return_append.program
    mut verified: NativeIRVerifiedResult = verify_program(program)
    mut verification: NativeVerification = verified.verification
    program = verified.program
    mut emission_view: vector<i64> = native_ir_emission_view(program)
    mut instruction_count: i64 = stage1_emission_instruction_count(&emission_view)
    mut value_count: i64 = stage1_emission_value_count(&emission_view)
    match verification.accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(5, verification.diagnostic_code)
        1:
            return stage1_empty_result(5, verification.diagnostic_code)
    mut output: vector<i64> = vector_new<i64>(16384)
    discard stage1_emit_single_main_program(&emission_view, &mut output)
    mut sink: OutputSinkState = output_sink_new(16384)
    sink = output_sink_append_bytes(sink, output)
    match sink.failed == 0:
        -1:
            discard 0
        0:
            return stage1_empty_result(6, 20)
        1:
            return stage1_empty_result(6, 20)
    sink = output_sink_commit(sink)
    match sink.failed == 0:
        -1:
            discard 0
        0:
            return stage1_empty_result(6, 21)
        1:
            return stage1_empty_result(6, 21)
    return stage1_result(
        1, 0, 0, sink.buffer,
        instruction_count,
        value_count,
        verification
    )

