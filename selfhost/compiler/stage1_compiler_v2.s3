fn stage1_source_name_is_discard(
    source: &vector<i64>, start: i64, end: i64
) -> i64:
    mut expected: vector<i64> = vector_new<i64>(7)
    discard vector_push<i64>(&mut expected, 100)
    discard vector_push<i64>(&mut expected, 105)
    discard vector_push<i64>(&mut expected, 115)
    discard vector_push<i64>(&mut expected, 99)
    discard vector_push<i64>(&mut expected, 97)
