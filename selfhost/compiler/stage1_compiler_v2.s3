                1:
                    return 0
        1:
            return 0
    return 1

fn stage1_emit_cfg_target(
    output: &mut vector<i64>,
    block_id: i64,
    entry_block_id: i64
) -> i64:
    match block_id == entry_block_id:
        -1:
            discard stage1_emit_cfg_literal(output, 1)
        0:
            discard vector_push<i64>(output, 98)
            discard stage1_emit_decimal(output, block_id)
        1:
            return 0
    return 1

fn stage1_emit_cfg_block_label(
    output: &mut vector<i64>,
    block_id: i64,
    is_entry: i64
) -> i64:
    match is_entry == 1:
        -1:
            discard stage1_emit_literal(output, 6)
        0:
            discard stage1_emit_cfg_literal(output, 0)
            discard stage1_emit_decimal(output, block_id)
            discard stage1_emit_cfg_literal(output, 5)
        1:
            return 0
    return 1

fn stage1_emission_value_count(view: &vector<i64>) -> i64:
    return vector_get<i64>(view, 0)

fn stage1_emission_instruction_count(view: &vector<i64>) -> i64:
    return vector_get<i64>(view, 1)

fn stage1_emission_value_id(view: &vector<i64>, index: i64) -> i64:
    return vector_get<i64>(view, 3 + index)

fn stage1_emission_operand_id(view: &vector<i64>, index: i64) -> i64:
    mut value_count: i64 = stage1_emission_value_count(view)
    return vector_get<i64>(view, 3 + value_count + index)

fn stage1_emission_instruction_field(view: &vector<i64>, index: i64, field: i64) -> i64:
    mut value_count: i64 = stage1_emission_value_count(view)
    mut operand_count: i64 = vector_get<i64>(view, 2)
    mut start: i64 = 3 + value_count + operand_count + index * 5
    return vector_get<i64>(view, start + field)

