                0:
                    match stage1_type_is_i64_vector_reference(
                        type_id, type_kinds, type_element_ids,
                        type_mutability_flags, type_lengths, 0
                    ) == 1:
                        -1:
                            return stage1_emit_ir_vector_reference_type_suffix(0, output)
                        0:
