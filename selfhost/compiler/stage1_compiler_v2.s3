    parameter_value_ids: &vector<i64>,
    parameter_type_ids: &vector<i64>,
    type_kinds: &vector<i64>,
    type_element_ids: &vector<i64>,
    type_mutability_flags: &vector<i64>,
    type_lengths: &vector<i64>,
    function_index: i64,
    output: &mut vector<i64>
) -> i64:
    mut first: i64 = i64_vector_get(function_parameter_first, function_index)
    mut count: i64 = i64_vector_get(function_parameter_count, function_index)
    mut index: i64 = 0
    while index < count:
        discard stage1_emit_literal(output, 3)
        discard stage1_emit_register(output, i64_vector_get(parameter_value_ids, first + index))
        match stage1_emit_ir_parameter_type_suffix(
            i64_vector_get(parameter_type_ids, first + index),
            type_kinds,
            type_element_ids,
            type_mutability_flags,
            type_lengths,
            output
        ) == 1:
            -1:
                discard 0
            0:
                return 0
            1:
                return 0
        index = index + 1
    return 1

fn stage1_emit_ir_callee_name(
    function_ids: &vector<i64>,
    function_name_first: &vector<i64>,
    function_name_count: &vector<i64>,
    function_name_bytes: &vector<i64>,
    callee_id: i64,
    output: &mut vector<i64>
) -> i64:
    mut index: i64 = 0
    while index < i64_vector_len(function_ids):
        match i64_vector_get(function_ids, index) == callee_id:
            -1:
                discard stage1_emit_ir_function_name(
                    function_name_first, function_name_count, function_name_bytes, index, output
                )
                index = i64_vector_len(function_ids)
            0:
                index = index + 1
            1:
                index = index + 1
    return 1

fn stage1_emit_ir_value_group(
    values: &vector<i64>,
    first: i64,
    count: i64,
    output: &mut vector<i64>
) -> i64:
    match count >= 1:
        -1:
            discard 0
        0:
            return 0
        1:
            return 0
    match count == 1:
        -1:
            discard 0
        0:
            discard vector_push<i64>(output, 91)
        1:
            discard vector_push<i64>(output, 91)
    mut index: i64 = 0
    while index < count:
        match index == 0:
            -1:
                discard 0
            0:
                discard stage1_emit_literal(output, 8)
            1:
                discard stage1_emit_literal(output, 8)
        discard stage1_emit_register(output, i64_vector_get(values, first + index))
        index = index + 1
    match count == 1:
        -1:
            discard 0
        0:
            discard vector_push<i64>(output, 93)
        1:
            discard vector_push<i64>(output, 93)
    return 1

fn stage1_emit_memory_declaration(
    memory_id: i64,
    type_id: i64,
    length: i64,
    output: &mut vector<i64>
) -> i64:
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 46)
    discard vector_push<i64>(output, 109)
    discard vector_push<i64>(output, 101)
    discard vector_push<i64>(output, 109)
    discard vector_push<i64>(output, 111)
    discard vector_push<i64>(output, 114)
    discard vector_push<i64>(output, 121)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 109)
    discard stage1_emit_decimal(output, memory_id)
    discard vector_push<i64>(output, 44)
    discard vector_push<i64>(output, 32)
    match type_id == 0:
        -1:
            discard vector_push<i64>(output, 105)
            discard vector_push<i64>(output, 54)
            discard vector_push<i64>(output, 52)
        0:
            match type_id == 1:
                -1:
                    discard vector_push<i64>(output, 116)
                    discard vector_push<i64>(output, 114)
                    discard vector_push<i64>(output, 105)
                    discard vector_push<i64>(output, 116)
                0:
                    return 0
                1:
                    return 0
        1:
            return 0
    discard vector_push<i64>(output, 44)
    discard vector_push<i64>(output, 32)
    discard stage1_emit_decimal(output, length)
    discard vector_push<i64>(output, 44)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 109)
    discard vector_push<i64>(output, 117)
    discard vector_push<i64>(output, 116)
    discard vector_push<i64>(output, 97)
    discard vector_push<i64>(output, 98)
    discard vector_push<i64>(output, 108)
    discard vector_push<i64>(output, 101)
    discard vector_push<i64>(output, 10)
    return 1

fn stage1_emit_ir_memory_declarations(
    memory_ids: &vector<i64>,
    memory_types: &vector<i64>,
    memory_lengths: &vector<i64>,
    instruction_ids: &vector<i64>,
    instruction_function_ids: &vector<i64>,
    instruction_memory_ids: &vector<i64>,
    function_id: i64,
    output: &mut vector<i64>
) -> i64:
    mut memory_index: i64 = 0
    while memory_index < i64_vector_len(memory_ids):
        mut memory_id: i64 = i64_vector_get(memory_ids, memory_index)
        mut used: i64 = 0
        mut instruction_index: i64 = 0
        while instruction_index < i64_vector_len(instruction_ids):
            match i64_vector_get(instruction_function_ids, instruction_index) == function_id:
                -1:
                    match i64_vector_get(instruction_memory_ids, instruction_index) == memory_id:
                        -1:
                            used = 1
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
            instruction_index = instruction_index + 1
        match used == 1:
            -1:
                match stage1_emit_memory_declaration(
                    memory_id,
                    i64_vector_get(memory_types, memory_index),
                    i64_vector_get(memory_lengths, memory_index),
                    output
                ) == 1:
                    -1:
                        discard 0
                    0:
                        return 0
                    1:
                        return 0
            0:
                discard 0
            1:
                discard 0
        memory_index = memory_index + 1
    return 1

fn stage1_emit_ir_memory_instruction(
    opcode: i64,
    memory_id: i64,
