            discard vector_push<i64>(output, 54)
            discard vector_push<i64>(output, 52)
            return 1
        0:
            match type_id == 1:
                -1:
                    discard vector_push<i64>(output, 116)
                    discard vector_push<i64>(output, 114)
                    discard vector_push<i64>(output, 105)
                    discard vector_push<i64>(output, 116)
                    return 1
                0:
                    match type_id >= 0:
                        -1:
                            match type_id < vector_len<i64>(type_kinds):
