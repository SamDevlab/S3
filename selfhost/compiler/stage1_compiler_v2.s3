    return stage1_source_span_matches_bytes(source, start, end, &expected)

fn stage1_source_name_is_vector_push(
    source: &vector<i64>, start: i64, end: i64
) -> i64:
    mut expected: vector<i64> = vector_new<i64>(11)
    discard vector_push<i64>(&mut expected, 118)
    discard vector_push<i64>(&mut expected, 101)
    discard vector_push<i64>(&mut expected, 99)
    discard vector_push<i64>(&mut expected, 116)
    discard vector_push<i64>(&mut expected, 111)
    discard vector_push<i64>(&mut expected, 114)
    discard vector_push<i64>(&mut expected, 95)
    discard vector_push<i64>(&mut expected, 112)
    discard vector_push<i64>(&mut expected, 117)
    discard vector_push<i64>(&mut expected, 115)
    discard vector_push<i64>(&mut expected, 104)
    return stage1_source_span_matches_bytes(source, start, end, &expected)

fn stage1_source_name_is_vector_new(
    source: &vector<i64>, start: i64, end: i64
) -> i64:
    mut expected: vector<i64> = vector_new<i64>(10)
    discard vector_push<i64>(&mut expected, 118)
    discard vector_push<i64>(&mut expected, 101)
    discard vector_push<i64>(&mut expected, 99)
    discard vector_push<i64>(&mut expected, 116)
    discard vector_push<i64>(&mut expected, 111)
    discard vector_push<i64>(&mut expected, 114)
    discard vector_push<i64>(&mut expected, 95)
    discard vector_push<i64>(&mut expected, 110)
    discard vector_push<i64>(&mut expected, 101)
    discard vector_push<i64>(&mut expected, 119)
    return stage1_source_span_matches_bytes(source, start, end, &expected)

fn stage1_parse_vector_parameter_type(
    source: &vector<i64>,
    tokens: &vector<i64>,
    vector_cursor: i64,
    next_cursor: i64,
    type_code: i64
) -> Stage1ParameterTypeParse:
    match generic_native_parser_program_type_code_for_token(
        source, tokens, vector_cursor
    ) == 5:
        -1:
            match generic_token_kind(tokens, vector_cursor + 1) == 160:
                -1:
                    match generic_native_parser_program_type_code_for_token(
                        source, tokens, vector_cursor + 2
                    ) == 2:
                        -1:
                            match generic_token_kind(tokens, vector_cursor + 3) == 162:
                                -1:
                                    return Stage1ParameterTypeParse(
                                        next_cursor=next_cursor,
                                        type_code=type_code,
                                        accepted=1
                                    )
                                0:
                                    return stage1_parameter_type_parse_failure()
                                1:
                                    return stage1_parameter_type_parse_failure()
                        0:
                            return stage1_parameter_type_parse_failure()
                        1:
                            return stage1_parameter_type_parse_failure()
                0:
                    return stage1_parameter_type_parse_failure()
                1:
                    return stage1_parameter_type_parse_failure()
        0:
            return stage1_parameter_type_parse_failure()
        1:
            return stage1_parameter_type_parse_failure()

fn stage1_generic_vector_builtin_id(
    source: &vector<i64>,
    start: i64,
    end: i64
) -> i64:
    match stage1_source_name_is_vector_get(source, start, end) == 1:
        -1:
            return 1000
        0:
            match stage1_source_name_is_vector_len(source, start, end) == 1:
                -1:
                    return 1001
                0:
                    match stage1_source_name_is_vector_push(source, start, end) == 1:
                        -1:
                            return 1002
                        0:
                            match stage1_source_name_is_vector_new(source, start, end) == 1:
                                -1:
                                    return 1003
                                0:
                                    return -1
                                1:
                                    return 1003
                        1:
                            return -1
                1:
                    return -1
        1:
            return 1000

fn stage1_lower_call_arguments_to_id(
    node: i64,
    source: &vector<i64>,
    tree: &vector<i64>,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    callee_id: i64,
    symbol_name_starts: &vector<i64>,
    symbol_name_ends: &vector<i64>,
    symbol_value_ids: &vector<i64>,
    symbol_memory_ids: &vector<i64>,
    symbol_mutability_flags: &vector<i64>
) -> Stage1LowerResult:
    mut argument_result: Stage1CallArgumentResult = stage1_lower_call_argument_sequence(
        generic_expression_node_right(tree, node),
        source,
        tree,
        program,
        function_id,
        block_id,
        vector_new<i64>(64),
        symbol_name_starts,
        symbol_name_ends,
        symbol_value_ids,
        symbol_memory_ids,
        symbol_mutability_flags
    )
    match argument_result.accepted == 1:
        -1:
            mut arguments: vector<i64> = i64_vector_clone(&argument_result.arguments)
            return stage1_lower_from_append(
                native_ir_append_call_arguments(
                    argument_result.program, function_id, block_id, callee_id, &arguments
                )
            )
        0:
            return stage1_lower_preserved_failure(argument_result.program)
        1:
            return stage1_lower_preserved_failure(argument_result.program)

fn stage1_lower_call_with_arguments(
    node: i64,
    source: &vector<i64>,
    tree: &vector<i64>,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: &vector<i64>,
    symbol_name_ends: &vector<i64>,
    symbol_value_ids: &vector<i64>,
    symbol_memory_ids: &vector<i64>,
    symbol_mutability_flags: &vector<i64>
) -> Stage1LowerResult:
    mut callee_node: i64 = generic_expression_node_left(tree, node)
    mut call_type_code: i64 = generic_expression_node_value(tree, node)
    match generic_expression_node_kind(tree, callee_node) == 3:
        -1:
            mut callee_id: i64 = stage1_find_function_id_by_source_name(
                &program.function_ids,
                &program.function_name_first,
                &program.function_name_count,
                &program.function_name_bytes,
                source,
                generic_expression_node_start(tree, callee_node),
                generic_expression_node_end(tree, callee_node)
            )
            match callee_id >= 0:
                -1:
                    match call_type_code == 0:
                        -1:
                            return stage1_lower_call_arguments_to_id(
                                node, source, tree, program, function_id, block_id, callee_id,
                                symbol_name_starts, symbol_name_ends, symbol_value_ids,
                                symbol_memory_ids, symbol_mutability_flags
                            )
                        0:
                            return stage1_lower_preserved_failure(program)
                        1:
                            return stage1_lower_preserved_failure(program)
                0:
                    match call_type_code == 2:
                        -1:
                            mut builtin_id: i64 = stage1_generic_vector_builtin_id(
                                source,
                                generic_expression_node_start(tree, callee_node),
                                generic_expression_node_end(tree, callee_node)
                            )
                            match builtin_id >= 0:
                                -1:
                                    return stage1_lower_call_arguments_to_id(
                                        node, source, tree, program, function_id, block_id, builtin_id,
                                        symbol_name_starts, symbol_name_ends, symbol_value_ids,
                                        symbol_memory_ids, symbol_mutability_flags
                                    )
                                0:
                                    return stage1_lower_preserved_failure(program)
                                1:
                                    return stage1_lower_preserved_failure(program)
                        0:
                            return stage1_lower_preserved_failure(program)
                        1:
                            return stage1_lower_preserved_failure(program)
                1:
                    return stage1_lower_preserved_failure(program)
        0:
            return stage1_lower_preserved_failure(program)
        1:
            return stage1_lower_preserved_failure(program)

fn stage1_lower_address_expression(
    node: i64,
    source: &vector<i64>,
    tree: &vector<i64>,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: &vector<i64>,
    symbol_name_ends: &vector<i64>,
    symbol_value_ids: &vector<i64>,
    symbol_memory_ids: &vector<i64>,
    symbol_mutability_flags: &vector<i64>
) -> Stage1LowerResult:
    mut target_node: i64 = generic_expression_node_left(tree, node)
    mut reference_mode: i64 = generic_expression_node_operator(tree, node)
    match generic_expression_node_kind(tree, target_node) == 3:
        -1:
            mut symbol_index: i64 = stage1_find_symbol_index(
                source, symbol_name_starts, symbol_name_ends,
                generic_expression_node_start(tree, target_node),
                generic_expression_node_end(tree, target_node)
            )
            match symbol_index >= 0:
                -1:
                    mut source_value_id: i64 = vector_get<i64>(
                        symbol_value_ids, symbol_index
                    )
                    mut source_type_id: i64 = native_ir_value_type_id(
                        &program.value_ids, &program.value_type_ids, source_value_id
                    )
                    match source_type_id >= 0:
                        -1:
                            match i64_vector_get(&program.type_kinds, source_type_id) == 2:
                                -1:
                                    match i64_vector_get(
                                        &program.type_element_ids, source_type_id
                                    ) == 0:
                                        -1:
                                            match reference_mode == 1:
                                                -1:
                                                    return stage1_lower_from_append(
                                                        native_ir_append_reference_for_function(
                                                            program, function_id, block_id,
                                                            source_value_id, source_type_id, 0
                                                        )
                                                    )
                                                0:
                                                    match reference_mode == 2:
                                                        -1:
                                                            match vector_get<i64>(
                                                                symbol_mutability_flags,
                                                                symbol_index
                                                            ) == 1:
                                                                -1:
                                                                    return stage1_lower_from_append(
                                                                        native_ir_append_reference_for_function(
                                                                            program, function_id,
                                                                            block_id, source_value_id,
                                                                            source_type_id, 1
                                                                        )
                                                                    )
                                                                0:
                                                                    return stage1_lower_preserved_failure(program)
                                                                1:
                                                                    return stage1_lower_preserved_failure(program)
                                                        0:
                                                            return stage1_lower_preserved_failure(program)
                                                        1:
                                                            return stage1_lower_preserved_failure(program)
                                                1:
                                                    return stage1_lower_preserved_failure(program)
                                        0:
                                            return stage1_lower_preserved_failure(program)
                                        1:
                                            return stage1_lower_preserved_failure(program)
                                0:
                                    return stage1_lower_preserved_failure(program)
                                1:
                                    return stage1_lower_preserved_failure(program)
                        0:
                            return stage1_lower_preserved_failure(program)
                        1:
                            return stage1_lower_preserved_failure(program)
                0:
                    return stage1_lower_preserved_failure(program)
                1:
                    return stage1_lower_preserved_failure(program)
        0:
            return stage1_lower_preserved_failure(program)
        1:
            return stage1_lower_preserved_failure(program)

fn stage1_find_symbol_value(
    source: &vector<i64>,
    name_starts: &vector<i64>,
    name_ends: &vector<i64>,
    value_ids: &vector<i64>,
    wanted_start: i64,
    wanted_end: i64
) -> i64:
    mut index: i64 = 0
    while index < vector_len<i64>(name_starts):
        match stage1_source_spans_equal(
            source,
            wanted_start,
            wanted_end,
            vector_get<i64>(name_starts, index),
            vector_get<i64>(name_ends, index)
        ):
            -1:
                return vector_get<i64>(value_ids, index)
            0:
                index = index + 1
            1:
                index = index + 1
    return -1

fn stage1_find_symbol_index(
    source: &vector<i64>,
    name_starts: &vector<i64>,
    name_ends: &vector<i64>,
    wanted_start: i64,
    wanted_end: i64
) -> i64:
    mut index: i64 = 0
    while index < vector_len<i64>(name_starts):
        match stage1_source_spans_equal(
            source,
            wanted_start,
            wanted_end,
            vector_get<i64>(name_starts, index),
            vector_get<i64>(name_ends, index)
        ):
            -1:
                return index
            0:
                index = index + 1
            1:
                index = index + 1
    return -1

fn stage1_lower_integer_literal(
    value: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64
) -> Stage1LowerResult:
    match value < 0:
        -1:
            mut zero: NativeIRAppendResult = native_ir_append_instruction_for_function(
                program, function_id, block_id, 0, 0, -1, -1, -1
            )
            match zero.accepted == 1:
                -1:
                    mut zero_value_id: i64 = zero.value_id
                    mut zero_program: NativeIR = zero.program
                    mut magnitude: NativeIRAppendResult = native_ir_append_instruction_for_function(
                        zero_program, function_id, block_id, 0, 0 - value, -1, -1, -1
                    )
                    match magnitude.accepted == 1:
                        -1:
                            mut magnitude_value_id: i64 = magnitude.value_id
                            mut magnitude_program: NativeIR = magnitude.program
                            return stage1_lower_from_append(
                                native_ir_append_instruction_for_function(
                                    magnitude_program, function_id, block_id,
                                    13, 0, zero_value_id, magnitude_value_id, -1
                                )
                            )
                        0:
                            return stage1_lower_preserved_failure(magnitude.program)
                        1:
                            return stage1_lower_preserved_failure(magnitude.program)
                0:
                    return stage1_lower_preserved_failure(zero.program)
                1:
                    return stage1_lower_preserved_failure(zero.program)
        0:
            return stage1_lower_from_append(
                native_ir_append_instruction_for_function(
                    program, function_id, block_id, 0, value, -1, -1, -1
                )
            )
        1:
            return stage1_lower_from_append(
                native_ir_append_instruction_for_function(
                    program, function_id, block_id, 0, value, -1, -1, -1
                )
            )

fn stage1_lower_expression(
    node: i64,
    source: &vector<i64>,
    tree: &vector<i64>,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: &vector<i64>,
    symbol_name_ends: &vector<i64>,
    symbol_value_ids: &vector<i64>,
    symbol_memory_ids: &vector<i64>,
    symbol_mutability_flags: &vector<i64>
) -> Stage1LowerResult:
    mut node_count: i64 = generic_expression_node_count(tree)
    match node >= 0:
        -1:
            match node < node_count:
                -1:
                    mut kind: i64 = generic_expression_node_kind(tree, node)
                    match kind == 1:
                        -1:
                            mut value: i64 = generic_expression_node_value(tree, node)
                            return stage1_lower_integer_literal(
                                value, program, function_id, block_id
                            )
                        0:
                            match kind == 2:
                                -1:
                                    mut left_node: i64 = generic_expression_node_left(tree, node)
                                    mut right_node: i64 = generic_expression_node_right(tree, node)
                                    mut left_lowered: Stage1LowerResult = stage1_lower_expression(
                                        left_node, source, tree, program, function_id, block_id,
                                        symbol_name_starts, symbol_name_ends, symbol_value_ids,
                                        symbol_memory_ids, symbol_mutability_flags
                                    )
                                    mut left_value: i64 = left_lowered.value_id
                                    mut left_accepted: i64 = left_lowered.accepted
                                    mut right_lowered: Stage1LowerResult = stage1_lower_expression(
                                        right_node, source, tree, left_lowered.program, function_id, block_id,
                                        symbol_name_starts, symbol_name_ends, symbol_value_ids,
                                        symbol_memory_ids, symbol_mutability_flags
                                    )
                                    mut right_value: i64 = right_lowered.value_id
                                    mut operator: i64 = generic_expression_node_operator(tree, node)
                                    mut opcode: i64 = -1
                                    match left_accepted == 1:
                                        -1:
                                            match right_lowered.accepted == 1:
                                                -1:
                                                    match operator == 1:
                                                        -1:
                                                            opcode = 9
                                                        0:
                                                            match operator == 2:
                                                                -1:
                                                                    opcode = 13
                                                                0:
                                                                    match operator == 3:
                                                                        -1:
                                                                            opcode = 10
                                                                        0:
                                                                            match operator == 10:
                                                                                -1:
                                                                                    opcode = 11
                                                                                0:
                                                                                    match operator == 13:
                                                                                        -1:
                                                                                            opcode = 11
                                                                                        0:
                                                                                            match operator == 12:
                                                                                                -1:
                                                                                                    opcode = 11
                                                                                                0:
                                                                                                    match operator == 15:
                                                                                                        -1:
                                                                                                            opcode = 11
                                                                                                        0:
                                                                                                            match operator == 16:
                                                                                                                -1:
                                                                                                                    opcode = 11
                                                                                                                0:
                                                                                                                    discard 0
                                                                                                                1:
                                                                                                                    discard 0
                                                                                                        1:
                                                                                                            discard 0
                                                                                                1:
                                                                                                    discard 0
                                                                                        1:
                                                                                            discard 0
                                                                                1:
                                                                                    discard 0
                                                                        1:
                                                                            discard 0
                                                                1:
                                                                    discard 0
                                                        1:
                                                            discard 0
                                                0:
                                                    discard 0
                                                1:
                                                    discard 0
                                        0:
                                            discard 0
                                        1:
                                            discard 0
                                    match operator == 14:
                                        -1:
                                            opcode = 12
                                        0:
                                            discard 0
                                        1:
                                            discard 0
                                    match opcode == 12:
                                        -1:
                                            mut compare_left_type_id: i64 = native_ir_value_type_id(
                                                &right_lowered.program.value_ids,
                                                &right_lowered.program.value_type_ids,
                                                left_value
                                            )
                                            mut compare_right_type_id: i64 = native_ir_value_type_id(
                                                &right_lowered.program.value_ids,
                                                &right_lowered.program.value_type_ids,
                                                right_value
                                            )
                                            match compare_left_type_id == compare_right_type_id:
                                                -1:
                                                    match compare_left_type_id < 2:
                                                        -1:
                                                            return stage1_lower_from_append(
                                                                native_ir_append_typed_instruction_for_function(
                                                                    right_lowered.program,
                                                                    function_id,
                                                                    block_id,
                                                                    opcode,
                                                                    0,
                                                                    left_value,
                                                                    right_value,
                                                                    1
                                                                )
                                                            )
                                                        0:
                                                            return stage1_lower_preserved_failure(
                                                                right_lowered.program
                                                            )
                                                        1:
                                                            return stage1_lower_preserved_failure(
                                                                right_lowered.program
                                                            )
                                                0:
                                                    return stage1_lower_preserved_failure(
                                                        right_lowered.program
                                                    )
                                                1:
                                                    return stage1_lower_preserved_failure(
                                                        right_lowered.program
                                                    )
                                        0:
                                            discard 0
                                        1:
                                            discard 0
                                    match opcode == 11:
                                        -1:
                                            mut relation_code: i64 = 0
                                            match operator == 10:
                                                -1:
                                                    relation_code = 2
                                                0:
                                                    match operator == 12:
                                                        -1:
                                                            relation_code = 4
                                                        0:
                                                            match operator == 15:
                                                                -1:
                                                                    relation_code = 3
                                                                0:
                                                                    match operator == 16:
                                                                        -1:
                                                                            relation_code = 5
                                                                        0:
                                                                            relation_code = 0
                                                                        1:
                                                                            relation_code = 0
                                                                1:
                                                                    relation_code = 0
                                                        1:
                                                            relation_code = 0
                                                1:
                                                    relation_code = 0
                                            mut left_type_id: i64 = native_ir_value_type_id(
                                                &right_lowered.program.value_ids,
                                                &right_lowered.program.value_type_ids,
                                                left_value
                                            )
                                            mut right_type_id: i64 = native_ir_value_type_id(
                                                &right_lowered.program.value_ids,
                                                &right_lowered.program.value_type_ids,
                                                right_value
                                            )
                                            match left_type_id == right_type_id:
                                                -1:
                                                    match left_type_id < 2:
                                                        -1:
                                                            return stage1_lower_from_append(
                                                                native_ir_append_typed_instruction_for_function(
                                                                    right_lowered.program,
                                                                    function_id,
                                                                    block_id,
                                                                    opcode,
                                                                    relation_code,
                                                                    left_value,
                                                                    right_value,
                                                                    1
                                                                )
                                                            )
                                                        0:
                                                            return stage1_lower_preserved_failure(
                                                                right_lowered.program
                                                            )
                                                        1:
                                                            return stage1_lower_preserved_failure(
                                                                right_lowered.program
                                                            )
                                                0:
                                                    return stage1_lower_preserved_failure(
                                                        right_lowered.program
                                                    )
                                                1:
                                                    return stage1_lower_preserved_failure(
                                                        right_lowered.program
                                                    )
                                        0:
                                            return stage1_lower_from_append(
                                                native_ir_append_instruction_for_function(
                                                    right_lowered.program,
                                                    function_id,
                                                    block_id,
                                                    opcode,
                                                    0,
                                                    left_value,
                                                    right_value,
                                                    -1
                                                )
                                            )
                                        1:
                                            return stage1_lower_from_append(
                                                native_ir_append_instruction_for_function(
                                                    right_lowered.program,
                                                    function_id,
                                                    block_id,
                                                    opcode,
                                                    0,
                                                    left_value,
                                                    right_value,
                                                    -1
                                                )
                                            )
                                0:
                                    match kind == 3:
                                        -1:
                                            mut symbol_index: i64 = stage1_find_symbol_index(
                                                source,
                                                symbol_name_starts,
                                                symbol_name_ends,
                                                generic_expression_node_start(tree, node),
                                                generic_expression_node_end(tree, node)
                                            )
                                            match symbol_index >= 0:
                                                -1:
                                                    mut memory_id: i64 = vector_get<i64>(
                                                        symbol_memory_ids, symbol_index
                                                    )
                                                    match memory_id >= 0:
                                                        -1:
                                                            return stage1_lower_memory_load(
                                                                program, function_id, block_id,
                                                                memory_id
                                                            )
                                                        0:
                                                            return Stage1LowerResult(
                                                                program=program,
                                                                value_id=vector_get<i64>(
                                                                    symbol_value_ids, symbol_index
                                                                ),
                                                                accepted=1
                                                            )
                                                        1:
                                                            return Stage1LowerResult(
                                                                program=program,
                                                                value_id=vector_get<i64>(
                                                                    symbol_value_ids, symbol_index
                                                                ),
                                                                accepted=1
                                                            )
                                                0:
                                                    return stage1_lower_preserved_failure(program)
                                                1:
                                                    return stage1_lower_preserved_failure(program)
                                        0:
                                            match kind == 4:
                                                -1:
                                                    return stage1_lower_call_with_arguments(
                                                        node, source, tree, program, function_id, block_id,
                                                        symbol_name_starts, symbol_name_ends, symbol_value_ids,
                                                        symbol_memory_ids, symbol_mutability_flags
                                                    )
                                                0:
                                                    match kind == 6:
                                                        -1:
                                                            return stage1_lower_address_expression(
                                                                node, source, tree, program,
                                                                function_id, block_id,
                                                                symbol_name_starts,
                                                                symbol_name_ends,
                                                                symbol_value_ids,
                                                                symbol_memory_ids,
                                                                symbol_mutability_flags
                                                            )
                                                        0:
                                                            return stage1_lower_preserved_failure(program)
                                                        1:
                                                            return stage1_lower_preserved_failure(program)
                                                1:
                                                    match kind == 6:
                                                        -1:
                                                            return stage1_lower_address_expression(
                                                                node, source, tree, program,
                                                                function_id, block_id,
                                                                symbol_name_starts,
                                                                symbol_name_ends,
                                                                symbol_value_ids,
                                                                symbol_memory_ids,
                                                                symbol_mutability_flags
                                                            )
                                                        0:
                                                            return stage1_lower_preserved_failure(program)
                                                        1:
                                                            return stage1_lower_preserved_failure(program)
                                        1:
                                            match kind == 4:
                                                -1:
                                                    return stage1_lower_call_with_arguments(
                                                        node, source, tree, program, function_id, block_id,
                                                        symbol_name_starts, symbol_name_ends, symbol_value_ids,
                                                        symbol_memory_ids, symbol_mutability_flags
                                                    )
                                                0:
                                                    return stage1_lower_preserved_failure(program)
                                                1:
                                                    match kind == 6:
                                                        -1:
                                                            return stage1_lower_address_expression(
                                                                node, source, tree, program,
                                                                function_id, block_id,
                                                                symbol_name_starts,
                                                                symbol_name_ends,
                                                                symbol_value_ids,
                                                                symbol_memory_ids,
                                                                symbol_mutability_flags
                                                            )
                                                        0:
                                                            return stage1_lower_preserved_failure(program)
                                                        1:
                                                            return stage1_lower_preserved_failure(program)
                                1:
                                    return stage1_lower_preserved_failure(program)
                        1:
                            return stage1_lower_preserved_failure(program)
                0:
                    return stage1_lower_preserved_failure(program)
                1:
                    return stage1_lower_preserved_failure(program)
        0:
            return stage1_lower_preserved_failure(program)
        1:
            return stage1_lower_preserved_failure(program)

fn stage1_emit_decimal(output: &mut vector<i64>, value: i64) -> i64:
    mut places: vector<i64> = vector_new<i64>(20)
    discard vector_push<i64>(&mut places, 1000000000000000000)
    discard vector_push<i64>(&mut places, 100000000000000000)
    discard vector_push<i64>(&mut places, 10000000000000000)
    discard vector_push<i64>(&mut places, 1000000000000000)
    discard vector_push<i64>(&mut places, 100000000000000)
    discard vector_push<i64>(&mut places, 10000000000000)
    discard vector_push<i64>(&mut places, 1000000000000)
    discard vector_push<i64>(&mut places, 100000000000)
    discard vector_push<i64>(&mut places, 10000000000)
    discard vector_push<i64>(&mut places, 1000000000)
    discard vector_push<i64>(&mut places, 100000000)
    discard vector_push<i64>(&mut places, 10000000)
    discard vector_push<i64>(&mut places, 1000000)
    discard vector_push<i64>(&mut places, 100000)
    discard vector_push<i64>(&mut places, 10000)
    discard vector_push<i64>(&mut places, 1000)
    discard vector_push<i64>(&mut places, 100)
    discard vector_push<i64>(&mut places, 10)
    discard vector_push<i64>(&mut places, 1)
    mut digits: vector<i64> = vector_new<i64>(19)
    mut remaining: i64 = value
    mut index: i64 = 0
    while index < vector_len<i64>(&places):
        mut place: i64 = vector_get<i64>(&places, index)
        mut digit: i64 = 0
        while remaining >= place:
            remaining = remaining - place
            digit = digit + 1
        discard vector_push<i64>(&mut digits, digit)
        index = index + 1
    mut first_digit: i64 = 18
    mut found_nonzero: i64 = 0
    index = 0
    while index < 19:
        mut digit: i64 = vector_get<i64>(&digits, index)
        match digit > 0:
            -1:
                match found_nonzero == 0:
                    -1:
                        first_digit = index
                        found_nonzero = 1
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        index = index + 1
    index = first_digit
    while index < 19:
        discard vector_push<i64>(output, vector_get<i64>(&digits, index) + 48)
        index = index + 1
    return 1

fn stage1_emit_register(output: &mut vector<i64>, register_id: i64) -> i64:
    discard vector_push<i64>(output, 114)
    discard stage1_emit_decimal(output, register_id)
    return 1

fn stage1_emit_cfg_literal(output: &mut vector<i64>, literal_id: i64) -> i64:
    match literal_id == 0:
        -1:
            discard vector_push<i64>(output, 46)
            discard vector_push<i64>(output, 108)
            discard vector_push<i64>(output, 97)
            discard vector_push<i64>(output, 98)
            discard vector_push<i64>(output, 101)
            discard vector_push<i64>(output, 108)
            discard vector_push<i64>(output, 32)
            discard vector_push<i64>(output, 98)
        0:
            match literal_id == 1:
                -1:
                    discard vector_push<i64>(output, 101)
                    discard vector_push<i64>(output, 110)
                    discard vector_push<i64>(output, 116)
                    discard vector_push<i64>(output, 114)
                    discard vector_push<i64>(output, 121)
                0:
                    match literal_id == 2:
                        -1:
                            discard vector_push<i64>(output, 32)
                            discard vector_push<i64>(output, 32)
                            discard vector_push<i64>(output, 32)
                            discard vector_push<i64>(output, 32)
                            discard vector_push<i64>(output, 84)
                            discard vector_push<i64>(output, 66)
                            discard vector_push<i64>(output, 82)
                            discard vector_push<i64>(output, 51)
                            discard vector_push<i64>(output, 32)
                        0:
                            match literal_id == 3:
                                -1:
                                    discard vector_push<i64>(output, 32)
                                    discard vector_push<i64>(output, 32)
                                    discard vector_push<i64>(output, 32)
                                    discard vector_push<i64>(output, 32)
                                    discard vector_push<i64>(output, 84)
                                    discard vector_push<i64>(output, 74)
                                    discard vector_push<i64>(output, 77)
                                    discard vector_push<i64>(output, 80)
                                    discard vector_push<i64>(output, 32)
                                0:
                                    match literal_id == 4:
                                        -1:
                                            discard vector_push<i64>(output, 44)
                                            discard vector_push<i64>(output, 32)
                                        0:
                                            match literal_id == 5:
                                                -1:
                                                    discard vector_push<i64>(output, 10)
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        1:
                                            return 0
                                1:
                                    return 0
                        1:
                            return 0
                1:
                    return 0
        1:
            return 0
    return 1

fn stage1_emit_cfg_target(
    output: &mut vector<i64>,
    block_id: i64,
    entry_block_id: i64
) -> i64:
    match block_id == entry_block_id:
        -1:
            discard stage1_emit_cfg_literal(output, 1)
        0:
            discard vector_push<i64>(output, 98)
            discard stage1_emit_decimal(output, block_id)
        1:
            return 0
    return 1

fn stage1_emit_cfg_block_label(
    output: &mut vector<i64>,
    block_id: i64,
    is_entry: i64
) -> i64:
    match is_entry == 1:
        -1:
            discard stage1_emit_literal(output, 6)
        0:
            discard stage1_emit_cfg_literal(output, 0)
            discard stage1_emit_decimal(output, block_id)
            discard stage1_emit_cfg_literal(output, 5)
        1:
            return 0
    return 1

fn stage1_emission_value_count(view: &vector<i64>) -> i64:
    return vector_get<i64>(view, 0)

fn stage1_emission_instruction_count(view: &vector<i64>) -> i64:
    return vector_get<i64>(view, 1)

fn stage1_emission_value_id(view: &vector<i64>, index: i64) -> i64:
    return vector_get<i64>(view, 3 + index)

fn stage1_emission_operand_id(view: &vector<i64>, index: i64) -> i64:
    mut value_count: i64 = stage1_emission_value_count(view)
    return vector_get<i64>(view, 3 + value_count + index)

fn stage1_emission_instruction_field(view: &vector<i64>, index: i64, field: i64) -> i64:
    mut value_count: i64 = stage1_emission_value_count(view)
    mut operand_count: i64 = vector_get<i64>(view, 2)
    mut start: i64 = 3 + value_count + operand_count + index * 5
    return vector_get<i64>(view, start + field)

fn stage1_emit_single_main_program(view: &vector<i64>, output: &mut vector<i64>) -> i64:
    discard vector_push<i64>(output, 46)
    discard vector_push<i64>(output, 115)
    discard vector_push<i64>(output, 51)
    discard vector_push<i64>(output, 97)
    discard vector_push<i64>(output, 115)
    discard vector_push<i64>(output, 109)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 48)
    discard vector_push<i64>(output, 46)
    discard vector_push<i64>(output, 54)
    discard vector_push<i64>(output, 46)
    discard vector_push<i64>(output, 48)
    discard vector_push<i64>(output, 10)
    discard vector_push<i64>(output, 10)
    discard vector_push<i64>(output, 46)
    discard vector_push<i64>(output, 102)
    discard vector_push<i64>(output, 117)
    discard vector_push<i64>(output, 110)
    discard vector_push<i64>(output, 99)
    discard vector_push<i64>(output, 116)
    discard vector_push<i64>(output, 105)
    discard vector_push<i64>(output, 111)
    discard vector_push<i64>(output, 110)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 109)
    discard vector_push<i64>(output, 97)
    discard vector_push<i64>(output, 105)
    discard vector_push<i64>(output, 110)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 45)
    discard vector_push<i64>(output, 62)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 105)
    discard vector_push<i64>(output, 54)
    discard vector_push<i64>(output, 52)
    discard vector_push<i64>(output, 10)
    mut value_index: i64 = 0
    while value_index < stage1_emission_value_count(view):
        discard vector_push<i64>(output, 32)
        discard vector_push<i64>(output, 32)
        discard vector_push<i64>(output, 32)
        discard vector_push<i64>(output, 32)
        discard vector_push<i64>(output, 46)
        discard vector_push<i64>(output, 114)
        discard vector_push<i64>(output, 101)
        discard vector_push<i64>(output, 103)
        discard vector_push<i64>(output, 105)
        discard vector_push<i64>(output, 115)
        discard vector_push<i64>(output, 116)
        discard vector_push<i64>(output, 101)
        discard vector_push<i64>(output, 114)
        discard vector_push<i64>(output, 32)
        discard stage1_emit_register(output, stage1_emission_value_id(view, value_index))
        discard vector_push<i64>(output, 44)
        discard vector_push<i64>(output, 32)
        discard vector_push<i64>(output, 105)
        discard vector_push<i64>(output, 54)
        discard vector_push<i64>(output, 52)
        discard vector_push<i64>(output, 10)
        value_index = value_index + 1
    discard vector_push<i64>(output, 46)
    discard vector_push<i64>(output, 108)
    discard vector_push<i64>(output, 97)
    discard vector_push<i64>(output, 98)
    discard vector_push<i64>(output, 101)
    discard vector_push<i64>(output, 108)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 101)
    discard vector_push<i64>(output, 110)
    discard vector_push<i64>(output, 116)
    discard vector_push<i64>(output, 114)
    discard vector_push<i64>(output, 121)
    discard vector_push<i64>(output, 10)
    mut instruction_index: i64 = 0
    while instruction_index < stage1_emission_instruction_count(view):
        mut opcode: i64 = stage1_emission_instruction_field(view, instruction_index, 0)
        match opcode == 0:
            -1:
                discard vector_push<i64>(output, 32)
                discard vector_push<i64>(output, 32)
                discard vector_push<i64>(output, 32)
                discard vector_push<i64>(output, 32)
                discard vector_push<i64>(output, 84)
                discard vector_push<i64>(output, 67)
                discard vector_push<i64>(output, 79)
                discard vector_push<i64>(output, 78)
                discard vector_push<i64>(output, 83)
                discard vector_push<i64>(output, 84)
                discard vector_push<i64>(output, 32)
                discard stage1_emit_register(output, stage1_emission_value_id(view, stage1_emission_instruction_field(view, instruction_index, 2)))
                discard vector_push<i64>(output, 44)
                discard vector_push<i64>(output, 32)
                discard stage1_emit_decimal(output, stage1_emission_instruction_field(view, instruction_index, 1))
            0:
                match opcode == 9:
                    -1:
                        discard vector_push<i64>(output, 32)
                        discard vector_push<i64>(output, 32)
                        discard vector_push<i64>(output, 32)
                        discard vector_push<i64>(output, 32)
                        discard vector_push<i64>(output, 84)
                        discard vector_push<i64>(output, 65)
                        discard vector_push<i64>(output, 68)
                        discard vector_push<i64>(output, 68)
                        discard vector_push<i64>(output, 32)
                        discard stage1_emit_register(output, stage1_emission_value_id(view, stage1_emission_instruction_field(view, instruction_index, 2)))
                        discard vector_push<i64>(output, 44)
                        discard vector_push<i64>(output, 32)
                        discard stage1_emit_register(output, stage1_emission_operand_id(view, stage1_emission_instruction_field(view, instruction_index, 3)))
                        discard vector_push<i64>(output, 44)
                        discard vector_push<i64>(output, 32)
                        discard stage1_emit_register(output, stage1_emission_operand_id(view, stage1_emission_instruction_field(view, instruction_index, 3) + 1))
                    0:
                        match opcode == 10:
                            -1:
                                discard vector_push<i64>(output, 32)
                                discard vector_push<i64>(output, 32)
                                discard vector_push<i64>(output, 32)
                                discard vector_push<i64>(output, 32)
                                discard vector_push<i64>(output, 84)
                                discard vector_push<i64>(output, 77)
                                discard vector_push<i64>(output, 85)
                                discard vector_push<i64>(output, 76)
                                discard vector_push<i64>(output, 32)
                                discard stage1_emit_register(output, stage1_emission_value_id(view, stage1_emission_instruction_field(view, instruction_index, 2)))
                                discard vector_push<i64>(output, 44)
                                discard vector_push<i64>(output, 32)
                                discard stage1_emit_register(output, stage1_emission_operand_id(view, stage1_emission_instruction_field(view, instruction_index, 3)))
                                discard vector_push<i64>(output, 44)
                                discard vector_push<i64>(output, 32)
                                discard stage1_emit_register(output, stage1_emission_operand_id(view, stage1_emission_instruction_field(view, instruction_index, 3) + 1))
                            0:
                                discard vector_push<i64>(output, 32)
                                discard vector_push<i64>(output, 32)
                                discard vector_push<i64>(output, 32)
                                discard vector_push<i64>(output, 32)
                                discard vector_push<i64>(output, 84)
                                discard vector_push<i64>(output, 82)
                                discard vector_push<i64>(output, 69)
                                discard vector_push<i64>(output, 84)
                                discard vector_push<i64>(output, 32)
                                discard stage1_emit_register(output, stage1_emission_operand_id(view, stage1_emission_instruction_field(view, instruction_index, 3)))
                            1:
                                discard vector_push<i64>(output, 32)
                                discard vector_push<i64>(output, 32)
                                discard vector_push<i64>(output, 32)
                                discard vector_push<i64>(output, 32)
                                discard vector_push<i64>(output, 84)
                                discard vector_push<i64>(output, 82)
                                discard vector_push<i64>(output, 69)
                                discard vector_push<i64>(output, 84)
                                discard vector_push<i64>(output, 32)
                                discard stage1_emit_register(output, stage1_emission_operand_id(view, stage1_emission_instruction_field(view, instruction_index, 3)))
                    1:
                        discard vector_push<i64>(output, 32)
                        discard vector_push<i64>(output, 32)
                        discard vector_push<i64>(output, 32)
                        discard vector_push<i64>(output, 32)
                        discard vector_push<i64>(output, 84)
                        discard vector_push<i64>(output, 82)
                        discard vector_push<i64>(output, 69)
                        discard vector_push<i64>(output, 84)
                        discard vector_push<i64>(output, 32)
                        discard stage1_emit_register(output, stage1_emission_operand_id(view, stage1_emission_instruction_field(view, instruction_index, 3)))
            1:
                discard vector_push<i64>(output, 32)
                discard vector_push<i64>(output, 32)
                discard vector_push<i64>(output, 32)
                discard vector_push<i64>(output, 32)
                discard vector_push<i64>(output, 84)
                discard vector_push<i64>(output, 82)
                discard vector_push<i64>(output, 69)
                discard vector_push<i64>(output, 84)
                discard vector_push<i64>(output, 32)
                discard stage1_emit_register(output, stage1_emission_operand_id(view, stage1_emission_instruction_field(view, instruction_index, 3)))
        discard vector_push<i64>(output, 10)
        instruction_index = instruction_index + 1
    discard vector_push<i64>(output, 46)
    discard vector_push<i64>(output, 101)
    discard vector_push<i64>(output, 110)
    discard vector_push<i64>(output, 100)
    discard vector_push<i64>(output, 10)
    return 1

fn stage1_function_header_failure() -> Stage1FunctionHeader:
    return Stage1FunctionHeader(
        next_cursor=-1,
        name_start=-1,
        name_end=-1,
        expression_cursor=-1,
        parameter_name_starts=vector_new<i64>(0),
        parameter_name_ends=vector_new<i64>(0),
        parameter_type_codes=vector_new<i64>(0),
        result_type_code=-1,
        accepted=0
    )

fn stage1_parameter_parse_failure() -> Stage1ParameterParse:
    return Stage1ParameterParse(
        next_cursor=-1,
        name_starts=vector_new<i64>(0),
        name_ends=vector_new<i64>(0),
        type_codes=vector_new<i64>(0),
        accepted=0
    )

fn stage1_parameter_type_parse_failure() -> Stage1ParameterTypeParse:
    return Stage1ParameterTypeParse(next_cursor=-1, type_code=-1, accepted=0)

fn stage1_parse_parameter_type(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64
) -> Stage1ParameterTypeParse:
    match generic_native_parser_program_type_code_for_token(source, tokens, cursor) == 2:
        -1:
            return Stage1ParameterTypeParse(
                next_cursor=cursor + 1, type_code=0, accepted=1
            )
        0:
            match generic_native_parser_program_type_code_for_token(source, tokens, cursor) == 6:
                -1:
                    return Stage1ParameterTypeParse(
                        next_cursor=cursor + 1, type_code=2, accepted=1
                    )
                0:
                    match generic_native_parser_program_type_code_for_token(
                        source, tokens, cursor
                    ) == 5:
                        -1:
                            return stage1_parse_vector_parameter_type(
                                source, tokens, cursor, cursor + 4, 4
                            )
                        0:
                            match generic_token_kind(tokens, cursor) == 138:
                                -1:
                                    match stage1_source_name_is_mut_keyword(
                                        source,
                                        generic_token_start(tokens, cursor + 1),
                                        generic_token_end(tokens, cursor + 1)
                                    ) == 1:
                                        -1:
                                            return stage1_parse_vector_parameter_type(
                                                source, tokens, cursor + 2, cursor + 6, 3
                                            )
                                        0:
                                            return stage1_parse_vector_parameter_type(
                                                source, tokens, cursor + 1, cursor + 5, 1
                                            )
                                        1:
                                            return stage1_parse_vector_parameter_type(
                                                source, tokens, cursor + 1, cursor + 5, 1
                                            )
                                0:
                                    return stage1_parameter_type_parse_failure()
                                1:
                                    return stage1_parameter_type_parse_failure()
                        1:
                            return stage1_parameter_type_parse_failure()
                1:
                    return stage1_parameter_type_parse_failure()
        1:
            return stage1_parameter_type_parse_failure()

fn stage1_parameter_name_seen(
    source: &vector<i64>,
    name_starts: &vector<i64>,
    name_ends: &vector<i64>,
    wanted_start: i64,
    wanted_end: i64,
    index: i64
) -> i64:
    match index < vector_len<i64>(name_starts):
        -1:
            match stage1_source_spans_equal(
                source,
                wanted_start,
                wanted_end,
                vector_get<i64>(name_starts, index),
                vector_get<i64>(name_ends, index)
            ):
                -1:
                    return 1
                0:
                    return stage1_parameter_name_seen(
                        source, name_starts, name_ends,
                        wanted_start, wanted_end, index + 1
                    )
                1:
                    return stage1_parameter_name_seen(
                        source, name_starts, name_ends,
                        wanted_start, wanted_end, index + 1
                    )
        0:
            return 0
        1:
            return 0

fn stage1_parameter_names_unique(
    source: &vector<i64>,
    name_starts: &vector<i64>,
    name_ends: &vector<i64>,
    index: i64
) -> i64:
    match index < vector_len<i64>(name_starts):
        -1:
            match stage1_parameter_name_seen(
                source,
                name_starts,
                name_ends,
                vector_get<i64>(name_starts, index),
                vector_get<i64>(name_ends, index),
                index + 1
            ) == 0:
                -1:
                    return stage1_parameter_names_unique(
                        source, name_starts, name_ends, index + 1
                    )
                0:
                    return 0
                1:
                    return 0
        0:
            return 1
        1:
            return 1

fn stage1_parse_parameters(
    source: &vector<i64>,
    tokens: &vector<i64>,
    start_cursor: i64
) -> Stage1ParameterParse:
    mut token_count: i64 = generic_token_count(tokens)
    mut cursor: i64 = stage1_skip_body_newlines(tokens, start_cursor)
    mut name_starts: vector<i64> = vector_new<i64>(64)
    mut name_ends: vector<i64> = vector_new<i64>(64)
    mut type_codes: vector<i64> = vector_new<i64>(64)
    match cursor < token_count:
        -1:
            discard 0
        0:
            return stage1_parameter_parse_failure()
        1:
            return stage1_parameter_parse_failure()
    match generic_token_kind(tokens, cursor) == 8:
        -1:
            return Stage1ParameterParse(
                next_cursor=cursor + 1,
                name_starts=name_starts,
                name_ends=name_ends,
                type_codes=type_codes,
                accepted=1
            )
        0:
            discard 0
        1:
            discard 0
    mut parsing: i64 = 1
    mut accepted: i64 = 1
    while parsing == 1:
        cursor = stage1_skip_body_newlines(tokens, cursor)
        match cursor < token_count:
            -1:
                discard 0
            0:
                accepted = 0
                parsing = 0
            1:
                accepted = 0
                parsing = 0
        match accepted == 1:
            -1:
                match generic_token_kind(tokens, cursor) == 1:
                    -1:
                        discard vector_push<i64>(
                            &mut name_starts, generic_token_start(tokens, cursor)
                        )
                        discard vector_push<i64>(
                            &mut name_ends, generic_token_end(tokens, cursor)
                        )
                        cursor = cursor + 1
                        match generic_token_kind(tokens, cursor) == 158:
                            -1:
                                cursor = cursor + 1
                                mut parsed_type: Stage1ParameterTypeParse = stage1_parse_parameter_type(
                                    source, tokens, cursor
                                )
                                match parsed_type.accepted == 1:
                                    -1:
                                        cursor = stage1_skip_body_newlines(
                                            tokens, parsed_type.next_cursor
                                        )
                                        discard vector_push<i64>(
                                            &mut type_codes, parsed_type.type_code
                                        )
                                    0:
                                        accepted = 0
                                    1:
                                        accepted = 0
                            0:
                                accepted = 0
                            1:
                                accepted = 0
                        match accepted == 1:
                            -1:
                                match generic_token_kind(tokens, cursor) == 144:
                                    -1:
                                        cursor = cursor + 1
                                    0:
                                        match generic_token_kind(tokens, cursor) == 8:
                                            -1:
                                                return Stage1ParameterParse(
                                                    next_cursor=cursor + 1,
                                                    name_starts=name_starts,
                                                    name_ends=name_ends,
                                                    type_codes=type_codes,
                                                    accepted=1
                                                )
                                            0:
                                                accepted = 0
                                                parsing = 0
                                            1:
                                                accepted = 0
                                                parsing = 0
                                    1:
                                        accepted = 0
                                        parsing = 0
                            0:
                                parsing = 0
                            1:
                                parsing = 0
                    0:
                        accepted = 0
                        parsing = 0
                    1:
                        accepted = 0
                        parsing = 0
            0:
                parsing = 0
            1:
                parsing = 0
    return stage1_parameter_parse_failure()

fn stage1_function_body_end(
    source: &vector<i64>,
    tokens: &vector<i64>,
    body_cursor: i64
) -> i64:
    mut token_count: i64 = generic_token_count(tokens)
    mut cursor: i64 = body_cursor
    mut line_count: i64 = 0
    mut finished: i64 = 0
    while cursor < token_count:
        match finished == 0:
            -1:
                match generic_token_kind(tokens, cursor) == 6:
                    -1:
                        cursor = cursor + 1
                    0:
                        mut indent: i64 = generic_native_parser_program_indent(
                            source, generic_token_start(tokens, cursor)
                        )
                        match indent >= 4:
                            -1:
                                mut line_end: i64 = cursor
                                mut next_line_cursor: i64 = -1
                                while line_end < token_count:
                                    match generic_token_kind(tokens, line_end) == 6:
                                        -1:
                                            next_line_cursor = line_end + 1
                                            line_end = token_count
                                        0:
                                            line_end = line_end + 1
                                        1:
                                            line_end = line_end + 1
                                match next_line_cursor >= 0:
                                    -1:
                                        cursor = next_line_cursor
                                        line_count = line_count + 1
                                    0:
                                        return -1
                                    1:
                                        return -1
                            0:
                                match indent < 4:
                                    -1:
                                        finished = 1
                                    0:
                                        return -1
                                    1:
                                        return -1
                            1:
                                match indent < 4:
                                    -1:
                                        finished = 1
                                    0:
                                        return -1
                                    1:
                                        return -1
                    1:
                        mut indent: i64 = generic_native_parser_program_indent(
                            source, generic_token_start(tokens, cursor)
                        )
                        match indent >= 4:
                            -1:
                                mut line_end: i64 = cursor
                                mut next_line_cursor: i64 = -1
                                while line_end < token_count:
                                    match generic_token_kind(tokens, line_end) == 6:
                                        -1:
                                            next_line_cursor = line_end + 1
                                            line_end = token_count
                                        0:
                                            line_end = line_end + 1
                                        1:
                                            line_end = line_end + 1
                                match next_line_cursor >= 0:
                                    -1:
                                        cursor = next_line_cursor
                                        line_count = line_count + 1
                                    0:
                                        return -1
                                    1:
                                        return -1
                            0:
                                match indent < 4:
                                    -1:
                                        finished = 1
                                    0:
                                        return -1
                                    1:
                                        return -1
                            1:
                                match indent < 4:
                                    -1:
                                        finished = 1
                                    0:
                                        return -1
                                    1:
                                        return -1
            0:
                return cursor
            1:
                return cursor
    match line_count > 0:
        -1:
            return cursor
        0:
            return -1
        1:
            return -1

fn stage1_parse_function_header_core(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64
) -> Stage1FunctionHeader:
    mut token_count: i64 = generic_token_count(tokens)
    mut valid: i64 = 1
    match cursor >= 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match generic_token_kind(tokens, cursor) == 2:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match generic_token_kind(tokens, cursor + 1) == 1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match generic_token_kind(tokens, cursor + 2) == 7:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    mut parameters: Stage1ParameterParse = stage1_parse_parameters(
        source, tokens, cursor + 3
    )
    match parameters.accepted == 1:
        -1:
            match stage1_parameter_names_unique(
                source,
                &parameters.name_starts,
                &parameters.name_ends,
                0
            ) == 1:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    mut suffix: i64 = parameters.next_cursor
    mut result_type_code: i64 = -1
    match generic_token_kind(tokens, suffix) == 145:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match generic_token_kind(tokens, suffix + 1) == 162:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    mut parsed_result_type: Stage1ParameterTypeParse = stage1_parse_parameter_type(
        source, tokens, suffix + 2
    )
    match parsed_result_type.accepted == 1:
        -1:
            match parsed_result_type.type_code == 0:
                -1:
                    result_type_code = 0
                0:
                    match parsed_result_type.type_code == 2:
                        -1:
                            result_type_code = 1
                        0:
                            match parsed_result_type.type_code == 4:
                                -1:
                                    result_type_code = 4
                                0:
                                    valid = 0
                                1:
                                    valid = 0
                        1:
                            valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    mut result_suffix_cursor: i64 = parsed_result_type.next_cursor
    match generic_token_kind(tokens, result_suffix_cursor) == 158:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match generic_token_kind(tokens, result_suffix_cursor + 1) == 6:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    mut body_cursor: i64 = result_suffix_cursor + 2
    match valid == 1:
        -1:
            mut next_cursor: i64 = stage1_function_body_end(source, tokens, body_cursor)
            match next_cursor >= 0:
                -1:
                    return Stage1FunctionHeader(
                        next_cursor=next_cursor,
                        name_start=generic_token_start(tokens, cursor + 1),
                        name_end=generic_token_end(tokens, cursor + 1),
                        expression_cursor=body_cursor,
                        parameter_name_starts=parameters.name_starts,
                        parameter_name_ends=parameters.name_ends,
                        parameter_type_codes=parameters.type_codes,
                        result_type_code=result_type_code,
                        accepted=1
                    )
                0:
                    return stage1_function_header_failure()
                1:
                    return stage1_function_header_failure()
        0:
            return stage1_function_header_failure()
        1:
            return stage1_function_header_failure()

fn stage1_parse_function_header(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64
) -> Stage1FunctionHeader:
    return stage1_parse_function_header_core(source, tokens, cursor)

fn stage1_source_spans_equal(
    source: &vector<i64>,
    first_start: i64,
    first_end: i64,
    second_start: i64,
    second_end: i64
) -> trit:
    match first_end - first_start == second_end - second_start:
        -1:
            mut offset: i64 = 0
            while offset < first_end - first_start:
                match vector_get<i64>(source, first_start + offset) == vector_get<i64>(source, second_start + offset):
                    -1:
                        offset = offset + 1
                    0:
                        return 0
                    1:
                        return 0
            return -1
        0:
            return 0
        1:
            return 0

fn stage1_find_function_id_by_source_name(
    function_ids: &vector<i64>,
    function_name_first: &vector<i64>,
    function_name_count: &vector<i64>,
    function_name_bytes: &vector<i64>,
    source: &vector<i64>,
    name_start: i64,
    name_end: i64
) -> i64:
    mut function_index: i64 = 0
    mut source_name_length: i64 = name_end - name_start
    while function_index < i64_vector_len(function_ids):
        match i64_vector_get(function_name_count, function_index) == source_name_length:
            -1:
                mut offset: i64 = 0
                mut equal: i64 = 1
                mut first: i64 = i64_vector_get(function_name_first, function_index)
                while offset < source_name_length:
                    match vector_get<i64>(source, name_start + offset) == i64_vector_get(function_name_bytes, first + offset):
                        -1:
                            discard 0
                        0:
                            equal = 0
                        1:
                            equal = 0
                    offset = offset + 1
                match equal == 1:
                    -1:
                        return i64_vector_get(function_ids, function_index)
                    0:
                        function_index = function_index + 1
                    1:
                        function_index = function_index + 1
            0:
                function_index = function_index + 1
            1:
                function_index = function_index + 1
    return -1

export fn stage1_output_chunk(output: &vector<i64>, start: i64) -> i64:
    mut index: i64 = 0
    mut packed: i64 = 0
    mut scanning: i64 = 1
    while scanning == 1:
        match index < 8:
            -1:
                match start + index < vector_len<i64>(output):
                    -1:
                        packed = packed * 128 + vector_get<i64>(output, start + index)
                        index = index + 1
                    0:
                        scanning = 0
                    1:
                        scanning = 0
            0:
                scanning = 0
            1:
                scanning = 0
    return packed

fn stage1_compile_single_main(source: vector<i64>) -> Stage1CompileResult:
    mut source_length: i64 = vector_len<i64>(&source)
    match source_length <= 4096:
        -1:
            discard 0
        0:
            return stage1_empty_result(1, 1)
        1:
            return stage1_empty_result(1, 1)
    mut tokens: vector<i64> = generic_lexer_scan(&source)
    mut token_count: i64 = generic_token_count(&tokens)
    match token_count <= 1025:
        -1:
            discard 0
        0:
            return stage1_empty_result(2, 2)
        1:
            return stage1_empty_result(2, 2)
    match generic_token_kind(&tokens, 0) == 2:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 3)
        1:
            return stage1_empty_result(3, 3)
    match generic_token_kind(&tokens, 1) == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 4)
        1:
            return stage1_empty_result(3, 4)
    match generic_token_end(&tokens, 1) - generic_token_start(&tokens, 1) == 4:
        -1:
            match vector_get<i64>(&source, generic_token_start(&tokens, 1)) == 109:
                -1:
                    match vector_get<i64>(&source, generic_token_start(&tokens, 1) + 1) == 97:
                        -1:
                            match vector_get<i64>(&source, generic_token_start(&tokens, 1) + 2) == 105:
                                -1:
                                    match vector_get<i64>(&source, generic_token_start(&tokens, 1) + 3) == 110:
                                        -1:
                                            discard 0
                                        0:
                                            return stage1_empty_result(3, 4)
                                        1:
                                            return stage1_empty_result(3, 4)
                                0:
                                    return stage1_empty_result(3, 4)
                                1:
                                    return stage1_empty_result(3, 4)
                        0:
                            return stage1_empty_result(3, 4)
                        1:
                            return stage1_empty_result(3, 4)
                0:
                    return stage1_empty_result(3, 4)
                1:
                    return stage1_empty_result(3, 4)
        0:
            return stage1_empty_result(3, 4)
        1:
            return stage1_empty_result(3, 4)
    match generic_token_kind(&tokens, 2) == 7:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 5)
        1:
            return stage1_empty_result(3, 5)
    match generic_token_kind(&tokens, 3) == 8:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 6)
        1:
            return stage1_empty_result(3, 6)
    match generic_token_kind(&tokens, 4) == 145:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 7)
        1:
            return stage1_empty_result(3, 7)
    match generic_token_kind(&tokens, 5) == 162:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 8)
        1:
            return stage1_empty_result(3, 8)
    match generic_native_parser_program_type_code_for_token(&source, &tokens, 6) == 2:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 9)
        1:
            return stage1_empty_result(3, 9)
    match generic_token_kind(&tokens, 7) == 158:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 10)
        1:
            return stage1_empty_result(3, 10)
    match generic_token_kind(&tokens, 8) == 6:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 11)
        1:
            return stage1_empty_result(3, 11)
    match generic_native_parser_program_indent(&source, generic_token_start(&tokens, 9)) == 4:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 12)
        1:
            return stage1_empty_result(3, 12)
    match generic_token_kind(&tokens, 9) == 3:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 13)
        1:
            return stage1_empty_result(3, 13)
    mut expression_tree: vector<i64> = generic_native_parser_parse_expression(
        &source, &tokens, 10, 0
    )
    mut expression_result: i64 = generic_expression_packed_result(&expression_tree)
    match expression_result <=> 0:
        -1:
            return stage1_empty_result(3, 14)
        0:
            return stage1_empty_result(3, 14)
        1:
            discard 0
    mut root_node: i64 = generic_native_parser_packed_node(expression_result)
    mut cursor: i64 = generic_native_parser_packed_cursor(expression_result)
    match generic_token_kind(&tokens, cursor) == 6:
        -1:
            cursor = cursor + 1
        0:
            return stage1_empty_result(3, 15)
        1:
            return stage1_empty_result(3, 15)
    match generic_token_kind(&tokens, cursor) == 0:
        -1:
            cursor = cursor + 1
        0:
            return stage1_empty_result(3, 16)
        1:
            return stage1_empty_result(3, 16)
    match cursor == token_count:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 17)
        1:
            return stage1_empty_result(3, 17)
    match generic_expression_node_count(&expression_tree) <= 63:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 18)
        1:
            return stage1_empty_result(3, 18)
    mut program: NativeIR = native_ir_empty()
    mut function_append: NativeIRAppendResult = native_ir_append_function(program, 0, 1)
    match function_append.accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(4, 18)
        1:
            return stage1_empty_result(4, 18)
    program = function_append.program
    mut block_append: NativeIRAppendResult = native_ir_append_block(program, 0, 1)
    match block_append.accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(4, 18)
        1:
            return stage1_empty_result(4, 18)
    program = block_append.program
    mut empty_symbol_name_starts: vector<i64> = vector_new<i64>(0)
    mut empty_symbol_name_ends: vector<i64> = vector_new<i64>(0)
    mut empty_symbol_value_ids: vector<i64> = vector_new<i64>(0)
    mut empty_symbol_memory_ids: vector<i64> = vector_new<i64>(0)
    mut empty_symbol_mutability_flags: vector<i64> = vector_new<i64>(0)
    mut lowered: Stage1LowerResult = stage1_lower_expression(
        root_node, &source, &expression_tree, program, 0, 0,
        &empty_symbol_name_starts, &empty_symbol_name_ends, &empty_symbol_value_ids,
        &empty_symbol_memory_ids, &empty_symbol_mutability_flags
    )
    match lowered.accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(4, 19)
        1:
            return stage1_empty_result(4, 19)
    mut return_value: i64 = lowered.value_id
    program = lowered.program
    mut return_append: NativeIRAppendResult = native_ir_append_instruction(
        program, 1, 0, return_value, -1
    )
    match return_append.accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(4, 20)
        1:
            return stage1_empty_result(4, 20)
    program = return_append.program
    program = native_ir_order_blocks_by_instruction_first(program)
    mut verified: NativeIRVerifiedResult = verify_program(program)
    mut verification: NativeVerification = verified.verification
    program = verified.program
    mut emission_view: vector<i64> = native_ir_emission_view(program)
    mut instruction_count: i64 = stage1_emission_instruction_count(&emission_view)
    mut value_count: i64 = stage1_emission_value_count(&emission_view)
    match verification.accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(5, verification.diagnostic_code)
        1:
            return stage1_empty_result(5, verification.diagnostic_code)
    mut output: vector<i64> = vector_new<i64>(16384)
    discard stage1_emit_single_main_program(&emission_view, &mut output)
    mut sink: OutputSinkState = output_sink_new(16384)
    sink = output_sink_append_bytes(sink, output)
    match sink.failed == 0:
        -1:
            discard 0
        0:
            return stage1_empty_result(6, 20)
        1:
            return stage1_empty_result(6, 20)
    sink = output_sink_commit(sink)
    match sink.failed == 0:
        -1:
            discard 0
        0:
            return stage1_empty_result(6, 21)
        1:
            return stage1_empty_result(6, 21)
    return stage1_result(
        1, 0, 0, sink.buffer,
        instruction_count,
        value_count,
        verification
    )

