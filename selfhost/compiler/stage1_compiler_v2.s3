fn stage1_emit_ir_register_type_suffix(
    type_id: i64,
    type_kinds: &vector<i64>,
    type_element_ids: &vector<i64>,
    type_mutability_flags: &vector<i64>,
    type_lengths: &vector<i64>,
    output: &mut vector<i64>
) -> i64:
    match type_id == 0:
        -1:
            discard stage1_emit_literal(output, 4)
            return 1
        0:
            match type_id == 1:
                -1:
                    discard stage1_emit_literal(output, 17)
                    return 1
                0:
                    return stage1_emit_ir_non_scalar_register_type_suffix(
                        type_id, type_kinds, type_element_ids,
                        type_mutability_flags, type_lengths, output
                    )
                1:
                    return stage1_emit_ir_non_scalar_register_type_suffix(
                        type_id, type_kinds, type_element_ids,
                        type_mutability_flags, type_lengths, output
                    )
        1:
            return stage1_emit_ir_non_scalar_register_type_suffix(
                type_id, type_kinds, type_element_ids,
                type_mutability_flags, type_lengths, output
            )

fn stage1_emit_ir_vector_reference_type_suffix(
    mutability: i64,
    output: &mut vector<i64>
) -> i64:
    discard vector_push<i64>(output, 44)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 114)
    discard vector_push<i64>(output, 101)
    discard vector_push<i64>(output, 102)
    discard vector_push<i64>(output, 101)
    discard vector_push<i64>(output, 114)
    discard vector_push<i64>(output, 101)
    discard vector_push<i64>(output, 110)
    discard vector_push<i64>(output, 99)
    discard vector_push<i64>(output, 101)
    discard vector_push<i64>(output, 44)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 118)
    discard vector_push<i64>(output, 101)
    discard vector_push<i64>(output, 99)
    discard vector_push<i64>(output, 116)
    discard vector_push<i64>(output, 111)
    discard vector_push<i64>(output, 114)
    discard vector_push<i64>(output, 44)
    discard vector_push<i64>(output, 32)
    match mutability == 0:
        -1:
            discard vector_push<i64>(output, 105)
            discard vector_push<i64>(output, 109)
            discard vector_push<i64>(output, 109)
            discard vector_push<i64>(output, 117)
            discard vector_push<i64>(output, 116)
            discard vector_push<i64>(output, 97)
            discard vector_push<i64>(output, 98)
            discard vector_push<i64>(output, 108)
            discard vector_push<i64>(output, 101)
        0:
            discard 0
        1:
            discard 0
    match mutability == 1:
        -1:
            discard vector_push<i64>(output, 109)
            discard vector_push<i64>(output, 117)
            discard vector_push<i64>(output, 116)
            discard vector_push<i64>(output, 97)
            discard vector_push<i64>(output, 98)
            discard vector_push<i64>(output, 108)
            discard vector_push<i64>(output, 101)
        0:
            discard 0
        1:
            discard 0
    discard vector_push<i64>(output, 44)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 118)
    discard vector_push<i64>(output, 97)
    discard vector_push<i64>(output, 108)
    discard vector_push<i64>(output, 117)
    discard vector_push<i64>(output, 101)
    discard vector_push<i64>(output, 10)
    return 1

