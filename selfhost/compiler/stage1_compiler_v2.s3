                            discard vector_push<i64>(output, 44)
                            discard vector_push<i64>(output, 32)
                            discard vector_push<i64>(output, 114)
                            discard vector_push<i64>(output, 101)
                            discard vector_push<i64>(output, 102)
                            discard vector_push<i64>(output, 101)
                            discard vector_push<i64>(output, 114)
                            discard vector_push<i64>(output, 101)
                            discard vector_push<i64>(output, 110)
                            discard vector_push<i64>(output, 99)
                            discard vector_push<i64>(output, 101)
                            discard vector_push<i64>(output, 44)
                            discard vector_push<i64>(output, 32)
                            discard vector_push<i64>(output, 118)
                            discard vector_push<i64>(output, 101)
                            discard vector_push<i64>(output, 99)
                            discard vector_push<i64>(output, 116)
                            discard vector_push<i64>(output, 111)
                            discard vector_push<i64>(output, 114)
                            discard vector_push<i64>(output, 44)
                            discard vector_push<i64>(output, 32)
                            discard vector_push<i64>(output, 105)
                            discard vector_push<i64>(output, 109)
                            discard vector_push<i64>(output, 109)
                            discard vector_push<i64>(output, 117)
                            discard vector_push<i64>(output, 116)
                            discard vector_push<i64>(output, 97)
                            discard vector_push<i64>(output, 98)
                            discard vector_push<i64>(output, 108)
                            discard vector_push<i64>(output, 101)
                            discard vector_push<i64>(output, 44)
                            discard vector_push<i64>(output, 32)
                            discard vector_push<i64>(output, 118)
                            discard vector_push<i64>(output, 97)
                            discard vector_push<i64>(output, 108)
                            discard vector_push<i64>(output, 117)
                            discard vector_push<i64>(output, 101)
                            discard vector_push<i64>(output, 10)
                            return 1
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 0
        1:
            return 0

fn stage1_emit_ir_parameters(
    function_parameter_first: &vector<i64>,
    function_parameter_count: &vector<i64>,
    parameter_value_ids: &vector<i64>,
    parameter_type_ids: &vector<i64>,
    type_kinds: &vector<i64>,
    type_element_ids: &vector<i64>,
    type_mutability_flags: &vector<i64>,
    type_lengths: &vector<i64>,
    function_index: i64,
    output: &mut vector<i64>
) -> i64:
    mut first: i64 = i64_vector_get(function_parameter_first, function_index)
    mut count: i64 = i64_vector_get(function_parameter_count, function_index)
    mut index: i64 = 0
    while index < count:
        discard stage1_emit_literal(output, 3)
        discard stage1_emit_register(output, i64_vector_get(parameter_value_ids, first + index))
        match stage1_emit_ir_parameter_type_suffix(
            i64_vector_get(parameter_type_ids, first + index),
            type_kinds,
            type_element_ids,
            type_mutability_flags,
            type_lengths,
            output
        ) == 1:
            -1:
                discard 0
            0:
                return 0
            1:
                return 0
        index = index + 1
    return 1

fn stage1_emit_ir_callee_name(
    function_ids: &vector<i64>,
    function_name_first: &vector<i64>,
    function_name_count: &vector<i64>,
    function_name_bytes: &vector<i64>,
    callee_id: i64,
    output: &mut vector<i64>
) -> i64:
    mut index: i64 = 0
    while index < i64_vector_len(function_ids):
        match i64_vector_get(function_ids, index) == callee_id:
            -1:
                discard stage1_emit_ir_function_name(
                    function_name_first, function_name_count, function_name_bytes, index, output
                )
                index = i64_vector_len(function_ids)
            0:
                index = index + 1
            1:
                index = index + 1
    return 1

fn stage1_emit_memory_declaration(
    memory_id: i64,
    type_id: i64,
    length: i64,
    output: &mut vector<i64>
) -> i64:
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 46)
    discard vector_push<i64>(output, 109)
    discard vector_push<i64>(output, 101)
    discard vector_push<i64>(output, 109)
    discard vector_push<i64>(output, 111)
    discard vector_push<i64>(output, 114)
    discard vector_push<i64>(output, 121)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 109)
    discard stage1_emit_decimal(output, memory_id)
    discard vector_push<i64>(output, 44)
    discard vector_push<i64>(output, 32)
    match type_id == 0:
        -1:
            discard vector_push<i64>(output, 105)
            discard vector_push<i64>(output, 54)
            discard vector_push<i64>(output, 52)
        0:
            match type_id == 1:
                -1:
                    discard vector_push<i64>(output, 116)
                    discard vector_push<i64>(output, 114)
                    discard vector_push<i64>(output, 105)
                    discard vector_push<i64>(output, 116)
                0:
                    return 0
                1:
                    return 0
        1:
            return 0
    discard vector_push<i64>(output, 44)
    discard vector_push<i64>(output, 32)
    discard stage1_emit_decimal(output, length)
    discard vector_push<i64>(output, 44)
    discard vector_push<i64>(output, 32)
    discard vector_push<i64>(output, 109)
    discard vector_push<i64>(output, 117)
    discard vector_push<i64>(output, 116)
    discard vector_push<i64>(output, 97)
    discard vector_push<i64>(output, 98)
    discard vector_push<i64>(output, 108)
    discard vector_push<i64>(output, 101)
    discard vector_push<i64>(output, 10)
    return 1

fn stage1_emit_ir_memory_declarations(
    memory_ids: &vector<i64>,
    memory_types: &vector<i64>,
    memory_lengths: &vector<i64>,
    instruction_ids: &vector<i64>,
    instruction_function_ids: &vector<i64>,
    instruction_memory_ids: &vector<i64>,
    function_id: i64,
    output: &mut vector<i64>
) -> i64:
    mut memory_index: i64 = 0
    while memory_index < i64_vector_len(memory_ids):
        mut memory_id: i64 = i64_vector_get(memory_ids, memory_index)
        mut used: i64 = 0
        mut instruction_index: i64 = 0
        while instruction_index < i64_vector_len(instruction_ids):
            match i64_vector_get(instruction_function_ids, instruction_index) == function_id:
                -1:
                    match i64_vector_get(instruction_memory_ids, instruction_index) == memory_id:
                        -1:
                            used = 1
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
            instruction_index = instruction_index + 1
        match used == 1:
            -1:
                match stage1_emit_memory_declaration(
                    memory_id,
                    i64_vector_get(memory_types, memory_index),
                    i64_vector_get(memory_lengths, memory_index),
                    output
                ) == 1:
                    -1:
                        discard 0
                    0:
                        return 0
                    1:
                        return 0
            0:
                discard 0
            1:
                discard 0
        memory_index = memory_index + 1
    return 1

fn stage1_emit_ir_memory_instruction(
    opcode: i64,
    memory_id: i64,
    operand_first: i64,
    result_first: i64,
    result_value_ids: &vector<i64>,
    operand_value_ids: &vector<i64>,
    output: &mut vector<i64>
) -> i64:
    match opcode == 4:
        -1:
            discard vector_push<i64>(output, 32)
            discard vector_push<i64>(output, 32)
            discard vector_push<i64>(output, 32)
            discard vector_push<i64>(output, 32)
            discard vector_push<i64>(output, 84)
            discard vector_push<i64>(output, 76)
            discard vector_push<i64>(output, 79)
            discard vector_push<i64>(output, 65)
            discard vector_push<i64>(output, 68)
            discard vector_push<i64>(output, 32)
            discard vector_push<i64>(output, 32)
            discard stage1_emit_register(
                output, i64_vector_get(result_value_ids, result_first)
            )
            discard vector_push<i64>(output, 44)
            discard vector_push<i64>(output, 32)
            discard vector_push<i64>(output, 109)
            discard stage1_emit_decimal(output, memory_id)
            discard vector_push<i64>(output, 44)
            discard vector_push<i64>(output, 32)
            discard stage1_emit_register(
                output, i64_vector_get(operand_value_ids, operand_first)
            )
            discard vector_push<i64>(output, 10)
            return 1
        0:
            match opcode == 5:
                -1:
                    discard vector_push<i64>(output, 32)
                    discard vector_push<i64>(output, 32)
                    discard vector_push<i64>(output, 32)
                    discard vector_push<i64>(output, 32)
                    discard vector_push<i64>(output, 84)
                    discard vector_push<i64>(output, 83)
                    discard vector_push<i64>(output, 84)
                    discard vector_push<i64>(output, 79)
                    discard vector_push<i64>(output, 82)
                    discard vector_push<i64>(output, 69)
                    discard vector_push<i64>(output, 32)
                    discard vector_push<i64>(output, 109)
                    discard stage1_emit_decimal(output, memory_id)
                    discard vector_push<i64>(output, 44)
                    discard vector_push<i64>(output, 32)
                    discard stage1_emit_register(
                        output, i64_vector_get(operand_value_ids, operand_first)
                    )
                    discard vector_push<i64>(output, 44)
                    discard vector_push<i64>(output, 32)
                    discard stage1_emit_register(
                        output, i64_vector_get(operand_value_ids, operand_first + 1)
                    )
                    discard vector_push<i64>(output, 10)
                    return 1
                0:
                    return 0
                1:
                    return 0
        1:
            return 0

fn stage1_emit_ir_instruction(
    instruction_opcodes: &vector<i64>,
    instruction_operand_first: &vector<i64>,
    instruction_operand_count: &vector<i64>,
    instruction_result_first: &vector<i64>,
    instruction_immediates: &vector<i64>,
    instruction_callee_function_ids: &vector<i64>,
    instruction_memory_ids: &vector<i64>,
    instruction_target_first: &vector<i64>,
    instruction_target_count: &vector<i64>,
    result_value_ids: &vector<i64>,
    operand_value_ids: &vector<i64>,
    target_block_ids: &vector<i64>,
    function_ids: &vector<i64>,
    function_name_first: &vector<i64>,
    function_name_count: &vector<i64>,
    function_name_bytes: &vector<i64>,
    instruction_index: i64,
    entry_block_id: i64,
    output: &mut vector<i64>
) -> i64:
    mut opcode: i64 = i64_vector_get(instruction_opcodes, instruction_index)
    mut operand_first: i64 = i64_vector_get(instruction_operand_first, instruction_index)
    mut operand_count: i64 = i64_vector_get(instruction_operand_count, instruction_index)
    match opcode == 4:
        -1:
            return stage1_emit_ir_memory_instruction(
                opcode,
                i64_vector_get(instruction_memory_ids, instruction_index),
                operand_first,
                i64_vector_get(instruction_result_first, instruction_index),
                result_value_ids,
                operand_value_ids,
                output
            )
        0:
            match opcode == 5:
                -1:
                    return stage1_emit_ir_memory_instruction(
                        opcode,
                        i64_vector_get(instruction_memory_ids, instruction_index),
                        operand_first,
                        i64_vector_get(instruction_result_first, instruction_index),
                        result_value_ids,
                        operand_value_ids,
                        output
                    )
                0:
                    discard 0
                1:
                    return 0
        1:
            return 0
    match opcode == 2:
        -1:
            return stage1_emit_ir_control_instruction(
                opcode, operand_first, operand_count,
                i64_vector_get(instruction_target_first, instruction_index),
                i64_vector_get(instruction_target_count, instruction_index),
                operand_value_ids, target_block_ids, entry_block_id, output
            )
        0:
            match opcode == 8:
                -1:
                    return stage1_emit_ir_control_instruction(
                        opcode, operand_first, operand_count,
                        i64_vector_get(instruction_target_first, instruction_index),
                        i64_vector_get(instruction_target_count, instruction_index),
                        operand_value_ids, target_block_ids, entry_block_id, output
                    )
                0:
                    discard 0
                1:
                    discard 0
        1:
            discard 0
    match opcode == 0:
        -1:
            discard stage1_emit_literal(output, 7)
            discard stage1_emit_register(output, i64_vector_get(result_value_ids, i64_vector_get(instruction_result_first, instruction_index)))
            discard stage1_emit_literal(output, 8)
            discard stage1_emit_decimal(output, i64_vector_get(instruction_immediates, instruction_index))
        0:
            match opcode == 9:
                -1:
                    discard stage1_emit_literal(output, 9)
                    discard stage1_emit_register(output, i64_vector_get(result_value_ids, i64_vector_get(instruction_result_first, instruction_index)))
                    discard stage1_emit_literal(output, 8)
                    discard stage1_emit_register(output, i64_vector_get(operand_value_ids, operand_first))
                    discard stage1_emit_literal(output, 8)
                    discard stage1_emit_register(output, i64_vector_get(operand_value_ids, operand_first + 1))
                0:
                    match opcode == 10:
                        -1:
                            discard stage1_emit_literal(output, 10)
                            discard stage1_emit_register(output, i64_vector_get(result_value_ids, i64_vector_get(instruction_result_first, instruction_index)))
                            discard stage1_emit_literal(output, 8)
                            discard stage1_emit_register(output, i64_vector_get(operand_value_ids, operand_first))
                            discard stage1_emit_literal(output, 8)
                            discard stage1_emit_register(output, i64_vector_get(operand_value_ids, operand_first + 1))
                        0:
                            match opcode == 11:
                                -1:
                                    discard stage1_emit_literal(output, 16)
                                    discard stage1_emit_register(output, i64_vector_get(result_value_ids, i64_vector_get(instruction_result_first, instruction_index)))
                                    discard stage1_emit_literal(output, 8)
                                    discard stage1_emit_register(output, i64_vector_get(operand_value_ids, operand_first))
                                    discard stage1_emit_literal(output, 8)
                                    discard stage1_emit_register(output, i64_vector_get(operand_value_ids, operand_first + 1))
                                    discard stage1_emit_literal(output, 8)
                                    discard stage1_emit_decimal(output, i64_vector_get(instruction_immediates, instruction_index))
                                0:
                                    match opcode == 3:
                                        -1:
                                            discard stage1_emit_literal(output, 12)
                                            discard stage1_emit_register(output, i64_vector_get(result_value_ids, i64_vector_get(instruction_result_first, instruction_index)))
                                            discard stage1_emit_literal(output, 8)
                                            discard stage1_emit_ir_callee_name(
                                                function_ids,
                                                function_name_first,
                                                function_name_count,
                                                function_name_bytes,
                                                i64_vector_get(instruction_callee_function_ids, instruction_index),
                                                output
                                            )
                                            mut argument: i64 = 0
                                            while argument < operand_count:
                                                discard stage1_emit_literal(output, 8)
                                                discard stage1_emit_register(output, i64_vector_get(operand_value_ids, operand_first + argument))
                                                argument = argument + 1
                                        0:
                                            match opcode == 1:
                                                -1:
                                                    discard stage1_emit_literal(output, 11)
                                                    discard stage1_emit_register(output, i64_vector_get(operand_value_ids, operand_first))
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        1:
                                            return 0
                                1:
                                    return 0
                        1:
                            return 0
                1:
                    return 0
        1:
            return 0
    discard stage1_emit_literal(output, 14)
    return 1

fn stage1_emit_ir_control_instruction(
    opcode: i64,
    operand_first: i64,
    operand_count: i64,
    target_first: i64,
    target_count: i64,
    operand_value_ids: &vector<i64>,
    target_block_ids: &vector<i64>,
    entry_block_id: i64,
    output: &mut vector<i64>
) -> i64:
    match opcode == 2:
        -1:
            match operand_count == 1:
                -1:
                    match target_count == 3:
                        -1:
                            discard stage1_emit_cfg_literal(output, 2)
                            discard stage1_emit_register(
                                output, i64_vector_get(operand_value_ids, operand_first)
                            )
                            discard stage1_emit_cfg_literal(output, 4)
                            mut target_offset: i64 = 0
                            while target_offset < target_count:
                                match stage1_emit_cfg_target(
                                    output,
                                    i64_vector_get(target_block_ids, target_first + target_offset),
                                    entry_block_id
                                ) == 1:
                                    -1:
                                        discard 0
                                    0:
                                        return 0
                                    1:
                                        return 0
                                match target_offset < 2:
                                    -1:
                                        discard stage1_emit_cfg_literal(output, 4)
                                    0:
                                        discard 0
                                    1:
                                        discard 0
                                target_offset = target_offset + 1
                            discard stage1_emit_cfg_literal(output, 5)
                            return 1
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            match opcode == 8:
                -1:
                    match operand_count == 0:
                        -1:
                            match target_count == 1:
                                -1:
                                    discard stage1_emit_cfg_literal(output, 3)
                                    match stage1_emit_cfg_target(
                                        output,
                                        i64_vector_get(target_block_ids, target_first),
                                        entry_block_id
                                    ) == 1:
                                        -1:
                                            discard stage1_emit_cfg_literal(output, 5)
                                            return 1
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        1:
            return 0

fn stage1_emit_native_function(
    function_ids: &vector<i64>,
    function_name_first: &vector<i64>,
    function_name_count: &vector<i64>,
    function_name_bytes: &vector<i64>,
    function_result_type_ids: &vector<i64>,
    function_parameter_first: &vector<i64>,
    function_parameter_count: &vector<i64>,
    function_block_first: &vector<i64>,
    function_block_count: &vector<i64>,
    parameter_value_ids: &vector<i64>,
    parameter_type_ids: &vector<i64>,
    type_kinds: &vector<i64>,
    type_element_ids: &vector<i64>,
    type_mutability_flags: &vector<i64>,
    type_lengths: &vector<i64>,
    memory_ids: &vector<i64>,
    memory_types: &vector<i64>,
    memory_lengths: &vector<i64>,
    value_ids: &vector<i64>,
    definition_function_ids: &vector<i64>,
    value_type_ids: &vector<i64>,
    instruction_ids: &vector<i64>,
    instruction_function_ids: &vector<i64>,
    instruction_block_ids: &vector<i64>,
    instruction_opcodes: &vector<i64>,
    instruction_operand_first: &vector<i64>,
    instruction_operand_count: &vector<i64>,
    instruction_result_first: &vector<i64>,
    instruction_immediates: &vector<i64>,
    instruction_callee_function_ids: &vector<i64>,
    instruction_memory_ids: &vector<i64>,
    instruction_target_first: &vector<i64>,
    instruction_target_count: &vector<i64>,
    result_value_ids: &vector<i64>,
    operand_value_ids: &vector<i64>,
    block_ids: &vector<i64>,
    block_function_ids: &vector<i64>,
    block_instruction_first: &vector<i64>,
    block_instruction_count: &vector<i64>,
    target_block_ids: &vector<i64>,
    function_index: i64,
    output: &mut vector<i64>
) -> i64:
    mut function_id: i64 = i64_vector_get(function_ids, function_index)
    discard stage1_emit_literal(output, 1)
    discard stage1_emit_ir_function_name(
        function_name_first,
        function_name_count,
        function_name_bytes,
        function_index,
        output
    )
    match i64_vector_get(function_result_type_ids, function_index) == 0:
        -1:
            discard stage1_emit_literal(output, 2)
        0:
            match i64_vector_get(function_result_type_ids, function_index) == 1:
                -1:
                    discard stage1_emit_literal(output, 15)
                0:
                    return 0
                1:
                    return 0
        1:
            return 0
    match stage1_emit_ir_parameters(
        function_parameter_first,
        function_parameter_count,
        parameter_value_ids,
        parameter_type_ids,
        type_kinds,
        type_element_ids,
        type_mutability_flags,
        type_lengths,
        function_index,
        output
    ) == 1:
        -1:
            discard 0
        0:
            return 0
        1:
            return 0
    discard stage1_emit_ir_register_declarations(
        value_ids,
        definition_function_ids,
        value_type_ids,
        parameter_value_ids,
        function_id,
        output
    )
    match stage1_emit_ir_memory_declarations(
        memory_ids,
        memory_types,
        memory_lengths,
        instruction_ids,
        instruction_function_ids,
        instruction_memory_ids,
        function_id,
        output
    ) == 1:
        -1:
            discard 0
        0:
            return 0
        1:
            return 0
    mut block_first: i64 = i64_vector_get(function_block_first, function_index)
    mut block_count: i64 = i64_vector_get(function_block_count, function_index)
    match block_count > 0:
        -1:
            discard 0
        0:
            return 0
        1:
            return 0
    mut entry_block_id: i64 = i64_vector_get(block_ids, block_first)
    mut block_offset: i64 = 0
    while block_offset < block_count:
        mut block_index: i64 = block_first + block_offset
        mut block_id: i64 = i64_vector_get(block_ids, block_index)
        match i64_vector_get(block_function_ids, block_index) == function_id:
            -1:
                discard 0
            0:
                return 0
            1:
                return 0
        mut is_entry: i64 = 0
        match block_offset == 0:
            -1:
                is_entry = 1
            0:
                discard 0
            1:
                discard 0
        match stage1_emit_cfg_block_label(output, block_id, is_entry) == 1:
            -1:
                discard 0
            0:
                return 0
            1:
                return 0
        mut instruction_index: i64 = i64_vector_get(
            block_instruction_first, block_index
        )
        mut instruction_end: i64 = instruction_index + i64_vector_get(
            block_instruction_count, block_index
        )
        while instruction_index < instruction_end:
            match i64_vector_get(instruction_function_ids, instruction_index) == function_id:
                -1:
                    discard 0
                0:
                    return 0
                1:
                    return 0
            match i64_vector_get(instruction_block_ids, instruction_index) == block_id:
                -1:
                    discard 0
                0:
                    return 0
                1:
                    return 0
            match stage1_emit_ir_instruction(
                instruction_opcodes,
                instruction_operand_first,
                instruction_operand_count,
                instruction_result_first,
                instruction_immediates,
                instruction_callee_function_ids,
                instruction_memory_ids,
                instruction_target_first,
                instruction_target_count,
                result_value_ids,
                operand_value_ids,
                target_block_ids,
                function_ids,
                function_name_first,
                function_name_count,
                function_name_bytes,
                instruction_index,
                entry_block_id,
                output
            ) == 1:
                -1:
                    discard 0
                0:
                    return 0
                1:
                    return 0
            instruction_index = instruction_index + 1
        block_offset = block_offset + 1
    discard stage1_emit_literal(output, 13)
    return 1

fn stage1_emit_native_program(program: NativeIR, output: &mut vector<i64>) -> i64:
    discard stage1_emit_literal(output, 0)
    mut function_index: i64 = 0
    while function_index < i64_vector_len(&program.function_ids):
        match i64_vector_get(&program.function_external_flags, function_index) == 0:
            -1:
                match stage1_emit_native_function(
                    &program.function_ids,
                    &program.function_name_first,
                    &program.function_name_count,
                    &program.function_name_bytes,
                    &program.function_result_type_ids,
                    &program.function_parameter_first,
                    &program.function_parameter_count,
                    &program.function_block_first,
                    &program.function_block_count,
                    &program.parameter_value_ids,
                    &program.parameter_type_ids,
                    &program.type_kinds,
                    &program.type_element_ids,
                    &program.type_mutability_flags,
                    &program.type_lengths,
                    &program.memory_ids,
                    &program.memory_types,
                    &program.memory_lengths,
                    &program.value_ids,
                    &program.definition_function_ids,
                    &program.value_type_ids,
                    &program.instruction_ids,
                    &program.instruction_function_ids,
                    &program.instruction_block_ids,
                    &program.instruction_opcodes,
                    &program.instruction_operand_first,
                    &program.instruction_operand_count,
                    &program.instruction_result_first,
                    &program.instruction_immediates,
                    &program.instruction_callee_function_ids,
                    &program.instruction_memory_ids,
                    &program.instruction_target_first,
                    &program.instruction_target_count,
                    &program.result_value_ids,
                    &program.operand_value_ids,
                    &program.block_ids,
                    &program.block_function_ids,
                    &program.block_instruction_first,
                    &program.block_instruction_count,
                    &program.target_block_ids,
                    function_index,
                    output
                ) == 1:
                    -1:
                        discard 0
                    0:
                        return 0
                    1:
                        return 0
            0:
                discard 0
            1:
                discard 0
        function_index = function_index + 1
    return 1

export fn stage1_emit_verified_native_program(
    program: NativeIR,
    output: &mut vector<i64>
) -> i64:
    mut verified: NativeIRVerifiedResult = verify_program(program)
    match verified.verification.accepted == 1:
        -1:
            return stage1_emit_native_program(verified.program, output)
        0:
            return 0
        1:
            return 0

fn stage1_skip_body_newlines(tokens: &vector<i64>, start_cursor: i64) -> i64:
    mut cursor: i64 = start_cursor
    mut token_count: i64 = generic_token_count(tokens)
    while cursor < token_count:
        match generic_token_kind(tokens, cursor) == 6:
            -1:
                cursor = cursor + 1
            0:
                return cursor
            1:
                return cursor
    return cursor

fn stage1_body_compile_failure(
    program: NativeIR,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>
) -> Stage1BodyCompileResult:
    return Stage1BodyCompileResult(
        program=program,
        symbol_name_starts=symbol_name_starts,
        symbol_name_ends=symbol_name_ends,
        symbol_value_ids=symbol_value_ids,
        return_value_id=-1,
        accepted=0
    )

fn stage1_source_span_is_mut(
    source: &vector<i64>,
    start: i64,
    end: i64
) -> i64:
    match end - start == 3:
        -1:
            match vector_get<i64>(source, start) == 109:
                -1:
                    match vector_get<i64>(source, start + 1) == 117:
                        -1:
                            match vector_get<i64>(source, start + 2) == 116:
                                -1:
                                    return 1
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn stage1_local_declaration_name_cursor(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64
) -> i64:
    match generic_token_kind(tokens, cursor) == 1:
        -1:
            match generic_token_kind(tokens, cursor + 1) == 158:
                -1:
                    return cursor
                0:
                    match stage1_source_span_is_mut(
                        source,
                        generic_token_start(tokens, cursor),
                        generic_token_end(tokens, cursor)
                    ) == 1:
                        -1:
                            match generic_token_kind(tokens, cursor + 1) == 1:
                                -1:
                                    match generic_token_kind(tokens, cursor + 2) == 158:
                                        -1:
                                            return cursor + 1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn stage1_lower_source_expression(
    source: &vector<i64>,
    tokens: &vector<i64>,
    expression_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: &vector<i64>,
    symbol_name_ends: &vector<i64>,
    symbol_value_ids: &vector<i64>
) -> Stage1ExpressionLowerResult:
    mut tree: vector<i64> = generic_native_parser_parse_expression(
        source, tokens, expression_cursor, 0
    )
    mut packed: i64 = generic_expression_packed_result(&tree)
    match packed >= 0:
        -1:
            match generic_expression_node_count(&tree) <= 63:
                -1:
                    mut lowered: Stage1LowerResult = stage1_lower_expression(
                        generic_native_parser_packed_node(packed),
                        source,
                        &tree,
                        program,
                        function_id,
                        block_id,
                        symbol_name_starts,
                        symbol_name_ends,
                        symbol_value_ids
                    )
                    mut accepted: i64 = lowered.accepted
                    mut value_id: i64 = lowered.value_id
                    mut next_cursor: i64 = generic_native_parser_packed_cursor(packed)
                    mut lowered_program: NativeIR = lowered.program
                    return Stage1ExpressionLowerResult(
                        program=lowered_program,
                        value_id=value_id,
                        next_cursor=next_cursor,
                        accepted=accepted
                    )
                0:
                    return Stage1ExpressionLowerResult(
                        program=program, value_id=-1, next_cursor=-1, accepted=0
                    )
                1:
                    return Stage1ExpressionLowerResult(
                        program=program, value_id=-1, next_cursor=-1, accepted=0
                    )
        0:
            return Stage1ExpressionLowerResult(
                program=program, value_id=-1, next_cursor=-1, accepted=0
            )
        1:
            return Stage1ExpressionLowerResult(
                program=program, value_id=-1, next_cursor=-1, accepted=0
            )

fn stage1_compile_assignment_statement(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_mutability_flags: vector<i64>,
    statement_count: i64
) -> Stage1BodyCompileResult:
    mut symbol_index: i64 = stage1_find_symbol_index(
        source,
        &symbol_name_starts,
        &symbol_name_ends,
        generic_token_start(tokens, cursor),
        generic_token_end(tokens, cursor)
    )
    match symbol_index >= 0:
        -1:
            match vector_get<i64>(&symbol_mutability_flags, symbol_index) == 1:
                -1:
                    mut lowered: Stage1ExpressionLowerResult = stage1_lower_source_expression(
                        source,
                        tokens,
                        cursor + 2,
                        program,
                        function_id,
                        block_id,
                        &symbol_name_starts,
                        &symbol_name_ends,
                        &symbol_value_ids
                    )
                    match lowered.accepted == 1:
                        -1:
                            match generic_token_kind(tokens, lowered.next_cursor) == 6:
                                -1:
                                    mut next_values: vector<i64> = symbol_value_ids
                                    discard vector_set<i64>(
                                        &mut next_values, symbol_index, lowered.value_id
                                    )
                                    return stage1_compile_body_sequence(
                                        source,
                                        tokens,
                                        lowered.next_cursor + 1,
                                        body_end_cursor,
                                        lowered.program,
                                        function_id,
                                        block_id,
                                        symbol_name_starts,
                                        symbol_name_ends,
                                        next_values,
                                        symbol_mutability_flags,
                                        statement_count + 1
                                    )
                                0:
                                    return stage1_body_compile_failure(
                                        lowered.program,
                                        symbol_name_starts,
                                        symbol_name_ends,
                                        symbol_value_ids
                                    )
                                1:
                                    return stage1_body_compile_failure(
                                        lowered.program,
                                        symbol_name_starts,
                                        symbol_name_ends,
                                        symbol_value_ids
                                    )
                        0:
                            return stage1_body_compile_failure(
                                lowered.program,
                                symbol_name_starts,
                                symbol_name_ends,
                                symbol_value_ids
                            )
                        1:
                            return stage1_body_compile_failure(
                                lowered.program,
                                symbol_name_starts,
                                symbol_name_ends,
                                symbol_value_ids
                            )
                0:
                    return stage1_body_compile_failure(
                        program,
                        symbol_name_starts,
                        symbol_name_ends,
                        symbol_value_ids
                    )
                1:
                    return stage1_body_compile_failure(
                        program,
                        symbol_name_starts,
                        symbol_name_ends,
                        symbol_value_ids
                    )
        0:
            return stage1_body_compile_failure(
                program,
                symbol_name_starts,
                symbol_name_ends,
                symbol_value_ids
            )
        1:
            return stage1_body_compile_failure(
                program,
                symbol_name_starts,
                symbol_name_ends,
                symbol_value_ids
            )

fn stage1_compile_body_sequence_non_assignment(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_mutability_flags: vector<i64>,
    statement_count: i64
) -> Stage1BodyCompileResult:
    mut current_cursor: i64 = stage1_skip_body_newlines(tokens, cursor)
    match current_cursor == body_end_cursor:
        -1:
            return stage1_body_compile_failure(
                program, symbol_name_starts, symbol_name_ends, symbol_value_ids
            )
        0:
            match statement_count < 64:
                -1:
                    match generic_native_parser_program_indent(
                        source, generic_token_start(tokens, current_cursor)
                    ) == 4:
                        -1:
                            match generic_token_kind(tokens, current_cursor) == 3:
                                -1:
                                    mut expression_cursor: i64 = current_cursor + 1
                                    mut lowered: Stage1ExpressionLowerResult = stage1_lower_source_expression(
                                        source,
                                        tokens,
                                        expression_cursor,
                                        program,
                                        function_id,
                                        block_id,
                                        &symbol_name_starts,
                                        &symbol_name_ends,
                                        &symbol_value_ids
                                    )
                                    mut accepted: i64 = lowered.accepted
                                    mut return_value_id: i64 = lowered.value_id
                                    mut after_return: i64 = lowered.next_cursor
                                    mut lowered_program: NativeIR = lowered.program
                                    match accepted == 1:
                                        -1:
                                            match generic_token_kind(tokens, after_return) == 6:
                                                -1:
                                                    mut after_blank_lines: i64 = stage1_skip_body_newlines(
                                                        tokens, after_return + 1
                                                    )
                                                    match after_blank_lines == body_end_cursor:
                                                        -1:
                                                            return Stage1BodyCompileResult(
                                                                program=lowered_program,
                                                                symbol_name_starts=symbol_name_starts,
                                                                symbol_name_ends=symbol_name_ends,
                                                                symbol_value_ids=symbol_value_ids,
                                                                return_value_id=return_value_id,
                                                                accepted=1
                                                            )
                                                        0:
                                                            return stage1_body_compile_failure(
                                                                lowered_program,
                                                                symbol_name_starts,
                                                                symbol_name_ends,
                                                                symbol_value_ids
                                                            )
                                                        1:
                                                            return stage1_body_compile_failure(
                                                                lowered_program,
                                                                symbol_name_starts,
                                                                symbol_name_ends,
                                                                symbol_value_ids
                                                            )
                                                0:
                                                    return stage1_body_compile_failure(
                                                        lowered_program,
                                                        symbol_name_starts,
                                                        symbol_name_ends,
                                                        symbol_value_ids
                                                    )
                                                1:
                                                    return stage1_body_compile_failure(
                                                        lowered_program,
                                                        symbol_name_starts,
                                                        symbol_name_ends,
                                                        symbol_value_ids
                                                    )
                                        0:
                                            return stage1_body_compile_failure(
                                                lowered_program,
                                                symbol_name_starts,
                                                symbol_name_ends,
                                                symbol_value_ids
                                            )
                                        1:
                                            return stage1_body_compile_failure(
                                                lowered_program,
                                                symbol_name_starts,
                                                symbol_name_ends,
                                                symbol_value_ids
                                            )
                                0:
                                    match generic_token_kind(tokens, current_cursor) == 1:
                                        -1:
                                            mut declaration_name_cursor: i64 = stage1_local_declaration_name_cursor(
                                                source, tokens, current_cursor
                                            )
                                            mut declaration_mutable: i64 = 0
                                            match declaration_name_cursor == current_cursor + 1:
                                                -1:
                                                    declaration_mutable = 1
                                                0:
                                                    discard 0
                                                1:
                                                    discard 0
                                            match declaration_name_cursor >= 0:
                                                -1:
                                                    current_cursor = declaration_name_cursor
                                                0:
                                                    discard 0
                                                1:
                                                    discard 0
                                            match generic_token_kind(tokens, current_cursor + 1) == 158:
                                                -1:
                                                    match generic_native_parser_program_type_code_for_token(
                                                        source, tokens, current_cursor + 2
                                                    ) == 2:
                                                        -1:
                                                            match generic_token_kind(tokens, current_cursor + 3) == 161:
                                                                -1:
                                                                    mut name_start: i64 = generic_token_start(tokens, current_cursor)
                                                                    mut name_end: i64 = generic_token_end(tokens, current_cursor)
                                                                    mut existing_value: i64 = stage1_find_symbol_value(
                                                                        source,
                                                                        &symbol_name_starts,
                                                                        &symbol_name_ends,
                                                                        &symbol_value_ids,
                                                                        name_start,
                                                                        name_end
                                                                    )
                                                                    match existing_value < 0:
                                                                        -1:
                                                                            mut expression_cursor: i64 = current_cursor + 4
                                                                            mut lowered: Stage1ExpressionLowerResult = stage1_lower_source_expression(
                                                                                source,
                                                                                tokens,
                                                                                expression_cursor,
                                                                                program,
                                                                                function_id,
                                                                                block_id,
                                                                                &symbol_name_starts,
                                                                                &symbol_name_ends,
                                                                                &symbol_value_ids
                                                                            )
                                                                            mut accepted: i64 = lowered.accepted
                                                                            mut local_value_id: i64 = lowered.value_id
                                                                            mut after_expression: i64 = lowered.next_cursor
                                                                            mut lowered_program: NativeIR = lowered.program
                                                                            match accepted == 1:
                                                                                -1:
                                                                                    match generic_token_kind(tokens, after_expression) == 6:
                                                                                        -1:
                                                                                            mut next_names: vector<i64> = symbol_name_starts
                                                                                            mut next_ends: vector<i64> = symbol_name_ends
                                                                                            mut next_values: vector<i64> = symbol_value_ids
                                                                                            mut next_mutability: vector<i64> = symbol_mutability_flags
                                                                                            discard vector_push<i64>(&mut next_names, name_start)
                                                                                            discard vector_push<i64>(&mut next_ends, name_end)
                                                                                            discard vector_push<i64>(&mut next_values, local_value_id)
                                                                                            discard vector_push<i64>(&mut next_mutability, declaration_mutable)
                                                                                            return stage1_compile_body_sequence(
                                                                                                source,
                                                                                                tokens,
                                                                                                after_expression + 1,
                                                                                                body_end_cursor,
                                                                                                lowered_program,
                                                                                                function_id,
                                                                                                block_id,
                                                                                                next_names,
                                                                                                next_ends,
                                                                                                next_values,
                                                                                                next_mutability,
                                                                                                statement_count + 1
                                                                                            )
                                                                                        0:
                                                                                            return stage1_body_compile_failure(
                                                                                                lowered_program,
                                                                                                symbol_name_starts,
                                                                                                symbol_name_ends,
                                                                                                symbol_value_ids
                                                                                            )
                                                                                        1:
                                                                                            return stage1_body_compile_failure(
                                                                                                lowered_program,
                                                                                                symbol_name_starts,
                                                                                                symbol_name_ends,
                                                                                                symbol_value_ids
                                                                                            )
                                                                                0:
                                                                                    return stage1_body_compile_failure(
                                                                                        lowered_program,
                                                                                        symbol_name_starts,
                                                                                        symbol_name_ends,
                                                                                        symbol_value_ids
                                                                                    )
                                                                                1:
                                                                                    return stage1_body_compile_failure(
                                                                                        lowered_program,
                                                                                        symbol_name_starts,
                                                                                        symbol_name_ends,
                                                                                        symbol_value_ids
                                                                                    )
                                                                        0:
                                                                            return stage1_body_compile_failure(
                                                                                program,
                                                                                symbol_name_starts,
                                                                                symbol_name_ends,
                                                                                symbol_value_ids
                                                                            )
                                                                        1:
                                                                            return stage1_body_compile_failure(
                                                                                program,
                                                                                symbol_name_starts,
                                                                                symbol_name_ends,
                                                                                symbol_value_ids
                                                                            )
                                                                0:
                                                                    return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                                                                1:
                                                                    return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                                                        0:
                                                            return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                                                        1:
                                                            return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                                                0:
                                                    return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                                                1:
                                                    return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                                        0:
                                            return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                                        1:
                                            return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                                1:
                                    return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                        0:
                            return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                        1:
                            return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                0:
                    return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                1:
                    return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
        1:
            return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)

fn stage1_compile_body_sequence(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_mutability_flags: vector<i64>,
    statement_count: i64
) -> Stage1BodyCompileResult:
    mut current_cursor: i64 = stage1_skip_body_newlines(tokens, cursor)
    match current_cursor < body_end_cursor:
        -1:
            match generic_native_parser_program_indent(
                source, generic_token_start(tokens, current_cursor)
            ) == 4:
                -1:
                    match generic_token_kind(tokens, current_cursor) == 1:
                        -1:
                            match generic_token_kind(tokens, current_cursor + 1) == 161:
                                -1:
                                    return stage1_compile_assignment_statement(
                                        source,
                                        tokens,
                                        current_cursor,
                                        body_end_cursor,
                                        program,
                                        function_id,
                                        block_id,
                                        symbol_name_starts,
                                        symbol_name_ends,
                                        symbol_value_ids,
                                        symbol_mutability_flags,
                                        statement_count
                                    )
                                0:
                                    return stage1_compile_body_sequence_non_assignment(
                                        source, tokens, cursor, body_end_cursor, program,
                                        function_id, block_id, symbol_name_starts,
                                        symbol_name_ends, symbol_value_ids,
                                        symbol_mutability_flags, statement_count
                                    )
                                1:
                                    return stage1_compile_body_sequence_non_assignment(
                                        source, tokens, cursor, body_end_cursor, program,
                                        function_id, block_id, symbol_name_starts,
                                        symbol_name_ends, symbol_value_ids,
                                        symbol_mutability_flags, statement_count
                                    )
                        0:
                            return stage1_compile_body_sequence_non_assignment(
                                source, tokens, cursor, body_end_cursor, program,
                                function_id, block_id, symbol_name_starts,
                                symbol_name_ends, symbol_value_ids,
                                symbol_mutability_flags, statement_count
                            )
                        1:
                            return stage1_compile_body_sequence_non_assignment(
                                source, tokens, cursor, body_end_cursor, program,
                                function_id, block_id, symbol_name_starts,
                                symbol_name_ends, symbol_value_ids,
                                symbol_mutability_flags, statement_count
                            )
                0:
                    return stage1_compile_body_sequence_non_assignment(
                        source, tokens, cursor, body_end_cursor, program,
                        function_id, block_id, symbol_name_starts,
                        symbol_name_ends, symbol_value_ids,
                        symbol_mutability_flags, statement_count
                    )
                1:
                    return stage1_compile_body_sequence_non_assignment(
                        source, tokens, cursor, body_end_cursor, program,
                        function_id, block_id, symbol_name_starts,
                        symbol_name_ends, symbol_value_ids,
                        symbol_mutability_flags, statement_count
                    )
        0:
            return stage1_compile_body_sequence_non_assignment(
                source, tokens, cursor, body_end_cursor, program,
                function_id, block_id, symbol_name_starts,
                symbol_name_ends, symbol_value_ids,
                symbol_mutability_flags, statement_count
            )
        1:
            return stage1_compile_body_sequence_non_assignment(
                source, tokens, cursor, body_end_cursor, program,
                function_id, block_id, symbol_name_starts,
                symbol_name_ends, symbol_value_ids,
                symbol_mutability_flags, statement_count
            )

fn stage1_compile_registered_function(
    initial_program: NativeIR,
    source: &vector<i64>,
    tokens: &vector<i64>,
    expression_cursors: &vector<i64>,
    parameter_name_starts: &vector<i64>,
    parameter_name_ends: &vector<i64>,
    function_index: i64
) -> Stage1LowerResult:
    mut program: NativeIR = initial_program
    mut function_id: i64 = function_index
    mut block_append: NativeIRAppendResult = native_ir_append_block_for_function(
        program, function_id, function_id, 1
    )
    mut block_accepted: i64 = block_append.accepted
    match block_accepted == 1:
        -1:
            program = block_append.program
        0:
            return stage1_lower_preserved_failure(block_append.program)
        1:
            return stage1_lower_preserved_failure(block_append.program)
    mut expression_cursor: i64 = vector_get<i64>(expression_cursors, function_index)
    mut symbol_name_starts: vector<i64> = vector_new<i64>(64)
    mut symbol_name_ends: vector<i64> = vector_new<i64>(64)
    mut symbol_value_ids: vector<i64> = vector_new<i64>(64)
    mut symbol_mutability_flags: vector<i64> = vector_new<i64>(64)
    mut parameter_first: i64 = i64_vector_get(&program.function_parameter_first, function_index)
    mut parameter_count: i64 = i64_vector_get(&program.function_parameter_count, function_index)
    mut parameter_index: i64 = 0
    while parameter_index < parameter_count:
        discard vector_push<i64>(
            &mut symbol_name_starts,
            vector_get<i64>(parameter_name_starts, parameter_first + parameter_index)
        )
        discard vector_push<i64>(
            &mut symbol_name_ends,
            vector_get<i64>(parameter_name_ends, parameter_first + parameter_index)
        )
        discard vector_push<i64>(
            &mut symbol_value_ids,
            i64_vector_get(&program.parameter_value_ids, parameter_first + parameter_index)
        )
        discard vector_push<i64>(&mut symbol_mutability_flags, 0)
        parameter_index = parameter_index + 1
    mut body_end_cursor: i64 = stage1_function_body_end(source, tokens, expression_cursor)
    match body_end_cursor >= 0:
        -1:
            discard 0
        0:
            return stage1_lower_preserved_failure(program)
        1:
            return stage1_lower_preserved_failure(program)
    mut body: Stage1BodyCompileResult = stage1_compile_body_sequence(
        source,
        tokens,
        expression_cursor,
        body_end_cursor,
        program,
        function_id,
        function_id,
        symbol_name_starts,
        symbol_name_ends,
        symbol_value_ids,
        symbol_mutability_flags,
        0
    )
    mut body_accepted: i64 = body.accepted
    mut lowered_value_id: i64 = body.return_value_id
    match body_accepted == 1:
        -1:
            program = body.program
        0:
            return stage1_lower_preserved_failure(body.program)
        1:
            return stage1_lower_preserved_failure(body.program)
    mut returned: NativeIRAppendResult = native_ir_append_instruction_for_function(
        program, function_id, function_id, 1, 0, lowered_value_id, -1, -1
    )
    mut returned_accepted: i64 = returned.accepted
    match returned_accepted == 1:
        -1:
            return stage1_lower_from_append(returned)
        0:
            return stage1_lower_preserved_failure(returned.program)
        1:
            return stage1_lower_preserved_failure(returned.program)

fn stage1_compile_function_sequence(
    initial_program: NativeIR,
    source: &vector<i64>,
    tokens: &vector<i64>,
    expression_cursors: &vector<i64>,
    parameter_name_starts: &vector<i64>,
    parameter_name_ends: &vector<i64>,
    function_index: i64,
    function_count: i64
) -> Stage1LowerResult:
    mut program: NativeIR = initial_program
    match function_index < function_count:
        -1:
            mut lowered_function: Stage1LowerResult = stage1_compile_registered_function(
                program, source, tokens, expression_cursors,
                parameter_name_starts, parameter_name_ends, function_index
            )
            mut lowered_function_accepted: i64 = lowered_function.accepted
            match lowered_function_accepted == 1:
                -1:
                    return stage1_compile_function_sequence(
                        lowered_function.program,
                        source,
                        tokens,
                        expression_cursors,
                        parameter_name_starts,
                        parameter_name_ends,
                        function_index + 1,
                        function_count
                    )
                0:
                    return stage1_lower_preserved_failure(lowered_function.program)
                1:
                    return stage1_lower_preserved_failure(lowered_function.program)
        0:
            return Stage1LowerResult(program=program, value_id=-1, accepted=1)
        1:
            return Stage1LowerResult(program=program, value_id=-1, accepted=1)

fn stage1_function_scan_state(
    program: NativeIR,
    name_starts: vector<i64>,
    name_ends: vector<i64>,
    parameter_name_starts: vector<i64>,
    parameter_name_ends: vector<i64>,
    expression_cursors: vector<i64>,
    cursor: i64,
    function_count: i64,
    main_count: i64,
    accepted: i64,
    error_code: i64
) -> Stage1FunctionScanState:
    return Stage1FunctionScanState(
        program=program,
        name_starts=name_starts,
        name_ends=name_ends,
        parameter_name_starts=parameter_name_starts,
        parameter_name_ends=parameter_name_ends,
        expression_cursors=expression_cursors,
        cursor=cursor,
        function_count=function_count,
        main_count=main_count,
        accepted=accepted,
        error_code=error_code
    )

fn stage1_source_name_is_main(source: &vector<i64>, name_start: i64, name_end: i64) -> i64:
    match name_end - name_start == 4:
        -1:
            mut expected: vector<i64> = vector_new<i64>(4)
            discard vector_push<i64>(&mut expected, 109)
            discard vector_push<i64>(&mut expected, 97)
            discard vector_push<i64>(&mut expected, 105)
            discard vector_push<i64>(&mut expected, 110)
            mut matched: i64 = 1
            mut offset: i64 = 0
            while offset < 4:
                match vector_get<i64>(source, name_start + offset) == vector_get<i64>(&expected, offset):
                    -1:
                        discard 0
                    0:
                        matched = 0
                    1:
                        matched = 0
                offset = offset + 1
            return matched
        0:
            return 0
        1:
            return 0

fn stage1_intern_parameter_type(
    program: NativeIR,
    type_code: i64
) -> Stage1InternedTypeResult:
    match type_code == 0:
        -1:
            return Stage1InternedTypeResult(program=program, type_id=0, accepted=1)
        0:
            match type_code == 1:
                -1:
                    mut vector_type: NativeIRAppendResult = native_ir_intern_composite_type(
                        program, 2, 0, 0, -1
                    )
                    match vector_type.accepted == 1:
                        -1:
                            mut vector_type_id: i64 = vector_type.value_id
                            mut vector_program: NativeIR = vector_type.program
                            mut reference_type: NativeIRAppendResult = native_ir_intern_composite_type(
                                vector_program, 3, vector_type_id, 0, -1
                            )
                            match reference_type.accepted == 1:
                                -1:
                                    mut reference_type_id: i64 = reference_type.value_id
                                    mut reference_program: NativeIR = reference_type.program
                                    return Stage1InternedTypeResult(
                                        program=reference_program,
                                        type_id=reference_type_id,
                                        accepted=1
                                    )
                                0:
                                    return Stage1InternedTypeResult(
                                        program=reference_type.program, type_id=-1, accepted=0
                                    )
                                1:
                                    return Stage1InternedTypeResult(
                                        program=reference_type.program, type_id=-1, accepted=0
                                    )
                        0:
                            return Stage1InternedTypeResult(
                                program=vector_type.program, type_id=-1, accepted=0
                            )
                        1:
                            return Stage1InternedTypeResult(
                                program=vector_type.program, type_id=-1, accepted=0
                            )
                0:
                    match type_code == 2:
                        -1:
                            return Stage1InternedTypeResult(
                                program=program, type_id=1, accepted=1
                            )
                        0:
                            return Stage1InternedTypeResult(
                                program=program, type_id=-1, accepted=0
                            )
                        1:
                            return Stage1InternedTypeResult(
                                program=program, type_id=-1, accepted=0
                            )
                1:
                    return Stage1InternedTypeResult(program=program, type_id=-1, accepted=0)
        1:
            return Stage1InternedTypeResult(program=program, type_id=-1, accepted=0)

fn stage1_apply_result_type(
    program: NativeIR,
    function_id: i64,
    result_type_code: i64
) -> NativeIRAppendResult:
    match result_type_code == 0:
        -1:
            return NativeIRAppendResult(program=program, accepted=1, value_id=0)
        0:
            match result_type_code == 1:
                -1:
                    return native_ir_set_function_result_type(program, function_id, 1)
                0:
                    return NativeIRAppendResult(program=program, accepted=0, value_id=-1)
                1:
                    return NativeIRAppendResult(program=program, accepted=0, value_id=-1)
        1:
            return NativeIRAppendResult(program=program, accepted=0, value_id=-1)

fn stage1_register_i64_vector_external(
    program: NativeIR,
    function_id: i64,
    name: &vector<i64>,
    parameter_count: i64
) -> NativeIRAppendResult:
    mut reference_type: Stage1InternedTypeResult = stage1_intern_parameter_type(
        program, 1
    )
    match reference_type.accepted == 1:
        -1:
            mut reference_type_id: i64 = reference_type.type_id
            mut typed_program: NativeIR = reference_type.program
            mut external: NativeIRAppendResult = native_ir_append_external_function_source(
                typed_program,
                function_id,
                1,
                0,
                name,
                0,
                vector_len<i64>(name)
            )
            match external.accepted == 1:
                -1:
                    mut first_parameter: NativeIRAppendResult = native_ir_append_typed_parameter(
                        external.program, function_id, 0, reference_type_id
                    )
                    match first_parameter.accepted == 1:
                        -1:
                            match parameter_count == 1:
                                -1:
                                    return first_parameter
                                0:
                                    match parameter_count == 2:
                                        -1:
                                            return native_ir_append_typed_parameter(
                                                first_parameter.program,
                                                function_id,
                                                1,
                                                0
                                            )
                                        0:
                                            return NativeIRAppendResult(
                                                program=first_parameter.program,
                                                accepted=0,
                                                value_id=-1
                                            )
                                        1:
                                            return NativeIRAppendResult(
                                                program=first_parameter.program,
                                                accepted=0,
                                                value_id=-1
                                            )
                                1:
                                    return NativeIRAppendResult(
                                        program=first_parameter.program,
                                        accepted=0,
                                        value_id=-1
                                    )
                        0:
                            return first_parameter
                        1:
                            return first_parameter
                0:
                    return external
                1:
                    return external
        0:
            return NativeIRAppendResult(
                program=reference_type.program, accepted=0, value_id=-1
            )
        1:
            return NativeIRAppendResult(
                program=reference_type.program, accepted=0, value_id=-1
            )

fn stage1_register_i64_vector_get(program: NativeIR) -> NativeIRAppendResult:
    mut name: vector<i64> = vector_new<i64>(14)
    discard vector_push<i64>(&mut name, 105)
    discard vector_push<i64>(&mut name, 54)
    discard vector_push<i64>(&mut name, 52)
    discard vector_push<i64>(&mut name, 95)
    discard vector_push<i64>(&mut name, 118)
    discard vector_push<i64>(&mut name, 101)
    discard vector_push<i64>(&mut name, 99)
    discard vector_push<i64>(&mut name, 116)
    discard vector_push<i64>(&mut name, 111)
    discard vector_push<i64>(&mut name, 114)
    discard vector_push<i64>(&mut name, 95)
    discard vector_push<i64>(&mut name, 103)
    discard vector_push<i64>(&mut name, 101)
    discard vector_push<i64>(&mut name, 116)
    return stage1_register_i64_vector_external(program, 1000, &name, 2)

fn stage1_register_i64_vector_len(program: NativeIR) -> NativeIRAppendResult:
    mut name: vector<i64> = vector_new<i64>(14)
    discard vector_push<i64>(&mut name, 105)
    discard vector_push<i64>(&mut name, 54)
    discard vector_push<i64>(&mut name, 52)
    discard vector_push<i64>(&mut name, 95)
    discard vector_push<i64>(&mut name, 118)
    discard vector_push<i64>(&mut name, 101)
    discard vector_push<i64>(&mut name, 99)
    discard vector_push<i64>(&mut name, 116)
    discard vector_push<i64>(&mut name, 111)
    discard vector_push<i64>(&mut name, 114)
    discard vector_push<i64>(&mut name, 95)
    discard vector_push<i64>(&mut name, 108)
    discard vector_push<i64>(&mut name, 101)
    discard vector_push<i64>(&mut name, 110)
    return stage1_register_i64_vector_external(program, 1001, &name, 1)

fn stage1_register_parameters(
    program: NativeIR,
    function_id: i64,
    parameter_index: i64,
    parameter_name_starts: &vector<i64>,
    parameter_name_ends: &vector<i64>,
    parameter_type_codes: &vector<i64>,
    registered_name_starts: vector<i64>,
    registered_name_ends: vector<i64>
) -> Stage1ParameterRegistrationResult:
    match parameter_index < vector_len<i64>(parameter_name_starts):
        -1:
            mut interned_type: Stage1InternedTypeResult = stage1_intern_parameter_type(
                program, vector_get<i64>(parameter_type_codes, parameter_index)
            )
            match interned_type.accepted == 1:
                -1:
                    mut interned_type_id: i64 = interned_type.type_id
                    mut interned_program: NativeIR = interned_type.program
                    mut appended: NativeIRAppendResult = native_ir_append_typed_parameter(
                        interned_program,
                        function_id,
                        parameter_index,
                        interned_type_id
                    )
                    match appended.accepted == 1:
                        -1:
                            discard vector_push<i64>(
                                &mut registered_name_starts,
                                vector_get<i64>(parameter_name_starts, parameter_index)
                            )
                            discard vector_push<i64>(
                                &mut registered_name_ends,
                                vector_get<i64>(parameter_name_ends, parameter_index)
                            )
                            return stage1_register_parameters(
                                appended.program,
                                function_id,
                                parameter_index + 1,
                                parameter_name_starts,
                                parameter_name_ends,
                                parameter_type_codes,
                                registered_name_starts,
                                registered_name_ends
                            )
                        0:
                            return Stage1ParameterRegistrationResult(
                                program=appended.program,
                                name_starts=registered_name_starts,
                                name_ends=registered_name_ends,
                                accepted=0
                            )
                        1:
                            return Stage1ParameterRegistrationResult(
                                program=appended.program,
                                name_starts=registered_name_starts,
                                name_ends=registered_name_ends,
                                accepted=0
                            )
                0:
                    return Stage1ParameterRegistrationResult(
                        program=interned_type.program,
                        name_starts=registered_name_starts,
                        name_ends=registered_name_ends,
                        accepted=0
                    )
                1:
                    return Stage1ParameterRegistrationResult(
                        program=interned_type.program,
                        name_starts=registered_name_starts,
                        name_ends=registered_name_ends,
                        accepted=0
                    )
        0:
            return Stage1ParameterRegistrationResult(
                program=program,
                name_starts=registered_name_starts,
                name_ends=registered_name_ends,
                accepted=1
            )
        1:
            return Stage1ParameterRegistrationResult(
                program=program,
                name_starts=registered_name_starts,
                name_ends=registered_name_ends,
                accepted=1
            )

fn stage1_register_function_at(
    initial_state: Stage1FunctionScanState,
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64
) -> Stage1FunctionScanState:
    mut name_starts: vector<i64> = i64_vector_clone(&initial_state.name_starts)
    mut name_ends: vector<i64> = i64_vector_clone(&initial_state.name_ends)
    mut parameter_name_starts: vector<i64> = i64_vector_clone(&initial_state.parameter_name_starts)
    mut parameter_name_ends: vector<i64> = i64_vector_clone(&initial_state.parameter_name_ends)
    mut expression_cursors: vector<i64> = i64_vector_clone(&initial_state.expression_cursors)
    mut function_count: i64 = initial_state.function_count
    mut main_count: i64 = initial_state.main_count
    mut program: NativeIR = initial_state.program
    mut header: Stage1FunctionHeader = stage1_parse_function_header(source, tokens, cursor)
    mut header_accepted: i64 = header.accepted
    match header_accepted == 1:
        -1:
            match function_count < 16:
                -1:
                    mut duplicate_index: i64 = 0
                    while duplicate_index < function_count:
                        match stage1_source_spans_equal(
                            source,
                            header.name_start,
                            header.name_end,
                            vector_get<i64>(&name_starts, duplicate_index),
                            vector_get<i64>(&name_ends, duplicate_index)
                        ):
                            -1:
                                return stage1_function_scan_state(
                                    native_ir_empty(), name_starts, name_ends,
                                    parameter_name_starts, parameter_name_ends, expression_cursors,
                                    cursor, function_count, main_count, 0, 22
                                )
                            0:
                                discard 0
                            1:
                                discard 0
                        duplicate_index = duplicate_index + 1
                    match stage1_source_name_is_main(source, header.name_start, header.name_end) == 1:
                        -1:
                            main_count = main_count + 1
                        0:
                            discard 0
                        1:
                            discard 0
                    mut function_append: NativeIRAppendResult = native_ir_append_function_source(
                        program, function_count, 1, source, header.name_start, header.name_end
                    )
                    mut append_accepted: i64 = function_append.accepted
                    match append_accepted == 1:
                        -1:
                            mut typed_function: NativeIRAppendResult = stage1_apply_result_type(
                                function_append.program, function_count, header.result_type_code
                            )
                            mut registered_parameters: Stage1ParameterRegistrationResult = stage1_register_parameters(
                                typed_function.program,
                                function_count,
                                0,
                                &header.parameter_name_starts,
                                &header.parameter_name_ends,
                                &header.parameter_type_codes,
                                parameter_name_starts,
                                parameter_name_ends
                            )
                            mut parameters_accepted: i64 = registered_parameters.accepted
                            mut registered_parameter_name_starts: vector<i64> = i64_vector_clone(
                                &registered_parameters.name_starts
                            )
                            mut registered_parameter_name_ends: vector<i64> = i64_vector_clone(
                                &registered_parameters.name_ends
                            )
                            match parameters_accepted == 1:
                                -1:
                                    program = registered_parameters.program
                                    parameter_name_starts = registered_parameter_name_starts
                                    parameter_name_ends = registered_parameter_name_ends
                                0:
                                    return stage1_function_scan_state(
                                        native_ir_empty(), name_starts, name_ends,
                                        registered_parameter_name_starts,
                                        registered_parameter_name_ends, expression_cursors,
                                        cursor, function_count, main_count, 0, 23
                                    )
                                1:
                                    return stage1_function_scan_state(
                                        native_ir_empty(), name_starts, name_ends,
                                        registered_parameter_name_starts,
                                        registered_parameter_name_ends, expression_cursors,
                                        cursor, function_count, main_count, 0, 23
                                    )
                            discard vector_push<i64>(&mut name_starts, header.name_start)
                            discard vector_push<i64>(&mut name_ends, header.name_end)
                            discard vector_push<i64>(&mut expression_cursors, header.expression_cursor)
                            function_count = function_count + 1
                            return stage1_function_scan_state(
                                program, name_starts, name_ends,
                                parameter_name_starts, parameter_name_ends, expression_cursors,
                                header.next_cursor, function_count, main_count, 1, 0
                            )
                        0:
                            return stage1_function_scan_state(
                                native_ir_empty(), name_starts, name_ends,
                                parameter_name_starts, parameter_name_ends, expression_cursors,
                                cursor, function_count, main_count, 0, 23
                            )
                        1:
                            return stage1_function_scan_state(
                                native_ir_empty(), name_starts, name_ends,
                                parameter_name_starts, parameter_name_ends, expression_cursors,
                                cursor, function_count, main_count, 0, 23
                            )
                0:
                    return stage1_function_scan_state(
                        native_ir_empty(), name_starts, name_ends,
                        parameter_name_starts, parameter_name_ends, expression_cursors,
                        cursor, function_count, main_count, 0, 24
                    )
                1:
                    return stage1_function_scan_state(
                        native_ir_empty(), name_starts, name_ends,
                        parameter_name_starts, parameter_name_ends, expression_cursors,
                        cursor, function_count, main_count, 0, 24
                    )
        0:
            return stage1_function_scan_state(
                native_ir_empty(), name_starts, name_ends,
                parameter_name_starts, parameter_name_ends, expression_cursors,
                cursor, function_count, main_count, 0, 25
            )
        1:
            return stage1_function_scan_state(
                native_ir_empty(), name_starts, name_ends,
                parameter_name_starts, parameter_name_ends, expression_cursors,
                cursor, function_count, main_count, 0, 25
            )

fn stage1_scan_non_newline(
    initial_state: Stage1FunctionScanState,
    source: &vector<i64>,
    tokens: &vector<i64>,
    token_count: i64,
    cursor: i64
) -> Stage1FunctionScanState:
    mut name_starts: vector<i64> = i64_vector_clone(&initial_state.name_starts)
    mut name_ends: vector<i64> = i64_vector_clone(&initial_state.name_ends)
    mut parameter_name_starts: vector<i64> = i64_vector_clone(&initial_state.parameter_name_starts)
    mut parameter_name_ends: vector<i64> = i64_vector_clone(&initial_state.parameter_name_ends)
    mut expression_cursors: vector<i64> = i64_vector_clone(&initial_state.expression_cursors)
    mut function_count: i64 = initial_state.function_count
    mut main_count: i64 = initial_state.main_count
    mut program: NativeIR = initial_state.program
    match generic_token_kind(tokens, cursor) == 0:
        -1:
            return stage1_function_scan_state(
                program, name_starts, name_ends,
                parameter_name_starts, parameter_name_ends, expression_cursors,
                token_count, function_count, main_count, 1, 0
            )
        0:
            mut state: Stage1FunctionScanState = stage1_function_scan_state(
                program, name_starts, name_ends,
                parameter_name_starts, parameter_name_ends, expression_cursors,
                cursor, function_count, main_count, 1, 0
            )
            mut registered: Stage1FunctionScanState = stage1_register_function_at(
                state, source, tokens, cursor
            )
            mut registered_accepted: i64 = registered.accepted
            mut next_cursor: i64 = registered.cursor
            match registered_accepted == 1:
                -1:
                    return stage1_scan_functions(registered, source, tokens, token_count, next_cursor)
                0:
                    return registered
                1:
                    return registered
        1:
            mut state: Stage1FunctionScanState = stage1_function_scan_state(
                program, name_starts, name_ends,
                parameter_name_starts, parameter_name_ends, expression_cursors,
                cursor, function_count, main_count, 1, 0
            )
            mut registered: Stage1FunctionScanState = stage1_register_function_at(
                state, source, tokens, cursor
            )
            mut registered_accepted: i64 = registered.accepted
            mut next_cursor: i64 = registered.cursor
            match registered_accepted == 1:
                -1:
                    return stage1_scan_functions(registered, source, tokens, token_count, next_cursor)
                0:
                    return registered
                1:
                    return registered

fn stage1_scan_functions(
    initial_state: Stage1FunctionScanState,
    source: &vector<i64>,
    tokens: &vector<i64>,
    token_count: i64,
    start_cursor: i64
) -> Stage1FunctionScanState:
    mut name_starts: vector<i64> = i64_vector_clone(&initial_state.name_starts)
    mut name_ends: vector<i64> = i64_vector_clone(&initial_state.name_ends)
    mut parameter_name_starts: vector<i64> = i64_vector_clone(&initial_state.parameter_name_starts)
    mut parameter_name_ends: vector<i64> = i64_vector_clone(&initial_state.parameter_name_ends)
    mut expression_cursors: vector<i64> = i64_vector_clone(&initial_state.expression_cursors)
    mut function_count: i64 = initial_state.function_count
    mut main_count: i64 = initial_state.main_count
    mut cursor: i64 = start_cursor
    mut program: NativeIR = initial_state.program
    while cursor < token_count:
        match generic_token_kind(tokens, cursor) == 6:
            -1:
                cursor = cursor + 1
            0:
                mut state: Stage1FunctionScanState = stage1_function_scan_state(
                    program, name_starts, name_ends,
                    parameter_name_starts, parameter_name_ends, expression_cursors,
                    cursor, function_count, main_count, 1, 0
                )
                return stage1_scan_non_newline(state, source, tokens, token_count, cursor)
            1:
                mut state: Stage1FunctionScanState = stage1_function_scan_state(
                    program, name_starts, name_ends,
                    parameter_name_starts, parameter_name_ends, expression_cursors,
                    cursor, function_count, main_count, 1, 0
                )
                return stage1_scan_non_newline(state, source, tokens, token_count, cursor)
    return stage1_function_scan_state(
        program, name_starts, name_ends,
        parameter_name_starts, parameter_name_ends, expression_cursors,
        token_count, function_count, main_count, 1, 0
    )

export fn stage1_compile(source: vector<i64>) -> Stage1CompileResult:
    mut source_length: i64 = vector_len<i64>(&source)
    match source_length <= 4096:
        -1:
            discard 0
        0:
            return stage1_empty_result(1, 1)
        1:
            return stage1_empty_result(1, 1)
    mut tokens: vector<i64> = generic_lexer_scan(&source)
    mut token_count: i64 = generic_token_count(&tokens)
    match token_count <= 1024:
        -1:
            discard 0
        0:
            return stage1_empty_result(2, 2)
        1:
            return stage1_empty_result(2, 2)
    mut initial_scan_state: Stage1FunctionScanState = stage1_function_scan_state(
        native_ir_empty(),
        vector_new<i64>(16),
        vector_new<i64>(16),
        vector_new<i64>(64),
        vector_new<i64>(64),
        vector_new<i64>(16),
        0,
        0,
        0,
        1,
        0
    )
    mut registered: Stage1FunctionScanState = stage1_scan_functions(
        initial_scan_state, &source, &tokens, token_count, 0
    )
    mut scan_accepted: i64 = registered.accepted
    mut scan_error_code: i64 = registered.error_code
    mut function_count: i64 = registered.function_count
    mut main_count: i64 = registered.main_count
    mut function_expression_cursors: vector<i64> = i64_vector_clone(&registered.expression_cursors)
    mut function_parameter_name_starts: vector<i64> = i64_vector_clone(&registered.parameter_name_starts)
    mut function_parameter_name_ends: vector<i64> = i64_vector_clone(&registered.parameter_name_ends)
    match scan_accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, scan_error_code)
        1:
            return stage1_empty_result(3, scan_error_code)
    mut program: NativeIR = registered.program
    mut builtin_registration: NativeIRAppendResult = stage1_register_i64_vector_get(program)
    match builtin_registration.accepted == 1:
        -1:
            program = builtin_registration.program
        0:
            return stage1_empty_result(3, 29)
        1:
            return stage1_empty_result(3, 29)
    mut vector_len_registration: NativeIRAppendResult = stage1_register_i64_vector_len(
        program
    )
    match vector_len_registration.accepted == 1:
        -1:
            program = vector_len_registration.program
        0:
            return stage1_empty_result(3, 30)
        1:
            return stage1_empty_result(3, 30)
    match function_count > 0:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 27)
        1:
            return stage1_empty_result(3, 27)
    match main_count == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 28)
        1:
            return stage1_empty_result(3, 28)
    mut lowered_sequence: Stage1LowerResult = stage1_compile_function_sequence(
        program, &source, &tokens, &function_expression_cursors,
        &function_parameter_name_starts, &function_parameter_name_ends,
        0, function_count
    )
    mut sequence_accepted: i64 = lowered_sequence.accepted
    match sequence_accepted == 1:
        -1:
            program = lowered_sequence.program
        0:
            return stage1_empty_result(4, 29)
        1:
            return stage1_empty_result(4, 29)
    mut verified: NativeIRVerifiedResult = verify_program(program)
    mut verification: NativeVerification = verified.verification
    program = verified.program
    match verification.accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(5, verification.diagnostic_code)
        1:
            return stage1_empty_result(5, verification.diagnostic_code)
    mut instruction_count: i64 = i64_vector_len(&program.instruction_ids)
    mut value_count: i64 = i64_vector_len(&program.value_ids)
    mut output: vector<i64> = vector_new<i64>(16384)
    discard stage1_emit_native_program(program, &mut output)
    mut sink: OutputSinkState = output_sink_new(16384)
    sink = output_sink_append_bytes(sink, output)
    match sink.failed == 0:
        -1:
            discard 0
        0:
            return stage1_empty_result(6, 20)
        1:
            return stage1_empty_result(6, 20)
    sink = output_sink_commit(sink)
    match sink.failed == 0:
        -1:
            discard 0
        0:
            return stage1_empty_result(6, 21)
        1:
            return stage1_empty_result(6, 21)
    return stage1_result(1, 0, 0, sink.buffer, instruction_count, value_count, verification)
