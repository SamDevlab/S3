fn stage1_emit_literal(output: &mut vector<i64>, literal_id: i64) -> i64:
    mut bytes: vector<i64> = stage1_literal_bytes(literal_id)
    mut index: i64 = 0
    while index < vector_len<i64>(&bytes):
        discard vector_push<i64>(output, vector_get<i64>(&bytes, index))
        index = index + 1
    return 1

fn stage1_emit_ir_function_name(
    function_name_first: &vector<i64>,
    function_name_count: &vector<i64>,
    function_name_bytes: &vector<i64>,
    function_index: i64,
    output: &mut vector<i64>
) -> i64:
    mut first: i64 = i64_vector_get(function_name_first, function_index)
    mut count: i64 = i64_vector_get(function_name_count, function_index)
    mut index: i64 = 0
    while index < count:
        discard vector_push<i64>(output, i64_vector_get(function_name_bytes, first + index))
        index = index + 1
    return 1

fn stage1_emit_ir_register_declarations(
    value_ids: &vector<i64>,
    definition_function_ids: &vector<i64>,
    value_type_ids: &vector<i64>,
    parameter_value_ids: &vector<i64>,
    function_id: i64,
    output: &mut vector<i64>
) -> i64:
    mut value_index: i64 = 0
    while value_index < i64_vector_len(value_ids):
        match i64_vector_get(definition_function_ids, value_index) == function_id:
            -1:
                mut value_id: i64 = i64_vector_get(value_ids, value_index)
                mut parameter: i64 = 0
                mut is_parameter: i64 = 0
                while parameter < i64_vector_len(parameter_value_ids):
                    match i64_vector_get(parameter_value_ids, parameter) == value_id:
                        -1:
                            is_parameter = 1
                            parameter = i64_vector_len(parameter_value_ids)
                        0:
                            parameter = parameter + 1
                        1:
                            parameter = parameter + 1
                match is_parameter == 0:
                    -1:
                        discard stage1_emit_literal(output, 5)
                        discard stage1_emit_register(output, value_id)
                        match i64_vector_get(value_type_ids, value_index) == 1:
                            -1:
                                discard stage1_emit_literal(output, 17)
                            0:
                                discard stage1_emit_literal(output, 4)
                            1:
                                discard stage1_emit_literal(output, 4)
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        value_index = value_index + 1
    return 1

fn stage1_type_is_i64_vector_reference(
    type_id: i64,
    type_kinds: &vector<i64>,
    type_element_ids: &vector<i64>,
    type_mutability_flags: &vector<i64>,
    type_lengths: &vector<i64>
) -> i64:
    match type_id >= 0:
        -1:
            match type_id < i64_vector_len(type_kinds):
                -1:
                    match i64_vector_get(type_kinds, type_id) == 3:
                        -1:
                            mut vector_type_id: i64 = i64_vector_get(type_element_ids, type_id)
                            match vector_type_id >= 0:
                                -1:
                                    match vector_type_id < i64_vector_len(type_kinds):
                                        -1:
                                            match i64_vector_get(type_kinds, vector_type_id) == 2:
                                                -1:
                                                    match i64_vector_get(type_element_ids, vector_type_id) == 0:
                                                        -1:
                                                            match i64_vector_get(type_mutability_flags, type_id) == 0:
                                                                -1:
                                                                    match i64_vector_get(type_lengths, type_id) == -1:
                                                                        -1:
                                                                            return 1
                                                                        0:
                                                                            return 0
                                                                        1:
                                                                            return 0
                                                                0:
                                                                    return 0
                                                                1:
                                                                    return 0
                                                        0:
                                                            return 0
                                                        1:
                                                            return 0
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn stage1_emit_ir_parameter_type_suffix(
    type_id: i64,
    type_kinds: &vector<i64>,
    type_element_ids: &vector<i64>,
    type_mutability_flags: &vector<i64>,
    type_lengths: &vector<i64>,
    output: &mut vector<i64>
) -> i64:
    match type_id == 0:
        -1:
            discard stage1_emit_literal(output, 4)
            return 1
        0:
            match type_id == 1:
                -1:
                    discard stage1_emit_literal(output, 17)
                    return 1
                0:
                    match stage1_type_is_i64_vector_reference(
                        type_id, type_kinds, type_element_ids,
                        type_mutability_flags, type_lengths
                    ) == 1:
