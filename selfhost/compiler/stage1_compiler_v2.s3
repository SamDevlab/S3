                                target_offset = target_offset + 1
                            discard stage1_emit_cfg_literal(output, 5)
                            return 1
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            match opcode == 8:
                -1:
                    match operand_count == 0:
                        -1:
                            match target_count == 1:
                                -1:
                                    discard stage1_emit_cfg_literal(output, 3)
                                    match stage1_emit_cfg_target(
                                        output,
                                        i64_vector_get(target_block_ids, target_first),
                                        entry_block_id
