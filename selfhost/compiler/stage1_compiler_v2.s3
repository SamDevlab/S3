                                                                                                                                                    discard vector_push<i64>(&mut bytes, 32)
                                                                                                                                                    discard vector_push<i64>(&mut bytes, 116)
                                                                                                                                                    discard vector_push<i64>(&mut bytes, 114)
                                                                                                                                                    discard vector_push<i64>(&mut bytes, 105)
