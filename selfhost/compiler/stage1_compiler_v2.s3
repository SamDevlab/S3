            discard vector_push<i64>(output, 44)
            discard vector_push<i64>(output, 32)
            discard vector_push<i64>(output, 109)
            discard stage1_emit_decimal(output, memory_id)
            discard vector_push<i64>(output, 44)
            discard vector_push<i64>(output, 32)
            discard stage1_emit_register(
                output, i64_vector_get(operand_value_ids, operand_first)
            )
            discard vector_push<i64>(output, 10)
            return 1
        0:
            match opcode == 5:
                -1:
                    discard vector_push<i64>(output, 32)
                    discard vector_push<i64>(output, 32)
                    discard vector_push<i64>(output, 32)
                    discard vector_push<i64>(output, 32)
                    discard vector_push<i64>(output, 84)
                    discard vector_push<i64>(output, 83)
                    discard vector_push<i64>(output, 84)
                    discard vector_push<i64>(output, 79)
                    discard vector_push<i64>(output, 82)
                    discard vector_push<i64>(output, 69)
                    discard vector_push<i64>(output, 32)
                    discard vector_push<i64>(output, 109)
                    discard stage1_emit_decimal(output, memory_id)
                    discard vector_push<i64>(output, 44)
                    discard vector_push<i64>(output, 32)
                    discard stage1_emit_register(
