export record Stage1CompileResult:
    status: i64
    phase: i64
    error_code: i64
    output: vector<i64>
    output_length: i64
    ir_instruction_count: i64
    ir_value_count: i64
    verifier_accepted: i64
    verifier_digest: i64

record Stage1LowerResult:
    program: NativeIR
    value_id: i64
    accepted: i64

record Stage1ExpressionLowerResult:
    program: NativeIR
    value_id: i64
    next_cursor: i64
    accepted: i64

record Stage1FunctionHeader:
    next_cursor: i64
    name_start: i64
    name_end: i64
    expression_cursor: i64
    parameter_name_starts: vector<i64>
    parameter_name_ends: vector<i64>
    parameter_type_codes: vector<i64>
    result_type_code: i64
    accepted: i64

record Stage1ParameterParse:
    next_cursor: i64
    name_starts: vector<i64>
    name_ends: vector<i64>
    type_codes: vector<i64>
    accepted: i64

record Stage1ParameterTypeParse:
    next_cursor: i64
    type_code: i64
    accepted: i64

record Stage1InternedTypeResult:
    program: NativeIR
    type_id: i64
    accepted: i64

record Stage1CallArgumentResult:
    program: NativeIR
    arguments: vector<i64>
    accepted: i64

record Stage1ParameterRegistrationResult:
    program: NativeIR
    name_starts: vector<i64>
    name_ends: vector<i64>
    accepted: i64

record Stage1BodyCompileResult:
    program: NativeIR
    symbol_name_starts: vector<i64>
    symbol_name_ends: vector<i64>
    symbol_value_ids: vector<i64>
    return_value_id: i64
    accepted: i64

record Stage1FunctionScanState:
    program: NativeIR
    name_starts: vector<i64>
    name_ends: vector<i64>
    parameter_name_starts: vector<i64>
    parameter_name_ends: vector<i64>
    expression_cursors: vector<i64>
    cursor: i64
    function_count: i64
    main_count: i64
    accepted: i64
    error_code: i64

fn stage1_empty_ir() -> NativeIR:
    return native_ir_empty()

fn stage1_empty_result(phase: i64, error_code: i64) -> Stage1CompileResult:
    return Stage1CompileResult(
        status=0,
        phase=phase,
        error_code=error_code,
        output=vector_new<i64>(0),
        output_length=0,
        ir_instruction_count=0,
        ir_value_count=0,
        verifier_accepted=0,
        verifier_digest=0
    )

fn stage1_result(
    status: i64,
    phase: i64,
    error_code: i64,
    output: vector<i64>,
    instruction_count: i64,
    value_count: i64,
    verification: NativeVerification
) -> Stage1CompileResult:
    mut output_length: i64 = 0
    match status == 1:
        -1:
            output_length = vector_len<i64>(&output)
        0:
            output_length = 0
        1:
            output_length = 0
    return Stage1CompileResult(
        status=status,
        phase=phase,
        error_code=error_code,
        output=output,
        output_length=output_length,
        ir_instruction_count=instruction_count,
        ir_value_count=value_count,
        verifier_accepted=verification.accepted,
        verifier_digest=verification.digest_after
    )

fn stage1_lower_from_append(append: NativeIRAppendResult) -> Stage1LowerResult:
    return Stage1LowerResult(
        program=append.program,
        value_id=append.value_id,
        accepted=append.accepted
    )

fn stage1_lower_preserved_failure(program: NativeIR) -> Stage1LowerResult:
    return Stage1LowerResult(program=program, value_id=-1, accepted=0)

fn stage1_lower_call_argument_sequence(
    argument_link: i64,
    source: &vector<i64>,
    tree: &vector<i64>,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    arguments: vector<i64>,
    symbol_name_starts: &vector<i64>,
    symbol_name_ends: &vector<i64>,
    symbol_value_ids: &vector<i64>
) -> Stage1CallArgumentResult:
    match argument_link < 0:
        -1:
            return Stage1CallArgumentResult(
                program=program, arguments=arguments, accepted=1
            )
        0:
            match generic_expression_node_kind(tree, argument_link) == 5:
                -1:
                    mut argument_node: i64 = generic_expression_node_left(tree, argument_link)
                    mut argument_lowered: Stage1LowerResult = stage1_lower_expression(
                        argument_node,
                        source,
                        tree,
                        program,
                        function_id,
                        block_id,
                        symbol_name_starts,
                        symbol_name_ends,
                        symbol_value_ids
                    )
                    mut argument_accepted: i64 = argument_lowered.accepted
                    mut argument_value_id: i64 = argument_lowered.value_id
                    match argument_accepted == 1:
                        -1:
                            mut next_program: NativeIR = argument_lowered.program
                            discard vector_push<i64>(&mut arguments, argument_value_id)
                            return stage1_lower_call_argument_sequence(
                                generic_expression_node_right(tree, argument_link),
                                source,
                                tree,
                                next_program,
                                function_id,
                                block_id,
                                arguments,
                                symbol_name_starts,
                                symbol_name_ends,
                                symbol_value_ids
                            )
                        0:
                            return Stage1CallArgumentResult(
                                program=argument_lowered.program,
                                arguments=arguments,
                                accepted=0
                            )
                        1:
                            return Stage1CallArgumentResult(
                                program=argument_lowered.program,
                                arguments=arguments,
                                accepted=0
                            )
                0:
                    return Stage1CallArgumentResult(
                        program=program, arguments=arguments, accepted=0
                    )
                1:
                    return Stage1CallArgumentResult(
                        program=program, arguments=arguments, accepted=0
                    )
        1:
            return Stage1CallArgumentResult(
                program=program, arguments=arguments, accepted=0
            )

fn stage1_source_span_matches_bytes(
    source: &vector<i64>,
    start: i64,
    end: i64,
    expected: &vector<i64>
) -> i64:
    match end - start == vector_len<i64>(expected):
        -1:
            mut index: i64 = 0
            while index < vector_len<i64>(expected):
                match vector_get<i64>(source, start + index) == vector_get<i64>(expected, index):
                    -1:
                        discard 0
                    0:
                        return 0
                    1:
                        return 0
                index = index + 1
            return 1
        0:
            return 0
        1:
            return 0

fn stage1_source_name_is_vector_get(
    source: &vector<i64>,
    start: i64,
    end: i64
) -> i64:
    mut expected: vector<i64> = vector_new<i64>(10)
    discard vector_push<i64>(&mut expected, 118)
    discard vector_push<i64>(&mut expected, 101)
    discard vector_push<i64>(&mut expected, 99)
    discard vector_push<i64>(&mut expected, 116)
    discard vector_push<i64>(&mut expected, 111)
    discard vector_push<i64>(&mut expected, 114)
    discard vector_push<i64>(&mut expected, 95)
    discard vector_push<i64>(&mut expected, 103)
    discard vector_push<i64>(&mut expected, 101)
    discard vector_push<i64>(&mut expected, 116)
    return stage1_source_span_matches_bytes(source, start, end, &expected)

fn stage1_source_name_is_vector_len(
    source: &vector<i64>,
    start: i64,
    end: i64
) -> i64:
    mut expected: vector<i64> = vector_new<i64>(10)
    discard vector_push<i64>(&mut expected, 118)
    discard vector_push<i64>(&mut expected, 101)
    discard vector_push<i64>(&mut expected, 99)
    discard vector_push<i64>(&mut expected, 116)
    discard vector_push<i64>(&mut expected, 111)
    discard vector_push<i64>(&mut expected, 114)
    discard vector_push<i64>(&mut expected, 95)
    discard vector_push<i64>(&mut expected, 108)
    discard vector_push<i64>(&mut expected, 101)
    discard vector_push<i64>(&mut expected, 110)
    return stage1_source_span_matches_bytes(source, start, end, &expected)

fn stage1_generic_vector_builtin_id(
    source: &vector<i64>,
    start: i64,
    end: i64
) -> i64:
    match stage1_source_name_is_vector_get(source, start, end) == 1:
        -1:
            return 1000
        0:
            match stage1_source_name_is_vector_len(source, start, end) == 1:
                -1:
                    return 1001
                0:
                    return -1
                1:
                    return -1
        1:
            return 1000

fn stage1_lower_call_arguments_to_id(
    node: i64,
    source: &vector<i64>,
    tree: &vector<i64>,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    callee_id: i64,
    symbol_name_starts: &vector<i64>,
    symbol_name_ends: &vector<i64>,
    symbol_value_ids: &vector<i64>
) -> Stage1LowerResult:
    mut argument_result: Stage1CallArgumentResult = stage1_lower_call_argument_sequence(
        generic_expression_node_right(tree, node),
        source,
        tree,
        program,
        function_id,
        block_id,
        vector_new<i64>(64),
        symbol_name_starts,
        symbol_name_ends,
        symbol_value_ids
    )
    match argument_result.accepted == 1:
        -1:
            mut arguments: vector<i64> = i64_vector_clone(&argument_result.arguments)
            return stage1_lower_from_append(
                native_ir_append_call_arguments(
                    argument_result.program, function_id, block_id, callee_id, &arguments
                )
            )
        0:
            return stage1_lower_preserved_failure(argument_result.program)
        1:
            return stage1_lower_preserved_failure(argument_result.program)

fn stage1_lower_call_with_arguments(
    node: i64,
    source: &vector<i64>,
    tree: &vector<i64>,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: &vector<i64>,
    symbol_name_ends: &vector<i64>,
    symbol_value_ids: &vector<i64>
) -> Stage1LowerResult:
    mut callee_node: i64 = generic_expression_node_left(tree, node)
    mut call_type_code: i64 = generic_expression_node_value(tree, node)
    match generic_expression_node_kind(tree, callee_node) == 3:
        -1:
            mut callee_id: i64 = stage1_find_function_id_by_source_name(
                &program.function_ids,
                &program.function_name_first,
                &program.function_name_count,
                &program.function_name_bytes,
                source,
                generic_expression_node_start(tree, callee_node),
                generic_expression_node_end(tree, callee_node)
            )
            match callee_id >= 0:
                -1:
                    match call_type_code == 0:
                        -1:
                            return stage1_lower_call_arguments_to_id(
                                node, source, tree, program, function_id, block_id, callee_id,
                                symbol_name_starts, symbol_name_ends, symbol_value_ids
                            )
                        0:
                            return stage1_lower_preserved_failure(program)
                        1:
                            return stage1_lower_preserved_failure(program)
                0:
                    match call_type_code == 2:
                        -1:
                            mut builtin_id: i64 = stage1_generic_vector_builtin_id(
                                source,
                                generic_expression_node_start(tree, callee_node),
                                generic_expression_node_end(tree, callee_node)
                            )
                            match builtin_id >= 0:
                                -1:
                                    return stage1_lower_call_arguments_to_id(
                                        node, source, tree, program, function_id, block_id, builtin_id,
                                        symbol_name_starts, symbol_name_ends, symbol_value_ids
                                    )
                                0:
                                    return stage1_lower_preserved_failure(program)
                                1:
                                    return stage1_lower_preserved_failure(program)
                        0:
                            return stage1_lower_preserved_failure(program)
                        1:
                            return stage1_lower_preserved_failure(program)
                1:
                    return stage1_lower_preserved_failure(program)
        0:
            return stage1_lower_preserved_failure(program)
        1:
            return stage1_lower_preserved_failure(program)

fn stage1_find_symbol_value(
    source: &vector<i64>,
    name_starts: &vector<i64>,
    name_ends: &vector<i64>,
    value_ids: &vector<i64>,
    wanted_start: i64,
    wanted_end: i64
) -> i64:
    mut index: i64 = 0
    while index < vector_len<i64>(name_starts):
        match stage1_source_spans_equal(
            source,
            wanted_start,
            wanted_end,
            vector_get<i64>(name_starts, index),
            vector_get<i64>(name_ends, index)
        ):
            -1:
                return vector_get<i64>(value_ids, index)
            0:
                index = index + 1
            1:
                index = index + 1
    return -1

fn stage1_find_symbol_index(
    source: &vector<i64>,
    name_starts: &vector<i64>,
    name_ends: &vector<i64>,
    wanted_start: i64,
    wanted_end: i64
) -> i64:
    mut index: i64 = 0
    while index < vector_len<i64>(name_starts):
        match stage1_source_spans_equal(
            source,
            wanted_start,
            wanted_end,
            vector_get<i64>(name_starts, index),
            vector_get<i64>(name_ends, index)
        ):
            -1:
                return index
            0:
                index = index + 1
            1:
                index = index + 1
    return -1

fn stage1_lower_expression(
    node: i64,
    source: &vector<i64>,
    tree: &vector<i64>,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: &vector<i64>,
    symbol_name_ends: &vector<i64>,
    symbol_value_ids: &vector<i64>
) -> Stage1LowerResult:
    mut node_count: i64 = generic_expression_node_count(tree)
    match node >= 0:
        -1:
            match node < node_count:
                -1:
                    mut kind: i64 = generic_expression_node_kind(tree, node)
                    match kind == 1:
                        -1:
                            mut value: i64 = generic_expression_node_value(tree, node)
                            return stage1_lower_from_append(
                                native_ir_append_instruction_for_function(
                                    program, function_id, block_id, 0, value, -1, -1, -1
                                )
                            )
                        0:
                            match kind == 2:
                                -1:
                                    mut left_node: i64 = generic_expression_node_left(tree, node)
                                    mut right_node: i64 = generic_expression_node_right(tree, node)
                                    mut left_lowered: Stage1LowerResult = stage1_lower_expression(
                                        left_node, source, tree, program, function_id, block_id,
                                        symbol_name_starts, symbol_name_ends, symbol_value_ids
                                    )
                                    mut left_value: i64 = left_lowered.value_id
                                    mut left_accepted: i64 = left_lowered.accepted
                                    mut right_lowered: Stage1LowerResult = stage1_lower_expression(
                                        right_node, source, tree, left_lowered.program, function_id, block_id,
                                        symbol_name_starts, symbol_name_ends, symbol_value_ids
                                    )
                                    mut right_value: i64 = right_lowered.value_id
                                    mut operator: i64 = generic_expression_node_operator(tree, node)
                                    mut opcode: i64 = -1
                                    match left_accepted == 1:
                                        -1:
                                            match right_lowered.accepted == 1:
                                                -1:
                                                    match operator == 1:
                                                        -1:
                                                            opcode = 9
                                                        0:
                                                            match operator == 3:
                                                                -1:
                                                                    opcode = 10
                                                                0:
                                                                    match operator == 10:
                                                                        -1:
                                                                            opcode = 11
                                                                        0:
                                                                            match operator == 13:
                                                                                -1:
                                                                                    opcode = 11
                                                                                0:
                                                                                    discard 0
                                                                                1:
                                                                                    discard 0
                                                                        1:
                                                                            discard 0
                                                                1:
                                                                    discard 0
                                                        1:
                                                            discard 0
                                                0:
                                                    discard 0
                                                1:
                                                    discard 0
                                        0:
                                            discard 0
                                        1:
                                            discard 0
                                    match opcode == 11:
                                        -1:
                                            mut relation_code: i64 = 0
                                            match operator == 10:
                                                -1:
                                                    relation_code = 2
                                                0:
                                                    relation_code = 0
                                                1:
                                                    relation_code = 0
                                            mut left_type_id: i64 = native_ir_value_type_id(
                                                &right_lowered.program.value_ids,
                                                &right_lowered.program.value_type_ids,
                                                left_value
                                            )
                                            mut right_type_id: i64 = native_ir_value_type_id(
                                                &right_lowered.program.value_ids,
                                                &right_lowered.program.value_type_ids,
                                                right_value
                                            )
                                            match left_type_id == right_type_id:
                                                -1:
                                                    match left_type_id < 2:
                                                        -1:
                                                            return stage1_lower_from_append(
                                                                native_ir_append_typed_instruction_for_function(
                                                                    right_lowered.program,
                                                                    function_id,
                                                                    block_id,
                                                                    opcode,
                                                                    relation_code,
                                                                    left_value,
                                                                    right_value,
                                                                    1
                                                                )
                                                            )
                                                        0:
                                                            return stage1_lower_preserved_failure(
                                                                right_lowered.program
                                                            )
                                                        1:
                                                            return stage1_lower_preserved_failure(
                                                                right_lowered.program
                                                            )
                                                0:
                                                    return stage1_lower_preserved_failure(
                                                        right_lowered.program
                                                    )
                                                1:
                                                    return stage1_lower_preserved_failure(
                                                        right_lowered.program
                                                    )
                                        0:
                                            return stage1_lower_from_append(
                                                native_ir_append_instruction_for_function(
                                                    right_lowered.program,
                                                    function_id,
                                                    block_id,
                                                    opcode,
                                                    0,
                                                    left_value,
                                                    right_value,
                                                    -1
                                                )
                                            )
                                        1:
                                            return stage1_lower_from_append(
                                                native_ir_append_instruction_for_function(
                                                    right_lowered.program,
                                                    function_id,
                                                    block_id,
                                                    opcode,
                                                    0,
                                                    left_value,
                                                    right_value,
                                                    -1
                                                )
                                            )
                                0:
                                    match kind == 3:
                                        -1:
                                            mut value_id: i64 = stage1_find_symbol_value(
                                                source,
                                                symbol_name_starts,
                                                symbol_name_ends,
                                                symbol_value_ids,
                                                generic_expression_node_start(tree, node),
                                                generic_expression_node_end(tree, node)
                                            )
                                            match value_id >= 0:
                                                -1:
                                                    return Stage1LowerResult(
                                                        program=program, value_id=value_id, accepted=1
                                                    )
                                                0:
                                                    return stage1_lower_preserved_failure(program)
                                                1:
                                                    return stage1_lower_preserved_failure(program)
                                        0:
                                            match kind == 4:
                                                -1:
                                                    return stage1_lower_call_with_arguments(
                                                        node, source, tree, program, function_id, block_id,
                                                        symbol_name_starts, symbol_name_ends, symbol_value_ids
                                                    )
                                                0:
                                                    return stage1_lower_preserved_failure(program)
                                                1:
                                                    return stage1_lower_preserved_failure(program)
                                        1:
                                            match kind == 4:
                                                -1:
                                                    return stage1_lower_call_with_arguments(
                                                        node, source, tree, program, function_id, block_id,
                                                        symbol_name_starts, symbol_name_ends, symbol_value_ids
                                                    )
                                                0:
                                                    return stage1_lower_preserved_failure(program)
                                                1:
                                                    return stage1_lower_preserved_failure(program)
                                1:
                                    return stage1_lower_preserved_failure(program)
                        1:
                            return stage1_lower_preserved_failure(program)
                0:
                    return stage1_lower_preserved_failure(program)
                1:
                    return stage1_lower_preserved_failure(program)
        0:
            return stage1_lower_preserved_failure(program)
        1:
            return stage1_lower_preserved_failure(program)

fn stage1_emit_decimal(output: &mut vector<i64>, value: i64) -> i64:
    mut places: vector<i64> = vector_new<i64>(20)
    discard vector_push<i64>(&mut places, 1000000000000000000)
    discard vector_push<i64>(&mut places, 100000000000000000)
    discard vector_push<i64>(&mut places, 10000000000000000)
    discard vector_push<i64>(&mut places, 1000000000000000)
    discard vector_push<i64>(&mut places, 100000000000000)
    discard vector_push<i64>(&mut places, 10000000000000)
    discard vector_push<i64>(&mut places, 1000000000000)
    discard vector_push<i64>(&mut places, 100000000000)
    discard vector_push<i64>(&mut places, 10000000000)
    discard vector_push<i64>(&mut places, 1000000000)
    discard vector_push<i64>(&mut places, 100000000)
    discard vector_push<i64>(&mut places, 10000000)
    discard vector_push<i64>(&mut places, 1000000)
    discard vector_push<i64>(&mut places, 100000)
    discard vector_push<i64>(&mut places, 10000)
    discard vector_push<i64>(&mut places, 1000)
    discard vector_push<i64>(&mut places, 100)
    discard vector_push<i64>(&mut places, 10)
    discard vector_push<i64>(&mut places, 1)
    mut digits: vector<i64> = vector_new<i64>(19)
    mut remaining: i64 = value
    mut index: i64 = 0
    while index < vector_len<i64>(&places):
        mut place: i64 = vector_get<i64>(&places, index)
        mut digit: i64 = 0
        while remaining >= place:
            remaining = remaining - place
            digit = digit + 1
        discard vector_push<i64>(&mut digits, digit)
        index = index + 1
    mut first_digit: i64 = 18
    mut found_nonzero: i64 = 0
    index = 0
    while index < 19:
        mut digit: i64 = vector_get<i64>(&digits, index)
        match digit > 0:
            -1:
                match found_nonzero == 0:
                    -1:
                        first_digit = index
                        found_nonzero = 1
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        index = index + 1
    index = first_digit
    while index < 19:
        discard vector_push<i64>(output, vector_get<i64>(&digits, index) + 48)
        index = index + 1
    return 1

fn stage1_emit_register(output: &mut vector<i64>, register_id: i64) -> i64:
    discard vector_push<i64>(output, 114)
    discard stage1_emit_decimal(output, register_id)
    return 1

