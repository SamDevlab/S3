export record Stage1CompileResult:
    status: i64
    phase: i64
    error_code: i64
    output: vector<i64>
    output_length: i64
    ir_instruction_count: i64
    ir_value_count: i64
    verifier_accepted: i64
    verifier_digest: i64

record Stage1LowerResult:
    program: NativeIR
    value_id: i64
    accepted: i64

record Stage1ExpressionLowerResult:
    program: NativeIR
    value_id: i64
    next_cursor: i64
    accepted: i64

record Stage1FunctionHeader:
    next_cursor: i64
    name_start: i64
    name_end: i64
    expression_cursor: i64
    parameter_name_starts: vector<i64>
    parameter_name_ends: vector<i64>
    parameter_type_codes: vector<i64>
    result_type_code: i64
    accepted: i64

record Stage1ParameterParse:
    next_cursor: i64
    name_starts: vector<i64>
    name_ends: vector<i64>
    type_codes: vector<i64>
    accepted: i64

record Stage1ParameterTypeParse:
    next_cursor: i64
    type_code: i64
    accepted: i64

record Stage1InternedTypeResult:
    program: NativeIR
    type_id: i64
    accepted: i64

record Stage1CallArgumentResult:
    program: NativeIR
    arguments: vector<i64>
    accepted: i64

record Stage1ParameterRegistrationResult:
    program: NativeIR
    name_starts: vector<i64>
    name_ends: vector<i64>
    accepted: i64

record Stage1BodyCompileResult:
    program: NativeIR
    symbol_name_starts: vector<i64>
    symbol_name_ends: vector<i64>
    symbol_value_ids: vector<i64>
    symbol_memory_ids: vector<i64>
    block_id: i64
    return_value_id: i64
    accepted: i64

record Stage1MatchArmResult:
    program: NativeIR
    return_value_id: i64
    accepted: i64

record Stage1LoopBlockSet:
    program: NativeIR
    condition_block_id: i64
    body_block_id: i64
    neutral_block_id: i64
    positive_block_id: i64
    exit_block_id: i64
    accepted: i64

record Stage1WhileHeader:
    tree: vector<i64>
    condition_node: i64
    body_start_cursor: i64
    body_end_cursor: i64
    accepted: i64

record Stage1MatchArmHeader:
    body_start_cursor: i64
    body_end_cursor: i64
    arm_value: i64
    accepted: i64

record Stage1MatchHeader:
    tree: vector<i64>
    condition_node: i64
    next_cursor: i64
    negative_body_start: i64
    negative_body_end: i64
    neutral_body_start: i64
    neutral_body_end: i64
    positive_body_start: i64
    positive_body_end: i64
    accepted: i64

record Stage1MatchBlockSet:
    program: NativeIR
    negative_block_id: i64
    neutral_block_id: i64
    positive_block_id: i64
    continuation_block_id: i64
    accepted: i64

record Stage1FunctionScanState:
    program: NativeIR
    name_starts: vector<i64>
    name_ends: vector<i64>
    parameter_name_starts: vector<i64>
    parameter_name_ends: vector<i64>
    expression_cursors: vector<i64>
    cursor: i64
    function_count: i64
    main_count: i64
    accepted: i64
    error_code: i64

fn stage1_empty_ir() -> NativeIR:
    return native_ir_empty()

fn stage1_empty_result(phase: i64, error_code: i64) -> Stage1CompileResult:
    return Stage1CompileResult(
        status=0,
        phase=phase,
        error_code=error_code,
        output=vector_new<i64>(0),
        output_length=0,
        ir_instruction_count=0,
        ir_value_count=0,
        verifier_accepted=0,
        verifier_digest=0
    )

fn stage1_result(
    status: i64,
    phase: i64,
    error_code: i64,
    output: vector<i64>,
    instruction_count: i64,
    value_count: i64,
    verification: NativeVerification
) -> Stage1CompileResult:
    mut output_length: i64 = 0
    match status == 1:
        -1:
            output_length = vector_len<i64>(&output)
        0:
            output_length = 0
        1:
            output_length = 0
    return Stage1CompileResult(
        status=status,
        phase=phase,
        error_code=error_code,
        output=output,
        output_length=output_length,
        ir_instruction_count=instruction_count,
        ir_value_count=value_count,
        verifier_accepted=verification.accepted,
        verifier_digest=verification.digest_after
    )

fn stage1_lower_from_append(append: NativeIRAppendResult) -> Stage1LowerResult:
    return Stage1LowerResult(
        program=append.program,
        value_id=append.value_id,
        accepted=append.accepted
    )

fn stage1_lower_preserved_failure(program: NativeIR) -> Stage1LowerResult:
    return Stage1LowerResult(program=program, value_id=-1, accepted=0)

fn stage1_acceptance_and(left: i64, right: i64) -> i64:
    match left == 1:
        -1:
            match right == 1:
                -1:
                    return 1
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn stage1_lower_memory_index(
    program: NativeIR, function_id: i64, block_id: i64
) -> Stage1LowerResult:
    return stage1_lower_from_append(
        native_ir_append_typed_instruction_for_function(
            program, function_id, block_id, 0, 0, -1, -1, 0
        )
    )

fn stage1_lower_memory_load(
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    memory_id: i64
) -> Stage1LowerResult:
    mut index: Stage1LowerResult = stage1_lower_memory_index(
        program, function_id, block_id
    )
    match index.accepted == 1:
        -1:
            mut index_value_id: i64 = index.value_id
            mut index_program: NativeIR = index.program
            return stage1_lower_from_append(
                native_ir_append_load_for_function(
                    index_program, function_id, block_id, memory_id, index_value_id
                )
            )
        0:
            return stage1_lower_preserved_failure(index.program)
        1:
            return stage1_lower_preserved_failure(index.program)

fn stage1_lower_memory_store(
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    memory_id: i64,
    value_id: i64
) -> Stage1LowerResult:
    mut index: Stage1LowerResult = stage1_lower_memory_index(
        program, function_id, block_id
    )
    match index.accepted == 1:
        -1:
            mut index_value_id: i64 = index.value_id
            mut index_program: NativeIR = index.program
            return stage1_lower_from_append(
                native_ir_append_store_for_function(
                    index_program, function_id, block_id, memory_id,
                    index_value_id, value_id
                )
            )
        0:
            return stage1_lower_preserved_failure(index.program)
        1:
            return stage1_lower_preserved_failure(index.program)

fn stage1_lower_store_if_mutable(
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    memory_id: i64,
    value_id: i64
) -> Stage1LowerResult:
    match memory_id >= 0:
        -1:
            return stage1_lower_memory_store(
                program, function_id, block_id, memory_id, value_id
            )
        0:
            return Stage1LowerResult(
                program=program, value_id=-1, accepted=1
            )
        1:
            return Stage1LowerResult(
                program=program, value_id=-1, accepted=1
            )

fn stage1_lower_declaration_storage(
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    declaration_mutable: i64,
    initial_value_id: i64
) -> Stage1LowerResult:
    match declaration_mutable == 1:
        -1:
            mut initial_type_id: i64 = native_ir_value_type_id(
                &program.value_ids, &program.value_type_ids, initial_value_id
            )
            match initial_type_id >= 0:
                -1:
                    match i64_vector_get(&program.type_kinds, initial_type_id) == 2:
                        -1:
                            match i64_vector_get(
                                &program.type_element_ids, initial_type_id
                            ) == 0:
                                -1:
                                    return Stage1LowerResult(
                                        program=program, value_id=-1, accepted=1
                                    )
                                0:
                                    return stage1_lower_preserved_failure(program)
                                1:
                                    return stage1_lower_preserved_failure(program)
                        0:
                            return stage1_lower_new_mutable_slot(
                                program, function_id, block_id, initial_value_id
                            )
                        1:
                            return stage1_lower_new_mutable_slot(
                                program, function_id, block_id, initial_value_id
                            )
                0:
                    return stage1_lower_preserved_failure(program)
                1:
                    return stage1_lower_preserved_failure(program)
        0:
            return Stage1LowerResult(
                program=program, value_id=-1, accepted=1
            )
        1:
            return Stage1LowerResult(
                program=program, value_id=-1, accepted=1
            )

fn stage1_lower_new_mutable_slot(
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    initial_value_id: i64
) -> Stage1LowerResult:
    mut memory_id: i64 = i64_vector_len(&program.memory_ids)
    mut memory: NativeIRAppendResult = native_ir_append_memory(
        program, memory_id, 0, 1
    )
    match memory.accepted == 1:
        -1:
            mut stored: Stage1LowerResult = stage1_lower_memory_store(
                memory.program, function_id, block_id, memory_id, initial_value_id
            )
            match stored.accepted == 1:
                -1:
                    return Stage1LowerResult(
                        program=stored.program, value_id=memory_id, accepted=1
                    )
                0:
                    return stage1_lower_preserved_failure(stored.program)
                1:
                    return stage1_lower_preserved_failure(stored.program)
        0:
            return stage1_lower_preserved_failure(memory.program)
        1:
            return stage1_lower_preserved_failure(memory.program)

fn stage1_lower_new_block(
    program: NativeIR, function_id: i64, terminator_kind: i64
) -> Stage1LowerResult:
    mut block_id: i64 = 1000 + i64_vector_len(&program.block_ids)
    mut appended: NativeIRAppendResult = native_ir_append_block_for_function(
        program, function_id, block_id, terminator_kind
    )
    mut accepted: i64 = appended.accepted
    mut appended_program: NativeIR = appended.program
    return Stage1LowerResult(
        program=appended_program,
        value_id=block_id,
        accepted=accepted
    )

fn stage1_loop_block_set_failure(program: NativeIR) -> Stage1LoopBlockSet:
    return Stage1LoopBlockSet(
        program=program,
        condition_block_id=-1,
        body_block_id=-1,
        neutral_block_id=-1,
        positive_block_id=-1,
        exit_block_id=-1,
        accepted=0
    )

fn stage1_append_loop_blocks(
    program: NativeIR, function_id: i64
) -> Stage1LoopBlockSet:
    mut condition: Stage1LowerResult = stage1_lower_new_block(
        program, function_id, 2
    )
    match condition.accepted == 1:
        -1:
            mut condition_block_id: i64 = condition.value_id
            mut body: Stage1LowerResult = stage1_lower_new_block(
                condition.program, function_id, 3
            )
            match body.accepted == 1:
                -1:
                    mut body_block_id: i64 = body.value_id
                    mut neutral: Stage1LowerResult = stage1_lower_new_block(
                        body.program, function_id, 3
                    )
                    match neutral.accepted == 1:
                        -1:
                            mut neutral_block_id: i64 = neutral.value_id
                            mut positive: Stage1LowerResult = stage1_lower_new_block(
                                neutral.program, function_id, 3
                            )
                            match positive.accepted == 1:
                                -1:
                                    mut positive_block_id: i64 = positive.value_id
                                    mut exit_block: Stage1LowerResult = stage1_lower_new_block(
                                        positive.program, function_id, 1
                                    )
                                    match exit_block.accepted == 1:
                                        -1:
                                            mut exit_block_id: i64 = exit_block.value_id
                                            mut exit_program: NativeIR = exit_block.program
                                            return Stage1LoopBlockSet(
                                                program=exit_program,
                                                condition_block_id=condition_block_id,
                                                body_block_id=body_block_id,
                                                neutral_block_id=neutral_block_id,
                                                positive_block_id=positive_block_id,
                                                exit_block_id=exit_block_id,
                                                accepted=1
                                            )
                                        0:
                                            return stage1_loop_block_set_failure(exit_block.program)
                                        1:
                                            return stage1_loop_block_set_failure(exit_block.program)
                                0:
                                    return stage1_loop_block_set_failure(positive.program)
                                1:
                                    return stage1_loop_block_set_failure(positive.program)
                        0:
                            return stage1_loop_block_set_failure(neutral.program)
                        1:
                            return stage1_loop_block_set_failure(neutral.program)
                0:
                    return stage1_loop_block_set_failure(body.program)
                1:
                    return stage1_loop_block_set_failure(body.program)
        0:
            return stage1_loop_block_set_failure(condition.program)
        1:
            return stage1_loop_block_set_failure(condition.program)

fn stage1_lower_call_argument_sequence(
    argument_link: i64,
    source: &vector<i64>,
    tree: &vector<i64>,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    arguments: vector<i64>,
    symbol_name_starts: &vector<i64>,
    symbol_name_ends: &vector<i64>,
    symbol_value_ids: &vector<i64>,
    symbol_memory_ids: &vector<i64>,
    symbol_mutability_flags: &vector<i64>
) -> Stage1CallArgumentResult:
    match argument_link < 0:
        -1:
            return Stage1CallArgumentResult(
                program=program, arguments=arguments, accepted=1
            )
        0:
            match generic_expression_node_kind(tree, argument_link) == 5:
                -1:
                    mut argument_node: i64 = generic_expression_node_left(tree, argument_link)
                    mut argument_lowered: Stage1LowerResult = stage1_lower_expression(
                        argument_node,
                        source,
                        tree,
                        program,
                        function_id,
                        block_id,
                        symbol_name_starts,
                        symbol_name_ends,
                        symbol_value_ids,
                        symbol_memory_ids,
                        symbol_mutability_flags
                    )
                    mut argument_accepted: i64 = argument_lowered.accepted
                    mut argument_value_id: i64 = argument_lowered.value_id
                    match argument_accepted == 1:
                        -1:
                            mut next_program: NativeIR = argument_lowered.program
                            discard vector_push<i64>(&mut arguments, argument_value_id)
                            return stage1_lower_call_argument_sequence(
                                generic_expression_node_right(tree, argument_link),
                                source,
                                tree,
                                next_program,
                                function_id,
                                block_id,
                                arguments,
                                symbol_name_starts,
                                symbol_name_ends,
                                symbol_value_ids,
                                symbol_memory_ids,
                                symbol_mutability_flags
                            )
                        0:
                            return Stage1CallArgumentResult(
                                program=argument_lowered.program,
                                arguments=arguments,
                                accepted=0
                            )
                        1:
                            return Stage1CallArgumentResult(
                                program=argument_lowered.program,
                                arguments=arguments,
                                accepted=0
                            )
                0:
                    return Stage1CallArgumentResult(
                        program=program, arguments=arguments, accepted=0
                    )
                1:
                    return Stage1CallArgumentResult(
                        program=program, arguments=arguments, accepted=0
                    )
        1:
            return Stage1CallArgumentResult(
                program=program, arguments=arguments, accepted=0
            )

fn stage1_source_span_matches_bytes(
    source: &vector<i64>,
    start: i64,
    end: i64,
    expected: &vector<i64>
) -> i64:
    match end - start == vector_len<i64>(expected):
        -1:
            mut index: i64 = 0
            while index < vector_len<i64>(expected):
                match vector_get<i64>(source, start + index) == vector_get<i64>(expected, index):
                    -1:
                        discard 0
                    0:
                        return 0
                    1:
                        return 0
                index = index + 1
            return 1
        0:
            return 0
        1:
            return 0

fn stage1_source_name_is_vector_get(
    source: &vector<i64>,
    start: i64,
    end: i64
) -> i64:
    mut expected: vector<i64> = vector_new<i64>(10)
    discard vector_push<i64>(&mut expected, 118)
    discard vector_push<i64>(&mut expected, 101)
    discard vector_push<i64>(&mut expected, 99)
    discard vector_push<i64>(&mut expected, 116)
    discard vector_push<i64>(&mut expected, 111)
    discard vector_push<i64>(&mut expected, 114)
    discard vector_push<i64>(&mut expected, 95)
    discard vector_push<i64>(&mut expected, 103)
    discard vector_push<i64>(&mut expected, 101)
    discard vector_push<i64>(&mut expected, 116)
    return stage1_source_span_matches_bytes(source, start, end, &expected)

