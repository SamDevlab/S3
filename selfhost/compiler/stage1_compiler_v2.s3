fn stage1_emit_ir_function_result_types(
    function_result_widths: &vector<i64>,
    function_result_type_first: &vector<i64>,
    function_result_type_ids: &vector<i64>,
    type_kinds: &vector<i64>,
    type_element_ids: &vector<i64>,
    type_mutability_flags: &vector<i64>,
    type_lengths: &vector<i64>,
    function_index: i64,
    output: &mut vector<i64>
) -> i64:
    mut result_width: i64 = i64_vector_get(function_result_widths, function_index)
    mut result_first: i64 = i64_vector_get(function_result_type_first, function_index)
    match result_width >= 1:
        -1:
            match result_first >= 0:
                -1:
                    match result_first <= i64_vector_len(function_result_type_ids):
                        -1:
                            match result_width <= i64_vector_len(function_result_type_ids) - result_first:
                                -1:
                                    discard vector_push<i64>(output, 32)
                                    discard vector_push<i64>(output, 45)
                                    discard vector_push<i64>(output, 62)
                                    discard vector_push<i64>(output, 32)
                                    match result_width == 1:
                                        -1:
                                            discard 0
                                        0:
                                            discard vector_push<i64>(output, 91)
                                        1:
                                            discard vector_push<i64>(output, 91)
                                    mut result_index: i64 = 0
                                    while result_index < result_width:
                                        match result_index == 0:
                                            -1:
                                                discard 0
                                            0:
                                                discard stage1_emit_literal(output, 8)
                                            1:
                                                discard stage1_emit_literal(output, 8)
                                        match stage1_emit_ir_function_result_type_name(
                                            i64_vector_get(function_result_type_ids, result_first + result_index),
                                            type_kinds, type_element_ids,
                                            type_mutability_flags, type_lengths, output
                                        ) == 1:
                                            -1:
                                                discard 0
                                            0:
                                                return 0
                                            1:
                                                return 0
                                        result_index = result_index + 1
                                    match result_width == 1:
                                        -1:
                                            discard 0
                                        0:
                                            discard vector_push<i64>(output, 93)
                                        1:
                                            discard vector_push<i64>(output, 93)
                                    discard vector_push<i64>(output, 10)
                                    return 1
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn stage1_emit_native_function(
    function_ids: &vector<i64>,
    function_name_first: &vector<i64>,
    function_name_count: &vector<i64>,
    function_name_bytes: &vector<i64>,
    function_result_widths: &vector<i64>,
    function_result_type_first: &vector<i64>,
    function_result_type_ids: &vector<i64>,
    function_parameter_first: &vector<i64>,
    function_parameter_count: &vector<i64>,
    function_block_first: &vector<i64>,
    function_block_count: &vector<i64>,
    parameter_value_ids: &vector<i64>,
    parameter_type_ids: &vector<i64>,
    type_kinds: &vector<i64>,
    type_element_ids: &vector<i64>,
    type_mutability_flags: &vector<i64>,
    type_lengths: &vector<i64>,
    memory_ids: &vector<i64>,
    memory_types: &vector<i64>,
    memory_lengths: &vector<i64>,
    value_ids: &vector<i64>,
    definition_function_ids: &vector<i64>,
    value_type_ids: &vector<i64>,
    instruction_ids: &vector<i64>,
    instruction_function_ids: &vector<i64>,
    instruction_block_ids: &vector<i64>,
    instruction_opcodes: &vector<i64>,
    instruction_operand_first: &vector<i64>,
    instruction_operand_count: &vector<i64>,
    instruction_result_first: &vector<i64>,
    instruction_result_count: &vector<i64>,
    instruction_immediates: &vector<i64>,
    instruction_callee_function_ids: &vector<i64>,
    instruction_memory_ids: &vector<i64>,
    instruction_reference_target_types: &vector<i64>,
    instruction_reference_flags: &vector<i64>,
    instruction_target_first: &vector<i64>,
    instruction_target_count: &vector<i64>,
    result_value_ids: &vector<i64>,
    operand_value_ids: &vector<i64>,
    block_ids: &vector<i64>,
    block_function_ids: &vector<i64>,
    block_instruction_first: &vector<i64>,
    block_instruction_count: &vector<i64>,
    target_block_ids: &vector<i64>,
    function_index: i64,
    output: &mut vector<i64>
) -> i64:
    mut function_id: i64 = i64_vector_get(function_ids, function_index)
    discard stage1_emit_literal(output, 1)
    discard stage1_emit_ir_function_name(
        function_name_first,
        function_name_count,
        function_name_bytes,
        function_index,
        output
    )
    match stage1_emit_ir_function_result_types(
        function_result_widths, function_result_type_first,
        function_result_type_ids, type_kinds, type_element_ids,
        type_mutability_flags, type_lengths, function_index, output
    ) == 1:
        -1:
            discard 0
        0:
            return 0
        1:
            return 0
    match stage1_emit_ir_parameters(
        function_parameter_first,
        function_parameter_count,
        parameter_value_ids,
        parameter_type_ids,
        type_kinds,
        type_element_ids,
        type_mutability_flags,
        type_lengths,
        function_index,
        output
    ) == 1:
        -1:
            discard 0
        0:
            return 0
        1:
            return 0
    match stage1_emit_ir_register_declarations(
        value_ids,
        definition_function_ids,
        value_type_ids,
        type_kinds,
        type_element_ids,
        type_mutability_flags,
        type_lengths,
        parameter_value_ids,
        function_id,
        output
    ) == 1:
        -1:
            discard 0
        0:
            return 0
        1:
            return 0
    match stage1_emit_ir_memory_declarations(
        memory_ids,
        memory_types,
        memory_lengths,
        instruction_ids,
        instruction_function_ids,
        instruction_memory_ids,
        function_id,
        output
    ) == 1:
        -1:
            discard 0
        0:
            return 0
        1:
            return 0
    mut block_first: i64 = i64_vector_get(function_block_first, function_index)
    mut block_count: i64 = i64_vector_get(function_block_count, function_index)
    match block_count > 0:
        -1:
            discard 0
        0:
            return 0
        1:
            return 0
    mut entry_block_id: i64 = i64_vector_get(block_ids, block_first)
    mut block_offset: i64 = 0
    while block_offset < block_count:
        mut block_index: i64 = block_first + block_offset
        mut block_id: i64 = i64_vector_get(block_ids, block_index)
        match i64_vector_get(block_function_ids, block_index) == function_id:
            -1:
                discard 0
            0:
                return 0
            1:
                return 0
        mut is_entry: i64 = 0
        match block_offset == 0:
            -1:
                is_entry = 1
            0:
                discard 0
            1:
                discard 0
        match stage1_emit_cfg_block_label(output, block_id, is_entry) == 1:
            -1:
                discard 0
            0:
                return 0
            1:
                return 0
        mut instruction_index: i64 = i64_vector_get(
            block_instruction_first, block_index
        )
        mut instruction_end: i64 = instruction_index + i64_vector_get(
            block_instruction_count, block_index
        )
        while instruction_index < instruction_end:
            match i64_vector_get(instruction_function_ids, instruction_index) == function_id:
                -1:
                    discard 0
                0:
                    return 0
                1:
                    return 0
            match i64_vector_get(instruction_block_ids, instruction_index) == block_id:
                -1:
                    discard 0
                0:
                    return 0
                1:
                    return 0
            match stage1_emit_ir_instruction(
                instruction_opcodes,
                instruction_operand_first,
                instruction_operand_count,
                instruction_result_first,
                instruction_result_count,
                instruction_immediates,
                instruction_callee_function_ids,
                instruction_memory_ids,
                instruction_reference_target_types,
                instruction_reference_flags,
                type_kinds,
                type_element_ids,
                type_mutability_flags,
                type_lengths,
                instruction_target_first,
                instruction_target_count,
                result_value_ids,
                operand_value_ids,
                target_block_ids,
                function_ids,
                function_name_first,
                function_name_count,
                function_name_bytes,
                instruction_index,
                entry_block_id,
                output
            ) == 1:
                -1:
                    discard 0
                0:
                    return 0
                1:
                    return 0
            instruction_index = instruction_index + 1
        block_offset = block_offset + 1
    discard stage1_emit_literal(output, 13)
    return 1

fn stage1_emit_native_program(program: NativeIR, output: &mut vector<i64>) -> i64:
    discard stage1_emit_literal(output, 0)
    mut function_index: i64 = 0
    while function_index < i64_vector_len(&program.function_ids):
        match i64_vector_get(&program.function_external_flags, function_index) == 0:
            -1:
                match stage1_emit_native_function(
                    &program.function_ids,
                    &program.function_name_first,
                    &program.function_name_count,
                    &program.function_name_bytes,
                    &program.function_result_widths,
                    &program.function_result_type_first,
                    &program.function_result_type_ids,
                    &program.function_parameter_first,
                    &program.function_parameter_count,
                    &program.function_block_first,
                    &program.function_block_count,
                    &program.parameter_value_ids,
                    &program.parameter_type_ids,
                    &program.type_kinds,
                    &program.type_element_ids,
                    &program.type_mutability_flags,
                    &program.type_lengths,
                    &program.memory_ids,
                    &program.memory_types,
                    &program.memory_lengths,
                    &program.value_ids,
                    &program.definition_function_ids,
                    &program.value_type_ids,
                    &program.instruction_ids,
                    &program.instruction_function_ids,
                    &program.instruction_block_ids,
                    &program.instruction_opcodes,
                    &program.instruction_operand_first,
                    &program.instruction_operand_count,
                    &program.instruction_result_first,
                    &program.instruction_result_count,
                    &program.instruction_immediates,
                    &program.instruction_callee_function_ids,
                    &program.instruction_memory_ids,
                    &program.instruction_reference_target_types,
                    &program.instruction_reference_flags,
                    &program.instruction_target_first,
                    &program.instruction_target_count,
                    &program.result_value_ids,
                    &program.operand_value_ids,
                    &program.block_ids,
                    &program.block_function_ids,
                    &program.block_instruction_first,
                    &program.block_instruction_count,
                    &program.target_block_ids,
                    function_index,
                    output
                ) == 1:
                    -1:
                        discard 0
                    0:
                        return 0
                    1:
                        return 0
            0:
                discard 0
            1:
                discard 0
        function_index = function_index + 1
    return 1

export fn stage1_emit_verified_native_program(
    program: NativeIR,
    output: &mut vector<i64>
) -> i64:
    mut verified: NativeIRVerifiedResult = verify_program(program)
    match verified.verification.accepted == 1:
        -1:
            return stage1_emit_native_program(verified.program, output)
        0:
            return 0
        1:
            return 0

fn stage1_skip_body_newlines(tokens: &vector<i64>, start_cursor: i64) -> i64:
    mut cursor: i64 = start_cursor
    mut token_count: i64 = generic_token_count(tokens)
    while cursor < token_count:
        match generic_token_kind(tokens, cursor) == 6:
            -1:
                cursor = cursor + 1
            0:
                return cursor
            1:
                return cursor
    return cursor

fn stage1_indented_block_end(
    source: &vector<i64>,
    tokens: &vector<i64>,
    start_cursor: i64,
    parent_indent: i64
) -> i64:
    mut token_count: i64 = generic_token_count(tokens)
    mut cursor: i64 = stage1_skip_body_newlines(tokens, start_cursor)
    mut found_body_line: i64 = 0
    while cursor < token_count:
        mut indent: i64 = generic_native_parser_program_indent(
            source, generic_token_start(tokens, cursor)
        )
        match indent > parent_indent:
            -1:
                found_body_line = 1
                mut line_end: i64 = cursor
                mut next_line_cursor: i64 = -1
                while line_end < token_count:
                    match generic_token_kind(tokens, line_end) == 6:
                        -1:
                            next_line_cursor = line_end + 1
                            line_end = token_count
                        0:
                            line_end = line_end + 1
                        1:
                            line_end = line_end + 1
                match next_line_cursor >= 0:
                    -1:
                        cursor = next_line_cursor
                    0:
                        cursor = token_count
                    1:
                        cursor = token_count
                cursor = stage1_skip_body_newlines(tokens, cursor)
            0:
                match found_body_line == 1:
                    -1:
                        return cursor
                    0:
                        return -1
                    1:
                        return -1
            1:
                match found_body_line == 1:
                    -1:
                        return cursor
                    0:
                        return -1
                    1:
                        return -1
    match found_body_line == 1:
        -1:
            return cursor
        0:
            return -1
        1:
            return -1

fn stage1_parse_while_header(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    parent_indent: i64
) -> Stage1WhileHeader:
    mut tree: vector<i64> = generic_native_parser_parse_expression(
        source, tokens, cursor + 1, 0
    )
    mut packed: i64 = generic_expression_packed_result(&tree)
    match packed >= 0:
        -1:
            mut node_count: i64 = generic_expression_node_count(&tree)
            mut condition_cursor: i64 = generic_native_parser_packed_cursor(packed)
            match node_count <= 63:
                -1:
                    match generic_token_kind(tokens, condition_cursor) == 158:
                        -1:
                            match generic_token_kind(tokens, condition_cursor + 1) == 6:
                                -1:
                                    mut body_start: i64 = condition_cursor + 2
                                    mut body_end: i64 = stage1_indented_block_end(
                                        source, tokens, body_start, parent_indent
                                    )
                                    match body_end > body_start:
                                        -1:
                                            return Stage1WhileHeader(
                                                tree=tree,
                                                condition_node=generic_native_parser_packed_node(packed),
                                                body_start_cursor=body_start,
                                                body_end_cursor=body_end,
                                                accepted=1
                                            )
                                        0:
                                            discard 0
                                        1:
                                            discard 0
                                0:
                                    discard 0
                                1:
                                    discard 0
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
        0:
            discard 0
        1:
            discard 0
    return Stage1WhileHeader(
        tree=tree,
        condition_node=-1,
        body_start_cursor=-1,
        body_end_cursor=-1,
        accepted=0
    )

fn stage1_parse_match_arm_header(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    arm_indent: i64
) -> Stage1MatchArmHeader:
    mut label_cursor: i64 = cursor
    mut sign: i64 = 1
    match generic_token_kind(tokens, cursor) == 145:
        -1:
            sign = -1
            label_cursor = cursor + 1
        0:
            discard 0
        1:
            discard 0
    match generic_native_parser_program_indent(
        source, generic_token_start(tokens, cursor)
    ) == arm_indent:
        -1:
            match generic_token_kind(tokens, label_cursor) == 5:
                -1:
                    mut arm_value: i64 = sign * generic_native_parser_integer_value(
                        source,
                        generic_token_start(tokens, label_cursor),
                        generic_token_end(tokens, label_cursor)
                    )
                    match generic_token_kind(tokens, label_cursor + 1) == 158:
                        -1:
                            match generic_token_kind(tokens, label_cursor + 2) == 6:
                                -1:
                                    mut arm_slot: i64 = stage1_match_arm_slot(arm_value)
                                    match arm_slot <=> -2:
                                        -1:
                                            discard 0
                                        0:
                                            discard 0
                                        1:
                                            mut body_start: i64 = label_cursor + 3
                                            mut body_end: i64 = stage1_indented_block_end(
                                                source, tokens, body_start, arm_indent
                                            )
                                            match body_end > body_start:
                                                -1:
                                                    return Stage1MatchArmHeader(
                                                        body_start_cursor=body_start,
                                                        body_end_cursor=body_end,
                                                        arm_value=arm_value,
                                                        accepted=1
                                                    )
                                                0:
                                                    discard 0
                                                1:
                                                    discard 0
                                0:
                                    discard 0
                                1:
                                    discard 0
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
        0:
            discard 0
        1:
            discard 0
    return Stage1MatchArmHeader(
        body_start_cursor=-1,
        body_end_cursor=-1,
        arm_value=2,
        accepted=0
    )

fn stage1_match_arm_slot(arm_value: i64) -> i64:
    match arm_value <=> 0:
        -1:
            match arm_value <=> -1:
                -1:
                    return -2
                0:
                    return 0
                1:
                    return -2
        0:
            return 1
        1:
            match arm_value <=> 1:
                -1:
                    return -2
                0:
                    return 2
                1:
                    return -2

fn stage1_parse_match_header(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    parent_indent: i64
) -> Stage1MatchHeader:
    mut tree: vector<i64> = generic_native_parser_parse_expression(
        source, tokens, cursor + 1, 0
    )
    mut packed: i64 = generic_expression_packed_result(&tree)
    match packed >= 0:
        -1:
            mut condition_cursor: i64 = generic_native_parser_packed_cursor(packed)
            match generic_token_kind(tokens, condition_cursor) == 158:
                -1:
                    match generic_token_kind(tokens, condition_cursor + 1) == 6:
                        -1:
                            mut body_start: i64 = condition_cursor + 2
                            mut match_end: i64 = stage1_indented_block_end(
                                source, tokens, body_start, parent_indent
                            )
                            match match_end > body_start:
                                -1:
                                    mut negative_start: i64 = -1
                                    mut negative_end: i64 = -1
                                    mut neutral_start: i64 = -1
                                    mut neutral_end: i64 = -1
                                    mut positive_start: i64 = -1
                                    mut positive_end: i64 = -1
                                    mut saw_negative: i64 = 0
                                    mut saw_neutral: i64 = 0
                                    mut saw_positive: i64 = 0
                                    mut arm_cursor: i64 = stage1_skip_body_newlines(
                                        tokens, body_start
                                    )
                                    mut accepted: i64 = 1
                                    while arm_cursor < match_end:
                                        mut arm: Stage1MatchArmHeader = stage1_parse_match_arm_header(
                                            source, tokens, arm_cursor,
                                            parent_indent + 4
                                        )
                                        match arm.accepted == 1:
                                            -1:
                                                mut arm_slot: i64 = stage1_match_arm_slot(
                                                    arm.arm_value
                                                )
                                                match arm_slot <=> 0:
                                                    -1:
                                                        accepted = 0
                                                        arm_cursor = match_end
                                                    0:
                                                        match saw_negative == 0:
                                                            -1:
                                                                saw_negative = 1
                                                                negative_start = arm.body_start_cursor
                                                                negative_end = arm.body_end_cursor
                                                            0:
                                                                accepted = 0
                                                            1:
                                                                accepted = 0
                                                        arm_cursor = arm.body_end_cursor
                                                    1:
                                                        match arm_slot <=> 1:
                                                            -1:
                                                                accepted = 0
                                                                arm_cursor = match_end
                                                            0:
                                                                match saw_neutral == 0:
                                                                    -1:
                                                                        saw_neutral = 1
                                                                        neutral_start = arm.body_start_cursor
                                                                        neutral_end = arm.body_end_cursor
                                                                    0:
                                                                        accepted = 0
                                                                    1:
                                                                        accepted = 0
                                                                arm_cursor = arm.body_end_cursor
                                                            1:
                                                                match saw_positive == 0:
                                                                    -1:
                                                                        saw_positive = 1
                                                                        positive_start = arm.body_start_cursor
                                                                        positive_end = arm.body_end_cursor
                                                                    0:
                                                                        accepted = 0
                                                                    1:
                                                                        accepted = 0
                                                                arm_cursor = arm.body_end_cursor
                                            0:
                                                accepted = 0
                                                arm_cursor = match_end
                                            1:
                                                accepted = 0
                                                arm_cursor = match_end
                                    accepted = stage1_acceptance_and(accepted, saw_negative)
                                    accepted = stage1_acceptance_and(accepted, saw_neutral)
                                    accepted = stage1_acceptance_and(accepted, saw_positive)
                                    match accepted == 1:
                                        -1:
                                            return Stage1MatchHeader(
                                                tree=tree,
                                                condition_node=generic_native_parser_packed_node(packed),
                                                next_cursor=match_end,
                                                negative_body_start=negative_start,
                                                negative_body_end=negative_end,
                                                neutral_body_start=neutral_start,
                                                neutral_body_end=neutral_end,
                                                positive_body_start=positive_start,
                                                positive_body_end=positive_end,
                                                accepted=1
                                            )
                                        0:
                                            return Stage1MatchHeader(
                                                tree=tree,
                                                condition_node=-1,
                                                next_cursor=-1,
                                                negative_body_start=-1,
                                                negative_body_end=-1,
                                                neutral_body_start=-1,
                                                neutral_body_end=-1,
                                                positive_body_start=-1,
                                                positive_body_end=-1,
                                                accepted=0
                                            )
                                        1:
                                            return Stage1MatchHeader(
                                                tree=tree,
                                                condition_node=-1,
                                                next_cursor=-1,
                                                negative_body_start=-1,
                                                negative_body_end=-1,
                                                neutral_body_start=-1,
                                                neutral_body_end=-1,
                                                positive_body_start=-1,
                                                positive_body_end=-1,
                                                accepted=0
                                            )
                                0:
                                    discard 0
                                1:
                                    discard 0
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
        0:
            discard 0
        1:
            discard 0
    return Stage1MatchHeader(
        tree=tree,
        condition_node=-1,
        next_cursor=-1,
        negative_body_start=-1,
        negative_body_end=-1,
        neutral_body_start=-1,
        neutral_body_end=-1,
        positive_body_start=-1,
        positive_body_end=-1,
        accepted=0
    )

fn stage1_body_compile_failure(
    program: NativeIR,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>
) -> Stage1BodyCompileResult:
    return Stage1BodyCompileResult(
        program=program,
        symbol_name_starts=symbol_name_starts,
        symbol_name_ends=symbol_name_ends,
        symbol_value_ids=symbol_value_ids,
        symbol_memory_ids=vector_new<i64>(0),
        block_id=-1,
        return_value_id=-1,
        accepted=0
    )

fn stage1_continue_local_declaration(
    source: &vector<i64>,
    tokens: &vector<i64>,
    after_expression: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    name_start: i64,
    name_end: i64,
    value_id: i64,
    declaration_mutable: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_memory_ids: vector<i64>,
    symbol_mutability_flags: vector<i64>,
    body_indent: i64,
    allow_fallthrough: i64,
    statement_count: i64
) -> Stage1BodyCompileResult:
    mut storage: Stage1LowerResult = stage1_lower_declaration_storage(
        program, function_id, block_id, declaration_mutable, value_id
    )
    mut next_names: vector<i64> = i64_vector_clone(&symbol_name_starts)
    mut next_ends: vector<i64> = i64_vector_clone(&symbol_name_ends)
    mut next_values: vector<i64> = i64_vector_clone(&symbol_value_ids)
    mut next_memory_ids: vector<i64> = i64_vector_clone(&symbol_memory_ids)
    mut next_mutability: vector<i64> = i64_vector_clone(&symbol_mutability_flags)
    discard vector_push<i64>(&mut next_names, name_start)
    discard vector_push<i64>(&mut next_ends, name_end)
    discard vector_push<i64>(&mut next_values, value_id)
    discard vector_push<i64>(&mut next_memory_ids, storage.value_id)
    discard vector_push<i64>(&mut next_mutability, declaration_mutable)
    match storage.accepted == 1:
        -1:
            return stage1_compile_body_sequence(
                source,
                tokens,
                after_expression + 1,
                body_end_cursor,
                storage.program,
                function_id,
                block_id,
                next_names,
                next_ends,
                next_values,
                next_memory_ids,
                next_mutability,
                body_indent,
                allow_fallthrough,
                statement_count + 1
            )
        0:
            return stage1_body_compile_failure(
                storage.program, symbol_name_starts, symbol_name_ends,
                symbol_value_ids
            )
        1:
            return stage1_body_compile_failure(
                storage.program, symbol_name_starts, symbol_name_ends,
                symbol_value_ids
            )

fn stage1_i64_vector_value(
    value_ids: &vector<i64>,
    value_type_ids: &vector<i64>,
    type_kinds: &vector<i64>,
    type_element_ids: &vector<i64>,
    type_mutability_flags: &vector<i64>,
    type_lengths: &vector<i64>,
    value_id: i64
) -> i64:
    mut type_id: i64 = native_ir_value_type_id(
        value_ids, value_type_ids, value_id
    )
    match type_id >= 0:
        -1:
            match i64_vector_get(type_kinds, type_id) == 2:
                -1:
                    match i64_vector_get(type_element_ids, type_id) == 0:
                        -1:
                            match i64_vector_get(
                                type_mutability_flags, type_id
                            ) == 0:
                                -1:
                                    match i64_vector_get(type_lengths, type_id) == -1:
                                        -1:
                                            return 1
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn stage1_compile_vector_local_declaration(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    declaration_mutable: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_memory_ids: vector<i64>,
    symbol_mutability_flags: vector<i64>,
    body_indent: i64,
    allow_fallthrough: i64,
    statement_count: i64
) -> Stage1BodyCompileResult:
    mut name_start: i64 = generic_token_start(tokens, cursor)
    mut name_end: i64 = generic_token_end(tokens, cursor)
    mut valid_syntax: i64 = 1
    match generic_token_kind(tokens, cursor + 3) == 160:
        -1:
            match generic_native_parser_program_type_code_for_token(
                source, tokens, cursor + 4
            ) == 2:
                -1:
                    match generic_token_kind(tokens, cursor + 5) == 162:
                        -1:
                            match generic_token_kind(tokens, cursor + 6) == 161:
                                -1:
                                    discard 0
                                0:
                                    valid_syntax = 0
                                1:
                                    valid_syntax = 0
                        0:
                            valid_syntax = 0
                        1:
                            valid_syntax = 0
                0:
                    valid_syntax = 0
                1:
                    valid_syntax = 0
        0:
            valid_syntax = 0
        1:
            valid_syntax = 0
    match valid_syntax == 1:
        -1:
            match stage1_find_symbol_index(
                source, &symbol_name_starts, &symbol_name_ends,
                name_start, name_end
            ) < 0:
                -1:
                    mut lowered: Stage1ExpressionLowerResult = stage1_lower_source_expression(
                        source, tokens, cursor + 7, program, function_id, block_id,
                        &symbol_name_starts, &symbol_name_ends, &symbol_value_ids,
                        &symbol_memory_ids, &symbol_mutability_flags
                    )
                    mut lowered_accepted: i64 = lowered.accepted
                    mut lowered_value_id: i64 = lowered.value_id
                    mut lowered_next_cursor: i64 = lowered.next_cursor
                    mut lowered_program: NativeIR = lowered.program
                    match lowered_accepted == 1:
                        -1:
                            match stage1_i64_vector_value(
                                &lowered_program.value_ids,
                                &lowered_program.value_type_ids,
                                &lowered_program.type_kinds,
                                &lowered_program.type_element_ids,
                                &lowered_program.type_mutability_flags,
                                &lowered_program.type_lengths,
                                lowered_value_id
                            ) == 1:
                                -1:
                                    match generic_token_kind(
                                        tokens, lowered_next_cursor
                                    ) == 6:
                                        -1:
                                            return stage1_continue_local_declaration(
                                                source, tokens, lowered_next_cursor,
                                                body_end_cursor, lowered_program,
                                                function_id, block_id, name_start,
                                                name_end, lowered_value_id,
                                                declaration_mutable,
                                                symbol_name_starts,
                                                symbol_name_ends,
                                                symbol_value_ids,
                                                symbol_memory_ids,
                                                symbol_mutability_flags,
                                                body_indent, allow_fallthrough,
                                                statement_count
                                            )
                                        0:
                                            return stage1_body_compile_failure(
                                                lowered_program, symbol_name_starts,
                                                symbol_name_ends, symbol_value_ids
                                            )
                                        1:
                                            return stage1_body_compile_failure(
                                                lowered_program, symbol_name_starts,
                                                symbol_name_ends, symbol_value_ids
                                            )
                                0:
                                    return stage1_body_compile_failure(
                                        lowered_program, symbol_name_starts,
                                        symbol_name_ends, symbol_value_ids
                                    )
                                1:
                                    return stage1_body_compile_failure(
                                        lowered_program, symbol_name_starts,
                                        symbol_name_ends, symbol_value_ids
                                    )
                        0:
                            return stage1_body_compile_failure(
                                lowered_program, symbol_name_starts,
                                symbol_name_ends, symbol_value_ids
                            )
                        1:
                            return stage1_body_compile_failure(
                                lowered_program, symbol_name_starts,
                                symbol_name_ends, symbol_value_ids
                            )
                0:
                    return stage1_body_compile_failure(
                        program, symbol_name_starts, symbol_name_ends,
                        symbol_value_ids
                    )
                1:
                    return stage1_body_compile_failure(
                        program, symbol_name_starts, symbol_name_ends,
                        symbol_value_ids
                    )
        0:
            return stage1_body_compile_failure(
                program, symbol_name_starts, symbol_name_ends, symbol_value_ids
            )
        1:
            return stage1_body_compile_failure(
                program, symbol_name_starts, symbol_name_ends, symbol_value_ids
            )

fn stage1_source_span_is_mut(
    source: &vector<i64>,
    start: i64,
    end: i64
) -> i64:
    match end - start == 3:
        -1:
            match vector_get<i64>(source, start) == 109:
                -1:
                    match vector_get<i64>(source, start + 1) == 117:
                        -1:
                            match vector_get<i64>(source, start + 2) == 116:
                                -1:
                                    return 1
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn stage1_local_declaration_name_cursor(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64
) -> i64:
    match generic_token_kind(tokens, cursor) == 1:
        -1:
            match generic_token_kind(tokens, cursor + 1) == 158:
                -1:
                    return cursor
                0:
                    match stage1_source_span_is_mut(
                        source,
                        generic_token_start(tokens, cursor),
                        generic_token_end(tokens, cursor)
                    ) == 1:
                        -1:
                            match generic_token_kind(tokens, cursor + 1) == 1:
                                -1:
                                    match generic_token_kind(tokens, cursor + 2) == 158:
                                        -1:
                                            return cursor + 1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn stage1_lower_source_expression(
    source: &vector<i64>,
    tokens: &vector<i64>,
    expression_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: &vector<i64>,
    symbol_name_ends: &vector<i64>,
    symbol_value_ids: &vector<i64>,
    symbol_memory_ids: &vector<i64>,
    symbol_mutability_flags: &vector<i64>
) -> Stage1ExpressionLowerResult:
    mut tree: vector<i64> = generic_native_parser_parse_expression(
        source, tokens, expression_cursor, 0
    )
    mut packed: i64 = generic_expression_packed_result(&tree)
    match packed >= 0:
        -1:
            match generic_expression_node_count(&tree) <= 63:
                -1:
                    mut lowered: Stage1LowerResult = stage1_lower_expression(
                        generic_native_parser_packed_node(packed),
                        source,
                        &tree,
                        program,
                        function_id,
                        block_id,
                        symbol_name_starts,
                        symbol_name_ends,
                        symbol_value_ids,
                        symbol_memory_ids,
                        symbol_mutability_flags
                    )
                    mut accepted: i64 = lowered.accepted
                    mut value_id: i64 = lowered.value_id
                    mut next_cursor: i64 = generic_native_parser_packed_cursor(packed)
                    mut lowered_program: NativeIR = lowered.program
                    return Stage1ExpressionLowerResult(
                        program=lowered_program,
                        value_id=value_id,
                        next_cursor=next_cursor,
                        accepted=accepted
                    )
                0:
                    return Stage1ExpressionLowerResult(
                        program=program, value_id=-1, next_cursor=-1, accepted=0
                    )
                1:
                    return Stage1ExpressionLowerResult(
                        program=program, value_id=-1, next_cursor=-1, accepted=0
                    )
        0:
            return Stage1ExpressionLowerResult(
                program=program, value_id=-1, next_cursor=-1, accepted=0
            )
        1:
            return Stage1ExpressionLowerResult(
                program=program, value_id=-1, next_cursor=-1, accepted=0
            )

fn stage1_compile_assignment_statement(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_memory_ids: vector<i64>,
    symbol_mutability_flags: vector<i64>,
    body_indent: i64,
    allow_fallthrough: i64,
    statement_count: i64
) -> Stage1BodyCompileResult:
    mut symbol_index: i64 = stage1_find_symbol_index(
        source,
        &symbol_name_starts,
        &symbol_name_ends,
        generic_token_start(tokens, cursor),
        generic_token_end(tokens, cursor)
    )
    match symbol_index >= 0:
        -1:
            match vector_get<i64>(&symbol_mutability_flags, symbol_index) == 1:
                -1:
                    mut lowered: Stage1ExpressionLowerResult = stage1_lower_source_expression(
                        source,
                        tokens,
                        cursor + 2,
                        program,
                        function_id,
                        block_id,
                        &symbol_name_starts,
                        &symbol_name_ends,
                        &symbol_value_ids,
                        &symbol_memory_ids,
                        &symbol_mutability_flags
                    )
                    mut next_cursor: i64 = lowered.next_cursor
                    mut assigned_value_id: i64 = lowered.value_id
                    match lowered.accepted == 1:
                        -1:
                            match generic_token_kind(tokens, next_cursor) == 6:
                                -1:
                                    mut memory_id: i64 = vector_get<i64>(
                                        &symbol_memory_ids, symbol_index
                                    )
                                    mut stored: Stage1LowerResult = stage1_lower_store_if_mutable(
                                        lowered.program, function_id, block_id,
                                        memory_id, assigned_value_id
                                    )
                                    mut next_values: vector<i64> = i64_vector_clone(
                                        &symbol_value_ids
                                    )
                                    discard vector_set<i64>(
                                        &mut next_values, symbol_index, assigned_value_id
                                    )
                                    match stored.accepted == 1:
                                        -1:
                                            return stage1_compile_body_sequence(
                                                source,
                                                tokens,
                                                next_cursor + 1,
                                                body_end_cursor,
                                                stored.program,
                                                function_id,
                                                block_id,
                                                symbol_name_starts,
                                                symbol_name_ends,
                                                next_values,
                                                symbol_memory_ids,
                                                symbol_mutability_flags,
                                                body_indent,
                                                allow_fallthrough,
                                                statement_count + 1
                                            )
                                        0:
                                            return stage1_body_compile_failure(
                                                stored.program, symbol_name_starts,
                                                symbol_name_ends, symbol_value_ids
                                            )
                                        1:
                                            return stage1_body_compile_failure(
                                                stored.program, symbol_name_starts,
                                                symbol_name_ends, symbol_value_ids
                                            )
                                0:
                                    return stage1_body_compile_failure(
                                        lowered.program,
                                        symbol_name_starts,
                                        symbol_name_ends,
                                        symbol_value_ids
                                    )
                                1:
                                    return stage1_body_compile_failure(
                                        lowered.program,
                                        symbol_name_starts,
                                        symbol_name_ends,
                                        symbol_value_ids
                                    )
                        0:
                            return stage1_body_compile_failure(
                                lowered.program,
                                symbol_name_starts,
                                symbol_name_ends,
                                symbol_value_ids
                            )
                        1:
                            return stage1_body_compile_failure(
                                lowered.program,
                                symbol_name_starts,
                                symbol_name_ends,
                                symbol_value_ids
                            )
                0:
                    return stage1_body_compile_failure(
                        program,
                        symbol_name_starts,
                        symbol_name_ends,
                        symbol_value_ids
                    )
                1:
                    return stage1_body_compile_failure(
                        program,
                        symbol_name_starts,
                        symbol_name_ends,
                        symbol_value_ids
                    )
        0:
            return stage1_body_compile_failure(
                program,
                symbol_name_starts,
                symbol_name_ends,
                symbol_value_ids
            )
        1:
            return stage1_body_compile_failure(
                program,
                symbol_name_starts,
                symbol_name_ends,
                symbol_value_ids
            )

fn stage1_append_trit_literal(
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    value: i64
) -> NativeIRAppendResult:
    match value == -1:
        -1:
            mut zero: NativeIRAppendResult = native_ir_append_instruction_for_function(
                program, function_id, block_id, 0, 0, -1, -1, -1
            )
            match zero.accepted == 1:
                -1:
                    mut zero_value_id: i64 = zero.value_id
                    mut zero_program: NativeIR = zero.program
                    mut one: NativeIRAppendResult = native_ir_append_instruction_for_function(
                        zero_program, function_id, block_id, 0, 1, -1, -1, -1
                    )
                    match one.accepted == 1:
                        -1:
                            mut one_value_id: i64 = one.value_id
                            mut one_program: NativeIR = one.program
                            return native_ir_append_typed_instruction_for_function(
                                one_program, function_id, block_id, 11, 2,
                                zero_value_id, one_value_id, 1
                            )
                        0:
                            return one
                        1:
                            return one
                0:
                    return zero
                1:
                    return zero
        0:
            return native_ir_append_typed_instruction_for_function(
                program, function_id, block_id, 0, value, -1, -1, 1
            )
        1:
            return native_ir_append_typed_instruction_for_function(
                program, function_id, block_id, 0, value, -1, -1, 1
            )

fn stage1_typed_trit_return_literal(
    source: &vector<i64>,
    tokens: &vector<i64>,
    keyword_cursor: i64,
    expression_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    value_id: i64
) -> NativeIRAppendResult:
    match native_ir_function_result_type_id(
        &program.function_ids, &program.function_result_widths,
        &program.function_result_type_first, &program.function_result_type_ids,
        function_id, 0
    ) == 1:
        -1:
            mut expression_cursor: i64 = keyword_cursor + 1
            mut literal_value: i64 = -2
            match generic_token_kind(tokens, expression_cursor) == 145:
                -1:
                    match generic_token_kind(tokens, expression_cursor + 1) == 5:
                        -1:
                            match expression_end_cursor == expression_cursor + 2:
                                -1:
                                    mut literal_start: i64 = generic_token_start(
                                        tokens, expression_cursor + 1
                                    )
                                    mut literal_end: i64 = generic_token_end(
                                        tokens, expression_cursor + 1
                                    )
                                    mut magnitude: i64 = generic_native_parser_integer_value(
                                        source, literal_start, literal_end
                                    )
                                    match magnitude <= 1:
                                        -1:
                                            literal_value = 0 - magnitude
                                        0:
                                            discard 0
                                        1:
                                            discard 0
                                0:
                                    discard 0
                                1:
                                    discard 0
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    match generic_token_kind(tokens, expression_cursor) == 5:
                        -1:
                            match expression_end_cursor == expression_cursor + 1:
                                -1:
                                    mut literal_start: i64 = generic_token_start(
                                        tokens, expression_cursor
                                    )
                                    mut literal_end: i64 = generic_token_end(
                                        tokens, expression_cursor
                                    )
                                    mut magnitude: i64 = generic_native_parser_integer_value(
                                        source, literal_start, literal_end
                                    )
                                    match magnitude == 1:
                                        -1:
                                            literal_value = 1
                                        0:
                                            match magnitude == 0:
                                                -1:
                                                    literal_value = 0
                                                0:
                                                    discard 0
                                                1:
                                                    discard 0
                                        1:
                                            discard 0
                                0:
                                    discard 0
                                1:
                                    discard 0
                        0:
                            discard 0
                        1:
                            discard 0
                1:
                    discard 0
            match literal_value >= -1:
                -1:
                    match literal_value <= 1:
                        -1:
                            return stage1_append_trit_literal(
                                program, function_id, block_id, literal_value
                            )
                        0:
                            return NativeIRAppendResult(
                                program=program, accepted=1, value_id=value_id
                            )
                        1:
                            return NativeIRAppendResult(
                                program=program, accepted=1, value_id=value_id
                            )
                0:
                    return NativeIRAppendResult(
                        program=program, accepted=1, value_id=value_id
                    )
                1:
                    return NativeIRAppendResult(
                        program=program, accepted=1, value_id=value_id
                    )
        0:
            return NativeIRAppendResult(program=program, accepted=1, value_id=value_id)
        1:
            return NativeIRAppendResult(program=program, accepted=1, value_id=value_id)

fn stage1_finish_keyword_expression_statement(
    source: &vector<i64>,
    tokens: &vector<i64>,
    keyword_cursor: i64,
    expression_end_cursor: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_memory_ids: vector<i64>,
    symbol_mutability_flags: vector<i64>,
    body_indent: i64,
    allow_fallthrough: i64,
    statement_count: i64,
    value_id: i64
) -> Stage1BodyCompileResult:
    mut next_cursor: i64 = stage1_skip_body_newlines(tokens, expression_end_cursor + 1)
    match stage1_source_name_is_discard(
        source,
        generic_token_start(tokens, keyword_cursor),
        generic_token_end(tokens, keyword_cursor)
    ) == 1:
        -1:
            return stage1_compile_body_sequence(
                source, tokens, next_cursor, body_end_cursor, program,
                function_id, block_id, symbol_name_starts, symbol_name_ends,
                symbol_value_ids, symbol_memory_ids, symbol_mutability_flags,
                body_indent, allow_fallthrough, statement_count + 1
            )
        0:
            match next_cursor == body_end_cursor:
                -1:
                    mut returned: NativeIRAppendResult = stage1_typed_trit_return_literal(
                        source, tokens, keyword_cursor, expression_end_cursor,
                        program, function_id, block_id, value_id
                    )
                    match returned.accepted == 1:
                        -1:
                            return Stage1BodyCompileResult(
                                program=returned.program,
                                symbol_name_starts=symbol_name_starts,
                                symbol_name_ends=symbol_name_ends,
                                symbol_value_ids=symbol_value_ids,
                                symbol_memory_ids=symbol_memory_ids,
                                block_id=block_id,
                                return_value_id=returned.value_id,
                                accepted=1
                            )
                        0:
                            return stage1_body_compile_failure(
                                returned.program, symbol_name_starts,
                                symbol_name_ends, symbol_value_ids
                            )
                        1:
                            return stage1_body_compile_failure(
                                returned.program, symbol_name_starts,
                                symbol_name_ends, symbol_value_ids
                            )
                0:
                    return stage1_body_compile_failure(
                        program, symbol_name_starts, symbol_name_ends,
                        symbol_value_ids
                    )
                1:
                    return stage1_body_compile_failure(
                        program, symbol_name_starts, symbol_name_ends,
                        symbol_value_ids
                    )
        1:
            return stage1_compile_body_sequence(
                source, tokens, next_cursor, body_end_cursor, program,
                function_id, block_id, symbol_name_starts, symbol_name_ends,
                symbol_value_ids, symbol_memory_ids, symbol_mutability_flags,
                body_indent, allow_fallthrough, statement_count + 1
            )

fn stage1_compile_body_sequence_non_assignment_plain(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_memory_ids: vector<i64>,
    symbol_mutability_flags: vector<i64>,
    body_indent: i64,
    allow_fallthrough: i64,
    statement_count: i64
) -> Stage1BodyCompileResult:
    mut current_cursor: i64 = stage1_skip_body_newlines(tokens, cursor)
    match current_cursor == body_end_cursor:
        -1:
            match allow_fallthrough == 1:
                -1:
                    return Stage1BodyCompileResult(
                        program=program,
                        symbol_name_starts=symbol_name_starts,
                        symbol_name_ends=symbol_name_ends,
                        symbol_value_ids=symbol_value_ids,
                        symbol_memory_ids=symbol_memory_ids,
                        block_id=block_id,
                        return_value_id=-1,
                        accepted=1
                    )
                0:
                    return stage1_body_compile_failure(
                        program, symbol_name_starts, symbol_name_ends, symbol_value_ids
                    )
                1:
                    return stage1_body_compile_failure(
                        program, symbol_name_starts, symbol_name_ends, symbol_value_ids
                    )
        0:
            match statement_count < 64:
                -1:
                    match generic_native_parser_program_indent(
                        source, generic_token_start(tokens, current_cursor)
                    ) == body_indent:
                        -1:
                            match generic_token_kind(tokens, current_cursor) == 3:
                                -1:
                                    mut expression_cursor: i64 = current_cursor + 1
                                    mut lowered: Stage1ExpressionLowerResult = stage1_lower_source_expression(
                                        source,
                                        tokens,
                                        expression_cursor,
                                        program,
                                        function_id,
                                        block_id,
                                        &symbol_name_starts,
                                        &symbol_name_ends,
                                        &symbol_value_ids,
                                        &symbol_memory_ids,
                                        &symbol_mutability_flags
                                    )
                                    mut accepted: i64 = lowered.accepted
                                    mut return_value_id: i64 = lowered.value_id
                                    mut after_return: i64 = lowered.next_cursor
                                    mut lowered_program: NativeIR = lowered.program
                                    match accepted == 1:
                                        -1:
                                            match generic_token_kind(tokens, after_return) == 6:
                                                -1:
                                                    return stage1_finish_keyword_expression_statement(
                                                        source, tokens, current_cursor,
                                                        after_return, body_end_cursor,
                                                        lowered_program, function_id,
                                                        block_id, symbol_name_starts,
                                                        symbol_name_ends, symbol_value_ids,
                                                        symbol_memory_ids,
                                                        symbol_mutability_flags, body_indent,
                                                        allow_fallthrough, statement_count,
                                                        return_value_id
                                                    )
                                                0:
                                                    return stage1_body_compile_failure(
                                                        lowered_program,
                                                        symbol_name_starts,
                                                        symbol_name_ends,
                                                        symbol_value_ids
                                                    )
                                                1:
                                                    return stage1_body_compile_failure(
                                                        lowered_program,
                                                        symbol_name_starts,
                                                        symbol_name_ends,
                                                        symbol_value_ids
                                                    )
                                        0:
                                            return stage1_body_compile_failure(
                                                lowered_program,
                                                symbol_name_starts,
                                                symbol_name_ends,
                                                symbol_value_ids
                                            )
                                        1:
                                            return stage1_body_compile_failure(
                                                lowered_program,
                                                symbol_name_starts,
                                                symbol_name_ends,
                                                symbol_value_ids
                                            )
                                0:
                                    match generic_token_kind(tokens, current_cursor) == 1:
                                        -1:
                                            mut declaration_name_cursor: i64 = stage1_local_declaration_name_cursor(
                                                source, tokens, current_cursor
                                            )
                                            mut declaration_mutable: i64 = 0
                                            match declaration_name_cursor == current_cursor + 1:
                                                -1:
                                                    declaration_mutable = 1
                                                0:
                                                    discard 0
                                                1:
                                                    discard 0
                                            match declaration_name_cursor >= 0:
                                                -1:
                                                    current_cursor = declaration_name_cursor
                                                0:
                                                    discard 0
                                                1:
                                                    discard 0
                                            match generic_token_kind(tokens, current_cursor + 1) == 158:
                                                -1:
                                                    match generic_native_parser_program_type_code_for_token(
                                                        source, tokens, current_cursor + 2
                                                    ) == 2:
                                                        -1:
                                                            match generic_token_kind(tokens, current_cursor + 3) == 161:
                                                                -1:
                                                                    mut name_start: i64 = generic_token_start(tokens, current_cursor)
                                                                    mut name_end: i64 = generic_token_end(tokens, current_cursor)
                                                                    mut existing_value: i64 = stage1_find_symbol_value(
                                                                        source,
                                                                        &symbol_name_starts,
                                                                        &symbol_name_ends,
                                                                        &symbol_value_ids,
                                                                        name_start,
                                                                        name_end
                                                                    )
                                                                    match existing_value < 0:
                                                                        -1:
                                                                            mut expression_cursor: i64 = current_cursor + 4
                                                                            mut lowered: Stage1ExpressionLowerResult = stage1_lower_source_expression(
                                                                                source,
                                                                                tokens,
                                                                                expression_cursor,
                                                                                program,
                                                                                function_id,
                                                                                block_id,
                                                                                &symbol_name_starts,
                                                                                &symbol_name_ends,
                                                                                &symbol_value_ids,
                                                                                &symbol_memory_ids,
                                                                                &symbol_mutability_flags
                                                                            )
                                                                            mut accepted: i64 = lowered.accepted
                                                                            mut local_value_id: i64 = lowered.value_id
                                                                            mut after_expression: i64 = lowered.next_cursor
                                                                            mut lowered_program: NativeIR = lowered.program
                                                                            match accepted == 1:
                                                                                -1:
                                                                                    match generic_token_kind(tokens, after_expression) == 6:
                                                                                        -1:
                                                                                            return stage1_continue_local_declaration(
                                                                                                source,
                                                                                                tokens,
                                                                                                after_expression,
                                                                                                body_end_cursor,
                                                                                                lowered_program,
                                                                                                function_id,
                                                                                                block_id,
                                                                                                name_start,
                                                                                                name_end,
                                                                                                local_value_id,
                                                                                                declaration_mutable,
                                                                                                symbol_name_starts,
                                                                                                symbol_name_ends,
                                                                                                symbol_value_ids,
                                                                                                symbol_memory_ids,
                                                                                                symbol_mutability_flags,
                                                                                                body_indent,
                                                                                                allow_fallthrough,
                                                                                                statement_count
                                                                                            )
                                                                                        0:
                                                                                            return stage1_body_compile_failure(
                                                                                                lowered_program,
                                                                                                symbol_name_starts,
                                                                                                symbol_name_ends,
                                                                                                symbol_value_ids
                                                                                            )
                                                                                        1:
                                                                                            return stage1_body_compile_failure(
                                                                                                lowered_program,
                                                                                                symbol_name_starts,
                                                                                                symbol_name_ends,
                                                                                                symbol_value_ids
                                                                                            )
                                                                                0:
                                                                                    return stage1_body_compile_failure(
                                                                                        lowered_program,
                                                                                        symbol_name_starts,
                                                                                        symbol_name_ends,
                                                                                        symbol_value_ids
                                                                                    )
                                                                                1:
                                                                                    return stage1_body_compile_failure(
                                                                                        lowered_program,
                                                                                        symbol_name_starts,
                                                                                        symbol_name_ends,
                                                                                        symbol_value_ids
                                                                                    )
                                                                        0:
                                                                            return stage1_body_compile_failure(
                                                                                program,
                                                                                symbol_name_starts,
                                                                                symbol_name_ends,
                                                                                symbol_value_ids
                                                                            )
                                                                        1:
                                                                            return stage1_body_compile_failure(
                                                                                program,
                                                                                symbol_name_starts,
                                                                                symbol_name_ends,
                                                                                symbol_value_ids
                                                                            )
                                                                0:
                                                                    return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                                                                1:
                                                                    return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                                                        0:
                                                            match generic_native_parser_program_type_code_for_token(
                                                                source, tokens, current_cursor + 2
                                                            ) == 5:
                                                                -1:
                                                                    return stage1_compile_vector_local_declaration(
                                                                        source, tokens, current_cursor,
                                                                        body_end_cursor, program,
                                                                        function_id, block_id,
                                                                        declaration_mutable,
                                                                        symbol_name_starts,
                                                                        symbol_name_ends,
                                                                        symbol_value_ids,
                                                                        symbol_memory_ids,
                                                                        symbol_mutability_flags,
                                                                        body_indent,
                                                                        allow_fallthrough,
                                                                        statement_count
                                                                    )
                                                                0:
                                                                    return stage1_body_compile_failure(
                                                                        program, symbol_name_starts,
                                                                        symbol_name_ends, symbol_value_ids
                                                                    )
                                                                1:
                                                                    return stage1_body_compile_failure(
                                                                        program, symbol_name_starts,
                                                                        symbol_name_ends, symbol_value_ids
                                                                    )
                                                        1:
                                                            match generic_native_parser_program_type_code_for_token(
                                                                source, tokens, current_cursor + 2
                                                            ) == 5:
                                                                -1:
                                                                    return stage1_compile_vector_local_declaration(
                                                                        source, tokens, current_cursor,
                                                                        body_end_cursor, program,
                                                                        function_id, block_id,
                                                                        declaration_mutable,
                                                                        symbol_name_starts,
                                                                        symbol_name_ends,
                                                                        symbol_value_ids,
                                                                        symbol_memory_ids,
                                                                        symbol_mutability_flags,
                                                                        body_indent,
                                                                        allow_fallthrough,
                                                                        statement_count
                                                                    )
                                                                0:
                                                                    return stage1_body_compile_failure(
                                                                        program, symbol_name_starts,
                                                                        symbol_name_ends, symbol_value_ids
                                                                    )
                                                                1:
                                                                    return stage1_body_compile_failure(
                                                                        program, symbol_name_starts,
                                                                        symbol_name_ends, symbol_value_ids
                                                                    )
                                                0:
                                                    return stage1_body_compile_failure(
                                                        program, symbol_name_starts,
                                                        symbol_name_ends, symbol_value_ids
                                                    )
                                                1:
                                                    return stage1_body_compile_failure(
                                                        program, symbol_name_starts,
                                                        symbol_name_ends, symbol_value_ids
                                                    )
                                        0:
                                            return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                                        1:
                                            return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                                1:
                                    return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                        0:
                            return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                        1:
                            return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                0:
                    return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
                1:
                    return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)
        1:
            return stage1_body_compile_failure(program, symbol_name_starts, symbol_name_ends, symbol_value_ids)

fn stage1_finish_loop_body(
    function_id: i64,
    body: Stage1BodyCompileResult,
    condition_block_id: i64
) -> Stage1LowerResult:
    mut body_block_id: i64 = body.block_id
    mut return_value_id: i64 = body.return_value_id
    mut body_program: NativeIR = body.program
    match return_value_id >= 0:
        -1:
            mut terminator: NativeIRAppendResult = native_ir_set_block_terminator_for_function(
                body_program, function_id, body_block_id, 1
            )
            match terminator.accepted == 1:
                -1:
                    return stage1_lower_from_append(
                        native_ir_append_instruction_for_function(
                            terminator.program,
                            function_id,
                            body_block_id,
                            1,
                            0,
                            return_value_id,
                            -1,
                            -1
                        )
                    )
                0:
                    return stage1_lower_preserved_failure(terminator.program)
                1:
                    return stage1_lower_preserved_failure(terminator.program)
        0:
            mut terminator: NativeIRAppendResult = native_ir_set_block_terminator_for_function(
                body_program, function_id, body_block_id, 3
            )
            match terminator.accepted == 1:
                -1:
                    return stage1_lower_from_append(
                        native_ir_append_jump_for_function(
                            terminator.program,
                            function_id,
                            body_block_id,
                            condition_block_id
                        )
                    )
                0:
                    return stage1_lower_preserved_failure(terminator.program)
                1:
                    return stage1_lower_preserved_failure(terminator.program)
        1:
            mut terminator: NativeIRAppendResult = native_ir_set_block_terminator_for_function(
                body_program, function_id, body_block_id, 3
            )
            match terminator.accepted == 1:
                -1:
                    return stage1_lower_from_append(
                        native_ir_append_jump_for_function(
                            terminator.program,
                            function_id,
                            body_block_id,
                            condition_block_id
                        )
                    )
                0:
                    return stage1_lower_preserved_failure(terminator.program)
                1:
                    return stage1_lower_preserved_failure(terminator.program)

fn stage1_match_block_set_failure(program: NativeIR) -> Stage1MatchBlockSet:
    return Stage1MatchBlockSet(
        program=program,
        negative_block_id=-1,
        neutral_block_id=-1,
        positive_block_id=-1,
        continuation_block_id=-1,
        accepted=0
    )

fn stage1_append_match_blocks(
    program: NativeIR, function_id: i64
) -> Stage1MatchBlockSet:
    mut negative: Stage1LowerResult = stage1_lower_new_block(
        program, function_id, 3
    )
    match negative.accepted == 1:
        -1:
            mut negative_block_id: i64 = negative.value_id
            mut neutral: Stage1LowerResult = stage1_lower_new_block(
                negative.program, function_id, 3
            )
            match neutral.accepted == 1:
                -1:
                    mut neutral_block_id: i64 = neutral.value_id
                    mut positive: Stage1LowerResult = stage1_lower_new_block(
                        neutral.program, function_id, 3
                    )
                    match positive.accepted == 1:
                        -1:
                            mut positive_block_id: i64 = positive.value_id
                            mut continuation: Stage1LowerResult = stage1_lower_new_block(
                                positive.program, function_id, 3
                            )
                            match continuation.accepted == 1:
                                -1:
                                    return Stage1MatchBlockSet(
                                        program=continuation.program,
                                        negative_block_id=negative_block_id,
                                        neutral_block_id=neutral_block_id,
                                        positive_block_id=positive_block_id,
                                        continuation_block_id=continuation.value_id,
                                        accepted=1
                                    )
                                0:
                                    return stage1_match_block_set_failure(
                                        continuation.program
                                    )
                                1:
                                    return stage1_match_block_set_failure(
                                        continuation.program
                                    )
                        0:
                            return stage1_match_block_set_failure(positive.program)
                        1:
                            return stage1_match_block_set_failure(positive.program)
                0:
                    return stage1_match_block_set_failure(neutral.program)
                1:
                    return stage1_match_block_set_failure(neutral.program)
        0:
            return stage1_match_block_set_failure(negative.program)
        1:
            return stage1_match_block_set_failure(negative.program)

fn stage1_finish_match_arm(
    function_id: i64,
    body: Stage1BodyCompileResult,
    continuation_block_id: i64
) -> Stage1LowerResult:
    mut body_block_id: i64 = body.block_id
    mut return_value_id: i64 = body.return_value_id
    mut body_program: NativeIR = body.program
    match return_value_id >= 0:
        -1:
            mut terminator: NativeIRAppendResult = native_ir_set_block_terminator_for_function(
                body_program, function_id, body_block_id, 1
            )
            match terminator.accepted == 1:
                -1:
                    return stage1_lower_from_append(
                        native_ir_append_instruction_for_function(
                            terminator.program,
                            function_id,
                            body_block_id,
                            1,
                            0,
                            return_value_id,
                            -1,
                            -1
                        )
                    )
                0:
                    return stage1_lower_preserved_failure(terminator.program)
                1:
                    return stage1_lower_preserved_failure(terminator.program)
        0:
            mut terminator: NativeIRAppendResult = native_ir_set_block_terminator_for_function(
                body_program, function_id, body_block_id, 3
            )
            match terminator.accepted == 1:
                -1:
                    return stage1_lower_from_append(
                        native_ir_append_jump_for_function(
                            terminator.program,
                            function_id,
                            body_block_id,
                            continuation_block_id
                        )
                    )
                0:
                    return stage1_lower_preserved_failure(terminator.program)
                1:
                    return stage1_lower_preserved_failure(terminator.program)
        1:
            mut terminator: NativeIRAppendResult = native_ir_set_block_terminator_for_function(
                body_program, function_id, body_block_id, 3
            )
            match terminator.accepted == 1:
                -1:
                    return stage1_lower_from_append(
                        native_ir_append_jump_for_function(
                            terminator.program,
                            function_id,
                            body_block_id,
                            continuation_block_id
                        )
                    )
                0:
                    return stage1_lower_preserved_failure(terminator.program)
                1:
                    return stage1_lower_preserved_failure(terminator.program)

fn stage1_compile_match_arm(
    source: &vector<i64>,
    tokens: &vector<i64>,
    body_start_cursor: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    continuation_block_id: i64,
    symbol_name_starts: &vector<i64>,
    symbol_name_ends: &vector<i64>,
    symbol_value_ids: &vector<i64>,
    symbol_memory_ids: &vector<i64>,
    symbol_mutability_flags: &vector<i64>,
    body_indent: i64
) -> Stage1MatchArmResult:
    mut body: Stage1BodyCompileResult = stage1_compile_body_sequence(
        source,
        tokens,
        body_start_cursor,
        body_end_cursor,
        program,
        function_id,
        block_id,
        i64_vector_clone(symbol_name_starts),
        i64_vector_clone(symbol_name_ends),
        i64_vector_clone(symbol_value_ids),
        i64_vector_clone(symbol_memory_ids),
        i64_vector_clone(symbol_mutability_flags),
        body_indent,
        1,
        0
    )
    match body.accepted == 1:
        -1:
            mut arm_return_value_id: i64 = body.return_value_id
            mut finished: Stage1LowerResult = stage1_finish_match_arm(
                function_id, body, continuation_block_id
            )
            return Stage1MatchArmResult(
                program=finished.program,
                return_value_id=arm_return_value_id,
                accepted=finished.accepted
            )
        0:
            return Stage1MatchArmResult(
                program=body.program, return_value_id=-1, accepted=0
            )
        1:
            return Stage1MatchArmResult(
                program=body.program, return_value_id=-1, accepted=0
            )

fn stage1_append_unreachable_match_join(
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_memory_ids: vector<i64>
) -> Stage1BodyCompileResult:
    mut function_result_type_id: i64 = native_ir_function_result_type_id(
        &program.function_ids, &program.function_result_widths,
        &program.function_result_type_first, &program.function_result_type_ids,
        function_id, 0
    )
    mut appended: NativeIRAppendResult = native_ir_append_typed_instruction_for_function(
        program,
        function_id,
        block_id,
        0,
        0,
        -1,
        -1,
        function_result_type_id
    )
    match appended.accepted == 1:
        -1:
            mut appended_value_id: i64 = appended.value_id
            mut appended_program: NativeIR = appended.program
            return Stage1BodyCompileResult(
                program=appended_program,
                symbol_name_starts=symbol_name_starts,
                symbol_name_ends=symbol_name_ends,
                symbol_value_ids=symbol_value_ids,
                symbol_memory_ids=symbol_memory_ids,
                block_id=block_id,
                return_value_id=appended_value_id,
                accepted=1
            )
        0:
            return stage1_body_compile_failure(
                appended.program,
                symbol_name_starts,
                symbol_name_ends,
                symbol_value_ids
            )
        1:
            return stage1_body_compile_failure(
                appended.program,
                symbol_name_starts,
                symbol_name_ends,
                symbol_value_ids
            )

fn stage1_normalize_match_continuation(
    continuation: Stage1BodyCompileResult,
    function_id: i64
) -> Stage1BodyCompileResult:
    mut continuation_block_id: i64 = continuation.block_id
    mut continuation_return_value_id: i64 = continuation.return_value_id
    mut continuation_accepted: i64 = continuation.accepted
    mut continuation_symbol_name_starts: vector<i64> = i64_vector_clone(
        &continuation.symbol_name_starts
    )
    mut continuation_symbol_name_ends: vector<i64> = i64_vector_clone(
        &continuation.symbol_name_ends
    )
    mut continuation_symbol_value_ids: vector<i64> = i64_vector_clone(
        &continuation.symbol_value_ids
    )
    mut continuation_symbol_memory_ids: vector<i64> = i64_vector_clone(
        &continuation.symbol_memory_ids
    )
    mut continuation_program: NativeIR = continuation.program
    match continuation_return_value_id >= 0:
        -1:
            return Stage1BodyCompileResult(
                program=continuation_program,
                symbol_name_starts=continuation_symbol_name_starts,
                symbol_name_ends=continuation_symbol_name_ends,
                symbol_value_ids=continuation_symbol_value_ids,
                symbol_memory_ids=continuation_symbol_memory_ids,
                block_id=continuation_block_id,
                return_value_id=continuation_return_value_id,
                accepted=continuation_accepted
            )
        0:
            return stage1_append_unreachable_match_join(
                continuation_program,
                function_id,
                continuation_block_id,
                continuation_symbol_name_starts,
                continuation_symbol_name_ends,
                continuation_symbol_value_ids,
                continuation_symbol_memory_ids
            )
        1:
            return stage1_append_unreachable_match_join(
                continuation_program,
                function_id,
                continuation_block_id,
                continuation_symbol_name_starts,
                continuation_symbol_name_ends,
                continuation_symbol_value_ids,
                continuation_symbol_memory_ids
            )

fn stage1_match_arms_all_return(
    negative_return_value_id: i64,
    neutral_return_value_id: i64,
    positive_return_value_id: i64
) -> i64:
    match negative_return_value_id >= 0:
        -1:
            match neutral_return_value_id >= 0:
                -1:
                    match positive_return_value_id >= 0:
                        -1:
                            return 1
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn stage1_compile_match_statement(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    preheader_block_id: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_memory_ids: vector<i64>,
    symbol_mutability_flags: vector<i64>,
    body_indent: i64,
    allow_fallthrough: i64,
    statement_count: i64
) -> Stage1BodyCompileResult:
    mut header: Stage1MatchHeader = stage1_parse_match_header(
        source, tokens, cursor, body_indent
    )
    match header.accepted == 1:
        -1:
            mut blocks: Stage1MatchBlockSet = stage1_append_match_blocks(
                program, function_id
            )
            match blocks.accepted == 1:
                -1:
                    mut negative_block_id: i64 = blocks.negative_block_id
                    mut neutral_block_id: i64 = blocks.neutral_block_id
                    mut positive_block_id: i64 = blocks.positive_block_id
                    mut continuation_block_id: i64 = blocks.continuation_block_id
                    mut blocks_program: NativeIR = blocks.program
                    mut condition: Stage1LowerResult = stage1_lower_expression(
                        header.condition_node,
                        source,
                        &header.tree,
                        blocks_program,
                        function_id,
                        preheader_block_id,
                        &symbol_name_starts,
                        &symbol_name_ends,
                        &symbol_value_ids,
                        &symbol_memory_ids,
                        &symbol_mutability_flags
                    )
                    match condition.accepted == 1:
                        -1:
                            mut condition_type_id: i64 = native_ir_value_type_id(
                                &condition.program.value_ids,
                                &condition.program.value_type_ids,
                                condition.value_id
                            )
                            match condition_type_id == 1:
                                -1:
                                    mut condition_value_id: i64 = condition.value_id
                                    mut condition_program: NativeIR = condition.program
                                    mut match_terminator: NativeIRAppendResult = native_ir_set_block_terminator_for_function(
                                        condition_program,
                                        function_id,
                                        preheader_block_id,
                                        2
                                    )
                                    mut branch: NativeIRAppendResult = native_ir_append_branch_for_function(
                                        match_terminator.program,
                                        function_id,
                                        preheader_block_id,
                                        condition_value_id,
                                        negative_block_id,
                                        neutral_block_id,
                                        positive_block_id
                                    )
                                    match branch.accepted == 1:
                                        -1:
                                            mut negative: Stage1MatchArmResult = stage1_compile_match_arm(
                                                source,
                                                tokens,
                                                header.negative_body_start,
                                                header.negative_body_end,
                                                branch.program,
                                                function_id,
                                                negative_block_id,
                                                continuation_block_id,
                                                &symbol_name_starts,
                                                &symbol_name_ends,
                                                &symbol_value_ids,
                                                &symbol_memory_ids,
                                                &symbol_mutability_flags,
                                                body_indent + 8
                                            )
                                            mut negative_return_value_id: i64 = negative.return_value_id
                                            match negative.accepted == 1:
                                                -1:
                                                    mut neutral: Stage1MatchArmResult = stage1_compile_match_arm(
                                                        source,
                                                        tokens,
                                                        header.neutral_body_start,
                                                        header.neutral_body_end,
                                                        negative.program,
                                                        function_id,
                                                        neutral_block_id,
                                                        continuation_block_id,
                                                        &symbol_name_starts,
                                                        &symbol_name_ends,
                                                        &symbol_value_ids,
                                                        &symbol_memory_ids,
                                                        &symbol_mutability_flags,
                                                        body_indent + 8
                                                    )
                                                    mut neutral_return_value_id: i64 = neutral.return_value_id
                                                    match neutral.accepted == 1:
                                                        -1:
                                                            mut positive: Stage1MatchArmResult = stage1_compile_match_arm(
                                                                source,
                                                                tokens,
                                                                header.positive_body_start,
                                                                header.positive_body_end,
                                                                neutral.program,
                                                                function_id,
                                                                positive_block_id,
                                                                continuation_block_id,
                                                                &symbol_name_starts,
                                                                &symbol_name_ends,
                                                                &symbol_value_ids,
                                                                &symbol_memory_ids,
                                                                &symbol_mutability_flags,
                                                                body_indent + 8
                                                            )
                                                            mut positive_return_value_id: i64 = positive.return_value_id
                                                            match positive.accepted == 1:
                                                                -1:
                                                                    mut all_arms_returned: i64 = stage1_match_arms_all_return(
                                                                        negative_return_value_id,
                                                                        neutral_return_value_id,
                                                                        positive_return_value_id
                                                                    )
                                                                    mut continuation_allow_fallthrough: i64 = allow_fallthrough
                                                                    match all_arms_returned == 1:
                                                                        -1:
                                                                            continuation_allow_fallthrough = 1
                                                                        0:
                                                                            discard 0
                                                                        1:
                                                                            discard 0
                                                                    mut continuation: Stage1BodyCompileResult = stage1_compile_body_sequence(
                                                                        source,
                                                                        tokens,
                                                                        header.next_cursor,
                                                                        body_end_cursor,
                                                                        positive.program,
                                                                        function_id,
                                                                        continuation_block_id,
                                                                        symbol_name_starts,
                                                                        symbol_name_ends,
                                                                        symbol_value_ids,
                                                                        symbol_memory_ids,
                                                                        symbol_mutability_flags,
                                                                        body_indent,
                                                                        continuation_allow_fallthrough,
                                                                        statement_count + 1
                                                                    )
                                                                    match all_arms_returned == 1:
                                                                        -1:
                                                                            return stage1_normalize_match_continuation(
                                                                                continuation, function_id
                                                                            )
                                                                        0:
                                                                            return continuation
                                                                        1:
                                                                            return continuation
                                                                0:
                                                                    return stage1_body_compile_failure(
                                                                        positive.program,
                                                                        symbol_name_starts,
                                                                        symbol_name_ends,
                                                                        symbol_value_ids
                                                                    )
                                                                1:
                                                                    return stage1_body_compile_failure(
                                                                        positive.program,
                                                                        symbol_name_starts,
                                                                        symbol_name_ends,
                                                                        symbol_value_ids
                                                                    )
                                                        0:
                                                            return stage1_body_compile_failure(
                                                                neutral.program,
                                                                symbol_name_starts,
                                                                symbol_name_ends,
                                                                symbol_value_ids
                                                            )
                                                        1:
                                                            return stage1_body_compile_failure(
                                                                neutral.program,
                                                                symbol_name_starts,
                                                                symbol_name_ends,
                                                                symbol_value_ids
                                                            )
                                                0:
                                                    return stage1_body_compile_failure(
                                                        negative.program,
                                                        symbol_name_starts,
                                                        symbol_name_ends,
                                                        symbol_value_ids
                                                    )
                                                1:
                                                    return stage1_body_compile_failure(
                                                        negative.program,
                                                        symbol_name_starts,
                                                        symbol_name_ends,
                                                        symbol_value_ids
                                                    )
                                        0:
                                            return stage1_body_compile_failure(
                                                branch.program,
                                                symbol_name_starts,
                                                symbol_name_ends,
                                                symbol_value_ids
                                            )
                                        1:
                                            return stage1_body_compile_failure(
                                                branch.program,
                                                symbol_name_starts,
                                                symbol_name_ends,
                                                symbol_value_ids
                                            )
                                0:
                                    return stage1_body_compile_failure(
                                        condition.program,
                                        symbol_name_starts,
                                        symbol_name_ends,
                                        symbol_value_ids
                                    )
                                1:
                                    return stage1_body_compile_failure(
                                        condition.program,
                                        symbol_name_starts,
                                        symbol_name_ends,
                                        symbol_value_ids
                                    )
                        0:
                            return stage1_body_compile_failure(
                                condition.program,
                                symbol_name_starts,
                                symbol_name_ends,
                                symbol_value_ids
                            )
                        1:
                            return stage1_body_compile_failure(
                                condition.program,
                                symbol_name_starts,
                                symbol_name_ends,
                                symbol_value_ids
                            )
                0:
                    return stage1_body_compile_failure(
                        blocks.program, symbol_name_starts,
                        symbol_name_ends, symbol_value_ids
                    )
                1:
                    return stage1_body_compile_failure(
                        blocks.program, symbol_name_starts,
                        symbol_name_ends, symbol_value_ids
                    )
        0:
            return stage1_body_compile_failure(
                program, symbol_name_starts, symbol_name_ends, symbol_value_ids
            )
        1:
            return stage1_body_compile_failure(
                program, symbol_name_starts, symbol_name_ends, symbol_value_ids
            )

fn stage1_compile_while_statement(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    preheader_block_id: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_memory_ids: vector<i64>,
    symbol_mutability_flags: vector<i64>,
    body_indent: i64,
    allow_fallthrough: i64,
    statement_count: i64
) -> Stage1BodyCompileResult:
    mut header: Stage1WhileHeader = stage1_parse_while_header(
        source, tokens, cursor, body_indent
    )
    mut blocks: Stage1LoopBlockSet = stage1_append_loop_blocks(program, function_id)
    mut accepted: i64 = stage1_acceptance_and(header.accepted, blocks.accepted)
    mut condition_block_id: i64 = blocks.condition_block_id
    mut body_block_id: i64 = blocks.body_block_id
    mut neutral_block_id: i64 = blocks.neutral_block_id
    mut positive_block_id: i64 = blocks.positive_block_id
    mut exit_block_id: i64 = blocks.exit_block_id
    mut blocks_program: NativeIR = blocks.program
    mut terminator: NativeIRAppendResult = native_ir_set_block_terminator_for_function(
        blocks_program, function_id, preheader_block_id, 3
    )
    accepted = stage1_acceptance_and(accepted, terminator.accepted)
    mut preheader_jump: NativeIRAppendResult = native_ir_append_jump_for_function(
        terminator.program, function_id, preheader_block_id,
        condition_block_id
    )
    accepted = stage1_acceptance_and(accepted, preheader_jump.accepted)
    mut condition: Stage1LowerResult = stage1_lower_expression(
        header.condition_node,
        source,
        &header.tree,
        preheader_jump.program,
        function_id,
        condition_block_id,
        &symbol_name_starts,
        &symbol_name_ends,
        &symbol_value_ids,
        &symbol_memory_ids,
        &symbol_mutability_flags
    )
    accepted = stage1_acceptance_and(accepted, condition.accepted)
    mut condition_value_id: i64 = condition.value_id
    mut condition_program: NativeIR = condition.program
    mut branch: NativeIRAppendResult = native_ir_append_branch_for_function(
        condition_program,
        function_id,
        condition_block_id,
        condition_value_id,
        body_block_id,
        neutral_block_id,
        positive_block_id
    )
    accepted = stage1_acceptance_and(accepted, branch.accepted)
    mut loop_name_starts: vector<i64> = i64_vector_clone(&symbol_name_starts)
    mut loop_name_ends: vector<i64> = i64_vector_clone(&symbol_name_ends)
    mut loop_value_ids: vector<i64> = i64_vector_clone(&symbol_value_ids)
    mut loop_memory_ids: vector<i64> = i64_vector_clone(&symbol_memory_ids)
    mut loop_mutability_flags: vector<i64> = i64_vector_clone(&symbol_mutability_flags)
    mut body: Stage1BodyCompileResult = stage1_compile_body_sequence(
        source,
        tokens,
        header.body_start_cursor,
        header.body_end_cursor,
        branch.program,
        function_id,
        body_block_id,
        loop_name_starts,
        loop_name_ends,
        loop_value_ids,
        loop_memory_ids,
        loop_mutability_flags,
        body_indent + 4,
        1,
        0
    )
    accepted = stage1_acceptance_and(accepted, body.accepted)
    mut finished_body: Stage1LowerResult = stage1_finish_loop_body(
        function_id, body, condition_block_id
    )
    accepted = stage1_acceptance_and(accepted, finished_body.accepted)
    mut neutral_jump: NativeIRAppendResult = native_ir_append_jump_for_function(
        finished_body.program, function_id,
        neutral_block_id, exit_block_id
    )
    accepted = stage1_acceptance_and(accepted, neutral_jump.accepted)
    mut positive_jump: NativeIRAppendResult = native_ir_append_jump_for_function(
        neutral_jump.program, function_id,
        positive_block_id, exit_block_id
    )
    accepted = stage1_acceptance_and(accepted, positive_jump.accepted)
    match accepted == 1:
        -1:
            return stage1_compile_body_sequence(
                source,
                tokens,
                header.body_end_cursor,
                body_end_cursor,
                positive_jump.program,
                function_id,
                exit_block_id,
                symbol_name_starts,
                symbol_name_ends,
                symbol_value_ids,
                symbol_memory_ids,
                symbol_mutability_flags,
                body_indent,
                allow_fallthrough,
                statement_count + 1
            )
        0:
            return stage1_body_compile_failure(
                positive_jump.program, symbol_name_starts,
                symbol_name_ends, symbol_value_ids
            )
        1:
            return stage1_body_compile_failure(
                positive_jump.program, symbol_name_starts,
                symbol_name_ends, symbol_value_ids
            )

fn stage1_compile_discard_statement(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_memory_ids: vector<i64>,
    symbol_mutability_flags: vector<i64>,
    body_indent: i64,
    allow_fallthrough: i64,
    statement_count: i64
) -> Stage1BodyCompileResult:
    mut lowered: Stage1ExpressionLowerResult = stage1_lower_source_expression(
        source, tokens, cursor + 1, program, function_id, block_id,
        &symbol_name_starts, &symbol_name_ends, &symbol_value_ids,
        &symbol_memory_ids, &symbol_mutability_flags
    )
    mut accepted: i64 = lowered.accepted
    mut expression_end_cursor: i64 = lowered.next_cursor
    mut discarded_value_id: i64 = lowered.value_id
    mut lowered_program: NativeIR = lowered.program
    match accepted == 1:
        -1:
            match generic_token_kind(tokens, expression_end_cursor) == 6:
                -1:
                    return stage1_finish_keyword_expression_statement(
                        source, tokens, cursor, expression_end_cursor,
                        body_end_cursor, lowered_program, function_id, block_id,
                        symbol_name_starts, symbol_name_ends, symbol_value_ids,
                        symbol_memory_ids, symbol_mutability_flags, body_indent,
                        allow_fallthrough, statement_count, discarded_value_id
                    )
                0:
                    return stage1_body_compile_failure(
                        lowered_program, symbol_name_starts, symbol_name_ends,
                        symbol_value_ids
                    )
                1:
                    return stage1_body_compile_failure(
                        lowered_program, symbol_name_starts, symbol_name_ends,
                        symbol_value_ids
                    )
        0:
            return stage1_body_compile_failure(
                lowered_program, symbol_name_starts, symbol_name_ends,
                symbol_value_ids
            )
        1:
            return stage1_body_compile_failure(
                lowered_program, symbol_name_starts, symbol_name_ends,
                symbol_value_ids
            )

fn stage1_compile_body_sequence_non_assignment(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_memory_ids: vector<i64>,
    symbol_mutability_flags: vector<i64>,
    body_indent: i64,
    allow_fallthrough: i64,
    statement_count: i64
) -> Stage1BodyCompileResult:
    mut current_cursor: i64 = stage1_skip_body_newlines(tokens, cursor)
    match current_cursor < body_end_cursor:
        -1:
            match stage1_source_name_is_discard(
                source,
                generic_token_start(tokens, current_cursor),
                generic_token_end(tokens, current_cursor)
            ) == 1:
                -1:
                    return stage1_compile_discard_statement(
                        source, tokens, current_cursor, body_end_cursor, program,
                        function_id, block_id, symbol_name_starts, symbol_name_ends,
                        symbol_value_ids, symbol_memory_ids, symbol_mutability_flags,
                        body_indent, allow_fallthrough, statement_count
                    )
                0:
                    return stage1_compile_body_sequence_non_assignment_control(
                        source, tokens, cursor, body_end_cursor, program,
                        function_id, block_id, symbol_name_starts, symbol_name_ends,
                        symbol_value_ids, symbol_memory_ids, symbol_mutability_flags,
                        body_indent, allow_fallthrough, statement_count
                    )
                1:
                    return stage1_compile_body_sequence_non_assignment_control(
                        source, tokens, cursor, body_end_cursor, program,
                        function_id, block_id, symbol_name_starts, symbol_name_ends,
                        symbol_value_ids, symbol_memory_ids, symbol_mutability_flags,
                        body_indent, allow_fallthrough, statement_count
                    )
        0:
            return stage1_compile_body_sequence_non_assignment_control(
                source, tokens, cursor, body_end_cursor, program,
                function_id, block_id, symbol_name_starts, symbol_name_ends,
                symbol_value_ids, symbol_memory_ids, symbol_mutability_flags,
                body_indent, allow_fallthrough, statement_count
            )
        1:
            return stage1_compile_body_sequence_non_assignment_control(
                source, tokens, cursor, body_end_cursor, program,
                function_id, block_id, symbol_name_starts, symbol_name_ends,
                symbol_value_ids, symbol_memory_ids, symbol_mutability_flags,
                body_indent, allow_fallthrough, statement_count
            )

fn stage1_compile_body_sequence_non_assignment_control(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_memory_ids: vector<i64>,
    symbol_mutability_flags: vector<i64>,
    body_indent: i64,
    allow_fallthrough: i64,
    statement_count: i64
) -> Stage1BodyCompileResult:
    mut current_cursor: i64 = stage1_skip_body_newlines(tokens, cursor)
    match current_cursor == body_end_cursor:
        -1:
            return stage1_compile_body_sequence_non_assignment_plain(
                source, tokens, cursor, body_end_cursor, program,
                function_id, block_id, symbol_name_starts, symbol_name_ends,
                symbol_value_ids, symbol_memory_ids, symbol_mutability_flags,
                body_indent, allow_fallthrough, statement_count
            )
        0:
            match stage1_source_name_is_match(
                source,
                generic_token_start(tokens, current_cursor),
                generic_token_end(tokens, current_cursor)
            ) == 1:
                -1:
                    return stage1_compile_match_statement(
                        source, tokens, current_cursor, body_end_cursor,
                        program, function_id, block_id, symbol_name_starts,
                        symbol_name_ends, symbol_value_ids, symbol_memory_ids,
                        symbol_mutability_flags, body_indent,
                        allow_fallthrough, statement_count
                    )
                0:
                    match stage1_source_name_is_while(
                        source,
                        generic_token_start(tokens, current_cursor),
                        generic_token_end(tokens, current_cursor)
                    ) == 1:
                        -1:
                            return stage1_compile_while_statement(
                                source, tokens, current_cursor, body_end_cursor,
                                program, function_id, block_id, symbol_name_starts,
                                symbol_name_ends, symbol_value_ids, symbol_memory_ids,
                                symbol_mutability_flags, body_indent,
                                allow_fallthrough, statement_count
                            )
                        0:
                            return stage1_compile_body_sequence_non_assignment_plain(
                                source, tokens, cursor, body_end_cursor, program,
                                function_id, block_id, symbol_name_starts, symbol_name_ends,
                                symbol_value_ids, symbol_memory_ids, symbol_mutability_flags,
                                body_indent, allow_fallthrough, statement_count
                            )
                        1:
                            return stage1_compile_body_sequence_non_assignment_plain(
                                source, tokens, cursor, body_end_cursor, program,
                                function_id, block_id, symbol_name_starts, symbol_name_ends,
                                symbol_value_ids, symbol_memory_ids, symbol_mutability_flags,
                                body_indent, allow_fallthrough, statement_count
                            )
                1:
                    return stage1_compile_body_sequence_non_assignment_plain(
                        source, tokens, cursor, body_end_cursor, program,
                        function_id, block_id, symbol_name_starts, symbol_name_ends,
                        symbol_value_ids, symbol_memory_ids, symbol_mutability_flags,
                        body_indent, allow_fallthrough, statement_count
                    )
        1:
            return stage1_compile_body_sequence_non_assignment_plain(
                source, tokens, cursor, body_end_cursor, program,
                function_id, block_id, symbol_name_starts, symbol_name_ends,
                symbol_value_ids, symbol_memory_ids, symbol_mutability_flags,
                body_indent, allow_fallthrough, statement_count
            )

fn stage1_compile_body_sequence(
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64,
    body_end_cursor: i64,
    program: NativeIR,
    function_id: i64,
    block_id: i64,
    symbol_name_starts: vector<i64>,
    symbol_name_ends: vector<i64>,
    symbol_value_ids: vector<i64>,
    symbol_memory_ids: vector<i64>,
    symbol_mutability_flags: vector<i64>,
    body_indent: i64,
    allow_fallthrough: i64,
    statement_count: i64
) -> Stage1BodyCompileResult:
    mut current_cursor: i64 = stage1_skip_body_newlines(tokens, cursor)
    match current_cursor < body_end_cursor:
        -1:
            match generic_native_parser_program_indent(
                source, generic_token_start(tokens, current_cursor)
            ) == body_indent:
                -1:
                    match generic_token_kind(tokens, current_cursor) == 1:
                        -1:
                            match generic_token_kind(tokens, current_cursor + 1) == 161:
                                -1:
                                    return stage1_compile_assignment_statement(
                                        source,
                                        tokens,
                                        current_cursor,
                                        body_end_cursor,
                                        program,
                                        function_id,
                                        block_id,
                                        symbol_name_starts,
                                        symbol_name_ends,
                                        symbol_value_ids,
                                        symbol_memory_ids,
                                        symbol_mutability_flags,
                                        body_indent,
                                        allow_fallthrough,
                                        statement_count
                                    )
                                0:
                                    return stage1_compile_body_sequence_non_assignment(
                                        source, tokens, cursor, body_end_cursor, program,
                                        function_id, block_id, symbol_name_starts,
                                        symbol_name_ends, symbol_value_ids,
                                        symbol_memory_ids, symbol_mutability_flags,
                                        body_indent, allow_fallthrough, statement_count
                                    )
                                1:
                                    return stage1_compile_body_sequence_non_assignment(
                                        source, tokens, cursor, body_end_cursor, program,
                                        function_id, block_id, symbol_name_starts,
                                        symbol_name_ends, symbol_value_ids,
                                        symbol_memory_ids, symbol_mutability_flags,
                                        body_indent, allow_fallthrough, statement_count
                                    )
                        0:
                            return stage1_compile_body_sequence_non_assignment(
                                source, tokens, cursor, body_end_cursor, program,
                                function_id, block_id, symbol_name_starts,
                                symbol_name_ends, symbol_value_ids,
                                symbol_memory_ids, symbol_mutability_flags,
                                body_indent, allow_fallthrough, statement_count
                            )
                        1:
                            return stage1_compile_body_sequence_non_assignment(
                                source, tokens, cursor, body_end_cursor, program,
                                function_id, block_id, symbol_name_starts,
                                symbol_name_ends, symbol_value_ids,
                                symbol_memory_ids, symbol_mutability_flags,
                                body_indent, allow_fallthrough, statement_count
                            )
                0:
                    return stage1_compile_body_sequence_non_assignment(
                        source, tokens, cursor, body_end_cursor, program,
                        function_id, block_id, symbol_name_starts,
                        symbol_name_ends, symbol_value_ids,
                        symbol_memory_ids, symbol_mutability_flags,
                        body_indent, allow_fallthrough, statement_count
                    )
                1:
                    return stage1_compile_body_sequence_non_assignment(
                        source, tokens, cursor, body_end_cursor, program,
                        function_id, block_id, symbol_name_starts,
                        symbol_name_ends, symbol_value_ids,
                        symbol_memory_ids, symbol_mutability_flags,
                        body_indent, allow_fallthrough, statement_count
                    )
        0:
            return stage1_compile_body_sequence_non_assignment(
                source, tokens, cursor, body_end_cursor, program,
                function_id, block_id, symbol_name_starts,
                symbol_name_ends, symbol_value_ids,
                symbol_memory_ids, symbol_mutability_flags,
                body_indent, allow_fallthrough, statement_count
            )
        1:
            return stage1_compile_body_sequence_non_assignment(
                source, tokens, cursor, body_end_cursor, program,
                function_id, block_id, symbol_name_starts,
                symbol_name_ends, symbol_value_ids,
                symbol_memory_ids, symbol_mutability_flags,
                body_indent, allow_fallthrough, statement_count
            )

fn stage1_compile_registered_function(
    initial_program: NativeIR,
    source: &vector<i64>,
    tokens: &vector<i64>,
    expression_cursors: &vector<i64>,
    parameter_name_starts: &vector<i64>,
    parameter_name_ends: &vector<i64>,
    function_index: i64
) -> Stage1LowerResult:
    mut program: NativeIR = initial_program
    mut function_id: i64 = function_index
    mut block_append: NativeIRAppendResult = native_ir_append_block_for_function(
        program, function_id, function_id, 1
    )
    mut block_accepted: i64 = block_append.accepted
    match block_accepted == 1:
        -1:
            program = block_append.program
        0:
            return stage1_lower_preserved_failure(block_append.program)
        1:
            return stage1_lower_preserved_failure(block_append.program)
    mut expression_cursor: i64 = vector_get<i64>(expression_cursors, function_index)
    mut symbol_name_starts: vector<i64> = vector_new<i64>(64)
    mut symbol_name_ends: vector<i64> = vector_new<i64>(64)
    mut symbol_value_ids: vector<i64> = vector_new<i64>(64)
    mut symbol_memory_ids: vector<i64> = vector_new<i64>(64)
    mut symbol_mutability_flags: vector<i64> = vector_new<i64>(64)
    mut parameter_first: i64 = i64_vector_get(&program.function_parameter_first, function_index)
    mut parameter_count: i64 = i64_vector_get(&program.function_parameter_count, function_index)
    mut parameter_index: i64 = 0
    while parameter_index < parameter_count:
        discard vector_push<i64>(
            &mut symbol_name_starts,
            vector_get<i64>(parameter_name_starts, parameter_first + parameter_index)
        )
        discard vector_push<i64>(
            &mut symbol_name_ends,
            vector_get<i64>(parameter_name_ends, parameter_first + parameter_index)
        )
        discard vector_push<i64>(
            &mut symbol_value_ids,
            i64_vector_get(&program.parameter_value_ids, parameter_first + parameter_index)
        )
        discard vector_push<i64>(&mut symbol_memory_ids, -1)
        discard vector_push<i64>(&mut symbol_mutability_flags, 0)
        parameter_index = parameter_index + 1
    mut body_end_cursor: i64 = stage1_function_body_end(source, tokens, expression_cursor)
    match body_end_cursor >= 0:
        -1:
            discard 0
        0:
            return stage1_lower_preserved_failure(program)
        1:
            return stage1_lower_preserved_failure(program)
    mut body: Stage1BodyCompileResult = stage1_compile_body_sequence(
        source,
        tokens,
        expression_cursor,
        body_end_cursor,
        program,
        function_id,
        function_id,
        symbol_name_starts,
        symbol_name_ends,
        symbol_value_ids,
        symbol_memory_ids,
        symbol_mutability_flags,
        4,
        0,
        0
    )
    mut body_accepted: i64 = body.accepted
    mut lowered_value_id: i64 = body.return_value_id
    mut body_block_id: i64 = body.block_id
    match body_accepted == 1:
        -1:
            match lowered_value_id >= 0:
                -1:
                    program = body.program
                0:
                    return stage1_lower_preserved_failure(body.program)
                1:
                    return stage1_lower_preserved_failure(body.program)
        0:
            return Stage1LowerResult(
                program=body.program, value_id=body.block_id, accepted=0
            )
        1:
            return Stage1LowerResult(
                program=body.program, value_id=body.block_id, accepted=0
            )
    mut final_terminator: NativeIRAppendResult = native_ir_set_block_terminator_for_function(
        program, function_id, body_block_id, 1
    )
    mut returned: NativeIRAppendResult = native_ir_append_instruction_for_function(
        final_terminator.program,
        function_id,
        body_block_id,
        1,
        0,
        lowered_value_id,
        -1,
        -1
    )
    mut returned_accepted: i64 = returned.accepted
    match returned_accepted == 1:
        -1:
            return stage1_lower_from_append(returned)
        0:
            return stage1_lower_preserved_failure(returned.program)
        1:
            return stage1_lower_preserved_failure(returned.program)

fn stage1_compile_function_sequence(
    initial_program: NativeIR,
    source: &vector<i64>,
    tokens: &vector<i64>,
    expression_cursors: &vector<i64>,
    parameter_name_starts: &vector<i64>,
    parameter_name_ends: &vector<i64>,
    function_index: i64,
    function_count: i64
) -> Stage1LowerResult:
    mut program: NativeIR = initial_program
    match function_index < function_count:
        -1:
            mut lowered_function: Stage1LowerResult = stage1_compile_registered_function(
                program, source, tokens, expression_cursors,
                parameter_name_starts, parameter_name_ends, function_index
            )
            mut lowered_function_accepted: i64 = lowered_function.accepted
            match lowered_function_accepted == 1:
                -1:
                    return stage1_compile_function_sequence(
                        lowered_function.program,
                        source,
                        tokens,
                        expression_cursors,
                        parameter_name_starts,
                        parameter_name_ends,
                        function_index + 1,
                        function_count
                    )
                0:
                    return Stage1LowerResult(
                        program=lowered_function.program,
                        value_id=lowered_function.value_id,
                        accepted=0
                    )
                1:
                    return Stage1LowerResult(
                        program=lowered_function.program,
                        value_id=lowered_function.value_id,
                        accepted=0
                    )
        0:
            return Stage1LowerResult(program=program, value_id=-1, accepted=1)
        1:
            return Stage1LowerResult(program=program, value_id=-1, accepted=1)

fn stage1_function_scan_state(
    program: NativeIR,
    name_starts: vector<i64>,
    name_ends: vector<i64>,
    parameter_name_starts: vector<i64>,
    parameter_name_ends: vector<i64>,
    expression_cursors: vector<i64>,
    cursor: i64,
    function_count: i64,
    main_count: i64,
    accepted: i64,
    error_code: i64
) -> Stage1FunctionScanState:
    return Stage1FunctionScanState(
        program=program,
        name_starts=name_starts,
        name_ends=name_ends,
        parameter_name_starts=parameter_name_starts,
        parameter_name_ends=parameter_name_ends,
        expression_cursors=expression_cursors,
        cursor=cursor,
        function_count=function_count,
        main_count=main_count,
        accepted=accepted,
        error_code=error_code
    )

fn stage1_source_name_is_main(source: &vector<i64>, name_start: i64, name_end: i64) -> i64:
    match name_end - name_start == 4:
        -1:
            mut expected: vector<i64> = vector_new<i64>(4)
            discard vector_push<i64>(&mut expected, 109)
            discard vector_push<i64>(&mut expected, 97)
            discard vector_push<i64>(&mut expected, 105)
            discard vector_push<i64>(&mut expected, 110)
            mut matched: i64 = 1
            mut offset: i64 = 0
            while offset < 4:
                match vector_get<i64>(source, name_start + offset) == vector_get<i64>(&expected, offset):
                    -1:
                        discard 0
                    0:
                        matched = 0
                    1:
                        matched = 0
                offset = offset + 1
            return matched
        0:
            return 0
        1:
            return 0

fn stage1_intern_i64_vector_reference_type(
    program: NativeIR,
    mutability: i64
) -> Stage1InternedTypeResult:
    mut vector_type: NativeIRAppendResult = native_ir_intern_composite_type(
        program, 2, 0, 0, -1
    )
    match vector_type.accepted == 1:
        -1:
            mut vector_type_id: i64 = vector_type.value_id
            mut vector_program: NativeIR = vector_type.program
            mut reference_type: NativeIRAppendResult = native_ir_intern_composite_type(
                vector_program, 3, vector_type_id, mutability, -1
            )
            match reference_type.accepted == 1:
                -1:
                    return Stage1InternedTypeResult(
                        program=reference_type.program,
                        type_id=reference_type.value_id,
                        accepted=1
                    )
                0:
                    return Stage1InternedTypeResult(
                        program=reference_type.program, type_id=-1, accepted=0
                    )
                1:
                    return Stage1InternedTypeResult(
                        program=reference_type.program, type_id=-1, accepted=0
                    )
        0:
            return Stage1InternedTypeResult(
                program=vector_type.program, type_id=-1, accepted=0
            )
        1:
            return Stage1InternedTypeResult(
                program=vector_type.program, type_id=-1, accepted=0
            )

fn stage1_intern_parameter_type(
    program: NativeIR,
    type_code: i64
) -> Stage1InternedTypeResult:
    match type_code == 0:
        -1:
            return Stage1InternedTypeResult(program=program, type_id=0, accepted=1)
        0:
            match type_code == 1:
                -1:
                    return stage1_intern_i64_vector_reference_type(program, 0)
                0:
                    match type_code == 2:
                        -1:
                            return Stage1InternedTypeResult(
                                program=program, type_id=1, accepted=1
                            )
                        0:
                            match type_code == 3:
                                -1:
                                    return stage1_intern_i64_vector_reference_type(
                                        program, 1
                                    )
                                0:
                                    match type_code == 4:
                                        -1:
                                            mut vector_type: NativeIRAppendResult = native_ir_intern_composite_type(
                                                program, 2, 0, 0, -1
                                            )
                                            return Stage1InternedTypeResult(
                                                program=vector_type.program,
                                                type_id=vector_type.value_id,
                                                accepted=vector_type.accepted
                                            )
                                        0:
                                            return Stage1InternedTypeResult(
                                                program=program, type_id=-1, accepted=0
                                            )
                                        1:
                                            return Stage1InternedTypeResult(
                                                program=program, type_id=-1, accepted=0
                                            )
                                1:
                                    return Stage1InternedTypeResult(
                                        program=program, type_id=-1, accepted=0
                                    )
                        1:
                            return Stage1InternedTypeResult(
                                program=program, type_id=-1, accepted=0
                            )
                1:
                    return Stage1InternedTypeResult(program=program, type_id=-1, accepted=0)
        1:
            return Stage1InternedTypeResult(program=program, type_id=-1, accepted=0)

fn stage1_apply_result_type(
    program: NativeIR,
    function_id: i64,
    result_type_code: i64
) -> NativeIRAppendResult:
    match result_type_code == 0:
        -1:
            return NativeIRAppendResult(program=program, accepted=1, value_id=0)
        0:
            match result_type_code == 1:
                -1:
                    return native_ir_set_function_result_type(program, function_id, 1)
                0:
                    match result_type_code == 4:
                        -1:
                            mut vector_type: Stage1InternedTypeResult = stage1_intern_parameter_type(
                                program, result_type_code
                            )
                            match vector_type.accepted == 1:
                                -1:
                                    mut result_type_id: i64 = vector_type.type_id
                                    mut typed_program: NativeIR = vector_type.program
                                    return native_ir_set_function_result_type(
                                        typed_program,
                                        function_id,
                                        result_type_id
                                    )
                                0:
                                    return NativeIRAppendResult(
                                        program=vector_type.program,
                                        accepted=0,
                                        value_id=-1
                                    )
                                1:
                                    return NativeIRAppendResult(
                                        program=vector_type.program,
                                        accepted=0,
                                        value_id=-1
                                    )
                        0:
                            return NativeIRAppendResult(program=program, accepted=0, value_id=-1)
                        1:
                            return NativeIRAppendResult(program=program, accepted=0, value_id=-1)
                1:
                    return NativeIRAppendResult(program=program, accepted=0, value_id=-1)
        1:
            return NativeIRAppendResult(program=program, accepted=0, value_id=-1)

fn stage1_register_i64_vector_external(
    program: NativeIR,
    function_id: i64,
    name: &vector<i64>,
    reference_type_code: i64,
    parameter_count: i64,
    result_type_id: i64
) -> NativeIRAppendResult:
    mut reference_type: Stage1InternedTypeResult = stage1_intern_parameter_type(
        program, reference_type_code
    )
    match reference_type.accepted == 1:
        -1:
            mut reference_type_id: i64 = reference_type.type_id
            mut typed_program: NativeIR = reference_type.program
            mut external: NativeIRAppendResult = native_ir_append_external_function_source(
                typed_program,
                function_id,
                1,
                result_type_id,
                name,
                0,
                vector_len<i64>(name)
            )
            match external.accepted == 1:
                -1:
                    mut first_parameter: NativeIRAppendResult = native_ir_append_typed_parameter(
                        external.program, function_id, 0, reference_type_id
                    )
                    match first_parameter.accepted == 1:
                        -1:
                            match parameter_count == 1:
                                -1:
                                    return first_parameter
                                0:
                                    match parameter_count == 2:
                                        -1:
                                            return native_ir_append_typed_parameter(
                                                first_parameter.program,
                                                function_id,
                                                1,
                                                0
                                            )
                                        0:
                                            return NativeIRAppendResult(
                                                program=first_parameter.program,
                                                accepted=0,
                                                value_id=-1
                                            )
                                        1:
                                            return NativeIRAppendResult(
                                                program=first_parameter.program,
                                                accepted=0,
                                                value_id=-1
                                            )
                                1:
                                    return NativeIRAppendResult(
                                        program=first_parameter.program,
                                        accepted=0,
                                        value_id=-1
                                    )
                        0:
                            return first_parameter
                        1:
                            return first_parameter
                0:
                    return external
                1:
                    return external
        0:
            return NativeIRAppendResult(
                program=reference_type.program, accepted=0, value_id=-1
            )
        1:
            return NativeIRAppendResult(
                program=reference_type.program, accepted=0, value_id=-1
            )

fn stage1_register_i64_vector_get(program: NativeIR) -> NativeIRAppendResult:
    mut name: vector<i64> = vector_new<i64>(14)
    discard vector_push<i64>(&mut name, 105)
    discard vector_push<i64>(&mut name, 54)
    discard vector_push<i64>(&mut name, 52)
    discard vector_push<i64>(&mut name, 95)
    discard vector_push<i64>(&mut name, 118)
    discard vector_push<i64>(&mut name, 101)
    discard vector_push<i64>(&mut name, 99)
    discard vector_push<i64>(&mut name, 116)
    discard vector_push<i64>(&mut name, 111)
    discard vector_push<i64>(&mut name, 114)
    discard vector_push<i64>(&mut name, 95)
    discard vector_push<i64>(&mut name, 103)
    discard vector_push<i64>(&mut name, 101)
    discard vector_push<i64>(&mut name, 116)
    return stage1_register_i64_vector_external(program, 1000, &name, 1, 2, 0)

fn stage1_register_i64_vector_len(program: NativeIR) -> NativeIRAppendResult:
    mut name: vector<i64> = vector_new<i64>(14)
    discard vector_push<i64>(&mut name, 105)
    discard vector_push<i64>(&mut name, 54)
    discard vector_push<i64>(&mut name, 52)
    discard vector_push<i64>(&mut name, 95)
    discard vector_push<i64>(&mut name, 118)
    discard vector_push<i64>(&mut name, 101)
    discard vector_push<i64>(&mut name, 99)
    discard vector_push<i64>(&mut name, 116)
    discard vector_push<i64>(&mut name, 111)
    discard vector_push<i64>(&mut name, 114)
    discard vector_push<i64>(&mut name, 95)
    discard vector_push<i64>(&mut name, 108)
    discard vector_push<i64>(&mut name, 101)
    discard vector_push<i64>(&mut name, 110)
    return stage1_register_i64_vector_external(program, 1001, &name, 1, 1, 0)

fn stage1_register_i64_vector_push(program: NativeIR) -> NativeIRAppendResult:
    mut name: vector<i64> = vector_new<i64>(15)
    discard vector_push<i64>(&mut name, 105)
    discard vector_push<i64>(&mut name, 54)
    discard vector_push<i64>(&mut name, 52)
    discard vector_push<i64>(&mut name, 95)
    discard vector_push<i64>(&mut name, 118)
    discard vector_push<i64>(&mut name, 101)
    discard vector_push<i64>(&mut name, 99)
    discard vector_push<i64>(&mut name, 116)
    discard vector_push<i64>(&mut name, 111)
    discard vector_push<i64>(&mut name, 114)
    discard vector_push<i64>(&mut name, 95)
    discard vector_push<i64>(&mut name, 112)
    discard vector_push<i64>(&mut name, 117)
    discard vector_push<i64>(&mut name, 115)
    discard vector_push<i64>(&mut name, 104)
    mut tryte_type: NativeIRAppendResult = native_ir_intern_tryte_type(program)
    match tryte_type.accepted == 1:
        -1:
            mut tryte_type_id: i64 = tryte_type.value_id
            mut tryte_program: NativeIR = tryte_type.program
            return stage1_register_i64_vector_external(
                tryte_program, 1002, &name, 3, 2, tryte_type_id
            )
        0:
            return tryte_type
        1:
            return tryte_type

fn stage1_register_i64_vector_new(program: NativeIR) -> NativeIRAppendResult:
    mut name: vector<i64> = vector_new<i64>(14)
    discard vector_push<i64>(&mut name, 105)
    discard vector_push<i64>(&mut name, 54)
    discard vector_push<i64>(&mut name, 52)
    discard vector_push<i64>(&mut name, 95)
    discard vector_push<i64>(&mut name, 118)
    discard vector_push<i64>(&mut name, 101)
    discard vector_push<i64>(&mut name, 99)
    discard vector_push<i64>(&mut name, 116)
    discard vector_push<i64>(&mut name, 111)
    discard vector_push<i64>(&mut name, 114)
    discard vector_push<i64>(&mut name, 95)
    discard vector_push<i64>(&mut name, 110)
    discard vector_push<i64>(&mut name, 101)
    discard vector_push<i64>(&mut name, 119)
    mut vector_type: NativeIRAppendResult = native_ir_intern_composite_type(
        program, 2, 0, 0, -1
    )
    match vector_type.accepted == 1:
        -1:
            mut vector_type_id: i64 = vector_type.value_id
            mut vector_program: NativeIR = vector_type.program
            mut external: NativeIRAppendResult = native_ir_append_external_function_source(
                vector_program, 1003, 1, vector_type_id,
                &name, 0, vector_len<i64>(&name)
            )
            match external.accepted == 1:
                -1:
                    return native_ir_append_typed_parameter(
                        external.program, 1003, 0, 0
                    )
                0:
                    return external
                1:
                    return external
        0:
            return vector_type
        1:
            return vector_type

fn stage1_register_parameters(
    program: NativeIR,
    function_id: i64,
    parameter_index: i64,
    parameter_name_starts: &vector<i64>,
    parameter_name_ends: &vector<i64>,
    parameter_type_codes: &vector<i64>,
    registered_name_starts: vector<i64>,
    registered_name_ends: vector<i64>
) -> Stage1ParameterRegistrationResult:
    match parameter_index < vector_len<i64>(parameter_name_starts):
        -1:
            mut interned_type: Stage1InternedTypeResult = stage1_intern_parameter_type(
                program, vector_get<i64>(parameter_type_codes, parameter_index)
            )
            match interned_type.accepted == 1:
                -1:
                    mut interned_type_id: i64 = interned_type.type_id
                    mut interned_program: NativeIR = interned_type.program
                    mut appended: NativeIRAppendResult = native_ir_append_typed_parameter(
                        interned_program,
                        function_id,
                        parameter_index,
                        interned_type_id
                    )
                    match appended.accepted == 1:
                        -1:
                            discard vector_push<i64>(
                                &mut registered_name_starts,
                                vector_get<i64>(parameter_name_starts, parameter_index)
                            )
                            discard vector_push<i64>(
                                &mut registered_name_ends,
                                vector_get<i64>(parameter_name_ends, parameter_index)
                            )
                            return stage1_register_parameters(
                                appended.program,
                                function_id,
                                parameter_index + 1,
                                parameter_name_starts,
                                parameter_name_ends,
                                parameter_type_codes,
                                registered_name_starts,
                                registered_name_ends
                            )
                        0:
                            return Stage1ParameterRegistrationResult(
                                program=appended.program,
                                name_starts=registered_name_starts,
                                name_ends=registered_name_ends,
                                accepted=0
                            )
                        1:
                            return Stage1ParameterRegistrationResult(
                                program=appended.program,
                                name_starts=registered_name_starts,
                                name_ends=registered_name_ends,
                                accepted=0
                            )
                0:
                    return Stage1ParameterRegistrationResult(
                        program=interned_type.program,
                        name_starts=registered_name_starts,
                        name_ends=registered_name_ends,
                        accepted=0
                    )
                1:
                    return Stage1ParameterRegistrationResult(
                        program=interned_type.program,
                        name_starts=registered_name_starts,
                        name_ends=registered_name_ends,
                        accepted=0
                    )
        0:
            return Stage1ParameterRegistrationResult(
                program=program,
                name_starts=registered_name_starts,
                name_ends=registered_name_ends,
                accepted=1
            )
        1:
            return Stage1ParameterRegistrationResult(
                program=program,
                name_starts=registered_name_starts,
                name_ends=registered_name_ends,
                accepted=1
            )

fn stage1_register_function_at(
    initial_state: Stage1FunctionScanState,
    source: &vector<i64>,
    tokens: &vector<i64>,
    cursor: i64
) -> Stage1FunctionScanState:
    mut name_starts: vector<i64> = i64_vector_clone(&initial_state.name_starts)
    mut name_ends: vector<i64> = i64_vector_clone(&initial_state.name_ends)
    mut parameter_name_starts: vector<i64> = i64_vector_clone(&initial_state.parameter_name_starts)
    mut parameter_name_ends: vector<i64> = i64_vector_clone(&initial_state.parameter_name_ends)
    mut expression_cursors: vector<i64> = i64_vector_clone(&initial_state.expression_cursors)
    mut function_count: i64 = initial_state.function_count
    mut main_count: i64 = initial_state.main_count
    mut program: NativeIR = initial_state.program
    mut header: Stage1FunctionHeader = stage1_parse_function_header(source, tokens, cursor)
    mut header_accepted: i64 = header.accepted
    match header_accepted == 1:
        -1:
            match function_count < 16:
                -1:
                    mut duplicate_index: i64 = 0
                    while duplicate_index < function_count:
                        match stage1_source_spans_equal(
                            source,
                            header.name_start,
                            header.name_end,
                            vector_get<i64>(&name_starts, duplicate_index),
                            vector_get<i64>(&name_ends, duplicate_index)
                        ):
                            -1:
                                return stage1_function_scan_state(
                                    native_ir_empty(), name_starts, name_ends,
                                    parameter_name_starts, parameter_name_ends, expression_cursors,
                                    cursor, function_count, main_count, 0, 22
                                )
                            0:
                                discard 0
                            1:
                                discard 0
                        duplicate_index = duplicate_index + 1
                    match stage1_source_name_is_main(source, header.name_start, header.name_end) == 1:
                        -1:
                            main_count = main_count + 1
                        0:
                            discard 0
                        1:
                            discard 0
                    mut function_append: NativeIRAppendResult = native_ir_append_function_source(
                        program, function_count, 1, source, header.name_start, header.name_end
                    )
                    mut append_accepted: i64 = function_append.accepted
                    match append_accepted == 1:
                        -1:
                            mut typed_function: NativeIRAppendResult = stage1_apply_result_type(
                                function_append.program, function_count, header.result_type_code
                            )
                            mut registered_parameters: Stage1ParameterRegistrationResult = stage1_register_parameters(
                                typed_function.program,
                                function_count,
                                0,
                                &header.parameter_name_starts,
                                &header.parameter_name_ends,
                                &header.parameter_type_codes,
                                parameter_name_starts,
                                parameter_name_ends
                            )
                            mut parameters_accepted: i64 = registered_parameters.accepted
                            mut registered_parameter_name_starts: vector<i64> = i64_vector_clone(
                                &registered_parameters.name_starts
                            )
                            mut registered_parameter_name_ends: vector<i64> = i64_vector_clone(
                                &registered_parameters.name_ends
                            )
                            match parameters_accepted == 1:
                                -1:
                                    program = registered_parameters.program
                                    parameter_name_starts = registered_parameter_name_starts
                                    parameter_name_ends = registered_parameter_name_ends
                                0:
                                    return stage1_function_scan_state(
                                        native_ir_empty(), name_starts, name_ends,
                                        registered_parameter_name_starts,
                                        registered_parameter_name_ends, expression_cursors,
                                        cursor, function_count, main_count, 0, 23
                                    )
                                1:
                                    return stage1_function_scan_state(
                                        native_ir_empty(), name_starts, name_ends,
                                        registered_parameter_name_starts,
                                        registered_parameter_name_ends, expression_cursors,
                                        cursor, function_count, main_count, 0, 23
                                    )
                            discard vector_push<i64>(&mut name_starts, header.name_start)
                            discard vector_push<i64>(&mut name_ends, header.name_end)
                            discard vector_push<i64>(&mut expression_cursors, header.expression_cursor)
                            function_count = function_count + 1
                            return stage1_function_scan_state(
                                program, name_starts, name_ends,
                                parameter_name_starts, parameter_name_ends, expression_cursors,
                                header.next_cursor, function_count, main_count, 1, 0
                            )
                        0:
                            return stage1_function_scan_state(
                                native_ir_empty(), name_starts, name_ends,
                                parameter_name_starts, parameter_name_ends, expression_cursors,
                                cursor, function_count, main_count, 0, 23
                            )
                        1:
                            return stage1_function_scan_state(
                                native_ir_empty(), name_starts, name_ends,
                                parameter_name_starts, parameter_name_ends, expression_cursors,
                                cursor, function_count, main_count, 0, 23
                            )
                0:
                    return stage1_function_scan_state(
                        native_ir_empty(), name_starts, name_ends,
                        parameter_name_starts, parameter_name_ends, expression_cursors,
                        cursor, function_count, main_count, 0, 24
                    )
                1:
                    return stage1_function_scan_state(
                        native_ir_empty(), name_starts, name_ends,
                        parameter_name_starts, parameter_name_ends, expression_cursors,
                        cursor, function_count, main_count, 0, 24
                    )
        0:
            return stage1_function_scan_state(
                native_ir_empty(), name_starts, name_ends,
                parameter_name_starts, parameter_name_ends, expression_cursors,
                cursor, function_count, main_count, 0, 25
            )
        1:
            return stage1_function_scan_state(
                native_ir_empty(), name_starts, name_ends,
                parameter_name_starts, parameter_name_ends, expression_cursors,
                cursor, function_count, main_count, 0, 25
            )

fn stage1_scan_non_newline_core(
    initial_state: Stage1FunctionScanState,
    source: &vector<i64>,
    tokens: &vector<i64>,
    token_count: i64,
    cursor: i64
) -> Stage1FunctionScanState:
    mut name_starts: vector<i64> = i64_vector_clone(&initial_state.name_starts)
    mut name_ends: vector<i64> = i64_vector_clone(&initial_state.name_ends)
    mut parameter_name_starts: vector<i64> = i64_vector_clone(&initial_state.parameter_name_starts)
    mut parameter_name_ends: vector<i64> = i64_vector_clone(&initial_state.parameter_name_ends)
    mut expression_cursors: vector<i64> = i64_vector_clone(&initial_state.expression_cursors)
    mut function_count: i64 = initial_state.function_count
    mut main_count: i64 = initial_state.main_count
    mut program: NativeIR = initial_state.program
    match generic_token_kind(tokens, cursor) == 0:
        -1:
            return stage1_function_scan_state(
                program, name_starts, name_ends,
                parameter_name_starts, parameter_name_ends, expression_cursors,
                token_count, function_count, main_count, 1, 0
            )
        0:
            mut state: Stage1FunctionScanState = stage1_function_scan_state(
                program, name_starts, name_ends,
                parameter_name_starts, parameter_name_ends, expression_cursors,
                cursor, function_count, main_count, 1, 0
            )
            mut registered: Stage1FunctionScanState = stage1_register_function_at(
                state, source, tokens, cursor
            )
            mut registered_accepted: i64 = registered.accepted
            mut next_cursor: i64 = registered.cursor
            match registered_accepted == 1:
                -1:
                    return stage1_scan_functions(registered, source, tokens, token_count, next_cursor)
                0:
                    return registered
                1:
                    return registered
        1:
            mut state: Stage1FunctionScanState = stage1_function_scan_state(
                program, name_starts, name_ends,
                parameter_name_starts, parameter_name_ends, expression_cursors,
                cursor, function_count, main_count, 1, 0
            )
            mut registered: Stage1FunctionScanState = stage1_register_function_at(
                state, source, tokens, cursor
            )
            mut registered_accepted: i64 = registered.accepted
            mut next_cursor: i64 = registered.cursor
            match registered_accepted == 1:
                -1:
                    return stage1_scan_functions(registered, source, tokens, token_count, next_cursor)
                0:
                    return registered
                1:
                    return registered

fn stage1_source_name_is_export(
    source: &vector<i64>, name_start: i64, name_end: i64
) -> i64:
    mut expected: vector<i64> = vector_new<i64>(6)
    discard vector_push<i64>(&mut expected, 101)
    discard vector_push<i64>(&mut expected, 120)
    discard vector_push<i64>(&mut expected, 112)
    discard vector_push<i64>(&mut expected, 111)
    discard vector_push<i64>(&mut expected, 114)
    discard vector_push<i64>(&mut expected, 116)
    return stage1_source_span_matches_bytes(source, name_start, name_end, &expected)

fn stage1_scan_non_newline(
    initial_state: Stage1FunctionScanState,
    source: &vector<i64>,
    tokens: &vector<i64>,
    token_count: i64,
    cursor: i64
) -> Stage1FunctionScanState:
    match stage1_source_name_is_export(
        source,
        generic_token_start(tokens, cursor),
        generic_token_end(tokens, cursor)
    ) == 1:
        -1:
            return stage1_scan_functions(
                initial_state, source, tokens, token_count, cursor + 1
            )
        0:
            return stage1_scan_non_newline_core(
                initial_state, source, tokens, token_count, cursor
            )
        1:
            return stage1_scan_non_newline_core(
                initial_state, source, tokens, token_count, cursor
            )

fn stage1_scan_functions(
    initial_state: Stage1FunctionScanState,
    source: &vector<i64>,
    tokens: &vector<i64>,
    token_count: i64,
    start_cursor: i64
) -> Stage1FunctionScanState:
    mut name_starts: vector<i64> = i64_vector_clone(&initial_state.name_starts)
    mut name_ends: vector<i64> = i64_vector_clone(&initial_state.name_ends)
    mut parameter_name_starts: vector<i64> = i64_vector_clone(&initial_state.parameter_name_starts)
    mut parameter_name_ends: vector<i64> = i64_vector_clone(&initial_state.parameter_name_ends)
    mut expression_cursors: vector<i64> = i64_vector_clone(&initial_state.expression_cursors)
    mut function_count: i64 = initial_state.function_count
    mut main_count: i64 = initial_state.main_count
    mut cursor: i64 = start_cursor
    mut program: NativeIR = initial_state.program
    while cursor < token_count:
        match generic_token_kind(tokens, cursor) == 6:
            -1:
                cursor = cursor + 1
            0:
                mut state: Stage1FunctionScanState = stage1_function_scan_state(
                    program, name_starts, name_ends,
                    parameter_name_starts, parameter_name_ends, expression_cursors,
                    cursor, function_count, main_count, 1, 0
                )
                return stage1_scan_non_newline(state, source, tokens, token_count, cursor)
            1:
                mut state: Stage1FunctionScanState = stage1_function_scan_state(
                    program, name_starts, name_ends,
                    parameter_name_starts, parameter_name_ends, expression_cursors,
                    cursor, function_count, main_count, 1, 0
                )
                return stage1_scan_non_newline(state, source, tokens, token_count, cursor)
    return stage1_function_scan_state(
        program, name_starts, name_ends,
        parameter_name_starts, parameter_name_ends, expression_cursors,
        token_count, function_count, main_count, 1, 0
    )

export fn stage1_compile(source: vector<i64>) -> Stage1CompileResult:
    mut source_length: i64 = vector_len<i64>(&source)
    match source_length <= 4096:
        -1:
            discard 0
        0:
            return stage1_empty_result(1, 1)
        1:
            return stage1_empty_result(1, 1)
    mut tokens: vector<i64> = generic_lexer_scan(&source)
    mut token_count: i64 = generic_token_count(&tokens)
    match token_count <= 1024:
        -1:
            discard 0
        0:
            return stage1_empty_result(2, 2)
        1:
            return stage1_empty_result(2, 2)
    mut initial_scan_state: Stage1FunctionScanState = stage1_function_scan_state(
        native_ir_empty(),
        vector_new<i64>(16),
        vector_new<i64>(16),
        vector_new<i64>(64),
        vector_new<i64>(64),
        vector_new<i64>(16),
        0,
        0,
        0,
        1,
        0
    )
    mut registered: Stage1FunctionScanState = stage1_scan_functions(
        initial_scan_state, &source, &tokens, token_count, 0
    )
    mut scan_accepted: i64 = registered.accepted
    mut scan_error_code: i64 = registered.error_code
    mut function_count: i64 = registered.function_count
    mut main_count: i64 = registered.main_count
    mut function_expression_cursors: vector<i64> = i64_vector_clone(&registered.expression_cursors)
    mut function_parameter_name_starts: vector<i64> = i64_vector_clone(&registered.parameter_name_starts)
    mut function_parameter_name_ends: vector<i64> = i64_vector_clone(&registered.parameter_name_ends)
    match scan_accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, scan_error_code)
        1:
            return stage1_empty_result(3, scan_error_code)
    mut program: NativeIR = registered.program
    mut builtin_registration: NativeIRAppendResult = stage1_register_i64_vector_get(program)
    match builtin_registration.accepted == 1:
        -1:
            program = builtin_registration.program
        0:
            return stage1_empty_result(3, 29)
        1:
            return stage1_empty_result(3, 29)
    mut vector_len_registration: NativeIRAppendResult = stage1_register_i64_vector_len(
        program
    )
    match vector_len_registration.accepted == 1:
        -1:
            program = vector_len_registration.program
        0:
            return stage1_empty_result(3, 30)
        1:
            return stage1_empty_result(3, 30)
    mut vector_push_registration: NativeIRAppendResult = stage1_register_i64_vector_push(
        program
    )
    match vector_push_registration.accepted == 1:
        -1:
            program = vector_push_registration.program
        0:
            return stage1_empty_result(3, 31)
        1:
            return stage1_empty_result(3, 31)
    mut vector_new_registration: NativeIRAppendResult = stage1_register_i64_vector_new(
        program
    )
    match vector_new_registration.accepted == 1:
        -1:
            program = vector_new_registration.program
        0:
            return stage1_empty_result(3, 32)
        1:
            return stage1_empty_result(3, 32)
    match function_count > 0:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 27)
        1:
            return stage1_empty_result(3, 27)
    match main_count == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(3, 28)
        1:
            return stage1_empty_result(3, 28)
    mut lowered_sequence: Stage1LowerResult = stage1_compile_function_sequence(
        program, &source, &tokens, &function_expression_cursors,
        &function_parameter_name_starts, &function_parameter_name_ends,
        0, function_count
    )
    mut sequence_accepted: i64 = lowered_sequence.accepted
    match sequence_accepted == 1:
        -1:
            program = lowered_sequence.program
        0:
            return stage1_empty_result(4, 1000 + lowered_sequence.value_id)
        1:
            return stage1_empty_result(4, 1000 + lowered_sequence.value_id)
    program = native_ir_order_blocks_by_instruction_first(program)
    mut verified: NativeIRVerifiedResult = verify_program(program)
    mut verification: NativeVerification = verified.verification
    program = verified.program
    match verification.accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(5, verification.diagnostic_code)
        1:
            return stage1_empty_result(5, verification.diagnostic_code)
    mut instruction_count: i64 = i64_vector_len(&program.instruction_ids)
    mut value_count: i64 = i64_vector_len(&program.value_ids)
    mut output: vector<i64> = vector_new<i64>(16384)
    mut emission_accepted: i64 = stage1_emit_native_program(program, &mut output)
    match emission_accepted == 1:
        -1:
            discard 0
        0:
            return stage1_empty_result(6, 22)
        1:
            return stage1_empty_result(6, 22)
    mut sink: OutputSinkState = output_sink_new(16384)
    sink = output_sink_append_bytes(sink, output)
    match sink.failed == 0:
        -1:
            discard 0
        0:
            return stage1_empty_result(6, 20)
        1:
            return stage1_empty_result(6, 20)
    sink = output_sink_commit(sink)
    match sink.failed == 0:
        -1:
            discard 0
        0:
            return stage1_empty_result(6, 21)
        1:
            return stage1_empty_result(6, 21)
    return stage1_result(1, 0, 0, sink.buffer, instruction_count, value_count, verification)
