fn add_mod(left: tryte, amount: tryte) -> tryte:
    mut result: tryte = left
    match result <=> 301 - amount:
        -1:
            result += amount
        0:
            result = result - (301 - amount)
        1:
            result = result - (301 - amount)
    return result

fn fold_identity(value: tryte) -> tryte:
    mut result: tryte = value
    while result < 0:
        result += 181
    while result > 180:
        result = result - 181
    return result

fn admit_bootstrap(
    artifact_identity: tryte,
    assembly_identity: tryte,
    target_id: tryte
) -> tryte:
    mut result: tryte = add_mod(artifact_identity, assembly_identity)
    result = add_mod(result, target_id)
    result = add_mod(result, 297)
    return fold_identity(result)
