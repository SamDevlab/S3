module selfhost.assembly.assembly_frontend

from bounded_text_types import BoundedText
from selfhost.assembly.assembly_parser import initial_assembly_parser_state
from selfhost.assembly.assembly_parser import next_assembly_parser_event
from selfhost.assembly.frontend_types import AssemblyFrontendResult
from selfhost.assembly.frontend_types import AssemblyFrontendSummary
from selfhost.assembly.parser_types import AssemblyParserResult
from selfhost.assembly.parser_types import AssemblyParserState

fn scan_frontend(text: BoundedText, input_state: AssemblyParserState, ended: tryte) -> AssemblyFrontendResult:
    result: AssemblyParserResult = next_assembly_parser_event(text, input_state)
    match result:
        AssemblyParserResult.Event(event, state):
            match event.kind <=> 7:
                0:
                    return scan_frontend(text, state, 1)
                -1:
                    return scan_frontend(text, state, ended)
                1:
                    return scan_frontend(text, state, ended)
        AssemblyParserResult.End(state):
            return AssemblyFrontendResult.Summary(summary=AssemblyFrontendSummary(version=state.version, function_count=state.function_count, declaration_count=state.declaration_count, block_count=state.block_count, call_count=state.call_count, return_count=state.return_count, max_result_width=state.max_result_width, ended=ended))
        AssemblyParserResult.Error(error, state):
            return AssemblyFrontendResult.Error(error=error)

export fn analyze_bounded_assembly(text: BoundedText) -> AssemblyFrontendResult:
    return scan_frontend(text, initial_assembly_parser_state(), 0)
