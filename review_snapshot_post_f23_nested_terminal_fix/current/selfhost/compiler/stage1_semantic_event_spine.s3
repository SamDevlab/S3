                        next_id += 2
                    0:
                        discard 0
                    1:
                        discard 0
                mut immutable_info: i64 = parse_immutable_literal(first, stop, 1)
                match immutable_info > 0:
                    -1:
                        mut parsed_type: i64 = immutable_info / 1000000000000000
                        mut remainder: i64 = immutable_info - parsed_type * 1000000000000000
                        mut name_start: i64 = remainder / 1000000000
                        remainder = remainder - name_start * 1000000000
                        mut name_length: i64 = remainder / 1000000
                        match same_span(name_start, name_start + name_length, target_start, target_stop):
                            -1:
                                return next_id + core_immutable_instruction_count(first, stop, immutable_info) - 1
                            0:
                                discard 0
                            1:
                                discard 0
                        next_id += core_immutable_instruction_count(first, stop, immutable_info)
                    0:
                        discard 0
                    1:
                        discard 0
            1:
                discard 0
        cursor = stop + 1
    return -1

fn mutable_storage_count_before(start: i64, end: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut cursor: i64 = start
    mut storage_id: i64 = 0
    while cursor < end:
        mut stop: i64 = line_end(cursor, length)
        match stop > end:
            -1:
                stop = end
            0:
