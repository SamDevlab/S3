            discard emit_v3_i_block(inner_negative_store_id, function_id, 15, ordinal + 59, 1, 1, 0, -1, relational_lane_result(nested_operator_start, -1))
            discard emit_v3_r(inner_negative_store_id, 0, inner_negative_result_value)
            discard emit_v3_i_block(inner_negative_jump_id, function_id, 15, ordinal + 60, 16, 0, 2, inner_temp_storage_id, -1)
            discard emit_v3_o(inner_negative_jump_id, 0, inner_negative_index_value)
            discard emit_v3_o(inner_negative_jump_id, 1, inner_negative_result_value)
            discard emit_v3_i_block(inner_negative_terminator_id, function_id, 15, ordinal + 61, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(inner_negative_terminator_id, 18)
            discard emit_v3_i_block(inner_neutral_const_id, function_id, 16, ordinal + 62, 1, 1, 0, -1, 0)
            discard emit_v3_r(inner_neutral_const_id, 0, inner_neutral_index_value)
            discard emit_v3_i_block(inner_neutral_store_id, function_id, 16, ordinal + 63, 1, 1, 0, -1, relational_lane_result(nested_operator_start, 0))
            discard emit_v3_r(inner_neutral_store_id, 0, inner_neutral_result_value)
            discard emit_v3_i_block(inner_neutral_jump_id, function_id, 16, ordinal + 64, 16, 0, 2, inner_temp_storage_id, -1)
