            1:
                discard 0
        mut first: i64 = first_non_space(cursor, stop)
        mut array_info: i64 = parse_mut_array_initializer(first, stop)
        match array_info > 0:
            -1:
                storage_id += 1
            0:
                discard 0
            1:
                discard 0
        mut mutable_info: i64 = parse_mut(first, stop)
        match mutable_info > 0:
            -1:
                storage_id += 1
            0:
                mut identifier_info: i64 = parse_mut_identifier_initializer(first, stop)
                match identifier_info > 0:
                    -1:
                        storage_id += 1
                    0:
                        match parse_mut_compound_product_literal(first, stop) > 0:
                            -1:
                                storage_id += 1
                            0:
                                discard 0
                            1:
                                discard 0
                        match parse_mut_binary_literal(first, stop) > 0:
                            -1:
                                storage_id += 1
                            0:
                                discard 0
                            1:
                                discard 0
                        match parse_mut_compound_product_identifier(first, stop) > 0:
                            -1:
                                storage_id += 1
                            0:
                                match parse_mut_binary_identifier(first, stop) > 0:
                                    -1:
                                        storage_id += 1
                                    0:
                                        match parse_mut_call_binding(first, stop) > 0:
                                            -1:
                                                storage_id += 1
                                            0:
                                                discard 0
                                            1:
                                                discard 0
                                        match parse_mut_additive(first, stop) > 0:
                                            -1:
                                                storage_id += 1
                                            0:
                                                discard 0
                                            1:
                                                discard 0
                                    1:
                                        discard 0
                            1:
                                discard 0
                    1:
                        discard 0
            1:
                discard 0
        cursor = stop + 1
    return storage_id

fn find_mutable_storage_id(start: i64, end: i64, target_start: i64, target_stop: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut cursor: i64 = start
    mut storage_id: i64 = 0
    mut found: i64 = -1
    while cursor < end:
        mut stop: i64 = line_end(cursor, length)
        match stop > end:
            -1:
                stop = end
            0:
                discard 0
            1:
                discard 0
        mut first: i64 = first_non_space(cursor, stop)
        mut array_packed: i64 = parse_mut_array_initializer(first, stop)
        match array_packed > 0:
            -1:
                mut array_type: i64 = array_packed / 1000000000000000
                mut array_remainder: i64 = array_packed - array_type * 1000000000000000
                mut array_extent: i64 = array_remainder / 1000000000000
                array_remainder = array_remainder - array_extent * 1000000000000
                mut array_name_start: i64 = array_remainder / 1000000
                mut array_name_length: i64 = array_remainder - array_name_start * 1000000
                match same_span(array_name_start, array_name_start + array_name_length, target_start, target_stop):
                    -1:
                        found = storage_id
                    0:
                        discard 0
                    1:
                        discard 0
                storage_id += 1
            0:
                discard 0
            1:
                discard 0
        mut packed: i64 = parse_mut(first, stop)
        match packed == 0:
            -1:
                packed = parse_mut_compound_product_literal(first, stop)
                match packed == 0:
                    -1:
                        packed = parse_mut_binary_literal(first, stop)
                        match packed == 0:
                            -1:
                                packed = parse_mut_compound_product_identifier(first, stop)
                                match packed == 0:
                                    -1:
                                        packed = parse_mut_binary_identifier(first, stop)
                                        match packed == 0:
                                            -1:
                                                packed = parse_mut_identifier_initializer(first, stop)
                                            0:
                                                discard 0
                                            1:
                                                discard 0
                                    0:
                                        discard 0
                                    1:
                                        discard 0
                            0:
                                discard 0
                            1:
                                discard 0
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        mut call_binding: i64 = parse_mut_call_binding(first, stop)
        match call_binding > 0:
            -1:
                mut call_binding_type: i64 = call_binding / 1000000000000
                mut call_binding_remainder: i64 = call_binding - call_binding_type * 1000000000000
                mut call_binding_name_start: i64 = call_binding_remainder / 1000000
                mut call_binding_name_stop: i64 = call_binding_remainder - call_binding_name_start * 1000000
                match same_span(call_binding_name_start, call_binding_name_stop, target_start, target_stop):
                    -1:
                        found = storage_id
                    0:
                        discard 0
                    1:
                        discard 0
                storage_id += 1
            0:
                discard 0
            1:
                discard 0
        mut additive_binding: i64 = parse_mut_additive(first, stop)
        match additive_binding > 0:
            -1:
                mut additive_type: i64 = additive_binding / 1000000000000000
                mut additive_remainder: i64 = additive_binding - additive_type * 1000000000000000
                mut additive_name_start: i64 = additive_remainder / 1000000000
                additive_remainder = additive_remainder - additive_name_start * 1000000000
                mut additive_name_length: i64 = additive_remainder / 1000000
                match same_span(additive_name_start, additive_name_start + additive_name_length, target_start, target_stop):
                    -1:
                        found = storage_id
                    0:
                        discard 0
                    1:
                        discard 0
                storage_id += 1
            0:
                discard 0
            1:
                discard 0
        match packed > 0:
            -1:
                mut packed_type: i64 = packed / 1000000000000000
                mut remainder: i64 = packed - packed_type * 1000000000000000
                mut name_start: i64 = remainder / 1000000000
                remainder = remainder - name_start * 1000000000
                mut name_length: i64 = remainder / 1000000
                match same_span(name_start, name_start + name_length, target_start, target_stop):
                    -1:
                        found = storage_id
                    0:
                        discard 0
                    1:
                        discard 0
                storage_id += 1
            0:
                discard 0
            1:
                discard 0
        cursor = stop + 1
    return found

fn find_next_identifier_use(start: i64, target_start: i64, target_stop: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut target_length: i64 = target_stop - target_start
    mut cursor: i64 = start
    while cursor + target_length <= length:
        mut candidate_stop: i64 = cursor + target_length
        match same_span(cursor, candidate_stop, target_start, target_stop):
            -1:
                mut before_ok: trit = -1
                match cursor > 0:
                    -1:
                        match is_identifier_continue(read_byte(cursor - 1)):
                            -1:
                                before_ok = 0
                            0:
                                discard 0
                            1:
                                discard 0
                    0:
                        discard 0
                    1:
                        discard 0
                mut after_ok: trit = -1
                match candidate_stop < length:
                    -1:
                        match is_identifier_continue(read_byte(candidate_stop)):
                            -1:
                                after_ok = 0
                            0:
                                discard 0
                            1:
                                discard 0
                    0:
                        discard 0
                    1:
                        discard 0
                match before_ok == -1:
                    -1:
                        match after_ok == -1:
                            -1:
                                return cursor
                            0:
                                discard 0
                            1:
                                discard 0
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        cursor += 1
    return -1

fn expect_byte(cursor: i64, length: i64, expected: i64) -> trit:
    match cursor < length:
        -1:
            match read_byte(cursor) == expected:
                -1:
                    return -1
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn word_is(start: i64, end: i64, expected_hash: i64, expected_length: i64) -> trit:
    match end - start == expected_length:
        -1:
            match identifier_hash(start, end) == expected_hash:
                -1:
                    return -1
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn type_code(start: i64, end: i64) -> i64:
    match word_is(start, end, 110644588, 5):
        -1:
            return 2
        0:
            match word_is(start, end, 102631, 3):
                -1:
                    return 3
                0:
                    match word_is(start, end, 3568681, 4):
                        -1:
                            return 1
                        0:
                            match word_is(start, end, 99748, 3):
                                -1:
                                    return 4
                                0:
                                    match word_is(start, end, 3402981393, 6):
                                        -1:
                                            return 5
                                        0:
                                            match word_is(start, end, 94224491, 5):
                                                -1:
                                                    return 6
                                                0:
                                                    match word_is(start, end, 3556653, 4):
                                                        -1:
                                                            return 7
                                                        0:
                                                            match word_is(start, end, 3474579779, 6):
                                                                -1:
                                                                    return 8
                                                                0:
                                                                    match word_is(start, end, 100101877612363, 9):
                                                                        -1:
                                                                            return 9
                                                                        0:
                                                                            match word_is(start, end, 93090393, 5):
                                                                                -1:
                                                                                    return 10
                                                                                0:
                                                                                    match word_is(start, end, 100907141340, 7):
                                                                                        -1:
                                                                                            return 11
                                                                                        0:
                                                                                            return 0
                                                                                        1:
                                                                                            return 0
                                                                                1:
                                                                                    return 0
                                                                        1:
                                                                            return 0
                                                                1:
                                                                    return 0
                                                        1:
                                                            return 0
                                                1:
                                                    return 0
                                        1:
                                            return 0
                                1:
                                    return 0
                        1:
                            return 0
                1:
                    return 0
        1:
            return 2

fn line_end(cursor: i64, length: i64) -> i64:
    mut position: i64 = cursor
    while position < length:
        match read_byte(position) == 10:
            -1:
                return position
            0:
                position += 1
            1:
                position += 1
    return position

fn first_non_space(start: i64, end: i64) -> i64:
    mut position: i64 = start
    while position < end:
        match is_space(read_byte(position)):
            -1:
                position += 1
            0:
                return position
            1:
                return position
    return position

fn same_span(left_start: i64, left_end: i64, right_start: i64, right_end: i64) -> trit:
    match left_end - left_start == right_end - right_start:
        -1:
            mut left: i64 = left_start
            mut right: i64 = right_start
            mut equal: trit = -1
            while left < left_end:
                match read_byte(left) == read_byte(right):
                    -1:
                        left += 1
                        right += 1
                    0:
                        equal = 0
                        left = left_end
                    1:
                        equal = 0
                        left = left_end
            return equal
        0:
            return 0
        1:
            return 0

fn is_identifier_span(start: i64, end: i64) -> trit:
    match start < end:
        -1:
            match is_identifier_start(read_byte(start)):
                -1:
                    mut cursor: i64 = start + 1
                    mut valid: trit = -1
                    while cursor < end:
                        match is_identifier_continue(read_byte(cursor)):
                            -1:
                                cursor += 1
                            0:
                                valid = 0
                                cursor = end
                            1:
                                valid = 0
                                cursor = end
                    return valid
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn return_type_matches(value_type: i64, return_type: i64) -> trit:
    match value_type == return_type:
        -1:
            return -1
        0:
            return 0
        1:
            return 0

fn parse_parameter_list(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    match expect_byte(cursor, end, 40):
        -1:
            cursor += 1
        0:
            return 0
        1:
            return 0
    cursor = skip_spaces(cursor, end)
    match read_byte(cursor) == 41:
        -1:
            return (cursor + 1) * to_i64(10)
        0:
            discard 0
        1:
            return 0
    while cursor < end:
        mut name_start: i64 = cursor
        mut name_stop: i64 = word_end(cursor, end)
        match is_identifier_span(name_start, name_stop):
            -1:
                cursor = skip_spaces(name_stop, end)
            0:
                return 0
            1:
                return 0
        match expect_byte(cursor, end, 58):
            -1:
                cursor += 1
            0:
                return 0
            1:
                return 0
        cursor = skip_spaces(cursor, end)
        mut type_start: i64 = cursor
        mut type_stop: i64 = word_end(cursor, end)
        mut parsed_type: i64 = type_code(type_start, type_stop)
        match parsed_type > 0:
            -1:
                cursor = skip_spaces(type_stop, end)
            0:
                return 0
            1:
                return 0
        match read_byte(cursor) == 41:
            -1:
                return (cursor + 1) * to_i64(10) + 1
            0:
                match expect_byte(cursor, end, 44):
                    -1:
                        cursor += 1
                        cursor = skip_spaces(cursor, end)
                    0:
                        return 0
                    1:
                        return 0
            1:
                return 0
    return 0

fn parse_header(start: i64, end: i64, require_body_colon: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 3272, 2):
        -1:
            cursor = skip_spaces(word_stop, end)
        0:
            return 0
        1:
            return 0
    word_stop = word_end(cursor, end)
    match is_identifier_span(cursor, word_stop):
        -1:
            cursor = skip_spaces(word_stop, end)
        0:
            return 0
        1:
            return 0
    mut parameter_info: i64 = parse_parameter_list(cursor, end)
    mut parameter_flag: i64 = 0
    match parameter_info > 0:
        -1:
            parameter_flag = parameter_info - (parameter_info / to_i64(10)) * to_i64(10)
            cursor = parameter_info / to_i64(10)
        0:
            return 0
        1:
            return 0
    cursor = skip_spaces(cursor, end)
    match expect_byte(cursor, end, 45):
        -1:
            cursor += 1
        0:
            return 0
        1:
            return 0
    cursor = skip_spaces(cursor, end)
    match expect_byte(cursor, end, 62):
        -1:
            cursor += 1
        0:
            return 0
        1:
            return 0
    cursor = skip_spaces(cursor, end)
    mut return_type_start: i64 = cursor
    mut return_type_stop: i64 = word_end(cursor, end)
    mut return_type: i64 = type_code(return_type_start, return_type_stop)
    match return_type > 0:
        -1:
            cursor = skip_spaces(return_type_stop, end)
        0:
            return 0
        1:
            return 0
    match require_body_colon == 1:
        -1:
            match expect_byte(cursor, end, 58):
                -1:
                    cursor += 1
                0:
                    return 0
                1:
                    return 0
        0:
            discard 0
        1:
            discard 0
    cursor = skip_spaces(cursor, end)
    match cursor == end:
        -1:
            return return_type * 10 + parameter_flag
        0:
            return 0
        1:
            return 0

fn parse_foreign_header(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 93811605716, 7):
        -1:
            cursor = skip_spaces(word_stop, end)
            return parse_header(cursor, end, 0)
        0:
            return 0
        1:
            return 0

fn count_header_parameters(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    cursor = skip_spaces(word_stop, end)
    word_stop = word_end(cursor, end)
    cursor = skip_spaces(word_stop, end)
    match expect_byte(cursor, end, 40):
        -1:
            cursor += 1
        0:
            return -1
        1:
            return -1
    cursor = skip_spaces(cursor, end)
    match read_byte(cursor) == 41:
        -1:
            return 0
        0:
            mut count: i64 = 0
            while cursor < end:
                mut name_start: i64 = cursor
                mut name_stop: i64 = word_end(cursor, end)
                match is_identifier_span(name_start, name_stop):
                    -1:
                        cursor = skip_spaces(name_stop, end)
                    0:
