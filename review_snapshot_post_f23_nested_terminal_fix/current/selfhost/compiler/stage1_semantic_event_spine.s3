                    discard emit_v3_b_block(function_id, outer_negative_block, outer_negative_block, 1, negative_jump_id)
                    discard emit_v3_b_block(function_id, outer_neutral_block, outer_neutral_block, 1, neutral_jump_id)
                    discard emit_v3_b_block(function_id, outer_positive_block, outer_positive_block, 1, positive_jump_id)
                    discard emit_v3_b_block(function_id, nested_next_block, nested_next_block, v3_return_instruction_count(continuation_first, continuation_stop), v3_return_terminator_id(continuation_context, header_start, header_end, continuation_first, continuation_stop))
