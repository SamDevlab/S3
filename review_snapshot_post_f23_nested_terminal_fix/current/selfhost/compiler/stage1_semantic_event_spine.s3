                            valid = 0
                        1:
                            valid = 0
                    match find_local_type(header_end + 1, body_limit, target_start, word_end(target_start, s3_stage1_source_length())) > 0:
                        -1:
                            match same_span(left_start, left_stop, target_start, word_end(target_start, s3_stage1_source_length())):
                                -1:
                                    discard 0
                                0:
                                    valid = 0
                                1:
                                    valid = 0
                        0:
                            discard 0
                        1:
                            discard 0
                1:
                    valid = 0
        0:
            discard 0
        1:
            discard 0
    match valid == -1:
        -1:
            return binary_info
        0:
            return 0
        1:
            return 0

fn scan_arithmetic_return(mode: i64, function_id: i64, return_type: i64, header_start: i64, header_end: i64, body_limit: i64, start: i64, end: i64, value_id: i64) -> i64:
    match return_type == 3:
        -1:
            match parse_pack_token_return(start, end) > 0:
                -1:
                    mut first_additive: i64 = find_additive_operator(start, end) / 10
                    mut first_left_end: i64 = trim_expression_end(start, first_additive)
                    mut first_product: i64 = find_multiplicative_operator(start, first_left_end) / 10
                    mut first_literal_start: i64 = skip_spaces(first_product + 1, first_left_end)
                    mut first_right_start: i64 = skip_spaces(first_additive + 1, end)
                    mut second_additive: i64 = find_additive_operator(first_right_start, end) / 10
                    mut second_left_end: i64 = trim_expression_end(first_right_start, second_additive)
                    mut second_product: i64 = find_multiplicative_operator(first_right_start, second_left_end) / 10
                    mut second_literal_start: i64 = skip_spaces(second_product + 1, second_left_end)
                    mut second_right_start: i64 = skip_spaces(second_additive + 1, end)
                    mut third_additive: i64 = find_additive_operator(second_right_start, end) / 10
                    mut third_left_end: i64 = trim_expression_end(second_right_start, third_additive)
                    mut third_start: i64 = first_non_space(second_right_start, third_left_end)
                    mut third_stop: i64 = word_end(third_start, third_left_end)
                    mut fourth_start: i64 = skip_spaces(third_additive + 1, end)
                    match mode == 1:
                        -1:
                            discard record_v(mode, value_id, function_id, 3, 3, first_literal_start, 0, 0, -1)
                            discard record_v(mode, value_id + 1, function_id, 4, 3, first_product, 0, 0, -1)
                            discard record_v(mode, value_id + 2, function_id, 3, 3, second_literal_start, 0, 0, -1)
                            discard record_v(mode, value_id + 3, function_id, 4, 3, second_product, 0, 0, -1)
                            discard record_v(mode, value_id + 4, function_id, 4, 3, first_additive, 0, 0, -1)
                            discard record_v(mode, value_id + 5, function_id, 4, 3, second_additive, 0, 0, -1)
                            discard record_v(mode, value_id + 6, function_id, 3, 3, fourth_start, 0, 0, -1)
                            discard record_v(mode, value_id + 7, function_id, 4, 3, third_additive, 0, 0, -1)
                            return value_id + 8
                        0:
                            return value_id + 8
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_return_builtin_conversion_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, callee_start: i64, callee_stop: i64, expression_start: i64, stop: i64, value_id: i64, signature: i64) -> i64:
    mut parsed_return: i64 = signature / 100
    mut parameter_type: i64 = signature - parsed_return * 100
    mut call_end: i64 = call_expression_end(expression_start)
    mut call_open: i64 = skip_spaces(callee_stop, call_end)
    mut argument_start: i64 = first_non_space(call_open + 1, call_end - 1)
    mut argument_stop: i64 = word_end(argument_start, call_end - 1)
    mut argument_type: i64 = resolve_value_type(header_start, header_end, first, argument_start, argument_stop)
    mut storage_id: i64 = find_mutable_storage_id(header_end + 1, first, argument_start, argument_stop)
    mut source_value_id: i64 = -1
    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
    mut base_id: i64 = function_id * 1000000 + ordinal
    mut convert_id: i64 = base_id
    mut return_id: i64 = base_id + 1
    mut convert_value_id: i64 = value_id
    mut source_value_kind: i64 = 0
    mut valid: trit = -1
    match parsed_return == return_type:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match argument_type == parameter_type:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match storage_id >= 0:
        -1:
            source_value_kind = 1
        0:
            mut parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, argument_start, argument_stop)
            match parameter_ordinal >= 0:
                -1:
                    source_value_id = value_id - count_header_parameters(header_start, header_end) + parameter_ordinal
                    source_value_kind = 2
                0:
                    source_value_id = find_core_local_value_id(header_end + 1, first, argument_start, argument_stop)
                    source_value_kind = 2
                1:
                    source_value_id = find_core_local_value_id(header_end + 1, first, argument_start, argument_stop)
                    source_value_kind = 2
        1:
            valid = 0
    match source_value_kind == 1:
        -1:
            convert_id = base_id + 2
            return_id = base_id + 3
            convert_value_id = value_id + 2
        0:
            match source_value_id >= 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        1:
            valid = 0
    match valid == -1:
        -1:
            match source_value_kind == 1:
                -1:
                    discard emit_v3_v(value_id, function_id, 2, 2, argument_start)
                    discard emit_v3_v(value_id + 1, function_id, 3, argument_type, argument_start)
                    discard emit_v3_i_aux(base_id, function_id, ordinal, 1, 1, 0, -1, 0)
                    discard emit_v3_r(base_id, 0, value_id)
                    discard emit_v3_i_aux(base_id + 1, function_id, ordinal + 1, 15, 1, 1, storage_id, -1)
                    discard emit_v3_o(base_id + 1, 0, value_id)
                    discard emit_v3_r(base_id + 1, 0, value_id + 1)
                    discard emit_v3_v(convert_value_id, function_id, 4, parsed_return, callee_start)
                    discard emit_v3_i(convert_id, function_id, ordinal + 2, 10, 1, 1, -1)
                    discard emit_v3_o(convert_id, 0, value_id + 1)
                    discard emit_v3_r(convert_id, 0, convert_value_id)
                0:
                    discard emit_v3_v(convert_value_id, function_id, 4, parsed_return, callee_start)
                    discard emit_v3_i(convert_id, function_id, ordinal, 10, 1, 1, -1)
                    discard emit_v3_o(convert_id, 0, source_value_id)
                    discard emit_v3_r(convert_id, 0, convert_value_id)
                1:
                    return -1
            match source_value_kind == 1:
                -1:
                    discard emit_v3_i(return_id, function_id, ordinal + 3, 23, 0, 1, -1)
                    discard emit_v3_o(return_id, 0, convert_value_id)
                    discard emit_v3_t(return_id, convert_value_id)
                0:
                    discard emit_v3_i(return_id, function_id, ordinal + 1, 23, 0, 1, -1)
                    discard emit_v3_o(return_id, 0, convert_value_id)
                    discard emit_v3_t(return_id, convert_value_id)
                1:
                    return -1
            match source_value_kind == 1:
                -1:
                    return value_id + 3
                0:
                    return value_id + 1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_return_call_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, expression_start: i64, stop: i64, value_id: i64) -> i64:
    mut call_info: i64 = parse_call_callee(expression_start, stop)
    match call_info > 0:
        -1:
            mut callee_start: i64 = call_info / 1000000
            mut callee_stop: i64 = call_info - callee_start * 1000000
            mut builtin_signature: i64 = builtin_call_signature(callee_start, callee_stop)
            match builtin_signature > 0:
                -1:
                    mut builtin_next_id: i64 = scan_return_builtin_conversion_v3(function_id, return_type, header_start, header_end, first, callee_start, callee_stop, expression_start, stop, value_id, builtin_signature)
                    match builtin_next_id >= 0:
                        -1:
                            return builtin_next_id
                        0:
                            return -1
                        1:
                            return -1
                0:
                    discard 0
                1:
                    return -1
            mut call_return_type: i64 = parse_call_return_type(expression_start, header_start, header_end)
            match call_return_type > 0:
                -1:
                    match return_type_matches(call_return_type, return_type):
                        -1:
                            mut open_start: i64 = skip_spaces(callee_stop, stop)
                            mut call_end: i64 = call_expression_end(expression_start)
                            mut argument_start: i64 = skip_spaces(open_start + 1, call_end - 1)
                            mut argument_stop: i64 = word_end(argument_start, call_end - 1)
                            mut argument_type: i64 = resolve_value_type(header_start, header_end, first, argument_start, argument_stop)
                            mut parameter_type: i64 = find_call_argument_type(expression_start, header_start, header_end)
                            match argument_type == parameter_type:
                                -1:
                                    mut parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, argument_start, argument_stop)
                                    match parameter_ordinal >= 0:
                                        -1:
                                            mut parameter_count: i64 = count_header_parameters(header_start, header_end)
                                            match parameter_count > 0:
                                                -1:
                                                    mut argument_value_id: i64 = value_id - parameter_count + parameter_ordinal
                                                    mut callee_identity: i64 = find_function_identity(callee_start, callee_stop)
                                                    match callee_identity > 0:
                                                        -1:
                                                            mut callee_function_id: i64 = callee_identity / 10
                                                            mut callee_kind: i64 = callee_identity - callee_function_id * 10
                                                            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                                            mut call_id: i64 = function_id * 1000000 + ordinal
                                                            mut return_id: i64 = call_id + 1
                                                            discard emit_v3_v(value_id, function_id, 4, call_return_type, callee_start)
                                                            discard emit_v3_i(call_id, function_id, ordinal, 14, 1, 1, -1)
                                                            discard emit_v3_c(call_id, callee_function_id, callee_kind, callee_start, callee_stop - callee_start)
                                                            discard emit_v3_a(call_id, 0, argument_value_id)
                                                            discard emit_v3_o(call_id, 0, argument_value_id)
                                                            discard emit_v3_r(call_id, 0, value_id)
                                                            discard emit_v3_i(return_id, function_id, ordinal + 1, 23, 0, 1, -1)
                                                            discard emit_v3_o(return_id, 0, value_id)
                                                            discard emit_v3_t(return_id, value_id)
                                                            return value_id + 1
                                                        0:
                                                            return -1
                                                        1:
                                                            return -1
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_return_additive_nested_three_call_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, expression_start: i64, stop: i64, value_id: i64) -> i64:
    mut shape: i64 = parse_call_additive_nested_three_arguments(expression_start, stop)
    mut outer_start: i64 = 0
    mut outer_stop: i64 = 0
    mut outer_open: i64 = 0
    mut outer_close: i64 = 0
    mut first_start: i64 = 0
    mut first_additive_info: i64 = 0
    mut first_additive_operator: i64 = 0
    mut first_additive_kind: i64 = 0
    mut first_left_end: i64 = 0
    mut first_left_start: i64 = 0
    mut first_left_stop: i64 = 0
    mut first_literal_start: i64 = 0
    mut first_literal_stop: i64 = 0
    mut first_comma: i64 = 0
    mut second_start: i64 = 0
    mut second_cursor: i64 = 0
    mut second_stop: i64 = 0
    mut second_comma: i64 = 0
    mut third_start: i64 = 0
    mut third_stop: i64 = 0
    mut inner_open: i64 = 0
    mut inner_close: i64 = 0
    mut inner_argument_start: i64 = 0
    mut inner_argument_stop: i64 = 0
    mut outer_signature: i64 = 0
    mut outer_parameter_zero_type: i64 = 0
    mut outer_parameter_one_type: i64 = 0
    mut outer_parameter_two_type: i64 = 0
    mut outer_result_type: i64 = 0
    mut outer_identity: i64 = 0
    mut inner_declared_signature: i64 = 0
    mut inner_signature: i64 = 0
    mut inner_parameter_type: i64 = 0
    mut inner_result_type: i64 = 0
    mut inner_identity: i64 = 0
    mut inner_builtin: trit = 0
    mut first_left_type: i64 = 0
    mut first_storage_id: i64 = 0
    mut inner_argument_type: i64 = 0
    mut inner_storage_id: i64 = 0
    mut valid: trit = -1
    match shape > 0:
        -1:
            outer_start = shape / 1000000
            outer_stop = shape - outer_start * 1000000
            outer_open = skip_spaces(outer_stop, stop)
            outer_close = matching_close(outer_open, stop)
            first_start = first_non_space(outer_open + 1, outer_close)
            first_additive_info = find_additive_operator(first_start, outer_close)
            first_additive_operator = first_additive_info / 10
            first_additive_kind = first_additive_info - first_additive_operator * 10
            first_left_end = trim_expression_end(first_start, first_additive_operator)
            first_left_start = first_non_space(first_start, first_left_end)
            first_left_stop = word_end(first_left_start, first_left_end)
            first_literal_start = first_non_space(first_additive_operator + 1, outer_close)
            mut first_literal_cursor: i64 = first_literal_start
            match read_byte(first_literal_cursor) == 45:
                -1:
                    first_literal_cursor += 1
                0:
                    discard 0
                1:
                    discard 0
            first_literal_stop = number_end(first_literal_cursor, outer_close)
            first_comma = skip_spaces(first_literal_stop, outer_close)
            second_start = first_non_space(first_comma + 1, outer_close)
            second_cursor = second_start
            match read_byte(second_cursor) == 45:
                -1:
                    second_cursor += 1
                0:
                    discard 0
                1:
                    discard 0
            second_stop = number_end(second_cursor, outer_close)
            second_comma = skip_spaces(second_stop, outer_close)
            third_start = first_non_space(second_comma + 1, outer_close)
            third_stop = word_end(third_start, outer_close)
            inner_open = skip_spaces(third_stop, outer_close)
            inner_close = matching_close(inner_open, outer_close)
            inner_argument_start = first_non_space(inner_open + 1, inner_close)
            inner_argument_stop = word_end(inner_argument_start, inner_close)
        0:
            valid = 0
        1:
            valid = 0
    match shape > 0:
        -1:
            outer_signature = find_function_signature(outer_start, outer_stop)
            outer_result_type = outer_signature / 100
            outer_parameter_zero_type = find_function_parameter_type_by_ordinal(outer_start, outer_stop, 0)
            outer_parameter_one_type = find_function_parameter_type_by_ordinal(outer_start, outer_stop, 1)
            outer_parameter_two_type = find_function_parameter_type_by_ordinal(outer_start, outer_stop, 2)
            outer_identity = find_function_identity(outer_start, outer_stop)
            inner_declared_signature = find_function_signature(third_start, third_stop)
            inner_signature = inner_declared_signature
            match inner_signature > 0:
                -1:
                    inner_builtin = 0
                0:
                    inner_signature = builtin_call_signature(third_start, third_stop)
                    inner_builtin = -1
                1:
                    inner_builtin = 0
            inner_result_type = inner_signature / 100
            inner_parameter_type = inner_signature - inner_result_type * 100
            inner_identity = find_function_identity(third_start, third_stop)
            first_left_type = resolve_value_type(header_start, header_end, first, first_left_start, first_left_stop)
            first_storage_id = find_mutable_storage_id(header_end + 1, first, first_left_start, first_left_stop)
            inner_argument_type = resolve_value_type(header_start, header_end, first, inner_argument_start, inner_argument_stop)
            inner_storage_id = find_mutable_storage_id(header_end + 1, first, inner_argument_start, inner_argument_stop)
        0:
            discard 0
        1:
            discard 0
    match shape > 0:
        -1:
            match outer_signature > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match outer_identity > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match outer_result_type == return_type:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match outer_parameter_zero_type == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match outer_parameter_one_type == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match outer_parameter_two_type > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match first_left_type == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match first_storage_id >= 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match first_additive_kind == 1:
                -1:
                    discard 0
                0:
                    match first_additive_kind == 2:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                1:
                    valid = 0
            match inner_signature > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match inner_parameter_type > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match inner_result_type > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match inner_argument_type == inner_parameter_type:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match inner_storage_id >= 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match outer_parameter_two_type == inner_result_type:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match inner_builtin == -1:
                -1:
                    match inner_identity == 0:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    match inner_identity > 0:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                1:
                    valid = 0
        0:
            discard 0
        1:
            discard 0
    match valid == -1:
        -1:
            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
            mut base_id: i64 = function_id * 1000000 + ordinal
            mut position_index_id: i64 = base_id
            mut position_load_id: i64 = base_id + 1
            mut first_literal_id: i64 = base_id + 2
            mut add_id: i64 = base_id + 3
            mut second_literal_id: i64 = base_id + 4
            mut inner_index_id: i64 = base_id + 5
            mut inner_load_id: i64 = base_id + 6
            mut inner_operation_id: i64 = base_id + 7
            mut outer_call_id: i64 = base_id + 8
            mut return_id: i64 = base_id + 9
            mut position_index_value: i64 = value_id
            mut position_load_value: i64 = value_id + 1
            mut first_literal_value: i64 = value_id + 2
            mut add_value: i64 = value_id + 3
            mut second_literal_value: i64 = value_id + 4
            mut inner_index_value: i64 = value_id + 5
            mut inner_load_value: i64 = value_id + 6
            mut inner_value: i64 = value_id + 7
            mut outer_value: i64 = value_id + 8
            mut add_opcode: i64 = 5
            mut outer_function_id: i64 = outer_identity / 10
            mut outer_kind: i64 = outer_identity - outer_function_id * 10
            mut inner_function_id: i64 = inner_identity / 10
            mut inner_kind: i64 = inner_identity - inner_function_id * 10
            match first_additive_kind == 2:
                -1:
                    add_opcode = 6
                0:
                    discard 0
                1:
                    discard 0
            discard emit_v3_v(position_index_value, function_id, 2, 2, first_left_start)
            discard emit_v3_v(position_load_value, function_id, 3, first_left_type, first_left_start)
            discard emit_v3_i_aux(position_index_id, function_id, ordinal, 1, 1, 0, -1, 0)
            discard emit_v3_r(position_index_id, 0, position_index_value)
            discard emit_v3_i_aux(position_load_id, function_id, ordinal + 1, 15, 1, 1, first_storage_id, -1)
            discard emit_v3_o(position_load_id, 0, position_index_value)
            discard emit_v3_r(position_load_id, 0, position_load_value)
            discard emit_v3_v(first_literal_value, function_id, 2, 3, first_literal_start)
            discard emit_v3_i(first_literal_id, function_id, ordinal + 2, 1, 1, 0, parse_integer_literal(first_literal_start, first_literal_stop))
            discard emit_v3_r(first_literal_id, 0, first_literal_value)
            discard emit_v3_v(add_value, function_id, 3, first_left_type, first_additive_operator)
            discard emit_v3_i(add_id, function_id, ordinal + 3, add_opcode, 1, 2, -1)
            discard emit_v3_o(add_id, 0, position_load_value)
            discard emit_v3_o(add_id, 1, first_literal_value)
            discard emit_v3_r(add_id, 0, add_value)
            discard emit_v3_v(second_literal_value, function_id, 2, 3, second_start)
            discard emit_v3_i(second_literal_id, function_id, ordinal + 4, 1, 1, 0, parse_integer_literal(second_start, second_stop))
            discard emit_v3_r(second_literal_id, 0, second_literal_value)
            discard emit_v3_v(inner_index_value, function_id, 2, 2, inner_argument_start)
            discard emit_v3_v(inner_load_value, function_id, 3, inner_argument_type, inner_argument_start)
            discard emit_v3_i_aux(inner_index_id, function_id, ordinal + 5, 1, 1, 0, -1, 0)
            discard emit_v3_r(inner_index_id, 0, inner_index_value)
            discard emit_v3_i_aux(inner_load_id, function_id, ordinal + 6, 15, 1, 1, inner_storage_id, -1)
            discard emit_v3_o(inner_load_id, 0, inner_index_value)
