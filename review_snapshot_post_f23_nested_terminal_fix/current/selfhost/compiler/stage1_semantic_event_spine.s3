                                                                                    discard emit_v3_v(argument_zero_value, function_id, 2, parameter_zero_type, argument_zero_start)
                                                                                    discard emit_v3_i(const_id, function_id, literal_ordinal, 1, 1, 0, parse_integer_literal(argument_zero_start, argument_zero_stop))
