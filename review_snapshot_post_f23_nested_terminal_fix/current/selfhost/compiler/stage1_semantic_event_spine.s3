fn call_expression_end(start: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut end: i64 = line_end(start, length)
    match end > start:
        -1:
            match expect_byte(end - 1, end, 13):
                -1:
                    match expect_byte(end - 2, end, 58):
                        -1:
                            return end - 2
                        0:
                            return end
                        1:
                            return end
                0:
                    match expect_byte(end - 1, end, 58):
                        -1:
                            return end - 1
                        0:
                            return end
                        1:
                            return end
                1:
                    return end
        0:
            return end
        1:
            return end

