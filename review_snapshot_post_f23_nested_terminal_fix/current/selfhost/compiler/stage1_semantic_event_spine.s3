            discard emit_v3_o(inner_neutral_jump_id, 1, inner_neutral_result_value)
            discard emit_v3_i_block(inner_neutral_terminator_id, function_id, 16, ordinal + 65, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(inner_neutral_terminator_id, 18)
            discard emit_v3_i_block(inner_positive_const_id, function_id, 17, ordinal + 66, 1, 1, 0, -1, 0)
            discard emit_v3_r(inner_positive_const_id, 0, inner_positive_index_value)
            discard emit_v3_i_block(inner_positive_store_id, function_id, 17, ordinal + 67, 1, 1, 0, -1, relational_lane_result(nested_operator_start, 1))
            discard emit_v3_r(inner_positive_store_id, 0, inner_positive_result_value)
            discard emit_v3_i_block(inner_positive_jump_id, function_id, 17, ordinal + 68, 16, 0, 2, inner_temp_storage_id, -1)
            discard emit_v3_o(inner_positive_jump_id, 0, inner_positive_index_value)
            discard emit_v3_o(inner_positive_jump_id, 1, inner_positive_result_value)
            discard emit_v3_i_block(inner_positive_terminator_id, function_id, 17, ordinal + 69, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(inner_positive_terminator_id, 18)
            discard emit_v3_i_block(inner_continuation_const_id, function_id, 18, ordinal + 70, 1, 1, 0, -1, 0)
            discard emit_v3_r(inner_continuation_const_id, 0, inner_continuation_index_value)
            discard emit_v3_i_block(inner_continuation_load_id, function_id, 18, ordinal + 71, 15, 1, 1, inner_temp_storage_id, -1)
            discard emit_v3_o(inner_continuation_load_id, 0, inner_continuation_index_value)
            discard emit_v3_r(inner_continuation_load_id, 0, inner_continuation_load_value)
            discard emit_v3_i_block(inner_continuation_branch_id, function_id, 18, ordinal + 72, 25, 0, 1, -1, -1)
            discard emit_v3_o(inner_continuation_branch_id, 0, inner_continuation_load_value)
            discard emit_v3_t_branch(inner_continuation_branch_id, 11, 12, 13, inner_continuation_load_value)
            discard emit_v3_b_block(function_id, 0, 0, count_core_instructions_between(header_end + 1, first) + 1, base_id)
            discard emit_v3_b_block(function_id, 1, 1, 4, outer_branch_id)
            discard emit_v3_b_block(function_id, 2, 2, 12, compound_jump_id)
            discard emit_v3_b_block(function_id, 3, 3, 1, outer_exit_zero_id)
            discard emit_v3_b_block(function_id, 4, 4, 1, outer_exit_positive_id)
            discard emit_v3_b_block(function_id, 5, 5, 3, outer_final_return_id)
            discard emit_v3_b_block(function_id, 6, 6, 4, outer_negative_terminator_id)
            discard emit_v3_b_block(function_id, 7, 7, 4, outer_neutral_terminator_id)
            discard emit_v3_b_block(function_id, 8, 8, 4, outer_positive_terminator_id)
            discard emit_v3_b_block(function_id, 9, 9, 3, outer_continuation_branch_id)
            discard emit_v3_b_block(function_id, 10, 10, 5, inner_branch_id)
            discard emit_v3_b_block(function_id, 11, 11, 7, inner_body_jump_id)
            discard emit_v3_b_block(function_id, 12, 12, 1, inner_exit_zero_id)
            discard emit_v3_b_block(function_id, 13, 13, 1, inner_exit_positive_id)
            discard emit_v3_b_block(function_id, 14, 14, 7, increment_jump_id)
            discard emit_v3_b_block(function_id, 15, 15, 4, inner_negative_terminator_id)
            discard emit_v3_b_block(function_id, 16, 16, 4, inner_neutral_terminator_id)
            discard emit_v3_b_block(function_id, 17, 17, 4, inner_positive_terminator_id)
            discard emit_v3_b_block(function_id, 18, 18, 3, inner_continuation_branch_id)
            mut encoded_next_id: i64 = value_id + 45
            encoded_next_id = encoded_next_id * 1000000
            encoded_next_id = encoded_next_id + return_stop + 2000000000000
            return encoded_next_id
        0:
            return -1
        1:
            return -1

fn scan_while_relation_parameter_right_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut left_start: i64 = while_left_start(first, stop)
    mut left_stop: i64 = while_left_stop(first, stop)
    mut operator_start: i64 = while_operator_start(first, stop)
    mut operator_length: i64 = comparison_operator_length(operator_start, stop)
    mut right_start: i64 = skip_spaces(operator_start + operator_length, stop)
    mut right_stop: i64 = word_end(right_start, stop)
    mut left_type: i64 = resolve_value_type(header_start, header_end, first, left_start, left_stop)
    mut right_type: i64 = resolve_value_type(header_start, header_end, first, right_start, right_stop)
    mut left_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
    mut right_parameter_type: i64 = find_parameter_type(header_start, header_end, right_start, right_stop)
    mut body_start: i64 = line_end(source_line_start(first), s3_stage1_source_length()) + 1
    mut body_stop: i64 = line_end(body_start, s3_stage1_source_length())
    mut body_target_start: i64 = first_non_space(body_start, body_stop)
    mut body_target_stop: i64 = word_end(body_target_start, body_stop)
    mut body_operator_start: i64 = skip_spaces(body_target_stop, body_stop)
    mut after_body: i64 = while_body_end(first, s3_stage1_source_length())
    mut return_stop: i64 = line_end(after_body, s3_stage1_source_length())
    mut return_first: i64 = first_non_space(after_body, return_stop)
    mut return_info: i64 = parse_return(return_first, return_stop)
    mut return_target_info: i64 = 0
    mut return_start: i64 = 0
    mut return_target_stop: i64 = 0
    mut valid: trit = -1
    match operator_length < 3:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_type > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_type == right_type:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_storage_id >= 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match right_parameter_type > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match return_type == left_type:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match parse_increment_statement(body_start, body_stop):
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match same_span(body_target_start, body_target_stop, left_start, left_stop):
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match return_info < 0:
        -1:
            return_target_info = 0 - return_info
            return_start = return_target_info / 1000000
            return_target_stop = return_target_info - return_start * 1000000
            match same_span(return_start, return_target_stop, left_start, left_stop):
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match valid == -1:
        -1:
            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
            mut base_id: i64 = function_id * 1000000 + ordinal
            mut entry_jump_id: i64 = base_id
            mut condition_index_id: i64 = base_id + 1
            mut condition_load_id: i64 = base_id + 2
            mut compare_id: i64 = base_id + 3
            mut condition_branch_id: i64 = base_id + 4
            mut body_index_id: i64 = base_id + 5
            mut body_load_id: i64 = base_id + 6
            mut body_const_id: i64 = base_id + 7
            mut add_id: i64 = base_id + 8
            mut store_index_id: i64 = base_id + 9
            mut store_id: i64 = base_id + 10
            mut body_jump_id: i64 = base_id + 11
            mut exit_zero_jump_id: i64 = base_id + 12
            mut exit_positive_jump_id: i64 = base_id + 13
            mut final_const_id: i64 = base_id + 14
            mut final_load_id: i64 = base_id + 15
            mut final_return_id: i64 = base_id + 16
            mut negative_const_id: i64 = base_id + 17
            mut negative_value_id: i64 = base_id + 18
            mut negative_store_id: i64 = base_id + 19
            mut negative_jump_id: i64 = base_id + 20
            mut neutral_const_id: i64 = base_id + 21
            mut neutral_value_id: i64 = base_id + 22
            mut neutral_store_id: i64 = base_id + 23
            mut neutral_jump_id: i64 = base_id + 24
            mut positive_const_id: i64 = base_id + 25
            mut positive_value_id: i64 = base_id + 26
            mut positive_store_id: i64 = base_id + 27
            mut positive_jump_id: i64 = base_id + 28
            mut continuation_const_id: i64 = base_id + 29
            mut continuation_load_id: i64 = base_id + 30
            mut continuation_branch_id: i64 = base_id + 31
            mut condition_index_value: i64 = value_id
            mut condition_load_value: i64 = value_id + 1
            mut compare_value: i64 = value_id + 2
            mut body_index_value: i64 = value_id + 3
            mut body_load_value: i64 = value_id + 4
            mut body_const_value: i64 = value_id + 5
            mut add_value: i64 = value_id + 6
            mut store_index_value: i64 = value_id + 7
            mut final_index_value: i64 = value_id + 8
            mut final_load_value: i64 = value_id + 9
            mut negative_index_value: i64 = value_id + 10
            mut negative_result_value: i64 = value_id + 11
            mut neutral_index_value: i64 = value_id + 12
            mut neutral_result_value: i64 = value_id + 13
            mut positive_index_value: i64 = value_id + 14
            mut positive_result_value: i64 = value_id + 15
            mut continuation_index_value: i64 = value_id + 16
            mut continuation_load_value: i64 = value_id + 17
            mut temporary_storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
            discard emit_v3_m(function_id, temporary_storage_id, 1, 1, 1, operator_start)
            discard emit_v3_v(condition_index_value, function_id, 2, 2, left_start)
            discard emit_v3_v(condition_load_value, function_id, 3, left_type, left_start)
            discard emit_v3_v(compare_value, function_id, 3, 1, operator_start)
            discard emit_v3_v(body_index_value, function_id, 2, 2, body_target_start)
            discard emit_v3_v(body_load_value, function_id, 3, left_type, body_target_start)
            mut body_literal_start: i64 = skip_spaces(body_operator_start + 2, body_stop)
            mut body_literal_stop: i64 = trim_expression_end(body_literal_start, body_stop)
            discard emit_v3_v(body_const_value, function_id, 2, left_type, body_literal_start)
            discard emit_v3_v(add_value, function_id, 3, left_type, body_operator_start)
            discard emit_v3_v(store_index_value, function_id, 2, 2, body_target_start)
            discard emit_v3_v(final_index_value, function_id, 2, 2, return_start)
            discard emit_v3_v(final_load_value, function_id, 3, left_type, return_start)
            discard emit_v3_v(negative_index_value, function_id, 2, 2, operator_start)
            discard emit_v3_v(negative_result_value, function_id, 2, 1, operator_start)
            discard emit_v3_v(neutral_index_value, function_id, 2, 2, operator_start)
            discard emit_v3_v(neutral_result_value, function_id, 2, 1, operator_start)
            discard emit_v3_v(positive_index_value, function_id, 2, 2, operator_start)
            discard emit_v3_v(positive_result_value, function_id, 2, 1, operator_start)
            discard emit_v3_v(continuation_index_value, function_id, 2, 2, operator_start)
            discard emit_v3_v(continuation_load_value, function_id, 3, 1, operator_start)
            discard emit_v3_i_block(entry_jump_id, function_id, 0, ordinal, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(entry_jump_id, 1)
            discard emit_v3_i_block(condition_index_id, function_id, 1, ordinal + 1, 1, 1, 0, -1, 0)
            discard emit_v3_r(condition_index_id, 0, condition_index_value)
            discard emit_v3_i_block(condition_load_id, function_id, 1, ordinal + 2, 15, 1, 1, left_storage_id, -1)
            discard emit_v3_o(condition_load_id, 0, condition_index_value)
            discard emit_v3_r(condition_load_id, 0, condition_load_value)
            discard emit_v3_i_block(compare_id, function_id, 1, ordinal + 3, 13, 1, 2, -1, -1)
            discard emit_v3_o(compare_id, 0, condition_load_value)
            discard emit_v3_o(compare_id, 1, find_parameter_ordinal(header_start, header_end, right_start, right_stop))
            discard emit_v3_r(compare_id, 0, compare_value)
            discard emit_v3_i_block(condition_branch_id, function_id, 1, ordinal + 4, 25, 0, 1, -1, -1)
            discard emit_v3_o(condition_branch_id, 0, compare_value)
            discard emit_v3_t_branch(condition_branch_id, 6, 7, 8, compare_value)
            discard emit_v3_i_block(body_index_id, function_id, 2, ordinal + 5, 1, 1, 0, -1, 0)
            discard emit_v3_r(body_index_id, 0, body_index_value)
            discard emit_v3_i_block(body_load_id, function_id, 2, ordinal + 6, 15, 1, 1, left_storage_id, -1)
            discard emit_v3_o(body_load_id, 0, body_index_value)
            discard emit_v3_r(body_load_id, 0, body_load_value)
            discard emit_v3_i_block(body_const_id, function_id, 2, ordinal + 7, 1, 1, 0, -1, parse_integer_literal(body_literal_start, body_literal_stop))
            discard emit_v3_r(body_const_id, 0, body_const_value)
            discard emit_v3_i_block(add_id, function_id, 2, ordinal + 8, 5, 1, 2, -1, -1)
            discard emit_v3_o(add_id, 0, body_load_value)
            discard emit_v3_o(add_id, 1, body_const_value)
            discard emit_v3_r(add_id, 0, add_value)
            discard emit_v3_i_block(store_index_id, function_id, 2, ordinal + 9, 1, 1, 0, -1, 0)
            discard emit_v3_r(store_index_id, 0, store_index_value)
            discard emit_v3_i_block(store_id, function_id, 2, ordinal + 10, 16, 0, 2, left_storage_id, -1)
            discard emit_v3_o(store_id, 0, store_index_value)
            discard emit_v3_o(store_id, 1, add_value)
            discard emit_v3_i_block(body_jump_id, function_id, 2, ordinal + 11, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(body_jump_id, 1)
            discard emit_v3_i_block(exit_zero_jump_id, function_id, 3, ordinal + 12, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(exit_zero_jump_id, 5)
            discard emit_v3_i_block(exit_positive_jump_id, function_id, 4, ordinal + 13, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(exit_positive_jump_id, 5)
            discard emit_v3_i_block(final_const_id, function_id, 5, ordinal + 14, 1, 1, 0, -1, 0)
            discard emit_v3_r(final_const_id, 0, final_index_value)
            discard emit_v3_i_block(final_load_id, function_id, 5, ordinal + 15, 15, 1, 1, left_storage_id, -1)
            discard emit_v3_o(final_load_id, 0, final_index_value)
            discard emit_v3_r(final_load_id, 0, final_load_value)
            discard emit_v3_i_block(final_return_id, function_id, 5, ordinal + 16, 23, 0, 1, -1, -1)
            discard emit_v3_o(final_return_id, 0, final_load_value)
            discard emit_v3_t(final_return_id, final_load_value)
            discard emit_v3_i_block(negative_const_id, function_id, 6, ordinal + 17, 1, 1, 0, -1, 0)
            discard emit_v3_r(negative_const_id, 0, negative_index_value)
            discard emit_v3_i_block(negative_value_id, function_id, 6, ordinal + 18, 1, 1, 0, -1, relational_lane_result(operator_start, -1))
            discard emit_v3_r(negative_value_id, 0, negative_result_value)
            discard emit_v3_i_block(negative_store_id, function_id, 6, ordinal + 19, 16, 0, 2, temporary_storage_id, -1)
            discard emit_v3_o(negative_store_id, 0, negative_index_value)
            discard emit_v3_o(negative_store_id, 1, negative_result_value)
            discard emit_v3_i_block(negative_jump_id, function_id, 6, ordinal + 20, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(negative_jump_id, 9)
            discard emit_v3_i_block(neutral_const_id, function_id, 7, ordinal + 21, 1, 1, 0, -1, 0)
            discard emit_v3_r(neutral_const_id, 0, neutral_index_value)
            discard emit_v3_i_block(neutral_value_id, function_id, 7, ordinal + 22, 1, 1, 0, -1, relational_lane_result(operator_start, 0))
            discard emit_v3_r(neutral_value_id, 0, neutral_result_value)
            discard emit_v3_i_block(neutral_store_id, function_id, 7, ordinal + 23, 16, 0, 2, temporary_storage_id, -1)
            discard emit_v3_o(neutral_store_id, 0, neutral_index_value)
            discard emit_v3_o(neutral_store_id, 1, neutral_result_value)
            discard emit_v3_i_block(neutral_jump_id, function_id, 7, ordinal + 24, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(neutral_jump_id, 9)
            discard emit_v3_i_block(positive_const_id, function_id, 8, ordinal + 25, 1, 1, 0, -1, 0)
            discard emit_v3_r(positive_const_id, 0, positive_index_value)
            discard emit_v3_i_block(positive_value_id, function_id, 8, ordinal + 26, 1, 1, 0, -1, relational_lane_result(operator_start, 1))
            discard emit_v3_r(positive_value_id, 0, positive_result_value)
            discard emit_v3_i_block(positive_store_id, function_id, 8, ordinal + 27, 16, 0, 2, temporary_storage_id, -1)
            discard emit_v3_o(positive_store_id, 0, positive_index_value)
            discard emit_v3_o(positive_store_id, 1, positive_result_value)
            discard emit_v3_i_block(positive_jump_id, function_id, 8, ordinal + 28, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(positive_jump_id, 9)
            discard emit_v3_i_block(continuation_const_id, function_id, 9, ordinal + 29, 1, 1, 0, -1, 0)
            discard emit_v3_r(continuation_const_id, 0, continuation_index_value)
            discard emit_v3_i_block(continuation_load_id, function_id, 9, ordinal + 30, 15, 1, 1, temporary_storage_id, -1)
            discard emit_v3_o(continuation_load_id, 0, continuation_index_value)
            discard emit_v3_r(continuation_load_id, 0, continuation_load_value)
            discard emit_v3_i_block(continuation_branch_id, function_id, 9, ordinal + 31, 25, 0, 1, -1, -1)
            discard emit_v3_o(continuation_branch_id, 0, continuation_load_value)
            discard emit_v3_t_branch(continuation_branch_id, 2, 3, 4, continuation_load_value)
            discard emit_v3_b_block(function_id, 0, 0, ordinal + 1, entry_jump_id)
            discard emit_v3_b_block(function_id, 1, 1, 4, condition_branch_id)
            discard emit_v3_b_block(function_id, 2, 2, 7, body_jump_id)
            discard emit_v3_b_block(function_id, 3, 3, 1, exit_zero_jump_id)
            discard emit_v3_b_block(function_id, 4, 4, 1, exit_positive_jump_id)
            discard emit_v3_b_block(function_id, 5, 5, 3, final_return_id)
            discard emit_v3_b_block(function_id, 6, 6, 4, negative_jump_id)
            discard emit_v3_b_block(function_id, 7, 7, 4, neutral_jump_id)
            discard emit_v3_b_block(function_id, 8, 8, 4, positive_jump_id)
            discard emit_v3_b_block(function_id, 9, 9, 3, continuation_branch_id)
            mut encoded_next_id: i64 = value_id + 18
            encoded_next_id = encoded_next_id * 1000000
            encoded_next_id = encoded_next_id + return_stop + 2000000000000
            return encoded_next_id
        0:
            return -1
        1:
            return -1

fn scan_while_relation_mutable_right_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut left_start: i64 = while_left_start(first, stop)
    mut left_stop: i64 = while_left_stop(first, stop)
    mut operator_start: i64 = while_operator_start(first, stop)
    mut right_start: i64 = skip_spaces(operator_start + comparison_operator_length(operator_start, stop), stop)
    mut right_stop: i64 = word_end(right_start, stop)
    mut left_type: i64 = resolve_value_type(header_start, header_end, first, left_start, left_stop)
    mut right_type: i64 = resolve_value_type(header_start, header_end, first, right_start, right_stop)
    match left_type > 0:
        -1:
            match left_type == right_type:
                -1:
                    match return_type == left_type:
                        -1:
                            mut left_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
                            mut right_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, right_start, right_stop)
                            match left_storage_id >= 0:
                                -1:
                                    match right_storage_id >= 0:
                                        -1:
                                            mut body_start: i64 = line_end(source_line_start(first), s3_stage1_source_length()) + 1
                                            mut body_stop: i64 = line_end(body_start, s3_stage1_source_length())
                                            mut body_first: i64 = first_non_space(body_start, body_stop)
                                            mut assignment_info: i64 = parse_assignment_expression_bounds(body_first, body_stop)
                                            match assignment_info > 0:
                                                -1:
                                                    mut target_start: i64 = body_first
                                                    mut target_stop: i64 = word_end(target_start, body_stop)
                                                    mut expression_start: i64 = assignment_info / 1000000
                                                    mut expression_end: i64 = assignment_info - expression_start * 1000000
                                                    mut additive_info: i64 = find_additive_operator(expression_start, expression_end)
                                                    match additive_info > 0:
                                                        -1:
                                                            mut additive_operator: i64 = additive_info / 10
                                                            mut body_left_end: i64 = trim_expression_end(expression_start, additive_operator)
                                                            mut body_left_start: i64 = first_non_space(expression_start, body_left_end)
                                                            mut body_left_stop: i64 = word_end(body_left_start, body_left_end)
                                                            mut body_right_start: i64 = skip_spaces(additive_operator + 1, expression_end)
                                                            mut body_right_stop: i64 = binary_right_operand_stop(body_right_start, expression_end)
                                                            match same_span(target_start, target_stop, left_start, left_stop):
                                                                -1:
                                                                    match same_span(body_left_start, body_left_stop, left_start, left_stop):
                                                                        -1:
                                                                            match body_right_stop > 0:
                                                                                -1:
                                                                                    match parse_literal_expression(body_right_start, body_right_stop) > 0:
                                                                                        -1:
                                                                                            match skip_spaces(body_right_stop, expression_end) == expression_end:
                                                                                                -1:
                                                                                                    mut after_body: i64 = while_body_end(first, s3_stage1_source_length())
                                                                                                    mut return_stop: i64 = line_end(after_body, s3_stage1_source_length())
                                                                                                    mut return_first: i64 = first_non_space(after_body, return_stop)
                                                                                                    mut return_info: i64 = parse_return(return_first, return_stop)
                                                                                                    match return_info < 0:
                                                                                                        -1:
                                                                                                            mut return_target_info: i64 = 0 - return_info
                                                                                                            mut return_start: i64 = return_target_info / 1000000
                                                                                                            mut return_target_stop: i64 = return_target_info - return_start * 1000000
                                                                                                            match same_span(return_start, return_target_stop, left_start, left_stop):
                                                                                                                -1:
                                                                                                                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                                                                                                    mut base_id: i64 = function_id * 1000000 + ordinal
                                                                                                                    mut entry_jump_id: i64 = base_id
                                                                                                                    mut left_index_id: i64 = base_id + 1
                                                                                                                    mut left_load_id: i64 = base_id + 2
                                                                                                                    mut right_index_id: i64 = base_id + 3
                                                                                                                    mut right_load_id: i64 = base_id + 4
                                                                                                                    mut compare_id: i64 = base_id + 5
                                                                                                                    mut condition_branch_id: i64 = base_id + 6
                                                                                                                    mut body_index_id: i64 = base_id + 7
                                                                                                                    mut body_load_id: i64 = base_id + 8
                                                                                                                    mut body_const_id: i64 = base_id + 9
                                                                                                                    mut add_id: i64 = base_id + 10
                                                                                                                    mut store_index_id: i64 = base_id + 11
                                                                                                                    mut store_id: i64 = base_id + 12
                                                                                                                    mut body_jump_id: i64 = base_id + 13
                                                                                                                    mut exit_zero_jump_id: i64 = base_id + 14
                                                                                                                    mut exit_positive_jump_id: i64 = base_id + 15
                                                                                                                    mut final_const_id: i64 = base_id + 16
                                                                                                                    mut final_load_id: i64 = base_id + 17
                                                                                                                    mut final_return_id: i64 = base_id + 18
                                                                                                                    mut negative_const_id: i64 = base_id + 19
                                                                                                                    mut negative_value_id: i64 = base_id + 20
                                                                                                                    mut negative_store_id: i64 = base_id + 21
                                                                                                                    mut negative_jump_id: i64 = base_id + 22
                                                                                                                    mut neutral_const_id: i64 = base_id + 23
                                                                                                                    mut neutral_value_id: i64 = base_id + 24
                                                                                                                    mut neutral_store_id: i64 = base_id + 25
                                                                                                                    mut neutral_jump_id: i64 = base_id + 26
                                                                                                                    mut positive_const_id: i64 = base_id + 27
                                                                                                                    mut positive_value_id: i64 = base_id + 28
                                                                                                                    mut positive_store_id: i64 = base_id + 29
                                                                                                                    mut positive_jump_id: i64 = base_id + 30
                                                                                                                    mut continuation_const_id: i64 = base_id + 31
                                                                                                                    mut continuation_load_id: i64 = base_id + 32
                                                                                                                    mut continuation_branch_id: i64 = base_id + 33
                                                                                                                    mut condition_left_index_value: i64 = value_id
                                                                                                                    mut condition_left_load_value: i64 = value_id + 1
                                                                                                                    mut condition_right_index_value: i64 = value_id + 2
                                                                                                                    mut condition_right_load_value: i64 = value_id + 3
                                                                                                                    mut compare_value: i64 = value_id + 4
                                                                                                                    mut body_index_value: i64 = value_id + 5
                                                                                                                    mut body_load_value: i64 = value_id + 6
                                                                                                                    mut body_const_value: i64 = value_id + 7
                                                                                                                    mut add_value: i64 = value_id + 8
                                                                                                                    mut store_index_value: i64 = value_id + 9
                                                                                                                    mut final_index_value: i64 = value_id + 10
                                                                                                                    mut final_load_value: i64 = value_id + 11
                                                                                                                    mut negative_index_value: i64 = value_id + 12
                                                                                                                    mut negative_result_value: i64 = value_id + 13
                                                                                                                    mut neutral_index_value: i64 = value_id + 14
                                                                                                                    mut neutral_result_value: i64 = value_id + 15
                                                                                                                    mut positive_index_value: i64 = value_id + 16
                                                                                                                    mut positive_result_value: i64 = value_id + 17
                                                                                                                    mut continuation_index_value: i64 = value_id + 18
                                                                                                                    mut continuation_load_value: i64 = value_id + 19
                                                                                                                    mut temporary_storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
                                                                                                                    discard emit_v3_m(function_id, temporary_storage_id, 1, 1, 1, operator_start)
                                                                                                                    discard emit_v3_v(condition_left_index_value, function_id, 2, 2, left_start)
                                                                                                                    discard emit_v3_v(condition_left_load_value, function_id, 3, left_type, left_start)
                                                                                                                    discard emit_v3_v(condition_right_index_value, function_id, 2, 2, right_start)
                                                                                                                    discard emit_v3_v(condition_right_load_value, function_id, 3, right_type, right_start)
                                                                                                                    discard emit_v3_v(compare_value, function_id, 3, 1, operator_start)
                                                                                                                    discard emit_v3_v(body_index_value, function_id, 2, 2, target_start)
                                                                                                                    discard emit_v3_v(body_load_value, function_id, 3, left_type, target_start)
                                                                                                                    discard emit_v3_v(body_const_value, function_id, 2, left_type, body_right_start)
                                                                                                                    discard emit_v3_v(add_value, function_id, 3, left_type, additive_operator)
                                                                                                                    discard emit_v3_v(store_index_value, function_id, 2, 2, target_start)
                                                                                                                    discard emit_v3_v(final_index_value, function_id, 2, 2, return_start)
                                                                                                                    discard emit_v3_v(final_load_value, function_id, 3, left_type, return_start)
                                                                                                                    discard emit_v3_v(negative_index_value, function_id, 2, 2, operator_start)
                                                                                                                    discard emit_v3_v(negative_result_value, function_id, 2, 1, operator_start)
                                                                                                                    discard emit_v3_v(neutral_index_value, function_id, 2, 2, operator_start)
                                                                                                                    discard emit_v3_v(neutral_result_value, function_id, 2, 1, operator_start)
                                                                                                                    discard emit_v3_v(positive_index_value, function_id, 2, 2, operator_start)
                                                                                                                    discard emit_v3_v(positive_result_value, function_id, 2, 1, operator_start)
                                                                                                                    discard emit_v3_v(continuation_index_value, function_id, 2, 2, operator_start)
                                                                                                                    discard emit_v3_v(continuation_load_value, function_id, 3, 1, operator_start)
                                                                                                                    discard emit_v3_i_block(entry_jump_id, function_id, 0, ordinal, 24, 0, 0, -1, -1)
                                                                                                                    discard emit_v3_t_jump(entry_jump_id, 1)
                                                                                                                    discard emit_v3_i_block(left_index_id, function_id, 1, ordinal + 1, 1, 1, 0, -1, 0)
                                                                                                                    discard emit_v3_r(left_index_id, 0, condition_left_index_value)
                                                                                                                    discard emit_v3_i_block(left_load_id, function_id, 1, ordinal + 2, 15, 1, 1, left_storage_id, -1)
                                                                                                                    discard emit_v3_o(left_load_id, 0, condition_left_index_value)
                                                                                                                    discard emit_v3_r(left_load_id, 0, condition_left_load_value)
                                                                                                                    discard emit_v3_i_block(right_index_id, function_id, 1, ordinal + 3, 1, 1, 0, -1, 0)
                                                                                                                    discard emit_v3_r(right_index_id, 0, condition_right_index_value)
                                                                                                                    discard emit_v3_i_block(right_load_id, function_id, 1, ordinal + 4, 15, 1, 1, right_storage_id, -1)
                                                                                                                    discard emit_v3_o(right_load_id, 0, condition_right_index_value)
                                                                                                                    discard emit_v3_r(right_load_id, 0, condition_right_load_value)
                                                                                                                    discard emit_v3_i_block(compare_id, function_id, 1, ordinal + 5, 13, 1, 2, -1, -1)
                                                                                                                    discard emit_v3_o(compare_id, 0, condition_left_load_value)
                                                                                                                    discard emit_v3_o(compare_id, 1, condition_right_load_value)
                                                                                                                    discard emit_v3_r(compare_id, 0, compare_value)
                                                                                                                    discard emit_v3_i_block(condition_branch_id, function_id, 1, ordinal + 6, 25, 0, 1, -1, -1)
                                                                                                                    discard emit_v3_o(condition_branch_id, 0, compare_value)
                                                                                                                    discard emit_v3_t_branch(condition_branch_id, 6, 7, 8, compare_value)
                                                                                                                    discard emit_v3_i_block(body_index_id, function_id, 2, ordinal + 7, 1, 1, 0, -1, 0)
                                                                                                                    discard emit_v3_r(body_index_id, 0, body_index_value)
                                                                                                                    discard emit_v3_i_block(body_load_id, function_id, 2, ordinal + 8, 15, 1, 1, left_storage_id, -1)
                                                                                                                    discard emit_v3_o(body_load_id, 0, body_index_value)
                                                                                                                    discard emit_v3_r(body_load_id, 0, body_load_value)
                                                                                                                    discard emit_v3_i_block(body_const_id, function_id, 2, ordinal + 9, 1, 1, 0, -1, parse_integer_literal(body_right_start, body_right_stop))
                                                                                                                    discard emit_v3_r(body_const_id, 0, body_const_value)
                                                                                                                    discard emit_v3_i_block(add_id, function_id, 2, ordinal + 10, 5, 1, 2, -1, -1)
                                                                                                                    discard emit_v3_o(add_id, 0, body_load_value)
                                                                                                                    discard emit_v3_o(add_id, 1, body_const_value)
                                                                                                                    discard emit_v3_r(add_id, 0, add_value)
                                                                                                                    discard emit_v3_i_block(store_index_id, function_id, 2, ordinal + 11, 1, 1, 0, -1, 0)
                                                                                                                    discard emit_v3_r(store_index_id, 0, store_index_value)
                                                                                                                    discard emit_v3_i_block(store_id, function_id, 2, ordinal + 12, 16, 0, 2, left_storage_id, -1)
                                                                                                                    discard emit_v3_o(store_id, 0, store_index_value)
                                                                                                                    discard emit_v3_o(store_id, 1, add_value)
                                                                                                                    discard emit_v3_i_block(body_jump_id, function_id, 2, ordinal + 13, 24, 0, 0, -1, -1)
                                                                                                                    discard emit_v3_t_jump(body_jump_id, 1)
                                                                                                                    discard emit_v3_i_block(exit_zero_jump_id, function_id, 3, ordinal + 14, 24, 0, 0, -1, -1)
                                                                                                                    discard emit_v3_t_jump(exit_zero_jump_id, 5)
                                                                                                                    discard emit_v3_i_block(exit_positive_jump_id, function_id, 4, ordinal + 15, 24, 0, 0, -1, -1)
                                                                                                                    discard emit_v3_t_jump(exit_positive_jump_id, 5)
                                                                                                                    discard emit_v3_i_block(final_const_id, function_id, 5, ordinal + 16, 1, 1, 0, -1, 0)
                                                                                                                    discard emit_v3_r(final_const_id, 0, final_index_value)
                                                                                                                    discard emit_v3_i_block(final_load_id, function_id, 5, ordinal + 17, 15, 1, 1, left_storage_id, -1)
                                                                                                                    discard emit_v3_o(final_load_id, 0, final_index_value)
                                                                                                                    discard emit_v3_r(final_load_id, 0, final_load_value)
                                                                                                                    discard emit_v3_i_block(final_return_id, function_id, 5, ordinal + 18, 23, 0, 1, -1, -1)
                                                                                                                    discard emit_v3_o(final_return_id, 0, final_load_value)
                                                                                                                    discard emit_v3_t(final_return_id, final_load_value)
                                                                                                                    discard emit_v3_i_block(negative_const_id, function_id, 6, ordinal + 19, 1, 1, 0, -1, 0)
                                                                                                                    discard emit_v3_r(negative_const_id, 0, negative_index_value)
                                                                                                                    discard emit_v3_i_block(negative_value_id, function_id, 6, ordinal + 20, 1, 1, 0, -1, relational_lane_result(operator_start, -1))
                                                                                                                    discard emit_v3_r(negative_value_id, 0, negative_result_value)
                                                                                                                    discard emit_v3_i_block(negative_store_id, function_id, 6, ordinal + 21, 16, 0, 2, temporary_storage_id, -1)
                                                                                                                    discard emit_v3_o(negative_store_id, 0, negative_index_value)
                                                                                                                    discard emit_v3_o(negative_store_id, 1, negative_result_value)
                                                                                                                    discard emit_v3_i_block(negative_jump_id, function_id, 6, ordinal + 22, 24, 0, 0, -1, -1)
                                                                                                                    discard emit_v3_t_jump(negative_jump_id, 9)
                                                                                                                    discard emit_v3_i_block(neutral_const_id, function_id, 7, ordinal + 23, 1, 1, 0, -1, 0)
                                                                                                                    discard emit_v3_r(neutral_const_id, 0, neutral_index_value)
                                                                                                                    discard emit_v3_i_block(neutral_value_id, function_id, 7, ordinal + 24, 1, 1, 0, -1, relational_lane_result(operator_start, 0))
                                                                                                                    discard emit_v3_r(neutral_value_id, 0, neutral_result_value)
                                                                                                                    discard emit_v3_i_block(neutral_store_id, function_id, 7, ordinal + 25, 16, 0, 2, temporary_storage_id, -1)
                                                                                                                    discard emit_v3_o(neutral_store_id, 0, neutral_index_value)
                                                                                                                    discard emit_v3_o(neutral_store_id, 1, neutral_result_value)
                                                                                                                    discard emit_v3_i_block(neutral_jump_id, function_id, 7, ordinal + 26, 24, 0, 0, -1, -1)
                                                                                                                    discard emit_v3_t_jump(neutral_jump_id, 9)
                                                                                                                    discard emit_v3_i_block(positive_const_id, function_id, 8, ordinal + 27, 1, 1, 0, -1, 0)
                                                                                                                    discard emit_v3_r(positive_const_id, 0, positive_index_value)
                                                                                                                    discard emit_v3_i_block(positive_value_id, function_id, 8, ordinal + 28, 1, 1, 0, -1, relational_lane_result(operator_start, 1))
                                                                                                                    discard emit_v3_r(positive_value_id, 0, positive_result_value)
                                                                                                                    discard emit_v3_i_block(positive_store_id, function_id, 8, ordinal + 29, 16, 0, 2, temporary_storage_id, -1)
                                                                                                                    discard emit_v3_o(positive_store_id, 0, positive_index_value)
                                                                                                                    discard emit_v3_o(positive_store_id, 1, positive_result_value)
                                                                                                                    discard emit_v3_i_block(positive_jump_id, function_id, 8, ordinal + 30, 24, 0, 0, -1, -1)
                                                                                                                    discard emit_v3_t_jump(positive_jump_id, 9)
                                                                                                                    discard emit_v3_i_block(continuation_const_id, function_id, 9, ordinal + 31, 1, 1, 0, -1, 0)
                                                                                                                    discard emit_v3_r(continuation_const_id, 0, continuation_index_value)
                                                                                                                    discard emit_v3_i_block(continuation_load_id, function_id, 9, ordinal + 32, 15, 1, 1, temporary_storage_id, -1)
                                                                                                                    discard emit_v3_o(continuation_load_id, 0, continuation_index_value)
                                                                                                                    discard emit_v3_r(continuation_load_id, 0, continuation_load_value)
                                                                                                                    discard emit_v3_i_block(continuation_branch_id, function_id, 9, ordinal + 33, 25, 0, 1, -1, -1)
                                                                                                                    discard emit_v3_o(continuation_branch_id, 0, continuation_load_value)
                                                                                                                    discard emit_v3_t_branch(continuation_branch_id, 2, 3, 4, continuation_load_value)
                                                                                                                    discard emit_v3_b_block(function_id, 0, 0, ordinal + 1, entry_jump_id)
                                                                                                                    discard emit_v3_b_block(function_id, 1, 1, 6, condition_branch_id)
                                                                                                                    discard emit_v3_b_block(function_id, 2, 2, 7, body_jump_id)
                                                                                                                    discard emit_v3_b_block(function_id, 3, 3, 1, exit_zero_jump_id)
                                                                                                                    discard emit_v3_b_block(function_id, 4, 4, 1, exit_positive_jump_id)
                                                                                                                    discard emit_v3_b_block(function_id, 5, 5, 3, final_return_id)
                                                                                                                    discard emit_v3_b_block(function_id, 6, 6, 4, negative_jump_id)
                                                                                                                    discard emit_v3_b_block(function_id, 7, 7, 4, neutral_jump_id)
                                                                                                                    discard emit_v3_b_block(function_id, 8, 8, 4, positive_jump_id)
                                                                                                                    discard emit_v3_b_block(function_id, 9, 9, 3, continuation_branch_id)
                                                                                                                    mut encoded_next_id: i64 = value_id + 20
                                                                                                                    encoded_next_id = encoded_next_id * 1000000
                                                                                                                    encoded_next_id = encoded_next_id + return_stop + 2000000000000
                                                                                                                    return encoded_next_id
                                                                                                                0:
                                                                                                                    return -1
                                                                                                                1:
                                                                                                                    return -1
                                                                                                        0:
                                                                                                            return -1
                                                                                                        1:
                                                                                                            return -1
                                                                                                0:
                                                                                                    return -1
                                                                                                1:
                                                                                                    return -1
                                                                                        0:
                                                                                            return -1
                                                                                        1:
                                                                                            return -1
                                                                                0:
                                                                                    return -1
                                                                                1:
                                                                                    return -1
                                                                        0:
                                                                            return -1
                                                                        1:
                                                                            return -1
                                                                0:
                                                                    return -1
                                                                1:
                                                                    return -1
                                                        0:
                                                            return -1
                                                        1:
                                                            return -1
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_while_compare_v3(function_id: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut left_start: i64 = while_left_start(first, stop)
    mut left_stop: i64 = while_left_stop(first, stop)
    mut operator_start: i64 = while_operator_start(first, stop)
    mut operator_length: i64 = comparison_operator_length(operator_start, stop)
    match operator_length == 3:
        -1:
            discard 0
        0:
            return -1
        1:
            return -1
    mut right_start: i64 = skip_spaces(operator_start + operator_length, stop)
    mut right_cursor: i64 = right_start
    match read_byte(right_cursor) == 45:
        -1:
            right_cursor += 1
        0:
            discard 0
        1:
            discard 0
    mut right_stop: i64 = number_end(right_cursor, stop)
    match is_digit(read_byte(right_cursor)):
        -1:
            match skip_spaces(right_stop, stop) == stop:
                -1:
                    discard 0
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1
    mut left_type: i64 = resolve_value_type(header_start, header_end, first, left_start, left_stop)
    match left_type > 0:
        -1:
            mut storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
            match storage_id >= 0:
                -1:
                    mut body_start: i64 = line_end(source_line_start(first), s3_stage1_source_length()) + 1
                    mut body_stop: i64 = line_end(body_start, s3_stage1_source_length())
                    mut body_first: i64 = first_non_space(body_start, body_stop)
                    mut assignment_info: i64 = parse_assignment_expression_bounds(body_first, body_stop)
                    match assignment_info > 0:
                        -1:
                            mut target_start: i64 = body_first
                            mut target_stop: i64 = word_end(target_start, body_stop)
                            mut expression_start: i64 = assignment_info / 1000000
                            mut expression_end: i64 = assignment_info - expression_start * 1000000
                            mut additive_info: i64 = find_additive_operator(expression_start, expression_end)
                            match additive_info > 0:
                                -1:
                                    mut additive_operator: i64 = additive_info / 10
                                    mut body_left_end: i64 = trim_expression_end(expression_start, additive_operator)
                                    mut body_left_start: i64 = first_non_space(expression_start, body_left_end)
                                    mut body_left_stop: i64 = word_end(body_left_start, body_left_end)
                                    mut body_right_start: i64 = skip_spaces(additive_operator + 1, expression_end)
                                    mut body_right_stop: i64 = binary_right_operand_stop(body_right_start, expression_end)
                                    match same_span(target_start, target_stop, left_start, left_stop):
                                        -1:
                                            match same_span(body_left_start, body_left_stop, left_start, left_stop):
                                                -1:
                                                    match body_right_stop > 0:
                                                        -1:
                                                            match parse_literal_expression(body_right_start, body_right_stop) > 0:
                                                                -1:
                                                                    match skip_spaces(body_right_stop, expression_end) == expression_end:
                                                                        -1:
                                                                            mut after_body: i64 = while_body_end(first, s3_stage1_source_length())
                                                                            mut return_stop: i64 = line_end(after_body, s3_stage1_source_length())
                                                                            mut return_first: i64 = first_non_space(after_body, return_stop)
                                                                            mut return_info: i64 = parse_return(return_first, return_stop)
                                                                            match return_info < 0:
                                                                                -1:
                                                                                    mut return_target_info: i64 = 0 - return_info
                                                                                    mut return_start: i64 = return_target_info / 1000000
                                                                                    mut return_target_stop: i64 = return_target_info - return_start * 1000000
                                                                                    match same_span(return_start, return_target_stop, left_start, left_stop):
                                                                                        -1:
                                                                                            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                                                                            mut base_id: i64 = function_id * 1000000 + ordinal
                                                                                            mut entry_jump_id: i64 = base_id
                                                                                            mut condition_index_id: i64 = base_id + 1
                                                                                            mut condition_load_id: i64 = base_id + 2
                                                                                            mut condition_const_id: i64 = base_id + 3
                                                                                            mut compare_id: i64 = base_id + 4
                                                                                            mut branch_id: i64 = base_id + 5
                                                                                            mut body_index_id: i64 = base_id + 6
                                                                                            mut body_load_id: i64 = base_id + 7
                                                                                            mut body_const_id: i64 = base_id + 8
                                                                                            mut add_id: i64 = base_id + 9
                                                                                            mut store_index_id: i64 = base_id + 10
                                                                                            mut store_id: i64 = base_id + 11
                                                                                            mut body_jump_id: i64 = base_id + 12
                                                                                            mut exit_zero_jump_id: i64 = base_id + 13
                                                                                            mut exit_positive_jump_id: i64 = base_id + 14
                                                                                            mut final_const_id: i64 = base_id + 15
                                                                                            mut final_load_id: i64 = base_id + 16
                                                                                            mut final_return_id: i64 = base_id + 17
                                                                                            mut condition_index_value: i64 = value_id
                                                                                            mut condition_load_value: i64 = value_id + 1
                                                                                            mut condition_const_value: i64 = value_id + 2
                                                                                            mut compare_value: i64 = value_id + 3
                                                                                            mut body_index_value: i64 = value_id + 4
                                                                                            mut body_load_value: i64 = value_id + 5
                                                                                            mut body_const_value: i64 = value_id + 6
                                                                                            mut add_value: i64 = value_id + 7
                                                                                            mut store_index_value: i64 = value_id + 8
                                                                                            mut final_index_value: i64 = value_id + 9
                                                                                            mut final_load_value: i64 = value_id + 10
                                                                                            discard emit_v3_v(condition_index_value, function_id, 2, 2, left_start)
                                                                                            discard emit_v3_v(condition_load_value, function_id, 3, left_type, left_start)
                                                                                            discard emit_v3_v(condition_const_value, function_id, 2, left_type, right_start)
                                                                                            discard emit_v3_v(compare_value, function_id, 3, 1, operator_start)
                                                                                            discard emit_v3_v(body_index_value, function_id, 2, 2, target_start)
                                                                                            discard emit_v3_v(body_load_value, function_id, 3, left_type, target_start)
                                                                                            discard emit_v3_v(body_const_value, function_id, 2, left_type, body_right_start)
                                                                                            discard emit_v3_v(add_value, function_id, 3, left_type, additive_operator)
                                                                                            discard emit_v3_v(store_index_value, function_id, 2, 2, target_start)
                                                                                            discard emit_v3_v(final_index_value, function_id, 2, 2, return_start)
                                                                                            discard emit_v3_v(final_load_value, function_id, 3, left_type, return_start)
                                                                                            discard emit_v3_i_block(entry_jump_id, function_id, 0, ordinal, 24, 0, 0, -1, -1)
                                                                                            discard emit_v3_t_jump(entry_jump_id, 1)
                                                                                            discard emit_v3_i_block(condition_index_id, function_id, 1, ordinal + 1, 1, 1, 0, -1, 0)
                                                                                            discard emit_v3_r(condition_index_id, 0, condition_index_value)
                                                                                            discard emit_v3_i_block(condition_load_id, function_id, 1, ordinal + 2, 15, 1, 1, storage_id, -1)
                                                                                            discard emit_v3_o(condition_load_id, 0, condition_index_value)
                                                                                            discard emit_v3_r(condition_load_id, 0, condition_load_value)
                                                                                            discard emit_v3_i_block(condition_const_id, function_id, 1, ordinal + 3, 1, 1, 0, -1, parse_integer_literal(right_start, right_stop))
                                                                                            discard emit_v3_r(condition_const_id, 0, condition_const_value)
                                                                                            discard emit_v3_i_block(compare_id, function_id, 1, ordinal + 4, 13, 1, 2, -1, -1)
                                                                                            discard emit_v3_o(compare_id, 0, condition_load_value)
                                                                                            discard emit_v3_o(compare_id, 1, condition_const_value)
                                                                                            discard emit_v3_r(compare_id, 0, compare_value)
                                                                                            discard emit_v3_i_block(branch_id, function_id, 1, ordinal + 5, 25, 0, 1, -1, -1)
                                                                                            discard emit_v3_o(branch_id, 0, compare_value)
                                                                                            discard emit_v3_t_branch(branch_id, 2, 3, 4, compare_value)
                                                                                            discard emit_v3_i_block(body_index_id, function_id, 2, ordinal + 6, 1, 1, 0, -1, 0)
                                                                                            discard emit_v3_r(body_index_id, 0, body_index_value)
                                                                                            discard emit_v3_i_block(body_load_id, function_id, 2, ordinal + 7, 15, 1, 1, storage_id, -1)
                                                                                            discard emit_v3_o(body_load_id, 0, body_index_value)
                                                                                            discard emit_v3_r(body_load_id, 0, body_load_value)
                                                                                            discard emit_v3_i_block(body_const_id, function_id, 2, ordinal + 8, 1, 1, 0, -1, parse_integer_literal(body_right_start, body_right_stop))
                                                                                            discard emit_v3_r(body_const_id, 0, body_const_value)
                                                                                            discard emit_v3_i_block(add_id, function_id, 2, ordinal + 9, 5, 1, 2, -1, -1)
                                                                                            discard emit_v3_o(add_id, 0, body_load_value)
                                                                                            discard emit_v3_o(add_id, 1, body_const_value)
                                                                                            discard emit_v3_r(add_id, 0, add_value)
                                                                                            discard emit_v3_i_block(store_index_id, function_id, 2, ordinal + 10, 1, 1, 0, -1, 0)
                                                                                            discard emit_v3_r(store_index_id, 0, store_index_value)
                                                                                            discard emit_v3_i_block(store_id, function_id, 2, ordinal + 11, 16, 0, 2, storage_id, -1)
                                                                                            discard emit_v3_o(store_id, 0, store_index_value)
                                                                                            discard emit_v3_o(store_id, 1, add_value)
                                                                                            discard emit_v3_i_block(body_jump_id, function_id, 2, ordinal + 12, 24, 0, 0, -1, -1)
                                                                                            discard emit_v3_t_jump(body_jump_id, 1)
                                                                                            discard emit_v3_i_block(exit_zero_jump_id, function_id, 3, ordinal + 13, 24, 0, 0, -1, -1)
                                                                                            discard emit_v3_t_jump(exit_zero_jump_id, 5)
                                                                                            discard emit_v3_i_block(exit_positive_jump_id, function_id, 4, ordinal + 14, 24, 0, 0, -1, -1)
                                                                                            discard emit_v3_t_jump(exit_positive_jump_id, 5)
                                                                                            discard emit_v3_i_block(final_const_id, function_id, 5, ordinal + 15, 1, 1, 0, -1, 0)
                                                                                            discard emit_v3_r(final_const_id, 0, final_index_value)
                                                                                            discard emit_v3_i_block(final_load_id, function_id, 5, ordinal + 16, 15, 1, 1, storage_id, -1)
                                                                                            discard emit_v3_o(final_load_id, 0, final_index_value)
                                                                                            discard emit_v3_r(final_load_id, 0, final_load_value)
                                                                                            discard emit_v3_i_block(final_return_id, function_id, 5, ordinal + 17, 23, 0, 1, -1, -1)
                                                                                            discard emit_v3_o(final_return_id, 0, final_load_value)
                                                                                            discard emit_v3_t(final_return_id, final_load_value)
                                                                                            discard emit_v3_b_block(function_id, 0, 0, ordinal + 1, entry_jump_id)
                                                                                            discard emit_v3_b_block(function_id, 1, 1, 5, branch_id)
                                                                                            discard emit_v3_b_block(function_id, 2, 2, 7, body_jump_id)
                                                                                            discard emit_v3_b_block(function_id, 3, 3, 1, exit_zero_jump_id)
                                                                                            discard emit_v3_b_block(function_id, 4, 4, 1, exit_positive_jump_id)
                                                                                            discard emit_v3_b_block(function_id, 5, 5, 3, final_return_id)
                                                                                            mut encoded_next_id: i64 = value_id + 11
                                                                                            encoded_next_id = encoded_next_id * 1000000
                                                                                            encoded_next_id = encoded_next_id + return_stop + 2000000000000
                                                                                            return encoded_next_id
                                                                                        0:
                                                                                            return -1
                                                                                        1:
                                                                                            return -1
                                                                                0:
                                                                                    return -1
                                                                                1:
                                                                                    return -1
                                                                        0:
                                                                            return -1
                                                                        1:
                                                                            return -1
                                                                0:
                                                                    return -1
                                                                1:
                                                                    return -1
                                                        0:
                                                            return -1
                                                        1:
                                                            return -1
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1
fn scan_while_compare_mutable_right_v3(function_id: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut left_start: i64 = while_left_start(first, stop)
    mut left_stop: i64 = while_left_stop(first, stop)
    mut operator_start: i64 = while_operator_start(first, stop)
    mut right_start: i64 = skip_spaces(operator_start + 3, stop)
    mut right_stop: i64 = word_end(right_start, stop)
    mut left_type: i64 = resolve_value_type(header_start, header_end, first, left_start, left_stop)
    mut right_type: i64 = resolve_value_type(header_start, header_end, first, right_start, right_stop)
    match left_type > 0:
        -1:
            match right_type == left_type:
                -1:
                    mut left_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
                    mut right_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, right_start, right_stop)
                    match left_storage_id >= 0:
                        -1:
                            match right_storage_id >= 0:
                                -1:
                                    mut body_start: i64 = line_end(source_line_start(first), s3_stage1_source_length()) + 1
                                    mut body_stop: i64 = line_end(body_start, s3_stage1_source_length())
                                    mut body_first: i64 = first_non_space(body_start, body_stop)
                                    mut assignment_info: i64 = parse_assignment_expression_bounds(body_first, body_stop)
                                    match assignment_info > 0:
                                        -1:
                                            mut target_start: i64 = body_first
                                            mut target_stop: i64 = word_end(target_start, body_stop)
                                            mut expression_start: i64 = assignment_info / 1000000
                                            mut expression_end: i64 = assignment_info - expression_start * 1000000
                                            mut additive_info: i64 = find_additive_operator(expression_start, expression_end)
                                            match additive_info > 0:
                                                -1:
                                                    mut additive_operator: i64 = additive_info / 10
                                                    mut body_left_end: i64 = trim_expression_end(expression_start, additive_operator)
                                                    mut body_left_start: i64 = first_non_space(expression_start, body_left_end)
                                                    mut body_left_stop: i64 = word_end(body_left_start, body_left_end)
                                                    mut body_right_start: i64 = skip_spaces(additive_operator + 1, expression_end)
                                                    mut body_right_stop: i64 = binary_right_operand_stop(body_right_start, expression_end)
                                                    match same_span(target_start, target_stop, left_start, left_stop):
                                                        -1:
                                                            match same_span(body_left_start, body_left_stop, left_start, left_stop):
                                                                -1:
                                                                    match body_right_stop > 0:
                                                                        -1:
                                                                            match parse_literal_expression(body_right_start, body_right_stop) > 0:
                                                                                -1:
                                                                                    match skip_spaces(body_right_stop, expression_end) == expression_end:
