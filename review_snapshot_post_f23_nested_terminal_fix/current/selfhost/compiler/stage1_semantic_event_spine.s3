        0:
            discard 0
        1:
            discard 0
    mut nested_match_end: i64 = while_body_end(nested_match_start, length)
    mut continuation_start: i64 = nested_match_end
    mut continuation_stop: i64 = line_end(continuation_start, length)
    mut continuation_first: i64 = first_non_space(continuation_start, continuation_stop)
    outer_negative_body_stop = continuation_stop
    outer_neutral_label_start = outer_negative_body_stop + 1
    outer_neutral_label_stop = line_end(outer_neutral_label_start, length)
    outer_neutral_body_start = outer_neutral_label_stop + 1
    outer_neutral_body_stop = line_end(outer_neutral_body_start, length)
    outer_positive_label_start = outer_neutral_body_stop + 1
    outer_positive_label_stop = line_end(outer_positive_label_start, length)
    outer_positive_body_start = outer_positive_label_stop + 1
    outer_positive_body_stop = line_end(outer_positive_body_start, length)
    mut outer_after_start: i64 = while_body_end(first, length)
