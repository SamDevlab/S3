                -1:
                    cursor = skip_spaces(left_stop, end)
                    match expect_byte(cursor, end, 43):
                        -1:
                            cursor += 1
                            cursor = skip_spaces(cursor, end)
                            mut additive_start: i64 = cursor
                            match is_digit(read_byte(cursor)):
                                -1:
