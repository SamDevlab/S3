fn scan_while_relation_match_break_body_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut left_start: i64 = while_left_start(first, stop)
    mut left_stop: i64 = while_left_stop(first, stop)
    mut operator_start: i64 = while_operator_start(first, stop)
    mut operator_length: i64 = comparison_operator_length(operator_start, stop)
    mut right_start: i64 = skip_spaces(operator_start + operator_length, stop)
    mut right_stop: i64 = word_end(right_start, stop)
    mut left_type: i64 = resolve_value_type(header_start, header_end, first, left_start, left_stop)
    mut left_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
    mut right_type: i64 = find_parameter_type(header_start, header_end, right_start, right_stop)
    mut body_start: i64 = line_end(source_line_start(first), length) + 1
    mut body_stop: i64 = line_end(body_start, length)
    mut nested_match_start: i64 = first_non_space(body_start, body_stop)
    mut nested_match_stop: i64 = body_stop
    mut nested_match_info: i64 = parse_match_comparison(nested_match_start, nested_match_stop)
    mut nested_comparison_base: i64 = 1000000000000
    mut nested_left_start: i64 = nested_match_info / nested_comparison_base
    mut nested_comparison_remainder: i64 = nested_match_info - nested_left_start * nested_comparison_base
    mut nested_left_stop: i64 = nested_comparison_remainder / 1000000
    mut nested_literal_start: i64 = nested_comparison_remainder - nested_left_stop * 1000000
    mut nested_operator_start: i64 = skip_spaces(nested_left_stop, nested_match_stop)
    mut nested_operator_length: i64 = comparison_operator_length(nested_operator_start, nested_match_stop)
    mut nested_right_cursor: i64 = nested_literal_start
    mut nested_right_stop: i64 = number_end(nested_right_cursor, nested_match_stop)
    mut nested_branch_cursor: i64 = line_end(source_line_start(nested_match_start), length) + 1
    mut negative_label_stop: i64 = line_end(nested_branch_cursor, length)
    mut negative_body_start: i64 = negative_label_stop + 1
    mut negative_body_stop: i64 = line_end(negative_body_start, length)
    mut neutral_label_start: i64 = negative_body_stop + 1
    mut neutral_label_stop: i64 = line_end(neutral_label_start, length)
    mut neutral_body_start: i64 = neutral_label_stop + 1
    mut neutral_body_stop: i64 = line_end(neutral_body_start, length)
    mut positive_label_start: i64 = neutral_body_stop + 1
    mut positive_label_stop: i64 = line_end(positive_label_start, length)
    mut positive_body_start: i64 = positive_label_stop + 1
    mut positive_body_stop: i64 = line_end(positive_body_start, length)
    mut increment_start: i64 = positive_body_stop + 1
    mut increment_stop: i64 = line_end(increment_start, length)
    mut after_loop_start: i64 = while_body_end(first, length)
    mut after_loop_stop: i64 = line_end(after_loop_start, length)
    mut after_loop_first: i64 = first_non_space(after_loop_start, after_loop_stop)
    mut return_info: i64 = parse_return(after_loop_first, after_loop_stop)
    mut negative_first: i64 = first_non_space(negative_body_start, negative_body_stop)
    mut neutral_first: i64 = first_non_space(neutral_body_start, neutral_body_stop)
    mut positive_first: i64 = first_non_space(positive_body_start, positive_body_stop)
    mut negative_kind: i64 = match_branch_body_kind(negative_first, negative_body_stop)
    mut neutral_kind: i64 = match_branch_body_kind(neutral_first, neutral_body_stop)
    mut positive_kind: i64 = match_branch_body_kind(positive_first, positive_body_stop)
    mut current_block: i64 = v3_context_block_id(function_id)
    mut body_block: i64 = current_block + 2
    mut exit_zero_block: i64 = current_block + 3
    mut exit_positive_block: i64 = current_block + 4
    mut loop_exit_block: i64 = current_block + 5
    mut outer_successor_block: i64 = current_block + 6
    mut lane_first_block: i64 = current_block + 7
    mut lane_dispatch_block: i64 = current_block + 10
    mut nested_match_block: i64 = current_block + 11
    mut nested_negative_block: i64 = current_block + 12
    mut nested_neutral_block: i64 = current_block + 13
    mut nested_positive_block: i64 = current_block + 14
    mut nested_successor_block: i64 = current_block + 15
    mut valid: trit = -1
    match operator_length == 1:
        -1:
            match read_byte(operator_start) == 60:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match left_type > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_type == right_type:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_storage_id >= 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match right_type > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_match_info > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match same_span(nested_left_start, nested_left_stop, left_start, left_stop):
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_operator_length == 1:
        -1:
            match read_byte(nested_operator_start) == 60:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match is_digit(read_byte(nested_right_cursor)):
        -1:
            match expect_byte(nested_right_stop, nested_match_stop, 58):
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(nested_branch_cursor, negative_label_stop), negative_label_stop) == -1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(neutral_label_start, neutral_label_stop), neutral_label_stop) == 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(positive_label_start, positive_label_stop), positive_label_stop) == 1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match parse_break_statement(negative_first, negative_body_stop) > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match neutral_kind == 2:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match positive_kind == 2:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match parse_increment_statement(increment_start, increment_stop):
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match same_span(first_non_space(increment_start, increment_stop), word_end(first_non_space(increment_start, increment_stop), increment_stop), left_start, left_stop):
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match after_loop_start == increment_start:
        -1:
            valid = 0
        0:
            discard 0
        1:
            discard 0
    match return_info < 0:
        -1:
            mut return_target_info: i64 = 0 - return_info
            mut return_target_start: i64 = return_target_info / 1000000
            mut return_target_stop: i64 = return_target_info - return_target_start * 1000000
            match same_span(return_target_start, return_target_stop, left_start, left_stop):
                -1:
                    match return_type == left_type:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match valid == -1:
        -1:
            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
            mut base_id: i64 = function_id * 1000000 + ordinal + 100
            mut condition_index_id: i64 = base_id + 1
            mut condition_load_id: i64 = base_id + 2
            mut compare_id: i64 = base_id + 3
            mut condition_branch_id: i64 = base_id + 4
            mut body_jump_id: i64 = base_id + 5
            mut exit_zero_jump_id: i64 = base_id + 6
            mut exit_positive_jump_id: i64 = base_id + 7
            mut lane_first_id: i64 = base_id + 20
            mut dispatch_index_id: i64 = base_id + 34
            mut dispatch_load_id: i64 = base_id + 35
            mut dispatch_branch_id: i64 = base_id + 36
            mut nested_index_id: i64 = base_id + 40
            mut nested_load_id: i64 = base_id + 41
            mut nested_right_id: i64 = base_id + 42
            mut nested_compare_id: i64 = base_id + 43
            mut nested_branch_id: i64 = base_id + 44
            mut break_jump_id: i64 = base_id + 45
            mut neutral_jump_id: i64 = base_id + 46
            mut positive_jump_id: i64 = base_id + 47
            mut loop_exit_jump_id: i64 = base_id + 48
            mut condition_index_value: i64 = value_id
            mut condition_load_value: i64 = value_id + 1
            mut compare_value: i64 = value_id + 2
            mut dispatch_index_value: i64 = value_id + 3
            mut dispatch_load_value: i64 = value_id + 4
            mut negative_index_value: i64 = value_id + 5
            mut negative_result_value: i64 = value_id + 6
            mut neutral_index_value: i64 = value_id + 7
            mut neutral_result_value: i64 = value_id + 8
            mut positive_index_value: i64 = value_id + 9
            mut positive_result_value: i64 = value_id + 10
            mut nested_index_value: i64 = value_id + 11
            mut nested_load_value: i64 = value_id + 12
            mut nested_right_value: i64 = value_id + 13
            mut nested_compare_value: i64 = value_id + 14
            mut nested_after_value: i64 = value_id + 15
            mut temporary_storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
            discard emit_v3_m(function_id, temporary_storage_id, 1, 1, 1, operator_start)
            discard emit_v3_v(condition_index_value, function_id, 2, 2, left_start)
            discard emit_v3_v(condition_load_value, function_id, 3, left_type, left_start)
            discard emit_v3_v(compare_value, function_id, 3, 1, operator_start)
            discard emit_v3_v(dispatch_index_value, function_id, 2, 2, operator_start)
            discard emit_v3_v(dispatch_load_value, function_id, 3, 1, operator_start)
            discard emit_v3_v(negative_index_value, function_id, 2, 2, operator_start)
            discard emit_v3_v(negative_result_value, function_id, 2, 1, operator_start)
            discard emit_v3_v(neutral_index_value, function_id, 2, 2, operator_start)
            discard emit_v3_v(neutral_result_value, function_id, 2, 1, operator_start)
            discard emit_v3_v(positive_index_value, function_id, 2, 2, operator_start)
            discard emit_v3_v(positive_result_value, function_id, 2, 1, operator_start)
            discard emit_v3_v(nested_index_value, function_id, 2, 2, nested_left_start)
            discard emit_v3_v(nested_load_value, function_id, 3, left_type, nested_left_start)
            discard emit_v3_v(nested_right_value, function_id, 2, left_type, nested_literal_start)
            discard emit_v3_v(nested_compare_value, function_id, 3, 1, nested_operator_start)
            discard emit_v3_i_block(condition_index_id, function_id, current_block + 1, ordinal + 1, 1, 1, 0, -1, 0)
            discard emit_v3_r(condition_index_id, 0, condition_index_value)
            discard emit_v3_i_block(condition_load_id, function_id, current_block + 1, ordinal + 2, 15, 1, 1, left_storage_id, -1)
            discard emit_v3_o(condition_load_id, 0, condition_index_value)
            discard emit_v3_r(condition_load_id, 0, condition_load_value)
            discard emit_v3_i_block(compare_id, function_id, current_block + 1, ordinal + 3, 13, 1, 2, -1, -1)
            discard emit_v3_o(compare_id, 0, condition_load_value)
            discard emit_v3_o(compare_id, 1, find_parameter_ordinal(header_start, header_end, right_start, right_stop))
            discard emit_v3_r(compare_id, 0, compare_value)
            discard emit_v3_i_block(condition_branch_id, function_id, current_block + 1, ordinal + 4, 25, 0, 1, -1, -1)
            discard emit_v3_o(condition_branch_id, 0, compare_value)
            discard emit_v3_t_branch(condition_branch_id, lane_first_block, lane_first_block + 1, lane_first_block + 2, compare_value)
            discard emit_v3_relation_lane_group(function_id, operator_start, temporary_storage_id, lane_first_id, ordinal + 20, lane_first_block, lane_dispatch_block, negative_index_value, negative_result_value, neutral_index_value, neutral_result_value, positive_index_value, positive_result_value, 0)
            discard emit_v3_i_block(dispatch_index_id, function_id, lane_dispatch_block, ordinal + 34, 1, 1, 0, -1, 0)
            discard emit_v3_r(dispatch_index_id, 0, dispatch_index_value)
            discard emit_v3_i_block(dispatch_load_id, function_id, lane_dispatch_block, ordinal + 35, 15, 1, 1, temporary_storage_id, -1)
            discard emit_v3_o(dispatch_load_id, 0, dispatch_index_value)
            discard emit_v3_r(dispatch_load_id, 0, dispatch_load_value)
            discard emit_v3_i_block(dispatch_branch_id, function_id, lane_dispatch_block, ordinal + 36, 25, 0, 1, -1, -1)
            discard emit_v3_o(dispatch_branch_id, 0, dispatch_load_value)
            discard emit_v3_t_branch(dispatch_branch_id, body_block, exit_zero_block, exit_positive_block, dispatch_load_value)
            discard emit_v3_i_block(body_jump_id, function_id, body_block, ordinal + 5, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(body_jump_id, nested_match_block)
            discard emit_v3_i_block(nested_index_id, function_id, nested_match_block, ordinal + 40, 1, 1, 0, -1, 0)
            discard emit_v3_r(nested_index_id, 0, nested_index_value)
            discard emit_v3_i_block(nested_load_id, function_id, nested_match_block, ordinal + 41, 15, 1, 1, left_storage_id, -1)
            discard emit_v3_o(nested_load_id, 0, nested_index_value)
            discard emit_v3_r(nested_load_id, 0, nested_load_value)
            discard emit_v3_i_block(nested_right_id, function_id, nested_match_block, ordinal + 42, 1, 1, 0, -1, parse_integer_literal(nested_literal_start, nested_right_stop))
            discard emit_v3_r(nested_right_id, 0, nested_right_value)
            discard emit_v3_i_block(nested_compare_id, function_id, nested_match_block, ordinal + 43, 13, 1, 2, -1, -1)
            discard emit_v3_o(nested_compare_id, 0, nested_load_value)
            discard emit_v3_o(nested_compare_id, 1, nested_right_value)
            discard emit_v3_r(nested_compare_id, 0, nested_compare_value)
            discard emit_v3_i_block(nested_branch_id, function_id, nested_match_block, ordinal + 44, 25, 0, 1, -1, -1)
            discard emit_v3_o(nested_branch_id, 0, nested_compare_value)
            discard emit_v3_t_branch(nested_branch_id, nested_negative_block, nested_neutral_block, nested_positive_block, nested_compare_value)
            discard emit_v3_i_block(break_jump_id, function_id, nested_negative_block, ordinal + 45, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(break_jump_id, loop_exit_block)
            discard emit_v3_i_block(neutral_jump_id, function_id, nested_neutral_block, ordinal + 46, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(neutral_jump_id, nested_successor_block)
            discard emit_v3_i_block(positive_jump_id, function_id, nested_positive_block, ordinal + 47, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(positive_jump_id, nested_successor_block)
            mut increment_function_id: i64 = v3_context_function_id(v3_logical_function_id(function_id), nested_successor_block)
            mut increment_next_id: i64 = scan_increment_assignment_v3(increment_function_id, header_start, header_end, increment_start, increment_stop, nested_after_value)
            match increment_next_id >= 0:
                -1:
                    mut increment_ordinal: i64 = count_core_instructions_between(header_end + 1, increment_start)
                    mut increment_jump_id: i64 = increment_function_id * 1000000 + increment_ordinal + 6
                    discard emit_v3_i_block(increment_jump_id, increment_function_id, nested_successor_block, increment_ordinal + 6, 24, 0, 0, -1, -1)
                    discard emit_v3_t_jump(increment_jump_id, current_block + 1)
                    discard emit_v3_i_block(exit_zero_jump_id, function_id, exit_zero_block, ordinal + 6, 24, 0, 0, -1, -1)
                    discard emit_v3_t_jump(exit_zero_jump_id, loop_exit_block)
                    discard emit_v3_i_block(exit_positive_jump_id, function_id, exit_positive_block, ordinal + 7, 24, 0, 0, -1, -1)
                    discard emit_v3_t_jump(exit_positive_jump_id, loop_exit_block)
                    discard emit_v3_i_block(loop_exit_jump_id, function_id, loop_exit_block, ordinal + 48, 24, 0, 0, -1, -1)
                    discard emit_v3_t_jump(loop_exit_jump_id, outer_successor_block)
                    discard emit_v3_b_block(function_id, current_block, current_block, 1, condition_index_id)
                    discard emit_v3_b_block(function_id, current_block + 1, current_block + 1, 4, condition_branch_id)
                    discard emit_v3_b_block(function_id, body_block, body_block, 1, body_jump_id)
                    discard emit_v3_b_block(function_id, exit_zero_block, exit_zero_block, 1, exit_zero_jump_id)
                    discard emit_v3_b_block(function_id, exit_positive_block, exit_positive_block, 1, exit_positive_jump_id)
                    discard emit_v3_b_block(function_id, loop_exit_block, loop_exit_block, 1, loop_exit_jump_id)
                    discard emit_v3_b_block(function_id, lane_first_block, lane_first_block, 4, lane_first_id + 3)
                    discard emit_v3_b_block(function_id, lane_first_block + 1, lane_first_block + 1, 4, lane_first_id + 7)
                    discard emit_v3_b_block(function_id, lane_first_block + 2, lane_first_block + 2, 4, lane_first_id + 11)
                    discard emit_v3_b_block(function_id, lane_dispatch_block, lane_dispatch_block, 3, dispatch_branch_id)
                    discard emit_v3_b_block(function_id, nested_match_block, nested_match_block, 5, nested_branch_id)
                    discard emit_v3_b_block(function_id, nested_negative_block, nested_negative_block, 1, break_jump_id)
                    discard emit_v3_b_block(function_id, nested_neutral_block, nested_neutral_block, 1, neutral_jump_id)
                    discard emit_v3_b_block(function_id, nested_positive_block, nested_positive_block, 1, positive_jump_id)
                    discard emit_v3_b_block(function_id, nested_successor_block, nested_successor_block, 7, v3_context_instruction_id(increment_jump_id))
                    mut encoded_next_id: i64 = 3000000000000 + outer_successor_block * 100000000000
                    encoded_next_id = encoded_next_id + increment_next_id * 1000000 + after_loop_start
                    return encoded_next_id
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_while_relation_match_body_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut left_start: i64 = while_left_start(first, stop)
    mut left_stop: i64 = while_left_stop(first, stop)
    mut operator_start: i64 = while_operator_start(first, stop)
    mut operator_length: i64 = comparison_operator_length(operator_start, stop)
    mut right_start: i64 = skip_spaces(operator_start + operator_length, stop)
    mut right_cursor: i64 = right_start
    match read_byte(right_cursor) == 45:
        -1:
            right_cursor += 1
        0:
            discard 0
        1:
            discard 0
    mut right_stop: i64 = word_end(right_start, stop)
    mut right_is_literal: trit = 0
    match is_digit(read_byte(right_cursor)):
        -1:
            right_stop = number_end(right_cursor, stop)
            right_is_literal = -1
        0:
            discard 0
        1:
            discard 0
    mut left_type: i64 = resolve_value_type(header_start, header_end, first, left_start, left_stop)
    mut left_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
    mut right_type: i64 = find_parameter_type(header_start, header_end, right_start, right_stop)
    match right_is_literal == -1:
        -1:
            right_type = left_type
        0:
            discard 0
        1:
            discard 0
    mut body_start: i64 = line_end(source_line_start(first), length) + 1
    mut body_stop: i64 = line_end(body_start, length)
    mut nested_match_start: i64 = first_non_space(body_start, body_stop)
    mut nested_match_stop: i64 = body_stop
    mut nested_match_info: i64 = parse_match_comparison(nested_match_start, nested_match_stop)
    match nested_match_info > 0:
        -1:
            discard 0
        0:
            nested_match_info = parse_match_parameter_rhs_comparison(nested_match_start, nested_match_stop)
        1:
            discard 0
    mut nested_match_end: i64 = while_body_end(nested_match_start, length)
    mut negative_body_start: i64 = match_arm_body_start(nested_match_start, 0, length)
    mut negative_body_stop: i64 = match_arm_body_stop(negative_body_start, length)
    mut neutral_body_start: i64 = match_arm_body_start(nested_match_start, 1, length)
    mut neutral_body_stop: i64 = match_arm_body_stop(neutral_body_start, length)
    mut positive_body_start: i64 = match_arm_body_start(nested_match_start, 2, length)
    mut positive_body_stop: i64 = match_arm_body_stop(positive_body_start, length)
    mut increment_start: i64 = nested_match_end
    mut increment_stop: i64 = line_end(increment_start, length)
    mut after_loop_start: i64 = while_body_end(first, length)
    mut after_loop_stop: i64 = line_end(after_loop_start, length)
    mut after_loop_first: i64 = first_non_space(after_loop_start, after_loop_stop)
    mut return_info: i64 = parse_return(after_loop_first, after_loop_stop)
    mut after_loop_match_info: i64 = parse_match_comparison(after_loop_first, after_loop_stop)
    mut after_loop_successor_present: trit = 0
    match after_loop_first < after_loop_stop:
        -1:
            after_loop_successor_present = -1
        0:
            discard 0
        1:
            discard 0
    match after_loop_match_info > 0:
        -1:
            discard 0
        0:
            after_loop_match_info = parse_match_parameter_rhs_comparison(after_loop_first, after_loop_stop)
        1:
            discard 0
    mut nested_negative_first: i64 = first_non_space(negative_body_start, negative_body_stop)
    mut nested_neutral_first: i64 = first_non_space(neutral_body_start, neutral_body_stop)
    mut nested_positive_first: i64 = first_non_space(positive_body_start, positive_body_stop)
    mut negative_kind: i64 = match_arm_effect(negative_body_start, negative_body_stop)
    mut neutral_kind: i64 = match_arm_effect(neutral_body_start, neutral_body_stop)
    mut positive_kind: i64 = match_arm_effect(positive_body_start, positive_body_stop)
    mut increment_info: trit = parse_increment_statement(increment_start, increment_stop)
    mut current_block: i64 = v3_context_block_id(function_id)
    mut body_block: i64 = current_block + 2
    mut exit_zero_block: i64 = current_block + 3
    mut exit_positive_block: i64 = current_block + 4
    mut final_block: i64 = current_block + 20
    mut lane_first_block: i64 = current_block + 6
    mut lane_dispatch_block: i64 = current_block + 9
    mut nested_match_block: i64 = current_block + 10
    mut nested_successor_block: i64 = current_block + 14
    mut valid: trit = -1
    match operator_length > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_type > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_type == right_type:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_storage_id >= 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match right_type > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_match_info > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match negative_kind > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match neutral_kind > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match positive_kind > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match increment_info:
        -1:
            match same_span(first_non_space(increment_start, increment_stop), word_end(first_non_space(increment_start, increment_stop), increment_stop), left_start, left_stop):
                -1:
                    match after_loop_start == increment_start:
                        -1:
                            valid = 0
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            match after_loop_start == increment_start:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        1:
            valid = 0
    match return_info < 0:
        -1:
            mut return_target_info: i64 = 0 - return_info
            mut return_target_start: i64 = return_target_info / 1000000
            mut return_target_stop: i64 = return_target_info - return_target_start * 1000000
            match same_span(return_target_start, return_target_stop, left_start, left_stop):
                -1:
                    match return_type == left_type:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            match after_loop_successor_present == -1:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        1:
            valid = 0
    match valid == -1:
        -1:
            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
            mut base_id: i64 = function_id * 1000000 + ordinal + 100
            mut condition_index_id: i64 = base_id + 1
            mut condition_load_id: i64 = base_id + 2
            mut compare_id: i64 = base_id + 3
            mut condition_branch_id: i64 = base_id + 4
            mut entry_jump_id: i64 = base_id
            mut condition_const_id: i64 = base_id + 33
            mut body_jump_id: i64 = base_id + 5
            mut exit_zero_jump_id: i64 = base_id + 6
            mut exit_positive_jump_id: i64 = base_id + 7
            mut lane_first_id: i64 = base_id + 20
            mut dispatch_index_id: i64 = base_id + 34
            mut dispatch_load_id: i64 = base_id + 35
            mut dispatch_branch_id: i64 = base_id + 36
            mut condition_index_value: i64 = value_id
            mut condition_load_value: i64 = value_id + 1
            mut compare_value: i64 = value_id + 2
            mut dispatch_index_value: i64 = value_id + 3
            mut dispatch_load_value: i64 = value_id + 4
            mut negative_index_value: i64 = value_id + 5
            mut negative_result_value: i64 = value_id + 6
            mut neutral_index_value: i64 = value_id + 7
            mut neutral_result_value: i64 = value_id + 8
            mut positive_index_value: i64 = value_id + 9
            mut positive_result_value: i64 = value_id + 10
            mut nested_value_id: i64 = value_id + 11
            mut temporary_storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
            mut condition_instruction_count: i64 = 4
            mut condition_index_ordinal: i64 = ordinal + 1
            match right_is_literal == -1:
                -1:
                    condition_instruction_count = 5
                    condition_index_ordinal = ordinal + 2
                    condition_index_value = value_id + 1
                    condition_load_value = value_id + 2
                    compare_value = value_id + 3
                    dispatch_index_value = value_id + 4
                    dispatch_load_value = value_id + 5
                    negative_index_value = value_id + 6
                    negative_result_value = value_id + 7
                    neutral_index_value = value_id + 8
                    neutral_result_value = value_id + 9
                    positive_index_value = value_id + 10
                    positive_result_value = value_id + 11
                    nested_value_id = value_id + 12
                    discard emit_v3_v(value_id, function_id, 2, left_type, right_start)
                0:
                    discard 0
                1:
                    discard 0
            discard emit_v3_m(function_id, temporary_storage_id, 1, 1, 1, operator_start)
            discard emit_v3_v(condition_index_value, function_id, 2, 2, left_start)
            discard emit_v3_v(condition_load_value, function_id, 3, left_type, left_start)
            discard emit_v3_v(compare_value, function_id, 3, 1, operator_start)
            discard emit_v3_v(dispatch_index_value, function_id, 2, 2, operator_start)
            discard emit_v3_v(dispatch_load_value, function_id, 3, 1, operator_start)
            discard emit_v3_v(negative_index_value, function_id, 2, 2, operator_start)
            discard emit_v3_v(negative_result_value, function_id, 2, 1, operator_start)
            discard emit_v3_v(neutral_index_value, function_id, 2, 2, operator_start)
            discard emit_v3_v(neutral_result_value, function_id, 2, 1, operator_start)
            discard emit_v3_v(positive_index_value, function_id, 2, 2, operator_start)
            discard emit_v3_v(positive_result_value, function_id, 2, 1, operator_start)
            match right_is_literal == -1:
                -1:
                    discard emit_v3_i_block(condition_const_id, function_id, current_block + 1, ordinal + 1, 1, 1, 0, -1, parse_integer_literal(right_start, right_stop))
                    discard emit_v3_r(condition_const_id, 0, value_id)
                0:
                    discard 0
                1:
                    discard 0
            discard emit_v3_i_block(entry_jump_id, function_id, current_block, ordinal, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(entry_jump_id, current_block + 1)
            discard emit_v3_i_block(condition_index_id, function_id, current_block + 1, condition_index_ordinal, 1, 1, 0, -1, 0)
            discard emit_v3_r(condition_index_id, 0, condition_index_value)
            discard emit_v3_i_block(condition_load_id, function_id, current_block + 1, condition_index_ordinal + 1, 15, 1, 1, left_storage_id, -1)
            discard emit_v3_o(condition_load_id, 0, condition_index_value)
            discard emit_v3_r(condition_load_id, 0, condition_load_value)
            discard emit_v3_i_block(compare_id, function_id, current_block + 1, condition_index_ordinal + 2, 13, 1, 2, -1, -1)
            discard emit_v3_o(compare_id, 0, condition_load_value)
            match right_is_literal == -1:
                -1:
                    discard emit_v3_o(compare_id, 1, value_id)
                0:
                    discard emit_v3_o(compare_id, 1, find_parameter_ordinal(header_start, header_end, right_start, right_stop))
                1:
                    discard 0
            discard emit_v3_r(compare_id, 0, compare_value)
            discard emit_v3_i_block(condition_branch_id, function_id, current_block + 1, condition_index_ordinal + 3, 25, 0, 1, -1, -1)
            discard emit_v3_o(condition_branch_id, 0, compare_value)
            discard emit_v3_t_branch(condition_branch_id, lane_first_block, lane_first_block + 1, lane_first_block + 2, compare_value)
            discard emit_v3_relation_lane_group(function_id, operator_start, temporary_storage_id, lane_first_id, ordinal + 20, lane_first_block, lane_dispatch_block, negative_index_value, negative_result_value, neutral_index_value, neutral_result_value, positive_index_value, positive_result_value, 0)
            discard emit_v3_i_block(dispatch_index_id, function_id, lane_dispatch_block, ordinal + 34, 1, 1, 0, -1, 0)
            discard emit_v3_r(dispatch_index_id, 0, dispatch_index_value)
            discard emit_v3_i_block(dispatch_load_id, function_id, lane_dispatch_block, ordinal + 35, 15, 1, 1, temporary_storage_id, -1)
            discard emit_v3_o(dispatch_load_id, 0, dispatch_index_value)
            discard emit_v3_r(dispatch_load_id, 0, dispatch_load_value)
            discard emit_v3_i_block(dispatch_branch_id, function_id, lane_dispatch_block, ordinal + 36, 25, 0, 1, -1, -1)
            discard emit_v3_o(dispatch_branch_id, 0, dispatch_load_value)
            discard emit_v3_t_branch(dispatch_branch_id, body_block, exit_zero_block, exit_positive_block, dispatch_load_value)
            discard emit_v3_i_block(body_jump_id, function_id, body_block, ordinal + 5, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(body_jump_id, nested_match_block)
            mut nested_next_id: i64 = scan_match_relation_fallthrough_v3(function_id, return_type, header_start, header_end, nested_match_start, nested_match_stop, nested_match_info, nested_value_id, nested_match_block, nested_match_start, 0)
