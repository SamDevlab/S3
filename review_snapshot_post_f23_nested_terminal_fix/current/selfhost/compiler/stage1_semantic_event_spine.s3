                                                                1:
                                                                    return 0
                                                        0:
                                                            return 0
                                                        1:
                                                            return 0
                                                0:
                                                    mut right_cursor: i64 = right_start
                                                    match read_byte(right_cursor) == 45:
                                                        -1:
                                                            right_cursor += 1
                                                        0:
                                                            discard 0
                                                        1:
                                                            discard 0
                                                    match is_digit(read_byte(right_cursor)):
                                                        -1:
                                                            right_stop = number_end(right_cursor, end)
                                                            cursor = skip_spaces(right_stop, end)
                                                            match expect_byte(cursor, end, 58):
                                                                -1:
                                                                    cursor += 1
                                                                    cursor = skip_spaces(cursor, end)
                                                                    match cursor == end:
                                                                        -1:
                                                                            return additive_start
                                                                        0:
                                                                            return 0
                                                                        1:
