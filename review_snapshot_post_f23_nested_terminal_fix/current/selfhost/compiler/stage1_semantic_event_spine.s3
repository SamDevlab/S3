    discard emit_v3_field(v3_logical_function_id(function_id))
    discard emit_v3_field(1)
    discard emit_v3_field(name_start)
    discard emit_v3_field(name_length)
    discard emit_v3_field(parameter_count)
    discard emit_v3_field(result_count)
    discard emit_v3_char(10)
    return -1

fn emit_v3_b(function_id: i64, instruction_count: i64) -> trit:
    discard emit_v3_char(66)
    discard emit_v3_field(v3_logical_function_id(function_id))
    discard emit_v3_field(0)
    discard emit_v3_field(0)
    discard emit_v3_field(instruction_count)
    discard emit_v3_field(function_id * 1000000 + instruction_count - 1)
    discard emit_v3_char(10)
    return -1

