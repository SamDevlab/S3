            mut right_id: i64 = base_id + 2
            mut compare_id: i64 = base_id + 3
            mut branch_id: i64 = base_id + 4
            mut negative_jump_id: i64 = base_id + 5
            mut neutral_jump_id: i64 = base_id + 6
            mut positive_jump_id: i64 = base_id + 7
            mut left_index_value: i64 = value_id
            mut left_load_value: i64 = value_id + 1
