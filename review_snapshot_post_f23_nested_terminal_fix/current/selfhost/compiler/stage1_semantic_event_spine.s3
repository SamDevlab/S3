                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn find_local_type(body_start: i64, limit: i64, target_start: i64, target_end: i64) -> i64:
    mut cursor: i64 = body_start
    while cursor < limit:
        mut stop: i64 = line_end(cursor, limit)
