fn is_space(value: i64) -> trit:
    match value == 32:
        -1:
            return -1
        0:
            match value == 9:
                -1:
                    return -1
                0:
                    match value == 13:
                        -1:
                            return -1
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return -1
        1:
            return -1

fn is_digit(value: i64) -> trit:
    match value < 48:
        -1:
            return 0
        0:
            match value > 57:
                -1:
                    return 0
                0:
                    return -1
                1:
                    return 0
        1:
            return 0

fn is_identifier_start(value: i64) -> trit:
    match value == 95:
        -1:
            return -1
        0:
            match value < 65:
                -1:
                    return 0
                0:
                    match value > 90:
                        -1:
                            match value < 97:
                                -1:
                                    return 0
                                0:
                                    match value > 122:
                                        -1:
                                            return 0
                                        0:
                                            return -1
                                        1:
                                            return 0
                                1:
                                    return 0
                        0:
                            return -1
                        1:
                            return 0
                1:
                    return 0
        1:
            return -1

fn is_identifier_continue(value: i64) -> trit:
    match is_identifier_start(value):
        -1:
            return -1
        0:
            return is_digit(value)
        1:
            return is_digit(value)

fn identifier_hash(start: i64, end: i64) -> i64:
    mut cursor: i64 = start
    mut value: i64 = 0
    while cursor < end:
        value = value * 31 + read_byte(cursor)
        cursor += 1
    return value

fn skip_spaces(cursor: i64, length: i64) -> i64:
    mut position: i64 = cursor
    while position < length:
        match is_space(read_byte(position)):
            -1:
                position += 1
            0:
                return position
            1:
                return position
    return position

fn word_end(cursor: i64, length: i64) -> i64:
    mut position: i64 = cursor
    while position < length:
        match is_identifier_continue(read_byte(position)):
            -1:
                position += 1
            0:
                return position
            1:
                return position
    return position

fn number_end(cursor: i64, length: i64) -> i64:
    mut position: i64 = cursor
    while position < length:
        match is_digit(read_byte(position)):
            -1:
                position += 1
            0:
                return position
            1:
                return position
    return position

fn parse_integer_literal(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut negative: i64 = 0
    match read_byte(cursor) == 45:
        -1:
            negative = 1
            cursor += 1
        0:
            discard 0
        1:
            discard 0
    mut stop: i64 = number_end(cursor, end)
    mut value: i64 = 0
    while cursor < stop:
        value = value * 10 + read_byte(cursor) - 48
        cursor += 1
    match negative == 1:
        -1:
            return 0 - value
        0:
            return value
        1:
            return value

fn core_header_has_no_parameters(start: i64, end: i64) -> trit:
    mut cursor: i64 = skip_spaces(start + 2, end)
    cursor = word_end(cursor, end)
    cursor = skip_spaces(cursor, end)
    match expect_byte(cursor, end, 40):
        -1:
            cursor += 1
            cursor = skip_spaces(cursor, end)
            match read_byte(cursor) == 41:
                -1:
                    return -1
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_increment_statement(start: i64, end: i64) -> trit:
    mut target_start: i64 = first_non_space(start, end)
    mut target_stop: i64 = word_end(target_start, end)
    match is_identifier_span(target_start, target_stop):
        -1:
            mut operator_start: i64 = skip_spaces(target_stop, end)
            match expect_byte(operator_start, end, 43):
                -1:
                    match expect_byte(operator_start + 1, end, 61):
                        -1:
                            mut expression_start: i64 = skip_spaces(operator_start + 2, end)
                            match parse_literal_expression(expression_start, end) > 0:
                                -1:
                                    return -1
                                0:
                                    return -1
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn core_v3_line(first: i64, stop: i64) -> trit:
    match is_branch_label(first, stop):
        -1:
            return -1
        0:
            discard 0
        1:
            discard 0
    mut core_discard_call_start: i64 = skip_spaces(word_end(first, stop), stop)
    match word_is(first, word_end(first, stop), 91865680030, 7):
        -1:
            mut core_discard_call_info: i64 = parse_call_one_argument(core_discard_call_start, stop)
            match core_discard_call_info > 0:
                -1:
                    return -1
                0:
                    discard 0
                1:
                    discard 0
        0:
            discard 0
        1:
            discard 0
    mut core_discard_nested_additive_info: i64 = parse_discard_nested_additive_call(first, stop)
    match core_discard_nested_additive_info > 0:
        -1:
            return -1
        0:
            discard 0
        1:
            discard 0
    mut core_discard_nested_two_argument_info: i64 = parse_discard_nested_two_argument_call(first, stop)
    match core_discard_nested_two_argument_info > 0:
        -1:
            return -1
        0:
            discard 0
        1:
            discard 0
    mut match_info: i64 = parse_match_comparison(first, stop)
    match match_info > 0:
        -1:
            return -1
        0:
            mut match_call_info: i64 = parse_match_call(first, stop)
            match match_call_info > 0:
                -1:
                    return -1
                0:
                    mut match_nested_call_info: i64 = parse_match_nested_call(first, stop)
                    match match_nested_call_info > 0:
                        -1:
                            return -1
                        0:
                            mut match_parameter_info: i64 = parse_match_parameter_rhs_comparison(first, stop)
                            match match_parameter_info > 0:
                                -1:
                                    return -1
                                0:
                                    discard 0
                                1:
                                    discard 0
                        1:
                            discard 0
                1:
                    discard 0
        1:
            discard 0
    mut nested_additive_call_info: i64 = parse_match_nested_additive_call(first, stop)
    match nested_additive_call_info > 0:
        -1:
            return -1
        0:
            discard 0
        1:
            discard 0
    mut nested_call_relation_info: i64 = parse_match_nested_call_relation(first, stop)
    match nested_call_relation_info > 0:
        -1:
            return -1
        0:
            discard 0
