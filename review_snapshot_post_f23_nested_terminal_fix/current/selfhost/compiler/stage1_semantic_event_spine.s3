# Lower an outer comparison whose negative arm is a nested match followed by a
# terminal return.  The nested match keeps its own successor context; only the
# returned continuation is consumed by the outer terminal arm.
fn scan_match_nested_terminal_return_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64, current_block_start: i64) -> i64:
