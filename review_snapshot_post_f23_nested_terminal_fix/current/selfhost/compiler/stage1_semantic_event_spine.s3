                            1:
                                discard 0
                        next_id += 2
                    0:
                        discard 0
                    1:
                        discard 0
                mut mutable_identifier_info: i64 = parse_mut_identifier_initializer(first, stop)
                match mutable_identifier_info > 0:
                    -1:
                        mut mutable_identifier_type: i64 = mutable_identifier_info / 1000000000000000
                        mut mutable_identifier_remainder: i64 = mutable_identifier_info - mutable_identifier_type * 1000000000000000
                        mut mutable_identifier_name_start: i64 = mutable_identifier_remainder / 1000000000
                        mutable_identifier_remainder = mutable_identifier_remainder - mutable_identifier_name_start * 1000000000
                        mut mutable_identifier_name_length: i64 = mutable_identifier_remainder / 1000000
                        match same_span(mutable_identifier_name_start, mutable_identifier_name_start + mutable_identifier_name_length, target_start, target_stop):
                            -1:
