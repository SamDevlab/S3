foreign fn s3_stage1_source_length() -> i64
foreign fn s3_stage1_read_byte(index: i64) -> tryte
foreign fn s3_stage1_write_error_byte(value: tryte) -> tryte
foreign fn s3_stage1_write_byte(value: tryte) -> tryte
foreign fn s3_stage1_exit(status: i64) -> i64

fn read_byte(index: i64) -> i64:
    return to_i64(s3_stage1_read_byte(index))

fn emit_nonnegative(value: i64) -> trit:
    mut number: i64 = value
    match number < 0:
        -1:
            return 0
        0:
            discard 0
        1:
            discard 0
    match number == 0:
        -1:
            discard s3_stage1_write_error_byte(48)
            return -1
        0:
            discard 0
        1:
            discard 0
    mut divisor: i64 = 1
    mut probe: i64 = number
    while probe >= 10:
        probe = probe / 10
        divisor = divisor * 10
    while divisor > 0:
        mut digit: i64 = number / divisor
        discard s3_stage1_write_error_byte(to_tryte(digit + 48))
        number = number - digit * divisor
        divisor = divisor / 10
    return -1

fn emit_signed(value: i64) -> trit:
    match value < 0:
        -1:
            discard s3_stage1_write_error_byte(45)
            return emit_nonnegative(0 - value)
        0:
            return emit_nonnegative(value)
        1:
            return emit_nonnegative(value)

fn emit_field(value: i64) -> trit:
    discard s3_stage1_write_error_byte(32)
    return emit_signed(value)

fn emit_v(value_id: i64, function_id: i64, kind: i64, type_code: i64, anchor_start: i64, anchor_length: i64, mutable_flag: i64, storage_id: i64) -> trit:
    discard s3_stage1_write_error_byte(86)
    discard s3_stage1_write_error_byte(32)
    discard emit_field(value_id)
    discard emit_field(function_id)
    discard emit_field(kind)
    discard emit_field(type_code)
    discard emit_field(anchor_start)
    discard emit_field(anchor_length)
    discard emit_field(mutable_flag)
    discard emit_field(storage_id)
    discard s3_stage1_write_error_byte(10)
    return -1

fn emit_d(binding_id: i64, function_id: i64, kind: i64, type_code: i64, anchor_start: i64, anchor_length: i64, mutable_flag: i64, target_kind: i64, target_id: i64) -> trit:
    discard s3_stage1_write_error_byte(68)
    discard emit_field(binding_id)
    discard emit_field(function_id)
    discard emit_field(kind)
    discard emit_field(type_code)
    discard emit_field(anchor_start)
    discard emit_field(anchor_length)
    discard emit_field(mutable_flag)
    discard emit_field(target_kind)
    discard emit_field(target_id)
    discard s3_stage1_write_error_byte(10)
    return -1

fn emit_m(function_id: i64, storage_id: i64, type_code: i64, length: i64, mutable_flag: i64, anchor_start: i64) -> trit:
    discard s3_stage1_write_error_byte(77)
    discard emit_field(function_id)
    discard emit_field(storage_id)
    discard emit_field(type_code)
    discard emit_field(length)
    discard emit_field(mutable_flag)
    discard emit_field(anchor_start)
    discard s3_stage1_write_error_byte(10)
    return -1

fn emit_v3_char(value: i64) -> trit:
    discard s3_stage1_write_byte(to_tryte(value))
    return -1

fn emit_v3_nonnegative(value: i64) -> trit:
    mut number: i64 = value
    match number < 0:
        -1:
            return 0
        0:
            discard 0
        1:
            discard 0
    match number == 0:
        -1:
            discard emit_v3_char(48)
            return -1
        0:
            discard 0
        1:
            discard 0
    mut divisor: i64 = 1
    mut probe: i64 = number
    while probe >= 10:
        probe = probe / 10
        divisor = divisor * 10
    while divisor > 0:
        mut digit: i64 = number / divisor
        discard emit_v3_char(digit + 48)
        number = number - digit * divisor
        divisor = divisor / 10
    return -1

fn emit_v3_signed(value: i64) -> trit:
    match value < 0:
        -1:
            discard emit_v3_char(45)
            return emit_v3_nonnegative(0 - value)
        0:
            return emit_v3_nonnegative(value)
        1:
            return emit_v3_nonnegative(value)

fn emit_v3_field(value: i64) -> trit:
    discard emit_v3_char(32)
    return emit_v3_signed(value)

# V3 lowering carries a lexical successor block through the function-id
# argument.  The wire format still receives the logical function id, while
# legacy callers with an ordinary function id continue to target block 0.
fn v3_context_function_id(function_id: i64, block_id: i64) -> i64:
    return block_id * 1000000 + function_id

fn v3_logical_function_id(function_id: i64) -> i64:
    mut context_block: i64 = function_id / 1000000
    return function_id - context_block * 1000000

fn v3_context_block_id(function_id: i64) -> i64:
    return function_id / 1000000

fn v3_context_instruction_id(instruction_id: i64) -> i64:
    mut packed_function_id: i64 = instruction_id / 1000000
    mut ordinal: i64 = instruction_id - packed_function_id * 1000000
    mut context_block: i64 = packed_function_id / 1000000
    mut logical_function_id: i64 = packed_function_id - context_block * 1000000
    mut normalized_id: i64 = logical_function_id * 1000000 + ordinal
    match context_block > 0:
        -1:
            normalized_id = normalized_id + context_block * 1000000000
        0:
            discard 0
        1:
            discard 0
    return normalized_id

fn emit_v3_header() -> trit:
    discard emit_v3_char(83)
    discard emit_v3_char(51)
    discard emit_v3_char(73)
    discard emit_v3_char(82)
    discard emit_v3_char(50)
    discard emit_v3_char(32)
    discard emit_v3_char(51)
    discard emit_v3_char(10)
    return -1

fn emit_v3_f(function_id: i64, name_start: i64, name_length: i64, parameter_count: i64, result_count: i64) -> trit:
