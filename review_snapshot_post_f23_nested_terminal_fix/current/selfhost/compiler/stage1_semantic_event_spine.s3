                mut compound_literal_remainder: i64 = compound_product_literal_packed - compound_literal_type * 1000000000000000
                mut compound_literal_name_start: i64 = compound_literal_remainder / 1000000000
                compound_literal_remainder = compound_literal_remainder - compound_literal_name_start * 1000000000
                mut compound_literal_name_length: i64 = compound_literal_remainder / 1000000
                match same_span(compound_literal_name_start, compound_literal_name_start + compound_literal_name_length, target_start, target_end):
                    -1:
                        return compound_literal_type
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        mut binary_literal_packed: i64 = parse_mut_binary_literal(first, stop)
        match binary_literal_packed > 0:
            -1:
                mut literal_type: i64 = binary_literal_packed / 1000000000000000
                mut literal_remainder: i64 = binary_literal_packed - literal_type * 1000000000000000
                mut literal_name_start: i64 = literal_remainder / 1000000000
                literal_remainder = literal_remainder - literal_name_start * 1000000000
                mut literal_name_length: i64 = literal_remainder / 1000000
                match same_span(literal_name_start, literal_name_start + literal_name_length, target_start, target_end):
                    -1:
                        return literal_type
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        mut compound_packed: i64 = parse_mut_compound_product_identifier(first, stop)
        match compound_packed > 0:
            -1:
                mut compound_type: i64 = compound_packed / 1000000000000000
                mut compound_remainder: i64 = compound_packed - compound_type * 1000000000000000
                mut compound_name_start: i64 = compound_remainder / 1000000000
                compound_remainder = compound_remainder - compound_name_start * 1000000000
                mut compound_name_length: i64 = compound_remainder / 1000000
                match same_span(compound_name_start, compound_name_start + compound_name_length, target_start, target_end):
                    -1:
                        return compound_type
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        mut binary_packed: i64 = parse_mut_binary_identifier(first, stop)
        match binary_packed > 0:
            -1:
                mut binary_type: i64 = binary_packed / 1000000000000000
                mut binary_remainder: i64 = binary_packed - binary_type * 1000000000000000
                mut binary_name_start: i64 = binary_remainder / 1000000000
                binary_remainder = binary_remainder - binary_name_start * 1000000000
                mut binary_name_length: i64 = binary_remainder / 1000000
                match same_span(binary_name_start, binary_name_start + binary_name_length, target_start, target_end):
                    -1:
                        return binary_type
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        mut identifier_packed: i64 = parse_mut_identifier(first, stop)
        match identifier_packed > 0:
            -1:
                mut identifier_type: i64 = identifier_packed / 1000000000000000
                mut identifier_remainder: i64 = identifier_packed - identifier_type * 1000000000000000
                mut identifier_name_start: i64 = identifier_remainder / 1000000000
                identifier_remainder = identifier_remainder - identifier_name_start * 1000000000
                mut identifier_name_length: i64 = identifier_remainder / 1000000
                match same_span(identifier_name_start, identifier_name_start + identifier_name_length, target_start, target_end):
                    -1:
                        return identifier_type
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        match packed == 0:
            -1:
                packed = parse_mut_identifier(first, stop)
                match packed == 0:
                    -1:
                        mut call_type: i64 = find_call_local_type(first, stop, target_start, target_end)
                        match call_type > 0:
                            -1:
                                return call_type
                            0:
                                discard 0
                            1:
                                discard 0
                    0:
                        packed = parse_mut_additive(first, stop)
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        mut immutable_packed: i64 = parse_immutable_literal(first, stop, 1)
        match immutable_packed > 0:
            -1:
                mut immutable_type: i64 = immutable_packed / 1000000000000000
                mut immutable_remainder: i64 = immutable_packed - immutable_type * 1000000000000000
                mut immutable_name_start: i64 = immutable_remainder / 1000000000
                immutable_remainder = immutable_remainder - immutable_name_start * 1000000000
                mut immutable_name_length: i64 = immutable_remainder / 1000000
                match same_span(immutable_name_start, immutable_name_start + immutable_name_length, target_start, target_end):
