            1:
                discard 0
        match packed > 0:
            -1:
                mut parsed_type: i64 = packed / 1000000000000000
                mut remainder: i64 = packed - parsed_type * 1000000000000000
                mut name_start: i64 = remainder / 1000000000
                remainder = remainder - name_start * 1000000000
                mut name_length: i64 = remainder / 1000000
                match same_span(name_start, name_start + name_length, target_start, target_end):
                    -1:
                        return parsed_type
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        cursor = stop + 1
    return 0

fn emit_call_binding(function_id: i64, packed: i64, value_id: i64) -> i64:
    mut parsed_type: i64 = packed / 1000000000000
    mut remainder: i64 = packed - parsed_type * 1000000000000
    mut name_start: i64 = remainder / 1000000
    mut name_stop: i64 = remainder - name_start * 1000000
    discard emit_v(value_id, function_id, 2, parsed_type, name_start, name_stop - name_start, 1, -1)
    return value_id + 1

fn foreign_fn_start(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 93811605716, 7):
        -1:
            cursor = skip_spaces(word_stop, end)
            word_stop = word_end(cursor, end)
            match word_is(cursor, word_stop, 3272, 2):
                -1:
                    return cursor
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn scan_foreign_parameters(starting_function_id: i64, starting_value_id: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut cursor: i64 = 0
    mut foreign_index: i64 = 0
    mut next_id: i64 = starting_value_id
    while cursor < length:
        mut stop: i64 = line_end(cursor, length)
        mut first: i64 = first_non_space(cursor, stop)
        match first == cursor:
            -1:
                mut foreign_info: i64 = parse_foreign_header(first, stop)
                match foreign_info > 0:
                    -1:
                        mut function_start: i64 = foreign_fn_start(first, stop)
                        match function_start > 0:
                            -1:
                                mut function_id: i64 = starting_function_id + foreign_index
                                mut emitted_id: i64 = emit_parameters(function_start, stop, function_id, next_id)
                                match emitted_id >= 0:
                                    -1:
                                        next_id = emitted_id
                                        foreign_index += 1
                                    0:
                                        return -1
                                    1:
                                        return -1
                            0:
                                return -1
                            1:
                                return -1
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        cursor = stop + 1
    return next_id

fn is_return_line(start: i64, end: i64) -> trit:
    return word_is(start, word_end(start, end), 3360570672, 6)

fn validate_match_identifier_comparison(header_start: i64, header_end: i64, body_limit: i64, first: i64, stop: i64, comparison_info: i64) -> i64:
    mut comparison_base: i64 = 1000000000000
    mut left_start: i64 = comparison_info / comparison_base
    mut remainder: i64 = comparison_info - left_start * comparison_base
    mut left_stop: i64 = remainder / 1000000
    mut operator_start: i64 = remainder - left_stop * 1000000
    mut operator_length: i64 = comparison_operator_length(operator_start, stop)
    mut right_start: i64 = skip_spaces(operator_start + operator_length, stop)
    mut right_stop: i64 = word_end(right_start, stop)
    mut left_type: i64 = resolve_value_type(header_start, header_end, body_limit, left_start, left_stop)
    mut right_type: i64 = resolve_value_type(header_start, header_end, body_limit, right_start, right_stop)
    match left_type > 0:
        -1:
            match right_type == left_type:
                -1:
                    return left_type
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn scan_match_identifier_comparison(mode: i64, function_id: i64, header_start: i64, header_end: i64, first: i64, stop: i64, comparison_info: i64, value_id: i64) -> i64:
    mut comparison_base: i64 = 1000000000000
    mut left_start: i64 = comparison_info / comparison_base
    mut remainder: i64 = comparison_info - left_start * comparison_base
    mut left_stop: i64 = remainder / 1000000
    mut operator_start: i64 = remainder - left_stop * 1000000
    mut left_type: i64 = validate_match_identifier_comparison(header_start, header_end, first, first, stop, comparison_info)
    match left_type > 0:
        -1:
            mut next_id: i64 = value_id
            discard record_v(mode, next_id, function_id, 3, 2, left_start, 0, 0, -1)
            next_id += 1
            discard record_v(mode, next_id, function_id, 4, left_type, left_start, 0, 0, -1)
            next_id += 1
            discard record_v(mode, next_id, function_id, 4, 1, operator_start, 0, 0, -1)
            next_id += 1
            discard record_v(mode, next_id, function_id, 3, 2, operator_start, 0, 0, -1)
            next_id += 1
            discard record_v(mode, next_id, function_id, 3, 1, operator_start, 0, 0, -1)
            next_id += 1
            discard record_v(mode, next_id, function_id, 3, 2, operator_start, 0, 0, -1)
            next_id += 1
            discard record_v(mode, next_id, function_id, 3, 1, operator_start, 0, 0, -1)
            next_id += 1
            discard record_v(mode, next_id, function_id, 3, 2, operator_start, 0, 0, -1)
            next_id += 1
            discard record_v(mode, next_id, function_id, 3, 1, operator_start, 0, 0, -1)
            next_id += 1
            discard record_v(mode, next_id, function_id, 3, 2, operator_start, 0, 0, -1)
            next_id += 1
            discard record_v(mode, next_id, function_id, 4, 1, operator_start, 0, 0, -1)
            return next_id + 1
        0:
            return -1
        1:
            return -1

fn scan_match_call(mode: i64, function_id: i64, header_start: i64, header_end: i64, body_limit: i64, expression_start: i64, stop: i64, call_info: i64, value_id: i64) -> i64:
    mut callee_start: i64 = call_info / 1000000
    mut callee_stop: i64 = call_info - callee_start * 1000000
    mut open_start: i64 = skip_spaces(callee_stop, stop)
    mut call_end: i64 = call_expression_end(expression_start)
    mut close: i64 = call_end - 1
    mut argument_start: i64 = skip_spaces(open_start + 1, close)
    match read_byte(argument_start) == 41:
        -1:
            return -1
        0:
            mut parameter_type: i64 = find_parameter_type(header_start, header_end, argument_start, word_end(argument_start, close))
            match parameter_type > 0:
                -1:
                    mut call_return_type: i64 = parse_call_return_type(expression_start, header_start, header_end)
                    match call_return_type == 1:
                        -1:
                            match mode == 1:
                                -1:
                                    discard emit_v(value_id, function_id, 4, 1, callee_start, 0, 0, -1)
                                    return value_id + 1
                                0:
                                    return value_id + 1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return scan_call_atom(mode, function_id, header_start, header_end, body_limit, 1, expression_start, call_end, value_id)
                1:
                    return -1
        1:
            return -1

fn scan_match_call_fallthrough_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, call_info: i64, value_id: i64, current_block_id: i64, current_block_start: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut callee_start: i64 = call_info / 1000000
    mut callee_stop: i64 = call_info - callee_start * 1000000
    mut expression_start: i64 = skip_spaces(word_end(first, stop), stop)
    mut call_end: i64 = call_expression_end(expression_start)
    mut call_open: i64 = skip_spaces(callee_stop, call_end)
    mut argument_start: i64 = first_non_space(call_open + 1, call_end - 1)
    mut argument_stop: i64 = word_end(argument_start, call_end - 1)
    mut signature: i64 = find_function_signature(callee_start, callee_stop)
    mut call_return_type: i64 = 0
    mut parameter_type: i64 = 0
    mut argument_type: i64 = resolve_value_type(header_start, header_end, first, argument_start, argument_stop)
    mut argument_span: i64 = parse_call_argument_span(expression_start, call_end, 0)
    mut argument_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, argument_start, argument_stop)
    mut argument_value_id: i64 = value_id
    mut next_value_id: i64 = value_id
    mut condition_instruction_count: i64 = 2
    mut valid: trit = -1
    mut branch_cursor: i64 = line_end(source_line_start(first), length) + 1
    mut negative_label_stop: i64 = line_end(branch_cursor, length)
    mut negative_body_start: i64 = negative_label_stop + 1
    mut negative_body_stop: i64 = match_arm_body_stop(negative_body_start, length)
    mut neutral_label_start: i64 = negative_body_stop + 1
    mut neutral_label_stop: i64 = line_end(neutral_label_start, length)
    mut neutral_body_start: i64 = neutral_label_stop + 1
    mut neutral_body_stop: i64 = match_arm_body_stop(neutral_body_start, length)
    mut positive_label_start: i64 = neutral_body_stop + 1
    mut positive_label_stop: i64 = line_end(positive_label_start, length)
    mut positive_body_start: i64 = positive_label_stop + 1
    mut positive_body_stop: i64 = match_arm_body_stop(positive_body_start, length)
    mut negative_body_first: i64 = match_arm_body_start(first, 0, length)
    mut neutral_body_first: i64 = match_arm_body_start(first, 1, length)
    mut positive_body_first: i64 = match_arm_body_start(first, 2, length)
    mut negative_kind: i64 = match_arm_effect(negative_body_first, negative_body_stop)
    mut neutral_kind: i64 = match_arm_effect(neutral_body_first, neutral_body_stop)
    mut positive_kind: i64 = match_arm_effect(positive_body_first, positive_body_stop)
    match signature > 0:
        -1:
            call_return_type = signature / 100
            parameter_type = find_function_parameter_type_by_ordinal(callee_start, callee_stop, 0)
        0:
            valid = 0
        1:
            valid = 0
    match call_return_type == 1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match call_argument_type_matches(argument_type, parameter_type):
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match argument_span > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(branch_cursor, negative_label_stop), negative_label_stop) == -1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(neutral_label_start, neutral_label_stop), neutral_label_stop) == 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(positive_label_start, positive_label_stop), positive_label_stop) == 1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match argument_storage_id >= 0:
        -1:
            condition_instruction_count = 4
        0:
            match find_parameter_ordinal(header_start, header_end, argument_start, argument_stop) >= 0:
                -1:
                    discard 0
                0:
                    match find_core_local_value_id(header_end + 1, first, argument_start, argument_stop) >= 0:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                1:
                    discard 0
        1:
            valid = 0
    match valid == -1:
        -1:
            mut ordinal: i64 = count_core_instructions_between(current_block_start, first)
            mut base_id: i64 = function_id * 1000000 + ordinal
            mut argument_index_id: i64 = base_id
            mut argument_load_id: i64 = base_id
            mut call_id: i64 = base_id
            mut branch_id: i64 = base_id + 1
            match argument_storage_id >= 0:
                -1:
                    argument_value_id = value_id + 1
                    next_value_id = value_id + 2
                    call_id = base_id + 2
                    branch_id = base_id + 3
                    discard emit_v3_v(value_id, function_id, 2, 2, argument_start)
                    discard emit_v3_v(argument_value_id, function_id, 3, argument_type, argument_start)
                    discard emit_v3_i_block(argument_index_id, function_id, current_block_id, ordinal, 1, 1, 0, -1, 0)
                    discard emit_v3_r(argument_index_id, 0, value_id)
                    discard emit_v3_i_block(argument_load_id, function_id, current_block_id, ordinal + 1, 15, 1, 1, argument_storage_id, -1)
                    discard emit_v3_o(argument_load_id, 0, value_id)
                    discard emit_v3_r(argument_load_id, 0, argument_value_id)
                0:
                    mut parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, argument_start, argument_stop)
                    match parameter_ordinal >= 0:
                        -1:
                            argument_value_id = value_id - count_header_parameters(header_start, header_end) + parameter_ordinal
                        0:
                            argument_value_id = find_core_local_value_id(header_end + 1, first, argument_start, argument_stop)
                        1:
                            argument_value_id = find_core_local_value_id(header_end + 1, first, argument_start, argument_stop)
                    next_value_id = value_id
                1:
                    valid = 0
            mut call_identity: i64 = find_function_identity(callee_start, callee_stop)
            match call_identity > 0:
                -1:
                    mut callee_function_id: i64 = call_identity / 10
                    mut callee_kind: i64 = call_identity - callee_function_id * 10
                    mut call_value_id: i64 = next_value_id
                    mut negative_block: i64 = match_arm_block(current_block_id, 0)
                    mut neutral_block: i64 = match_arm_block(current_block_id, 1)
                    mut positive_block: i64 = match_arm_block(current_block_id, 2)
                    mut successor_block: i64 = match_successor_block(current_block_id)
                    discard emit_v3_v(call_value_id, function_id, 4, call_return_type, callee_start)
                    discard emit_v3_i_block(call_id, function_id, current_block_id, ordinal + condition_instruction_count - 2, 14, 1, 1, -1, -1)
                    discard emit_v3_c(call_id, callee_function_id, callee_kind, callee_start, callee_stop - callee_start)
                    discard emit_v3_a(call_id, 0, argument_value_id)
                    discard emit_v3_o(call_id, 0, argument_value_id)
                    discard emit_v3_r(call_id, 0, call_value_id)
                    discard emit_v3_i_block(branch_id, function_id, current_block_id, ordinal + condition_instruction_count - 1, 25, 0, 1, -1, -1)
                    discard emit_v3_o(branch_id, 0, call_value_id)
                    discard emit_v3_t_branch(branch_id, negative_block, neutral_block, positive_block, call_value_id)
                    mut negative_next_id: i64 = next_value_id + 1
                    mut neutral_next_id: i64 = negative_next_id
                    mut positive_next_id: i64 = negative_next_id
                    match negative_kind == 1:
                        -1:
                            negative_next_id = scan_statement_body(2, v3_context_function_id(v3_logical_function_id(function_id), negative_block), return_type, header_start, header_end, negative_body_first, negative_body_stop, negative_next_id)
                            match negative_next_id >= 0:
                                -1:
                                    neutral_next_id = negative_next_id
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            match negative_kind > 1:
                                -1:
                                    negative_next_id = scan_match_fallthrough_arm_v3(v3_context_function_id(v3_logical_function_id(function_id), negative_block), return_type, header_start, header_end, negative_body_first, negative_body_stop, negative_block, successor_block, negative_next_id)
                                    match negative_next_id >= 0:
                                        -1:
                                            neutral_next_id = negative_next_id
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        1:
                            return -1
                    match neutral_kind == 1:
                        -1:
                            neutral_next_id = scan_statement_body(2, v3_context_function_id(v3_logical_function_id(function_id), neutral_block), return_type, header_start, header_end, neutral_body_first, neutral_body_stop, neutral_next_id)
                            match neutral_next_id >= 0:
                                -1:
                                    positive_next_id = neutral_next_id
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            match neutral_kind > 1:
                                -1:
                                    neutral_next_id = scan_match_fallthrough_arm_v3(v3_context_function_id(v3_logical_function_id(function_id), neutral_block), return_type, header_start, header_end, neutral_body_first, neutral_body_stop, neutral_block, successor_block, neutral_next_id)
                                    match neutral_next_id >= 0:
                                        -1:
                                            positive_next_id = neutral_next_id
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        1:
                            return -1
                    match positive_kind == 1:
                        -1:
                            positive_next_id = scan_statement_body(2, v3_context_function_id(v3_logical_function_id(function_id), positive_block), return_type, header_start, header_end, positive_body_first, positive_body_stop, positive_next_id)
                            match positive_next_id >= 0:
                                -1:
                                    next_value_id = positive_next_id
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            match positive_kind > 1:
                                -1:
                                    positive_next_id = scan_match_fallthrough_arm_v3(v3_context_function_id(v3_logical_function_id(function_id), positive_block), return_type, header_start, header_end, positive_body_first, positive_body_stop, positive_block, successor_block, positive_next_id)
                                    match positive_next_id >= 0:
                                        -1:
                                            next_value_id = positive_next_id
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        1:
                            return -1
                    discard emit_v3_b_block(function_id, current_block_id, current_block_id, count_core_instructions_between(current_block_start, first) + condition_instruction_count, v3_context_instruction_id(branch_id))
                    match negative_kind == 1:
                        -1:
                            discard emit_v3_b_block(function_id, negative_block, negative_block, count_core_instructions_between(negative_body_first, negative_body_stop), v3_context_instruction_id(v3_context_function_id(v3_logical_function_id(function_id), negative_block) * 1000000 + count_core_instructions_between(header_end + 1, negative_body_first) + count_core_instructions_between(negative_body_first, negative_body_stop) - 1))
                        0:
                            discard 0
                        1:
                            discard 0
                    match negative_kind > 1:
                        -1:
                            mut negative_body_instruction_count: i64 = count_core_instructions_between(negative_body_first, negative_body_stop)
                            mut negative_jump_ordinal: i64 = count_core_instructions_between(header_end + 1, negative_body_stop)
                            mut negative_context_function_id: i64 = v3_context_function_id(v3_logical_function_id(function_id), negative_block)
                            discard emit_v3_b_block(function_id, negative_block, negative_block, negative_body_instruction_count + 1, v3_context_instruction_id(negative_context_function_id * 1000000 + negative_jump_ordinal))
                        0:
                            discard 0
                        1:
                            discard 0
                    match neutral_kind == 1:
                        -1:
                            discard emit_v3_b_block(function_id, neutral_block, neutral_block, count_core_instructions_between(neutral_body_first, neutral_body_stop), v3_context_instruction_id(v3_context_function_id(v3_logical_function_id(function_id), neutral_block) * 1000000 + count_core_instructions_between(header_end + 1, neutral_body_first) + count_core_instructions_between(neutral_body_first, neutral_body_stop) - 1))
                        0:
                            discard 0
                        1:
                            discard 0
                    match neutral_kind > 1:
                        -1:
                            mut neutral_body_instruction_count: i64 = count_core_instructions_between(neutral_body_first, neutral_body_stop)
                            mut neutral_jump_ordinal: i64 = count_core_instructions_between(header_end + 1, neutral_body_stop)
                            mut neutral_context_function_id: i64 = v3_context_function_id(v3_logical_function_id(function_id), neutral_block)
                            discard emit_v3_b_block(function_id, neutral_block, neutral_block, neutral_body_instruction_count + 1, v3_context_instruction_id(neutral_context_function_id * 1000000 + neutral_jump_ordinal))
                        0:
                            discard 0
                        1:
                            discard 0
                    match positive_kind == 1:
                        -1:
                            discard emit_v3_b_block(function_id, positive_block, positive_block, count_core_instructions_between(positive_body_first, positive_body_stop), v3_context_instruction_id(v3_context_function_id(v3_logical_function_id(function_id), positive_block) * 1000000 + count_core_instructions_between(header_end + 1, positive_body_first) + count_core_instructions_between(positive_body_first, positive_body_stop) - 1))
                        0:
                            discard 0
                        1:
                            discard 0
                    match positive_kind > 1:
                        -1:
                            mut positive_body_instruction_count: i64 = count_core_instructions_between(positive_body_first, positive_body_stop)
                            mut positive_jump_ordinal: i64 = count_core_instructions_between(header_end + 1, positive_body_stop)
                            mut positive_context_function_id: i64 = v3_context_function_id(v3_logical_function_id(function_id), positive_block)
                            discard emit_v3_b_block(function_id, positive_block, positive_block, positive_body_instruction_count + 1, v3_context_instruction_id(positive_context_function_id * 1000000 + positive_jump_ordinal))
                        0:
                            discard 0
                        1:
                            discard 0
                    match match_all_arms_terminal(negative_kind, neutral_kind, positive_kind):
                        -1:
                            return match_result_terminal(next_value_id, positive_body_stop + 1)
                        0:
                            return match_result_continuation(next_value_id, positive_body_stop + 1, successor_block)
                        1:
                            return match_result_continuation(next_value_id, positive_body_stop + 1, successor_block)
                0:
                    return -1
                1:
                    return -1
        0:
            return 0
        1:
            return 0

fn scan_pack_token_nested_hash_return_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut expression_start: i64 = skip_spaces(word_end(first, stop), stop)
    mut pack_name_start: i64 = first_non_space(expression_start, stop)
    mut pack_name_stop: i64 = word_end(pack_name_start, stop)
    mut pack_open: i64 = skip_spaces(pack_name_stop, stop)
    mut pack_close: i64 = matching_close(pack_open, stop)
    mut first_argument_start: i64 = first_non_space(pack_open + 1, pack_close)
    mut first_argument_stop: i64 = word_end(first_argument_start, pack_close)
    mut first_comma: i64 = skip_spaces(first_argument_stop, pack_close)
    mut second_argument_start: i64 = first_non_space(first_comma + 1, pack_close)
    mut second_argument_stop: i64 = word_end(second_argument_start, pack_close)
    mut second_comma: i64 = skip_spaces(second_argument_stop, pack_close)
    mut third_argument_start: i64 = first_non_space(second_comma + 1, pack_close)
    mut third_argument_stop: i64 = word_end(third_argument_start, pack_close)
    mut hash_name_start: i64 = third_argument_start
    mut hash_name_stop: i64 = word_end(hash_name_start, pack_close)
    mut hash_open: i64 = skip_spaces(hash_name_stop, pack_close)
    mut hash_close: i64 = matching_close(hash_open, pack_close)
    mut hash_first_start: i64 = first_non_space(hash_open + 1, hash_close)
    mut hash_first_stop: i64 = word_end(hash_first_start, hash_close)
    mut hash_comma: i64 = skip_spaces(hash_first_stop, hash_close)
    mut hash_second_start: i64 = first_non_space(hash_comma + 1, hash_close)
    mut hash_second_stop: i64 = word_end(hash_second_start, hash_close)
    mut pack_signature: i64 = find_function_signature(pack_name_start, pack_name_stop)
    mut hash_signature: i64 = find_function_signature(hash_name_start, hash_name_stop)
    mut pack_return_type: i64 = pack_signature / 100
    mut hash_return_type: i64 = hash_signature / 100
    mut first_type: i64 = resolve_value_type(header_start, header_end, first, first_argument_start, first_argument_stop)
    mut second_type: i64 = resolve_value_type(header_start, header_end, first, second_argument_start, second_argument_stop)
    mut hash_first_type: i64 = resolve_value_type(header_start, header_end, first, hash_first_start, hash_first_stop)
    mut hash_second_type: i64 = resolve_value_type(header_start, header_end, first, hash_second_start, hash_second_stop)
    mut position_ordinal: i64 = find_parameter_ordinal(header_start, header_end, hash_first_start, hash_first_stop)
    mut position_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, hash_first_start, hash_first_stop)
    mut end_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, hash_second_start, hash_second_stop)
    mut valid: trit = -1
    match pack_signature > 0:
        -1:
            match pack_return_type == return_type:
                -1:
                    match find_function_parameter_type_by_ordinal(pack_name_start, pack_name_stop, 0) == 3:
                        -1:
                            match find_function_parameter_type_by_ordinal(pack_name_start, pack_name_stop, 1) == 3:
                                -1:
                                    match find_function_parameter_type_by_ordinal(pack_name_start, pack_name_stop, 2) == 3:
                                        -1:
                                            discard 0
                                        0:
                                            valid = 0
                                        1:
                                            valid = 0
                                0:
                                    valid = 0
                                1:
                                    valid = 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match hash_signature > 0:
        -1:
            match hash_return_type == 3:
                -1:
                    match find_function_parameter_type_by_ordinal(hash_name_start, hash_name_stop, 0) == 3:
                        -1:
                            match find_function_parameter_type_by_ordinal(hash_name_start, hash_name_stop, 1) == 3:
                                -1:
                                    discard 0
                                0:
                                    valid = 0
                                1:
                                    valid = 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match first_type == 3:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match hash_first_type == 3:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match hash_second_type == 3:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match position_ordinal >= 0:
        -1:
            discard 0
        0:
            match position_storage_id >= 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        1:
            match position_storage_id >= 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
    match end_storage_id >= 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match parse_integer_literal(second_argument_start, second_argument_stop) == 1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match valid == -1:
        -1:
            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
            mut position_value_id: i64 = position_ordinal
            mut loaded_next_id: i64 = value_id
            match position_storage_id >= 0:
                -1:
                    discard emit_v3_v(value_id, function_id, 2, 2, hash_first_start)
                    discard emit_v3_v(value_id + 1, function_id, 3, hash_first_type, hash_first_start)
                    discard emit_v3_i_aux(function_id * 1000000 + ordinal, function_id, ordinal, 1, 1, 0, -1, 0)
                    discard emit_v3_r(function_id * 1000000 + ordinal, 0, value_id)
                    discard emit_v3_i_aux(function_id * 1000000 + ordinal + 1, function_id, ordinal + 1, 15, 1, 1, position_storage_id, -1)
                    discard emit_v3_o(function_id * 1000000 + ordinal + 1, 0, value_id)
                    discard emit_v3_r(function_id * 1000000 + ordinal + 1, 0, value_id + 1)
                    position_value_id = value_id + 1
                    loaded_next_id = value_id + 2
                0:
                    discard 0
                1:
                    discard 0
            match position_storage_id >= 0:
                -1:
                    discard emit_v3_v(loaded_next_id, function_id, 2, 2, hash_second_start)
                    discard emit_v3_v(loaded_next_id + 1, function_id, 3, hash_second_type, hash_second_start)
                    discard emit_v3_i_aux(function_id * 1000000 + ordinal + 2, function_id, ordinal + 2, 1, 1, 0, -1, 0)
                    discard emit_v3_r(function_id * 1000000 + ordinal + 2, 0, loaded_next_id)
                    discard emit_v3_i_aux(function_id * 1000000 + ordinal + 3, function_id, ordinal + 3, 15, 1, 1, end_storage_id, -1)
                    discard emit_v3_o(function_id * 1000000 + ordinal + 3, 0, loaded_next_id)
                    discard emit_v3_r(function_id * 1000000 + ordinal + 3, 0, loaded_next_id + 1)
                    loaded_next_id = loaded_next_id + 2
                0:
                    loaded_next_id = scan_mutable_load_v3(function_id, header_end, first, hash_second_start, hash_second_stop, hash_second_type, loaded_next_id)
                1:
                    loaded_next_id = scan_mutable_load_v3(function_id, header_end, first, hash_second_start, hash_second_stop, hash_second_type, loaded_next_id)
            match loaded_next_id >= 0:
                -1:
                    mut end_value_id: i64 = loaded_next_id - 1
                    mut literal_value_id: i64 = loaded_next_id
                    mut hash_value_id: i64 = loaded_next_id + 1
                    mut pack_value_id: i64 = loaded_next_id + 2
                    mut context_base: i64 = function_id * 1000000
                    mut literal_id: i64 = context_base + ordinal + loaded_next_id - value_id
                    mut hash_id: i64 = context_base + ordinal + loaded_next_id - value_id + 1
                    mut pack_id: i64 = context_base + ordinal + loaded_next_id - value_id + 2
                    mut return_id: i64 = context_base + ordinal + loaded_next_id - value_id + 3
                    mut hash_identity: i64 = find_function_identity(hash_name_start, hash_name_stop)
                    mut pack_identity: i64 = find_function_identity(pack_name_start, pack_name_stop)
                    mut hash_function_id: i64 = hash_identity / 10
                    mut hash_function_kind: i64 = hash_identity - hash_function_id * 10
                    mut pack_function_id: i64 = pack_identity / 10
                    mut pack_function_kind: i64 = pack_identity - pack_function_id * 10
                    match hash_identity > 0:
                        -1:
                            match pack_identity > 0:
                                -1:
                                    discard emit_v3_v(literal_value_id, function_id, 2, 3, second_argument_start)
                                    discard emit_v3_i(literal_id, function_id, ordinal + loaded_next_id - value_id, 1, 1, 0, parse_integer_literal(second_argument_start, second_argument_stop))
                                    discard emit_v3_r(literal_id, 0, literal_value_id)
                                    discard emit_v3_v(hash_value_id, function_id, 4, 3, hash_name_start)
                                    discard emit_v3_i(hash_id, function_id, ordinal + loaded_next_id - value_id + 1, 14, 1, 2, -1)
                                    discard emit_v3_c(hash_id, hash_function_id, hash_function_kind, hash_name_start, hash_name_stop - hash_name_start)
                                    discard emit_v3_a(hash_id, 0, position_value_id)
                                    discard emit_v3_a(hash_id, 1, end_value_id)
                                    discard emit_v3_o(hash_id, 0, position_value_id)
                                    discard emit_v3_o(hash_id, 1, end_value_id)
                                    discard emit_v3_r(hash_id, 0, hash_value_id)
                                    discard emit_v3_v(pack_value_id, function_id, 4, 3, pack_name_start)
                                    discard emit_v3_i(pack_id, function_id, ordinal + loaded_next_id - value_id + 2, 14, 1, 3, -1)
                                    discard emit_v3_c(pack_id, pack_function_id, pack_function_kind, pack_name_start, pack_name_stop - pack_name_start)
                                    discard emit_v3_a(pack_id, 0, end_value_id)
                                    discard emit_v3_a(pack_id, 1, literal_value_id)
                                    discard emit_v3_a(pack_id, 2, hash_value_id)
                                    discard emit_v3_o(pack_id, 0, end_value_id)
                                    discard emit_v3_o(pack_id, 1, literal_value_id)
                                    discard emit_v3_o(pack_id, 2, hash_value_id)
                                    discard emit_v3_r(pack_id, 0, pack_value_id)
                                    discard emit_v3_i(return_id, function_id, ordinal + loaded_next_id - value_id + 3, 23, 0, 1, -1)
                                    discard emit_v3_o(return_id, 0, pack_value_id)
                                    discard emit_v3_t(return_id, pack_value_id)
                                    return loaded_next_id + 3
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_while_match_call_increment_break_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64, current_block_id: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut left_start: i64 = while_left_start(first, stop)
    mut left_stop: i64 = while_left_stop(first, stop)
    mut operator_start: i64 = while_operator_start(first, stop)
    mut operator_length: i64 = comparison_operator_length(operator_start, stop)
    mut right_start: i64 = skip_spaces(operator_start + operator_length, stop)
    mut right_stop: i64 = word_end(right_start, stop)
    mut left_type: i64 = resolve_value_type(header_start, header_end, first, left_start, left_stop)
    mut right_type: i64 = find_parameter_type(header_start, header_end, right_start, right_stop)
    mut left_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
    mut body_start: i64 = line_end(source_line_start(first), length) + 1
    mut body_stop: i64 = line_end(body_start, length)
    mut nested_match_start: i64 = first_non_space(body_start, body_stop)
    mut nested_match_stop: i64 = body_stop
    mut nested_match_info: i64 = parse_match_call(nested_match_start, nested_match_stop)
    match nested_match_info == 0:
        -1:
            nested_match_info = parse_match_nested_call(nested_match_start, nested_match_stop)
        0:
            discard 0
        1:
            discard 0
    mut nested_match_expression_start: i64 = skip_spaces(word_end(nested_match_start, nested_match_stop), nested_match_stop)
    mut nested_match_callee_start: i64 = nested_match_info / 1000000
    mut nested_match_callee_stop: i64 = nested_match_info - nested_match_callee_start * 1000000
    mut nested_match_open: i64 = skip_spaces(nested_match_callee_stop, nested_match_stop)
    mut nested_match_close: i64 = matching_close(nested_match_open, nested_match_stop)
    mut nested_argument_call_start: i64 = first_non_space(nested_match_open + 1, nested_match_close)
    mut nested_argument_call_end: i64 = matching_close(skip_spaces(word_end(nested_argument_call_start, nested_match_close), nested_match_close), nested_match_close)
    mut nested_argument_call_info: i64 = parse_call_callee(nested_argument_call_start, nested_match_close)
    mut nested_argument_callee_start: i64 = nested_argument_call_info / 1000000
    mut nested_argument_callee_stop: i64 = nested_argument_call_info - nested_argument_callee_start * 1000000
    mut nested_argument_open: i64 = skip_spaces(nested_argument_callee_stop, nested_match_close)
    mut nested_argument_close: i64 = matching_close(nested_argument_open, nested_match_close)
    mut nested_argument_start: i64 = first_non_space(nested_argument_open + 1, nested_argument_close)
    mut nested_argument_stop: i64 = word_end(nested_argument_start, nested_argument_close)
    mut nested_match_signature: i64 = find_function_signature(nested_match_callee_start, nested_match_callee_stop)
    mut nested_argument_signature: i64 = find_function_signature(nested_argument_callee_start, nested_argument_callee_stop)
    mut nested_match_return_type: i64 = nested_match_signature / 100
    mut nested_argument_return_type: i64 = nested_argument_signature / 100
    mut nested_argument_type: i64 = resolve_value_type(header_start, header_end, nested_match_start, nested_argument_start, nested_argument_stop)
    mut nested_argument_storage_id: i64 = find_mutable_storage_id(header_end + 1, nested_match_start, nested_argument_start, nested_argument_stop)
    mut nested_branch_cursor: i64 = line_end(source_line_start(nested_match_start), length) + 1
    mut negative_label_stop: i64 = line_end(nested_branch_cursor, length)
    mut negative_body_start: i64 = negative_label_stop + 1
    mut negative_first_stop: i64 = line_end(negative_body_start, length)
    mut negative_second_start: i64 = negative_first_stop + 1
    mut negative_second_stop: i64 = line_end(negative_second_start, length)
    mut negative_body_stop: i64 = negative_first_stop
    mut negative_assignment_info: i64 = parse_assignment_expression_bounds(negative_body_start, negative_first_stop)
    mut negative_tail_increment_info: trit = parse_increment_statement(negative_second_start, negative_second_stop)
    mut negative_body_is_compound: trit = 0
    match negative_assignment_info > 0:
        -1:
            match negative_tail_increment_info:
                -1:
                    negative_body_is_compound = -1
                    negative_body_stop = negative_second_stop
                0:
                    discard 0
                1:
                    discard 0
        0:
            discard 0
        1:
            discard 0
    mut negative_body_first: i64 = first_non_space(negative_body_start, negative_body_stop)
    mut neutral_label_start: i64 = negative_body_stop + 1
    mut neutral_label_stop: i64 = line_end(neutral_label_start, length)
    mut neutral_body_start: i64 = neutral_label_stop + 1
    mut neutral_body_stop: i64 = line_end(neutral_body_start, length)
    mut neutral_body_first: i64 = first_non_space(neutral_body_start, neutral_body_stop)
    mut positive_label_start: i64 = neutral_body_stop + 1
    mut positive_label_stop: i64 = line_end(positive_label_start, length)
    mut positive_body_start: i64 = positive_label_stop + 1
    mut positive_body_stop: i64 = line_end(positive_body_start, length)
    mut positive_body_first: i64 = first_non_space(positive_body_start, positive_body_stop)
    mut after_loop_start: i64 = while_body_end(first, length)
    mut after_loop_stop: i64 = line_end(after_loop_start, length)
    mut after_loop_first: i64 = first_non_space(after_loop_start, after_loop_stop)
    mut negative_increment_info: trit = parse_increment_statement(negative_body_first, negative_first_stop)
    mut neutral_break_info: i64 = parse_break_statement(neutral_body_first, neutral_body_stop)
    mut positive_break_info: i64 = parse_break_statement(positive_body_first, positive_body_stop)
    mut nested_match_identity: i64 = find_function_identity(nested_match_callee_start, nested_match_callee_stop)
    mut nested_argument_identity: i64 = find_function_identity(nested_argument_callee_start, nested_argument_callee_stop)
    mut nested_match_function_id: i64 = nested_match_identity / 10
    mut nested_match_function_kind: i64 = nested_match_identity - nested_match_function_id * 10
    mut nested_argument_function_id: i64 = nested_argument_identity / 10
    mut nested_argument_function_kind: i64 = nested_argument_identity - nested_argument_function_id * 10
    mut valid: trit = -1
    match parse_while_comparison(first, stop):
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match operator_length == 1:
        -1:
            match read_byte(operator_start) == 60:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match left_type == 3:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match right_type == 3:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_storage_id >= 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_match_info > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_match_return_type == 1:
        -1:
            match find_function_parameter_type_by_ordinal(nested_match_callee_start, nested_match_callee_stop, 0) == 2:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_argument_return_type == 2:
        -1:
            match find_function_parameter_type_by_ordinal(nested_argument_callee_start, nested_argument_callee_stop, 0) == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_argument_type == 3:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_argument_storage_id >= 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_argument_close - nested_argument_start > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(nested_branch_cursor, negative_label_stop), negative_label_stop) == -1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(neutral_label_start, neutral_label_stop), neutral_label_stop) == 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(positive_label_start, positive_label_stop), positive_label_stop) == 1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match negative_body_is_compound == -1:
        -1:
            match negative_assignment_info > 0:
                -1:
                    match negative_tail_increment_info:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            match negative_increment_info:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        1:
            valid = 0
    match neutral_break_info > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match positive_break_info > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_match_identity > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_argument_identity > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match valid == -1:
        -1:
            mut logical_function_id: i64 = v3_logical_function_id(function_id)
            mut entry_context: i64 = v3_context_function_id(logical_function_id, current_block_id)
            mut exit_zero_block: i64 = current_block_id + 1
            mut exit_positive_block: i64 = current_block_id + 2
            mut return_block: i64 = current_block_id + 3
            mut nested_block: i64 = current_block_id + 4
            mut nested_negative_block: i64 = current_block_id + 5
            mut nested_neutral_block: i64 = current_block_id + 6
            mut nested_positive_block: i64 = current_block_id + 7
            mut exit_zero_context: i64 = v3_context_function_id(logical_function_id, exit_zero_block)
            mut exit_positive_context: i64 = v3_context_function_id(logical_function_id, exit_positive_block)
            mut return_context: i64 = v3_context_function_id(logical_function_id, return_block)
            mut nested_context: i64 = v3_context_function_id(logical_function_id, nested_block)
            mut nested_negative_context: i64 = v3_context_function_id(logical_function_id, nested_negative_block)
            mut nested_neutral_context: i64 = v3_context_function_id(logical_function_id, nested_neutral_block)
            mut nested_positive_context: i64 = v3_context_function_id(logical_function_id, nested_positive_block)
            mut condition_ordinal: i64 = count_core_instructions_between(header_end + 1, first)
            mut nested_ordinal: i64 = count_core_instructions_between(header_end + 1, nested_match_start)
            mut condition_index_value: i64 = value_id
            mut condition_load_value: i64 = value_id + 1
            mut right_value: i64 = value_id + 2
            mut compare_value: i64 = value_id + 3
            mut nested_index_value: i64 = value_id + 4
            mut nested_load_value: i64 = value_id + 5
            mut nested_argument_value: i64 = value_id + 6
            mut nested_result_value: i64 = value_id + 7
            mut increment_value_id: i64 = value_id + 8
            mut increment_ordinal: i64 = count_core_instructions_between(header_end + 1, negative_body_first)
            mut increment_next_id: i64 = increment_value_id
            match negative_body_is_compound == -1:
                -1:
                    increment_ordinal = count_core_instructions_between(header_end + 1, negative_second_start)
                    increment_next_id = scan_statement_body(2, nested_negative_context, return_type, header_start, header_end, negative_body_first, negative_first_stop, increment_value_id)
                    match increment_next_id >= 0:
                        -1:
                            increment_next_id = scan_increment_assignment_v3(nested_negative_context, header_start, header_end, negative_second_start, negative_second_stop, increment_next_id)
                        0:
                            increment_next_id = -1
                        1:
                            increment_next_id = -1
                0:
                    increment_next_id = scan_increment_assignment_v3(nested_negative_context, header_start, header_end, negative_body_first, negative_first_stop, increment_value_id)
                1:
                    increment_next_id = -1
            match increment_next_id >= 0:
                -1:
                    discard 0
                0:
                    return -1
                1:
                    return -1
            mut increment_jump_id: i64 = nested_negative_context * 1000000 + increment_ordinal + 6
            mut exit_zero_jump_id: i64 = exit_zero_context * 1000000 + condition_ordinal + 5
            mut exit_positive_jump_id: i64 = exit_positive_context * 1000000 + condition_ordinal + 6
            mut nested_read_id: i64 = nested_context * 1000000 + nested_ordinal + 2
            mut nested_call_id: i64 = nested_context * 1000000 + nested_ordinal + 3
            mut nested_branch_id: i64 = nested_context * 1000000 + nested_ordinal + 4
            mut nested_neutral_jump_id: i64 = nested_neutral_context * 1000000 + nested_ordinal + 5
            mut nested_positive_jump_id: i64 = nested_positive_context * 1000000 + nested_ordinal + 6
            mut nested_increment_jump_id: i64 = nested_negative_context * 1000000 + increment_ordinal + 6
            discard emit_v3_v(condition_index_value, entry_context, 2, 2, left_start)
            discard emit_v3_v(condition_load_value, entry_context, 3, left_type, left_start)
            discard emit_v3_v(right_value, entry_context, 2, right_type, right_start)
            discard emit_v3_v(compare_value, entry_context, 3, 1, operator_start)
            discard emit_v3_i(entry_context * 1000000 + condition_ordinal, entry_context, condition_ordinal, 1, 1, 0, 0)
            discard emit_v3_r(entry_context * 1000000 + condition_ordinal, 0, condition_index_value)
            discard emit_v3_i_aux(entry_context * 1000000 + condition_ordinal + 1, entry_context, condition_ordinal + 1, 15, 1, 1, left_storage_id, -1)
            discard emit_v3_o(entry_context * 1000000 + condition_ordinal + 1, 0, condition_index_value)
            discard emit_v3_r(entry_context * 1000000 + condition_ordinal + 1, 0, condition_load_value)
            discard emit_v3_i(entry_context * 1000000 + condition_ordinal + 2, entry_context, condition_ordinal + 2, 13, 1, 2, -1)
            discard emit_v3_o(entry_context * 1000000 + condition_ordinal + 2, 0, condition_load_value)
            discard emit_v3_o(entry_context * 1000000 + condition_ordinal + 2, 1, find_parameter_ordinal(header_start, header_end, right_start, right_stop))
            discard emit_v3_r(entry_context * 1000000 + condition_ordinal + 2, 0, compare_value)
            discard emit_v3_i(entry_context * 1000000 + condition_ordinal + 3, entry_context, condition_ordinal + 3, 25, 0, 1, -1)
            discard emit_v3_o(entry_context * 1000000 + condition_ordinal + 3, 0, compare_value)
            discard emit_v3_t_branch(entry_context * 1000000 + condition_ordinal + 3, nested_block, exit_zero_block, exit_positive_block, compare_value)
            discard emit_v3_i(exit_zero_context * 1000000 + condition_ordinal + 5, exit_zero_context, condition_ordinal + 5, 24, 0, 0, -1)
            discard emit_v3_t_jump(exit_zero_context * 1000000 + condition_ordinal + 5, return_block)
            discard emit_v3_i(exit_positive_context * 1000000 + condition_ordinal + 6, exit_positive_context, condition_ordinal + 6, 24, 0, 0, -1)
            discard emit_v3_t_jump(exit_positive_context * 1000000 + condition_ordinal + 6, return_block)
            discard emit_v3_v(nested_index_value, nested_context, 2, 2, nested_argument_start)
            discard emit_v3_v(nested_load_value, nested_context, 3, nested_argument_type, nested_argument_start)
            discard emit_v3_v(nested_argument_value, nested_context, 4, nested_argument_return_type, nested_argument_callee_start)
            discard emit_v3_v(nested_result_value, nested_context, 4, nested_match_return_type, nested_match_callee_start)
            discard emit_v3_i(nested_context * 1000000 + nested_ordinal, nested_context, nested_ordinal, 1, 1, 0, 0)
            discard emit_v3_r(nested_context * 1000000 + nested_ordinal, 0, nested_index_value)
            discard emit_v3_i_aux(nested_context * 1000000 + nested_ordinal + 1, nested_context, nested_ordinal + 1, 15, 1, 1, nested_argument_storage_id, -1)
            discard emit_v3_o(nested_context * 1000000 + nested_ordinal + 1, 0, nested_index_value)
            discard emit_v3_r(nested_context * 1000000 + nested_ordinal + 1, 0, nested_load_value)
            discard emit_v3_i(nested_read_id, nested_context, nested_ordinal + 2, 14, 1, 1, -1)
            discard emit_v3_c(nested_read_id, nested_argument_function_id, nested_argument_function_kind, nested_argument_callee_start, nested_argument_callee_stop - nested_argument_callee_start)
            discard emit_v3_a(nested_read_id, 0, nested_load_value)
            discard emit_v3_o(nested_read_id, 0, nested_load_value)
            discard emit_v3_r(nested_read_id, 0, nested_argument_value)
            discard emit_v3_i(nested_call_id, nested_context, nested_ordinal + 3, 14, 1, 1, -1)
            discard emit_v3_c(nested_call_id, nested_match_function_id, nested_match_function_kind, nested_match_callee_start, nested_match_callee_stop - nested_match_callee_start)
            discard emit_v3_a(nested_call_id, 0, nested_argument_value)
            discard emit_v3_o(nested_call_id, 0, nested_argument_value)
            discard emit_v3_r(nested_call_id, 0, nested_result_value)
            discard emit_v3_i(nested_branch_id, nested_context, nested_ordinal + 4, 25, 0, 1, -1)
            discard emit_v3_o(nested_branch_id, 0, nested_result_value)
            discard emit_v3_t_branch(nested_branch_id, nested_negative_block, nested_neutral_block, nested_positive_block, nested_result_value)
            discard emit_v3_i(nested_increment_jump_id, nested_negative_context, increment_ordinal + 6, 24, 0, 0, -1)
            discard emit_v3_t_jump(nested_increment_jump_id, current_block_id)
            discard emit_v3_i(nested_neutral_jump_id, nested_neutral_context, nested_ordinal + 5, 24, 0, 0, -1)
            discard emit_v3_t_jump(nested_neutral_jump_id, return_block)
            discard emit_v3_i(nested_positive_jump_id, nested_positive_context, nested_ordinal + 6, 24, 0, 0, -1)
            discard emit_v3_t_jump(nested_positive_jump_id, return_block)
            mut return_expression_first: i64 = first_non_space(after_loop_first, after_loop_stop)
            mut return_expression_start: i64 = skip_spaces(word_end(return_expression_first, after_loop_stop), after_loop_stop)
            mut return_next_id: i64 = scan_return_three_call_v3(return_context, return_type, header_start, header_end, after_loop_first, return_expression_start, after_loop_stop, increment_next_id + 5, -1, -1)
            match return_next_id >= 0:
                -1:
                    discard 0
                0:
                    return -1
                1:
                    return -1
            discard emit_v3_b_block(function_id, current_block_id, current_block_id, 5, v3_context_instruction_id(entry_context * 1000000 + condition_ordinal + 3))
            discard emit_v3_b_block(function_id, exit_zero_block, exit_zero_block, 1, v3_context_instruction_id(exit_zero_context * 1000000 + condition_ordinal + 5))
            discard emit_v3_b_block(function_id, exit_positive_block, exit_positive_block, 1, v3_context_instruction_id(exit_positive_context * 1000000 + condition_ordinal + 6))
            discard emit_v3_b_block(function_id, return_block, return_block, 6 + return_next_id - value_id - 5, v3_context_instruction_id(return_context * 1000000 + count_core_instructions_between(header_end + 1, after_loop_first) + return_next_id - increment_next_id - 5))
            discard emit_v3_b_block(function_id, nested_block, nested_block, 5, v3_context_instruction_id(nested_context * 1000000 + nested_ordinal + 4))
            discard emit_v3_b_block(function_id, nested_negative_block, nested_negative_block, count_core_instructions_between(negative_body_first, negative_body_stop) + 1, v3_context_instruction_id(nested_negative_context * 1000000 + increment_ordinal + 6))
            discard emit_v3_b_block(function_id, nested_neutral_block, nested_neutral_block, 1, v3_context_instruction_id(nested_neutral_context * 1000000 + nested_ordinal + 5))
            discard emit_v3_b_block(function_id, nested_positive_block, nested_positive_block, 1, v3_context_instruction_id(nested_positive_context * 1000000 + nested_ordinal + 6))
            mut encoded_next_id: i64 = return_next_id * 1000000
            encoded_next_id = encoded_next_id + after_loop_stop + 1 + 2000000000000
            return encoded_next_id
        0:
            return -1
        1:
            return -1

# Lower a three-way match whose predicate is a call over one call argument.
# The nested call is materialized before the predicate call; all arms retain
# the same terminal/fallthrough protocol as ordinary call matches.
fn scan_match_nested_call_fallthrough_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, call_info: i64, value_id: i64, current_block_id: i64, current_block_start: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut outer_callee_start: i64 = call_info / 1000000
    mut outer_callee_stop: i64 = call_info - outer_callee_start * 1000000
    mut outer_open: i64 = skip_spaces(outer_callee_stop, stop)
    mut outer_close: i64 = matching_close(outer_open, stop)
    mut inner_start: i64 = first_non_space(outer_open + 1, outer_close)
    mut inner_stop: i64 = word_end(inner_start, outer_close)
    mut inner_open: i64 = skip_spaces(inner_stop, outer_close)
    mut inner_close: i64 = matching_close(inner_open, outer_close)
    mut argument_start: i64 = first_non_space(inner_open + 1, inner_close)
    mut argument_stop: i64 = word_end(argument_start, inner_close)
    mut outer_signature: i64 = find_function_signature(outer_callee_start, outer_callee_stop)
    mut inner_builtin_signature: i64 = builtin_call_signature(inner_start, inner_stop)
    mut inner_signature: i64 = resolve_call_signature(inner_start, inner_stop)
    mut outer_return_type: i64 = outer_signature / 100
    mut outer_parameter_type: i64 = find_function_parameter_type_by_ordinal(outer_callee_start, outer_callee_stop, 0)
    mut inner_return_type: i64 = inner_signature / 100
    mut inner_parameter_type: i64 = inner_signature - inner_return_type * 100
    mut argument_type: i64 = resolve_value_type(header_start, header_end, first, argument_start, argument_stop)
    mut argument_parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, argument_start, argument_stop)
    mut argument_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, argument_start, argument_stop)
    mut argument_local_value_id: i64 = find_core_local_value_id(header_end + 1, first, argument_start, argument_stop)
    mut branch_cursor: i64 = line_end(source_line_start(first), length) + 1
    mut negative_label_stop: i64 = line_end(branch_cursor, length)
    mut negative_body_start: i64 = negative_label_stop + 1
    mut negative_body_stop: i64 = line_end(negative_body_start, length)
    mut neutral_label_start: i64 = negative_body_stop + 1
    mut neutral_label_stop: i64 = line_end(neutral_label_start, length)
    mut neutral_body_start: i64 = neutral_label_stop + 1
    mut neutral_body_stop: i64 = line_end(neutral_body_start, length)
    mut positive_label_start: i64 = neutral_body_stop + 1
    mut positive_label_stop: i64 = line_end(positive_label_start, length)
    mut positive_body_start: i64 = positive_label_stop + 1
    mut positive_body_stop: i64 = line_end(positive_body_start, length)
    mut negative_body_first: i64 = first_non_space(negative_body_start, negative_body_stop)
    mut neutral_body_first: i64 = first_non_space(neutral_body_start, neutral_body_stop)
    mut positive_body_first: i64 = first_non_space(positive_body_start, positive_body_stop)
    mut negative_kind: i64 = match_branch_body_kind(negative_body_first, negative_body_stop)
    mut neutral_kind: i64 = match_branch_body_kind(neutral_body_first, neutral_body_stop)
    mut positive_kind: i64 = match_branch_body_kind(positive_body_first, positive_body_stop)
    mut valid: trit = -1
    match outer_signature > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match inner_signature > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match outer_return_type == 1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match outer_parameter_type == inner_return_type:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match argument_type == inner_parameter_type:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match argument_parameter_ordinal >= 0:
        -1:
            discard 0
        0:
            match argument_storage_id >= 0:
                -1:
                    discard 0
                0:
                    match argument_local_value_id >= 0:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                1:
                    valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(branch_cursor, negative_label_stop), negative_label_stop) == -1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(neutral_label_start, neutral_label_stop), neutral_label_stop) == 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(positive_label_start, positive_label_stop), positive_label_stop) == 1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match valid == -1:
        -1:
            mut ordinal: i64 = count_core_instructions_between(current_block_start, first)
            mut base_id: i64 = function_id * 1000000 + ordinal
            mut condition_instruction_count: i64 = 3
            mut argument_value_id: i64 = argument_parameter_ordinal
            mut inner_call_id: i64 = base_id
            mut outer_call_id: i64 = base_id + 1
            mut branch_id: i64 = base_id + 2
            mut inner_call_value_id: i64 = value_id
            mut outer_call_value_id: i64 = value_id + 1
            mut next_value_id: i64 = value_id + 2
            match argument_parameter_ordinal >= 0:
                -1:
                    discard 0
                0:
                    match argument_storage_id >= 0:
                        -1:
                            condition_instruction_count = 5
                            inner_call_id = base_id + 2
                            outer_call_id = base_id + 3
                            branch_id = base_id + 4
                            argument_value_id = value_id + 1
                            inner_call_value_id = value_id + 2
                            outer_call_value_id = value_id + 3
                            next_value_id = value_id + 4
                            discard emit_v3_v(value_id, function_id, 2, 2, argument_start)
                            discard emit_v3_v(argument_value_id, function_id, 3, argument_type, argument_start)
                            discard emit_v3_i_block(base_id, function_id, current_block_id, ordinal, 1, 1, 0, -1, 0)
                            discard emit_v3_r(base_id, 0, value_id)
                            discard emit_v3_i_block(base_id + 1, function_id, current_block_id, ordinal + 1, 15, 1, 1, argument_storage_id, -1)
                            discard emit_v3_o(base_id + 1, 0, value_id)
                            discard emit_v3_r(base_id + 1, 0, argument_value_id)
                        0:
                            argument_value_id = argument_local_value_id
                        1:
                            return -1
                1:
                    return -1
            mut inner_identity: i64 = find_function_identity(inner_start, inner_stop)
            mut outer_identity: i64 = find_function_identity(outer_callee_start, outer_callee_stop)
            mut inner_identity_valid: trit = 0
            match inner_builtin_signature > 0:
                -1:
                    inner_identity_valid = -1
                0:
                    match inner_identity > 0:
                        -1:
                            inner_identity_valid = -1
                        0:
                            discard 0
                        1:
                            discard 0
                1:
                    discard 0
            match inner_identity_valid == -1:
                -1:
                    match outer_identity > 0:
                        -1:
                            mut inner_function_id: i64 = inner_identity / 10
                            mut inner_function_kind: i64 = inner_identity - inner_function_id * 10
                            mut outer_function_id: i64 = outer_identity / 10
                            mut outer_function_kind: i64 = outer_identity - outer_function_id * 10
                            match inner_builtin_signature > 0:
                                -1:
                                    discard emit_v3_v(inner_call_value_id, function_id, 4, inner_return_type, inner_start)
                                    discard emit_v3_i_block(inner_call_id, function_id, current_block_id, ordinal + condition_instruction_count - 3, 10, 1, 1, -1, -1)
                                    discard emit_v3_o(inner_call_id, 0, argument_value_id)
                                    discard emit_v3_r(inner_call_id, 0, inner_call_value_id)
                                0:
                                    discard emit_v3_v(inner_call_value_id, function_id, 4, inner_return_type, inner_start)
                                    discard emit_v3_i_block(inner_call_id, function_id, current_block_id, ordinal + condition_instruction_count - 3, 14, 1, 1, -1, -1)
                                    discard emit_v3_c(inner_call_id, inner_function_id, inner_function_kind, inner_start, inner_stop - inner_start)
                                    discard emit_v3_a(inner_call_id, 0, argument_value_id)
                                    discard emit_v3_o(inner_call_id, 0, argument_value_id)
                                    discard emit_v3_r(inner_call_id, 0, inner_call_value_id)
                                1:
                                    return -1
                            discard emit_v3_v(outer_call_value_id, function_id, 4, outer_return_type, outer_callee_start)
                            discard emit_v3_i_block(outer_call_id, function_id, current_block_id, ordinal + condition_instruction_count - 2, 14, 1, 1, -1, -1)
                            discard emit_v3_c(outer_call_id, outer_function_id, outer_function_kind, outer_callee_start, outer_callee_stop - outer_callee_start)
                            discard emit_v3_a(outer_call_id, 0, inner_call_value_id)
                            discard emit_v3_o(outer_call_id, 0, inner_call_value_id)
                            discard emit_v3_r(outer_call_id, 0, outer_call_value_id)
                            discard emit_v3_i_block(branch_id, function_id, current_block_id, ordinal + condition_instruction_count - 1, 25, 0, 1, -1, -1)
                            discard emit_v3_o(branch_id, 0, outer_call_value_id)
                            discard emit_v3_t_branch(branch_id, current_block_id + 1, current_block_id + 2, current_block_id + 3, outer_call_value_id)
                            mut negative_next_id: i64 = next_value_id
                            mut neutral_next_id: i64 = next_value_id
                            mut positive_next_id: i64 = next_value_id
                            match negative_kind == 1:
                                -1:
                                    negative_next_id = scan_statement_body(2, v3_context_function_id(v3_logical_function_id(function_id), current_block_id + 1), return_type, header_start, header_end, negative_body_first, negative_body_stop, negative_next_id)
                                    match negative_next_id >= 0:
                                        -1:
                                            neutral_next_id = negative_next_id
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    match negative_kind == 2:
                                        -1:
                                            mut negative_jump_id: i64 = base_id + condition_instruction_count
                                            discard emit_v3_i_block(negative_jump_id, function_id, current_block_id + 1, ordinal + condition_instruction_count, 24, 0, 0, -1, -1)
                                            discard emit_v3_t_jump(negative_jump_id, current_block_id + 4)
                                        0:
                                            return -1
                                        1:
                                            return -1
                                1:
                                    return -1
                            match neutral_kind == 1:
                                -1:
                                    neutral_next_id = scan_statement_body(2, v3_context_function_id(v3_logical_function_id(function_id), current_block_id + 2), return_type, header_start, header_end, neutral_body_first, neutral_body_stop, neutral_next_id)
                                    match neutral_next_id >= 0:
                                        -1:
                                            positive_next_id = neutral_next_id
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    match neutral_kind == 2:
                                        -1:
                                            positive_next_id = neutral_next_id
                                            mut neutral_jump_id: i64 = base_id + condition_instruction_count + 1
                                            discard emit_v3_i_block(neutral_jump_id, function_id, current_block_id + 2, ordinal + condition_instruction_count + 1, 24, 0, 0, -1, -1)
                                            discard emit_v3_t_jump(neutral_jump_id, current_block_id + 4)
                                        0:
                                            return -1
                                        1:
                                            return -1
                                1:
                                    return -1
                            match positive_kind == 1:
                                -1:
                                    positive_next_id = scan_statement_body(2, v3_context_function_id(v3_logical_function_id(function_id), current_block_id + 3), return_type, header_start, header_end, positive_body_first, positive_body_stop, positive_next_id)
                                    match positive_next_id >= 0:
                                        -1:
                                            next_value_id = positive_next_id
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    match positive_kind == 2:
                                        -1:
                                            mut positive_jump_id: i64 = base_id + condition_instruction_count + 2
                                            discard emit_v3_i_block(positive_jump_id, function_id, current_block_id + 3, ordinal + condition_instruction_count + 2, 24, 0, 0, -1, -1)
                                            discard emit_v3_t_jump(positive_jump_id, current_block_id + 4)
                                            next_value_id = positive_next_id
                                        0:
                                            return -1
                                        1:
                                            return -1
                                1:
                                    return -1
                            discard emit_v3_b_block(function_id, current_block_id, current_block_id, count_core_instructions_between(current_block_start, first) + condition_instruction_count, branch_id)
                            match negative_kind == 1:
                                -1:
                                    discard emit_v3_b_block(function_id, current_block_id + 1, current_block_id + 1, count_core_instructions_between(negative_body_first, negative_body_stop), v3_context_instruction_id(v3_context_function_id(v3_logical_function_id(function_id), current_block_id + 1) * 1000000 + count_core_instructions_between(header_end + 1, negative_body_first) + count_core_instructions_between(negative_body_first, negative_body_stop) - 1))
                                0:
                                    discard 0
                                1:
                                    discard 0
                            match negative_kind == 2:
                                -1:
                                    discard emit_v3_b_block(function_id, current_block_id + 1, current_block_id + 1, 1, v3_context_instruction_id(base_id + condition_instruction_count))
                                0:
                                    discard 0
                                1:
                                    discard 0
                            match neutral_kind == 1:
                                -1:
                                    discard emit_v3_b_block(function_id, current_block_id + 2, current_block_id + 2, count_core_instructions_between(neutral_body_first, neutral_body_stop), v3_context_instruction_id(v3_context_function_id(v3_logical_function_id(function_id), current_block_id + 2) * 1000000 + count_core_instructions_between(header_end + 1, neutral_body_first) + count_core_instructions_between(neutral_body_first, neutral_body_stop) - 1))
                                0:
                                    discard 0
                                1:
                                    discard 0
                            match neutral_kind == 2:
                                -1:
                                    discard emit_v3_b_block(function_id, current_block_id + 2, current_block_id + 2, 1, v3_context_instruction_id(base_id + condition_instruction_count + 1))
                                0:
                                    discard 0
                                1:
                                    discard 0
                            match positive_kind == 1:
                                -1:
                                    discard emit_v3_b_block(function_id, current_block_id + 3, current_block_id + 3, count_core_instructions_between(positive_body_first, positive_body_stop), v3_context_instruction_id(v3_context_function_id(v3_logical_function_id(function_id), current_block_id + 3) * 1000000 + count_core_instructions_between(header_end + 1, positive_body_first) + count_core_instructions_between(positive_body_first, positive_body_stop) - 1))
                                0:
                                    discard 0
                                1:
                                    discard 0
                            match positive_kind == 2:
                                -1:
                                    discard emit_v3_b_block(function_id, current_block_id + 3, current_block_id + 3, 1, v3_context_instruction_id(base_id + condition_instruction_count + 2))
                                0:
                                    discard 0
                                1:
                                    discard 0
                            mut next_cursor: i64 = positive_body_stop + 1
                            match match_all_arms_terminal(negative_kind, neutral_kind, positive_kind):
                                -1:
                                    return match_result_terminal(next_value_id, next_cursor)
                                0:
                                    return match_result_continuation(next_value_id, next_cursor, current_block_id + 4)
                                1:
                                    return match_result_continuation(next_value_id, next_cursor, current_block_id + 4)
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return 0
        1:
            return 0

fn scan_match_call_complex_negative_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, call_info: i64, value_id: i64, current_block_id: i64, current_block_start: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut callee_start: i64 = call_info / 1000000
    mut callee_stop: i64 = call_info - callee_start * 1000000
    mut expression_start: i64 = skip_spaces(word_end(first, stop), stop)
    mut call_end: i64 = call_expression_end(expression_start)
    mut call_open: i64 = skip_spaces(callee_stop, call_end)
    mut argument_start: i64 = first_non_space(call_open + 1, call_end - 1)
    mut argument_stop: i64 = word_end(argument_start, call_end - 1)
    mut outer_argument_call_info: i64 = parse_call_callee(argument_start, call_end - 1)
    mut outer_argument_callee_start: i64 = outer_argument_call_info / 1000000
    mut outer_argument_callee_stop: i64 = outer_argument_call_info - outer_argument_callee_start * 1000000
    mut outer_argument_open: i64 = skip_spaces(outer_argument_callee_stop, call_end)
    mut outer_argument_close: i64 = matching_close(outer_argument_open, call_end)
    mut outer_argument_start: i64 = first_non_space(outer_argument_open + 1, outer_argument_close)
    mut outer_argument_stop: i64 = word_end(outer_argument_start, outer_argument_close)
    mut outer_argument_signature: i64 = find_function_signature(outer_argument_callee_start, outer_argument_callee_stop)
    mut outer_argument_return_type: i64 = outer_argument_signature / 100
    mut outer_argument_type: i64 = resolve_value_type(header_start, header_end, first, outer_argument_start, outer_argument_stop)
    mut outer_argument_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, outer_argument_start, outer_argument_stop)
    mut outer_argument_identity: i64 = find_function_identity(outer_argument_callee_start, outer_argument_callee_stop)
    mut outer_argument_function_id: i64 = outer_argument_identity / 10
    mut outer_argument_function_kind: i64 = outer_argument_identity - outer_argument_function_id * 10
    mut signature: i64 = find_function_signature(callee_start, callee_stop)
    mut call_return_type: i64 = 0
    mut parameter_type: i64 = 0
    mut argument_type: i64 = resolve_value_type(header_start, header_end, first, argument_start, argument_stop)
    mut argument_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, argument_start, argument_stop)
    mut outer_branch_cursor: i64 = line_end(source_line_start(first), length) + 1
    mut outer_negative_label_stop: i64 = line_end(outer_branch_cursor, length)
    mut outer_negative_body_start: i64 = outer_negative_label_stop + 1
    mut outer_negative_body_stop: i64 = line_end(outer_negative_body_start, length)
    mut outer_negative_body_first: i64 = first_non_space(outer_negative_body_start, outer_negative_body_stop)
    mut loop_start: i64 = outer_negative_body_stop + 1
    mut loop_stop: i64 = line_end(loop_start, length)
    mut loop_first: i64 = first_non_space(loop_start, loop_stop)
    mut outer_return_start: i64 = while_body_end(loop_first, length)
    mut outer_return_stop: i64 = line_end(outer_return_start, length)
    mut outer_neutral_label_start: i64 = outer_return_stop + 1
    mut outer_neutral_label_stop: i64 = line_end(outer_neutral_label_start, length)
    mut outer_neutral_body_start: i64 = outer_neutral_label_stop + 1
    mut outer_neutral_body_stop: i64 = line_end(outer_neutral_body_start, length)
    mut outer_neutral_body_first: i64 = first_non_space(outer_neutral_body_start, outer_neutral_body_stop)
    mut outer_positive_label_start: i64 = outer_neutral_body_stop + 1
    mut outer_positive_label_stop: i64 = line_end(outer_positive_label_start, length)
    mut outer_positive_body_start: i64 = outer_positive_label_stop + 1
    mut outer_positive_body_stop: i64 = line_end(outer_positive_body_start, length)
    mut outer_positive_body_first: i64 = first_non_space(outer_positive_body_start, outer_positive_body_stop)
    mut outer_negative_kind: i64 = match_branch_body_kind(outer_negative_body_first, outer_negative_body_stop)
    mut outer_neutral_kind: i64 = match_branch_body_kind(outer_neutral_body_first, outer_neutral_body_stop)
    mut outer_positive_kind: i64 = match_branch_body_kind(outer_positive_body_first, outer_positive_body_stop)
    mut loop_left_start: i64 = while_left_start(loop_start, loop_stop)
    mut loop_left_stop: i64 = while_left_stop(loop_start, loop_stop)
    mut loop_operator_start: i64 = while_operator_start(loop_start, loop_stop)
    mut loop_operator_length: i64 = comparison_operator_length(loop_operator_start, loop_stop)
    mut loop_right_start: i64 = skip_spaces(loop_operator_start + loop_operator_length, loop_stop)
    mut loop_right_stop: i64 = word_end(loop_right_start, loop_stop)
    mut loop_left_type: i64 = resolve_value_type(header_start, header_end, loop_start, loop_left_start, loop_left_stop)
    mut loop_right_type: i64 = find_parameter_type(header_start, header_end, loop_right_start, loop_right_stop)
    mut loop_left_storage_id: i64 = find_mutable_storage_id(header_end + 1, loop_start, loop_left_start, loop_left_stop)
    mut nested_body_start: i64 = line_end(source_line_start(loop_start), length) + 1
    mut nested_body_stop: i64 = line_end(nested_body_start, length)
    mut nested_match_start: i64 = first_non_space(nested_body_start, nested_body_stop)
    mut nested_match_stop: i64 = nested_body_stop
    mut nested_match_info: i64 = parse_match_call(nested_match_start, nested_match_stop)
    match nested_match_info == 0:
        -1:
            nested_match_info = parse_match_nested_call(nested_match_start, nested_match_stop)
        0:
            discard 0
        1:
            discard 0
    mut nested_match_callee_start: i64 = nested_match_info / 1000000
    mut nested_match_callee_stop: i64 = nested_match_info - nested_match_callee_start * 1000000
    mut nested_match_open: i64 = skip_spaces(nested_match_callee_stop, nested_match_stop)
    mut nested_match_close: i64 = matching_close(nested_match_open, nested_match_stop)
    mut nested_argument_call_start: i64 = first_non_space(nested_match_open + 1, nested_match_close)
    mut nested_argument_call_info: i64 = parse_call_callee(nested_argument_call_start, nested_match_close)
    mut nested_argument_callee_start: i64 = nested_argument_call_info / 1000000
    mut nested_argument_callee_stop: i64 = nested_argument_call_info - nested_argument_callee_start * 1000000
    mut nested_argument_open: i64 = skip_spaces(nested_argument_callee_stop, nested_match_close)
    mut nested_argument_close: i64 = matching_close(nested_argument_open, nested_match_close)
    mut nested_argument_start: i64 = first_non_space(nested_argument_open + 1, nested_argument_close)
    mut nested_argument_stop: i64 = word_end(nested_argument_start, nested_argument_close)
    mut nested_match_signature: i64 = find_function_signature(nested_match_callee_start, nested_match_callee_stop)
    mut nested_argument_signature: i64 = find_function_signature(nested_argument_callee_start, nested_argument_callee_stop)
    mut nested_match_return_type: i64 = nested_match_signature / 100
    mut nested_argument_return_type: i64 = nested_argument_signature / 100
    mut nested_argument_type: i64 = resolve_value_type(header_start, header_end, nested_match_start, nested_argument_start, nested_argument_stop)
    mut nested_argument_storage_id: i64 = find_mutable_storage_id(header_end + 1, nested_match_start, nested_argument_start, nested_argument_stop)
    mut nested_branch_cursor: i64 = line_end(source_line_start(nested_match_start), length) + 1
    mut nested_negative_label_stop: i64 = line_end(nested_branch_cursor, length)
    mut nested_negative_body_start: i64 = nested_negative_label_stop + 1
    mut nested_negative_first_stop: i64 = line_end(nested_negative_body_start, length)
    mut nested_negative_second_start: i64 = nested_negative_first_stop + 1
    mut nested_negative_second_stop: i64 = line_end(nested_negative_second_start, length)
    mut nested_negative_body_stop: i64 = nested_negative_first_stop
    mut nested_negative_body_first: i64 = first_non_space(nested_negative_body_start, nested_negative_body_stop)
    mut nested_neutral_label_start: i64 = nested_negative_body_stop + 1
    mut nested_neutral_label_stop: i64 = line_end(nested_neutral_label_start, length)
    mut nested_neutral_body_start: i64 = nested_neutral_label_stop + 1
    mut nested_neutral_body_stop: i64 = line_end(nested_neutral_body_start, length)
    mut nested_neutral_body_first: i64 = first_non_space(nested_neutral_body_start, nested_neutral_body_stop)
    mut nested_positive_label_start: i64 = nested_neutral_body_stop + 1
    mut nested_positive_label_stop: i64 = line_end(nested_positive_label_start, length)
    mut nested_positive_body_start: i64 = nested_positive_label_stop + 1
    mut nested_positive_body_stop: i64 = line_end(nested_positive_body_start, length)
    mut nested_positive_body_first: i64 = first_non_space(nested_positive_body_start, nested_positive_body_stop)
    mut nested_negative_increment_info: trit = parse_increment_statement(nested_negative_body_first, nested_negative_body_stop)
    mut nested_negative_assignment_info: i64 = parse_assignment_expression_bounds(nested_negative_body_start, nested_negative_first_stop)
    mut nested_negative_tail_increment_info: trit = parse_increment_statement(nested_negative_second_start, nested_negative_second_stop)
    mut nested_negative_body_is_compound: trit = 0
    match nested_negative_assignment_info > 0:
        -1:
            match nested_negative_tail_increment_info:
                -1:
                    nested_negative_body_is_compound = -1
                    nested_negative_body_stop = nested_negative_second_stop
                0:
                    discard 0
                1:
                    discard 0
        0:
            discard 0
        1:
            discard 0
    nested_neutral_label_start = nested_negative_body_stop + 1
    nested_neutral_label_stop = line_end(nested_neutral_label_start, length)
    nested_neutral_body_start = nested_neutral_label_stop + 1
    nested_neutral_body_stop = line_end(nested_neutral_body_start, length)
    nested_neutral_body_first = first_non_space(nested_neutral_body_start, nested_neutral_body_stop)
    nested_positive_label_start = nested_neutral_body_stop + 1
    nested_positive_label_stop = line_end(nested_positive_label_start, length)
    nested_positive_body_start = nested_positive_label_stop + 1
    nested_positive_body_stop = line_end(nested_positive_body_start, length)
    nested_positive_body_first = first_non_space(nested_positive_body_start, nested_positive_body_stop)
    mut nested_neutral_break_info: i64 = parse_break_statement(nested_neutral_body_first, nested_neutral_body_stop)
    mut nested_positive_break_info: i64 = parse_break_statement(nested_positive_body_first, nested_positive_body_stop)
    mut nested_match_identity: i64 = find_function_identity(nested_match_callee_start, nested_match_callee_stop)
    mut nested_argument_identity: i64 = find_function_identity(nested_argument_callee_start, nested_argument_callee_stop)
    mut nested_match_function_id: i64 = nested_match_identity / 10
    mut nested_match_function_kind: i64 = nested_match_identity - nested_match_function_id * 10
    mut nested_argument_function_id: i64 = nested_argument_identity / 10
    mut nested_argument_function_kind: i64 = nested_argument_identity - nested_argument_function_id * 10
    mut valid: trit = -1
    mut outer_argument_is_call: trit = 0
    match outer_argument_call_info > 0:
        -1:
            outer_argument_is_call = -1
            argument_type = outer_argument_return_type
            argument_storage_id = outer_argument_storage_id
            match outer_argument_signature > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match outer_argument_return_type == 2:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match find_function_parameter_type_by_ordinal(outer_argument_callee_start, outer_argument_callee_stop, 0) == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match outer_argument_type == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match outer_argument_storage_id >= 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match outer_argument_identity > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            discard 0
        1:
            discard 0
    match signature > 0:
        -1:
            call_return_type = signature / 100
            parameter_type = find_function_parameter_type_by_ordinal(callee_start, callee_stop, 0)
        0:
            valid = 0
        1:
            valid = 0
    match call_return_type == 1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match call_argument_type_matches(argument_type, parameter_type):
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match argument_storage_id >= 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(outer_branch_cursor, outer_negative_label_stop), outer_negative_label_stop) == -1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(outer_neutral_label_start, outer_neutral_label_stop), outer_neutral_label_stop) == 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(outer_positive_label_start, outer_positive_label_stop), outer_positive_label_stop) == 1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match outer_negative_kind == 3:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match outer_neutral_kind == 2:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match outer_positive_kind == 2:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match parse_while_comparison(loop_start, loop_stop):
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match loop_operator_length == 1:
        -1:
            match read_byte(loop_operator_start) == 60:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match loop_left_type == 3:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match loop_right_type == 3:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match loop_left_storage_id >= 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_match_info > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_match_return_type == 1:
        -1:
            match find_function_parameter_type_by_ordinal(nested_match_callee_start, nested_match_callee_stop, 0) == 2:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_argument_return_type == 2:
        -1:
            match find_function_parameter_type_by_ordinal(nested_argument_callee_start, nested_argument_callee_stop, 0) == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_argument_type == 3:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_argument_storage_id >= 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_argument_close - nested_argument_start > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(nested_branch_cursor, nested_negative_label_stop), nested_negative_label_stop) == -1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(nested_neutral_label_start, nested_neutral_label_stop), nested_neutral_label_stop) == 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(nested_positive_label_start, nested_positive_label_stop), nested_positive_label_stop) == 1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_negative_body_is_compound == -1:
        -1:
            match nested_negative_assignment_info > 0:
                -1:
                    match nested_negative_tail_increment_info:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            match nested_negative_increment_info:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        1:
            valid = 0
    match nested_neutral_break_info > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_positive_break_info > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_match_identity > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match nested_argument_identity > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match valid == -1:
        -1:
            mut logical_function_id: i64 = v3_logical_function_id(function_id)
            mut negative_block: i64 = current_block_id + 1
            mut loop_block: i64 = current_block_id + 2
            mut outer_neutral_block: i64 = current_block_id + 10
            mut outer_positive_block: i64 = current_block_id + 11
            mut successor_block: i64 = current_block_id + 12
            mut negative_context: i64 = v3_context_function_id(logical_function_id, negative_block)
            mut outer_ordinal: i64 = count_core_instructions_between(current_block_start, first)
            mut outer_base_id: i64 = function_id * 1000000 + outer_ordinal
            mut outer_index_id: i64 = outer_base_id
            mut outer_load_id: i64 = outer_base_id + 1
            mut outer_call_id: i64 = outer_base_id + 2
            mut outer_branch_id: i64 = outer_base_id + 3
            mut condition_instruction_count: i64 = 4
            mut negative_next_id: i64 = value_id
            match outer_argument_is_call == -1:
                -1:
                    outer_call_id = outer_base_id + 3
                    outer_branch_id = outer_base_id + 4
                    condition_instruction_count = 5
                    negative_next_id = scan_statement_body(2, negative_context, return_type, header_start, header_end, outer_negative_body_first, outer_negative_body_stop, value_id + 4)
                0:
                    negative_next_id = scan_statement_body(2, negative_context, return_type, header_start, header_end, outer_negative_body_first, outer_negative_body_stop, value_id + 3)
                1:
                    return -1
            match negative_next_id > 0:
                -1:
                    mut negative_pre_loop_ordinal: i64 = count_core_instructions_between(header_end + 1, loop_start)
                    mut negative_jump_id: i64 = negative_context * 1000000 + negative_pre_loop_ordinal
                    match outer_argument_is_call == -1:
                        -1:
                            discard emit_v3_v(value_id, function_id, 2, 3, outer_argument_start)
                            discard emit_v3_v(value_id + 1, function_id, 3, outer_argument_type, outer_argument_start)
                            discard emit_v3_i_block(outer_index_id, function_id, current_block_id, outer_ordinal, 1, 1, 0, -1, 0)
                            discard emit_v3_r(outer_index_id, 0, value_id)
                            discard emit_v3_i_aux(outer_load_id, function_id, outer_ordinal + 1, 15, 1, 1, outer_argument_storage_id, -1)
                            discard emit_v3_o(outer_load_id, 0, value_id)
                            discard emit_v3_r(outer_load_id, 0, value_id + 1)
                            discard emit_v3_v(value_id + 2, function_id, 4, outer_argument_return_type, outer_argument_callee_start)
                            discard emit_v3_i_block(outer_base_id + 2, function_id, current_block_id, outer_ordinal + 2, 14, 1, 1, -1, -1)
                            discard emit_v3_c(outer_base_id + 2, outer_argument_function_id, outer_argument_function_kind, outer_argument_callee_start, outer_argument_callee_stop - outer_argument_callee_start)
                            discard emit_v3_a(outer_base_id + 2, 0, value_id + 1)
                            discard emit_v3_o(outer_base_id + 2, 0, value_id + 1)
                            discard emit_v3_r(outer_base_id + 2, 0, value_id + 2)
                            discard emit_v3_v(value_id + 3, function_id, 4, call_return_type, callee_start)
                            discard emit_v3_i_block(outer_call_id, function_id, current_block_id, outer_ordinal + 3, 14, 1, 1, -1, -1)
                            mut call_identity: i64 = find_function_identity(callee_start, callee_stop)
                            mut call_function_id: i64 = call_identity / 10
                            mut call_function_kind: i64 = call_identity - call_function_id * 10
                            discard emit_v3_c(outer_call_id, call_function_id, call_function_kind, callee_start, callee_stop - callee_start)
                            discard emit_v3_a(outer_call_id, 0, value_id + 2)
                            discard emit_v3_o(outer_call_id, 0, value_id + 2)
                            discard emit_v3_r(outer_call_id, 0, value_id + 3)
                            discard emit_v3_i_block(outer_branch_id, function_id, current_block_id, outer_ordinal + 4, 25, 0, 1, -1, -1)
                            discard emit_v3_o(outer_branch_id, 0, value_id + 3)
                            discard emit_v3_t_branch(outer_branch_id, negative_block, outer_neutral_block, outer_positive_block, value_id + 3)
                        0:
                            discard emit_v3_v(value_id, function_id, 2, 2, argument_start)
                            discard emit_v3_v(value_id + 1, function_id, 3, argument_type, argument_start)
                            discard emit_v3_i_block(outer_index_id, function_id, current_block_id, outer_ordinal, 1, 1, 0, -1, 0)
                            discard emit_v3_r(outer_index_id, 0, value_id)
                            discard emit_v3_i_aux(outer_load_id, function_id, outer_ordinal + 1, 15, 1, 1, argument_storage_id, -1)
                            discard emit_v3_o(outer_load_id, 0, value_id)
                            discard emit_v3_r(outer_load_id, 0, value_id + 1)
                            discard emit_v3_v(value_id + 2, function_id, 4, call_return_type, callee_start)
                            discard emit_v3_i_block(outer_call_id, function_id, current_block_id, outer_ordinal + 2, 14, 1, 1, -1, -1)
                            mut call_identity: i64 = find_function_identity(callee_start, callee_stop)
                            mut call_function_id: i64 = call_identity / 10
                            mut call_function_kind: i64 = call_identity - call_function_id * 10
                            discard emit_v3_c(outer_call_id, call_function_id, call_function_kind, callee_start, callee_stop - callee_start)
                            discard emit_v3_a(outer_call_id, 0, value_id + 1)
                            discard emit_v3_o(outer_call_id, 0, value_id + 1)
                            discard emit_v3_r(outer_call_id, 0, value_id + 2)
                            discard emit_v3_i_block(outer_branch_id, function_id, current_block_id, outer_ordinal + 3, 25, 0, 1, -1, -1)
                            discard emit_v3_o(outer_branch_id, 0, value_id + 2)
                            discard emit_v3_t_branch(outer_branch_id, negative_block, outer_neutral_block, outer_positive_block, value_id + 2)
                        1:
                            return -1
                    discard emit_v3_i_block(negative_jump_id, function_id, negative_block, negative_pre_loop_ordinal, 24, 0, 0, -1, -1)
                    discard emit_v3_t_jump(negative_jump_id, loop_block)
                    mut loop_next_id: i64 = scan_while_match_call_increment_break_v3(function_id, return_type, header_start, header_end, loop_first, loop_stop, negative_next_id, loop_block)
                    mut loop_result_kind: i64 = lowering_result_kind(loop_next_id)
                    match loop_result_kind >= 2:
                        -1:
                            mut outer_neutral_jump_id: i64 = function_id * 1000000 + outer_ordinal + condition_instruction_count
                            mut outer_positive_jump_id: i64 = function_id * 1000000 + outer_ordinal + condition_instruction_count + 1
                            discard emit_v3_i_block(outer_neutral_jump_id, function_id, outer_neutral_block, outer_ordinal + condition_instruction_count, 24, 0, 0, -1, -1)
                            discard emit_v3_t_jump(outer_neutral_jump_id, successor_block)
                            discard emit_v3_i_block(outer_positive_jump_id, function_id, outer_positive_block, outer_ordinal + condition_instruction_count + 1, 24, 0, 0, -1, -1)
                            discard emit_v3_t_jump(outer_positive_jump_id, successor_block)
                            discard emit_v3_b_block(function_id, current_block_id, current_block_id, outer_ordinal + condition_instruction_count, outer_branch_id)
                            discard emit_v3_b_block(function_id, negative_block, negative_block, negative_pre_loop_ordinal + 1, v3_context_instruction_id(negative_jump_id))
                            discard emit_v3_b_block(function_id, outer_neutral_block, outer_neutral_block, 1, outer_neutral_jump_id)
                            discard emit_v3_b_block(function_id, outer_positive_block, outer_positive_block, 1, outer_positive_jump_id)
                            mut decoded_loop_next_id: i64 = lowering_result_next_id(loop_next_id)
                            mut encoded_next_id: i64 = 3000000000000 + successor_block * 100000000000
                            encoded_next_id = encoded_next_id + decoded_loop_next_id * 1000000 + (outer_positive_body_stop + 1)
                            return encoded_next_id
                        0:
                            discard 0
                        1:
                            discard 0
                    match loop_result_kind == 0:
                        -1:
                            mut outer_neutral_jump_id: i64 = function_id * 1000000 + outer_ordinal + condition_instruction_count
                            mut outer_positive_jump_id: i64 = function_id * 1000000 + outer_ordinal + condition_instruction_count + 1
                            discard emit_v3_i_block(outer_neutral_jump_id, function_id, outer_neutral_block, outer_ordinal + condition_instruction_count, 24, 0, 0, -1, -1)
                            discard emit_v3_t_jump(outer_neutral_jump_id, successor_block)
                            discard emit_v3_i_block(outer_positive_jump_id, function_id, outer_positive_block, outer_ordinal + condition_instruction_count + 1, 24, 0, 0, -1, -1)
                            discard emit_v3_t_jump(outer_positive_jump_id, successor_block)
                            discard emit_v3_b_block(function_id, current_block_id, current_block_id, outer_ordinal + condition_instruction_count, outer_branch_id)
                            discard emit_v3_b_block(function_id, negative_block, negative_block, negative_pre_loop_ordinal + 1, v3_context_instruction_id(negative_jump_id))
                            discard emit_v3_b_block(function_id, outer_neutral_block, outer_neutral_block, 1, outer_neutral_jump_id)
                            discard emit_v3_b_block(function_id, outer_positive_block, outer_positive_block, 1, outer_positive_jump_id)
                            mut encoded_next_id: i64 = 3000000000000 + successor_block * 100000000000
                            encoded_next_id = encoded_next_id + loop_next_id * 1000000 + (outer_positive_body_stop + 1)
                            return encoded_next_id
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return 0
        1:
            return 0

fn scan_match_line(mode: i64, function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut identifier_comparison_info: i64 = parse_match_identifier_comparison(first, stop)
    match identifier_comparison_info > 0:
        -1:
            return scan_match_identifier_comparison(mode, function_id, header_start, header_end, first, stop, identifier_comparison_info, value_id)
        0:
            discard 0
        1:
            return -1
    mut comparison_info: i64 = parse_match_comparison(first, stop)
    match comparison_info > 0:
        -1:
            match mode == 2:
                -1:
                    return scan_match_v3(function_id, return_type, header_start, header_end, first, stop, comparison_info, value_id)
                0:
                    discard 0
                1:
                    return -1
            mut comparison_base: i64 = 1000000000000
            mut comparison_high: i64 = comparison_info / comparison_base
            mut remainder: i64 = comparison_info - comparison_high * comparison_base
            mut left_start: i64 = comparison_info / comparison_base
            mut left_stop: i64 = remainder / 1000000
            mut literal_start: i64 = remainder - left_stop * 1000000
            mut operand_type: i64 = find_parameter_type(header_start, header_end, left_start, left_stop)
            match operand_type > 0:
                -1:
                    match mode == 1:
                        -1:
                            mut operator_start: i64 = skip_spaces(left_stop, stop)
                            discard emit_v(value_id, function_id, 3, operand_type, literal_start, 0, 0, -1)
                            discard emit_v(value_id + 1, function_id, 4, 1, operator_start, 0, 0, -1)
                            return value_id + 2
                        0:
                            return value_id + 2
                        1:
                            return -1
                0:
                    mut local_type: i64 = find_local_type(header_end + 1, first, left_start, left_stop)
                    match local_type > 0:
                        -1:
                            match mode == 1:
                                -1:
                                    mut operator_start: i64 = skip_spaces(left_stop, stop)
                                    discard emit_v(value_id, function_id, 3, local_type, literal_start, 0, 0, -1)
                                    discard emit_v(value_id + 1, function_id, 4, 1, operator_start, 0, 0, -1)
                                    return value_id + 2
                                0:
                                    return value_id + 2
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                1:
                    return -1
        0:
            mut expression_start: i64 = skip_spaces(word_end(first, stop), stop)
            mut call_info: i64 = parse_match_call(first, stop)
            match call_info > 0:
                -1:
                    return scan_match_call(mode, function_id, header_start, header_end, first, expression_start, stop, call_info, value_id)
                0:
                    return -1
                1:
                    return -1
        1:
            return -1

fn match_branch_label_value(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    match read_byte(cursor) == 45:
        -1:
            return -1
        0:
            match read_byte(cursor) == 48:
                -1:
                    return 0
                0:
                    match read_byte(cursor) == 49:
                        -1:
                            return 1
                        0:
                            return 9
                        1:
                            return 9
                1:
                    return 9
        1:
            return 9

fn match_branch_return_literal(start: i64, end: i64) -> i64:
    mut return_info: i64 = parse_return(start, end)
    match return_info > 0:
        -1:
            mut return_kind: i64 = return_info / 1000000000000000
            match return_kind == 0:
                -1:
                    return return_info
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn validate_three_call_local_v3(header_start: i64, header_end: i64, body_limit: i64, argument_start: i64, argument_stop: i64) -> trit:
    mut local_value_id: i64 = find_core_local_value_id(header_end + 1, body_limit, argument_start, argument_stop)
    match local_value_id >= 0:
        -1:
            return -1
        0:
            return 0
        1:
            return 0

fn validate_three_call_identifier_v3(header_start: i64, header_end: i64, body_limit: i64, argument_start: i64, argument_stop: i64) -> trit:
    mut parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, argument_start, argument_stop)
    match parameter_ordinal >= 0:
        -1:
            return -1
        0:
            return validate_three_call_local_v3(header_start, header_end, body_limit, argument_start, argument_stop)
        1:
            return 0

fn validate_three_call_argument_v3(header_start: i64, header_end: i64, body_limit: i64, argument_span: i64, expected_type: i64) -> trit:
    match call_argument_is_literal(argument_span):
        -1:
            return -1
        0:
            mut argument_start: i64 = argument_span / 1000000
            mut argument_stop: i64 = argument_span - argument_start * 1000000
            mut argument_type: i64 = resolve_value_type(header_start, header_end, body_limit, argument_start, argument_stop)
            match argument_type == expected_type:
                -1:
                    return validate_three_call_identifier_v3(header_start, header_end, body_limit, argument_start, argument_stop)
                0:
                    return 0
                1:
                    return 0
        1:
            return 0

fn validate_return_three_call_v3(header_start: i64, header_end: i64, body_limit: i64, return_type: i64, expression_start: i64, stop: i64) -> trit:
    mut call_info: i64 = parse_call_three_arguments(expression_start, stop)
    match call_info > 0:
        -1:
            mut callee_start: i64 = call_info / 1000000
            mut callee_stop: i64 = call_info - callee_start * 1000000
            mut signature: i64 = find_function_signature(callee_start, callee_stop)
            match signature > 0:
                -1:
                    mut call_return_type: i64 = signature / 100
                    mut valid: trit = -1
                    match return_type_matches(call_return_type, return_type):
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                    mut parameter_zero_type: i64 = find_function_parameter_type_by_ordinal(callee_start, callee_stop, 0)
                    mut parameter_one_type: i64 = find_function_parameter_type_by_ordinal(callee_start, callee_stop, 1)
                    mut parameter_two_type: i64 = find_function_parameter_type_by_ordinal(callee_start, callee_stop, 2)
                    match parameter_zero_type > 0:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                    match parameter_one_type > 0:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                    match parameter_two_type > 0:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                    mut argument_zero_span: i64 = parse_call_argument_span(expression_start, stop, 0)
                    mut argument_one_span: i64 = parse_call_argument_span(expression_start, stop, 1)
                    mut argument_two_span: i64 = parse_call_argument_span(expression_start, stop, 2)
                    match validate_three_call_argument_v3(header_start, header_end, body_limit, argument_zero_span, parameter_zero_type):
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                    match validate_three_call_argument_v3(header_start, header_end, body_limit, argument_one_span, parameter_one_type):
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                    match validate_three_call_argument_v3(header_start, header_end, body_limit, argument_two_span, parameter_two_type):
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                    match find_function_identity(callee_start, callee_stop) > 0:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                    match valid == -1:
                        -1:
                            return -1
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn match_branch_body_kind(start: i64, end: i64) -> i64:
    mut body_first: i64 = first_non_space(start, end)
    match is_return_line(body_first, end):
        -1:
            return 1
        0:
            match parse_discard_zero(body_first, end) > 0:
                -1:
                    return 2
                0:
                    match body_first < end:
                        -1:
                            return 3
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 0
        1:
            return 0

fn match_nested_all_arms_terminal(start: i64, end: i64) -> trit:
    mut length: i64 = s3_stage1_source_length()
    mut header_stop: i64 = line_end(source_line_start(start), length)
    mut comparison_info: i64 = parse_match_comparison(start, header_stop)
    mut additive_info: i64 = parse_match_additive_relation(start, header_stop)
    mut call_info: i64 = parse_match_call(start, header_stop)
    mut nested_call_info: i64 = parse_match_nested_call(start, header_stop)
    mut nested_call_relation_info: i64 = parse_match_nested_call_relation(start, header_stop)
    mut recognized: trit = 0
    match comparison_info > 0:
        -1:
            recognized = -1
        0:
            match additive_info > 0:
                -1:
                    recognized = -1
                0:
                    match call_info > 0:
                        -1:
                            recognized = -1
                        0:
                            match nested_call_info > 0:
                                -1:
                                    recognized = -1
                                0:
                                    match nested_call_relation_info > 0:
                                        -1:
                                            recognized = -1
                                        0:
                                            discard 0
                                        1:
                                            discard 0
                                1:
                                    discard 0
                        1:
                            recognized = -1
                1:
                    recognized = -1
        1:
            recognized = -1
    match recognized == -1:
        -1:
            mut negative_first: i64 = match_arm_body_start(start, 0, length)
            mut neutral_first: i64 = match_arm_body_start(start, 1, length)
            mut positive_first: i64 = match_arm_body_start(start, 2, length)
            mut negative_stop: i64 = match_arm_body_stop(negative_first, length)
            mut neutral_stop: i64 = match_arm_body_stop(neutral_first, length)
            mut positive_stop: i64 = match_arm_body_stop(positive_first, length)
            mut negative_kind: i64 = 0
            mut neutral_kind: i64 = 0
            mut positive_kind: i64 = 0
            match is_return_line(negative_first, negative_stop):
                -1:
                    negative_kind = 1
                0:
                    discard 0
                1:
                    discard 0
            match is_return_line(neutral_first, neutral_stop):
                -1:
                    neutral_kind = 1
                0:
                    discard 0
                1:
                    discard 0
            match is_return_line(positive_first, positive_stop):
                -1:
                    positive_kind = 1
                0:
                    discard 0
                1:
                    discard 0
            return match_all_arms_terminal(negative_kind, neutral_kind, positive_kind)
        0:
            return 0
        1:
            return 0

fn scan_match_fallthrough_arm_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, body_first: i64, body_stop: i64, block_id: i64, successor_block: i64, value_id: i64) -> i64:
    mut body_dispatch_stop: i64 = body_stop
    mut body_function_id: i64 = function_id
    mut body_header_stop: i64 = line_end(source_line_start(body_first), s3_stage1_source_length())
    mut body_descriptor: i64 = match_condition_descriptor(body_first, body_header_stop)
    mut body_kind: i64 = match_condition_kind(body_descriptor)
    mut active_body_first: i64 = body_first
    mut prefix_first: i64 = body_first
    mut prefix_stop: i64 = body_header_stop
    mut next_body_first: i64 = first_non_space(body_header_stop + 1, body_stop)
    mut next_body_stop: i64 = line_end(next_body_first, s3_stage1_source_length())
    mut next_body_descriptor: i64 = 0
    mut next_body_kind: i64 = 0
    match next_body_first < body_stop:
        -1:
            next_body_descriptor = match_condition_descriptor(next_body_first, next_body_stop)
            next_body_kind = match_condition_kind(next_body_descriptor)
        0:
            discard 0
        1:
            discard 0
    mut body_value_id: i64 = value_id
    mut nested_match_block: i64 = successor_block + 1
    mut nested_entry_ordinal: i64 = count_core_instructions_between(header_end + 1, body_first)
    mut nested_entry_id: i64 = function_id * 1000000 + nested_entry_ordinal
    match body_kind > 0:
        -1:
            body_dispatch_stop = body_header_stop
            body_function_id = v3_context_function_id(v3_logical_function_id(function_id), nested_match_block)
            discard emit_v3_i_block(nested_entry_id, function_id, block_id, nested_entry_ordinal, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(nested_entry_id, nested_match_block)
            discard emit_v3_b_block(function_id, block_id, block_id, 1, v3_context_instruction_id(nested_entry_id))
        0:
            match next_body_kind > 0:
                -1:
                    mut prefix_next_id: i64 = scan_body_line(2, body_function_id, return_type, header_start, header_end, body_first, body_header_stop, value_id, body_first)
                    match prefix_next_id > 0:
                        -1:
                            body_value_id = prefix_next_id
                            active_body_first = next_body_first
                            body_header_stop = next_body_stop
                            body_descriptor = next_body_descriptor
                            body_kind = next_body_kind
                            body_dispatch_stop = body_header_stop
                            nested_entry_ordinal = count_core_instructions_between(header_end + 1, next_body_first)
                            nested_entry_id = function_id * 1000000 + nested_entry_ordinal
                            body_function_id = v3_context_function_id(v3_logical_function_id(function_id), nested_match_block)
                            discard emit_v3_i_block(nested_entry_id, function_id, block_id, nested_entry_ordinal, 24, 0, 0, -1, -1)
                            discard emit_v3_t_jump(nested_entry_id, nested_match_block)
                            discard emit_v3_b_block(function_id, block_id, block_id, count_core_instructions_between(prefix_first, prefix_stop) + 1, v3_context_instruction_id(nested_entry_id))
                        0:
                            return 0
                        1:
                            return 0
                0:
                    discard 0
                1:
                    discard 0
        1:
            discard 0
    mut next_id: i64 = 0
    match body_kind == 0:
        -1:
            match next_body_first < body_stop:
                -1:
                    match next_body_kind == 0:
                        -1:
                            mut prefix_next_id: i64 = scan_body_line(2, body_function_id, return_type, header_start, header_end, active_body_first, body_header_stop, body_value_id, active_body_first)
                            match lowering_result_kind(prefix_next_id) == 0:
                                -1:
                                    match prefix_next_id > 0:
                                        -1:
                                            next_id = scan_body_line(2, body_function_id, return_type, header_start, header_end, next_body_first, next_body_stop, prefix_next_id, next_body_first)
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            next_id = scan_body_line(2, body_function_id, return_type, header_start, header_end, active_body_first, body_dispatch_stop, body_value_id, active_body_first)
                        1:
                            return 0
                0:
                    next_id = scan_body_line(2, body_function_id, return_type, header_start, header_end, active_body_first, body_dispatch_stop, body_value_id, active_body_first)
                1:
                    next_id = scan_body_line(2, body_function_id, return_type, header_start, header_end, active_body_first, body_dispatch_stop, body_value_id, active_body_first)
        0:
            next_id = scan_body_line(2, body_function_id, return_type, header_start, header_end, active_body_first, body_dispatch_stop, body_value_id, active_body_first)
        1:
            next_id = scan_body_line(2, body_function_id, return_type, header_start, header_end, active_body_first, body_dispatch_stop, body_value_id, active_body_first)
    match next_id >= 1000000000000:
        -1:
            mut next_kind: i64 = lowering_result_kind(next_id)
            match next_kind == 3:
                -1:
                    mut nested_successor_block: i64 = lowering_result_next_block(next_id)
                    mut nested_next_id: i64 = lowering_result_next_id(next_id)
                    match nested_successor_block >= 0:
                        -1:
                            match nested_next_id >= 0:
                                -1:
                                    mut jump_ordinal: i64 = count_core_instructions_between(header_end + 1, body_stop)
                                    mut jump_id: i64 = function_id * 1000000 + jump_ordinal + 1
                                    discard emit_v3_i_block(jump_id, function_id, nested_successor_block, jump_ordinal, 24, 0, 0, -1, -1)
                                    discard emit_v3_t_jump(jump_id, successor_block)
                                    discard emit_v3_b_block(function_id, nested_successor_block, nested_successor_block, 1, v3_context_instruction_id(jump_id))
                                    return nested_next_id
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            match next_id > 0:
                -1:
                    mut jump_ordinal: i64 = count_core_instructions_between(header_end + 1, body_stop)
                    mut jump_id: i64 = function_id * 1000000 + jump_ordinal
                    discard emit_v3_i_block(jump_id, function_id, block_id, jump_ordinal, 24, 0, 0, -1, -1)
                    discard emit_v3_t_jump(jump_id, successor_block)
                    return next_id
                0:
                    return 0
                1:
                    return 0
        1:
            return 0

# Lower a relation match whose arms may terminate or fall through.  The
# successor context is returned to scan_program so later source lines inherit
# the successor block without using block 0 as an implicit fallback.
fn scan_match_relation_fallthrough_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, comparison_info: i64, value_id: i64, current_block_id: i64, current_block_start: i64, additive_literal_start: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut comparison_base: i64 = 1000000000000
    mut left_start: i64 = comparison_info / comparison_base
    mut remainder: i64 = comparison_info - left_start * comparison_base
    mut left_stop: i64 = remainder / 1000000
    mut literal_start: i64 = remainder - left_stop * 1000000
    mut additive_mode: trit = 0
    mut additive_literal_stop: i64 = 0
    mut operator_start: i64 = skip_spaces(left_stop, stop)
    mut operator_length: i64 = comparison_operator_length(operator_start, stop)
    match additive_literal_start > 0:
        -1:
            additive_mode = -1
            mut condition_start: i64 = skip_spaces(word_end(first, stop), stop)
            left_start = first_non_space(condition_start, stop)
            left_stop = word_end(left_start, stop)
            additive_literal_stop = number_end(additive_literal_start, stop)
            operator_start = skip_spaces(additive_literal_stop, stop)
            operator_length = comparison_operator_length(operator_start, stop)
            literal_start = skip_spaces(operator_start + operator_length, stop)
        0:
            discard 0
        1:
            discard 0
    mut right_cursor: i64 = literal_start
    mut right_identifier: trit = 0
    mut right_parameter_type: i64 = 0
    mut right_parameter_ordinal: i64 = -1
    mut right_word_stop: i64 = word_end(right_cursor, stop)
    match is_identifier_span(right_cursor, right_word_stop):
        -1:
            right_identifier = -1
            right_parameter_type = find_parameter_type(header_start, header_end, right_cursor, right_word_stop)
            right_parameter_ordinal = find_parameter_ordinal(header_start, header_end, right_cursor, right_word_stop)
        0:
            discard 0
        1:
            discard 0
    match read_byte(right_cursor) == 45:
        -1:
            right_cursor += 1
        0:
            discard 0
        1:
            discard 0
    mut right_stop: i64 = number_end(right_cursor, stop)
    match right_identifier == -1:
        -1:
            right_stop = right_word_stop
        0:
            discard 0
        1:
            discard 0
    mut branch_cursor: i64 = line_end(source_line_start(first), length) + 1
    mut negative_label_stop: i64 = line_end(branch_cursor, length)
    mut negative_body_start: i64 = negative_label_stop + 1
    mut negative_body_stop: i64 = match_arm_body_stop(negative_body_start, length)
    mut neutral_label_start: i64 = negative_body_stop + 1
    mut neutral_label_stop: i64 = line_end(neutral_label_start, length)
    mut neutral_body_start: i64 = neutral_label_stop + 1
    mut neutral_body_stop: i64 = match_arm_body_stop(neutral_body_start, length)
    mut positive_label_start: i64 = neutral_body_stop + 1
    mut positive_label_stop: i64 = line_end(positive_label_start, length)
    mut positive_body_start: i64 = positive_label_stop + 1
    mut positive_body_stop: i64 = match_arm_body_stop(positive_body_start, length)
    mut negative_body_first: i64 = match_arm_body_start(first, 0, length)
    mut neutral_body_first: i64 = match_arm_body_start(first, 1, length)
    mut positive_body_first: i64 = match_arm_body_start(first, 2, length)
    mut negative_kind: i64 = match_arm_effect(negative_body_first, negative_body_stop)
    mut neutral_kind: i64 = match_arm_effect(neutral_body_first, neutral_body_stop)
    mut positive_kind: i64 = match_arm_effect(positive_body_first, positive_body_stop)
    mut negative_header_stop: i64 = line_end(source_line_start(negative_body_first), length)
    mut neutral_header_stop: i64 = line_end(source_line_start(neutral_body_first), length)
    mut positive_header_stop: i64 = line_end(source_line_start(positive_body_first), length)
    mut negative_next_first: i64 = first_non_space(negative_header_stop + 1, negative_body_stop)
    mut neutral_next_first: i64 = first_non_space(neutral_header_stop + 1, neutral_body_stop)
    mut positive_next_first: i64 = first_non_space(positive_header_stop + 1, positive_body_stop)
    mut negative_next_stop: i64 = line_end(negative_next_first, length)
    mut neutral_next_stop: i64 = line_end(neutral_next_first, length)
    mut positive_next_stop: i64 = line_end(positive_next_first, length)
    mut negative_next_kind: i64 = 0
    mut neutral_next_kind: i64 = 0
    mut positive_next_kind: i64 = 0
    match negative_next_first < negative_body_stop:
        -1:
            negative_next_kind = match_condition_kind(match_condition_descriptor(negative_next_first, negative_next_stop))
        0:
            discard 0
        1:
            discard 0
    match neutral_next_first < neutral_body_stop:
        -1:
            neutral_next_kind = match_condition_kind(match_condition_descriptor(neutral_next_first, neutral_next_stop))
        0:
            discard 0
        1:
            discard 0
    match positive_next_first < positive_body_stop:
        -1:
            positive_next_kind = match_condition_kind(match_condition_descriptor(positive_next_first, positive_next_stop))
        0:
            discard 0
        1:
            discard 0
    mut negative_is_nested: trit = 0
    mut neutral_is_nested: trit = 0
    mut positive_is_nested: trit = 0
    match match_condition_kind(match_condition_descriptor(negative_body_first, negative_header_stop)) > 0:
        -1:
            negative_is_nested = -1
        0:
            match negative_next_kind > 0:
                -1:
                    negative_is_nested = -1
                0:
                    discard 0
                1:
                    discard 0
        1:
            discard 0
    match match_condition_kind(match_condition_descriptor(neutral_body_first, neutral_header_stop)) > 0:
        -1:
            neutral_is_nested = -1
        0:
            match neutral_next_kind > 0:
                -1:
                    neutral_is_nested = -1
                0:
                    discard 0
                1:
                    discard 0
        1:
            discard 0
    match match_condition_kind(match_condition_descriptor(positive_body_first, positive_header_stop)) > 0:
        -1:
            positive_is_nested = -1
        0:
            match positive_next_kind > 0:
                -1:
                    positive_is_nested = -1
                0:
                    discard 0
                1:
                    discard 0
        1:
            discard 0
    mut valid: trit = -1
    match operator_length < 3:
        -1:
            discard 0
        0:
            match right_parameter_type > 0:
                -1:
                    discard 0
                0:
                    # A zero RHS parameter type denotes a parsed literal here.
                    # The shared fallthrough relation accepts both literal and
                    # parameter RHS operands; unknown identifiers are rejected
                    # by the later parameter-ordinal check.
                    discard 0
                1:
                    discard 0
        1:
            valid = 0
    match right_stop > literal_start:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(branch_cursor, negative_label_stop), negative_label_stop) == -1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match right_identifier == -1:
        -1:
            match right_parameter_type > 0:
                -1:
                    match right_parameter_ordinal >= 0:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            discard 0
        1:
            discard 0
    match match_branch_label_value(first_non_space(neutral_label_start, neutral_label_stop), neutral_label_stop) == 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match match_branch_label_value(first_non_space(positive_label_start, positive_label_stop), positive_label_stop) == 1:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match negative_kind > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match neutral_kind > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match positive_kind > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    mut parameter_type: i64 = find_parameter_type(header_start, header_end, left_start, left_stop)
    mut local_type: i64 = find_local_type(header_end + 1, first, left_start, left_stop)
    mut left_type: i64 = parameter_type
    mut storage_id: i64 = -1
    mut left_value_id: i64 = -1
    mut parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, left_start, left_stop)
    match parameter_type > 0:
        -1:
            match parameter_ordinal >= 0:
                -1:
                    # V3 parameters are emitted in header order from value 0;
                    # local values must not shift their identity.
                    left_value_id = parameter_ordinal
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            match local_type > 0:
                -1:
                    left_type = local_type
                    storage_id = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
                    match storage_id >= 0:
                        -1:
                            left_value_id = value_id
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
        1:
            valid = 0
    match right_parameter_type > 0:
        -1:
            match left_type == right_parameter_type:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            discard 0
        1:
            discard 0
    match additive_mode == -1:
        -1:
            match additive_literal_stop > additive_literal_start:
                -1:
                    match left_type == 3:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            discard 0
        1:
            discard 0
    match valid == -1:
        -1:
            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
            mut base_id: i64 = function_id * 1000000 + ordinal
            mut condition_count: i64 = 3
            mut left_index_id: i64 = base_id
            mut left_load_id: i64 = base_id
            mut right_id: i64 = base_id
            mut compare_id: i64 = base_id + 1
            mut branch_id: i64 = base_id + 2
            mut left_index_value: i64 = value_id
            mut left_load_value: i64 = value_id
            mut right_value: i64 = value_id
            mut compare_value: i64 = value_id + 1
            mut next_id: i64 = value_id + 2
            mut additive_const_id: i64 = base_id
            mut additive_id: i64 = base_id
            mut additive_const_value: i64 = value_id
            mut additive_value: i64 = value_id
            mut additive_left_value: i64 = left_value_id
            match right_parameter_type > 0:
                -1:
                    right_value = right_parameter_ordinal
                    compare_value = value_id
                    next_id = value_id + 1
                    condition_count = condition_count - 1
                    match storage_id >= 0:
                        -1:
                            compare_id = base_id + 2
                            branch_id = base_id + 3
                        0:
                            compare_id = base_id
                            branch_id = base_id + 1
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
            match storage_id >= 0:
                -1:
                    condition_count = 5
                    left_load_id = base_id + 1
                    right_id = base_id + 2
                    compare_id = base_id + 3
                    branch_id = base_id + 4
                    left_load_value = value_id + 1
                    match right_parameter_type > 0:
                        -1:
                            # A parameter is already a produced V3 value.  The
                            # storage load adds only its own value and the
                            # compare result; it must not manufacture a RHS V.
                            condition_count = 4
                            right_id = base_id + 2
                            compare_id = base_id + 2
                            branch_id = base_id + 3
                            compare_value = value_id + 2
                            next_id = value_id + 3
                        0:
                            right_value = value_id + 2
                            compare_value = value_id + 3
                            next_id = value_id + 4
                        1:
                            discard 0
                    discard emit_v3_v(left_index_value, function_id, 2, 2, left_start)
                    discard emit_v3_v(left_load_value, function_id, 3, left_type, left_start)
                    discard emit_v3_i_block(left_index_id, function_id, current_block_id, ordinal, 1, 1, 0, -1, 0)
                    discard emit_v3_r(left_index_id, 0, left_index_value)
                    discard emit_v3_i_block(left_load_id, function_id, current_block_id, ordinal + 1, 15, 1, 1, storage_id, -1)
                    discard emit_v3_o(left_load_id, 0, left_index_value)
                    discard emit_v3_r(left_load_id, 0, left_load_value)
                0:
                    discard 0
                1:
                    discard 0
            match additive_mode == -1:
                -1:
                    match storage_id >= 0:
                        -1:
                            condition_count = 7
                            additive_const_id = base_id + 2
                            additive_id = base_id + 3
                            right_id = base_id + 4
                            compare_id = base_id + 5
                            branch_id = base_id + 6
                            additive_const_value = value_id + 2
                            additive_value = value_id + 3
                            right_value = value_id + 4
                            compare_value = value_id + 5
                            next_id = value_id + 6
                            additive_left_value = left_load_value
                            discard emit_v3_v(additive_const_value, function_id, 2, left_type, additive_literal_start)
                            discard emit_v3_v(additive_value, function_id, 3, left_type, additive_literal_start)
                            discard emit_v3_i_block(additive_const_id, function_id, current_block_id, ordinal + 2, 1, 1, 0, -1, parse_integer_literal(additive_literal_start, additive_literal_stop))
                            discard emit_v3_r(additive_const_id, 0, additive_const_value)
                            discard emit_v3_i_block(additive_id, function_id, current_block_id, ordinal + 3, 5, 1, 2, -1, -1)
                            discard emit_v3_o(additive_id, 0, additive_left_value)
                            discard emit_v3_o(additive_id, 1, additive_const_value)
                            discard emit_v3_r(additive_id, 0, additive_value)
                        0:
                            condition_count = 5
                            additive_const_id = base_id
                            additive_id = base_id + 1
                            right_id = base_id + 2
                            compare_id = base_id + 3
                            branch_id = base_id + 4
                            additive_const_value = value_id
                            additive_value = value_id + 1
                            right_value = value_id + 2
                            compare_value = value_id + 3
                            next_id = value_id + 4
                            additive_left_value = left_value_id
                            discard emit_v3_v(additive_const_value, function_id, 2, left_type, additive_literal_start)
                            discard emit_v3_v(additive_value, function_id, 3, left_type, additive_literal_start)
                            discard emit_v3_i_block(additive_const_id, function_id, current_block_id, ordinal, 1, 1, 0, -1, parse_integer_literal(additive_literal_start, additive_literal_stop))
                            discard emit_v3_r(additive_const_id, 0, additive_const_value)
                            discard emit_v3_i_block(additive_id, function_id, current_block_id, ordinal + 1, 5, 1, 2, -1, -1)
                            discard emit_v3_o(additive_id, 0, additive_left_value)
                            discard emit_v3_o(additive_id, 1, additive_const_value)
                            discard emit_v3_r(additive_id, 0, additive_value)
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
            # Re-select a parameter RHS after storage/additive allocation.
            # The parameter's existing V3 identity must survive the temporary
            # value slots used by the relation lowering.
            match right_parameter_type > 0:
                -1:
                    right_value = right_parameter_ordinal
                0:
                    discard 0
                1:
                    discard 0
            match right_parameter_type > 0:
                -1:
                    discard 0
                0:
                    discard emit_v3_v(right_value, function_id, 2, left_type, literal_start)
                1:
                    discard 0
            discard emit_v3_v(compare_value, function_id, 3, 1, operator_start)
            match right_parameter_type > 0:
                -1:
                    discard 0
                0:
                    discard emit_v3_i_block(right_id, function_id, current_block_id, ordinal + condition_count - 3, 1, 1, 0, -1, parse_integer_literal(literal_start, right_stop))
                    discard emit_v3_r(right_id, 0, right_value)
                1:
                    discard 0
            discard emit_v3_i_block(compare_id, function_id, current_block_id, ordinal + condition_count - 2, 13, 1, 2, -1, -1)
            match additive_mode == -1:
                -1:
                    discard emit_v3_o(compare_id, 0, additive_value)
                0:
                    discard emit_v3_o(compare_id, 0, left_value_id)
                1:
                    discard emit_v3_o(compare_id, 0, left_value_id)
            discard emit_v3_o(compare_id, 1, right_value)
            discard emit_v3_r(compare_id, 0, compare_value)
            discard emit_v3_i_block(branch_id, function_id, current_block_id, ordinal + condition_count - 1, 25, 0, 1, -1, -1)
            discard emit_v3_o(branch_id, 0, compare_value)
            mut negative_block: i64 = match_arm_block(current_block_id, 0)
            mut neutral_block: i64 = match_arm_block(current_block_id, 1)
            mut positive_block: i64 = match_arm_block(current_block_id, 2)
            mut successor_block: i64 = match_successor_block(current_block_id)
            discard emit_v3_t_branch(branch_id, negative_block, neutral_block, positive_block, compare_value)
            match negative_kind == 1:
                -1:
                    mut negative_next_id: i64 = 0
                    match negative_is_nested == -1:
                        -1:
                            negative_next_id = scan_match_line_context(2, v3_context_function_id(v3_logical_function_id(function_id), negative_block), return_type, header_start, header_end, negative_body_first, negative_header_stop, next_id, negative_block, negative_body_first)
                            match lowering_result_kind(negative_next_id) == 2:
                                -1:
                                    negative_next_id = lowering_result_next_id(negative_next_id)
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            negative_next_id = scan_statement_body(2, v3_context_function_id(v3_logical_function_id(function_id), negative_block), return_type, header_start, header_end, negative_body_first, negative_body_stop, next_id)
                        1:
                            negative_next_id = scan_statement_body(2, v3_context_function_id(v3_logical_function_id(function_id), negative_block), return_type, header_start, header_end, negative_body_first, negative_body_stop, next_id)
                    match negative_next_id > 0:
                        -1:
                            next_id = negative_next_id
                        0:
                            return 0
                        1:
                            return 0
                0:
                    match negative_kind > 1:
                        -1:
                            mut negative_next_id: i64 = scan_match_fallthrough_arm_v3(v3_context_function_id(v3_logical_function_id(function_id), negative_block), return_type, header_start, header_end, negative_body_first, negative_body_stop, negative_block, successor_block, next_id)
                            match negative_next_id > 0:
                                -1:
                                    next_id = negative_next_id
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 0
            match neutral_kind == 1:
                -1:
                    mut neutral_next_id: i64 = 0
                    match neutral_is_nested == -1:
                        -1:
                            neutral_next_id = scan_match_line_context(2, v3_context_function_id(v3_logical_function_id(function_id), neutral_block), return_type, header_start, header_end, neutral_body_first, neutral_header_stop, next_id, neutral_block, neutral_body_first)
                            match lowering_result_kind(neutral_next_id) == 2:
                                -1:
                                    neutral_next_id = lowering_result_next_id(neutral_next_id)
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            neutral_next_id = scan_statement_body(2, v3_context_function_id(v3_logical_function_id(function_id), neutral_block), return_type, header_start, header_end, neutral_body_first, neutral_body_stop, next_id)
                        1:
                            neutral_next_id = scan_statement_body(2, v3_context_function_id(v3_logical_function_id(function_id), neutral_block), return_type, header_start, header_end, neutral_body_first, neutral_body_stop, next_id)
                    match neutral_next_id > 0:
                        -1:
                            next_id = neutral_next_id
                        0:
                            return 0
                        1:
                            return 0
                0:
                    match neutral_kind > 1:
                        -1:
                            mut neutral_next_id: i64 = scan_match_fallthrough_arm_v3(v3_context_function_id(v3_logical_function_id(function_id), neutral_block), return_type, header_start, header_end, neutral_body_first, neutral_body_stop, neutral_block, successor_block, next_id)
                            match neutral_next_id > 0:
                                -1:
                                    next_id = neutral_next_id
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 0
            match positive_kind == 1:
                -1:
                    mut positive_next_id: i64 = 0
                    match positive_is_nested == -1:
                        -1:
                            positive_next_id = scan_match_line_context(2, v3_context_function_id(v3_logical_function_id(function_id), positive_block), return_type, header_start, header_end, positive_body_first, positive_header_stop, next_id, positive_block, positive_body_first)
                            match lowering_result_kind(positive_next_id) == 2:
                                -1:
                                    positive_next_id = lowering_result_next_id(positive_next_id)
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            positive_next_id = scan_statement_body(2, v3_context_function_id(v3_logical_function_id(function_id), positive_block), return_type, header_start, header_end, positive_body_first, positive_body_stop, next_id)
                        1:
                            positive_next_id = scan_statement_body(2, v3_context_function_id(v3_logical_function_id(function_id), positive_block), return_type, header_start, header_end, positive_body_first, positive_body_stop, next_id)
                    match positive_next_id > 0:
                        -1:
                            next_id = positive_next_id
                        0:
                            return 0
                        1:
                            return 0
                0:
                    match positive_kind > 1:
                        -1:
                            mut positive_next_id: i64 = scan_match_fallthrough_arm_v3(v3_context_function_id(v3_logical_function_id(function_id), positive_block), return_type, header_start, header_end, positive_body_first, positive_body_stop, positive_block, successor_block, next_id)
                            match positive_next_id > 0:
                                -1:
                                    next_id = positive_next_id
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 0
            discard emit_v3_b_block(function_id, current_block_id, current_block_id, count_core_instructions_between(current_block_start, first) + condition_count, v3_context_instruction_id(branch_id))
            match negative_is_nested == -1:
                -1:
                    discard 0
                0:
                    match negative_kind == 1:
                        -1:
                            mut negative_terminal_context_function_id: i64 = v3_context_function_id(v3_logical_function_id(function_id), negative_block)
                            discard emit_v3_b_block(function_id, negative_block, negative_block, v3_return_instruction_count(negative_body_first, negative_body_stop), v3_return_terminator_id(negative_terminal_context_function_id, header_start, header_end, negative_body_first, negative_body_stop))
                        0:
                            mut negative_body_instruction_count: i64 = count_core_instructions_between(negative_body_first, negative_body_stop)
                            mut negative_jump_ordinal: i64 = count_core_instructions_between(header_end + 1, negative_body_stop)
                            mut negative_context_function_id: i64 = v3_context_function_id(v3_logical_function_id(function_id), negative_block)
                            discard emit_v3_b_block(function_id, negative_block, negative_block, negative_body_instruction_count + 1, v3_context_instruction_id(negative_context_function_id * 1000000 + negative_jump_ordinal))
                        1:
                            discard 0
                1:
                    discard 0
            match neutral_is_nested == -1:
                -1:
                    discard 0
                0:
                    match neutral_kind == 1:
                        -1:
                            mut neutral_terminal_context_function_id: i64 = v3_context_function_id(v3_logical_function_id(function_id), neutral_block)
                            discard emit_v3_b_block(function_id, neutral_block, neutral_block, v3_return_instruction_count(neutral_body_first, neutral_body_stop), v3_return_terminator_id(neutral_terminal_context_function_id, header_start, header_end, neutral_body_first, neutral_body_stop))
                        0:
                            mut neutral_body_instruction_count: i64 = count_core_instructions_between(neutral_body_first, neutral_body_stop)
                            mut neutral_jump_ordinal: i64 = count_core_instructions_between(header_end + 1, neutral_body_stop)
                            mut neutral_context_function_id: i64 = v3_context_function_id(v3_logical_function_id(function_id), neutral_block)
                            discard emit_v3_b_block(function_id, neutral_block, neutral_block, neutral_body_instruction_count + 1, v3_context_instruction_id(neutral_context_function_id * 1000000 + neutral_jump_ordinal))
                        1:
                            discard 0
                1:
                    discard 0
            match positive_is_nested == -1:
                -1:
                    discard 0
                0:
                    match positive_kind == 1:
                        -1:
                            mut positive_terminal_context_function_id: i64 = v3_context_function_id(v3_logical_function_id(function_id), positive_block)
                            discard emit_v3_b_block(function_id, positive_block, positive_block, v3_return_instruction_count(positive_body_first, positive_body_stop), v3_return_terminator_id(positive_terminal_context_function_id, header_start, header_end, positive_body_first, positive_body_stop))
                        0:
                            mut positive_body_instruction_count: i64 = count_core_instructions_between(positive_body_first, positive_body_stop)
                            mut positive_jump_ordinal: i64 = count_core_instructions_between(header_end + 1, positive_body_stop)
                            mut positive_context_function_id: i64 = v3_context_function_id(v3_logical_function_id(function_id), positive_block)
                            discard emit_v3_b_block(function_id, positive_block, positive_block, positive_body_instruction_count + 1, v3_context_instruction_id(positive_context_function_id * 1000000 + positive_jump_ordinal))
                        1:
                            discard 0
                1:
                    discard 0
            match match_all_arms_terminal(negative_kind, neutral_kind, positive_kind):
                -1:
                    return match_result_terminal(next_id, positive_body_stop + 1)
                0:
                    return match_result_continuation(next_id, positive_body_stop + 1, successor_block)
                1:
                    return match_result_continuation(next_id, positive_body_stop + 1, successor_block)
        0:
            return 0
        1:
            return 0

fn match_arm_body_stop(start: i64, length: i64) -> i64:
    mut body_line_start: i64 = source_line_start(start)
    mut label_line_start: i64 = source_line_start(body_line_start - 1)
    mut label_line_stop: i64 = line_end(label_line_start, length)
    mut label_first: i64 = first_non_space(label_line_start, label_line_stop)
    mut boundary: i64 = while_body_end(label_first, length)
    match boundary > body_line_start:
        -1:
            return line_end(boundary - 1, length)
        0:
            return line_end(start, length)
        1:
            return line_end(boundary - 1, length)

fn match_arm_body_start(match_start: i64, arm_index: i64, length: i64) -> i64:
    mut cursor: i64 = line_end(source_line_start(match_start), length) + 1
    mut current: i64 = 0
    while current < arm_index:
        mut label_stop: i64 = line_end(cursor, length)
        mut body_start: i64 = label_stop + 1
        cursor = match_arm_body_stop(body_start, length) + 1
        current += 1
    mut label_stop: i64 = line_end(cursor, length)
    mut body_start: i64 = label_stop + 1
    mut body_stop: i64 = match_arm_body_stop(body_start, length)
    return first_non_space(body_start, body_stop)

fn match_arm_effect(start: i64, end: i64) -> i64:
    mut body_first: i64 = first_non_space(start, end)
    mut nested_terminal: trit = match_nested_all_arms_terminal(body_first, end)
    match nested_terminal == -1:
        -1:
            return 1
        0:
            discard 0
        1:
            discard 0
    match is_return_line(body_first, end):
        -1:
            return 1
        0:
            match parse_discard_zero(body_first, end) > 0:
                -1:
                    return 2
                0:
                    match body_first < end:
                        -1:
                            return 3
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 0
        1:
            return 0

fn match_all_arms_terminal_effect(first: i64, end: i64) -> trit:
    mut length: i64 = s3_stage1_source_length()
    mut negative_first: i64 = match_arm_body_start(first, 0, length)
    mut neutral_first: i64 = match_arm_body_start(first, 1, length)
    mut positive_first: i64 = match_arm_body_start(first, 2, length)
    mut negative_stop: i64 = match_arm_body_stop(negative_first, length)
    mut neutral_stop: i64 = match_arm_body_stop(neutral_first, length)
    mut positive_stop: i64 = match_arm_body_stop(positive_first, length)
    mut negative_kind: i64 = match_arm_effect(negative_first, negative_stop)
    mut neutral_kind: i64 = match_arm_effect(neutral_first, neutral_stop)
    mut positive_kind: i64 = match_arm_effect(positive_first, positive_stop)
    return match_all_arms_terminal(negative_kind, neutral_kind, positive_kind)

fn match_branch_body_stop_v3(start: i64, length: i64) -> i64:
    return match_arm_body_stop(start, length)

fn match_has_nested_body_v3(first: i64, length: i64) -> trit:
    mut branch_cursor: i64 = line_end(source_line_start(first), length) + 1
    mut branch_number: i64 = 0
    while branch_number < 3:
        mut body_first: i64 = match_arm_body_start(first, branch_number, length)
        mut body_stop: i64 = match_arm_body_stop(body_first, length)
        mut body_header_stop: i64 = line_end(source_line_start(body_first), length)
        mut nested_comparison: i64 = parse_match_comparison(body_first, body_header_stop)
        mut nested_additive: i64 = parse_match_additive_relation(body_first, body_header_stop)
        mut nested_call: i64 = parse_match_call(body_first, body_header_stop)
        mut nested_call_relation: i64 = parse_match_nested_call_relation(body_first, body_header_stop)
        mut nested: trit = 0
        match nested_comparison > 0:
            -1:
                nested = -1
            0:
                match nested_additive > 0:
                    -1:
                        nested = -1
                    0:
                        match nested_call > 0:
                            -1:
                                nested = -1
                            0:
                                match nested_call_relation > 0:
                                    -1:
                                        nested = -1
                                    0:
                                        discard 0
                                    1:
                                        discard 0
                            1:
                                discard 0
                    1:
                        nested = -1
            1:
                nested = -1
        match nested == -1:
            -1:
                return -1
            0:
                match nested_comparison > 0:
                    -1:
                        branch_cursor = while_body_end(body_first, length)
                    0:
                        match nested_additive > 0:
                            -1:
                                branch_cursor = while_body_end(body_first, length)
                            0:
                                match nested_call > 0:
                                    -1:
                                        branch_cursor = while_body_end(body_first, length)
                                    0:
                                        match nested_call_relation > 0:
                                            -1:
                                                branch_cursor = while_body_end(body_first, length)
                                            0:
                                                branch_cursor = body_stop + 1
                                            1:
                                                branch_cursor = while_body_end(body_first, length)
                                    1:
                                        branch_cursor = while_body_end(body_first, length)
                            1:
                                branch_cursor = while_body_end(body_first, length)
                    1:
                        branch_cursor = while_body_end(body_first, length)
            1:
                return -1
        branch_number += 1
    return 0

# Lower the canonical nested predicate shape whose nested match has no local
# continuation.  The explicit blocks keep the outer successor separate from
# both nested matches, while unsupported shapes remain fail-closed.
fn scan_match_nested_predicate_no_continuation_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut outer_comparison_info: i64 = parse_match_comparison(first, stop)
    mut outer_base: i64 = 1000000000000
    mut outer_left_start: i64 = outer_comparison_info / outer_base
    mut outer_remainder: i64 = outer_comparison_info - outer_left_start * outer_base
    mut outer_left_stop: i64 = outer_remainder / 1000000
    mut outer_literal_start: i64 = outer_remainder - outer_left_stop * 1000000
    mut outer_operator_start: i64 = skip_spaces(outer_left_stop, stop)
    mut outer_operator_length: i64 = comparison_operator_length(outer_operator_start, stop)
    mut outer_negative_label_start: i64 = line_end(source_line_start(first), length) + 1
    mut outer_negative_label_stop: i64 = line_end(outer_negative_label_start, length)
    mut outer_negative_body_start: i64 = outer_negative_label_stop + 1
    mut outer_negative_body_first: i64 = first_non_space(outer_negative_body_start, length)
    mut nested_match_end: i64 = while_body_end(outer_negative_body_first, length)
    mut outer_negative_body_stop: i64 = match_branch_body_stop_v3(outer_negative_body_first, length)
    mut outer_neutral_label_start: i64 = nested_match_end
    mut outer_neutral_label_stop: i64 = line_end(outer_neutral_label_start, length)
    mut outer_neutral_body_start: i64 = outer_neutral_label_stop + 1
    mut outer_neutral_body_stop: i64 = match_branch_body_stop_v3(first_non_space(outer_neutral_body_start, length), length)
    mut outer_positive_label_start: i64 = outer_neutral_body_stop + 1
    mut outer_positive_label_stop: i64 = line_end(outer_positive_label_start, length)
    mut outer_positive_body_start: i64 = outer_positive_label_stop + 1
    mut outer_positive_body_stop: i64 = match_branch_body_stop_v3(first_non_space(outer_positive_body_start, length), length)
    mut outer_after_start: i64 = while_body_end(first, length)
    mut outer_after_stop: i64 = line_end(outer_after_start, length)
    mut nested_match_stop: i64 = line_end(outer_negative_body_first, length)
    mut nested_word_stop: i64 = word_end(outer_negative_body_first, nested_match_stop)
    mut nested_left_start: i64 = skip_spaces(nested_word_stop, nested_match_stop)
    mut nested_left_stop: i64 = word_end(nested_left_start, nested_match_stop)
    mut nested_add_operator_start: i64 = skip_spaces(nested_left_stop, nested_match_stop)
    mut nested_add_literal_start: i64 = first_non_space(nested_add_operator_start + 1, nested_match_stop)
    mut nested_add_literal_stop: i64 = number_end(nested_add_literal_start, nested_match_stop)
    mut nested_operator_start: i64 = skip_spaces(nested_add_literal_stop, nested_match_stop)
    mut nested_operator_length: i64 = comparison_operator_length(nested_operator_start, nested_match_stop)
    mut nested_right_start: i64 = skip_spaces(nested_operator_start + nested_operator_length, nested_match_stop)
    mut nested_right_stop: i64 = word_end(nested_right_start, nested_match_stop)
    mut nested_negative_label_start: i64 = line_end(source_line_start(outer_negative_body_first), length) + 1
    mut nested_negative_label_stop: i64 = line_end(nested_negative_label_start, length)
    mut nested_negative_body_start: i64 = nested_negative_label_stop + 1
    mut nested_negative_body_first: i64 = first_non_space(nested_negative_body_start, length)
    mut nested_match_body_stop: i64 = match_branch_body_stop_v3(nested_negative_body_first, length)
    mut nested_neutral_label_start: i64 = nested_match_body_stop + 1
    mut nested_neutral_label_stop: i64 = line_end(nested_neutral_label_start, length)
    mut nested_neutral_body_start: i64 = nested_neutral_label_stop + 1
    mut nested_neutral_body_stop: i64 = match_branch_body_stop_v3(first_non_space(nested_neutral_body_start, length), length)
    mut nested_positive_label_start: i64 = nested_neutral_body_stop + 1
    mut nested_positive_label_stop: i64 = line_end(nested_positive_label_start, length)
    mut nested_positive_body_start: i64 = nested_positive_label_stop + 1
    mut nested_positive_body_stop: i64 = match_branch_body_stop_v3(first_non_space(nested_positive_body_start, length), length)
    mut inner_match_header_stop: i64 = line_end(nested_negative_body_first, length)
    mut inner_match_info: i64 = parse_match_nested_additive_call(nested_negative_body_first, inner_match_header_stop)
    mut inner_callee_start: i64 = inner_match_info / 1000000
    mut inner_callee_stop: i64 = inner_match_info - inner_callee_start * 1000000
    mut inner_open: i64 = skip_spaces(inner_callee_stop, inner_match_header_stop)
    mut inner_close: i64 = matching_close(inner_open, inner_match_header_stop)
    mut read_call_start: i64 = first_non_space(inner_open + 1, inner_close)
    mut read_callee_start: i64 = read_call_start
    mut read_callee_stop: i64 = word_end(read_callee_start, inner_close)
    mut read_open: i64 = skip_spaces(read_callee_stop, inner_close)
    mut read_close: i64 = matching_close(read_open, inner_close)
    mut read_argument_start: i64 = first_non_space(read_open + 1, read_close)
    mut read_argument_stop: i64 = word_end(read_argument_start, read_close)
    mut read_add_operator_start: i64 = skip_spaces(read_argument_stop, read_close)
    mut read_add_literal_start: i64 = first_non_space(read_add_operator_start + 1, read_close)
    mut read_add_literal_stop: i64 = number_end(read_add_literal_start, read_close)
    mut inner_negative_label_start: i64 = line_end(source_line_start(nested_negative_body_first), length) + 1
    mut inner_negative_label_stop: i64 = line_end(inner_negative_label_start, length)
    mut inner_negative_body_start: i64 = inner_negative_label_stop + 1
    mut inner_negative_body_stop: i64 = match_branch_body_stop_v3(first_non_space(inner_negative_body_start, length), length)
    mut inner_assignment_first: i64 = first_non_space(inner_negative_body_start, inner_negative_body_stop)
    mut inner_assignment_stop: i64 = line_end(inner_assignment_first, length)
    mut inner_increment_start: i64 = first_non_space(inner_assignment_stop + 1, inner_negative_body_stop)
    mut inner_increment_stop: i64 = line_end(inner_increment_start, length)
    mut inner_neutral_label_start: i64 = inner_negative_body_stop + 1
    mut inner_neutral_label_stop: i64 = line_end(inner_neutral_label_start, length)
    mut inner_neutral_body_start: i64 = inner_neutral_label_stop + 1
    mut inner_neutral_body_stop: i64 = match_branch_body_stop_v3(first_non_space(inner_neutral_body_start, length), length)
    mut inner_positive_label_start: i64 = inner_neutral_body_stop + 1
    mut inner_positive_label_stop: i64 = line_end(inner_positive_label_start, length)
    mut inner_positive_body_start: i64 = inner_positive_label_stop + 1
    mut inner_positive_body_stop: i64 = match_branch_body_stop_v3(first_non_space(inner_positive_body_start, length), length)
    mut assignment_target_start: i64 = inner_assignment_first
    mut assignment_target_stop: i64 = word_end(assignment_target_start, inner_assignment_stop)
    mut assignment_operator_start: i64 = skip_spaces(assignment_target_stop, inner_assignment_stop)
    mut assignment_value_start: i64 = first_non_space(assignment_operator_start + 1, inner_assignment_stop)
    mut assignment_value_cursor: i64 = assignment_value_start
    match read_byte(assignment_value_cursor) == 45:
        -1:
            assignment_value_cursor += 1
        0:
            discard 0
        1:
            discard 0
    mut assignment_value_stop: i64 = number_end(assignment_value_cursor, inner_assignment_stop)
    mut outer_left_type: i64 = resolve_value_type(header_start, header_end, first, outer_left_start, outer_left_stop)
    mut nested_left_type: i64 = resolve_value_type(header_start, header_end, outer_negative_body_first, nested_left_start, nested_left_stop)
    mut nested_right_type: i64 = find_parameter_type(header_start, header_end, nested_right_start, nested_right_stop)
    mut position_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, nested_left_start, nested_left_stop)
    mut negative_storage_id: i64 = find_mutable_storage_id(header_end + 1, inner_assignment_first, assignment_target_start, assignment_target_stop)
    mut assignment_type: i64 = resolve_value_type(header_start, header_end, inner_assignment_first, assignment_target_start, assignment_target_stop)
    mut inner_signature: i64 = find_function_signature(inner_callee_start, inner_callee_stop)
    mut read_signature: i64 = find_function_signature(read_callee_start, read_callee_stop)
    mut inner_return_type: i64 = inner_signature / 100
    mut read_return_type: i64 = read_signature / 100
    mut inner_parameter_type: i64 = find_function_parameter_type_by_ordinal(inner_callee_start, inner_callee_stop, 0)
    mut read_parameter_type: i64 = find_function_parameter_type_by_ordinal(read_callee_start, read_callee_stop, 0)
    mut inner_identity: i64 = find_function_identity(inner_callee_start, inner_callee_stop)
    mut read_identity: i64 = find_function_identity(read_callee_start, read_callee_stop)
    mut inner_function_id: i64 = inner_identity / 10
    mut inner_function_kind: i64 = inner_identity - inner_function_id * 10
    mut read_function_id: i64 = read_identity / 10
    mut read_function_kind: i64 = read_identity - read_function_id * 10
    mut valid: trit = -1
    mut applicable: trit = 0
    match outer_comparison_info > 0:
        -1:
            match nested_match_end > outer_negative_body_first:
                -1:
                    match parse_match_additive_relation(outer_negative_body_first, nested_match_stop) > 0:
                        -1:
                            match inner_match_info > 0:
                                -1:
                                    applicable = -1
                                0:
                                    discard 0
                                1:
                                    discard 0
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
        0:
            discard 0
        1:
            discard 0
    match applicable == -1:
        -1:
            match outer_operator_length < 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match outer_left_type > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match position_storage_id >= 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match nested_left_type == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match nested_right_type == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match nested_left_type == nested_right_type:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match expect_byte(nested_add_operator_start, nested_match_stop, 43):
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match nested_operator_length == 1:
                -1:
                    match read_byte(nested_operator_start) == 60:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
            match find_parameter_ordinal(header_start, header_end, nested_right_start, nested_right_stop) >= 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match inner_return_type == 1:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match read_return_type == 2:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match inner_parameter_type == 2:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match read_parameter_type == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match inner_identity > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match read_identity > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match is_identifier_span(read_callee_start, read_callee_stop):
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match expect_byte(read_open, inner_close, 40):
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match read_close > read_open:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match expect_byte(inner_close + 1, inner_match_header_stop, 58):
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match read_argument_stop > read_argument_start:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match same_span(read_argument_start, read_argument_stop, nested_left_start, nested_left_stop):
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match expect_byte(read_add_operator_start, read_close, 43):
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match parse_integer_literal(read_add_literal_start, read_add_literal_stop) == parse_integer_literal(nested_add_literal_start, nested_add_literal_stop):
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match skip_spaces(read_add_literal_stop, read_close + 1) == read_close:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match match_branch_label_value(first_non_space(inner_negative_label_start, inner_negative_label_stop), inner_negative_label_stop) == -1:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match match_branch_label_value(first_non_space(inner_neutral_label_start, inner_neutral_label_stop), inner_neutral_label_stop) == 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match match_branch_label_value(first_non_space(inner_positive_label_start, inner_positive_label_stop), inner_positive_label_stop) == 1:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match parse_assignment_expression_bounds(inner_assignment_first, inner_assignment_stop) > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match expect_byte(assignment_operator_start, inner_assignment_stop, 61):
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match parse_integer_literal(assignment_value_start, assignment_value_stop) == -1:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match negative_storage_id >= 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match assignment_type == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match inner_increment_stop == inner_negative_body_stop:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match parse_increment_statement(inner_increment_start, inner_increment_stop):
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match same_span(first_non_space(inner_increment_start, inner_increment_stop), word_end(first_non_space(inner_increment_start, inner_increment_stop), inner_increment_stop), nested_left_start, nested_left_stop):
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match parse_discard_zero(first_non_space(inner_neutral_body_start, inner_neutral_body_stop), inner_neutral_body_stop) > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match parse_discard_zero(first_non_space(inner_positive_body_start, inner_positive_body_stop), inner_positive_body_stop) > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match parse_discard_zero(first_non_space(outer_neutral_body_start, outer_neutral_body_stop), outer_neutral_body_stop) > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match parse_discard_zero(first_non_space(outer_positive_body_start, outer_positive_body_stop), outer_positive_body_stop) > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match valid == -1:
                -1:
                    mut logical_function_id: i64 = v3_logical_function_id(function_id)
                    mut current_block: i64 = v3_context_block_id(function_id)
                    mut outer_negative_block: i64 = current_block + 1
                    mut outer_neutral_block: i64 = current_block + 2
                    mut outer_positive_block: i64 = current_block + 3
                    mut outer_successor_block: i64 = current_block + 4
                    mut nested_block: i64 = current_block + 5
                    mut nested_negative_block: i64 = current_block + 6
                    mut nested_neutral_block: i64 = current_block + 7
                    mut nested_positive_block: i64 = current_block + 8
                    mut inner_block: i64 = current_block + 9
                    mut inner_negative_block: i64 = current_block + 10
                    mut inner_neutral_block: i64 = current_block + 11
                    mut inner_positive_block: i64 = current_block + 12
                    mut outer_context: i64 = v3_context_function_id(logical_function_id, current_block)
                    mut outer_negative_context: i64 = v3_context_function_id(logical_function_id, outer_negative_block)
                    mut outer_neutral_context: i64 = v3_context_function_id(logical_function_id, outer_neutral_block)
                    mut outer_positive_context: i64 = v3_context_function_id(logical_function_id, outer_positive_block)
                    mut nested_context: i64 = v3_context_function_id(logical_function_id, nested_block)
                    mut nested_negative_context: i64 = v3_context_function_id(logical_function_id, nested_negative_block)
                    mut nested_neutral_context: i64 = v3_context_function_id(logical_function_id, nested_neutral_block)
                    mut nested_positive_context: i64 = v3_context_function_id(logical_function_id, nested_positive_block)
                    mut inner_context: i64 = v3_context_function_id(logical_function_id, inner_block)
                    mut inner_negative_context: i64 = v3_context_function_id(logical_function_id, inner_negative_block)
                    mut inner_neutral_context: i64 = v3_context_function_id(logical_function_id, inner_neutral_block)
                    mut inner_positive_context: i64 = v3_context_function_id(logical_function_id, inner_positive_block)
                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                    mut outer_left_index_value: i64 = value_id
                    mut outer_left_load_value: i64 = value_id + 1
                    mut outer_right_value: i64 = value_id + 2
                    mut outer_compare_value: i64 = value_id + 3
                    mut nested_left_index_value: i64 = value_id + 4
                    mut nested_left_load_value: i64 = value_id + 5
                    mut nested_const_value: i64 = value_id + 6
                    mut nested_add_value: i64 = value_id + 7
                    mut nested_compare_value: i64 = value_id + 8
                    mut read_value: i64 = value_id + 9
                    mut inner_value: i64 = value_id + 10
                    mut assignment_value_id: i64 = value_id + 11
                    mut assignment_next_id: i64 = scan_statement_body(2, inner_negative_context, return_type, header_start, header_end, inner_assignment_first, inner_assignment_stop, assignment_value_id)
                    match assignment_next_id >= 0:
                        -1:
                            mut increment_next_id: i64 = scan_increment_assignment_v3(inner_negative_context, header_start, header_end, inner_increment_start, inner_increment_stop, assignment_next_id)
                            match increment_next_id >= 0:
                                -1:
                                    mut outer_entry_id: i64 = outer_context * 1000000 + ordinal
                                    mut outer_load_id: i64 = outer_context * 1000000 + ordinal + 1
                                    mut outer_const_id: i64 = outer_context * 1000000 + ordinal + 2
                                    mut outer_compare_id: i64 = outer_context * 1000000 + ordinal + 3
                                    mut outer_branch_id: i64 = outer_context * 1000000 + ordinal + 4
                                    mut outer_negative_jump_id: i64 = outer_negative_context * 1000000
                                    mut outer_neutral_jump_id: i64 = outer_neutral_context * 1000000
                                    mut outer_positive_jump_id: i64 = outer_positive_context * 1000000
                                    mut nested_left_id: i64 = nested_context * 1000000
                                    mut nested_load_id: i64 = nested_context * 1000000 + 1
                                    mut nested_const_id: i64 = nested_context * 1000000 + 2
                                    mut nested_add_id: i64 = nested_context * 1000000 + 3
                                    mut nested_compare_id: i64 = nested_context * 1000000 + 4
                                    mut nested_branch_id: i64 = nested_context * 1000000 + 5
                                    mut nested_negative_jump_id: i64 = nested_negative_context * 1000000
                                    mut nested_neutral_jump_id: i64 = nested_neutral_context * 1000000
                                    mut nested_positive_jump_id: i64 = nested_positive_context * 1000000
                                    mut inner_read_id: i64 = inner_context * 1000000
                                    mut inner_call_id: i64 = inner_context * 1000000 + 1
                                    mut inner_branch_id: i64 = inner_context * 1000000 + 2
                                    mut inner_jump_id: i64 = inner_negative_context * 1000000 + count_core_instructions_between(header_end + 1, inner_increment_start) + 6
                                    mut inner_neutral_jump_id: i64 = inner_neutral_context * 1000000
                                    mut inner_positive_jump_id: i64 = inner_positive_context * 1000000
                                    discard emit_v3_v(outer_left_index_value, outer_context, 2, 2, outer_left_start)
                                    discard emit_v3_v(outer_left_load_value, outer_context, 3, outer_left_type, outer_left_start)
                                    discard emit_v3_v(outer_right_value, outer_context, 2, outer_left_type, outer_literal_start)
                                    discard emit_v3_v(outer_compare_value, outer_context, 3, 1, outer_operator_start)
                                    discard emit_v3_i(outer_entry_id, outer_context, ordinal, 1, 1, 0, 0)
                                    discard emit_v3_r(outer_entry_id, 0, outer_left_index_value)
                                    discard emit_v3_i_aux(outer_load_id, outer_context, ordinal + 1, 15, 1, 1, find_mutable_storage_id(header_end + 1, first, outer_left_start, outer_left_stop), -1)
                                    discard emit_v3_o(outer_load_id, 0, outer_left_index_value)
                                    discard emit_v3_r(outer_load_id, 0, outer_left_load_value)
                                    discard emit_v3_i(outer_const_id, outer_context, ordinal + 2, 1, 1, 0, parse_integer_literal(outer_literal_start, number_end(outer_literal_start, stop)))
                                    discard emit_v3_r(outer_const_id, 0, outer_right_value)
                                    discard emit_v3_i(outer_compare_id, outer_context, ordinal + 3, 13, 1, 2, -1)
                                    discard emit_v3_o(outer_compare_id, 0, outer_left_load_value)
                                    discard emit_v3_o(outer_compare_id, 1, outer_right_value)
                                    discard emit_v3_r(outer_compare_id, 0, outer_compare_value)
                                    discard emit_v3_i(outer_branch_id, outer_context, ordinal + 4, 25, 0, 1, -1)
                                    discard emit_v3_o(outer_branch_id, 0, outer_compare_value)
                                    discard emit_v3_t_branch(outer_branch_id, outer_negative_block, outer_neutral_block, outer_positive_block, outer_compare_value)
                                    discard emit_v3_i(outer_negative_jump_id, outer_negative_context, 0, 24, 0, 0, -1)
                                    discard emit_v3_t_jump(outer_negative_jump_id, nested_block)
                                    discard emit_v3_i(outer_neutral_jump_id, outer_neutral_context, 0, 24, 0, 0, -1)
                                    discard emit_v3_t_jump(outer_neutral_jump_id, outer_successor_block)
                                    discard emit_v3_i(outer_positive_jump_id, outer_positive_context, 0, 24, 0, 0, -1)
                                    discard emit_v3_t_jump(outer_positive_jump_id, outer_successor_block)
                                    discard emit_v3_v(nested_left_index_value, nested_context, 2, 2, nested_left_start)
                                    discard emit_v3_v(nested_left_load_value, nested_context, 3, nested_left_type, nested_left_start)
                                    discard emit_v3_v(nested_const_value, nested_context, 2, 2, nested_add_literal_start)
                                    discard emit_v3_v(nested_add_value, nested_context, 3, 2, nested_add_operator_start)
                                    discard emit_v3_v(nested_compare_value, nested_context, 3, 1, nested_operator_start)
                                    discard emit_v3_i(nested_left_id, nested_context, 0, 1, 1, 0, 0)
                                    discard emit_v3_r(nested_left_id, 0, nested_left_index_value)
                                    discard emit_v3_i_aux(nested_load_id, nested_context, 1, 15, 1, 1, position_storage_id, -1)
                                    discard emit_v3_o(nested_load_id, 0, nested_left_index_value)
                                    discard emit_v3_r(nested_load_id, 0, nested_left_load_value)
                                    discard emit_v3_i(nested_const_id, nested_context, 2, 1, 1, 0, parse_integer_literal(nested_add_literal_start, nested_add_literal_stop))
                                    discard emit_v3_r(nested_const_id, 0, nested_const_value)
                                    discard emit_v3_i(nested_add_id, nested_context, 3, 5, 1, 2, -1)
                                    discard emit_v3_o(nested_add_id, 0, nested_left_load_value)
                                    discard emit_v3_o(nested_add_id, 1, nested_const_value)
                                    discard emit_v3_r(nested_add_id, 0, nested_add_value)
                                    discard emit_v3_i(nested_compare_id, nested_context, 4, 13, 1, 2, -1)
                                    discard emit_v3_o(nested_compare_id, 0, nested_add_value)
                                    discard emit_v3_o(nested_compare_id, 1, value_id - count_header_parameters(header_start, header_end) + find_parameter_ordinal(header_start, header_end, nested_right_start, nested_right_stop))
                                    discard emit_v3_r(nested_compare_id, 0, nested_compare_value)
                                    discard emit_v3_i(nested_branch_id, nested_context, 5, 25, 0, 1, -1)
                                    discard emit_v3_o(nested_branch_id, 0, nested_compare_value)
                                    discard emit_v3_t_branch(nested_branch_id, nested_negative_block, nested_neutral_block, nested_positive_block, nested_compare_value)
                                    discard emit_v3_i(nested_negative_jump_id, nested_negative_context, 0, 24, 0, 0, -1)
                                    discard emit_v3_t_jump(nested_negative_jump_id, inner_block)
                                    discard emit_v3_i(nested_neutral_jump_id, nested_neutral_context, 0, 24, 0, 0, -1)
                                    discard emit_v3_t_jump(nested_neutral_jump_id, outer_successor_block)
                                    discard emit_v3_i(nested_positive_jump_id, nested_positive_context, 0, 24, 0, 0, -1)
                                    discard emit_v3_t_jump(nested_positive_jump_id, outer_successor_block)
                                    discard emit_v3_v(read_value, inner_context, 4, read_return_type, read_callee_start)
                                    discard emit_v3_v(inner_value, inner_context, 4, inner_return_type, inner_callee_start)
                                    discard emit_v3_i(inner_read_id, inner_context, 0, 14, 1, 1, -1)
                                    discard emit_v3_c(inner_read_id, read_function_id, read_function_kind, read_callee_start, read_callee_stop - read_callee_start)
                                    discard emit_v3_a(inner_read_id, 0, nested_add_value)
                                    discard emit_v3_o(inner_read_id, 0, nested_add_value)
                                    discard emit_v3_r(inner_read_id, 0, read_value)
                                    discard emit_v3_i(inner_call_id, inner_context, 1, 14, 1, 1, -1)
                                    discard emit_v3_c(inner_call_id, inner_function_id, inner_function_kind, inner_callee_start, inner_callee_stop - inner_callee_start)
                                    discard emit_v3_a(inner_call_id, 0, read_value)
                                    discard emit_v3_o(inner_call_id, 0, read_value)
                                    discard emit_v3_r(inner_call_id, 0, inner_value)
                                    discard emit_v3_i(inner_branch_id, inner_context, 2, 25, 0, 1, -1)
                                    discard emit_v3_o(inner_branch_id, 0, inner_value)
                                    discard emit_v3_t_branch(inner_branch_id, inner_negative_block, inner_neutral_block, inner_positive_block, inner_value)
                                    discard emit_v3_i(inner_jump_id, inner_negative_context, count_core_instructions_between(header_end + 1, inner_increment_start) + 6, 24, 0, 0, -1)
                                    discard emit_v3_t_jump(inner_jump_id, outer_successor_block)
                                    discard emit_v3_i(inner_neutral_jump_id, inner_neutral_context, 0, 24, 0, 0, -1)
                                    discard emit_v3_t_jump(inner_neutral_jump_id, outer_successor_block)
                                    discard emit_v3_i(inner_positive_jump_id, inner_positive_context, 0, 24, 0, 0, -1)
                                    discard emit_v3_t_jump(inner_positive_jump_id, outer_successor_block)
                                    discard emit_v3_b_block(logical_function_id, current_block, current_block, 5, v3_context_instruction_id(outer_branch_id))
                                    discard emit_v3_b_block(logical_function_id, outer_negative_block, outer_negative_block, 1, v3_context_instruction_id(outer_negative_jump_id))
                                    discard emit_v3_b_block(logical_function_id, outer_neutral_block, outer_neutral_block, 1, v3_context_instruction_id(outer_neutral_jump_id))
                                    discard emit_v3_b_block(logical_function_id, outer_positive_block, outer_positive_block, 1, v3_context_instruction_id(outer_positive_jump_id))
                                    discard emit_v3_b_block(logical_function_id, nested_block, nested_block, 6, v3_context_instruction_id(nested_branch_id))
                                    discard emit_v3_b_block(logical_function_id, nested_negative_block, nested_negative_block, 1, v3_context_instruction_id(nested_negative_jump_id))
                                    discard emit_v3_b_block(logical_function_id, nested_neutral_block, nested_neutral_block, 1, v3_context_instruction_id(nested_neutral_jump_id))
                                    discard emit_v3_b_block(logical_function_id, nested_positive_block, nested_positive_block, 1, v3_context_instruction_id(nested_positive_jump_id))
                                    discard emit_v3_b_block(logical_function_id, inner_block, inner_block, 3, v3_context_instruction_id(inner_branch_id))
                                    discard emit_v3_b_block(logical_function_id, inner_negative_block, inner_negative_block, 10, v3_context_instruction_id(inner_jump_id))
                                    discard emit_v3_b_block(logical_function_id, inner_neutral_block, inner_neutral_block, 1, v3_context_instruction_id(inner_neutral_jump_id))
                                    discard emit_v3_b_block(logical_function_id, inner_positive_block, inner_positive_block, 1, v3_context_instruction_id(inner_positive_jump_id))
                                    mut encoded_next_id: i64 = 3000000000000 + outer_successor_block * 100000000000
                                    encoded_next_id = encoded_next_id + increment_next_id * 1000000 + outer_after_start
                                    return encoded_next_id
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return 0
        1:
            return 0

# Lower a call comparison whose negative arm returns while the other arms
# continue at the lexical successor.  This route is intentionally driven by
# the shared call-relation parser; unsupported call shapes remain fail-closed.
fn scan_match_call_relation_terminal_return_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64, current_block_start: i64) -> i64:
    mut relation_info: i64 = parse_match_nested_call_relation(first, stop)
    match relation_info > 0:
        -1:
            mut length: i64 = s3_stage1_source_length()
            mut callee_start: i64 = relation_info / 1000000
            mut callee_stop: i64 = relation_info - callee_start * 1000000
            mut call_open: i64 = skip_spaces(callee_stop, stop)
            mut call_close: i64 = matching_close(call_open, stop)
            mut argument_start: i64 = first_non_space(call_open + 1, call_close)
            mut argument_stop: i64 = word_end(argument_start, call_close)
            mut argument_after: i64 = skip_spaces(argument_stop, call_close)
            mut additive_mode: trit = 0
            mut additive_operator_start: i64 = 0
            mut argument_left_start: i64 = argument_start
            mut argument_left_stop: i64 = argument_stop
            mut argument_literal_start: i64 = 0
            mut argument_literal_stop: i64 = 0
            match argument_after == call_close:
                -1:
                    discard 0
                0:
                    match expect_byte(argument_after, call_close, 43):
                        -1:
                            additive_mode = -1
                            additive_operator_start = argument_after
                            argument_literal_start = first_non_space(argument_after + 1, call_close)
                            mut argument_literal_cursor: i64 = argument_literal_start
                            match read_byte(argument_literal_cursor) == 45:
                                -1:
                                    argument_literal_cursor += 1
                                0:
                                    discard 0
                                1:
                                    discard 0
                            argument_literal_stop = number_end(argument_literal_cursor, call_close)
                        0:
                            return -1
                        1:
                            return -1
                1:
                    match expect_byte(argument_after, call_close, 43):
                        -1:
                            additive_mode = -1
                            additive_operator_start = argument_after
                            argument_literal_start = first_non_space(argument_after + 1, call_close)
                            mut argument_literal_cursor: i64 = argument_literal_start
                            match read_byte(argument_literal_cursor) == 45:
                                -1:
                                    argument_literal_cursor += 1
                                0:
                                    discard 0
                                1:
                                    discard 0
                            argument_literal_stop = number_end(argument_literal_cursor, call_close)
                        0:
                            return -1
                        1:
                            return -1
            mut operator_start: i64 = skip_spaces(call_close + 1, stop)
            mut operator_length: i64 = comparison_operator_length(operator_start, stop)
            mut right_start: i64 = skip_spaces(operator_start + operator_length, stop)
            mut right_cursor: i64 = right_start
            match read_byte(right_cursor) == 45:
                -1:
                    right_cursor += 1
                0:
                    discard 0
                1:
                    discard 0
            mut right_stop: i64 = number_end(right_cursor, stop)
            mut after_right: i64 = skip_spaces(right_stop, stop)
            mut signature: i64 = find_function_signature(callee_start, callee_stop)
            mut call_return_type: i64 = parse_call_return_type(callee_start, header_start, header_end)
            mut parameter_type: i64 = find_function_parameter_type_by_ordinal(callee_start, callee_stop, 0)
            mut argument_type: i64 = find_call_argument_type(callee_start, header_start, header_end)
            mut argument_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, argument_left_start, argument_left_stop)
            mut argument_parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, argument_left_start, argument_left_stop)
            mut argument_local_value_id: i64 = find_core_local_value_id(header_end + 1, first, argument_left_start, argument_left_stop)
            mut branch_cursor: i64 = line_end(source_line_start(first), length) + 1
            mut negative_label_stop: i64 = line_end(branch_cursor, length)
            mut negative_body_start: i64 = negative_label_stop + 1
            mut negative_body_stop: i64 = match_arm_body_stop(negative_body_start, length)
            mut neutral_label_start: i64 = negative_body_stop + 1
            mut neutral_label_stop: i64 = line_end(neutral_label_start, length)
            mut neutral_body_start: i64 = neutral_label_stop + 1
            mut neutral_body_stop: i64 = match_arm_body_stop(neutral_body_start, length)
            mut positive_label_start: i64 = neutral_body_stop + 1
            mut positive_label_stop: i64 = line_end(positive_label_start, length)
            mut positive_body_start: i64 = positive_label_stop + 1
            mut positive_body_stop: i64 = match_arm_body_stop(positive_body_start, length)
            mut negative_body_first: i64 = match_arm_body_start(first, 0, length)
            mut neutral_body_first: i64 = match_arm_body_start(first, 1, length)
            mut positive_body_first: i64 = match_arm_body_start(first, 2, length)
            mut negative_kind: i64 = match_arm_effect(negative_body_first, negative_body_stop)
            mut negative_header_stop: i64 = line_end(source_line_start(negative_body_first), length)
            mut negative_descriptor: i64 = match_condition_descriptor(negative_body_first, negative_header_stop)
            mut negative_condition_kind: i64 = match_condition_kind(negative_descriptor)
            mut valid: trit = -1
            match call_close > call_open:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match operator_length > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match read_byte(after_right) == 58:
                -1:
                    match skip_spaces(after_right + 1, stop) == stop:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
            match signature > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match call_return_type > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match parameter_type > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match call_argument_type_matches(argument_type, parameter_type):
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match parse_integer_literal(right_cursor, right_stop) >= 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match additive_mode == -1:
                -1:
                    match argument_literal_stop > argument_literal_start:
                        -1:
                            match argument_type == 3:
                                -1:
                                    discard 0
                                0:
                                    valid = 0
                                1:
                                    valid = 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    discard 0
                1:
                    discard 0
            match argument_storage_id >= 0:
                -1:
                    discard 0
                0:
                    match argument_parameter_ordinal >= 0:
                        -1:
                            discard 0
                        0:
                            match argument_local_value_id >= 0:
                                -1:
                                    discard 0
                                0:
                                    valid = 0
                                1:
                                    valid = 0
                        1:
                            discard 0
                1:
                    discard 0
            match match_branch_label_value(first_non_space(branch_cursor, negative_label_stop), negative_label_stop) == -1:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match match_branch_label_value(first_non_space(neutral_label_start, neutral_label_stop), neutral_label_stop) == 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match match_branch_label_value(first_non_space(positive_label_start, positive_label_stop), positive_label_stop) == 1:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match negative_kind == 1:
                -1:
                    match is_return_line(negative_body_first, negative_body_stop) == -1:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    match negative_kind == 3:
                        -1:
                            match negative_condition_kind > 0:
                                -1:
                                    discard 0
                                0:
                                    valid = 0
                                1:
                                    valid = 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                1:
                    valid = 0
            match parse_discard_zero(neutral_body_first, neutral_body_stop) > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match parse_discard_zero(positive_body_first, positive_body_stop) > 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match valid == -1:
                -1:
                    mut logical_function_id: i64 = v3_logical_function_id(function_id)
                    mut current_block: i64 = v3_context_block_id(function_id)
                    mut context_function_id: i64 = v3_context_function_id(logical_function_id, current_block)
                    mut negative_block: i64 = current_block + 1
                    mut neutral_block: i64 = current_block + 2
                    mut positive_block: i64 = current_block + 3
                    mut successor_block: i64 = current_block + 4
                    mut negative_context: i64 = v3_context_function_id(logical_function_id, negative_block)
                    mut neutral_context: i64 = v3_context_function_id(logical_function_id, neutral_block)
                    mut positive_context: i64 = v3_context_function_id(logical_function_id, positive_block)
                    mut ordinal: i64 = count_core_instructions_between(current_block_start, first)
                    mut base_id: i64 = context_function_id * 1000000 + ordinal
                    mut instruction_offset: i64 = 0
                    mut condition_count: i64 = 4
                    mut argument_value_id: i64 = value_id
                    mut next_value_id: i64 = value_id
                    mut argument_index_id: i64 = base_id
                    mut argument_load_id: i64 = base_id
                    mut argument_literal_id: i64 = base_id
                    mut argument_add_id: i64 = base_id
                    mut call_id: i64 = base_id
                    mut rhs_id: i64 = base_id
                    mut compare_id: i64 = base_id
                    mut branch_id: i64 = base_id
                    match argument_storage_id >= 0:
                        -1:
                            condition_count += 2
                            argument_value_id = value_id + 1
                            next_value_id = value_id + 2
                            argument_index_id = base_id
                            argument_load_id = base_id + 1
                            instruction_offset = 2
                            discard emit_v3_v(value_id, function_id, 2, 2, argument_left_start)
                            discard emit_v3_v(argument_value_id, function_id, 3, argument_type, argument_left_start)
                            discard emit_v3_i_block(argument_index_id, context_function_id, current_block, ordinal, 1, 1, 0, -1, 0)
                            discard emit_v3_r(argument_index_id, 0, value_id)
                            discard emit_v3_i_block(argument_load_id, context_function_id, current_block, ordinal + 1, 15, 1, 1, argument_storage_id, -1)
                            discard emit_v3_o(argument_load_id, 0, value_id)
                            discard emit_v3_r(argument_load_id, 0, argument_value_id)
                        0:
                            match argument_parameter_ordinal >= 0:
                                -1:
                                    argument_value_id = argument_parameter_ordinal
                                0:
                                    argument_value_id = argument_local_value_id
                                1:
                                    argument_value_id = argument_local_value_id
                        1:
                            argument_value_id = argument_local_value_id
                    match additive_mode == -1:
                        -1:
                            condition_count += 2
                            argument_literal_id = base_id + instruction_offset
                            argument_add_id = argument_literal_id + 1
                            discard emit_v3_v(next_value_id, function_id, 2, 3, argument_literal_start)
                            discard emit_v3_v(next_value_id + 1, function_id, 3, 3, additive_operator_start)
                            discard emit_v3_i_block(argument_literal_id, context_function_id, current_block, ordinal + instruction_offset, 1, 1, 0, -1, parse_integer_literal(argument_literal_start, argument_literal_stop))
                            discard emit_v3_r(argument_literal_id, 0, next_value_id)
                            discard emit_v3_i_block(argument_add_id, context_function_id, current_block, ordinal + instruction_offset + 1, 5, 1, 2, -1, -1)
                            discard emit_v3_o(argument_add_id, 0, argument_value_id)
                            discard emit_v3_o(argument_add_id, 1, next_value_id)
                            discard emit_v3_r(argument_add_id, 0, next_value_id + 1)
                            argument_value_id = next_value_id + 1
                            next_value_id += 2
                            instruction_offset += 2
                        0:
                            discard 0
                        1:
                            discard 0
                    mut call_value_id: i64 = next_value_id
                    mut right_value_id: i64 = call_value_id + 1
                    mut compare_value_id: i64 = call_value_id + 2
                    call_id = base_id + instruction_offset
                    rhs_id = call_id + 1
                    compare_id = call_id + 2
                    branch_id = call_id + 3
                    mut call_identity: i64 = find_function_identity(callee_start, callee_stop)
                    match call_identity > 0:
                        -1:
                            mut callee_function_id: i64 = call_identity / 10
                            mut callee_kind: i64 = call_identity - callee_function_id * 10
                            discard emit_v3_v(call_value_id, function_id, 4, call_return_type, callee_start)
                            discard emit_v3_i_block(call_id, context_function_id, current_block, ordinal + instruction_offset, 14, 1, 1, -1, -1)
                            discard emit_v3_c(call_id, callee_function_id, callee_kind, callee_start, callee_stop - callee_start)
                            discard emit_v3_a(call_id, 0, argument_value_id)
                            discard emit_v3_o(call_id, 0, argument_value_id)
                            discard emit_v3_r(call_id, 0, call_value_id)
                            discard emit_v3_v(right_value_id, function_id, 2, call_return_type, right_cursor)
                            discard emit_v3_i_block(rhs_id, context_function_id, current_block, ordinal + instruction_offset + 1, 1, 1, 0, -1, parse_integer_literal(right_cursor, right_stop))
                            discard emit_v3_r(rhs_id, 0, right_value_id)
                            discard emit_v3_v(compare_value_id, function_id, 3, 1, operator_start)
                            discard emit_v3_i_block(compare_id, context_function_id, current_block, ordinal + instruction_offset + 2, 13, 1, 2, -1, -1)
                            discard emit_v3_o(compare_id, 0, call_value_id)
                            discard emit_v3_o(compare_id, 1, right_value_id)
                            discard emit_v3_r(compare_id, 0, compare_value_id)
                            discard emit_v3_i_block(branch_id, context_function_id, current_block, ordinal + instruction_offset + 3, 25, 0, 1, -1, -1)
                            discard emit_v3_o(branch_id, 0, compare_value_id)
                            discard emit_v3_t_branch(branch_id, negative_block, neutral_block, positive_block, compare_value_id)
                            mut negative_next_id: i64 = next_value_id + 3
                            mut negative_result_id: i64 = -1
                            mut negative_is_nested: trit = 0
                            mut nested_result_id: i64 = -1
                            match negative_kind == 3:
                                -1:
                                    negative_is_nested = -1
                                    mut nested_context: i64 = v3_context_function_id(logical_function_id, current_block + 5)
                                    nested_result_id = scan_match_line_context(2, nested_context, return_type, header_start, header_end, negative_body_first, negative_header_stop, negative_next_id, current_block + 5, negative_body_first)
                                    match lowering_result_kind(nested_result_id) == 3:
                                        -1:
