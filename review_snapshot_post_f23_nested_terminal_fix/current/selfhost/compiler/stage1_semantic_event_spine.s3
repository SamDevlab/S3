fn scan_discard_call_v3(function_id: i64, header_start: i64, header_end: i64, first: i64, expression_start: i64, stop: i64, value_id: i64) -> i64:
    mut call_info: i64 = parse_call_one_argument(expression_start, stop)
    match call_info > 0:
        -1:
            mut callee_start: i64 = call_info / 1000000
            mut callee_stop: i64 = call_info - callee_start * 1000000
            mut signature: i64 = find_function_signature(callee_start, callee_stop)
            match signature > 0:
                -1:
                    mut call_return_type: i64 = signature / 100
                    mut parameter_type: i64 = find_function_parameter_type_by_ordinal(callee_start, callee_stop, 0)
                    mut argument_span: i64 = parse_call_argument_span(expression_start, stop, 0)
                    mut parameter_count: i64 = count_header_parameters(header_start, header_end)
                    mut parameter_base: i64 = value_id - parameter_count
                    mut argument_value: i64 = resolve_call_argument_value_id(header_start, header_end, first, argument_span, parameter_type, parameter_base, value_id)
                    match argument_value >= 0:
                        -1:
                            mut argument_start: i64 = argument_span / 1000000
                            mut argument_stop: i64 = argument_span - argument_start * 1000000
                            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                            mut literal_ordinal: i64 = ordinal
                            mut next_id: i64 = value_id
                            match call_argument_is_literal(argument_span):
                                -1:
                                    discard emit_v3_v(argument_value, function_id, 2, parameter_type, argument_start)
                                    discard emit_v3_i(function_id * 1000000 + literal_ordinal, function_id, literal_ordinal, 1, 1, 0, parse_integer_literal(argument_start, argument_stop))
                                    discard emit_v3_r(function_id * 1000000 + literal_ordinal, 0, argument_value)
                                    literal_ordinal += 1
                                    next_id += 1
                                0:
                                    discard 0
                                1:
                                    discard 0
                            mut callee_identity: i64 = find_function_identity(callee_start, callee_stop)
                            match callee_identity > 0:
                                -1:
                                    mut callee_function_id: i64 = callee_identity / 10
                                    mut callee_kind: i64 = callee_identity - callee_function_id * 10
                                    mut call_id: i64 = function_id * 1000000 + literal_ordinal
                                    discard emit_v3_v(next_id, function_id, 4, call_return_type, callee_start)
                                    discard emit_v3_i(call_id, function_id, literal_ordinal, 14, 1, 1, -1)
                                    discard emit_v3_c(call_id, callee_function_id, callee_kind, callee_start, callee_stop - callee_start)
                                    discard emit_v3_a(call_id, 0, argument_value)
                                    discard emit_v3_o(call_id, 0, argument_value)
                                    discard emit_v3_r(call_id, 0, next_id)
                                    return next_id + 1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_discard_nested_additive_call_v3(function_id: i64, header_start: i64, header_end: i64, first: i64, stop: i64, packed: i64, value_id: i64) -> i64:
    mut outer_start: i64 = packed / 1000000000000
    mut remainder: i64 = packed - outer_start * 1000000000000
    mut inner_start: i64 = remainder / 1000000
    mut argument_start: i64 = remainder - inner_start * 1000000
    mut outer_stop: i64 = word_end(outer_start, stop)
    mut outer_open: i64 = skip_spaces(outer_stop, stop)
    mut outer_close: i64 = matching_close(outer_open, stop)
    mut inner_stop: i64 = word_end(inner_start, outer_close)
    mut inner_open: i64 = skip_spaces(inner_stop, outer_close)
    mut inner_close: i64 = matching_close(inner_open, outer_close)
    mut additive_info: i64 = find_additive_operator(argument_start, inner_close)
    mut additive_operator: i64 = additive_info / 10
    mut additive_kind: i64 = additive_info - additive_operator * 10
    mut left_end: i64 = trim_expression_end(argument_start, additive_operator)
    mut left_start: i64 = first_non_space(argument_start, left_end)
    mut left_stop: i64 = word_end(left_start, left_end)
    mut right_start: i64 = skip_spaces(additive_operator + 1, inner_close)
    mut right_cursor: i64 = right_start
    match read_byte(right_cursor) == 45:
        -1:
            right_cursor += 1
        0:
            discard 0
        1:
            discard 0
    mut right_stop: i64 = number_end(right_cursor, inner_close)
    mut outer_signature: i64 = find_function_signature(outer_start, outer_stop)
    mut inner_signature: i64 = builtin_call_signature(inner_start, inner_stop)
    mut outer_result_type: i64 = outer_signature / 100
    mut outer_parameter_type: i64 = outer_signature - outer_result_type * 100
    mut inner_result_type: i64 = inner_signature / 100
    mut inner_parameter_type: i64 = inner_signature - inner_result_type * 100
    mut left_type: i64 = resolve_value_type(header_start, header_end, first, left_start, left_stop)
    mut left_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
    mut outer_identity: i64 = find_function_identity(outer_start, outer_stop)
    mut valid: trit = -1
    match additive_info > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match outer_signature > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match inner_signature == 203:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match word_is(inner_start, inner_stop, 3292806559400, 8):
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match outer_parameter_type == inner_result_type:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_type == inner_parameter_type:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_type == 3:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_storage_id >= 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match outer_identity > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match valid == -1:
        -1:
            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
            mut base_id: i64 = function_id * 1000000 + ordinal
            mut index_id: i64 = base_id
            mut load_id: i64 = base_id + 1
            mut const_id: i64 = base_id + 2
            mut add_id: i64 = base_id + 3
            mut convert_id: i64 = base_id + 4
            mut call_id: i64 = base_id + 5
            mut index_value: i64 = value_id
            mut load_value: i64 = value_id + 1
            mut literal_value: i64 = value_id + 2
            mut add_value: i64 = value_id + 3
            mut convert_value: i64 = value_id + 4
            mut call_value: i64 = value_id + 5
            mut outer_function_id: i64 = outer_identity / 10
            mut outer_kind: i64 = outer_identity - outer_function_id * 10
            discard emit_v3_v(index_value, function_id, 2, 2, left_start)
            discard emit_v3_v(load_value, function_id, 3, left_type, left_start)
            discard emit_v3_v(literal_value, function_id, 2, inner_parameter_type, right_start)
            discard emit_v3_v(add_value, function_id, 3, inner_parameter_type, additive_operator)
            discard emit_v3_v(convert_value, function_id, 4, inner_result_type, inner_start)
            discard emit_v3_v(call_value, function_id, 4, outer_result_type, outer_start)
            discard emit_v3_i(index_id, function_id, ordinal, 1, 1, 0, 0)
            discard emit_v3_r(index_id, 0, index_value)
            discard emit_v3_i_aux(load_id, function_id, ordinal + 1, 15, 1, 1, left_storage_id, -1)
            discard emit_v3_o(load_id, 0, index_value)
            discard emit_v3_r(load_id, 0, load_value)
            discard emit_v3_i(const_id, function_id, ordinal + 2, 1, 1, 0, parse_integer_literal(right_start, right_stop))
            discard emit_v3_r(const_id, 0, literal_value)
            match additive_kind == 1:
                -1:
                    discard emit_v3_i(add_id, function_id, ordinal + 3, 5, 1, 2, -1)
                0:
                    discard emit_v3_i(add_id, function_id, ordinal + 3, 6, 1, 2, -1)
                1:
                    discard emit_v3_i(add_id, function_id, ordinal + 3, 5, 1, 2, -1)
            discard emit_v3_o(add_id, 0, load_value)
            discard emit_v3_o(add_id, 1, literal_value)
            discard emit_v3_r(add_id, 0, add_value)
            discard emit_v3_i(convert_id, function_id, ordinal + 4, 10, 1, 1, -1)
            discard emit_v3_o(convert_id, 0, add_value)
            discard emit_v3_r(convert_id, 0, convert_value)
            discard emit_v3_i(call_id, function_id, ordinal + 5, 14, 1, 1, -1)
            discard emit_v3_c(call_id, outer_function_id, outer_kind, outer_start, outer_stop - outer_start)
            discard emit_v3_a(call_id, 0, convert_value)
            discard emit_v3_o(call_id, 0, convert_value)
            discard emit_v3_r(call_id, 0, call_value)
            return value_id + 6
        0:
            return -1
        1:
            return -1

