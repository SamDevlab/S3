    mut nested_match_start: i64 = outer_negative_body_first
    mut nested_match_stop: i64 = outer_negative_body_stop
    mut nested_match_word_stop: i64 = word_end(nested_match_start, nested_match_stop)
    mut nested_comparison_info: i64 = parse_match_comparison(nested_match_start, nested_match_stop)
    mut nested_additive_info: i64 = parse_match_additive_relation(nested_match_start, nested_match_stop)
    mut nested_call_relation_info: i64 = parse_match_nested_call_relation(nested_match_start, nested_match_stop)
    mut nested_shape: trit = 0
    match word_is(nested_match_start, nested_match_word_stop, 103668165, 5):
        -1:
            match nested_comparison_info > 0:
                -1:
                    nested_shape = -1
                0:
                    match nested_additive_info > 0:
                        -1:
                            nested_shape = -1
                        0:
