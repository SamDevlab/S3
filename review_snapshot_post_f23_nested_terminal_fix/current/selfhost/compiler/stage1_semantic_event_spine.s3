                                                    mut condition_index_id: i64 = base_id
                                                    mut condition_load_id: i64 = base_id
                                                    mut condition_const_id: i64 = base_id
                                                    mut compare_id: i64 = base_id + 1
                                                    mut branch_id: i64 = base_id + 2
                                                    mut negative_const_id: i64 = base_id + 3
                                                    mut negative_value_id: i64 = base_id + 4
                                                    mut negative_store_id: i64 = base_id + 5
                                                    mut negative_jump_id: i64 = base_id + 6
                                                    mut neutral_const_id: i64 = base_id + 7
                                                    mut neutral_value_id: i64 = base_id + 8
                                                    mut neutral_store_id: i64 = base_id + 9
                                                    mut neutral_jump_id: i64 = base_id + 10
                                                    mut positive_const_id: i64 = base_id + 11
                                                    mut positive_value_id: i64 = base_id + 12
                                                    mut positive_store_id: i64 = base_id + 13
                                                    mut positive_jump_id: i64 = base_id + 14
                                                    mut continuation_const_id: i64 = base_id + 15
                                                    mut continuation_load_id: i64 = base_id + 16
                                                    mut continuation_branch_id: i64 = base_id + 17
                                                    mut negative_switch_const_id: i64 = base_id + 18
                                                    mut negative_switch_return_id: i64 = base_id + 19
                                                    mut neutral_switch_const_id: i64 = base_id + 20
                                                    mut neutral_switch_return_id: i64 = base_id + 21
                                                    mut positive_switch_const_id: i64 = base_id + 22
                                                    mut positive_switch_return_id: i64 = base_id + 23
                                                    mut condition_right_value: i64 = value_id
                                                    mut compare_value: i64 = value_id + 1
                                                    mut relation_value_base: i64 = value_id + 2
                                                    mut condition_left_index_value: i64 = -1
                                                    mut condition_left_load_value: i64 = left_parameter_value_id
                                                    match left_storage_id >= 0:
                                                        -1:
                                                            has_storage = -1
                                                            condition_instruction_count = 5
                                                            condition_index_id = base_id
                                                            condition_load_id = base_id + 1
                                                            condition_const_id = base_id + 2
                                                            compare_id = base_id + 3
                                                            branch_id = base_id + 4
                                                            negative_const_id = base_id + 5
                                                            negative_value_id = base_id + 6
                                                            negative_store_id = base_id + 7
                                                            negative_jump_id = base_id + 8
                                                            neutral_const_id = base_id + 9
                                                            neutral_value_id = base_id + 10
                                                            neutral_store_id = base_id + 11
                                                            neutral_jump_id = base_id + 12
                                                            positive_const_id = base_id + 13
                                                            positive_value_id = base_id + 14
                                                            positive_store_id = base_id + 15
                                                            positive_jump_id = base_id + 16
                                                            continuation_const_id = base_id + 17
                                                            continuation_load_id = base_id + 18
                                                            continuation_branch_id = base_id + 19
                                                            negative_switch_const_id = base_id + 20
                                                            negative_switch_return_id = base_id + 21
                                                            neutral_switch_const_id = base_id + 22
                                                            neutral_switch_return_id = base_id + 23
                                                            positive_switch_const_id = base_id + 24
                                                            positive_switch_return_id = base_id + 25
                                                            condition_left_index_value = value_id
                                                            condition_left_load_value = value_id + 1
                                                            condition_right_value = value_id + 2
                                                            compare_value = value_id + 3
                                                            relation_value_base = value_id + 4
                                                        0:
                                                            discard 0
                                                        1:
                                                            discard 0
                                                    mut negative_index_value: i64 = relation_value_base
                                                    mut negative_result_value: i64 = relation_value_base + 1
                                                    mut neutral_index_value: i64 = relation_value_base + 2
                                                    mut neutral_result_value: i64 = relation_value_base + 3
                                                    mut positive_index_value: i64 = relation_value_base + 4
                                                    mut positive_result_value: i64 = relation_value_base + 5
                                                    mut continuation_index_value: i64 = relation_value_base + 6
                                                    mut continuation_load_value: i64 = relation_value_base + 7
                                                    mut negative_switch_value: i64 = relation_value_base + 8
                                                    mut neutral_switch_value: i64 = relation_value_base + 9
                                                    mut positive_switch_value: i64 = relation_value_base + 10
                                                    mut temporary_storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
                                                    mut negative_start: i64 = negative_return_info / 1000000
                                                    mut negative_stop: i64 = negative_return_info - negative_start * 1000000
                                                    mut neutral_start: i64 = neutral_return_info / 1000000
                                                    mut neutral_stop: i64 = neutral_return_info - neutral_start * 1000000
                                                    mut positive_start: i64 = positive_return_info / 1000000
                                                    mut positive_stop: i64 = positive_return_info - positive_start * 1000000
                                                    discard emit_v3_m(function_id, temporary_storage_id, 1, 1, 1, operator_start)
                                                    match has_storage == -1:
                                                        -1:
                                                            discard emit_v3_v(condition_left_index_value, function_id, 2, 2, left_start)
                                                            discard emit_v3_v(condition_left_load_value, function_id, 3, left_type, left_start)
                                                        0:
                                                            discard 0
                                                        1:
                                                            discard 0
                                                    discard emit_v3_v(condition_right_value, function_id, 2, left_type, literal_start)
                                                    discard emit_v3_v(compare_value, function_id, 3, 1, operator_start)
                                                    discard emit_v3_v(negative_index_value, function_id, 2, 2, operator_start)
                                                    discard emit_v3_v(negative_result_value, function_id, 2, 1, operator_start)
                                                    discard emit_v3_v(neutral_index_value, function_id, 2, 2, operator_start)
                                                    discard emit_v3_v(neutral_result_value, function_id, 2, 1, operator_start)
                                                    discard emit_v3_v(positive_index_value, function_id, 2, 2, operator_start)
                                                    discard emit_v3_v(positive_result_value, function_id, 2, 1, operator_start)
                                                    discard emit_v3_v(continuation_index_value, function_id, 2, 2, operator_start)
                                                    discard emit_v3_v(continuation_load_value, function_id, 3, 1, operator_start)
                                                    discard emit_v3_v(negative_switch_value, function_id, 2, return_type, negative_start)
                                                    discard emit_v3_v(neutral_switch_value, function_id, 2, return_type, neutral_start)
                                                    discard emit_v3_v(positive_switch_value, function_id, 2, return_type, positive_start)
                                                    match has_storage == -1:
                                                        -1:
                                                            discard emit_v3_i_block(condition_index_id, function_id, 0, ordinal, 1, 1, 0, -1, 0)
                                                            discard emit_v3_r(condition_index_id, 0, condition_left_index_value)
                                                            discard emit_v3_i_block(condition_load_id, function_id, 0, ordinal + 1, 15, 1, 1, left_storage_id, -1)
                                                            discard emit_v3_o(condition_load_id, 0, condition_left_index_value)
                                                            discard emit_v3_r(condition_load_id, 0, condition_left_load_value)
                                                            discard emit_v3_i_block(condition_const_id, function_id, 0, ordinal + 2, 1, 1, 0, -1, parse_integer_literal(literal_start, right_stop))
                                                            discard emit_v3_r(condition_const_id, 0, condition_right_value)
                                                            discard emit_v3_i_block(compare_id, function_id, 0, ordinal + 3, 13, 1, 2, -1, -1)
                                                            discard emit_v3_o(compare_id, 0, condition_left_load_value)
                                                            discard emit_v3_o(compare_id, 1, condition_right_value)
                                                            discard emit_v3_r(compare_id, 0, compare_value)
                                                            discard emit_v3_i_block(branch_id, function_id, 0, ordinal + 4, 25, 0, 1, -1, -1)
                                                        0:
                                                            discard emit_v3_i_block(condition_const_id, function_id, 0, ordinal, 1, 1, 0, -1, parse_integer_literal(literal_start, right_stop))
                                                            discard emit_v3_r(condition_const_id, 0, condition_right_value)
                                                            discard emit_v3_i_block(compare_id, function_id, 0, ordinal + 1, 13, 1, 2, -1, -1)
                                                            discard emit_v3_o(compare_id, 0, left_parameter_value_id)
                                                            discard emit_v3_o(compare_id, 1, condition_right_value)
                                                            discard emit_v3_r(compare_id, 0, compare_value)
                                                            discard emit_v3_i_block(branch_id, function_id, 0, ordinal + 2, 25, 0, 1, -1, -1)
                                                        1:
                                                            discard 0
                                                    discard emit_v3_o(branch_id, 0, compare_value)
                                                    discard emit_v3_t_branch(branch_id, 1, 2, 3, compare_value)
                                                    discard emit_v3_i_block(negative_const_id, function_id, 1, 0, 1, 1, 0, -1, 0)
                                                    discard emit_v3_r(negative_const_id, 0, negative_index_value)
                                                    discard emit_v3_i_block(negative_value_id, function_id, 1, 1, 1, 1, 0, -1, relational_lane_result(operator_start, -1))
                                                    discard emit_v3_r(negative_value_id, 0, negative_result_value)
                                                    discard emit_v3_i_block(negative_store_id, function_id, 1, 2, 16, 0, 2, temporary_storage_id, -1)
                                                    discard emit_v3_o(negative_store_id, 0, negative_index_value)
                                                    discard emit_v3_o(negative_store_id, 1, negative_result_value)
                                                    discard emit_v3_i_block(negative_jump_id, function_id, 1, 3, 24, 0, 0, -1, -1)
                                                    discard emit_v3_t_jump(negative_jump_id, 4)
                                                    discard emit_v3_i_block(neutral_const_id, function_id, 2, 0, 1, 1, 0, -1, 0)
                                                    discard emit_v3_r(neutral_const_id, 0, neutral_index_value)
                                                    discard emit_v3_i_block(neutral_value_id, function_id, 2, 1, 1, 1, 0, -1, relational_lane_result(operator_start, 0))
                                                    discard emit_v3_r(neutral_value_id, 0, neutral_result_value)
                                                    discard emit_v3_i_block(neutral_store_id, function_id, 2, 2, 16, 0, 2, temporary_storage_id, -1)
                                                    discard emit_v3_o(neutral_store_id, 0, neutral_index_value)
                                                    discard emit_v3_o(neutral_store_id, 1, neutral_result_value)
                                                    discard emit_v3_i_block(neutral_jump_id, function_id, 2, 3, 24, 0, 0, -1, -1)
                                                    discard emit_v3_t_jump(neutral_jump_id, 4)
                                                    discard emit_v3_i_block(positive_const_id, function_id, 3, 0, 1, 1, 0, -1, 0)
                                                    discard emit_v3_r(positive_const_id, 0, positive_index_value)
                                                    discard emit_v3_i_block(positive_value_id, function_id, 3, 1, 1, 1, 0, -1, relational_lane_result(operator_start, 1))
                                                    discard emit_v3_r(positive_value_id, 0, positive_result_value)
                                                    discard emit_v3_i_block(positive_store_id, function_id, 3, 2, 16, 0, 2, temporary_storage_id, -1)
                                                    discard emit_v3_o(positive_store_id, 0, positive_index_value)
                                                    discard emit_v3_o(positive_store_id, 1, positive_result_value)
                                                    discard emit_v3_i_block(positive_jump_id, function_id, 3, 3, 24, 0, 0, -1, -1)
                                                    discard emit_v3_t_jump(positive_jump_id, 4)
                                                    discard emit_v3_i_block(continuation_const_id, function_id, 4, 0, 1, 1, 0, -1, 0)
                                                    discard emit_v3_r(continuation_const_id, 0, continuation_index_value)
                                                    discard emit_v3_i_block(continuation_load_id, function_id, 4, 1, 15, 1, 1, temporary_storage_id, -1)
                                                    discard emit_v3_o(continuation_load_id, 0, continuation_index_value)
                                                    discard emit_v3_r(continuation_load_id, 0, continuation_load_value)
                                                    discard emit_v3_i_block(continuation_branch_id, function_id, 4, 2, 25, 0, 1, -1, -1)
                                                    discard emit_v3_o(continuation_branch_id, 0, continuation_load_value)
                                                    discard emit_v3_t_branch(continuation_branch_id, 5, 6, 7, continuation_load_value)
                                                    discard emit_v3_i_block(negative_switch_const_id, function_id, 5, 0, 1, 1, 0, -1, parse_integer_literal(negative_start, negative_stop))
                                                    discard emit_v3_r(negative_switch_const_id, 0, negative_switch_value)
                                                    discard emit_v3_i_block(negative_switch_return_id, function_id, 5, 1, 23, 0, 1, -1, -1)
                                                    discard emit_v3_o(negative_switch_return_id, 0, negative_switch_value)
                                                    discard emit_v3_t(negative_switch_return_id, negative_switch_value)
                                                    discard emit_v3_i_block(neutral_switch_const_id, function_id, 6, 0, 1, 1, 0, -1, parse_integer_literal(neutral_start, neutral_stop))
                                                    discard emit_v3_r(neutral_switch_const_id, 0, neutral_switch_value)
                                                    discard emit_v3_i_block(neutral_switch_return_id, function_id, 6, 1, 23, 0, 1, -1, -1)
                                                    discard emit_v3_o(neutral_switch_return_id, 0, neutral_switch_value)
                                                    discard emit_v3_t(neutral_switch_return_id, neutral_switch_value)
                                                    discard emit_v3_i_block(positive_switch_const_id, function_id, 7, 0, 1, 1, 0, -1, parse_integer_literal(positive_start, positive_stop))
                                                    discard emit_v3_r(positive_switch_const_id, 0, positive_switch_value)
                                                    discard emit_v3_i_block(positive_switch_return_id, function_id, 7, 1, 23, 0, 1, -1, -1)
                                                    discard emit_v3_o(positive_switch_return_id, 0, positive_switch_value)
                                                    discard emit_v3_t(positive_switch_return_id, positive_switch_value)
                                                    discard emit_v3_b_block(function_id, 0, 0, condition_instruction_count, branch_id)
                                                    discard emit_v3_b_block(function_id, 1, 1, 4, negative_jump_id)
                                                    discard emit_v3_b_block(function_id, 2, 2, 4, neutral_jump_id)
                                                    discard emit_v3_b_block(function_id, 3, 3, 4, positive_jump_id)
                                                    discard emit_v3_b_block(function_id, 4, 4, 3, continuation_branch_id)
                                                    discard emit_v3_b_block(function_id, 5, 5, 2, negative_switch_return_id)
                                                    discard emit_v3_b_block(function_id, 6, 6, 2, neutral_switch_return_id)
                                                    discard emit_v3_b_block(function_id, 7, 7, 2, positive_switch_return_id)
                                                    mut encoded_next_id: i64 = value_id + condition_instruction_count + 11
                                                    encoded_next_id = encoded_next_id * 1000000
                                                    encoded_next_id = encoded_next_id + branch_cursor + 2000000000000
                                                    return encoded_next_id
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn match_tree_branch_body_start(branch_start: i64, branch_stop: i64) -> i64:
    return branch_stop + 1

fn match_tree_after_branch(branch_start: i64, branch_stop: i64) -> i64:
    mut body_start: i64 = match_tree_branch_body_start(branch_start, branch_stop)
    mut body_stop: i64 = line_end(body_start, s3_stage1_source_length())
    mut body_first: i64 = first_non_space(body_start, body_stop)
    mut nested_info: i64 = parse_match_comparison(body_first, body_stop)
    match nested_info > 0:
        -1:
            return match_tree_after_match(body_first, body_stop)
        0:
            return body_stop + 1
        1:
            return body_stop + 1

fn match_tree_after_match(match_first: i64, match_stop: i64) -> i64:
    mut branch_cursor: i64 = line_end(source_line_start(match_first), s3_stage1_source_length()) + 1
    mut branch_number: i64 = 0
    while branch_number < 3:
        mut branch_stop: i64 = line_end(branch_cursor, s3_stage1_source_length())
        branch_cursor = match_tree_after_branch(branch_cursor, branch_stop)
        branch_number += 1
    return branch_cursor

fn match_tree_blocks(match_first: i64, match_stop: i64) -> i64:
    mut branch_cursor: i64 = line_end(source_line_start(match_first), s3_stage1_source_length()) + 1
    mut branch_number: i64 = 0
    mut block_count: i64 = 1
    while branch_number < 3:
        mut branch_stop: i64 = line_end(branch_cursor, s3_stage1_source_length())
        mut body_start: i64 = match_tree_branch_body_start(branch_cursor, branch_stop)
        mut body_stop: i64 = line_end(body_start, s3_stage1_source_length())
        mut body_first: i64 = first_non_space(body_start, body_stop)
        mut nested_info: i64 = parse_match_comparison(body_first, body_stop)
        match nested_info > 0:
            -1:
                block_count += match_tree_blocks(body_first, body_stop)
            0:
                block_count += 1
            1:
                block_count += 1
        branch_cursor = match_tree_after_branch(branch_cursor, branch_stop)
        branch_number += 1
    return block_count

fn match_tree_values(match_first: i64, match_stop: i64) -> i64:
    mut branch_cursor: i64 = line_end(source_line_start(match_first), s3_stage1_source_length()) + 1
    mut branch_number: i64 = 0
    mut value_count: i64 = 2
    while branch_number < 3:
        mut branch_stop: i64 = line_end(branch_cursor, s3_stage1_source_length())
        mut body_start: i64 = match_tree_branch_body_start(branch_cursor, branch_stop)
        mut body_stop: i64 = line_end(body_start, s3_stage1_source_length())
        mut body_first: i64 = first_non_space(body_start, body_stop)
        mut nested_info: i64 = parse_match_comparison(body_first, body_stop)
        match nested_info > 0:
            -1:
                value_count += match_tree_values(body_first, body_stop)
            0:
                value_count += 1
            1:
                value_count += 1
        branch_cursor = match_tree_after_branch(branch_cursor, branch_stop)
        branch_number += 1
    return value_count

fn match_tree_instructions(match_first: i64, match_stop: i64) -> i64:
    mut branch_cursor: i64 = line_end(source_line_start(match_first), s3_stage1_source_length()) + 1
    mut branch_number: i64 = 0
    mut instruction_count: i64 = 3
    while branch_number < 3:
        mut branch_stop: i64 = line_end(branch_cursor, s3_stage1_source_length())
        mut body_start: i64 = match_tree_branch_body_start(branch_cursor, branch_stop)
        mut body_stop: i64 = line_end(body_start, s3_stage1_source_length())
        mut body_first: i64 = first_non_space(body_start, body_stop)
        mut nested_info: i64 = parse_match_comparison(body_first, body_stop)
        match nested_info > 0:
            -1:
                instruction_count += match_tree_instructions(body_first, body_stop)
            0:
                instruction_count += 2
            1:
                instruction_count += 2
        branch_cursor = match_tree_after_branch(branch_cursor, branch_stop)
        branch_number += 1
    return instruction_count

fn emit_match_tree_leaf(function_id: i64, return_type: i64, branch_start: i64, branch_stop: i64, block_id: i64, instruction_ordinal: i64, value_id: i64) -> i64:
    mut body_start: i64 = match_tree_branch_body_start(branch_start, branch_stop)
    mut body_stop: i64 = line_end(body_start, s3_stage1_source_length())
    mut body_first: i64 = first_non_space(body_start, body_stop)
    mut return_info: i64 = parse_return(body_first, body_stop)
    match return_info > 0:
        -1:
            mut return_kind: i64 = return_info / 1000000000000000
            match return_kind == 0:
                -1:
                    mut expression_start: i64 = return_info / 1000000
                    mut expression_stop: i64 = return_info - expression_start * 1000000
                    mut const_id: i64 = function_id * 1000000 + instruction_ordinal
                    mut return_id: i64 = const_id + 1
                    discard emit_v3_v(value_id, function_id, 2, return_type, expression_start)
                    discard emit_v3_i_block(const_id, function_id, block_id, instruction_ordinal, 1, 1, 0, -1, parse_integer_literal(expression_start, expression_stop))
                    discard emit_v3_r(const_id, 0, value_id)
                    discard emit_v3_i_block(return_id, function_id, block_id, instruction_ordinal + 1, 23, 0, 1, -1, -1)
                    discard emit_v3_o(return_id, 0, value_id)
                    discard emit_v3_t(return_id, value_id)
                    discard emit_v3_b_block(function_id, block_id, block_id, 2, return_id)
                    mut encoded_next_id: i64 = value_id + 1
                    encoded_next_id = encoded_next_id * 1000000
                    encoded_next_id = encoded_next_id + body_stop + 1 + 2000000000000
                    return encoded_next_id
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn emit_match_tree_node(function_id: i64, return_type: i64, header_start: i64, header_end: i64, match_first: i64, match_stop: i64, value_id: i64, block_id: i64, instruction_ordinal: i64, root_left_start: i64, root_left_stop: i64) -> i64:
    mut comparison_info: i64 = parse_match_comparison(match_first, match_stop)
    mut comparison_base: i64 = 1000000000000
    mut left_start: i64 = comparison_info / comparison_base
    mut remainder: i64 = comparison_info - left_start * comparison_base
    mut left_stop: i64 = remainder / 1000000
    mut literal_start: i64 = remainder - left_stop * 1000000
    mut operator_start: i64 = skip_spaces(left_stop, match_stop)
    mut right_cursor: i64 = literal_start
    match read_byte(right_cursor) == 45:
        -1:
            right_cursor += 1
        0:
            discard 0
        1:
            discard 0
    mut right_stop: i64 = number_end(right_cursor, match_stop)
    mut left_type: i64 = find_parameter_type(header_start, header_end, left_start, left_stop)
    mut operator_length: i64 = comparison_operator_length(operator_start, match_stop)
    mut valid: trit = -1
    match comparison_info > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_type > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match same_span(left_start, left_stop, root_left_start, root_left_stop):
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match expect_byte(right_stop, match_stop, 58):
        -1:
            match skip_spaces(right_stop + 1, match_stop) == match_stop:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match is_digit(read_byte(right_cursor)):
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match operator_length == 2:
        -1:
            discard 0
        0:
            match operator_length == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    discard 0
        1:
            discard 0
    mut branch_cursor: i64 = line_end(source_line_start(match_first), s3_stage1_source_length()) + 1
    mut negative_branch_start: i64 = branch_cursor
    mut negative_branch_stop: i64 = line_end(branch_cursor, s3_stage1_source_length())
    mut negative_body_start: i64 = match_tree_branch_body_start(negative_branch_start, negative_branch_stop)
    mut negative_body_stop: i64 = line_end(negative_body_start, s3_stage1_source_length())
    mut negative_body_first: i64 = first_non_space(negative_body_start, negative_body_stop)
    mut negative_nested_info: i64 = parse_match_comparison(negative_body_first, negative_body_stop)
    branch_cursor = match_tree_after_branch(negative_branch_start, negative_branch_stop)
    mut zero_branch_start: i64 = branch_cursor
    mut zero_branch_stop: i64 = line_end(branch_cursor, s3_stage1_source_length())
    mut zero_body_start: i64 = match_tree_branch_body_start(zero_branch_start, zero_branch_stop)
    mut zero_body_stop: i64 = line_end(zero_body_start, s3_stage1_source_length())
    mut zero_body_first: i64 = first_non_space(zero_body_start, zero_body_stop)
    mut zero_nested_info: i64 = parse_match_comparison(zero_body_first, zero_body_stop)
    branch_cursor = match_tree_after_branch(zero_branch_start, zero_branch_stop)
    mut positive_branch_start: i64 = branch_cursor
    mut positive_branch_stop: i64 = line_end(branch_cursor, s3_stage1_source_length())
    mut positive_body_start: i64 = match_tree_branch_body_start(positive_branch_start, positive_branch_stop)
    mut positive_body_stop: i64 = line_end(positive_body_start, s3_stage1_source_length())
    mut positive_body_first: i64 = first_non_space(positive_body_start, positive_body_stop)
    mut positive_nested_info: i64 = parse_match_comparison(positive_body_first, positive_body_stop)
    mut negative_blocks: i64 = 1
    mut zero_blocks: i64 = 1
    mut positive_blocks: i64 = 1
    mut negative_values: i64 = 1
    mut zero_values: i64 = 1
    mut positive_values: i64 = 1
    mut negative_instructions: i64 = 2
    mut zero_instructions: i64 = 2
    mut positive_instructions: i64 = 2
    match negative_nested_info > 0:
        -1:
            negative_blocks = match_tree_blocks(negative_body_first, negative_body_stop)
            negative_values = match_tree_values(negative_body_first, negative_body_stop)
            negative_instructions = match_tree_instructions(negative_body_first, negative_body_stop)
        0:
            discard 0
        1:
            discard 0
    match zero_nested_info > 0:
        -1:
            zero_blocks = match_tree_blocks(zero_body_first, zero_body_stop)
            zero_values = match_tree_values(zero_body_first, zero_body_stop)
            zero_instructions = match_tree_instructions(zero_body_first, zero_body_stop)
        0:
            discard 0
        1:
            discard 0
    match positive_nested_info > 0:
        -1:
            positive_blocks = match_tree_blocks(positive_body_first, positive_body_stop)
            positive_values = match_tree_values(positive_body_first, positive_body_stop)
            positive_instructions = match_tree_instructions(positive_body_first, positive_body_stop)
        0:
            discard 0
        1:
            discard 0
    match valid == -1:
        -1:
            mut base_id: i64 = function_id * 1000000 + instruction_ordinal
            mut literal_value: i64 = value_id
            mut compare_value: i64 = value_id + 1
            mut negative_target: i64 = block_id + 1
            mut zero_target: i64 = negative_target + negative_blocks
            mut positive_target: i64 = zero_target + zero_blocks
            discard emit_v3_v(literal_value, function_id, 2, left_type, literal_start)
            discard emit_v3_v(compare_value, function_id, 3, 1, operator_start)
            discard emit_v3_i_block(base_id, function_id, block_id, instruction_ordinal, 1, 1, 0, -1, parse_integer_literal(literal_start, right_stop))
            discard emit_v3_r(base_id, 0, literal_value)
            discard emit_v3_i_block(base_id + 1, function_id, block_id, instruction_ordinal + 1, 13, 1, 2, -1, -1)
            discard emit_v3_o(base_id + 1, 0, find_parameter_ordinal(header_start, header_end, left_start, left_stop))
            discard emit_v3_o(base_id + 1, 1, literal_value)
            discard emit_v3_r(base_id + 1, 0, compare_value)
            discard emit_v3_i_block(base_id + 2, function_id, block_id, instruction_ordinal + 2, 25, 0, 1, -1, -1)
            discard emit_v3_o(base_id + 2, 0, compare_value)
            discard emit_v3_t_branch(base_id + 2, negative_target, zero_target, positive_target, compare_value)
            discard emit_v3_b_block(function_id, block_id, block_id, 3, base_id + 2)
            mut negative_result: i64 = 0
            match negative_nested_info > 0:
                -1:
                    negative_result = emit_match_tree_node(function_id, return_type, header_start, header_end, negative_body_first, negative_body_stop, value_id + 2, negative_target, instruction_ordinal + 3, root_left_start, root_left_stop)
                0:
                    negative_result = emit_match_tree_leaf(function_id, return_type, negative_branch_start, negative_branch_stop, negative_target, instruction_ordinal + 3, value_id + 2)
                1:
                    return -1
            match negative_result >= 2000000000000:
                -1:
                    discard 0
                0:
                    return -1
                1:
                    return -1
            mut negative_packed: i64 = negative_result - 2000000000000
            mut next_value_id: i64 = negative_packed / 1000000
            mut next_cursor: i64 = negative_packed - next_value_id * 1000000
            mut zero_result: i64 = 0
            match zero_nested_info > 0:
                -1:
                    zero_result = emit_match_tree_node(function_id, return_type, header_start, header_end, zero_body_first, zero_body_stop, next_value_id, zero_target, instruction_ordinal + 3 + negative_instructions, root_left_start, root_left_stop)
                0:
                    zero_result = emit_match_tree_leaf(function_id, return_type, zero_branch_start, zero_branch_stop, zero_target, instruction_ordinal + 3 + negative_instructions, next_value_id)
                1:
                    return -1
            match zero_result >= 2000000000000:
                -1:
                    discard 0
                0:
                    return -1
                1:
                    return -1
            mut zero_packed: i64 = zero_result - 2000000000000
            next_value_id = zero_packed / 1000000
            next_cursor = zero_packed - next_value_id * 1000000
            mut positive_result: i64 = 0
            match positive_nested_info > 0:
                -1:
                    positive_result = emit_match_tree_node(function_id, return_type, header_start, header_end, positive_body_first, positive_body_stop, next_value_id, positive_target, instruction_ordinal + 3 + negative_instructions + zero_instructions, root_left_start, root_left_stop)
                0:
                    positive_result = emit_match_tree_leaf(function_id, return_type, positive_branch_start, positive_branch_stop, positive_target, instruction_ordinal + 3 + negative_instructions + zero_instructions, next_value_id)
                1:
                    return -1
            match positive_result >= 2000000000000:
                -1:
                    mut positive_packed: i64 = positive_result - 2000000000000
                    next_value_id = positive_packed / 1000000
                    next_cursor = positive_packed - next_value_id * 1000000
                    mut encoded_next_id: i64 = next_value_id
                    encoded_next_id = encoded_next_id * 1000000
                    encoded_next_id = encoded_next_id + next_cursor + 2000000000000
                    return encoded_next_id
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_match_parameter_tree_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, comparison_info: i64, value_id: i64) -> i64:
    mut comparison_base: i64 = 1000000000000
    mut root_left_start: i64 = comparison_info / comparison_base
    mut root_remainder: i64 = comparison_info - root_left_start * comparison_base
    mut root_left_stop: i64 = root_remainder / 1000000
    mut root_type: i64 = find_parameter_type(header_start, header_end, root_left_start, root_left_stop)
    match root_type > 0:
        -1:
            mut root_blocks: i64 = match_tree_blocks(first, stop)
            match root_blocks > 0:
                -1:
                    return emit_match_tree_node(function_id, return_type, header_start, header_end, first, stop, value_id, 0, count_core_instructions_between(header_end + 1, first), root_left_start, root_left_stop)
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_match_parameter_nested_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, comparison_info: i64, value_id: i64) -> i64:
    mut comparison_base: i64 = 1000000000000
    mut outer_left_start: i64 = comparison_info / comparison_base
    mut outer_remainder: i64 = comparison_info - outer_left_start * comparison_base
    mut outer_left_stop: i64 = outer_remainder / 1000000
    mut outer_literal_start: i64 = outer_remainder - outer_left_stop * 1000000
    mut outer_operator_start: i64 = skip_spaces(outer_left_stop, stop)
    match comparison_operator_length(outer_operator_start, stop) == 3:
        -1:
            mut outer_right_cursor: i64 = outer_literal_start
            match read_byte(outer_right_cursor) == 45:
                -1:
                    outer_right_cursor += 1
                0:
                    discard 0
                1:
                    discard 0
            mut outer_right_stop: i64 = number_end(outer_right_cursor, stop)
            match skip_spaces(outer_right_stop, stop) == stop:
                -1:
                    mut outer_branch_cursor: i64 = line_end(source_line_start(first), s3_stage1_source_length()) + 1
                    mut outer_negative_label: i64 = match_branch_label_value(first_non_space(outer_branch_cursor, line_end(outer_branch_cursor, s3_stage1_source_length())), line_end(outer_branch_cursor, s3_stage1_source_length()))
                    match outer_negative_label == -1:
                        -1:
                            mut outer_negative_stop: i64 = line_end(outer_branch_cursor, s3_stage1_source_length())
                            mut outer_negative_return_first: i64 = first_non_space(outer_negative_stop + 1, line_end(outer_negative_stop + 1, s3_stage1_source_length()))
                            mut outer_negative_return_stop: i64 = line_end(outer_negative_stop + 1, s3_stage1_source_length())
                            mut outer_negative_return_info: i64 = match_branch_return_literal(outer_negative_return_first, outer_negative_return_stop)
                            match outer_negative_return_info > 0:
                                -1:
                                    outer_branch_cursor = outer_negative_return_stop + 1
                                    mut outer_zero_stop: i64 = line_end(outer_branch_cursor, s3_stage1_source_length())
                                    mut outer_zero_first: i64 = first_non_space(outer_branch_cursor, outer_zero_stop)
                                    match match_branch_label_value(outer_zero_first, outer_zero_stop) == 0:
                                        -1:
                                            mut outer_zero_return_stop: i64 = line_end(outer_zero_stop + 1, s3_stage1_source_length())
                                            mut outer_zero_return_first: i64 = first_non_space(outer_zero_stop + 1, outer_zero_return_stop)
                                            mut outer_zero_return_info: i64 = match_branch_return_literal(outer_zero_return_first, outer_zero_return_stop)
                                            match outer_zero_return_info > 0:
                                                -1:
                                                    outer_branch_cursor = outer_zero_return_stop + 1
                                                    mut outer_positive_stop: i64 = line_end(outer_branch_cursor, s3_stage1_source_length())
                                                    mut outer_positive_first: i64 = first_non_space(outer_branch_cursor, outer_positive_stop)
                                                    match match_branch_label_value(outer_positive_first, outer_positive_stop) == 1:
                                                        -1:
                                                            mut nested_match_line_start: i64 = outer_positive_stop + 1
                                                            mut nested_match_stop: i64 = line_end(nested_match_line_start, s3_stage1_source_length())
                                                            mut nested_match_first: i64 = first_non_space(nested_match_line_start, nested_match_stop)
                                                            mut nested_comparison_info: i64 = parse_match_comparison(nested_match_first, nested_match_stop)
                                                            match nested_comparison_info > 0:
                                                                -1:
                                                                    mut nested_left_start: i64 = nested_comparison_info / comparison_base
                                                                    mut nested_remainder: i64 = nested_comparison_info - nested_left_start * comparison_base
                                                                    mut nested_left_stop: i64 = nested_remainder / 1000000
                                                                    mut nested_literal_start: i64 = nested_remainder - nested_left_stop * 1000000
                                                                    mut nested_operator_start: i64 = skip_spaces(nested_left_stop, nested_match_stop)
                                                                    match comparison_operator_length(nested_operator_start, nested_match_stop) == 3:
                                                                        -1:
                                                                            match find_parameter_type(header_start, header_end, outer_left_start, outer_left_stop) > 0:
                                                                                -1:
                                                                                    match find_parameter_type(header_start, header_end, nested_left_start, nested_left_stop) > 0:
                                                                                        -1:
                                                                                            mut nested_right_cursor: i64 = nested_literal_start
                                                                                            match read_byte(nested_right_cursor) == 45:
                                                                                                -1:
                                                                                                    nested_right_cursor += 1
                                                                                                0:
                                                                                                    discard 0
                                                                                                1:
                                                                                                    discard 0
                                                                                            mut nested_right_stop: i64 = number_end(nested_right_cursor, nested_match_stop)
                                                                                            match skip_spaces(nested_right_stop, nested_match_stop) == nested_match_stop:
                                                                                                -1:
                                                                                                    mut nested_branch_cursor: i64 = line_end(source_line_start(nested_match_first), s3_stage1_source_length()) + 1
                                                                                                    mut nested_negative_stop: i64 = line_end(nested_branch_cursor, s3_stage1_source_length())
                                                                                                    mut nested_negative_first: i64 = first_non_space(nested_branch_cursor, nested_negative_stop)
                                                                                                    match match_branch_label_value(nested_negative_first, nested_negative_stop) == -1:
                                                                                                        -1:
                                                                                                            mut nested_negative_return_stop: i64 = line_end(nested_negative_stop + 1, s3_stage1_source_length())
                                                                                                            mut nested_negative_return_first: i64 = first_non_space(nested_negative_stop + 1, nested_negative_return_stop)
                                                                                                            mut nested_negative_return_info: i64 = match_branch_return_literal(nested_negative_return_first, nested_negative_return_stop)
                                                                                                            match nested_negative_return_info > 0:
                                                                                                                -1:
                                                                                                                    nested_branch_cursor = nested_negative_return_stop + 1
                                                                                                                    mut nested_zero_stop: i64 = line_end(nested_branch_cursor, s3_stage1_source_length())
                                                                                                                    mut nested_zero_first: i64 = first_non_space(nested_branch_cursor, nested_zero_stop)
                                                                                                                    match match_branch_label_value(nested_zero_first, nested_zero_stop) == 0:
                                                                                                                        -1:
                                                                                                                            mut nested_zero_return_stop: i64 = line_end(nested_zero_stop + 1, s3_stage1_source_length())
                                                                                                                            mut nested_zero_return_first: i64 = first_non_space(nested_zero_stop + 1, nested_zero_return_stop)
                                                                                                                            mut nested_zero_return_info: i64 = match_branch_return_literal(nested_zero_return_first, nested_zero_return_stop)
                                                                                                                            match nested_zero_return_info > 0:
                                                                                                                                -1:
                                                                                                                                    nested_branch_cursor = nested_zero_return_stop + 1
                                                                                                                                    mut nested_positive_stop: i64 = line_end(nested_branch_cursor, s3_stage1_source_length())
                                                                                                                                    mut nested_positive_first: i64 = first_non_space(nested_branch_cursor, nested_positive_stop)
                                                                                                                                    match match_branch_label_value(nested_positive_first, nested_positive_stop) == 1:
                                                                                                                                        -1:
                                                                                                                                            mut nested_positive_return_stop: i64 = line_end(nested_positive_stop + 1, s3_stage1_source_length())
                                                                                                                                            mut nested_positive_return_first: i64 = first_non_space(nested_positive_stop + 1, nested_positive_return_stop)
                                                                                                                                            mut nested_positive_return_info: i64 = match_branch_return_literal(nested_positive_return_first, nested_positive_return_stop)
                                                                                                                                            match nested_positive_return_info > 0:
                                                                                                                                                -1:
                                                                                                                                                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                                                                                                                                    mut base_id: i64 = function_id * 1000000 + ordinal
                                                                                                                                                    mut outer_const_id: i64 = base_id
                                                                                                                                                    mut outer_compare_id: i64 = base_id + 1
                                                                                                                                                    mut outer_branch_id: i64 = base_id + 2
                                                                                                                                                    mut outer_negative_const_id: i64 = base_id + 3
                                                                                                                                                    mut outer_negative_return_id: i64 = base_id + 4
                                                                                                                                                    mut outer_zero_const_id: i64 = base_id + 5
                                                                                                                                                    mut outer_zero_return_id: i64 = base_id + 6
                                                                                                                                                    mut nested_const_id: i64 = base_id + 7
                                                                                                                                                    mut nested_compare_id: i64 = base_id + 8
                                                                                                                                                    mut nested_branch_id: i64 = base_id + 9
                                                                                                                                                    mut nested_negative_const_id: i64 = base_id + 10
                                                                                                                                                    mut nested_negative_return_id: i64 = base_id + 11
                                                                                                                                                    mut nested_zero_const_id: i64 = base_id + 12
                                                                                                                                                    mut nested_zero_return_id: i64 = base_id + 13
                                                                                                                                                    mut nested_positive_const_id: i64 = base_id + 14
                                                                                                                                                    mut nested_positive_return_id: i64 = base_id + 15
                                                                                                                                                    mut outer_parameter_value: i64 = value_id - 1
                                                                                                                                                    mut outer_literal_value: i64 = value_id
                                                                                                                                                    mut outer_compare_value: i64 = value_id + 1
                                                                                                                                                    mut outer_negative_value: i64 = value_id + 2
                                                                                                                                                    mut outer_zero_value: i64 = value_id + 3
                                                                                                                                                    mut nested_literal_value: i64 = value_id + 4
                                                                                                                                                    mut nested_compare_value: i64 = value_id + 5
                                                                                                                                                    mut nested_negative_value: i64 = value_id + 6
                                                                                                                                                    mut nested_zero_value: i64 = value_id + 7
                                                                                                                                                    mut nested_positive_value: i64 = value_id + 8
                                                                                                                                                    mut outer_negative_start: i64 = outer_negative_return_info / 1000000
                                                                                                                                                    mut outer_negative_return_end: i64 = outer_negative_return_info - outer_negative_start * 1000000
                                                                                                                                                    mut outer_zero_start: i64 = outer_zero_return_info / 1000000
                                                                                                                                                    mut outer_zero_return_end: i64 = outer_zero_return_info - outer_zero_start * 1000000
                                                                                                                                                    mut nested_negative_start: i64 = nested_negative_return_info / 1000000
                                                                                                                                                    mut nested_negative_return_end: i64 = nested_negative_return_info - nested_negative_start * 1000000
                                                                                                                                                    mut nested_zero_start: i64 = nested_zero_return_info / 1000000
                                                                                                                                                    mut nested_zero_return_end: i64 = nested_zero_return_info - nested_zero_start * 1000000
                                                                                                                                                    mut nested_positive_start: i64 = nested_positive_return_info / 1000000
                                                                                                                                                    mut nested_positive_return_end: i64 = nested_positive_return_info - nested_positive_start * 1000000
                                                                                                                                                    discard emit_v3_v(outer_literal_value, function_id, 2, 2, outer_literal_start)
                                                                                                                                                    discard emit_v3_v(outer_compare_value, function_id, 3, 1, outer_operator_start)
                                                                                                                                                    discard emit_v3_v(outer_negative_value, function_id, 2, return_type, outer_negative_start)
                                                                                                                                                    discard emit_v3_v(outer_zero_value, function_id, 2, return_type, outer_zero_start)
                                                                                                                                                    discard emit_v3_v(nested_literal_value, function_id, 2, 2, nested_literal_start)
                                                                                                                                                    discard emit_v3_v(nested_compare_value, function_id, 3, 1, nested_operator_start)
                                                                                                                                                    discard emit_v3_v(nested_negative_value, function_id, 2, return_type, nested_negative_start)
                                                                                                                                                    discard emit_v3_v(nested_zero_value, function_id, 2, return_type, nested_zero_start)
                                                                                                                                                    discard emit_v3_v(nested_positive_value, function_id, 2, return_type, nested_positive_start)
                                                                                                                                                    discard emit_v3_i_block(outer_const_id, function_id, 0, ordinal, 1, 1, 0, -1, parse_integer_literal(outer_literal_start, outer_right_stop))
                                                                                                                                                    discard emit_v3_r(outer_const_id, 0, outer_literal_value)
                                                                                                                                                    discard emit_v3_i_block(outer_compare_id, function_id, 0, ordinal + 1, 13, 1, 2, -1, -1)
                                                                                                                                                    discard emit_v3_o(outer_compare_id, 0, outer_parameter_value)
                                                                                                                                                    discard emit_v3_o(outer_compare_id, 1, outer_literal_value)
                                                                                                                                                    discard emit_v3_r(outer_compare_id, 0, outer_compare_value)
                                                                                                                                                    discard emit_v3_i_block(outer_branch_id, function_id, 0, ordinal + 2, 25, 0, 1, -1, -1)
                                                                                                                                                    discard emit_v3_o(outer_branch_id, 0, outer_compare_value)
                                                                                                                                                    discard emit_v3_t_branch(outer_branch_id, 1, 2, 3, outer_compare_value)
                                                                                                                                                    discard emit_v3_i_block(outer_negative_const_id, function_id, 1, 0, 1, 1, 0, -1, parse_integer_literal(outer_negative_start, outer_negative_return_end))
                                                                                                                                                    discard emit_v3_r(outer_negative_const_id, 0, outer_negative_value)
                                                                                                                                                    discard emit_v3_i_block(outer_negative_return_id, function_id, 1, 1, 23, 0, 1, -1, -1)
                                                                                                                                                    discard emit_v3_o(outer_negative_return_id, 0, outer_negative_value)
                                                                                                                                                    discard emit_v3_t(outer_negative_return_id, outer_negative_value)
                                                                                                                                                    discard emit_v3_i_block(outer_zero_const_id, function_id, 2, 0, 1, 1, 0, -1, parse_integer_literal(outer_zero_start, outer_zero_return_end))
                                                                                                                                                    discard emit_v3_r(outer_zero_const_id, 0, outer_zero_value)
                                                                                                                                                    discard emit_v3_i_block(outer_zero_return_id, function_id, 2, 1, 23, 0, 1, -1, -1)
                                                                                                                                                    discard emit_v3_o(outer_zero_return_id, 0, outer_zero_value)
                                                                                                                                                    discard emit_v3_t(outer_zero_return_id, outer_zero_value)
                                                                                                                                                    discard emit_v3_i_block(nested_const_id, function_id, 3, ordinal + 7, 1, 1, 0, -1, parse_integer_literal(nested_literal_start, nested_right_stop))
                                                                                                                                                    discard emit_v3_r(nested_const_id, 0, nested_literal_value)
                                                                                                                                                    discard emit_v3_i_block(nested_compare_id, function_id, 3, ordinal + 8, 13, 1, 2, -1, -1)
                                                                                                                                                    discard emit_v3_o(nested_compare_id, 0, outer_parameter_value)
                                                                                                                                                    discard emit_v3_o(nested_compare_id, 1, nested_literal_value)
                                                                                                                                                    discard emit_v3_r(nested_compare_id, 0, nested_compare_value)
                                                                                                                                                    discard emit_v3_i_block(nested_branch_id, function_id, 3, ordinal + 9, 25, 0, 1, -1, -1)
                                                                                                                                                    discard emit_v3_o(nested_branch_id, 0, nested_compare_value)
                                                                                                                                                    discard emit_v3_t_branch(nested_branch_id, 4, 5, 6, nested_compare_value)
                                                                                                                                                    discard emit_v3_i_block(nested_negative_const_id, function_id, 4, 0, 1, 1, 0, -1, parse_integer_literal(nested_negative_start, nested_negative_return_end))
                                                                                                                                                    discard emit_v3_r(nested_negative_const_id, 0, nested_negative_value)
                                                                                                                                                    discard emit_v3_i_block(nested_negative_return_id, function_id, 4, 1, 23, 0, 1, -1, -1)
                                                                                                                                                    discard emit_v3_o(nested_negative_return_id, 0, nested_negative_value)
                                                                                                                                                    discard emit_v3_t(nested_negative_return_id, nested_negative_value)
                                                                                                                                                    discard emit_v3_i_block(nested_zero_const_id, function_id, 5, 0, 1, 1, 0, -1, parse_integer_literal(nested_zero_start, nested_zero_return_end))
                                                                                                                                                    discard emit_v3_r(nested_zero_const_id, 0, nested_zero_value)
                                                                                                                                                    discard emit_v3_i_block(nested_zero_return_id, function_id, 5, 1, 23, 0, 1, -1, -1)
                                                                                                                                                    discard emit_v3_o(nested_zero_return_id, 0, nested_zero_value)
                                                                                                                                                    discard emit_v3_t(nested_zero_return_id, nested_zero_value)
                                                                                                                                                    discard emit_v3_i_block(nested_positive_const_id, function_id, 6, 0, 1, 1, 0, -1, parse_integer_literal(nested_positive_start, nested_positive_return_end))
                                                                                                                                                    discard emit_v3_r(nested_positive_const_id, 0, nested_positive_value)
                                                                                                                                                    discard emit_v3_i_block(nested_positive_return_id, function_id, 6, 1, 23, 0, 1, -1, -1)
                                                                                                                                                    discard emit_v3_o(nested_positive_return_id, 0, nested_positive_value)
                                                                                                                                                    discard emit_v3_t(nested_positive_return_id, nested_positive_value)
                                                                                                                                                    discard emit_v3_b_block(function_id, 0, 0, 3, outer_branch_id)
                                                                                                                                                    discard emit_v3_b_block(function_id, 1, 1, 2, outer_negative_return_id)
                                                                                                                                                    discard emit_v3_b_block(function_id, 2, 2, 2, outer_zero_return_id)
                                                                                                                                                    discard emit_v3_b_block(function_id, 3, 3, 3, nested_branch_id)
                                                                                                                                                    discard emit_v3_b_block(function_id, 4, 4, 2, nested_negative_return_id)
                                                                                                                                                    discard emit_v3_b_block(function_id, 5, 5, 2, nested_zero_return_id)
                                                                                                                                                    discard emit_v3_b_block(function_id, 6, 6, 2, nested_positive_return_id)
                                                                                                                                                    mut encoded_next_id: i64 = value_id + 9
                                                                                                                                                    encoded_next_id = encoded_next_id * 1000000
                                                                                                                                                    encoded_next_id = encoded_next_id + nested_positive_return_stop + 1 + 2000000000000
                                                                                                                                                    return encoded_next_id
                                                                                                                                                0:
                                                                                                                                                    return -1
                                                                                                                                                1:
                                                                                                                                                    return -1
                                                                                                                                        0:
                                                                                                                                            return -1
                                                                                                                                        1:
                                                                                                                                            return -1
                                                                                                                                0:
                                                                                                                                    return -1
                                                                                                                                1:
                                                                                                                                    return -1
                                                                                                                        0:
                                                                                                                            return -1
                                                                                                                        1:
                                                                                                                            return -1
                                                                                                                0:
                                                                                                                    return -1
                                                                                                                1:
                                                                                                                    return -1
                                                                                                        0:
                                                                                                            return -1
                                                                                                        1:
                                                                                                            return -1
                                                                                                0:
                                                                                                    return -1
                                                                                                1:
                                                                                                    return -1
                                                                                        0:
                                                                                            return -1
                                                                                        1:
                                                                                            return -1
                                                                                0:
                                                                                    return -1
                                                                                1:
                                                                                    return -1
                                                                        0:
                                                                            return -1
                                                                        1:
                                                                            return -1
                                                                0:
                                                                    return -1
                                                                1:
                                                                    return -1
                                                        0:
                                                            return -1
                                                        1:
                                                            return -1
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_match_parameter_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, comparison_info: i64, value_id: i64) -> i64:
    mut nested_encoded_next_id: i64 = scan_match_parameter_nested_v3(function_id, return_type, header_start, header_end, first, stop, comparison_info, value_id)
    match nested_encoded_next_id >= 2000000000000:
        -1:
            return nested_encoded_next_id
        0:
            discard 0
        1:
            discard 0
    mut comparison_base: i64 = 1000000000000
    mut left_start: i64 = comparison_info / comparison_base
    mut remainder: i64 = comparison_info - left_start * comparison_base
    mut left_stop: i64 = remainder / 1000000
    mut literal_start: i64 = remainder - left_stop * 1000000
    mut left_type: i64 = find_parameter_type(header_start, header_end, left_start, left_stop)
    match left_type > 0:
        -1:
            mut right_cursor: i64 = literal_start
            match read_byte(right_cursor) == 45:
                -1:
                    right_cursor += 1
                0:
                    discard 0
                1:
                    discard 0
            mut right_stop: i64 = number_end(right_cursor, stop)
            match skip_spaces(right_stop, stop) == stop:
                -1:
                    mut branch_cursor: i64 = line_end(source_line_start(first), s3_stage1_source_length()) + 1
                    mut branch_number: i64 = 0
                    mut negative_return_info: i64 = 0
                    mut neutral_return_info: i64 = 0
                    mut positive_return_info: i64 = 0
                    mut valid: trit = -1
                    while branch_number < 3:
                        mut branch_stop: i64 = line_end(branch_cursor, s3_stage1_source_length())
                        mut branch_first: i64 = first_non_space(branch_cursor, branch_stop)
                        mut branch_value: i64 = match_branch_label_value(branch_first, branch_stop)
                        match branch_value == 9:
                            -1:
                                valid = 0
                            0:
                                branch_cursor = branch_stop + 1
                                mut return_stop: i64 = line_end(branch_cursor, s3_stage1_source_length())
                                mut return_first: i64 = first_non_space(branch_cursor, return_stop)
                                mut branch_return_info: i64 = match_branch_return_literal(return_first, return_stop)
                                match branch_return_info > 0:
                                    -1:
                                        match branch_value == -1:
                                            -1:
                                                negative_return_info = branch_return_info
                                            0:
                                                match branch_value == 0:
                                                    -1:
                                                        neutral_return_info = branch_return_info
                                                    0:
                                                        positive_return_info = branch_return_info
                                                    1:
                                                        positive_return_info = branch_return_info
                                            1:
                                                positive_return_info = branch_return_info
                                    0:
                                        valid = 0
                                    1:
                                        valid = 0
                                branch_cursor = return_stop + 1
                            1:
                                valid = 0
                        branch_number += 1
                    match negative_return_info > 0:
                        -1:
                            match neutral_return_info > 0:
                                -1:
                                    match positive_return_info > 0:
                                        -1:
                                            match valid == -1:
                                                -1:
                                                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                                    mut base_id: i64 = function_id * 1000000 + ordinal
                                                    mut const_id: i64 = base_id
                                                    mut compare_id: i64 = base_id + 1
                                                    mut branch_id: i64 = base_id + 2
                                                    mut negative_const_id: i64 = base_id + 3
                                                    mut negative_return_id: i64 = base_id + 4
                                                    mut neutral_const_id: i64 = base_id + 5
                                                    mut neutral_return_id: i64 = base_id + 6
                                                    mut positive_const_id: i64 = base_id + 7
                                                    mut positive_return_id: i64 = base_id + 8
                                                    mut parameter_value: i64 = value_id - 1
                                                    mut right_value: i64 = value_id
                                                    mut compare_value: i64 = value_id + 1
                                                    mut negative_value: i64 = value_id + 2
                                                    mut neutral_value: i64 = value_id + 3
                                                    mut positive_value: i64 = value_id + 4
                                                    mut negative_start: i64 = negative_return_info / 1000000
                                                    mut negative_stop: i64 = negative_return_info - negative_start * 1000000
                                                    mut neutral_start: i64 = neutral_return_info / 1000000
                                                    mut neutral_stop: i64 = neutral_return_info - neutral_start * 1000000
                                                    mut positive_start: i64 = positive_return_info / 1000000
                                                    mut positive_stop: i64 = positive_return_info - positive_start * 1000000
                                                    discard emit_v3_v(right_value, function_id, 2, left_type, literal_start)
                                                    discard emit_v3_v(compare_value, function_id, 3, 1, skip_spaces(left_stop, stop))
                                                    discard emit_v3_v(negative_value, function_id, 2, return_type, negative_start)
                                                    discard emit_v3_v(neutral_value, function_id, 2, return_type, neutral_start)
                                                    discard emit_v3_v(positive_value, function_id, 2, return_type, positive_start)
                                                    discard emit_v3_i_block(const_id, function_id, 0, ordinal, 1, 1, 0, -1, parse_integer_literal(literal_start, right_stop))
                                                    discard emit_v3_r(const_id, 0, right_value)
                                                    discard emit_v3_i_block(compare_id, function_id, 0, ordinal + 1, 13, 1, 2, -1, -1)
                                                    discard emit_v3_o(compare_id, 0, parameter_value)
                                                    discard emit_v3_o(compare_id, 1, right_value)
                                                    discard emit_v3_r(compare_id, 0, compare_value)
                                                    discard emit_v3_i_block(branch_id, function_id, 0, ordinal + 2, 25, 0, 1, -1, -1)
                                                    discard emit_v3_o(branch_id, 0, compare_value)
                                                    discard emit_v3_t_branch(branch_id, 1, 2, 3, compare_value)
                                                    discard emit_v3_i_block(negative_const_id, function_id, 1, 0, 1, 1, 0, -1, parse_integer_literal(negative_start, negative_stop))
                                                    discard emit_v3_r(negative_const_id, 0, negative_value)
                                                    discard emit_v3_i_block(negative_return_id, function_id, 1, 1, 23, 0, 1, -1, -1)
                                                    discard emit_v3_o(negative_return_id, 0, negative_value)
                                                    discard emit_v3_t(negative_return_id, negative_value)
                                                    discard emit_v3_i_block(neutral_const_id, function_id, 2, 0, 1, 1, 0, -1, parse_integer_literal(neutral_start, neutral_stop))
                                                    discard emit_v3_r(neutral_const_id, 0, neutral_value)
                                                    discard emit_v3_i_block(neutral_return_id, function_id, 2, 1, 23, 0, 1, -1, -1)
                                                    discard emit_v3_o(neutral_return_id, 0, neutral_value)
                                                    discard emit_v3_t(neutral_return_id, neutral_value)
                                                    discard emit_v3_i_block(positive_const_id, function_id, 3, 0, 1, 1, 0, -1, parse_integer_literal(positive_start, positive_stop))
                                                    discard emit_v3_r(positive_const_id, 0, positive_value)
                                                    discard emit_v3_i_block(positive_return_id, function_id, 3, 1, 23, 0, 1, -1, -1)
                                                    discard emit_v3_o(positive_return_id, 0, positive_value)
                                                    discard emit_v3_t(positive_return_id, positive_value)
                                                    discard emit_v3_b_block(function_id, 0, 0, ordinal + 3, branch_id)
                                                    discard emit_v3_b_block(function_id, 1, 1, 2, negative_return_id)
                                                    discard emit_v3_b_block(function_id, 2, 2, 2, neutral_return_id)
                                                    discard emit_v3_b_block(function_id, 3, 3, 2, positive_return_id)
                                                    mut encoded_next_id: i64 = value_id + 5
                                                    encoded_next_id = encoded_next_id * 1000000
                                                    encoded_next_id = encoded_next_id + branch_cursor + 2000000000000
                                                    return encoded_next_id
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_match_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, comparison_info: i64, value_id: i64) -> i64:
    mut tree_encoded_next_id: i64 = scan_match_parameter_tree_v3(function_id, return_type, header_start, header_end, first, stop, comparison_info, value_id)
    match tree_encoded_next_id >= 2000000000000:
        -1:
            return tree_encoded_next_id
        0:
            discard 0
        1:
            discard 0
    mut comparison_base: i64 = 1000000000000
    mut left_start: i64 = comparison_info / comparison_base
    mut remainder: i64 = comparison_info - left_start * comparison_base
    mut left_stop: i64 = remainder / 1000000
    mut literal_start: i64 = remainder - left_stop * 1000000
    mut left_type: i64 = find_parameter_type(header_start, header_end, left_start, left_stop)
    match left_type > 0:
        -1:
            mut parameter_operator_start: i64 = skip_spaces(left_stop, stop)
            mut parameter_operator_length: i64 = comparison_operator_length(parameter_operator_start, stop)
            match parameter_operator_length < 3:
                -1:
                    return scan_match_relation_v3(function_id, return_type, header_start, header_end, first, stop, comparison_info, value_id, -1, value_id - 1)
                0:
                    return scan_match_parameter_v3(function_id, return_type, header_start, header_end, first, stop, comparison_info, value_id)
                1:
                    return scan_match_parameter_v3(function_id, return_type, header_start, header_end, first, stop, comparison_info, value_id)
        0:
            left_type = find_local_type(header_end + 1, first, left_start, left_stop)
            match left_type > 0:
                -1:
                    mut storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
                    mut local_operator_start: i64 = skip_spaces(left_stop, stop)
                    mut local_operator_length: i64 = comparison_operator_length(local_operator_start, stop)
                    match local_operator_length < 3:
                        -1:
                            return scan_match_relation_v3(function_id, return_type, header_start, header_end, first, stop, comparison_info, value_id, storage_id, -1)
                        0:
                            discard 0
                        1:
                            discard 0
                    match storage_id >= 0:
                        -1:
                            mut right_cursor: i64 = literal_start
                            match read_byte(right_cursor) == 45:
                                -1:
                                    right_cursor += 1
                                0:
                                    discard 0
                                1:
                                    discard 0
                            mut right_stop: i64 = number_end(right_cursor, stop)
                            match skip_spaces(right_stop, stop) == stop:
                                -1:
                                    mut branch_cursor: i64 = line_end(source_line_start(first), s3_stage1_source_length()) + 1
                                    mut branch_number: i64 = 0
                                    mut negative_return_info: i64 = 0
                                    mut neutral_return_info: i64 = 0
                                    mut positive_return_info: i64 = 0
                                    mut valid: trit = -1
                                    while branch_number < 3:
                                        mut branch_stop: i64 = line_end(branch_cursor, s3_stage1_source_length())
                                        mut branch_first: i64 = first_non_space(branch_cursor, branch_stop)
                                        mut branch_value: i64 = match_branch_label_value(branch_first, branch_stop)
                                        match branch_value == 9:
                                            -1:
                                                valid = 0
                                            0:
                                                branch_cursor = branch_stop + 1
                                                mut return_stop: i64 = line_end(branch_cursor, s3_stage1_source_length())
                                                mut return_first: i64 = first_non_space(branch_cursor, return_stop)
                                                mut branch_return_info: i64 = match_branch_return_literal(return_first, return_stop)
                                                match branch_return_info > 0:
                                                    -1:
                                                        match branch_value == -1:
                                                            -1:
                                                                negative_return_info = branch_return_info
                                                            0:
                                                                match branch_value == 0:
                                                                    -1:
                                                                        neutral_return_info = branch_return_info
                                                                    0:
                                                                        positive_return_info = branch_return_info
                                                                    1:
                                                                        positive_return_info = branch_return_info
                                                            1:
                                                                positive_return_info = branch_return_info
                                                    0:
                                                        valid = 0
                                                    1:
                                                        valid = 0
                                                branch_cursor = return_stop + 1
                                            1:
                                                valid = 0
                                        branch_number += 1
                                    match negative_return_info > 0:
                                        -1:
                                            match neutral_return_info > 0:
                                                -1:
                                                    match positive_return_info > 0:
                                                        -1:
                                                            match valid == -1:
                                                                -1:
                                                                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                                                    mut index_id: i64 = function_id * 1000000 + ordinal
                                                                    mut load_id: i64 = index_id + 1
                                                                    mut const_id: i64 = index_id + 2
                                                                    mut compare_id: i64 = index_id + 3
                                                                    mut branch_id: i64 = index_id + 4
                                                                    mut negative_const_id: i64 = index_id + 5
                                                                    mut negative_return_id: i64 = index_id + 6
                                                                    mut neutral_const_id: i64 = index_id + 7
                                                                    mut neutral_return_id: i64 = index_id + 8
                                                                    mut positive_const_id: i64 = index_id + 9
                                                                    mut positive_return_id: i64 = index_id + 10
                                                                    mut left_index_value: i64 = value_id
                                                                    mut left_load_value: i64 = value_id + 1
                                                                    mut right_value: i64 = value_id + 2
                                                                    mut compare_value: i64 = value_id + 3
                                                                    mut negative_value: i64 = value_id + 4
                                                                    mut neutral_value: i64 = value_id + 5
                                                                    mut positive_value: i64 = value_id + 6
                                                                    mut operator_start: i64 = skip_spaces(left_stop, stop)
                                                                    discard emit_v3_v(left_index_value, function_id, 2, 2, left_start)
                                                                    discard emit_v3_v(left_load_value, function_id, 3, left_type, left_start)
                                                                    discard emit_v3_v(right_value, function_id, 2, left_type, literal_start)
                                                                    discard emit_v3_v(compare_value, function_id, 3, 1, operator_start)
                                                                    discard emit_v3_i_block(index_id, function_id, 0, ordinal, 1, 1, 0, -1, 0)
                                                                    discard emit_v3_r(index_id, 0, left_index_value)
                                                                    discard emit_v3_i_block(load_id, function_id, 0, ordinal + 1, 15, 1, 1, storage_id, -1)
                                                                    discard emit_v3_o(load_id, 0, left_index_value)
                                                                    discard emit_v3_r(load_id, 0, left_load_value)
                                                                    discard emit_v3_i_block(const_id, function_id, 0, ordinal + 2, 1, 1, 0, -1, parse_integer_literal(literal_start, right_stop))
                                                                    discard emit_v3_r(const_id, 0, right_value)
                                                                    discard emit_v3_i_block(compare_id, function_id, 0, ordinal + 3, 13, 1, 2, -1, -1)
                                                                    discard emit_v3_o(compare_id, 0, left_load_value)
                                                                    discard emit_v3_o(compare_id, 1, right_value)
                                                                    discard emit_v3_r(compare_id, 0, compare_value)
                                                                    discard emit_v3_i_block(branch_id, function_id, 0, ordinal + 4, 25, 0, 1, -1, -1)
                                                                    discard emit_v3_o(branch_id, 0, compare_value)
                                                                    discard emit_v3_t_branch(branch_id, 1, 2, 3, compare_value)
                                                                    mut negative_start: i64 = negative_return_info / 1000000
                                                                    mut negative_stop: i64 = negative_return_info - negative_start * 1000000
                                                                    mut neutral_start: i64 = neutral_return_info / 1000000
                                                                    mut neutral_stop: i64 = neutral_return_info - neutral_start * 1000000
                                                                    mut positive_start: i64 = positive_return_info / 1000000
                                                                    mut positive_stop: i64 = positive_return_info - positive_start * 1000000
                                                                    discard emit_v3_v(negative_value, function_id, 2, return_type, negative_start)
                                                                    discard emit_v3_v(neutral_value, function_id, 2, return_type, neutral_start)
                                                                    discard emit_v3_v(positive_value, function_id, 2, return_type, positive_start)
                                                                    discard emit_v3_i_block(negative_const_id, function_id, 1, 0, 1, 1, 0, -1, parse_integer_literal(negative_start, negative_stop))
                                                                    discard emit_v3_r(negative_const_id, 0, negative_value)
                                                                    discard emit_v3_i_block(negative_return_id, function_id, 1, 1, 23, 0, 1, -1, -1)
                                                                    discard emit_v3_o(negative_return_id, 0, negative_value)
                                                                    discard emit_v3_t(negative_return_id, negative_value)
                                                                    discard emit_v3_i_block(neutral_const_id, function_id, 2, 0, 1, 1, 0, -1, parse_integer_literal(neutral_start, neutral_stop))
                                                                    discard emit_v3_r(neutral_const_id, 0, neutral_value)
                                                                    discard emit_v3_i_block(neutral_return_id, function_id, 2, 1, 23, 0, 1, -1, -1)
                                                                    discard emit_v3_o(neutral_return_id, 0, neutral_value)
                                                                    discard emit_v3_t(neutral_return_id, neutral_value)
                                                                    discard emit_v3_i_block(positive_const_id, function_id, 3, 0, 1, 1, 0, -1, parse_integer_literal(positive_start, positive_stop))
                                                                    discard emit_v3_r(positive_const_id, 0, positive_value)
                                                                    discard emit_v3_i_block(positive_return_id, function_id, 3, 1, 23, 0, 1, -1, -1)
                                                                    discard emit_v3_o(positive_return_id, 0, positive_value)
                                                                    discard emit_v3_t(positive_return_id, positive_value)
                                                                    discard emit_v3_b_block(function_id, 0, 0, ordinal + 5, branch_id)
                                                                    discard emit_v3_b_block(function_id, 1, 1, 2, negative_return_id)
                                                                    discard emit_v3_b_block(function_id, 2, 2, 2, neutral_return_id)
                                                                    discard emit_v3_b_block(function_id, 3, 3, 2, positive_return_id)
                                                                    mut encoded_next_id: i64 = value_id + 7
                                                                    encoded_next_id = encoded_next_id * 1000000
                                                                    encoded_next_id = encoded_next_id + branch_cursor + 2000000000000
                                                                    return encoded_next_id
                                                                0:
                                                                    return -1
                                                                1:
                                                                    return -1
                                                        0:
                                                            return -1
                                                        1:
                                                            return -1
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        1:
            return -1

fn scan_relational_return_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, comparison_info: i64, value_id: i64) -> i64:
    match return_type == 1:
        -1:
            mut comparison_base: i64 = 1000000000000
            mut left_start: i64 = comparison_info / comparison_base
            mut remainder: i64 = comparison_info - left_start * comparison_base
            mut left_stop: i64 = remainder / 1000000
            mut operator_start: i64 = remainder - left_stop * 1000000
            mut operator_length: i64 = comparison_operator_length(operator_start, stop)
            mut right_start: i64 = skip_spaces(operator_start + operator_length, stop)
            mut right_cursor: i64 = right_start
            match read_byte(right_cursor) == 45:
                -1:
                    right_cursor += 1
                0:
                    discard 0
                1:
                    discard 0
            mut right_stop: i64 = number_end(right_cursor, stop)
            mut left_type: i64 = resolve_value_type(header_start, header_end, first, left_start, left_stop)
            match left_type > 0:
                -1:
                    mut storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
                    match storage_id >= 0:
                        -1:
                            match is_digit(read_byte(right_cursor)):
                                -1:
                                    match skip_spaces(right_stop, stop) == stop:
                                        -1:
                                            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                            mut base_id: i64 = function_id * 1000000 + ordinal
                                            mut condition_index_id: i64 = base_id
                                            mut condition_load_id: i64 = base_id + 1
                                            mut condition_const_id: i64 = base_id + 2
                                            mut compare_id: i64 = base_id + 3
                                            mut branch_id: i64 = base_id + 4
                                            mut negative_const_id: i64 = base_id + 5
                                            mut negative_value_id: i64 = base_id + 6
                                            mut negative_store_id: i64 = base_id + 7
                                            mut negative_jump_id: i64 = base_id + 8
                                            mut neutral_const_id: i64 = base_id + 9
                                            mut neutral_value_id: i64 = base_id + 10
                                            mut neutral_store_id: i64 = base_id + 11
                                            mut neutral_jump_id: i64 = base_id + 12
                                            mut positive_const_id: i64 = base_id + 13
                                            mut positive_value_id: i64 = base_id + 14
                                            mut positive_store_id: i64 = base_id + 15
                                            mut positive_jump_id: i64 = base_id + 16
                                            mut continuation_const_id: i64 = base_id + 17
                                            mut continuation_load_id: i64 = base_id + 18
                                            mut return_id: i64 = base_id + 19
                                            mut left_index_value: i64 = value_id
                                            mut left_load_value: i64 = value_id + 1
                                            mut right_value: i64 = value_id + 2
                                            mut compare_value: i64 = value_id + 3
                                            mut negative_index_value: i64 = value_id + 4
                                            mut negative_result_value: i64 = value_id + 5
                                            mut neutral_index_value: i64 = value_id + 6
                                            mut neutral_result_value: i64 = value_id + 7
                                            mut positive_index_value: i64 = value_id + 8
                                            mut positive_result_value: i64 = value_id + 9
                                            mut continuation_index_value: i64 = value_id + 10
                                            mut continuation_load_value: i64 = value_id + 11
                                            mut temporary_storage_id: i64 = storage_id + 1
                                            discard emit_v3_m(function_id, temporary_storage_id, 1, 1, 1, operator_start)
                                            discard emit_v3_v(left_index_value, function_id, 2, 2, left_start)
                                            discard emit_v3_v(left_load_value, function_id, 3, left_type, left_start)
                                            discard emit_v3_v(right_value, function_id, 2, left_type, right_start)
                                            discard emit_v3_v(compare_value, function_id, 3, 1, operator_start)
                                            discard emit_v3_v(negative_index_value, function_id, 2, 2, operator_start)
                                            discard emit_v3_v(negative_result_value, function_id, 2, 1, operator_start)
                                            discard emit_v3_v(neutral_index_value, function_id, 2, 2, operator_start)
                                            discard emit_v3_v(neutral_result_value, function_id, 2, 1, operator_start)
                                            discard emit_v3_v(positive_index_value, function_id, 2, 2, operator_start)
                                            discard emit_v3_v(positive_result_value, function_id, 2, 1, operator_start)
                                            discard emit_v3_v(continuation_index_value, function_id, 2, 2, operator_start)
                                            discard emit_v3_v(continuation_load_value, function_id, 3, 1, operator_start)
                                            discard emit_v3_i_block(condition_index_id, function_id, 0, ordinal, 1, 1, 0, -1, 0)
                                            discard emit_v3_r(condition_index_id, 0, left_index_value)
                                            discard emit_v3_i_block(condition_load_id, function_id, 0, ordinal + 1, 15, 1, 1, storage_id, -1)
                                            discard emit_v3_o(condition_load_id, 0, left_index_value)
                                            discard emit_v3_r(condition_load_id, 0, left_load_value)
                                            discard emit_v3_i_block(condition_const_id, function_id, 0, ordinal + 2, 1, 1, 0, -1, parse_integer_literal(right_start, right_stop))
                                            discard emit_v3_r(condition_const_id, 0, right_value)
                                            discard emit_v3_i_block(compare_id, function_id, 0, ordinal + 3, 13, 1, 2, -1, -1)
                                            discard emit_v3_o(compare_id, 0, left_load_value)
                                            discard emit_v3_o(compare_id, 1, right_value)
                                            discard emit_v3_r(compare_id, 0, compare_value)
                                            discard emit_v3_i_block(branch_id, function_id, 0, ordinal + 4, 25, 0, 1, -1, -1)
                                            discard emit_v3_o(branch_id, 0, compare_value)
                                            discard emit_v3_t_branch(branch_id, 1, 2, 3, compare_value)
                                            discard emit_v3_i_block(negative_const_id, function_id, 1, 0, 1, 1, 0, -1, 0)
                                            discard emit_v3_r(negative_const_id, 0, negative_index_value)
                                            discard emit_v3_i_block(negative_value_id, function_id, 1, 1, 1, 1, 0, -1, relational_lane_result(operator_start, -1))
                                            discard emit_v3_r(negative_value_id, 0, negative_result_value)
                                            discard emit_v3_i_block(negative_store_id, function_id, 1, 2, 16, 0, 2, temporary_storage_id, -1)
                                            discard emit_v3_o(negative_store_id, 0, negative_index_value)
                                            discard emit_v3_o(negative_store_id, 1, negative_result_value)
                                            discard emit_v3_i_block(negative_jump_id, function_id, 1, 3, 24, 0, 0, -1, -1)
                                            discard emit_v3_t_jump(negative_jump_id, 4)
                                            discard emit_v3_i_block(neutral_const_id, function_id, 2, 0, 1, 1, 0, -1, 0)
                                            discard emit_v3_r(neutral_const_id, 0, neutral_index_value)
                                            discard emit_v3_i_block(neutral_value_id, function_id, 2, 1, 1, 1, 0, -1, relational_lane_result(operator_start, 0))
                                            discard emit_v3_r(neutral_value_id, 0, neutral_result_value)
                                            discard emit_v3_i_block(neutral_store_id, function_id, 2, 2, 16, 0, 2, temporary_storage_id, -1)
                                            discard emit_v3_o(neutral_store_id, 0, neutral_index_value)
                                            discard emit_v3_o(neutral_store_id, 1, neutral_result_value)
                                            discard emit_v3_i_block(neutral_jump_id, function_id, 2, 3, 24, 0, 0, -1, -1)
                                            discard emit_v3_t_jump(neutral_jump_id, 4)
                                            discard emit_v3_i_block(positive_const_id, function_id, 3, 0, 1, 1, 0, -1, 0)
                                            discard emit_v3_r(positive_const_id, 0, positive_index_value)
                                            discard emit_v3_i_block(positive_value_id, function_id, 3, 1, 1, 1, 0, -1, relational_lane_result(operator_start, 1))
                                            discard emit_v3_r(positive_value_id, 0, positive_result_value)
                                            discard emit_v3_i_block(positive_store_id, function_id, 3, 2, 16, 0, 2, temporary_storage_id, -1)
                                            discard emit_v3_o(positive_store_id, 0, positive_index_value)
                                            discard emit_v3_o(positive_store_id, 1, positive_result_value)
                                            discard emit_v3_i_block(positive_jump_id, function_id, 3, 3, 24, 0, 0, -1, -1)
                                            discard emit_v3_t_jump(positive_jump_id, 4)
                                            discard emit_v3_i_block(continuation_const_id, function_id, 4, 0, 1, 1, 0, -1, 0)
                                            discard emit_v3_r(continuation_const_id, 0, continuation_index_value)
                                            discard emit_v3_i_block(continuation_load_id, function_id, 4, 1, 15, 1, 1, temporary_storage_id, -1)
                                            discard emit_v3_o(continuation_load_id, 0, continuation_index_value)
                                            discard emit_v3_r(continuation_load_id, 0, continuation_load_value)
                                            discard emit_v3_i_block(return_id, function_id, 4, 2, 23, 0, 1, -1, -1)
                                            discard emit_v3_o(return_id, 0, continuation_load_value)
                                            discard emit_v3_t(return_id, continuation_load_value)
                                            discard emit_v3_b_block(function_id, 0, 0, ordinal + 5, branch_id)
                                            discard emit_v3_b_block(function_id, 1, 1, 4, negative_jump_id)
                                            discard emit_v3_b_block(function_id, 2, 2, 4, neutral_jump_id)
                                            discard emit_v3_b_block(function_id, 3, 3, 4, positive_jump_id)
                                            discard emit_v3_b_block(function_id, 4, 4, 3, return_id)
                                            return value_id + 12
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_compare_return_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, comparison_info: i64, value_id: i64) -> i64:
    match return_type == 1:
        -1:
            mut comparison_base: i64 = 1000000000000
            mut left_start: i64 = comparison_info / comparison_base
            mut remainder: i64 = comparison_info - left_start * comparison_base
            mut left_stop: i64 = remainder / 1000000
            mut right_start: i64 = remainder - left_stop * 1000000
            mut left_type: i64 = find_parameter_type(header_start, header_end, left_start, left_stop)
            match left_type > 0:
                -1:
                    # Parameter materialization is a separate v3 lane; keep
                    # this emitter closed until its F/D contract is present.
                    return -1
                0:
                    left_type = find_local_type(header_end + 1, first, left_start, left_stop)
                    match left_type > 0:
                        -1:
                            mut storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
                            match storage_id >= 0:
                                -1:
                                    mut right_cursor: i64 = right_start
                                    match read_byte(right_cursor) == 45:
                                        -1:
                                            right_cursor += 1
                                        0:
                                            discard 0
                                        1:
                                            discard 0
                                    match is_digit(read_byte(right_cursor)):
                                        -1:
                                            mut right_stop: i64 = number_end(right_cursor, stop)
                                            match skip_spaces(right_stop, stop) == stop:
                                                -1:
                                                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                                    mut index_id: i64 = function_id * 1000000 + ordinal
                                                    mut load_id: i64 = index_id + 1
                                                    mut const_id: i64 = index_id + 2
                                                    mut compare_id: i64 = index_id + 3
                                                    mut return_id: i64 = index_id + 4
                                                    mut left_index_value: i64 = value_id
                                                    mut left_load_value: i64 = value_id + 1
                                                    mut right_value: i64 = value_id + 2
                                                    mut compare_value: i64 = value_id + 3
                                                    mut operator_start: i64 = skip_spaces(left_stop, stop)
                                                    discard emit_v3_v(left_index_value, function_id, 2, 2, left_start)
                                                    discard emit_v3_v(left_load_value, function_id, 3, left_type, left_start)
                                                    discard emit_v3_v(right_value, function_id, 2, left_type, right_start)
                                                    discard emit_v3_v(compare_value, function_id, 3, 1, operator_start)
                                                    discard emit_v3_i_aux(index_id, function_id, ordinal, 1, 1, 0, -1, 0)
                                                    discard emit_v3_r(index_id, 0, left_index_value)
                                                    discard emit_v3_i_aux(load_id, function_id, ordinal + 1, 15, 1, 1, storage_id, -1)
                                                    discard emit_v3_o(load_id, 0, left_index_value)
                                                    discard emit_v3_r(load_id, 0, left_load_value)
                                                    discard emit_v3_i(const_id, function_id, ordinal + 2, 1, 1, 0, parse_integer_literal(right_start, right_stop))
                                                    discard emit_v3_r(const_id, 0, right_value)
                                                    discard emit_v3_i(compare_id, function_id, ordinal + 3, 13, 1, 2, -1)
                                                    discard emit_v3_o(compare_id, 0, left_load_value)
                                                    discard emit_v3_o(compare_id, 1, right_value)
                                                    discard emit_v3_r(compare_id, 0, compare_value)
                                                    discard emit_v3_i(return_id, function_id, ordinal + 4, 23, 0, 1, -1)
                                                    discard emit_v3_o(return_id, 0, compare_value)
                                                    discard emit_v3_t(return_id, compare_value)
                                                    return value_id + 4
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_identifier_return(mode: i64, function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, return_info: i64, value_id: i64) -> i64:
    mut target_info: i64 = 0 - return_info
    mut target_start: i64 = target_info / 1000000
    mut target_stop: i64 = target_info - target_start * 1000000
    mut target_type: i64 = find_parameter_type(header_start, header_end, target_start, target_stop)
    match target_type > 0:
        -1:
            match return_type_matches(target_type, return_type):
                -1:
                    match mode == 2:
                        -1:
                            mut parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, target_start, target_stop)
                            mut parameter_count: i64 = count_header_parameters(header_start, header_end)
                            match parameter_ordinal >= 0:
                                -1:
                                    match parameter_count > 0:
                                        -1:
                                            mut parameter_value_id: i64 = value_id - parameter_count + parameter_ordinal
                                            mut parameter_return_ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                            mut parameter_return_id: i64 = function_id * 1000000 + parameter_return_ordinal
                                            discard emit_v3_i(parameter_return_id, function_id, parameter_return_ordinal, 23, 0, 1, -1)
                                            discard emit_v3_o(parameter_return_id, 0, parameter_value_id)
                                            discard emit_v3_t(parameter_return_id, parameter_value_id)
                                            return value_id
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return value_id
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            target_type = find_local_type(header_end + 1, first, target_start, target_stop)
            match target_type > 0:
                -1:
                    match return_type_matches(target_type, return_type):
                        -1:
                            match mode == 1:
                                -1:
                                    discard emit_v(value_id, function_id, 3, target_type, target_start, 0, 0, -1)
                                    discard emit_v(value_id + 1, function_id, 4, target_type, target_start, 0, 0, -1)
                                    return value_id + 2
                                0:
                                    match mode == 2:
                                        -1:
                                            mut mutable_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, target_start, target_stop)
                                            match mutable_storage_id >= 0:
                                                -1:
                                                    mut loaded_next_id: i64 = scan_mutable_load_v3(function_id, header_end, first, target_start, target_stop, target_type, value_id)
                                                    match loaded_next_id >= 0:
                                                        -1:
                                                            mut mutable_ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                                            mut mutable_return_id: i64 = function_id * 1000000 + mutable_ordinal + 2
                                                            discard emit_v3_i(mutable_return_id, function_id, mutable_ordinal + 2, 23, 0, 1, -1)
                                                            discard emit_v3_o(mutable_return_id, 0, value_id + 1)
                                                            discard emit_v3_t(mutable_return_id, value_id + 1)
                                                            return loaded_next_id
                                                        0:
                                                            return -1
                                                        1:
                                                            return -1
                                                0:
                                                    mut target_value_id: i64 = find_core_local_value_id(header_end + 1, first, target_start, target_stop)
                                                    match target_value_id >= 0:
                                                        -1:
                                                            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                                            mut return_id: i64 = function_id * 1000000 + ordinal
                                                            discard emit_v3_i(return_id, function_id, ordinal, 23, 0, 1, -1)
                                                            discard emit_v3_o(return_id, 0, target_value_id)
                                                            discard emit_v3_t(return_id, target_value_id)
                                                            return value_id
                                                        0:
                                                            return -1
                                                        1:
                                                            return -1
                                                1:
                                                    return -1
                                        0:
                                            return value_id
                                        1:
                                            return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        1:
            return -1

fn scan_numeric_mut(mode: i64, function_id: i64, packed: i64, first: i64, value_id: i64) -> i64:
    match mode == 1:
        -1:
            mut parsed_type: i64 = packed / 1000000000000000
            mut remainder: i64 = packed - parsed_type * 1000000000000000
            mut name_start: i64 = remainder / 1000000000
            remainder = remainder - name_start * 1000000000
            mut name_length: i64 = remainder / 1000000
            mut literal_start: i64 = remainder - name_length * 1000000
            discard emit_v(value_id, function_id, 3, parsed_type, literal_start, 0, 0, -1)
            discard emit_m(function_id, name_start, parsed_type, 1, 1, first)
            discard emit_d(name_start, function_id, 2, parsed_type, name_start, name_length, 1, 2, name_start)
            return value_id + 1
        0:
            return value_id
        1:
            return value_id

fn scan_mut_additive(mode: i64, function_id: i64, packed: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut cursor: i64 = first_non_space(first, stop)
    mut word_stop: i64 = word_end(cursor, stop)
    cursor = skip_spaces(word_stop, stop)
    mut name_stop: i64 = word_end(cursor, stop)
    cursor = skip_spaces(name_stop, stop)
    cursor += 1
    cursor = skip_spaces(cursor, stop)
    mut type_stop: i64 = word_end(cursor, stop)
    cursor = skip_spaces(type_stop, stop)
    cursor += 1
    cursor = skip_spaces(cursor, stop)
    mut first_start: i64 = cursor
    mut first_stop: i64 = word_end(first_start, stop)
    cursor = skip_spaces(first_stop, stop)
    mut operator_start: i64 = cursor
    cursor += 1
    cursor = skip_spaces(cursor, stop)
    mut literal_start: i64 = cursor
    match mode == 1:
        -1:
            discard emit_v(value_id, function_id, 3, 2, first_start, 0, 0, -1)
            discard emit_v(value_id + 1, function_id, 4, 3, first_start, 0, 0, -1)
            discard emit_v(value_id + 2, function_id, 3, 3, literal_start, 0, 0, -1)
            discard emit_v(value_id + 3, function_id, 4, 3, operator_start, 0, 0, -1)
            discard emit_v(value_id + 4, function_id, 3, 2, first, 0, 0, -1)
            return value_id + 5
        0:
            return value_id + 5
        1:
            return -1

fn scan_mut_call(mode: i64, function_id: i64, header_start: i64, header_end: i64, first: i64, stop: i64, packed: i64, value_id: i64) -> i64:
    mut parsed_type: i64 = packed / 1000000
    mut call_start: i64 = packed - parsed_type * 1000000
    mut call_end: i64 = call_expression_end(call_start)
    mut call_next: i64 = scan_call_atom(mode, function_id, header_start, header_end, first, parsed_type, call_start, call_end, value_id)
    match call_next >= 0:
        -1:
            discard record_v(mode, call_next, function_id, 3, 2, first, 0, 0, -1)
            return call_next + 1
        0:
            return -1
        1:
            return -1

fn resolve_value_type(header_start: i64, header_end: i64, body_limit: i64, target_start: i64, target_stop: i64) -> i64:
    mut target_type: i64 = find_parameter_type(header_start, header_end, target_start, target_stop)
    match target_type > 0:
        -1:
            return target_type
        0:
            return find_local_type(header_end + 1, body_limit, target_start, target_stop)
        1:
            return 0

fn resolve_call_argument_value_id(header_start: i64, header_end: i64, body_limit: i64, argument_span: i64, expected_type: i64, parameter_base: i64, literal_value_id: i64) -> i64:
    mut argument_start: i64 = argument_span / 1000000
    mut argument_stop: i64 = argument_span - argument_start * 1000000
    match call_argument_is_literal(argument_span):
        -1:
            return literal_value_id
        0:
            mut argument_type: i64 = resolve_value_type(header_start, header_end, body_limit, argument_start, argument_stop)
            match argument_type == expected_type:
                -1:
                    mut parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, argument_start, argument_stop)
                    match parameter_ordinal >= 0:
                        -1:
                            return parameter_base + parameter_ordinal
                        0:
                            mut local_value_id: i64 = find_core_local_value_id(header_end + 1, body_limit, argument_start, argument_stop)
                            match local_value_id >= 0:
                                -1:
                                    return parameter_base + local_value_id
                                0:
                                    return -1
                                1:
                                    return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        1:
            return -1

fn parse_while_constant(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 113101617, 5):
        -1:
            cursor = skip_spaces(word_stop, end)
            mut literal_start: i64 = cursor
            match read_byte(cursor) == 45:
                -1:
                    cursor += 1
                0:
                    discard 0
                1:
                    discard 0
            match is_digit(read_byte(cursor)):
                -1:
                    mut literal_stop: i64 = number_end(cursor, end)
                    cursor = skip_spaces(literal_stop, end)
                    match expect_byte(cursor, end, 58):
                        -1:
                            cursor += 1
                            cursor = skip_spaces(cursor, end)
                            match cursor == end:
                                -1:
                                    mut literal_value: i64 = parse_integer_literal(literal_start, literal_stop)
                                    match literal_value == 0:
                                        -1:
                                            return literal_start + 1
                                        0:
                                            match literal_value == 1:
                                                -1:
                                                    return literal_start + 1
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn while_body_end(start: i64, end: i64) -> i64:
    mut line_start: i64 = source_line_start(start)
    mut parent_indent: i64 = start - line_start
    mut cursor: i64 = line_end(line_start, end) + 1
    while cursor < end:
        mut stop: i64 = line_end(cursor, end)
        mut first: i64 = first_non_space(cursor, stop)
        match first == stop:
            -1:
                cursor = stop + 1
            0:
                match first - cursor > parent_indent:
                    -1:
                        cursor = stop + 1
                    0:
                        return cursor
                    1:
                        cursor = stop + 1
            1:
                return cursor
    return cursor

fn while_body_is_break(start: i64, end: i64) -> trit:
    mut line_start: i64 = source_line_start(start)
    mut parent_indent: i64 = start - line_start
    mut cursor: i64 = line_end(line_start, end) + 1
    mut found: trit = 0
    while cursor < end:
        mut stop: i64 = line_end(cursor, end)
        mut first: i64 = first_non_space(cursor, stop)
        match first == stop:
            -1:
                cursor = stop + 1
            0:
                match first - cursor > parent_indent:
                    -1:
                        return found
                    0:
                        return found
                    1:
                        match parse_break_statement(first, stop) > 0:
                            -1:
                                found = -1
                            0:
                                return 0
                            1:
                                return 0
                        cursor = stop + 1
            1:
                return found
    return found

fn scan_while_truthy_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut condition_start: i64 = while_left_start(first, stop)
    mut condition_cursor: i64 = condition_start
    match read_byte(condition_cursor) == 45:
        -1:
            condition_cursor += 1
        0:
            discard 0
        1:
            discard 0
    mut condition_literal: trit = 0
    mut condition_stop: i64 = word_end(condition_start, stop)
    match is_digit(read_byte(condition_cursor)):
        -1:
            condition_literal = -1
            condition_stop = number_end(condition_cursor, stop)
        0:
            discard 0
        1:
            discard 0
    mut condition_type: i64 = 1
    mut storage_id: i64 = -1
    match condition_literal == -1:
        -1:
            match parse_integer_literal(condition_start, condition_stop) == -1:
                -1:
                    discard 0
                0:
                    return -1
                1:
                    return -1
        0:
            condition_type = find_local_type(header_end + 1, first, condition_start, word_end(condition_start, stop))
            match condition_type == 1:
                -1:
                    storage_id = find_mutable_storage_id(header_end + 1, first, condition_start, word_end(condition_start, stop))
                    match storage_id >= 0:
                        -1:
                            discard 0
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        1:
            return -1
    match while_body_is_break(first, s3_stage1_source_length()):
        -1:
            mut after_body: i64 = while_body_end(first, s3_stage1_source_length())
            mut return_stop: i64 = line_end(after_body, s3_stage1_source_length())
            mut return_first: i64 = first_non_space(after_body, return_stop)
            mut return_info: i64 = parse_return(return_first, return_stop)
            match return_info > 0:
                -1:
                    mut return_kind: i64 = return_info / 1000000000000000
                    match return_kind == 0:
                        -1:
                            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                            mut base_id: i64 = function_id * 1000000 + ordinal
                            mut entry_jump_id: i64 = base_id
                            mut condition_id: i64 = base_id + 1
                            mut branch_id: i64 = base_id + 2
                            mut body_jump_id: i64 = base_id + 3
                            mut exit_zero_jump_id: i64 = base_id + 4
                            mut exit_positive_jump_id: i64 = base_id + 5
                            mut final_const_id: i64 = base_id + 6
                            mut final_return_id: i64 = base_id + 7
                            mut condition_value_id: i64 = value_id
                            mut next_value_id: i64 = value_id
                            mut condition_instruction_count: i64 = 2
                            discard emit_v3_i_block(entry_jump_id, function_id, 0, ordinal, 24, 0, 0, -1, -1)
                            discard emit_v3_t_jump(entry_jump_id, 1)
                            match condition_literal == -1:
                                -1:
                                    discard emit_v3_v(condition_value_id, function_id, 2, 1, condition_start)
                                    discard emit_v3_i_block(condition_id, function_id, 1, ordinal + 1, 1, 1, 0, -1, -1)
                                    discard emit_v3_r(condition_id, 0, condition_value_id)
                                    next_value_id += 1
                                0:
                                    mut index_value_id: i64 = next_value_id
                                    mut load_value_id: i64 = next_value_id + 1
                                    condition_value_id = load_value_id
                                    condition_instruction_count = 3
                                    discard emit_v3_v(index_value_id, function_id, 2, 2, condition_start)
                                    discard emit_v3_v(load_value_id, function_id, 3, 1, condition_start)
                                    discard emit_v3_i_block(condition_id, function_id, 1, ordinal + 1, 1, 1, 0, -1, 0)
                                    discard emit_v3_r(condition_id, 0, index_value_id)
                                    discard emit_v3_i_block(condition_id + 1, function_id, 1, ordinal + 2, 15, 1, 1, storage_id, -1)
                                    discard emit_v3_o(condition_id + 1, 0, index_value_id)
                                    discard emit_v3_r(condition_id + 1, 0, load_value_id)
                                    branch_id = base_id + 3
                                    next_value_id += 2
                                1:
                                    return -1
                            discard emit_v3_i_block(branch_id, function_id, 1, ordinal + condition_instruction_count + 1, 25, 0, 1, -1, -1)
                            discard emit_v3_o(branch_id, 0, condition_value_id)
                            discard emit_v3_t_branch(branch_id, 2, 3, 4, condition_value_id)
                            mut actual_body_jump_id: i64 = base_id + condition_instruction_count + 1
                            mut actual_exit_zero_jump_id: i64 = actual_body_jump_id + 1
                            mut actual_exit_positive_jump_id: i64 = actual_body_jump_id + 2
                            mut actual_final_const_id: i64 = actual_body_jump_id + 3
                            mut actual_final_return_id: i64 = actual_body_jump_id + 4
                            discard emit_v3_i_block(actual_body_jump_id, function_id, 2, ordinal + condition_instruction_count + 2, 24, 0, 0, -1, -1)
                            discard emit_v3_t_jump(actual_body_jump_id, 5)
                            discard emit_v3_i_block(actual_exit_zero_jump_id, function_id, 3, ordinal + condition_instruction_count + 3, 24, 0, 0, -1, -1)
                            discard emit_v3_t_jump(actual_exit_zero_jump_id, 5)
                            discard emit_v3_i_block(actual_exit_positive_jump_id, function_id, 4, ordinal + condition_instruction_count + 4, 24, 0, 0, -1, -1)
                            discard emit_v3_t_jump(actual_exit_positive_jump_id, 5)
                            mut final_start: i64 = return_info / 1000000
                            mut final_stop: i64 = return_info - final_start * 1000000
                            mut final_value_id: i64 = next_value_id
                            mut final_instruction_count: i64 = 2
                            match return_type > 0:
                                -1:
                                    discard emit_v3_v(final_value_id, function_id, 2, return_type, final_start)
                                    discard emit_v3_i_block(actual_final_const_id, function_id, 5, ordinal + condition_instruction_count + 5, 1, 1, 0, -1, parse_integer_literal(final_start, final_stop))
                                    discard emit_v3_r(actual_final_const_id, 0, final_value_id)
                                0:
                                    return -1
                                1:
                                    return -1
                            discard emit_v3_i_block(actual_final_return_id, function_id, 5, ordinal + condition_instruction_count + 6, 23, 0, 1, -1, -1)
                            discard emit_v3_o(actual_final_return_id, 0, final_value_id)
                            discard emit_v3_t(actual_final_return_id, final_value_id)
                            discard emit_v3_b_block(function_id, 0, 0, ordinal + 1, entry_jump_id)
                            discard emit_v3_b_block(function_id, 1, 1, condition_instruction_count + 1, branch_id)
                            discard emit_v3_b_block(function_id, 2, 2, 1, actual_body_jump_id)
                            discard emit_v3_b_block(function_id, 3, 3, 1, actual_exit_zero_jump_id)
                            discard emit_v3_b_block(function_id, 4, 4, 1, actual_exit_positive_jump_id)
                            discard emit_v3_b_block(function_id, 5, 5, final_instruction_count, actual_final_return_id)
                            mut encoded_next_id: i64 = next_value_id + 1
                            encoded_next_id = encoded_next_id * 1000000
                            encoded_next_id = encoded_next_id + return_stop + 2000000000000
                            return encoded_next_id
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_while_relation_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut left_start: i64 = while_left_start(first, stop)
    mut left_stop: i64 = while_left_stop(first, stop)
    mut operator_start: i64 = while_operator_start(first, stop)
    mut operator_length: i64 = comparison_operator_length(operator_start, stop)
    match operator_length > 0:
        -1:
            discard 0
        0:
            return -1
        1:
            return -1
    mut right_start: i64 = skip_spaces(operator_start + operator_length, stop)
    mut right_cursor: i64 = right_start
    match read_byte(right_cursor) == 45:
        -1:
            right_cursor += 1
        0:
            discard 0
        1:
            discard 0
    mut right_stop: i64 = number_end(right_cursor, stop)
    match is_digit(read_byte(right_cursor)):
        -1:
            match skip_spaces(right_stop, stop) == stop:
                -1:
                    discard 0
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1
    mut left_type: i64 = resolve_value_type(header_start, header_end, first, left_start, left_stop)
    match left_type > 0:
        -1:
            match return_type == left_type:
                -1:
                    mut storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
                    match storage_id >= 0:
                        -1:
                            mut body_start: i64 = line_end(source_line_start(first), s3_stage1_source_length()) + 1
                            mut body_stop: i64 = line_end(body_start, s3_stage1_source_length())
                            mut body_first: i64 = first_non_space(body_start, body_stop)
                            mut assignment_info: i64 = parse_assignment_expression_bounds(body_first, body_stop)
                            match assignment_info > 0:
                                -1:
                                    mut target_start: i64 = body_first
                                    mut target_stop: i64 = word_end(target_start, body_stop)
                                    mut expression_start: i64 = assignment_info / 1000000
                                    mut expression_end: i64 = assignment_info - expression_start * 1000000
                                    mut additive_info: i64 = find_additive_operator(expression_start, expression_end)
                                    match additive_info > 0:
                                        -1:
                                            mut additive_operator: i64 = additive_info / 10
                                            mut body_left_end: i64 = trim_expression_end(expression_start, additive_operator)
                                            mut body_left_start: i64 = first_non_space(expression_start, body_left_end)
                                            mut body_left_stop: i64 = word_end(body_left_start, body_left_end)
                                            mut body_right_start: i64 = skip_spaces(additive_operator + 1, expression_end)
                                            mut body_right_stop: i64 = binary_right_operand_stop(body_right_start, expression_end)
                                            match same_span(target_start, target_stop, left_start, left_stop):
                                                -1:
                                                    match same_span(body_left_start, body_left_stop, left_start, left_stop):
                                                        -1:
                                                            match body_right_stop > 0:
                                                                -1:
                                                                    match parse_literal_expression(body_right_start, body_right_stop) > 0:
                                                                        -1:
                                                                            match skip_spaces(body_right_stop, expression_end) == expression_end:
                                                                                -1:
                                                                                    mut after_body: i64 = while_body_end(first, s3_stage1_source_length())
                                                                                    mut return_stop: i64 = line_end(after_body, s3_stage1_source_length())
                                                                                    mut return_first: i64 = first_non_space(after_body, return_stop)
                                                                                    mut return_info: i64 = parse_return(return_first, return_stop)
                                                                                    match return_info < 0:
                                                                                        -1:
                                                                                            mut return_target_info: i64 = 0 - return_info
                                                                                            mut return_start: i64 = return_target_info / 1000000
                                                                                            mut return_target_stop: i64 = return_target_info - return_start * 1000000
                                                                                            match same_span(return_start, return_target_stop, left_start, left_stop):
                                                                                                -1:
                                                                                                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                                                                                    mut base_id: i64 = function_id * 1000000 + ordinal
                                                                                                    mut entry_jump_id: i64 = base_id
                                                                                                    mut condition_index_id: i64 = base_id + 1
                                                                                                    mut condition_load_id: i64 = base_id + 2
                                                                                                    mut condition_const_id: i64 = base_id + 3
                                                                                                    mut compare_id: i64 = base_id + 4
                                                                                                    mut condition_branch_id: i64 = base_id + 5
                                                                                                    mut body_index_id: i64 = base_id + 6
                                                                                                    mut body_load_id: i64 = base_id + 7
                                                                                                    mut body_const_id: i64 = base_id + 8
                                                                                                    mut add_id: i64 = base_id + 9
                                                                                                    mut store_index_id: i64 = base_id + 10
                                                                                                    mut store_id: i64 = base_id + 11
                                                                                                    mut body_jump_id: i64 = base_id + 12
                                                                                                    mut exit_zero_jump_id: i64 = base_id + 13
                                                                                                    mut exit_positive_jump_id: i64 = base_id + 14
                                                                                                    mut final_const_id: i64 = base_id + 15
                                                                                                    mut final_load_id: i64 = base_id + 16
                                                                                                    mut final_return_id: i64 = base_id + 17
                                                                                                    mut negative_const_id: i64 = base_id + 18
                                                                                                    mut negative_value_id: i64 = base_id + 19
                                                                                                    mut negative_store_id: i64 = base_id + 20
                                                                                                    mut negative_jump_id: i64 = base_id + 21
                                                                                                    mut neutral_const_id: i64 = base_id + 22
                                                                                                    mut neutral_value_id: i64 = base_id + 23
                                                                                                    mut neutral_store_id: i64 = base_id + 24
                                                                                                    mut neutral_jump_id: i64 = base_id + 25
                                                                                                    mut positive_const_id: i64 = base_id + 26
                                                                                                    mut positive_value_id: i64 = base_id + 27
                                                                                                    mut positive_store_id: i64 = base_id + 28
                                                                                                    mut positive_jump_id: i64 = base_id + 29
                                                                                                    mut continuation_const_id: i64 = base_id + 30
                                                                                                    mut continuation_load_id: i64 = base_id + 31
                                                                                                    mut continuation_branch_id: i64 = base_id + 32
                                                                                                    mut condition_index_value: i64 = value_id
                                                                                                    mut condition_load_value: i64 = value_id + 1
                                                                                                    mut condition_const_value: i64 = value_id + 2
                                                                                                    mut compare_value: i64 = value_id + 3
                                                                                                    mut body_index_value: i64 = value_id + 4
                                                                                                    mut body_load_value: i64 = value_id + 5
                                                                                                    mut body_const_value: i64 = value_id + 6
                                                                                                    mut add_value: i64 = value_id + 7
                                                                                                    mut store_index_value: i64 = value_id + 8
                                                                                                    mut final_index_value: i64 = value_id + 9
                                                                                                    mut final_load_value: i64 = value_id + 10
                                                                                                    mut negative_index_value: i64 = value_id + 11
                                                                                                    mut negative_result_value: i64 = value_id + 12
                                                                                                    mut neutral_index_value: i64 = value_id + 13
                                                                                                    mut neutral_result_value: i64 = value_id + 14
                                                                                                    mut positive_index_value: i64 = value_id + 15
                                                                                                    mut positive_result_value: i64 = value_id + 16
                                                                                                    mut continuation_index_value: i64 = value_id + 17
                                                                                                    mut continuation_load_value: i64 = value_id + 18
                                                                                                    mut temporary_storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
                                                                                                    discard emit_v3_m(function_id, temporary_storage_id, 1, 1, 1, operator_start)
                                                                                                    discard emit_v3_v(condition_index_value, function_id, 2, 2, left_start)
                                                                                                    discard emit_v3_v(condition_load_value, function_id, 3, left_type, left_start)
                                                                                                    discard emit_v3_v(condition_const_value, function_id, 2, left_type, right_start)
                                                                                                    discard emit_v3_v(compare_value, function_id, 3, 1, operator_start)
                                                                                                    discard emit_v3_v(body_index_value, function_id, 2, 2, target_start)
                                                                                                    discard emit_v3_v(body_load_value, function_id, 3, left_type, target_start)
                                                                                                    discard emit_v3_v(body_const_value, function_id, 2, left_type, body_right_start)
                                                                                                    discard emit_v3_v(add_value, function_id, 3, left_type, additive_operator)
                                                                                                    discard emit_v3_v(store_index_value, function_id, 2, 2, target_start)
                                                                                                    discard emit_v3_v(final_index_value, function_id, 2, 2, return_start)
                                                                                                    discard emit_v3_v(final_load_value, function_id, 3, left_type, return_start)
                                                                                                    discard emit_v3_v(negative_index_value, function_id, 2, 2, operator_start)
                                                                                                    discard emit_v3_v(negative_result_value, function_id, 2, 1, operator_start)
                                                                                                    discard emit_v3_v(neutral_index_value, function_id, 2, 2, operator_start)
                                                                                                    discard emit_v3_v(neutral_result_value, function_id, 2, 1, operator_start)
                                                                                                    discard emit_v3_v(positive_index_value, function_id, 2, 2, operator_start)
                                                                                                    discard emit_v3_v(positive_result_value, function_id, 2, 1, operator_start)
                                                                                                    discard emit_v3_v(continuation_index_value, function_id, 2, 2, operator_start)
                                                                                                    discard emit_v3_v(continuation_load_value, function_id, 3, 1, operator_start)
                                                                                                    discard emit_v3_i_block(entry_jump_id, function_id, 0, ordinal, 24, 0, 0, -1, -1)
                                                                                                    discard emit_v3_t_jump(entry_jump_id, 1)
                                                                                                    discard emit_v3_i_block(condition_index_id, function_id, 1, ordinal + 1, 1, 1, 0, -1, 0)
                                                                                                    discard emit_v3_r(condition_index_id, 0, condition_index_value)
                                                                                                    discard emit_v3_i_block(condition_load_id, function_id, 1, ordinal + 2, 15, 1, 1, storage_id, -1)
                                                                                                    discard emit_v3_o(condition_load_id, 0, condition_index_value)
                                                                                                    discard emit_v3_r(condition_load_id, 0, condition_load_value)
                                                                                                    discard emit_v3_i_block(condition_const_id, function_id, 1, ordinal + 3, 1, 1, 0, -1, parse_integer_literal(right_start, right_stop))
                                                                                                    discard emit_v3_r(condition_const_id, 0, condition_const_value)
                                                                                                    discard emit_v3_i_block(compare_id, function_id, 1, ordinal + 4, 13, 1, 2, -1, -1)
                                                                                                    discard emit_v3_o(compare_id, 0, condition_load_value)
                                                                                                    discard emit_v3_o(compare_id, 1, condition_const_value)
                                                                                                    discard emit_v3_r(compare_id, 0, compare_value)
                                                                                                    discard emit_v3_i_block(condition_branch_id, function_id, 1, ordinal + 5, 25, 0, 1, -1, -1)
                                                                                                    discard emit_v3_o(condition_branch_id, 0, compare_value)
                                                                                                    discard emit_v3_t_branch(condition_branch_id, 6, 7, 8, compare_value)
                                                                                                    discard emit_v3_i_block(body_index_id, function_id, 2, ordinal + 6, 1, 1, 0, -1, 0)
                                                                                                    discard emit_v3_r(body_index_id, 0, body_index_value)
                                                                                                    discard emit_v3_i_block(body_load_id, function_id, 2, ordinal + 7, 15, 1, 1, storage_id, -1)
                                                                                                    discard emit_v3_o(body_load_id, 0, body_index_value)
                                                                                                    discard emit_v3_r(body_load_id, 0, body_load_value)
                                                                                                    discard emit_v3_i_block(body_const_id, function_id, 2, ordinal + 8, 1, 1, 0, -1, parse_integer_literal(body_right_start, body_right_stop))
                                                                                                    discard emit_v3_r(body_const_id, 0, body_const_value)
                                                                                                    discard emit_v3_i_block(add_id, function_id, 2, ordinal + 9, 5, 1, 2, -1, -1)
                                                                                                    discard emit_v3_o(add_id, 0, body_load_value)
                                                                                                    discard emit_v3_o(add_id, 1, body_const_value)
                                                                                                    discard emit_v3_r(add_id, 0, add_value)
                                                                                                    discard emit_v3_i_block(store_index_id, function_id, 2, ordinal + 10, 1, 1, 0, -1, 0)
                                                                                                    discard emit_v3_r(store_index_id, 0, store_index_value)
                                                                                                    discard emit_v3_i_block(store_id, function_id, 2, ordinal + 11, 16, 0, 2, storage_id, -1)
                                                                                                    discard emit_v3_o(store_id, 0, store_index_value)
                                                                                                    discard emit_v3_o(store_id, 1, add_value)
                                                                                                    discard emit_v3_i_block(body_jump_id, function_id, 2, ordinal + 12, 24, 0, 0, -1, -1)
                                                                                                    discard emit_v3_t_jump(body_jump_id, 1)
                                                                                                    discard emit_v3_i_block(exit_zero_jump_id, function_id, 3, ordinal + 13, 24, 0, 0, -1, -1)
                                                                                                    discard emit_v3_t_jump(exit_zero_jump_id, 5)
                                                                                                    discard emit_v3_i_block(exit_positive_jump_id, function_id, 4, ordinal + 14, 24, 0, 0, -1, -1)
                                                                                                    discard emit_v3_t_jump(exit_positive_jump_id, 5)
                                                                                                    discard emit_v3_i_block(final_const_id, function_id, 5, ordinal + 15, 1, 1, 0, -1, 0)
                                                                                                    discard emit_v3_r(final_const_id, 0, final_index_value)
                                                                                                    discard emit_v3_i_block(final_load_id, function_id, 5, ordinal + 16, 15, 1, 1, storage_id, -1)
                                                                                                    discard emit_v3_o(final_load_id, 0, final_index_value)
                                                                                                    discard emit_v3_r(final_load_id, 0, final_load_value)
                                                                                                    discard emit_v3_i_block(final_return_id, function_id, 5, ordinal + 17, 23, 0, 1, -1, -1)
                                                                                                    discard emit_v3_o(final_return_id, 0, final_load_value)
                                                                                                    discard emit_v3_t(final_return_id, final_load_value)
                                                                                                    discard emit_v3_i_block(negative_const_id, function_id, 6, ordinal + 18, 1, 1, 0, -1, 0)
                                                                                                    discard emit_v3_r(negative_const_id, 0, negative_index_value)
                                                                                                    discard emit_v3_i_block(negative_value_id, function_id, 6, ordinal + 19, 1, 1, 0, -1, relational_lane_result(operator_start, -1))
                                                                                                    discard emit_v3_r(negative_value_id, 0, negative_result_value)
                                                                                                    discard emit_v3_i_block(negative_store_id, function_id, 6, ordinal + 20, 16, 0, 2, temporary_storage_id, -1)
                                                                                                    discard emit_v3_o(negative_store_id, 0, negative_index_value)
                                                                                                    discard emit_v3_o(negative_store_id, 1, negative_result_value)
                                                                                                    discard emit_v3_i_block(negative_jump_id, function_id, 6, ordinal + 21, 24, 0, 0, -1, -1)
                                                                                                    discard emit_v3_t_jump(negative_jump_id, 9)
                                                                                                    discard emit_v3_i_block(neutral_const_id, function_id, 7, ordinal + 22, 1, 1, 0, -1, 0)
                                                                                                    discard emit_v3_r(neutral_const_id, 0, neutral_index_value)
                                                                                                    discard emit_v3_i_block(neutral_value_id, function_id, 7, ordinal + 23, 1, 1, 0, -1, relational_lane_result(operator_start, 0))
                                                                                                    discard emit_v3_r(neutral_value_id, 0, neutral_result_value)
                                                                                                    discard emit_v3_i_block(neutral_store_id, function_id, 7, ordinal + 24, 16, 0, 2, temporary_storage_id, -1)
                                                                                                    discard emit_v3_o(neutral_store_id, 0, neutral_index_value)
                                                                                                    discard emit_v3_o(neutral_store_id, 1, neutral_result_value)
                                                                                                    discard emit_v3_i_block(neutral_jump_id, function_id, 7, ordinal + 25, 24, 0, 0, -1, -1)
                                                                                                    discard emit_v3_t_jump(neutral_jump_id, 9)
                                                                                                    discard emit_v3_i_block(positive_const_id, function_id, 8, ordinal + 26, 1, 1, 0, -1, 0)
                                                                                                    discard emit_v3_r(positive_const_id, 0, positive_index_value)
                                                                                                    discard emit_v3_i_block(positive_value_id, function_id, 8, ordinal + 27, 1, 1, 0, -1, relational_lane_result(operator_start, 1))
                                                                                                    discard emit_v3_r(positive_value_id, 0, positive_result_value)
                                                                                                    discard emit_v3_i_block(positive_store_id, function_id, 8, ordinal + 28, 16, 0, 2, temporary_storage_id, -1)
                                                                                                    discard emit_v3_o(positive_store_id, 0, positive_index_value)
                                                                                                    discard emit_v3_o(positive_store_id, 1, positive_result_value)
                                                                                                    discard emit_v3_i_block(positive_jump_id, function_id, 8, ordinal + 29, 24, 0, 0, -1, -1)
                                                                                                    discard emit_v3_t_jump(positive_jump_id, 9)
                                                                                                    discard emit_v3_i_block(continuation_const_id, function_id, 9, ordinal + 30, 1, 1, 0, -1, 0)
                                                                                                    discard emit_v3_r(continuation_const_id, 0, continuation_index_value)
                                                                                                    discard emit_v3_i_block(continuation_load_id, function_id, 9, ordinal + 31, 15, 1, 1, temporary_storage_id, -1)
                                                                                                    discard emit_v3_o(continuation_load_id, 0, continuation_index_value)
                                                                                                    discard emit_v3_r(continuation_load_id, 0, continuation_load_value)
                                                                                                    discard emit_v3_i_block(continuation_branch_id, function_id, 9, ordinal + 32, 25, 0, 1, -1, -1)
                                                                                                    discard emit_v3_o(continuation_branch_id, 0, continuation_load_value)
                                                                                                    discard emit_v3_t_branch(continuation_branch_id, 2, 3, 4, continuation_load_value)
                                                                                                    discard emit_v3_b_block(function_id, 0, 0, ordinal + 1, entry_jump_id)
                                                                                                    discard emit_v3_b_block(function_id, 1, 1, 5, condition_branch_id)
                                                                                                    discard emit_v3_b_block(function_id, 2, 2, 7, body_jump_id)
                                                                                                    discard emit_v3_b_block(function_id, 3, 3, 1, exit_zero_jump_id)
                                                                                                    discard emit_v3_b_block(function_id, 4, 4, 1, exit_positive_jump_id)
                                                                                                    discard emit_v3_b_block(function_id, 5, 5, 3, final_return_id)
                                                                                                    discard emit_v3_b_block(function_id, 6, 6, 4, negative_jump_id)
                                                                                                    discard emit_v3_b_block(function_id, 7, 7, 4, neutral_jump_id)
                                                                                                    discard emit_v3_b_block(function_id, 8, 8, 4, positive_jump_id)
                                                                                                    discard emit_v3_b_block(function_id, 9, 9, 3, continuation_branch_id)
                                                                                                    mut encoded_next_id: i64 = value_id + 19
                                                                                                    encoded_next_id = encoded_next_id * 1000000
                                                                                                    encoded_next_id = encoded_next_id + return_stop + 2000000000000
                                                                                                    return encoded_next_id
                                                                                                0:
                                                                                                    return -1
                                                                                                1:
                                                                                                    return -1
                                                                                        0:
                                                                                            return -1
                                                                                        1:
                                                                                            return -1
                                                                                0:
                                                                                    return -1
                                                                                1:
                                                                                    return -1
                                                                        0:
                                                                            return -1
                                                                        1:
                                                                            return -1
                                                                0:
                                                                    return -1
                                                                1:
                                                                    return -1
                                                        0:
                                                            return -1
                                                        1:
                                                            return -1
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn lowering_result_kind(result: i64) -> i64:
    # Shared continuation protocol: 0 is a plain next value, 1 is a
    # cursor/value continuation, 2 is a terminal continuation, and 3 carries
    # an explicit successor block together with the next value and cursor.
    match result >= 3000000000000:
        -1:
            return 3
        0:
            match result >= 2000000000000:
                -1:
                    return 2
                0:
                    match result >= 1000000000000:
                        -1:
                            return 1
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 0
        1:
            return 0

fn lowering_result_payload(result: i64, kind: i64) -> i64:
    match kind == 3:
        -1:
            return result - 3000000000000
        0:
            match kind == 2:
                -1:
                    return result - 2000000000000
                0:
                    match kind == 1:
                        -1:
                            return result - 1000000000000
                        0:
                            return result
                        1:
                            return result
                1:
                    return result
        1:
            return result

fn lowering_result_next_block(result: i64) -> i64:
    mut kind: i64 = lowering_result_kind(result)
    match kind == 3:
        -1:
            mut payload: i64 = lowering_result_payload(result, kind)
            return payload / 100000000000
        0:
            return -1
        1:
            return -1

fn lowering_result_next_id(result: i64) -> i64:
    mut kind: i64 = lowering_result_kind(result)
    mut payload: i64 = lowering_result_payload(result, kind)
    match kind == 3:
        -1:
            mut block: i64 = payload / 100000000000
            payload = payload - block * 100000000000
        0:
            discard 0
        1:
            discard 0
    match kind > 0:
        -1:
            return payload / 1000000
        0:
            return result
        1:
            return result

fn lowering_result_next_cursor(result: i64) -> i64:
    mut kind: i64 = lowering_result_kind(result)
    mut payload: i64 = lowering_result_payload(result, kind)
    mut next_id: i64 = lowering_result_next_id(result)
    match kind == 3:
        -1:
            mut block: i64 = payload / 100000000000
            payload = payload - block * 100000000000
        0:
            discard 0
        1:
            discard 0
    match kind > 0:
        -1:
            return payload - next_id * 1000000
        0:
            return result
        1:
            return result

fn match_call_lane_result(lane: i64) -> i64:
    match lane < 0:
        -1:
            return -1
        0:
            return 0
        1:
            return 0

fn emit_v3_relation_lane_group(function_id: i64, operator_start: i64, temporary_storage_id: i64, first_instruction_id: i64, first_ordinal: i64, first_block_id: i64, continuation_block_id: i64, negative_index_value: i64, negative_result_value: i64, neutral_index_value: i64, neutral_result_value: i64, positive_index_value: i64, positive_result_value: i64, call_mode: i64) -> trit:
    mut negative_const_id: i64 = first_instruction_id
    mut negative_store_id: i64 = first_instruction_id + 1
    mut negative_jump_id: i64 = first_instruction_id + 2
    mut negative_terminator_id: i64 = first_instruction_id + 3
    mut neutral_const_id: i64 = first_instruction_id + 4
    mut neutral_store_id: i64 = first_instruction_id + 5
    mut neutral_jump_id: i64 = first_instruction_id + 6
    mut neutral_terminator_id: i64 = first_instruction_id + 7
    mut positive_const_id: i64 = first_instruction_id + 8
    mut positive_store_id: i64 = first_instruction_id + 9
    mut positive_jump_id: i64 = first_instruction_id + 10
    mut positive_terminator_id: i64 = first_instruction_id + 11
    discard emit_v3_i_block(negative_const_id, function_id, first_block_id, first_ordinal, 1, 1, 0, -1, 0)
    discard emit_v3_r(negative_const_id, 0, negative_index_value)
    mut negative_lane_result: i64 = relational_lane_result(operator_start, -1)
    mut neutral_lane_result: i64 = relational_lane_result(operator_start, 0)
    mut positive_lane_result: i64 = relational_lane_result(operator_start, 1)
    match call_mode == 1:
        -1:
            negative_lane_result = match_call_lane_result(-1)
            neutral_lane_result = match_call_lane_result(0)
            positive_lane_result = match_call_lane_result(1)
        0:
            discard 0
        1:
            discard 0
    discard emit_v3_i_block(negative_store_id, function_id, first_block_id, first_ordinal + 1, 1, 1, 0, -1, negative_lane_result)
    discard emit_v3_r(negative_store_id, 0, negative_result_value)
    discard emit_v3_i_block(negative_jump_id, function_id, first_block_id, first_ordinal + 2, 16, 0, 2, temporary_storage_id, -1)
    discard emit_v3_o(negative_jump_id, 0, negative_index_value)
    discard emit_v3_o(negative_jump_id, 1, negative_result_value)
    discard emit_v3_i_block(negative_terminator_id, function_id, first_block_id, first_ordinal + 3, 24, 0, 0, -1, -1)
    discard emit_v3_t_jump(negative_terminator_id, continuation_block_id)
    discard emit_v3_i_block(neutral_const_id, function_id, first_block_id + 1, first_ordinal + 4, 1, 1, 0, -1, 0)
    discard emit_v3_r(neutral_const_id, 0, neutral_index_value)
    discard emit_v3_i_block(neutral_store_id, function_id, first_block_id + 1, first_ordinal + 5, 1, 1, 0, -1, neutral_lane_result)
    discard emit_v3_r(neutral_store_id, 0, neutral_result_value)
    discard emit_v3_i_block(neutral_jump_id, function_id, first_block_id + 1, first_ordinal + 6, 16, 0, 2, temporary_storage_id, -1)
    discard emit_v3_o(neutral_jump_id, 0, neutral_index_value)
    discard emit_v3_o(neutral_jump_id, 1, neutral_result_value)
    discard emit_v3_i_block(neutral_terminator_id, function_id, first_block_id + 1, first_ordinal + 7, 24, 0, 0, -1, -1)
    discard emit_v3_t_jump(neutral_terminator_id, continuation_block_id)
    discard emit_v3_i_block(positive_const_id, function_id, first_block_id + 2, first_ordinal + 8, 1, 1, 0, -1, 0)
    discard emit_v3_r(positive_const_id, 0, positive_index_value)
    discard emit_v3_i_block(positive_store_id, function_id, first_block_id + 2, first_ordinal + 9, 1, 1, 0, -1, positive_lane_result)
    discard emit_v3_r(positive_store_id, 0, positive_result_value)
    discard emit_v3_i_block(positive_jump_id, function_id, first_block_id + 2, first_ordinal + 10, 16, 0, 2, temporary_storage_id, -1)
    discard emit_v3_o(positive_jump_id, 0, positive_index_value)
    discard emit_v3_o(positive_jump_id, 1, positive_result_value)
    discard emit_v3_i_block(positive_terminator_id, function_id, first_block_id + 2, first_ordinal + 11, 24, 0, 0, -1, -1)
    discard emit_v3_t_jump(positive_terminator_id, continuation_block_id)
    return -1

fn scan_while_relation_parameter_right_nested_call_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut left_start: i64 = while_left_start(first, stop)
    mut left_stop: i64 = while_left_stop(first, stop)
    mut operator_start: i64 = while_operator_start(first, stop)
    mut operator_length: i64 = comparison_operator_length(operator_start, stop)
    mut right_start: i64 = skip_spaces(operator_start + operator_length, stop)
    mut right_cursor: i64 = right_start
    match read_byte(right_cursor) == 45:
        -1:
            right_cursor += 1
        0:
            discard 0
        1:
            discard 0
    mut right_stop: i64 = number_end(right_cursor, stop)
    mut outer_body_start: i64 = line_end(source_line_start(first), length) + 1
    mut outer_body_stop: i64 = line_end(outer_body_start, length)
    mut outer_match_start: i64 = first_non_space(outer_body_start, outer_body_stop)
    mut outer_match_stop: i64 = outer_body_stop
    mut outer_match_info: i64 = parse_match_identifier_comparison(outer_match_start, outer_match_stop)
    mut outer_match_left_start: i64 = outer_match_info / 1000000000000
    mut outer_match_remainder: i64 = outer_match_info - outer_match_left_start * 1000000000000
    mut outer_match_left_stop: i64 = outer_match_remainder / 1000000
    mut outer_match_operator_start: i64 = outer_match_remainder - outer_match_left_stop * 1000000
    mut outer_match_operator_length: i64 = comparison_operator_length(outer_match_operator_start, outer_match_stop)
    mut outer_match_right_start: i64 = skip_spaces(outer_match_operator_start + outer_match_operator_length, outer_match_stop)
    mut outer_match_right_stop: i64 = word_end(outer_match_right_start, outer_match_stop)
    mut outer_match_right_type: i64 = find_parameter_type(header_start, header_end, outer_match_right_start, outer_match_right_stop)
    mut outer_match_left_type: i64 = resolve_value_type(header_start, header_end, outer_match_start, outer_match_left_start, outer_match_left_stop)
    mut outer_match_left_storage_id: i64 = find_mutable_storage_id(header_end + 1, outer_match_start, outer_match_left_start, outer_match_left_stop)
    mut outer_branch_cursor: i64 = outer_match_stop + 1
    mut outer_negative_label_start: i64 = first_non_space(outer_branch_cursor, line_end(outer_branch_cursor, length))
    mut outer_negative_label_stop: i64 = line_end(outer_branch_cursor, length)
    mut unit_line_start: i64 = outer_negative_label_stop + 1
    mut unit_line_stop: i64 = line_end(unit_line_start, length)
    mut inner_match_start: i64 = first_non_space(unit_line_stop + 1, line_end(unit_line_stop + 1, length))
    mut inner_match_stop: i64 = line_end(inner_match_start, length)
    mut inner_match_call_info: i64 = parse_match_call(inner_match_start, inner_match_stop)
    mut inner_match_expression_start: i64 = skip_spaces(word_end(inner_match_start, inner_match_stop), inner_match_stop)
    mut inner_match_call_end: i64 = call_expression_end(inner_match_expression_start)
    mut inner_match_callee_start: i64 = inner_match_call_info / 1000000
    mut inner_match_callee_stop: i64 = inner_match_call_info - inner_match_callee_start * 1000000
    mut inner_match_call_open: i64 = skip_spaces(inner_match_callee_stop, inner_match_call_end)
    mut inner_match_argument_start: i64 = first_non_space(inner_match_call_open + 1, inner_match_call_end - 1)
    mut inner_match_argument_stop: i64 = word_end(inner_match_argument_start, inner_match_call_end - 1)
    mut inner_match_signature: i64 = find_function_signature(inner_match_callee_start, inner_match_callee_stop)
    mut inner_branch_cursor: i64 = inner_match_stop + 1
    mut inner_negative_label_start: i64 = first_non_space(inner_branch_cursor, line_end(inner_branch_cursor, length))
    mut inner_negative_label_stop: i64 = line_end(inner_branch_cursor, length)
    mut inner_negative_body_start: i64 = inner_negative_label_stop + 1
    mut inner_negative_body_stop: i64 = line_end(inner_negative_body_start, length)
    mut inner_negative_body_first: i64 = first_non_space(inner_negative_body_start, inner_negative_body_stop)
    mut inner_zero_label_start: i64 = first_non_space(inner_negative_body_stop + 1, line_end(inner_negative_body_stop + 1, length))
    mut inner_zero_label_stop: i64 = line_end(inner_negative_body_stop + 1, length)
    mut inner_zero_body_start: i64 = inner_zero_label_stop + 1
    mut inner_zero_body_stop: i64 = line_end(inner_zero_body_start, length)
    mut inner_zero_body_first: i64 = first_non_space(inner_zero_body_start, inner_zero_body_stop)
    mut inner_positive_label_start: i64 = first_non_space(inner_zero_body_stop + 1, line_end(inner_zero_body_stop + 1, length))
    mut inner_positive_label_stop: i64 = line_end(inner_zero_body_stop + 1, length)
    mut inner_positive_body_start: i64 = inner_positive_label_stop + 1
    mut inner_positive_body_stop: i64 = line_end(inner_positive_body_start, length)
    mut inner_positive_body_first: i64 = first_non_space(inner_positive_body_start, inner_positive_body_stop)
    mut outer_zero_label_start: i64 = first_non_space(inner_positive_body_stop + 1, line_end(inner_positive_body_stop + 1, length))
    mut outer_zero_label_stop: i64 = line_end(inner_positive_body_stop + 1, length)
    mut outer_zero_body_start: i64 = outer_zero_label_stop + 1
    mut outer_zero_body_stop: i64 = line_end(outer_zero_body_start, length)
    mut outer_zero_body_first: i64 = first_non_space(outer_zero_body_start, outer_zero_body_stop)
    mut outer_positive_label_start: i64 = first_non_space(outer_zero_body_stop + 1, line_end(outer_zero_body_stop + 1, length))
    mut outer_positive_label_stop: i64 = line_end(outer_zero_body_stop + 1, length)
    mut outer_positive_body_start: i64 = outer_positive_label_stop + 1
    mut outer_positive_body_stop: i64 = line_end(outer_positive_body_start, length)
    mut outer_positive_body_first: i64 = first_non_space(outer_positive_body_start, outer_positive_body_stop)
    mut after_loop_start: i64 = while_body_end(first, length)
    mut after_loop_stop: i64 = line_end(after_loop_start, length)
    mut after_loop_first: i64 = first_non_space(after_loop_start, after_loop_stop)
    mut return_info: i64 = parse_return(after_loop_first, after_loop_stop)
    mut return_target_info: i64 = 0 - return_info
    mut return_target_start: i64 = return_target_info / 1000000
    mut return_target_stop: i64 = return_target_info - return_target_start * 1000000
    # A structured loop can continue into a following three-way match instead
    # of returning immediately.  Keep this tail structural: it is selected by
    # the parsed match shape and value types, never by a function or offset.
    mut continuation_mode: trit = 0
    mut continuation_fallthrough: trit = 0
    mut continuation_info: i64 = parse_match_identifier_comparison(after_loop_first, after_loop_stop)
    mut continuation_left_start: i64 = 0
    mut continuation_left_stop: i64 = 0
    mut continuation_operator_start: i64 = 0
    mut continuation_right_start: i64 = 0
    mut continuation_right_stop: i64 = 0
    mut continuation_negative_body_start: i64 = 0
    mut continuation_negative_body_stop: i64 = 0
    mut continuation_zero_body_start: i64 = 0
    mut continuation_zero_body_stop: i64 = 0
    mut continuation_positive_body_start: i64 = 0
    mut continuation_positive_body_stop: i64 = 0
    mut continuation_negative_return_info: i64 = 0
    mut continuation_zero_return_info: i64 = 0
    mut continuation_positive_return_info: i64 = 0
    mut continuation_negative_call_info: i64 = 0
    mut continuation_zero_call_info: i64 = 0
    mut continuation_positive_call_info: i64 = 0
    mut continuation_negative_expression_start: i64 = 0
    mut continuation_zero_expression_start: i64 = 0
    mut continuation_positive_expression_start: i64 = 0
    mut continuation_end: i64 = after_loop_stop
    mut continuation_left_type: i64 = 0
    mut continuation_right_type: i64 = 0
    mut continuation_storage_id: i64 = -1
    match continuation_info > 0:
        -1:
            mut continuation_base: i64 = 1000000000000
            continuation_left_start = continuation_info / continuation_base
            mut continuation_remainder: i64 = continuation_info - continuation_left_start * continuation_base
            continuation_left_stop = continuation_remainder / 1000000
            continuation_operator_start = continuation_remainder - continuation_left_stop * 1000000
            mut continuation_operator_length: i64 = comparison_operator_length(continuation_operator_start, after_loop_stop)
            continuation_right_start = skip_spaces(continuation_operator_start + continuation_operator_length, after_loop_stop)
            continuation_right_stop = word_end(continuation_right_start, after_loop_stop)
            mut continuation_branch_cursor: i64 = line_end(source_line_start(after_loop_first), length) + 1
            mut continuation_negative_label_stop: i64 = line_end(continuation_branch_cursor, length)
            continuation_negative_body_start = continuation_negative_label_stop + 1
            continuation_negative_body_stop = line_end(continuation_negative_body_start, length)
            mut continuation_zero_label_start: i64 = continuation_negative_body_stop + 1
            mut continuation_zero_label_stop: i64 = line_end(continuation_zero_label_start, length)
            continuation_zero_body_start = continuation_zero_label_stop + 1
            continuation_zero_body_stop = line_end(continuation_zero_body_start, length)
            mut continuation_positive_label_start: i64 = continuation_zero_body_stop + 1
            mut continuation_positive_label_stop: i64 = line_end(continuation_positive_label_start, length)
            continuation_positive_body_start = continuation_positive_label_stop + 1
            continuation_positive_body_stop = line_end(continuation_positive_body_start, length)
            continuation_negative_return_info = match_branch_return_literal(first_non_space(continuation_negative_body_start, continuation_negative_body_stop), continuation_negative_body_stop)
            continuation_zero_return_info = match_branch_return_literal(first_non_space(continuation_zero_body_start, continuation_zero_body_stop), continuation_zero_body_stop)
            continuation_positive_return_info = match_branch_return_literal(first_non_space(continuation_positive_body_start, continuation_positive_body_stop), continuation_positive_body_stop)
            continuation_negative_expression_start = skip_spaces(word_end(first_non_space(continuation_negative_body_start, continuation_negative_body_stop), continuation_negative_body_stop), continuation_negative_body_stop)
            continuation_zero_expression_start = skip_spaces(word_end(first_non_space(continuation_zero_body_start, continuation_zero_body_stop), continuation_zero_body_stop), continuation_zero_body_stop)
            continuation_positive_expression_start = skip_spaces(word_end(first_non_space(continuation_positive_body_start, continuation_positive_body_stop), continuation_positive_body_stop), continuation_positive_body_stop)
            continuation_negative_call_info = parse_call_three_arguments(continuation_negative_expression_start, continuation_negative_body_stop)
            continuation_zero_call_info = parse_call_three_arguments(continuation_zero_expression_start, continuation_zero_body_stop)
            continuation_positive_call_info = parse_call_three_arguments(continuation_positive_expression_start, continuation_positive_body_stop)
            continuation_end = continuation_positive_body_stop
            continuation_left_type = resolve_value_type(header_start, header_end, after_loop_first, continuation_left_start, continuation_left_stop)
            continuation_right_type = find_parameter_type(header_start, header_end, continuation_right_start, continuation_right_stop)
            continuation_storage_id = find_mutable_storage_id(header_end + 1, after_loop_first, continuation_left_start, continuation_left_stop)
            mut continuation_valid: trit = -1
            match continuation_left_type == 3:
                -1:
                    discard 0
                0:
                    continuation_valid = 0
                1:
