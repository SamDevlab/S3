                        return -1
                match expect_byte(cursor, end, 58):
                    -1:
                        cursor += 1
                    0:
                        return -1
                    1:
                        return -1
                cursor = skip_spaces(cursor, end)
                mut type_start: i64 = cursor
                mut type_stop: i64 = word_end(cursor, end)
                mut parsed_type: i64 = type_code(type_start, type_stop)
                match parsed_type > 0:
                    -1:
                        cursor = skip_spaces(type_stop, end)
                    0:
                        return -1
                    1:
                        return -1
                discard emit_v(next_id, function_id, 1, parsed_type, name_start, name_stop - name_start, 0, -1)
                discard emit_d(name_start, function_id, 1, parsed_type, name_start, name_stop - name_start, 0, 1, next_id)
                next_id += 1
                match read_byte(cursor) == 41:
                    -1:
                        return next_id
                    0:
                        match expect_byte(cursor, end, 44):
                            -1:
                                cursor += 1
                                cursor = skip_spaces(cursor, end)
                            0:
                                return -1
                            1:
                                return -1
                    1:
                        return -1
            return -1
        1:
            return -1

fn find_parameter_type(start: i64, end: i64, target_start: i64, target_end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    cursor = skip_spaces(word_stop, end)
    word_stop = word_end(cursor, end)
    cursor = skip_spaces(word_stop, end)
    match expect_byte(cursor, end, 40):
        -1:
            cursor += 1
        0:
            return 0
        1:
            return 0
    cursor = skip_spaces(cursor, end)
    match read_byte(cursor) == 41:
        -1:
            return 0
        0:
            while cursor < end:
                mut name_start: i64 = cursor
                mut name_stop: i64 = word_end(cursor, end)
                match is_identifier_span(name_start, name_stop):
                    -1:
                        cursor = skip_spaces(name_stop, end)
                    0:
                        return 0
                    1:
                        return 0
                match expect_byte(cursor, end, 58):
                    -1:
                        cursor += 1
                    0:
                        return 0
                    1:
                        return 0
                cursor = skip_spaces(cursor, end)
                mut type_start: i64 = cursor
                mut type_stop: i64 = word_end(cursor, end)
                mut parsed_type: i64 = type_code(type_start, type_stop)
                match parsed_type > 0:
                    -1:
                        cursor = skip_spaces(type_stop, end)
                    0:
                        return 0
                    1:
                        return 0
                match same_span(name_start, name_stop, target_start, target_end):
                    -1:
                        return parsed_type
                    0:
                        match read_byte(cursor) == 41:
                            -1:
                                return 0
                            0:
                                match expect_byte(cursor, end, 44):
                                    -1:
                                        cursor += 1
                                        cursor = skip_spaces(cursor, end)
                                    0:
                                        return 0
                                    1:
                                        return 0
                            1:
                                return 0
                    1:
                        return 0
            return 0
        1:
            return 0

fn find_parameter_ordinal(start: i64, end: i64, target_start: i64, target_end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    cursor = skip_spaces(word_stop, end)
    word_stop = word_end(cursor, end)
    cursor = skip_spaces(word_stop, end)
    match expect_byte(cursor, end, 40):
        -1:
            cursor += 1
        0:
            return -1
        1:
            return -1
    mut ordinal: i64 = 0
    cursor = skip_spaces(cursor, end)
    match read_byte(cursor) == 41:
        -1:
            return -1
        0:
            while cursor < end:
                mut name_start: i64 = cursor
                mut name_stop: i64 = word_end(cursor, end)
                match is_identifier_span(name_start, name_stop):
                    -1:
                        cursor = skip_spaces(name_stop, end)
                    0:
                        return -1
                    1:
                        return -1
                match same_span(name_start, name_stop, target_start, target_end):
                    -1:
                        return ordinal
                    0:
                        discard 0
                    1:
                        return -1
                match expect_byte(cursor, end, 58):
                    -1:
                        cursor += 1
                    0:
                        return -1
                    1:
                        return -1
                cursor = skip_spaces(cursor, end)
                mut type_stop: i64 = word_end(cursor, end)
                match type_code(cursor, type_stop) > 0:
                    -1:
                        cursor = skip_spaces(type_stop, end)
                    0:
                        return -1
                    1:
                        return -1
                match read_byte(cursor) == 41:
                    -1:
                        return -1
                    0:
                        match expect_byte(cursor, end, 44):
                            -1:
                                cursor += 1
                                cursor = skip_spaces(cursor, end)
                                ordinal += 1
                            0:
                                return -1
                            1:
                                return -1
                    1:
                        return -1
            return -1
        1:
            return -1

fn parse_mut(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 108492, 3):
        -1:
            cursor = skip_spaces(word_stop, end)
        0:
            return 0
        1:
            return 0
    mut name_start: i64 = cursor
    mut name_stop: i64 = word_end(cursor, end)
    match name_stop > name_start:
        -1:
            cursor = skip_spaces(name_stop, end)
        0:
            return 0
        1:
            return 0
    match expect_byte(cursor, end, 58):
        -1:
            cursor += 1
        0:
            return 0
        1:
            return 0
    cursor = skip_spaces(cursor, end)
    mut type_start: i64 = cursor
    mut type_stop: i64 = word_end(cursor, end)
    mut parsed_type: i64 = type_code(type_start, type_stop)
    match parsed_type > 0:
        -1:
            cursor = skip_spaces(type_stop, end)
        0:
            return 0
        1:
            return 0
    match expect_byte(cursor, end, 61):
        -1:
            cursor += 1
        0:
            return 0
        1:
            return 0
    cursor = skip_spaces(cursor, end)
    mut literal_start: i64 = cursor
    match read_byte(cursor) == 45:
        -1:
            cursor += 1
        0:
            discard 0
        1:
            discard 0
    match is_digit(read_byte(cursor)):
        -1:
            mut literal_stop: i64 = number_end(cursor, end)
            cursor = skip_spaces(literal_stop, end)
            match cursor == end:
                -1:
                    return parsed_type * 1000000000000000 + name_start * 1000000000 + (name_stop - name_start) * 1000000 + literal_start
                0:
                    match parse_binary_literal_expression(literal_start, end) > 0:
                        -1:
                            return parsed_type * 1000000000000000 + name_start * 1000000000 + (name_stop - name_start) * 1000000 + literal_start
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_mut_array_initializer(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 108492, 3):
        -1:
            cursor = skip_spaces(word_stop, end)
        0:
            return 0
        1:
            return 0
    mut name_start: i64 = cursor
    mut name_stop: i64 = word_end(cursor, end)
    match is_identifier_span(name_start, name_stop):
        -1:
            cursor = skip_spaces(name_stop, end)
        0:
            return 0
        1:
            return 0
    match expect_byte(cursor, end, 58):
        -1:
            cursor += 1
        0:
            return 0
        1:
            return 0
    cursor = skip_spaces(cursor, end)
    mut type_start: i64 = cursor
    mut type_stop: i64 = word_end(cursor, end)
    mut element_type: i64 = type_code(type_start, type_stop)
    match element_type > 0:
        -1:
            cursor = skip_spaces(type_stop, end)
        0:
            return 0
        1:
            return 0
    match expect_byte(cursor, end, 91):
        -1:
            cursor += 1
        0:
            return 0
        1:
            return 0
    cursor = skip_spaces(cursor, end)
    mut extent_start: i64 = cursor
    mut extent_stop: i64 = number_end(cursor, end)
    match extent_stop > extent_start:
        -1:
            mut extent: i64 = parse_integer_literal(extent_start, extent_stop)
            match extent > 0:
                -1:
                    match extent <= 365:
                        -1:
                            cursor = skip_spaces(extent_stop, end)
                            match expect_byte(cursor, end, 93):
                                -1:
                                    cursor += 1
                                0:
                                    return 0
                                1:
                                    return 0
                            cursor = skip_spaces(cursor, end)
                            match expect_byte(cursor, end, 61):
                                -1:
                                    cursor += 1
                                0:
                                    return 0
                                1:
                                    return 0
                            cursor = skip_spaces(cursor, end)
                            match expect_byte(cursor, end, 91):
                                -1:
                                    cursor += 1
                                0:
                                    return 0
                                1:
                                    return 0
                            mut item: i64 = 0
                            while item < extent:
                                cursor = skip_spaces(cursor, end)
                                mut value_start: i64 = cursor
                                match read_byte(cursor) == 45:
                                    -1:
                                        cursor += 1
                                    0:
                                        discard 0
                                    1:
                                        discard 0
                                mut value_stop: i64 = number_end(cursor, end)
                                match value_stop > cursor:
                                    -1:
                                        match parse_integer_literal(value_start, value_stop) == 0:
                                            -1:
                                                discard 0
                                            0:
                                                return 0
                                            1:
                                                return 0
                                        cursor = skip_spaces(value_stop, end)
                                        match item + 1 < extent:
                                            -1:
                                                match expect_byte(cursor, end, 44):
                                                    -1:
                                                        cursor += 1
                                                    0:
                                                        return 0
                                                    1:
                                                        return 0
                                                cursor = skip_spaces(cursor, end)
                                            0:
                                                match expect_byte(cursor, end, 93):
                                                    -1:
                                                        cursor += 1
                                                    0:
                                                        return 0
                                                    1:
                                                        return 0
                                                cursor = skip_spaces(cursor, end)
                                                match cursor == end:
                                                    -1:
                                                        return element_type * 1000000000000000 + extent * 1000000000000 + name_start * 1000000 + (name_stop - name_start)
                                                    0:
                                                        return 0
                                                    1:
                                                        return 0
                                            1:
                                                return 0
                                        item += 1
                                    0:
                                        return 0
                                    1:
                                        return 0
                            return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_immutable_literal(start: i64, end: i64, allow_expression: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut name_start: i64 = cursor
    mut name_stop: i64 = word_end(cursor, end)
    match is_identifier_span(name_start, name_stop):
        -1:
            cursor = skip_spaces(name_stop, end)
        0:
            return 0
        1:
            return 0
    match expect_byte(cursor, end, 58):
        -1:
            cursor += 1
        0:
            return 0
        1:
            return 0
    cursor = skip_spaces(cursor, end)
    mut type_start: i64 = cursor
    mut type_stop: i64 = word_end(cursor, end)
    mut parsed_type: i64 = type_code(type_start, type_stop)
    match parsed_type > 0:
        -1:
            cursor = skip_spaces(type_stop, end)
        0:
            return 0
        1:
            return 0
    match expect_byte(cursor, end, 61):
        -1:
            cursor += 1
        0:
            return 0
        1:
            return 0
    cursor = skip_spaces(cursor, end)
    mut literal_start: i64 = cursor
    match read_byte(cursor) == 45:
        -1:
            cursor += 1
        0:
            discard 0
        1:
            discard 0
    match is_digit(read_byte(cursor)):
        -1:
            mut literal_stop: i64 = number_end(cursor, end)
            cursor = skip_spaces(literal_stop, end)
            match cursor == end:
                -1:
                    return parsed_type * 1000000000000000 + name_start * 1000000000 + (name_stop - name_start) * 1000000 + literal_start
                0:
                    match allow_expression == 1:
                        -1:
                            match parse_binary_literal_expression(literal_start, end) > 0:
                                -1:
                                    return parsed_type * 1000000000000000 + name_start * 1000000000 + (name_stop - name_start) * 1000000 + literal_start
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 0
        0:
            match allow_expression == 1:
                -1:
                    match parse_binary_literal_expression(literal_start, end) > 0:
                        -1:
                            return parsed_type * 1000000000000000 + name_start * 1000000000 + (name_stop - name_start) * 1000000 + literal_start
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        1:
            return 0

fn scan_immutable_literal(mode: i64, function_id: i64, packed: i64, header_end: i64, first: i64, value_id: i64) -> i64:
    mut parsed_type: i64 = packed / 1000000000000000
    mut remainder: i64 = packed - parsed_type * 1000000000000000
    mut name_start: i64 = remainder / 1000000000
    remainder = remainder - name_start * 1000000000
    mut name_length: i64 = remainder / 1000000
    mut literal_start: i64 = remainder - name_length * 1000000
    match mode == 2:
        -1:
            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
            mut const_id: i64 = function_id * 1000000 + ordinal
            mut move_id: i64 = const_id + 1
            mut literal_stop: i64 = literal_start
            match read_byte(literal_stop) == 45:
                -1:
                    literal_stop += 1
                0:
                    discard 0
                1:
                    discard 0
            literal_stop = number_end(literal_stop, s3_stage1_source_length())
            mut literal_value: i64 = parse_integer_literal(literal_start, literal_stop)
            discard emit_v3_v(value_id, function_id, 2, parsed_type, literal_start)
            discard emit_v3_v(value_id + 1, function_id, 3, parsed_type, name_start)
            discard emit_v3_d(name_start, function_id, parsed_type, name_start, name_length, 0, 1, value_id + 1)
            discard emit_v3_i(const_id, function_id, ordinal, 1, 1, 0, literal_value)
            discard emit_v3_r(const_id, 0, value_id)
            discard emit_v3_i(move_id, function_id, ordinal + 1, 3, 1, 1, -1)
            discard emit_v3_o(move_id, 0, value_id)
            discard emit_v3_r(move_id, 0, value_id + 1)
            return value_id + 2
        0:
            match mode == 1:
                -1:
                    discard emit_v(value_id, function_id, 3, parsed_type, literal_start, 0, 0, -1)
                    discard emit_d(name_start, function_id, 2, parsed_type, name_start, name_length, 0, 1, value_id)
                    return value_id + 1
                0:
                    return value_id
                1:
                    return value_id
        1:
            return value_id

fn core_immutable_instruction_count(first: i64, stop: i64, packed: i64) -> i64:
    mut parsed_type: i64 = packed / 1000000000000000
    mut remainder: i64 = packed - parsed_type * 1000000000000000
    mut name_start: i64 = remainder / 1000000000
    remainder = remainder - name_start * 1000000000
    mut name_length: i64 = remainder / 1000000
    mut expression_start: i64 = remainder - name_length * 1000000
    mut binary_info: i64 = parse_binary_literal_expression(expression_start, stop)
    match binary_info > 0:
        -1:
            mut additive_operator: i64 = binary_info / 10
            mut left_end: i64 = trim_expression_end(expression_start, additive_operator)
            mut left_start: i64 = first_non_space(expression_start, left_end)
            mut right_start: i64 = skip_spaces(additive_operator + 1, stop)
            mut right_stop: i64 = binary_right_operand_stop(right_start, stop)
            match parse_literal_expression(left_start, left_end) > 0:
                -1:
                    return 2
                0:
                    match parse_literal_expression(right_start, right_stop) > 0:
                        -1:
                            return 3
                        0:
                            return 6
                        1:
                            return 6
                1:
                    return 3
        0:
            return 2
        1:
            return 2

fn core_immutable_binary_info(stop: i64, packed: i64) -> i64:
    mut parsed_type: i64 = packed / 1000000000000000
    mut remainder: i64 = packed - parsed_type * 1000000000000000
    mut name_start: i64 = remainder / 1000000000
    remainder = remainder - name_start * 1000000000
    mut name_length: i64 = remainder / 1000000
    mut expression_start: i64 = remainder - name_length * 1000000
    return parse_binary_literal_expression(expression_start, stop)

fn scan_immutable_identifier_add_v3(function_id: i64, parsed_type: i64, name_start: i64, name_length: i64, header_end: i64, first: i64, additive_operator: i64, left_start: i64, left_stop: i64, right_start: i64, right_stop: i64, value_id: i64) -> i64:
    mut left_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
    mut right_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, right_start, right_stop)
    match left_storage_id >= 0:
        -1:
            match right_storage_id >= 0:
                -1:
                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                    mut left_index_id: i64 = function_id * 1000000 + ordinal
                    mut left_load_id: i64 = left_index_id + 1
                    mut right_index_id: i64 = left_index_id + 2
                    mut right_load_id: i64 = left_index_id + 3
                    mut add_id: i64 = left_index_id + 4
                    mut move_id: i64 = left_index_id + 5
                    discard emit_v3_v(value_id, function_id, 2, 2, left_start)
                    discard emit_v3_v(value_id + 1, function_id, 3, parsed_type, left_start)
                    discard emit_v3_v(value_id + 2, function_id, 2, 2, right_start)
                    discard emit_v3_v(value_id + 3, function_id, 3, parsed_type, right_start)
                    discard emit_v3_v(value_id + 4, function_id, 3, parsed_type, additive_operator)
                    discard emit_v3_v(value_id + 5, function_id, 3, parsed_type, name_start)
                    discard emit_v3_d(name_start, function_id, parsed_type, name_start, name_length, 0, 1, value_id + 5)
                    discard emit_v3_i_aux(left_index_id, function_id, ordinal, 1, 1, 0, -1, 0)
                    discard emit_v3_r(left_index_id, 0, value_id)
                    discard emit_v3_i_aux(left_load_id, function_id, ordinal + 1, 15, 1, 1, left_storage_id, -1)
                    discard emit_v3_o(left_load_id, 0, value_id)
                    discard emit_v3_r(left_load_id, 0, value_id + 1)
                    discard emit_v3_i_aux(right_index_id, function_id, ordinal + 2, 1, 1, 0, -1, 0)
                    discard emit_v3_r(right_index_id, 0, value_id + 2)
                    discard emit_v3_i_aux(right_load_id, function_id, ordinal + 3, 15, 1, 1, right_storage_id, -1)
                    discard emit_v3_o(right_load_id, 0, value_id + 2)
                    discard emit_v3_r(right_load_id, 0, value_id + 3)
                    discard emit_v3_i(add_id, function_id, ordinal + 4, 5, 1, 2, -1)
                    discard emit_v3_o(add_id, 0, value_id + 1)
                    discard emit_v3_o(add_id, 1, value_id + 3)
                    discard emit_v3_r(add_id, 0, value_id + 4)
                    discard emit_v3_i(move_id, function_id, ordinal + 5, 3, 1, 1, -1)
                    discard emit_v3_o(move_id, 0, value_id + 4)
                    discard emit_v3_r(move_id, 0, value_id + 5)
                    return value_id + 6
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_immutable_v3(function_id: i64, packed: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut parsed_type: i64 = packed / 1000000000000000
    mut remainder: i64 = packed - parsed_type * 1000000000000000
    mut name_start: i64 = remainder / 1000000000
    remainder = remainder - name_start * 1000000000
    mut name_length: i64 = remainder / 1000000
    mut expression_start: i64 = remainder - name_length * 1000000
    mut binary_info: i64 = parse_binary_literal_expression(expression_start, stop)
    match binary_info > 0:
        -1:
            mut additive_operator: i64 = binary_info / 10
            mut left_end: i64 = trim_expression_end(expression_start, additive_operator)
            mut left_start: i64 = first_non_space(expression_start, left_end)
            mut left_stop: i64 = word_end(left_start, left_end)
            mut right_start: i64 = skip_spaces(additive_operator + 1, stop)
            mut right_cursor: i64 = right_start
            match read_byte(right_cursor) == 45:
                -1:
                    right_cursor += 1
                0:
                    discard 0
                1:
                    discard 0
            mut right_stop: i64 = binary_right_operand_stop(right_start, stop)
            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
            mut const_id: i64 = function_id * 1000000 + ordinal
            mut left_literal_info: i64 = parse_literal_expression(left_start, left_end)
            match left_literal_info > 0:
                -1:
                    mut left_value: i64 = parse_integer_literal(left_start, left_end)
                    mut right_value: i64 = parse_integer_literal(right_cursor, right_stop)
                    discard emit_v3_v(value_id, function_id, 2, parsed_type, additive_operator)
                    discard emit_v3_v(value_id + 1, function_id, 3, parsed_type, name_start)
                    discard emit_v3_d(name_start, function_id, parsed_type, name_start, name_length, 0, 1, value_id + 1)
                    discard emit_v3_i(const_id, function_id, ordinal, 1, 1, 0, left_value + right_value)
                    discard emit_v3_r(const_id, 0, value_id)
                    discard emit_v3_i(const_id + 1, function_id, ordinal + 1, 3, 1, 1, -1)
                    discard emit_v3_o(const_id + 1, 0, value_id)
                    discard emit_v3_r(const_id + 1, 0, value_id + 1)
                    return value_id + 2
                0:
                    mut left_value_id: i64 = find_core_local_value_id(header_end + 1, first, left_start, left_stop)
                    match left_value_id >= 0:
                        -1:
                            mut right_literal_info: i64 = parse_literal_expression(right_cursor, right_stop)
                            match right_literal_info == 0:
                                -1:
                                    return scan_immutable_identifier_add_v3(function_id, parsed_type, name_start, name_length, header_end, first, additive_operator, left_start, left_stop, right_cursor, right_stop, value_id)
                                0:
                                    discard 0
                                1:
                                    return -1
                            mut right_value: i64 = parse_integer_literal(right_cursor, right_stop)
                            mut add_id: i64 = const_id + 1
                            mut move_id: i64 = const_id + 2
                            discard emit_v3_v(value_id, function_id, 2, parsed_type, right_cursor)
                            discard emit_v3_v(value_id + 1, function_id, 3, parsed_type, additive_operator)
                            discard emit_v3_v(value_id + 2, function_id, 3, parsed_type, name_start)
                            discard emit_v3_d(name_start, function_id, parsed_type, name_start, name_length, 0, 1, value_id + 2)
                            discard emit_v3_i(const_id, function_id, ordinal, 1, 1, 0, right_value)
                            discard emit_v3_r(const_id, 0, value_id)
                            discard emit_v3_i(add_id, function_id, ordinal + 1, 5, 1, 2, -1)
                            discard emit_v3_o(add_id, 0, left_value_id)
                            discard emit_v3_o(add_id, 1, value_id)
                            discard emit_v3_r(add_id, 0, value_id + 1)
                            discard emit_v3_i(move_id, function_id, ordinal + 2, 3, 1, 1, -1)
                            discard emit_v3_o(move_id, 0, value_id + 1)
                            discard emit_v3_r(move_id, 0, value_id + 2)
                            return value_id + 3
                        0:
                            return -1
                        1:
                            return -1
                1:
                    return -1
        0:
            return scan_immutable_literal(2, function_id, packed, header_end, first, value_id)
        1:
            return -1

fn scan_mutable_dependent_v3(function_id: i64, packed: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut parsed_type: i64 = packed / 1000000000000000
    mut remainder: i64 = packed - parsed_type * 1000000000000000
    mut name_start: i64 = remainder / 1000000000
    remainder = remainder - name_start * 1000000000
    mut name_length: i64 = remainder / 1000000
    mut cursor: i64 = first_non_space(first, stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor += 1
    cursor = skip_spaces(cursor, stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor += 1
    mut expression_start: i64 = skip_spaces(cursor, stop)
    mut binary_info: i64 = parse_binary_literal_expression(expression_start, stop)
    match binary_info > 0:
        -1:
            mut additive_operator: i64 = binary_info / 10
            mut left_end: i64 = trim_expression_end(expression_start, additive_operator)
            mut left_start: i64 = first_non_space(expression_start, left_end)
            mut left_stop: i64 = word_end(left_start, left_end)
            mut right_start: i64 = skip_spaces(additive_operator + 1, stop)
            mut right_stop: i64 = binary_right_operand_stop(right_start, stop)
            mut left_type: i64 = find_local_type(header_end + 1, first, left_start, left_stop)
            match left_type == parsed_type:
                -1:
                    mut left_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
                    match left_storage_id >= 0:
                        -1:
                            match right_stop > 0:
                                -1:
                                    match parse_literal_expression(right_start, right_stop) > 0:
                                        -1:
                                            match skip_spaces(right_stop, stop) == stop:
                                                -1:
                                                    mut storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
                                                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                                    mut index_id: i64 = function_id * 1000000 + ordinal
                                                    mut load_id: i64 = index_id + 1
                                                    mut const_id: i64 = index_id + 2
                                                    mut add_id: i64 = index_id + 3
                                                    mut store_index_id: i64 = index_id + 4
                                                    mut store_id: i64 = index_id + 5
                                                    discard emit_v3_d(storage_id, function_id, parsed_type, name_start, name_length, 1, 2, storage_id)
                                                    discard emit_v3_v(value_id, function_id, 2, 2, left_start)
                                                    discard emit_v3_v(value_id + 1, function_id, 3, parsed_type, left_start)
                                                    discard emit_v3_v(value_id + 2, function_id, 2, parsed_type, right_start)
                                                    discard emit_v3_v(value_id + 3, function_id, 3, parsed_type, additive_operator)
                                                    discard emit_v3_v(value_id + 4, function_id, 2, 2, first)
                                                    discard emit_v3_m(function_id, storage_id, parsed_type, 1, 1, first)
                                                    discard emit_v3_i_aux(index_id, function_id, ordinal, 1, 1, 0, -1, 0)
                                                    discard emit_v3_r(index_id, 0, value_id)
                                                    discard emit_v3_i_aux(load_id, function_id, ordinal + 1, 15, 1, 1, left_storage_id, -1)
                                                    discard emit_v3_o(load_id, 0, value_id)
                                                    discard emit_v3_r(load_id, 0, value_id + 1)
                                                    discard emit_v3_i(const_id, function_id, ordinal + 2, 1, 1, 0, parse_integer_literal(right_start, right_stop))
                                                    discard emit_v3_r(const_id, 0, value_id + 2)
                                                    discard emit_v3_i(add_id, function_id, ordinal + 3, 5, 1, 2, -1)
                                                    discard emit_v3_o(add_id, 0, value_id + 1)
                                                    discard emit_v3_o(add_id, 1, value_id + 2)
                                                    discard emit_v3_r(add_id, 0, value_id + 3)
                                                    discard emit_v3_i_aux(store_index_id, function_id, ordinal + 4, 1, 1, 0, -1, 0)
                                                    discard emit_v3_r(store_index_id, 0, value_id + 4)
                                                    discard emit_v3_i_aux(store_id, function_id, ordinal + 5, 16, 0, 2, storage_id, -1)
                                                    discard emit_v3_o(store_id, 0, value_id + 4)
                                                    discard emit_v3_o(store_id, 1, value_id + 3)
                                                    return value_id + 5
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn scan_mutable_array_v3(function_id: i64, packed: i64, header_end: i64, first: i64, value_id: i64) -> i64:
    mut element_type: i64 = packed / 1000000000000000
    mut remainder: i64 = packed - element_type * 1000000000000000
    mut extent: i64 = remainder / 1000000000000
    remainder = remainder - extent * 1000000000000
    mut name_start: i64 = remainder / 1000000
    mut name_length: i64 = remainder - name_start * 1000000
    mut storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
    discard emit_v3_d(storage_id, function_id, 10, name_start, name_length, 1, 2, storage_id)
    discard emit_v3_m(function_id, storage_id, element_type, extent, 1, first)
    return value_id

fn scan_mutable_v3(function_id: i64, packed: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut parsed_type: i64 = packed / 1000000000000000
    mut remainder: i64 = packed - parsed_type * 1000000000000000
    mut name_start: i64 = remainder / 1000000000
    remainder = remainder - name_start * 1000000000
    mut name_length: i64 = remainder / 1000000
    mut literal_start: i64 = remainder - name_length * 1000000
    mut binary_info: i64 = parse_binary_literal_expression(literal_start, stop)
    match binary_info > 0:
        -1:
            mut additive_operator: i64 = binary_info / 10
            mut left_end: i64 = trim_expression_end(literal_start, additive_operator)
            mut left_start: i64 = first_non_space(literal_start, left_end)
            mut right_start: i64 = skip_spaces(additive_operator + 1, stop)
            mut right_stop: i64 = binary_right_operand_stop(right_start, stop)
            mut left_value: i64 = parse_integer_literal(left_start, left_end)
            mut right_value: i64 = parse_integer_literal(right_start, right_stop)
            mut storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
            mut const_id: i64 = function_id * 1000000 + ordinal
            mut index_id: i64 = const_id + 1
            mut store_id: i64 = const_id + 2
            discard emit_v3_d(storage_id, function_id, parsed_type, name_start, name_length, 1, 2, storage_id)
            discard emit_v3_v(value_id, function_id, 2, parsed_type, additive_operator)
            discard emit_v3_v(value_id + 1, function_id, 2, 2, first)
            discard emit_v3_m(function_id, storage_id, parsed_type, 1, 1, first)
            discard emit_v3_i(const_id, function_id, ordinal, 1, 1, 0, left_value + right_value)
            discard emit_v3_r(const_id, 0, value_id)
            discard emit_v3_i_aux(index_id, function_id, ordinal + 1, 1, 1, 0, -1, 0)
            discard emit_v3_r(index_id, 0, value_id + 1)
            discard emit_v3_i_aux(store_id, function_id, ordinal + 2, 16, 0, 2, storage_id, -1)
            discard emit_v3_o(store_id, 0, value_id + 1)
            discard emit_v3_o(store_id, 1, value_id)
            return value_id + 2
        0:
            discard 0
        1:
            discard 0
    mut storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
    mut binding_id: i64 = storage_id
    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
    mut const_id: i64 = function_id * 1000000 + ordinal
    mut index_id: i64 = const_id + 1
    mut store_id: i64 = const_id + 2
    mut literal_stop: i64 = literal_start
    match read_byte(literal_stop) == 45:
        -1:
            literal_stop += 1
        0:
            discard 0
        1:
            discard 0
    literal_stop = number_end(literal_stop, stop)
    mut literal_value: i64 = parse_integer_literal(literal_start, literal_stop)
    discard emit_v3_d(binding_id, function_id, parsed_type, name_start, name_length, 1, 2, storage_id)
    discard emit_v3_v(value_id, function_id, 2, parsed_type, literal_start)
    discard emit_v3_v(value_id + 1, function_id, 2, 2, first)
    discard emit_v3_m(function_id, storage_id, parsed_type, 1, 1, first)
    discard emit_v3_i(const_id, function_id, ordinal, 1, 1, 0, literal_value)
    discard emit_v3_r(const_id, 0, value_id)
    discard emit_v3_i_aux(index_id, function_id, ordinal + 1, 1, 1, 0, -1, 0)
    discard emit_v3_r(index_id, 0, value_id + 1)
    discard emit_v3_i_aux(store_id, function_id, ordinal + 2, 16, 0, 2, storage_id, -1)
    discard emit_v3_o(store_id, 0, value_id + 1)
    discard emit_v3_o(store_id, 1, value_id)
    return value_id + 2

fn scan_core_return_literal(function_id: i64, return_type: i64, header_end: i64, first: i64, expression_start: i64, expression_stop: i64, value_id: i64) -> i64:
    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
    mut const_id: i64 = function_id * 1000000 + ordinal
    mut return_id: i64 = const_id + 1
    mut literal_value: i64 = parse_integer_literal(expression_start, expression_stop)
    discard emit_v3_v(value_id, function_id, 2, return_type, expression_start)
    discard emit_v3_i(const_id, function_id, ordinal, 1, 1, 0, literal_value)
    discard emit_v3_r(const_id, 0, value_id)
    discard emit_v3_i(return_id, function_id, ordinal + 1, 23, 0, 1, -1)
    discard emit_v3_o(return_id, 0, value_id)
    discard emit_v3_t(return_id, value_id)
    return value_id + 1

fn scan_mutable_compound_product_literal_v3(function_id: i64, header_start: i64, header_end: i64, first: i64, stop: i64, packed: i64, value_id: i64) -> i64:
    mut parsed_type: i64 = packed / 1000000000000000
    mut remainder: i64 = packed - parsed_type * 1000000000000000
    mut name_start: i64 = remainder / 1000000000
    remainder = remainder - name_start * 1000000000
    mut name_length: i64 = remainder / 1000000
    mut additive_operator: i64 = remainder - name_length * 1000000
    mut cursor: i64 = first_non_space(first, stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor += 1
    cursor = skip_spaces(cursor, stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor += 1
    mut expression_start: i64 = skip_spaces(cursor, stop)
    mut left_end: i64 = trim_expression_end(expression_start, additive_operator)
    mut left_start: i64 = first_non_space(expression_start, left_end)
    mut left_stop: i64 = word_end(left_start, left_end)
    mut product_start: i64 = skip_spaces(additive_operator + 1, stop)
    mut product_info: i64 = find_multiplicative_operator(product_start, stop)
    match product_info > 0:
        -1:
            mut product_operator: i64 = product_info / 10
            mut product_left_end: i64 = trim_expression_end(product_start, product_operator)
            mut product_left_start: i64 = first_non_space(product_start, product_left_end)
            mut product_left_stop: i64 = word_end(product_left_start, product_left_end)
            mut product_right_start: i64 = skip_spaces(product_operator + 1, stop)
            mut product_right_cursor: i64 = product_right_start
            match read_byte(product_right_cursor) == 45:
                -1:
                    product_right_cursor += 1
                0:
                    discard 0
                1:
                    discard 0
            mut product_right_stop: i64 = number_end(product_right_cursor, stop)
            mut left_type: i64 = resolve_value_type(header_start, header_end, first, left_start, left_stop)
            mut product_left_type: i64 = resolve_value_type(header_start, header_end, first, product_left_start, product_left_stop)
            mut left_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
            mut product_left_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, product_left_start, product_left_stop)
            mut valid: trit = -1
            match parsed_type == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match left_type == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match product_left_type == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match left_storage_id >= 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match product_left_storage_id >= 0:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match is_digit(read_byte(product_right_cursor)):
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match valid == -1:
                -1:
                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                    mut base_id: i64 = function_id * 1000000 + ordinal
                    mut left_index_id: i64 = base_id
                    mut left_load_id: i64 = base_id + 1
                    mut product_index_id: i64 = base_id + 2
                    mut product_load_id: i64 = base_id + 3
                    mut const_id: i64 = base_id + 4
                    mut multiply_id: i64 = base_id + 5
                    mut difference_id: i64 = base_id + 6
                    mut target_index_id: i64 = base_id + 7
                    mut store_id: i64 = base_id + 8
                    mut left_index_value_id: i64 = value_id
                    mut left_load_value_id: i64 = value_id + 1
                    mut product_index_value_id: i64 = value_id + 2
                    mut product_load_value_id: i64 = value_id + 3
                    mut literal_value_id: i64 = value_id + 4
                    mut product_value_id: i64 = value_id + 5
                    mut result_value_id: i64 = value_id + 6
                    mut target_index_value_id: i64 = value_id + 7
                    mut storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
                    discard emit_v3_d(storage_id, function_id, parsed_type, name_start, name_length, 1, 2, storage_id)
                    discard emit_v3_m(function_id, storage_id, parsed_type, 1, 1, first)
                    discard emit_v3_v(left_index_value_id, function_id, 2, 2, left_start)
                    discard emit_v3_v(left_load_value_id, function_id, 3, parsed_type, left_start)
                    discard emit_v3_v(product_index_value_id, function_id, 2, 2, product_left_start)
                    discard emit_v3_v(product_load_value_id, function_id, 3, parsed_type, product_left_start)
                    discard emit_v3_v(literal_value_id, function_id, 2, parsed_type, product_right_start)
                    discard emit_v3_v(product_value_id, function_id, 3, parsed_type, product_operator)
                    discard emit_v3_v(result_value_id, function_id, 3, parsed_type, additive_operator)
                    discard emit_v3_v(target_index_value_id, function_id, 2, 2, first)
                    discard emit_v3_i_aux(left_index_id, function_id, ordinal, 1, 1, 0, -1, 0)
                    discard emit_v3_r(left_index_id, 0, left_index_value_id)
                    discard emit_v3_i_aux(left_load_id, function_id, ordinal + 1, 15, 1, 1, left_storage_id, -1)
                    discard emit_v3_o(left_load_id, 0, left_index_value_id)
                    discard emit_v3_r(left_load_id, 0, left_load_value_id)
                    discard emit_v3_i_aux(product_index_id, function_id, ordinal + 2, 1, 1, 0, -1, 0)
                    discard emit_v3_r(product_index_id, 0, product_index_value_id)
                    discard emit_v3_i_aux(product_load_id, function_id, ordinal + 3, 15, 1, 1, product_left_storage_id, -1)
                    discard emit_v3_o(product_load_id, 0, product_index_value_id)
                    discard emit_v3_r(product_load_id, 0, product_load_value_id)
                    discard emit_v3_i(const_id, function_id, ordinal + 4, 1, 1, 0, parse_integer_literal(product_right_start, product_right_stop))
                    discard emit_v3_r(const_id, 0, literal_value_id)
                    discard emit_v3_i_aux(multiply_id, function_id, ordinal + 5, 7, 1, 2, -1, -1)
                    discard emit_v3_o(multiply_id, 0, product_load_value_id)
                    discard emit_v3_o(multiply_id, 1, literal_value_id)
                    discard emit_v3_r(multiply_id, 0, product_value_id)
                    discard emit_v3_i_aux(difference_id, function_id, ordinal + 6, 6, 1, 2, -1, -1)
                    discard emit_v3_o(difference_id, 0, left_load_value_id)
                    discard emit_v3_o(difference_id, 1, product_value_id)
                    discard emit_v3_r(difference_id, 0, result_value_id)
                    discard emit_v3_i_aux(target_index_id, function_id, ordinal + 7, 1, 1, 0, -1, 0)
                    discard emit_v3_r(target_index_id, 0, target_index_value_id)
                    discard emit_v3_i_aux(store_id, function_id, ordinal + 8, 16, 0, 2, storage_id, -1)
                    discard emit_v3_o(store_id, 0, target_index_value_id)
                    discard emit_v3_o(store_id, 1, result_value_id)
                    return value_id + 8
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_mutable_binary_literal_v3(function_id: i64, header_start: i64, header_end: i64, first: i64, stop: i64, packed: i64, value_id: i64) -> i64:
    mut parsed_type: i64 = packed / 1000000000000000
    mut remainder: i64 = packed - parsed_type * 1000000000000000
    mut name_start: i64 = remainder / 1000000000
    remainder = remainder - name_start * 1000000000
    mut name_length: i64 = remainder / 1000000
    mut operator_start: i64 = remainder - name_length * 1000000
    mut cursor: i64 = first_non_space(first, stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor += 1
    cursor = skip_spaces(cursor, stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor += 1
    mut expression_start: i64 = skip_spaces(cursor, stop)
    mut left_start: i64 = first_non_space(expression_start, operator_start)
    mut left_stop: i64 = word_end(left_start, operator_start)
    mut right_start: i64 = skip_spaces(operator_start + 1, stop)
    mut right_cursor: i64 = right_start
    match read_byte(right_cursor) == 45:
        -1:
            right_cursor += 1
        0:
            discard 0
        1:
            discard 0
    mut right_stop: i64 = number_end(right_cursor, stop)
    mut left_type: i64 = resolve_value_type(header_start, header_end, first, left_start, left_stop)
    mut left_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
    mut storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
    mut operator_kind: i64 = 0
    mut valid: trit = -1
    match parsed_type == 3:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_type == parsed_type:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match left_storage_id >= 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match is_digit(read_byte(right_cursor)):
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match read_byte(operator_start) == 42:
        -1:
            operator_kind = 1
        0:
            match read_byte(operator_start) == 47:
                -1:
                    operator_kind = 2
                0:
                    valid = 0
                1:
                    valid = 0
        1:
            valid = 0
    match operator_kind > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            discard 0
    match valid == -1:
        -1:
            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
            mut base_id: i64 = function_id * 1000000 + ordinal
            mut index_id: i64 = base_id
            mut load_id: i64 = base_id + 1
            mut const_id: i64 = base_id + 2
            mut operation_id: i64 = base_id + 3
            mut target_index_id: i64 = base_id + 4
            mut store_id: i64 = base_id + 5
            mut index_value: i64 = value_id
            mut load_value: i64 = value_id + 1
            mut literal_value: i64 = value_id + 2
            mut result_value: i64 = value_id + 3
            mut target_index_value: i64 = value_id + 4
            discard emit_v3_d(storage_id, function_id, parsed_type, name_start, name_length, 1, 2, storage_id)
            discard emit_v3_m(function_id, storage_id, parsed_type, 1, 1, first)
            discard emit_v3_v(index_value, function_id, 2, 2, left_start)
            discard emit_v3_v(load_value, function_id, 3, parsed_type, left_start)
            discard emit_v3_v(literal_value, function_id, 2, parsed_type, right_start)
            discard emit_v3_v(result_value, function_id, 3, parsed_type, operator_start)
            discard emit_v3_v(target_index_value, function_id, 2, 2, first)
            discard emit_v3_i(index_id, function_id, ordinal, 1, 1, 0, 0)
            discard emit_v3_r(index_id, 0, index_value)
            discard emit_v3_i_aux(load_id, function_id, ordinal + 1, 15, 1, 1, left_storage_id, -1)
            discard emit_v3_o(load_id, 0, index_value)
            discard emit_v3_r(load_id, 0, load_value)
            discard emit_v3_i(const_id, function_id, ordinal + 2, 1, 1, 0, parse_integer_literal(right_start, right_stop))
            discard emit_v3_r(const_id, 0, literal_value)
            match operator_kind == 1:
                -1:
                    discard emit_v3_i(operation_id, function_id, ordinal + 3, 7, 1, 2, -1)
                0:
                    discard emit_v3_i(operation_id, function_id, ordinal + 3, 8, 1, 2, -1)
                1:
                    discard emit_v3_i(operation_id, function_id, ordinal + 3, 7, 1, 2, -1)
            discard emit_v3_o(operation_id, 0, load_value)
            discard emit_v3_o(operation_id, 1, literal_value)
            discard emit_v3_r(operation_id, 0, result_value)
            discard emit_v3_i_aux(target_index_id, function_id, ordinal + 4, 1, 1, 0, -1, 0)
            discard emit_v3_r(target_index_id, 0, target_index_value)
            discard emit_v3_i_aux(store_id, function_id, ordinal + 5, 16, 0, 2, storage_id, -1)
            discard emit_v3_o(store_id, 0, target_index_value)
            discard emit_v3_o(store_id, 1, result_value)
            return value_id + 5
        0:
            return -1
        1:
            return -1

fn scan_mutable_compound_product_identifier_v3(function_id: i64, header_start: i64, header_end: i64, first: i64, stop: i64, packed: i64, value_id: i64) -> i64:
    mut parsed_type: i64 = packed / 1000000000000000
    mut remainder: i64 = packed - parsed_type * 1000000000000000
    mut name_start: i64 = remainder / 1000000000
    remainder = remainder - name_start * 1000000000
    mut name_length: i64 = remainder / 1000000
    mut cursor: i64 = first_non_space(first, stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor += 1
    cursor = skip_spaces(cursor, stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor += 1
    mut expression_start: i64 = skip_spaces(cursor, stop)
    mut additive_info: i64 = find_additive_operator(expression_start, stop)
    match additive_info > 0:
        -1:
            mut additive_operator: i64 = additive_info / 10
            mut additive_kind: i64 = additive_info - additive_operator * 10
            match additive_kind == 2:
                -1:
                    mut left_end: i64 = trim_expression_end(expression_start, additive_operator)
                    mut left_start: i64 = first_non_space(expression_start, left_end)
                    mut left_stop: i64 = word_end(left_start, left_end)
                    mut product_start: i64 = skip_spaces(additive_operator + 1, stop)
                    mut product_info: i64 = find_multiplicative_operator(product_start, stop)
                    match product_info > 0:
                        -1:
                            mut product_operator: i64 = product_info / 10
                            mut product_kind: i64 = product_info - product_operator * 10
                            match product_kind == 1:
                                -1:
                                    mut product_left_end: i64 = trim_expression_end(product_start, product_operator)
                                    mut product_left_start: i64 = first_non_space(product_start, product_left_end)
                                    mut product_left_stop: i64 = word_end(product_left_start, product_left_end)
                                    mut product_right_start: i64 = skip_spaces(product_operator + 1, stop)
                                    mut product_right_stop: i64 = word_end(product_right_start, stop)
                                    mut left_type: i64 = resolve_value_type(header_start, header_end, first, left_start, left_stop)
                                    mut product_left_type: i64 = resolve_value_type(header_start, header_end, first, product_left_start, product_left_stop)
                                    mut product_right_type: i64 = resolve_value_type(header_start, header_end, first, product_right_start, product_right_stop)
                                    mut left_parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, left_start, left_stop)
                                    mut product_right_parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, product_right_start, product_right_stop)
                                    mut product_left_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, product_left_start, product_left_stop)
                                    mut parameter_count: i64 = count_header_parameters(header_start, header_end)
                                    match parsed_type == 3:
                                        -1:
                                            match left_type == parsed_type:
                                                -1:
                                                    match product_left_type == parsed_type:
                                                        -1:
                                                            match product_right_type == parsed_type:
                                                                -1:
                                                                    match left_parameter_ordinal >= 0:
                                                                        -1:
                                                                            match product_left_storage_id >= 0:
                                                                                -1:
                                                                                    match product_right_parameter_ordinal >= 0:
                                                                                        -1:
                                                                                            mut left_value_id: i64 = value_id - parameter_count + left_parameter_ordinal
                                                                                            mut product_right_value_id: i64 = value_id - parameter_count + product_right_parameter_ordinal
                                                                                            mut product_left_index_value_id: i64 = value_id
                                                                                            mut product_left_load_value_id: i64 = value_id + 1
                                                                                            mut product_value_id: i64 = value_id + 2
                                                                                            mut result_value_id: i64 = value_id + 3
                                                                                            mut target_index_value_id: i64 = value_id + 4
                                                                                            mut storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
                                                                                            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                                                                            mut index_id: i64 = function_id * 1000000 + ordinal
                                                                                            mut load_id: i64 = index_id + 1
                                                                                            mut multiply_id: i64 = index_id + 2
                                                                                            mut difference_id: i64 = index_id + 3
                                                                                            mut target_index_id: i64 = index_id + 4
                                                                                            mut store_id: i64 = index_id + 5
                                                                                            discard emit_v3_d(storage_id, function_id, parsed_type, name_start, name_length, 1, 2, storage_id)
                                                                                            discard emit_v3_m(function_id, storage_id, parsed_type, 1, 1, first)
                                                                                            discard emit_v3_v(product_left_index_value_id, function_id, 2, 2, product_left_start)
                                                                                            discard emit_v3_v(product_left_load_value_id, function_id, 3, parsed_type, product_left_start)
                                                                                            discard emit_v3_v(product_value_id, function_id, 3, parsed_type, product_operator)
                                                                                            discard emit_v3_v(result_value_id, function_id, 3, parsed_type, additive_operator)
                                                                                            discard emit_v3_v(target_index_value_id, function_id, 2, 2, first)
                                                                                            discard emit_v3_i_aux(index_id, function_id, ordinal, 1, 1, 0, -1, 0)
                                                                                            discard emit_v3_r(index_id, 0, product_left_index_value_id)
                                                                                            discard emit_v3_i_aux(load_id, function_id, ordinal + 1, 15, 1, 1, product_left_storage_id, -1)
                                                                                            discard emit_v3_o(load_id, 0, product_left_index_value_id)
                                                                                            discard emit_v3_r(load_id, 0, product_left_load_value_id)
                                                                                            discard emit_v3_i_aux(multiply_id, function_id, ordinal + 2, 7, 1, 2, -1, -1)
                                                                                            discard emit_v3_o(multiply_id, 0, product_left_load_value_id)
                                                                                            discard emit_v3_o(multiply_id, 1, product_right_value_id)
                                                                                            discard emit_v3_r(multiply_id, 0, product_value_id)
                                                                                            discard emit_v3_i_aux(difference_id, function_id, ordinal + 3, 6, 1, 2, -1, -1)
                                                                                            discard emit_v3_o(difference_id, 0, left_value_id)
                                                                                            discard emit_v3_o(difference_id, 1, product_value_id)
                                                                                            discard emit_v3_r(difference_id, 0, result_value_id)
                                                                                            discard emit_v3_i_aux(target_index_id, function_id, ordinal + 4, 1, 1, 0, -1, 0)
                                                                                            discard emit_v3_r(target_index_id, 0, target_index_value_id)
                                                                                            discard emit_v3_i_aux(store_id, function_id, ordinal + 5, 16, 0, 2, storage_id, -1)
                                                                                            discard emit_v3_o(store_id, 0, target_index_value_id)
                                                                                            discard emit_v3_o(store_id, 1, result_value_id)
                                                                                            return value_id + 5
                                                                                        0:
                                                                                            return -1
                                                                                        1:
                                                                                            return -1
                                                                                0:
                                                                                    return -1
                                                                                1:
                                                                                    return -1
                                                                        0:
                                                                            return -1
                                                                        1:
                                                                            return -1
                                                                0:
                                                                    return -1
                                                                1:
                                                                    return -1
                                                        0:
                                                            return -1
                                                        1:
                                                            return -1
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_mutable_binary_identifier_v3(function_id: i64, header_start: i64, header_end: i64, first: i64, stop: i64, packed: i64, value_id: i64) -> i64:
    mut parsed_type: i64 = packed / 1000000000000000
    mut remainder: i64 = packed - parsed_type * 1000000000000000
    mut name_start: i64 = remainder / 1000000000
    remainder = remainder - name_start * 1000000000
    mut name_length: i64 = remainder / 1000000
    mut cursor: i64 = first_non_space(first, stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor += 1
    cursor = skip_spaces(cursor, stop)
    cursor = skip_spaces(word_end(cursor, stop), stop)
    cursor += 1
    mut expression_start: i64 = skip_spaces(cursor, stop)
    mut operator_info: i64 = find_multiplicative_operator(expression_start, stop)
    match operator_info > 0:
        -1:
            mut operator_start: i64 = operator_info / 10
            mut operator_kind: i64 = operator_info - operator_start * 10
            match operator_kind == 1:
                -1:
                    discard 0
                0:
                    match operator_kind == 2:
                        -1:
                            discard 0
                        0:
                            return -1
                        1:
                            return -1
                1:
                    discard 0
            mut left_end: i64 = trim_expression_end(expression_start, operator_start)
            mut left_start: i64 = first_non_space(expression_start, left_end)
            mut left_stop: i64 = word_end(left_start, left_end)
            mut right_start: i64 = skip_spaces(operator_start + 1, stop)
            mut right_stop: i64 = word_end(right_start, stop)
            mut left_type: i64 = resolve_value_type(header_start, header_end, first, left_start, left_stop)
            mut right_type: i64 = resolve_value_type(header_start, header_end, first, right_start, right_stop)
            match parsed_type == 3:
                -1:
                    match left_type == parsed_type:
                        -1:
                            match right_type == parsed_type:
                                -1:
                                    mut left_parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, left_start, left_stop)
                                    mut right_parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, right_start, right_stop)
                                    mut left_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, left_start, left_stop)
                                    mut right_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, right_start, right_stop)
                                    mut left_local_value_id: i64 = find_core_local_value_id(header_end + 1, first, left_start, left_stop)
                                    mut right_local_value_id: i64 = find_core_local_value_id(header_end + 1, first, right_start, right_stop)
                                    mut parameter_count: i64 = count_header_parameters(header_start, header_end)
                                    mut left_operand_value_id: i64 = left_local_value_id
                                    mut right_operand_value_id: i64 = right_local_value_id
                                    mut next_value_id: i64 = value_id
                                    mut left_index_value_id: i64 = -1
                                    mut right_index_value_id: i64 = -1
                                    mut left_load_value_id: i64 = -1
                                    mut right_load_value_id: i64 = -1
                                    match left_parameter_ordinal >= 0:
                                        -1:
                                            left_operand_value_id = value_id - parameter_count + left_parameter_ordinal
                                        0:
                                            match left_storage_id >= 0:
                                                -1:
                                                    left_index_value_id = next_value_id
                                                    next_value_id += 1
                                                    left_load_value_id = next_value_id
                                                    next_value_id += 1
                                                    left_operand_value_id = left_load_value_id
                                                0:
                                                    match left_local_value_id >= 0:
                                                        -1:
                                                            discard 0
                                                        0:
                                                            return -1
                                                        1:
                                                            return -1
                                                1:
                                                    return -1
                                        1:
                                            return -1
                                    match right_parameter_ordinal >= 0:
                                        -1:
                                            right_operand_value_id = value_id - parameter_count + right_parameter_ordinal
                                        0:
                                            match right_storage_id >= 0:
                                                -1:
                                                    right_index_value_id = next_value_id
                                                    next_value_id += 1
                                                    right_load_value_id = next_value_id
                                                    next_value_id += 1
                                                    right_operand_value_id = right_load_value_id
                                                0:
                                                    match right_local_value_id >= 0:
                                                        -1:
                                                            discard 0
                                                        0:
                                                            return -1
                                                        1:
                                                            return -1
                                                1:
                                                    return -1
                                        1:
                                            return -1
                                    mut result_value_id: i64 = next_value_id
                                    next_value_id += 1
                                    mut target_index_value_id: i64 = next_value_id
                                    next_value_id += 1
                                    mut storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
                                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                    mut left_index_id: i64 = function_id * 1000000 + ordinal
                                    mut left_load_id: i64 = left_index_id + 1
                                    mut right_index_id: i64 = left_index_id + 2
                                    mut right_load_id: i64 = left_index_id + 3
                                    mut operation_id: i64 = left_index_id
                                    mut target_index_id: i64 = left_index_id
                                    mut store_id: i64 = left_index_id
                                    mut instruction_ordinal: i64 = ordinal
                                    discard emit_v3_d(storage_id, function_id, parsed_type, name_start, name_length, 1, 2, storage_id)
                                    discard emit_v3_m(function_id, storage_id, parsed_type, 1, 1, first)
                                    match left_storage_id >= 0:
                                        -1:
                                            discard emit_v3_v(left_index_value_id, function_id, 2, 2, left_start)
                                            discard emit_v3_v(left_load_value_id, function_id, 3, parsed_type, left_start)
                                            discard emit_v3_i_aux(left_index_id, function_id, instruction_ordinal, 1, 1, 0, -1, 0)
                                            discard emit_v3_r(left_index_id, 0, left_index_value_id)
                                            discard emit_v3_i_aux(left_load_id, function_id, instruction_ordinal + 1, 15, 1, 1, left_storage_id, -1)
                                            discard emit_v3_o(left_load_id, 0, left_index_value_id)
                                            discard emit_v3_r(left_load_id, 0, left_load_value_id)
                                            instruction_ordinal += 2
                                        0:
                                            discard 0
                                        1:
                                            discard 0
                                    match right_storage_id >= 0:
                                        -1:
                                            discard emit_v3_v(right_index_value_id, function_id, 2, 2, right_start)
                                            discard emit_v3_v(right_load_value_id, function_id, 3, parsed_type, right_start)
                                            discard emit_v3_i_aux(right_index_id, function_id, instruction_ordinal, 1, 1, 0, -1, 0)
                                            discard emit_v3_r(right_index_id, 0, right_index_value_id)
                                            discard emit_v3_i_aux(right_load_id, function_id, instruction_ordinal + 1, 15, 1, 1, right_storage_id, -1)
                                            discard emit_v3_o(right_load_id, 0, right_index_value_id)
                                            discard emit_v3_r(right_load_id, 0, right_load_value_id)
                                            instruction_ordinal += 2
                                        0:
                                            discard 0
                                        1:
                                            discard 0
                                    operation_id = function_id * 1000000 + instruction_ordinal
                                    target_index_id = operation_id + 1
                                    store_id = operation_id + 2
                                    discard emit_v3_v(result_value_id, function_id, 3, parsed_type, operator_start)
                                    discard emit_v3_v(target_index_value_id, function_id, 2, 2, first)
                                    match operator_kind == 1:
                                        -1:
                                            discard emit_v3_i_aux(operation_id, function_id, instruction_ordinal, 7, 1, 2, -1, -1)
                                        0:
                                            discard emit_v3_i_aux(operation_id, function_id, instruction_ordinal, 8, 1, 2, -1, -1)
                                        1:
                                            discard emit_v3_i_aux(operation_id, function_id, instruction_ordinal, 7, 1, 2, -1, -1)
                                    discard emit_v3_o(operation_id, 0, left_operand_value_id)
                                    discard emit_v3_o(operation_id, 1, right_operand_value_id)
                                    discard emit_v3_r(operation_id, 0, result_value_id)
                                    discard emit_v3_i_aux(target_index_id, function_id, instruction_ordinal + 1, 1, 1, 0, -1, 0)
                                    discard emit_v3_r(target_index_id, 0, target_index_value_id)
                                    discard emit_v3_i_aux(store_id, function_id, instruction_ordinal + 2, 16, 0, 2, storage_id, -1)
                                    discard emit_v3_o(store_id, 0, target_index_value_id)
                                    discard emit_v3_o(store_id, 1, result_value_id)
                                    return next_value_id
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_mutable_call_v3(function_id: i64, header_start: i64, header_end: i64, first: i64, stop: i64, packed: i64, value_id: i64) -> i64:
    mut parsed_type: i64 = packed / 1000000
    mut call_start: i64 = packed - parsed_type * 1000000
    mut call_end: i64 = call_expression_end(call_start)
    mut callee_start: i64 = first_non_space(call_start, call_end)
    mut callee_stop: i64 = word_end(callee_start, call_end)
    mut signature: i64 = find_function_signature(callee_start, callee_stop)
    match signature > 0:
        -1:
            mut result_type: i64 = signature / 100
            mut parameter_type: i64 = find_function_parameter_type_by_ordinal(callee_start, callee_stop, 0)
            match result_type == parsed_type:
                -1:
                    match parameter_type > 0:
                        -1:
                            mut argument_span: i64 = parse_call_argument_span(call_start, call_end, 0)
                            match argument_span > 0:
                                -1:
                                    mut argument_start: i64 = argument_span / 1000000
                                    mut argument_stop: i64 = argument_span - argument_start * 1000000
                                    mut argument_type: i64 = resolve_value_type(header_start, header_end, first, argument_start, argument_stop)
                                    match argument_type == parameter_type:
                                        -1:
                                            mut next_id: i64 = value_id
                                            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                            match call_argument_is_literal(argument_span):
                                                -1:
                                                    discard emit_v3_v(next_id, function_id, 2, parameter_type, argument_start)
                                                    discard emit_v3_i(function_id * 1000000 + ordinal, function_id, ordinal, 1, 1, 0, parse_integer_literal(argument_start, argument_stop))
                                                    discard emit_v3_r(function_id * 1000000 + ordinal, 0, next_id)
                                                    next_id += 1
                                                    ordinal += 1
                                                0:
                                                    discard 0
                                                1:
                                                    discard 0
                                            mut parameter_count: i64 = count_header_parameters(header_start, header_end)
                                            mut parameter_base: i64 = next_id - parameter_count
                                            mut argument_value: i64 = resolve_call_argument_value_id(header_start, header_end, first, argument_span, parameter_type, parameter_base, next_id)
                                            match argument_value >= 0:
                                                -1:
                                                    mut callee_identity: i64 = find_function_identity(callee_start, callee_stop)
                                                    match callee_identity > 0:
                                                        -1:
                                                            mut callee_function_id: i64 = callee_identity / 10
                                                            mut callee_kind: i64 = callee_identity - callee_function_id * 10
                                                            mut call_id: i64 = function_id * 1000000 + ordinal
                                                            discard emit_v3_v(next_id, function_id, 4, result_type, callee_start)
                                                            discard emit_v3_i(call_id, function_id, ordinal, 14, 1, 1, -1)
                                                            discard emit_v3_c(call_id, callee_function_id, callee_kind, callee_start, callee_stop - callee_start)
                                                            discard emit_v3_a(call_id, 0, argument_value)
                                                            discard emit_v3_o(call_id, 0, argument_value)
                                                            discard emit_v3_r(call_id, 0, next_id)
                                                            return next_id + 1
                                                        0:
                                                            return -1
                                                        1:
                                                            return -1
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_mutable_identifier_v3(function_id: i64, header_start: i64, header_end: i64, first: i64, stop: i64, packed: i64, value_id: i64) -> i64:
    mut parsed_type: i64 = packed / 1000000000000000
    mut remainder: i64 = packed - parsed_type * 1000000000000000
    mut name_start: i64 = remainder / 1000000000
    remainder = remainder - name_start * 1000000000
    mut name_length: i64 = remainder / 1000000
    mut source_start: i64 = remainder - name_length * 1000000
    mut source_stop: i64 = word_end(source_start, stop)
    mut source_type: i64 = resolve_value_type(header_start, header_end, first, source_start, source_stop)
    match source_type == parsed_type:
        -1:
            mut source_value_id: i64 = -1
            mut parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, source_start, source_stop)
            match parameter_ordinal >= 0:
                -1:
                    mut parameter_count: i64 = count_header_parameters(header_start, header_end)
                    match parameter_count > 0:
                        -1:
                            source_value_id = value_id - parameter_count + parameter_ordinal
                        0:
                            return -1
                        1:
                            return -1
                0:
                    source_value_id = find_core_local_value_id(header_end + 1, first, source_start, source_stop)
                1:
                    return -1
            match source_value_id >= 0:
                -1:
                    mut storage_id: i64 = mutable_storage_count_before(header_end + 1, first)
                    mut binding_id: i64 = storage_id
                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                    mut index_id: i64 = function_id * 1000000 + ordinal
                    mut store_id: i64 = index_id + 1
                    discard emit_v3_d(binding_id, function_id, parsed_type, name_start, name_length, 1, 2, storage_id)
                    discard emit_v3_v(value_id, function_id, 2, 2, first)
                    discard emit_v3_m(function_id, storage_id, parsed_type, 1, 1, first)
                    discard emit_v3_i_aux(index_id, function_id, ordinal, 1, 1, 0, -1, 0)
                    discard emit_v3_r(index_id, 0, value_id)
                    discard emit_v3_i_aux(store_id, function_id, ordinal + 1, 16, 0, 2, storage_id, -1)
                    discard emit_v3_o(store_id, 0, value_id)
                    discard emit_v3_o(store_id, 1, source_value_id)
                    return value_id + 1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_mutable_load_v3(function_id: i64, header_end: i64, first: i64, target_start: i64, target_stop: i64, target_type: i64, value_id: i64) -> i64:
    mut storage_id: i64 = find_mutable_storage_id(header_end + 1, first, target_start, target_stop)
    match storage_id >= 0:
        -1:
            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
            mut index_id: i64 = function_id * 1000000 + ordinal
            mut load_id: i64 = index_id + 1
            discard emit_v3_v(value_id, function_id, 2, 2, target_start)
            discard emit_v3_v(value_id + 1, function_id, 3, target_type, target_start)
            discard emit_v3_i_aux(index_id, function_id, ordinal, 1, 1, 0, -1, 0)
            discard emit_v3_r(index_id, 0, value_id)
            discard emit_v3_i_aux(load_id, function_id, ordinal + 1, 15, 1, 1, storage_id, -1)
            discard emit_v3_o(load_id, 0, value_id)
            discard emit_v3_r(load_id, 0, value_id + 1)
            return value_id + 2
        0:
            return -1
        1:
            return -1

fn parse_mut_identifier(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 108492, 3):
        -1:
            cursor = skip_spaces(word_stop, end)
        0:
            return 0
        1:
            return 0

    mut name_start: i64 = cursor
    mut name_stop: i64 = word_end(cursor, end)
    match is_identifier_span(name_start, name_stop):
        -1:
            cursor = skip_spaces(name_stop, end)
        0:
            return 0
        1:
            return 0
    match expect_byte(cursor, end, 58):
        -1:
            cursor += 1
        0:
            return 0
        1:
            return 0
    cursor = skip_spaces(cursor, end)
    mut type_start: i64 = cursor
