fn scan_pack_token_return_add_call_v3(function_id: i64, return_type: i64, header_start: i64, header_end: i64, body_limit: i64, start: i64, end: i64, value_id: i64) -> i64:
    match parse_pack_token_return_add_call(start, end) > 0:
        -1:
            mut callee_start: i64 = first_non_space(start, end)
            mut callee_stop: i64 = word_end(callee_start, end)
            mut cursor: i64 = skip_spaces(callee_stop, end)
            cursor += 1
            mut first_start: i64 = first_non_space(cursor, end)
            mut first_stop: i64 = word_end(first_start, end)
            cursor = skip_spaces(first_stop, end)
            mut operator_start: i64 = cursor
            cursor += 1
            mut first_literal_start: i64 = first_non_space(cursor, end)
            mut first_literal_stop: i64 = number_end(first_literal_start, end)
            cursor = skip_spaces(first_literal_stop, end)
            cursor += 1
            mut second_start: i64 = first_non_space(cursor, end)
            mut second_stop: i64 = number_end(second_start, end)
            cursor = skip_spaces(second_stop, end)
            cursor += 1
            mut third_start: i64 = first_non_space(cursor, end)
            mut third_stop: i64 = number_end(third_start, end)
            mut signature: i64 = find_function_signature(callee_start, callee_stop)
            mut first_type: i64 = resolve_value_type(header_start, header_end, body_limit, first_start, first_stop)
            mut first_storage_id: i64 = find_mutable_storage_id(header_end + 1, body_limit, first_start, first_stop)
            mut first_parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, first_start, first_stop)
            mut valid: trit = -1
            match signature > 0:
                -1:
                    match signature / 100 == return_type:
                        -1:
                            match find_function_parameter_type_by_ordinal(callee_start, callee_stop, 0) == 3:
                                -1:
                                    match find_function_parameter_type_by_ordinal(callee_start, callee_stop, 1) == 3:
                                        -1:
                                            match find_function_parameter_type_by_ordinal(callee_start, callee_stop, 2) == 3:
                                                -1:
                                                    discard 0
                                                0:
                                                    valid = 0
                                                1:
                                                    valid = 0
                                        0:
                                            valid = 0
                                        1:
                                            valid = 0
                                0:
                                    valid = 0
                                1:
                                    valid = 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
            match first_type == 3:
                -1:
                    discard 0
                0:
                    valid = 0
                1:
                    valid = 0
            match parse_integer_literal(first_literal_start, first_literal_stop) >= 0:
                -1:
                    discard 0
                0:
                    discard 0
                1:
                    valid = 0
            match parse_integer_literal(second_start, second_stop) >= 0:
                -1:
                    discard 0
                0:
                    discard 0
                1:
                    valid = 0
            match parse_integer_literal(third_start, third_stop) >= 0:
                -1:
                    discard 0
                0:
                    discard 0
                1:
                    valid = 0
            match first_parameter_ordinal >= 0:
                -1:
                    discard 0
                0:
                    match first_storage_id >= 0:
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                1:
                    valid = 0
            match valid == -1:
                -1:
                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, source_line_start(start))
                    mut base_id: i64 = function_id * 1000000 + ordinal
                    mut next_id: i64 = value_id
                    mut instruction_offset: i64 = 0
                    mut first_value_id: i64 = value_id
                    mut parameter_count: i64 = count_header_parameters(header_start, header_end)
                    match first_storage_id >= 0:
                        -1:
                            discard emit_v3_v(next_id, function_id, 2, 2, first_start)
                            discard emit_v3_v(next_id + 1, function_id, 3, first_type, first_start)
                            discard emit_v3_i(base_id, function_id, ordinal, 1, 1, 0, 0)
                            discard emit_v3_r(base_id, 0, next_id)
                            discard emit_v3_i_aux(base_id + 1, function_id, ordinal + 1, 15, 1, 1, first_storage_id, -1)
                            discard emit_v3_o(base_id + 1, 0, next_id)
                            discard emit_v3_r(base_id + 1, 0, next_id + 1)
                            first_value_id = next_id + 1
                            next_id += 2
                            instruction_offset = 2
                        0:
                            first_value_id = value_id - parameter_count + first_parameter_ordinal
                        1:
                            first_value_id = value_id - parameter_count + first_parameter_ordinal
                    mut first_literal_value_id: i64 = next_id
                    mut add_value_id: i64 = next_id + 1
                    discard emit_v3_v(first_literal_value_id, function_id, 2, 3, first_literal_start)
                    discard emit_v3_v(add_value_id, function_id, 3, 3, operator_start)
                    discard emit_v3_i(base_id + instruction_offset, function_id, ordinal + instruction_offset, 1, 1, 0, parse_integer_literal(first_literal_start, first_literal_stop))
                    discard emit_v3_r(base_id + instruction_offset, 0, first_literal_value_id)
                    instruction_offset += 1
                    discard emit_v3_i(base_id + instruction_offset, function_id, ordinal + instruction_offset, 5, 1, 2, -1)
                    discard emit_v3_o(base_id + instruction_offset, 0, first_value_id)
                    discard emit_v3_o(base_id + instruction_offset, 1, first_literal_value_id)
                    discard emit_v3_r(base_id + instruction_offset, 0, add_value_id)
                    instruction_offset += 1
                    next_id += 2
                    mut second_value_id: i64 = next_id
                    discard emit_v3_v(second_value_id, function_id, 2, 3, second_start)
                    discard emit_v3_i(base_id + instruction_offset, function_id, ordinal + instruction_offset, 1, 1, 0, parse_integer_literal(second_start, second_stop))
                    discard emit_v3_r(base_id + instruction_offset, 0, second_value_id)
                    instruction_offset += 1
                    next_id += 1
                    mut third_value_id: i64 = next_id
                    discard emit_v3_v(third_value_id, function_id, 2, 3, third_start)
                    discard emit_v3_i(base_id + instruction_offset, function_id, ordinal + instruction_offset, 1, 1, 0, parse_integer_literal(third_start, third_stop))
                    discard emit_v3_r(base_id + instruction_offset, 0, third_value_id)
                    instruction_offset += 1
                    next_id += 1
                    mut callee_identity: i64 = find_function_identity(callee_start, callee_stop)
                    match callee_identity > 0:
                        -1:
                            mut callee_function_id: i64 = callee_identity / 10
                            mut callee_kind: i64 = callee_identity - callee_function_id * 10
                            mut call_value_id: i64 = next_id
                            mut call_id: i64 = base_id + instruction_offset
                            mut return_id: i64 = call_id + 1
                            discard emit_v3_v(call_value_id, function_id, 4, return_type, callee_start)
                            discard emit_v3_i(call_id, function_id, ordinal + instruction_offset, 14, 1, 3, -1)
                            discard emit_v3_c(call_id, callee_function_id, callee_kind, callee_start, callee_stop - callee_start)
                            discard emit_v3_a(call_id, 0, add_value_id)
                            discard emit_v3_a(call_id, 1, second_value_id)
                            discard emit_v3_a(call_id, 2, third_value_id)
                            discard emit_v3_o(call_id, 0, add_value_id)
                            discard emit_v3_o(call_id, 1, second_value_id)
                            discard emit_v3_o(call_id, 2, third_value_id)
                            discard emit_v3_r(call_id, 0, call_value_id)
                            discard emit_v3_i(return_id, function_id, ordinal + instruction_offset + 1, 23, 0, 1, -1)
                            discard emit_v3_o(return_id, 0, call_value_id)
                            discard emit_v3_t(return_id, call_value_id)
                            return call_value_id + 1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_expression_atom(mode: i64, function_id: i64, header_start: i64, header_end: i64, body_limit: i64, expected_type: i64, start: i64, end: i64, value_id: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut literal_start: i64 = cursor
    match read_byte(cursor) == 45:
        -1:
            cursor += 1
        0:
            discard 0
        1:
            discard 0
    match is_digit(read_byte(cursor)):
        -1:
            mut literal_stop: i64 = number_end(cursor, end)
            mut literal_after: i64 = skip_spaces(literal_stop, end)
            match literal_after == end:
                -1:
                    return record_v(mode, value_id, function_id, 3, expected_type, literal_start, 0, 0, -1)
                0:
                    return -1
                1:
                    return -1
        0:
            mut word_stop: i64 = word_end(cursor, end)
            match is_identifier_span(cursor, word_stop):
                -1:
                    mut after_word: i64 = skip_spaces(word_stop, end)
                    match read_byte(after_word) == 40:
                        -1:
                            return scan_call_atom(mode, function_id, header_start, header_end, body_limit, expected_type, cursor, end, value_id)
                        0:
                            match after_word == end:
                                -1:
                                    mut actual_type: i64 = resolve_value_type(header_start, header_end, body_limit, cursor, word_stop)
                                    match actual_type == expected_type:
                                        -1:
                                            discard record_v(mode, value_id, function_id, 3, 2, cursor, 0, 0, -1)
                                            discard record_v(mode, value_id + 1, function_id, 4, actual_type, cursor, 0, 0, -1)
                                            return value_id + 2
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        1:
            return -1

fn scan_expression_product(mode: i64, function_id: i64, header_start: i64, header_end: i64, body_limit: i64, expected_type: i64, start: i64, end: i64, value_id: i64) -> i64:
    mut operator_info: i64 = find_multiplicative_operator(start, end)
    match operator_info > 0:
        -1:
            mut operator_start: i64 = operator_info / 10
            mut left_end: i64 = trim_expression_end(start, operator_start)
            mut right_start: i64 = skip_spaces(operator_start + 1, end)
            mut left_start: i64 = start
            mut next_id: i64 = scan_expression_atom(mode, function_id, header_start, header_end, body_limit, expected_type, left_start, left_end, value_id)
            match next_id > 0:
                -1:
                    next_id = scan_expression_atom(mode, function_id, header_start, header_end, body_limit, expected_type, right_start, end, next_id)
                    match next_id > 0:
                        -1:
                            discard record_v(mode, next_id, function_id, 4, expected_type, operator_start, 0, 0, -1)
                            return next_id + 1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return scan_expression_atom(mode, function_id, header_start, header_end, body_limit, expected_type, start, end, value_id)
        1:
            return -1

fn scan_expression_value(mode: i64, function_id: i64, header_start: i64, header_end: i64, body_limit: i64, expected_type: i64, start: i64, end: i64, value_id: i64) -> i64:
    mut operator_info: i64 = find_additive_operator(start, end)
    match operator_info > 0:
        -1:
            mut operator_start: i64 = operator_info / 10
            mut left_end: i64 = trim_expression_end(start, operator_start)
            mut right_start: i64 = skip_spaces(operator_start + 1, end)
            mut left_start: i64 = start
            mut next_id: i64 = scan_expression_product(mode, function_id, header_start, header_end, body_limit, expected_type, left_start, left_end, value_id)
            match next_id > 0:
                -1:
                    next_id = scan_expression_product(mode, function_id, header_start, header_end, body_limit, expected_type, right_start, end, next_id)
                    match next_id > 0:
                        -1:
                            discard record_v(mode, next_id, function_id, 4, expected_type, operator_start, 0, 0, -1)
                            return next_id + 1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            mut expression_start_copy: i64 = start
            return scan_expression_product(mode, function_id, header_start, header_end, body_limit, expected_type, expression_start_copy, end, value_id)
        1:
            return -1

fn parse_nested_call_shape(start: i64, end: i64) -> i64:
    mut outer_start: i64 = first_non_space(start, end)
    mut outer_stop: i64 = word_end(outer_start, end)
    match is_identifier_span(outer_start, outer_stop):
        -1:
            mut outer_after: i64 = skip_spaces(outer_stop, end)
            match expect_byte(outer_after, end, 40):
                -1:
                    mut outer_close: i64 = matching_close(outer_after, end)
                    match outer_close > 0:
                        -1:
                            match skip_spaces(outer_close + 1, end) == end:
                                -1:
                                    mut inner_start: i64 = first_non_space(outer_after + 1, outer_close)
                                    mut inner_stop: i64 = word_end(inner_start, outer_close)
                                    match is_identifier_span(inner_start, inner_stop):
                                        -1:
                                            mut inner_after: i64 = skip_spaces(inner_stop, outer_close)
                                            match expect_byte(inner_after, outer_close, 40):
                                                -1:
                                                    mut inner_close: i64 = matching_close(inner_after, outer_close)
                                                    match inner_close > 0:
                                                        -1:
                                                            match skip_spaces(inner_close + 1, outer_close) == outer_close:
                                                                -1:
                                                                    mut argument_start: i64 = first_non_space(inner_after + 1, inner_close)
                                                                    mut argument_stop: i64 = word_end(argument_start, inner_close)
                                                                    match is_identifier_span(argument_start, argument_stop):
                                                                        -1:
                                                                            match skip_spaces(argument_stop, inner_close) == inner_close:
                                                                                -1:
                                                                                    return outer_start * 1000000000000 + inner_start * 1000000 + argument_start
                                                                                0:
                                                                                    return 0
                                                                                1:
                                                                                    return 0
                                                                        0:
                                                                            return 0
                                                                        1:
                                                                            return 0
                                                                0:
                                                                    return 0
                                                                1:
                                                                    return 0
                                                        0:
                                                            return 0
                                                        1:
                                                            return 0
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_nested_call_difference_shape(start: i64, end: i64) -> i64:
    mut open_start: i64 = first_non_space(start, end)
    mut close_start: i64 = matching_close(open_start, end)
    mut valid: trit = -1
    match read_byte(open_start) == 40:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match close_start > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match valid == -1:
        -1:
            match skip_spaces(close_start + 1, end) == end:
                -1:
                    mut difference_info: i64 = find_additive_operator(open_start + 1, close_start)
                    match difference_info > 0:
                        -1:
                            mut difference_operator: i64 = difference_info / 10
                            mut difference_left_end: i64 = trim_expression_end(open_start + 1, difference_operator)
                            mut difference_right_start: i64 = skip_spaces(difference_operator + 1, close_start)
                            mut difference_right_stop: i64 = number_end(difference_right_start, close_start)
                            match read_byte(difference_operator) == 45:
                                -1:
                                    match parse_nested_call_shape(first_non_space(open_start + 1, difference_left_end), difference_left_end) > 0:
                                        -1:
                                            match parse_literal_expression(difference_right_start, difference_right_stop) > 0:
                                                -1:
                                                    match skip_spaces(difference_right_stop, close_start) == close_start:
                                                        -1:
                                                            return parse_nested_call_shape(first_non_space(open_start + 1, difference_left_end), difference_left_end)
                                                        0:
                                                            return 0
                                                        1:
                                                            return 0
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_nested_additive_call_shape(start: i64, end: i64) -> i64:
    mut outer_start: i64 = first_non_space(start, end)
    mut outer_stop: i64 = word_end(outer_start, end)
    match is_identifier_span(outer_start, outer_stop):
        -1:
            mut outer_after: i64 = skip_spaces(outer_stop, end)
            match expect_byte(outer_after, end, 40):
                -1:
                    mut outer_close: i64 = matching_close(outer_after, end)
                    match outer_close > 0:
                        -1:
                            match skip_spaces(outer_close + 1, end) == end:
                                -1:
                                    mut inner_start: i64 = first_non_space(outer_after + 1, outer_close)
                                    mut inner_stop: i64 = word_end(inner_start, outer_close)
                                    match is_identifier_span(inner_start, inner_stop):
