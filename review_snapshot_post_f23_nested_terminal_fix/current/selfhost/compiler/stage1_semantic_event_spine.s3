    mut value_stop: i64 = word_end(cursor, end)
    match is_identifier_span(value_start, value_stop):
        -1:
            cursor = skip_spaces(value_stop, end)
            match cursor == end:
                -1:
                    return parsed_type * 1000000000000000 + name_start * 1000000000 + (name_stop - name_start) * 1000000
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

