                                    mut neutral_jump_id: i64 = negative_context * 1000000 + condition_count
                                    mut positive_jump_id: i64 = positive_context * 1000000 + condition_count + 1
                                    discard emit_v3_i_block(neutral_jump_id, neutral_context, neutral_block, ordinal + condition_count, 24, 0, 0, -1, -1)
                                    discard emit_v3_t_jump(neutral_jump_id, successor_block)
                                    discard emit_v3_i_block(positive_jump_id, positive_context, positive_block, ordinal + condition_count + 1, 24, 0, 0, -1, -1)
                                    discard emit_v3_t_jump(positive_jump_id, successor_block)
