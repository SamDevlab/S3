            mut outer_open: i64 = skip_spaces(outer_stop, end)
            match expect_byte(outer_open, end, 40):
                -1:
                    mut outer_close: i64 = matching_close(outer_open, end)
                    match outer_close > 0:
                        -1:
                            match skip_spaces(outer_close + 1, end) == end:
                                -1:
                                    mut first_start: i64 = first_non_space(outer_open + 1, outer_close)
                                    mut first_stop: i64 = word_end(first_start, outer_close)
