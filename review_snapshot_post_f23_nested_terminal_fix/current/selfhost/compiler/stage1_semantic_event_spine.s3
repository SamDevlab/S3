fn scan_pack_token_return_call(mode: i64, function_id: i64, header_start: i64, header_end: i64, body_limit: i64, start: i64, end: i64, value_id: i64) -> i64:
    match parse_pack_token_return_call(start, end) > 0:
        -1:
            mut callee_start: i64 = first_non_space(start, end)
            mut callee_stop: i64 = word_end(callee_start, end)
            mut cursor: i64 = skip_spaces(callee_stop, end)
            cursor += 1
            mut first_start: i64 = first_non_space(cursor, end)
            mut first_stop: i64 = word_end(first_start, end)
            cursor = skip_spaces(first_stop, end)
            cursor += 1
            mut second_start: i64 = first_non_space(cursor, end)
            mut second_stop: i64 = number_end(second_start, end)
            cursor = skip_spaces(second_stop, end)
            cursor += 1
            mut third_start: i64 = first_non_space(cursor, end)
            mut third_stop: i64 = number_end(third_start, end)
            mut first_type: i64 = resolve_value_type(header_start, header_end, body_limit, first_start, first_stop)
            mut signature: i64 = find_function_signature(callee_start, callee_stop)
            match signature > 0:
                -1:
                    mut result_type: i64 = signature / 100
                    mut parameter_type: i64 = signature - result_type * 100
                    match result_type == 3:
                        -1:
                            match parameter_type == 3:
                                -1:
                                    match first_type == 3:
                                        -1:
                                            mut next_id: i64 = value_id
                                            discard record_v(mode, next_id, function_id, 3, 2, first_start, 0, 0, -1)
                                            next_id += 1
                                            discard record_v(mode, next_id, function_id, 4, first_type, first_start, 0, 0, -1)
                                            next_id += 1
                                            discard record_v(mode, next_id, function_id, 3, 3, second_start, 0, 0, -1)
                                            next_id += 1
                                            discard record_v(mode, next_id, function_id, 3, 3, third_start, 0, 0, -1)
                                            next_id += 1
                                            discard record_v(mode, next_id, function_id, 4, result_type, callee_start, 0, 0, -1)
                                            return next_id + 1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_pack_token_return_add_call(mode: i64, function_id: i64, header_start: i64, header_end: i64, body_limit: i64, start: i64, end: i64, value_id: i64) -> i64:
