fn has_additive_operator(start: i64, end: i64) -> trit:
    mut cursor: i64 = start + 1
    while cursor < end:
        match read_byte(cursor) == 43:
            -1:
                return -1
            0:
                match read_byte(cursor) == 45:
                    -1:
                        return -1
                    0:
                        discard 0
                    1:
                        return -1
            1:
                return -1
        cursor += 1
    return 0

fn relational_lane_result(operator_start: i64, lane: i64) -> i64:
    mut operator_length: i64 = comparison_operator_length(operator_start, s3_stage1_source_length())
    mut result: i64 = 0
    match operator_length == 3:
        -1:
            match read_byte(operator_start) == 60:
                -1:
                    match read_byte(operator_start + 1) == 61:
                        -1:
                            match read_byte(operator_start + 2) == 62:
                                -1:
                                    return lane
                                0:
                                    discard 0
                                1:
                                    discard 0
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
        0:
            discard 0
        1:
            discard 0
    match read_byte(operator_start) == 60:
        -1:
            match operator_length == 1:
                -1:
                    match lane < 0:
                        -1:
                            result = -1
                        0:
                            result = 0
                        1:
                            result = 0
                0:
                    match operator_length == 2:
                        -1:
                            match lane <= 0:
                                -1:
                                    result = -1
                                0:
                                    result = 0
                                1:
                                    result = 0
                        0:
                            result = 0
                        1:
                            result = 0
                1:
                    result = 0
        0:
            match read_byte(operator_start) == 62:
                -1:
                    match operator_length == 1:
                        -1:
                            match lane > 0:
                                -1:
                                    result = -1
                                0:
                                    result = 0
                                1:
                                    result = 0
                        0:
                            match operator_length == 2:
                                -1:
                                    match lane >= 0:
                                        -1:
                                            result = -1
                                        0:
                                            result = 0
                                        1:
                                            result = 0
                                0:
                                    result = 0
                                1:
                                    result = 0
                        1:
                            result = 0
                0:
                    match read_byte(operator_start) == 61:
                        -1:
                            match operator_length == 2:
                                -1:
                                    match lane == 0:
                                        -1:
                                            result = -1
                                        0:
                                            result = 0
                                        1:
                                            result = 0
                                0:
                                    result = 0
                                1:
                                    result = 0
                        0:
                            match read_byte(operator_start) == 33:
                                -1:
                                    match operator_length == 2:
                                        -1:
                                            match lane == 0:
                                                -1:
                                                    result = 0
                                                0:
                                                    result = -1
                                                1:
                                                    result = -1
                                        0:
                                            result = 0
                                        1:
                                            result = 0
                                0:
                                    result = 0
                                1:
                                    result = 0
                        1:
                            result = 0
                1:
                    result = 0
        1:
            result = 0
    return result

fn parse_return_comparison(start: i64, end: i64) -> i64:
    # A raw relation is a trit-valued expression. Keep its operand spans in
    # the return marker so lowering can emit COMPARE rather than a synthetic
    # boolean value. This first rule deliberately covers the common bounded
    # identifier <=> integer form; other relational lowering remains separate.
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 3360570672, 6):
        -1:
            cursor = skip_spaces(word_stop, end)
            mut left_start: i64 = cursor
            mut left_stop: i64 = word_end(left_start, end)
            match is_identifier_span(left_start, left_stop):
                -1:
                    cursor = skip_spaces(left_stop, end)
                    match expect_byte(cursor, end, 60):
                        -1:
                            match expect_byte(cursor + 1, end, 61):
                                -1:
                                    match expect_byte(cursor + 2, end, 62):
                                        -1:
                                            cursor = skip_spaces(cursor + 3, end)
                                            mut right_start: i64 = cursor
                                            match read_byte(cursor) == 45:
                                                -1:
                                                    cursor += 1
                                                0:
                                                    discard 0
                                                1:
                                                    discard 0
                                            match is_digit(read_byte(cursor)):
                                                -1:
                                                    mut right_stop: i64 = number_end(cursor, end)
                                                    cursor = skip_spaces(right_stop, end)
                                                    match cursor == end:
                                                        -1:
                                                            return left_start * 1000000000000 + left_stop * 1000000 + right_start
                                                        0:
                                                            return 0
                                                        1:
                                                            return 0
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_return_relational(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 3360570672, 6):
        -1:
            cursor = skip_spaces(word_stop, end)
            mut left_start: i64 = cursor
            mut left_stop: i64 = word_end(left_start, end)
            match is_identifier_span(left_start, left_stop):
                -1:
                    cursor = skip_spaces(left_stop, end)
                    mut operator_start: i64 = cursor
                    mut operator_length: i64 = comparison_operator_length(operator_start, end)
                    match operator_length > 0:
                        -1:
                            match operator_length < 3:
                                -1:
                                    cursor = skip_spaces(operator_start + operator_length, end)
                                    mut right_start: i64 = cursor
                                    match read_byte(cursor) == 45:
                                        -1:
                                            cursor += 1
                                        0:
                                            discard 0
                                        1:
                                            discard 0
                                    match is_digit(read_byte(cursor)):
                                        -1:
                                            mut right_stop: i64 = number_end(cursor, end)
                                            cursor = skip_spaces(right_stop, end)
                                            match cursor == end:
                                                -1:
                                                    return left_start * 1000000000000 + left_stop * 1000000 + operator_start
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_return(start: i64, end: i64) -> i64:
    mut comparison_info: i64 = parse_return_comparison(start, end)
    match comparison_info > 0:
        -1:
            return 2000000000000000 + comparison_info
        0:
            discard 0
        1:
            return 0
    mut relational_info: i64 = parse_return_relational(start, end)
    match relational_info > 0:
        -1:
            return 3000000000000000 + relational_info
        0:
            discard 0
        1:
            discard 0
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 3360570672, 6):
        -1:
            cursor = skip_spaces(word_stop, end)
        0:
            return 0
        1:
            return 0
    mut expression_start: i64 = cursor
    match read_byte(cursor) == 45:
        -1:
            cursor += 1
        0:
            discard 0
        1:
            discard 0
    match is_digit(read_byte(cursor)):
        -1:
            mut expression_stop: i64 = number_end(cursor, end)
            cursor = skip_spaces(expression_stop, end)
            match cursor == end:
                -1:
                    return expression_start * 1000000 + expression_stop
                0:
                    return 0
                1:
                    return 0
        0:
            mut identifier_stop: i64 = word_end(expression_start, end)
            match identifier_stop > expression_start:
                -1:
                    cursor = skip_spaces(identifier_stop, end)
                    match cursor == end:
                        -1:
                            return 0 - (expression_start * 1000000 + identifier_stop)
                        0:
                            match has_additive_operator(expression_start, end):
                                -1:
                                    return 1000000000000000 + expression_start * 1000000 + end
                                0:
                                    return 0
                                1:
                                    return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        1:
            return 0

fn parse_call_callee(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut callee_start: i64 = cursor
    mut callee_stop: i64 = word_end(cursor, end)
    match is_identifier_span(callee_start, callee_stop):
        -1:
            cursor = skip_spaces(callee_stop, end)
            match expect_byte(cursor, end, 40):
                -1:
                    cursor += 1
                    cursor = skip_spaces(cursor, end)
                    match cursor < end:
                        -1:
                            match read_byte(cursor) == 41:
                                -1:
                                    cursor += 1
                                0:
                                    mut argument_start: i64 = cursor
                                    mut argument_stop: i64 = word_end(cursor, end)
                                    match is_identifier_span(argument_start, argument_stop):
                                        -1:
                                            cursor = skip_spaces(argument_stop, end)
                                            match expect_byte(cursor, end, 41):
                                                -1:
                                                    cursor += 1
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                    cursor = skip_spaces(cursor, end)
                    match cursor == end:
                        -1:
                            return callee_start * 1000000 + callee_stop
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_call_expression_callee(start: i64, end: i64) -> i64:
    # Callee identity is independent from the expression grammar used by its
    # arguments.  Keep the balanced call boundary here and let the shared
    # argument resolver validate the contents compositionally.
    mut cursor: i64 = first_non_space(start, end)
    mut callee_start: i64 = cursor
    mut callee_stop: i64 = word_end(cursor, end)
    match is_identifier_span(callee_start, callee_stop):
        -1:
            mut call_open: i64 = skip_spaces(callee_stop, end)
            match expect_byte(call_open, end, 40):
                -1:
                    mut call_close: i64 = matching_close(call_open, end)
                    match call_close > 0:
                        -1:
                            return callee_start * 1000000 + callee_stop
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn resolve_additive_expression_type(start: i64, end: i64, header_start: i64, header_end: i64) -> i64:
    mut additive_info: i64 = find_additive_operator(start, end)
    match additive_info > 0:
        -1:
            mut additive_operator: i64 = additive_info / 10
            mut left_end: i64 = trim_expression_end(start, additive_operator)
            mut left_start: i64 = first_non_space(start, left_end)
            mut left_stop: i64 = word_end(left_start, left_end)
            match is_identifier_span(left_start, left_stop):
                -1:
                    match skip_spaces(left_stop, left_end) == left_end:
                        -1:
                            mut right_start: i64 = skip_spaces(additive_operator + 1, end)
                            mut right_cursor: i64 = right_start
                            match read_byte(right_cursor) == 45:
                                -1:
                                    right_cursor += 1
                                0:
                                    discard 0
                                1:
                                    discard 0
                            match is_digit(read_byte(right_cursor)):
                                -1:
                                    mut right_stop: i64 = number_end(right_cursor, end)
                                    match skip_spaces(right_stop, end) == end:
                                        -1:
                                            mut left_type: i64 = resolve_value_type(header_start, header_end, start, left_start, left_stop)
                                            match left_type > 0:
                                                -1:
                                                    return left_type
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_simple_call_argument_end(start: i64, end: i64) -> i64:
    mut argument_start: i64 = first_non_space(start, end)
    mut cursor: i64 = argument_start
    match read_byte(cursor) == 45:
        -1:
            cursor += 1
        0:
            discard 0
        1:
            discard 0
    match is_digit(read_byte(cursor)):
        -1:
            return number_end(cursor, end)
        0:
            mut argument_stop: i64 = word_end(argument_start, end)
            match is_identifier_span(argument_start, argument_stop):
                -1:
                    return argument_stop
                0:
                    return 0
                1:
                    return 0
        1:
            return 0

fn parse_call_three_arguments(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut callee_start: i64 = cursor
    mut callee_stop: i64 = word_end(cursor, end)
    match is_identifier_span(callee_start, callee_stop):
        -1:
            cursor = skip_spaces(callee_stop, end)
            match expect_byte(cursor, end, 40):
                -1:
                    cursor += 1
                    mut first_start: i64 = first_non_space(cursor, end)
                    mut first_stop: i64 = parse_simple_call_argument_end(first_start, end)
                    match first_stop > first_start:
                        -1:
                            cursor = skip_spaces(first_stop, end)
                            match expect_byte(cursor, end, 44):
                                -1:
                                    cursor += 1
                                    mut second_start: i64 = first_non_space(cursor, end)
                                    mut second_stop: i64 = parse_simple_call_argument_end(second_start, end)
                                    match second_stop > second_start:
                                        -1:
                                            cursor = skip_spaces(second_stop, end)
                                            match expect_byte(cursor, end, 44):
                                                -1:
                                                    cursor += 1
                                                    mut third_start: i64 = first_non_space(cursor, end)
                                                    mut third_stop: i64 = parse_simple_call_argument_end(third_start, end)
                                                    match third_stop > third_start:
                                                        -1:
                                                            cursor = skip_spaces(third_stop, end)
                                                            match expect_byte(cursor, end, 41):
                                                                -1:
                                                                    cursor += 1
                                                                    match skip_spaces(cursor, end) == end:
                                                                        -1:
                                                                            return callee_start * 1000000 + callee_stop
                                                                        0:
                                                                            return 0
                                                                        1:
                                                                            return 0
                                                                0:
                                                                    return 0
                                                                1:
                                                                    return 0
                                                        0:
                                                            return 0
                                                        1:
                                                            return 0
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_call_additive_nested_three_arguments(start: i64, end: i64) -> i64:
    mut valid: trit = -1
    mut outer_start: i64 = first_non_space(start, end)
    mut outer_stop: i64 = word_end(outer_start, end)
    mut outer_after: i64 = 0
    mut outer_close: i64 = 0
    mut first_start: i64 = 0
    mut first_stop: i64 = 0
    mut additive_info: i64 = 0
    mut additive_operator: i64 = 0
    mut additive_kind: i64 = 0
    mut left_end: i64 = 0
    mut left_start: i64 = 0
    mut left_stop: i64 = 0
    mut first_literal_cursor: i64 = 0
    mut first_literal_stop: i64 = 0
    mut first_comma: i64 = 0
    mut second_start: i64 = 0
    mut second_cursor: i64 = 0
    mut second_stop: i64 = 0
    mut second_comma: i64 = 0
    mut third_start: i64 = 0
    mut third_stop: i64 = 0
    mut inner_open: i64 = 0
    mut inner_close: i64 = 0
    mut inner_argument_start: i64 = 0
    mut inner_argument_stop: i64 = 0
    match is_identifier_span(outer_start, outer_stop):
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match valid == -1:
        -1:
            outer_after = skip_spaces(outer_stop, end)
            match expect_byte(outer_after, end, 40):
                -1:
                    outer_close = matching_close(outer_after, end)
                    match outer_close > 0:
                        -1:
                            match skip_spaces(outer_close + 1, end) == end:
                                -1:
                                    discard 0
                                0:
                                    valid = 0
                                1:
                                    valid = 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            discard 0
        1:
            discard 0
    match valid == -1:
        -1:
            first_start = first_non_space(outer_after + 1, outer_close)
            additive_info = find_additive_operator(first_start, outer_close)
            match additive_info > 0:
                -1:
                    additive_operator = additive_info / 10
                    additive_kind = additive_info - additive_operator * 10
                    match additive_kind == 1:
                        -1:
                            discard 0
                        0:
                            match additive_kind == 2:
                                -1:
                                    discard 0
                                0:
                                    valid = 0
                                1:
                                    valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            discard 0
        1:
            discard 0
    match valid == -1:
        -1:
            left_end = trim_expression_end(first_start, additive_operator)
            left_start = first_non_space(first_start, left_end)
            left_stop = word_end(left_start, left_end)
            match is_identifier_span(left_start, left_stop):
                -1:
                    match skip_spaces(left_stop, left_end) == left_end:
                        -1:
                            first_literal_cursor = first_non_space(additive_operator + 1, outer_close)
                            match read_byte(first_literal_cursor) == 45:
                                -1:
                                    first_literal_cursor += 1
                                0:
                                    discard 0
                                1:
                                    discard 0
                            first_literal_stop = number_end(first_literal_cursor, outer_close)
                            match is_digit(read_byte(first_literal_cursor)):
                                -1:
                                    first_comma = skip_spaces(first_literal_stop, outer_close)
                                    match expect_byte(first_comma, outer_close, 44):
                                        -1:
                                            discard 0
                                        0:
                                            valid = 0
                                        1:
                                            valid = 0
                                0:
                                    valid = 0
                                1:
                                    valid = 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            discard 0
        1:
            discard 0
    match valid == -1:
        -1:
            second_start = first_non_space(first_comma + 1, outer_close)
            second_cursor = second_start
            match read_byte(second_cursor) == 45:
                -1:
                    second_cursor += 1
                0:
                    discard 0
                1:
                    discard 0
            second_stop = number_end(second_cursor, outer_close)
            match is_digit(read_byte(second_cursor)):
                -1:
                    second_comma = skip_spaces(second_stop, outer_close)
                    match expect_byte(second_comma, outer_close, 44):
                        -1:
                            discard 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            discard 0
        1:
            discard 0
    match valid == -1:
        -1:
            third_start = first_non_space(second_comma + 1, outer_close)
            third_stop = word_end(third_start, outer_close)
            match is_identifier_span(third_start, third_stop):
                -1:
                    inner_open = skip_spaces(third_stop, outer_close)
                    match expect_byte(inner_open, outer_close, 40):
                        -1:
                            inner_close = matching_close(inner_open, outer_close)
                            match inner_close > 0:
                                -1:
                                    match skip_spaces(inner_close + 1, outer_close) == outer_close:
                                        -1:
                                            inner_argument_start = first_non_space(inner_open + 1, inner_close)
                                            inner_argument_stop = word_end(inner_argument_start, inner_close)
                                            match is_identifier_span(inner_argument_start, inner_argument_stop):
                                                -1:
                                                    match skip_spaces(inner_argument_stop, inner_close) == inner_close:
                                                        -1:
                                                            discard 0
                                                        0:
                                                            valid = 0
                                                        1:
                                                            valid = 0
                                                0:
                                                    valid = 0
                                                1:
                                                    valid = 0
                                        0:
                                            valid = 0
                                        1:
                                            valid = 0
                                0:
                                    valid = 0
                                1:
                                    valid = 0
                        0:
                            valid = 0
                        1:
                            valid = 0
                0:
                    valid = 0
                1:
                    valid = 0
        0:
            valid = 0
        1:
            valid = 0
    match valid == -1:
        -1:
            return outer_start * 1000000 + outer_stop
        0:
            return 0
        1:
            return 0

fn parse_call_one_argument(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut callee_start: i64 = cursor
    mut callee_stop: i64 = word_end(cursor, end)
    match is_identifier_span(callee_start, callee_stop):
        -1:
            cursor = skip_spaces(callee_stop, end)
            match expect_byte(cursor, end, 40):
                -1:
                    cursor += 1
                    mut argument_start: i64 = first_non_space(cursor, end)
                    mut argument_stop: i64 = parse_simple_call_argument_end(argument_start, end)
                    match argument_stop > argument_start:
                        -1:
                            cursor = skip_spaces(argument_stop, end)
                            match expect_byte(cursor, end, 41):
                                -1:
                                    cursor += 1
                                    match skip_spaces(cursor, end) == end:
                                        -1:
                                            return callee_start * 1000000 + callee_stop
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_call_argument_span(start: i64, end: i64, target_ordinal: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut callee_stop: i64 = word_end(cursor, end)
    cursor = skip_spaces(callee_stop, end)
    match expect_byte(cursor, end, 40):
        -1:
            cursor += 1
            mut argument_start: i64 = first_non_space(cursor, end)
            mut argument_stop: i64 = parse_simple_call_argument_end(argument_start, end)
            match target_ordinal == 0:
                -1:
                    return argument_start * 1000000 + argument_stop
                0:
                    cursor = skip_spaces(argument_stop, end)
                    match expect_byte(cursor, end, 44):
                        -1:
                            cursor += 1
                            argument_start = first_non_space(cursor, end)
                            argument_stop = parse_simple_call_argument_end(argument_start, end)
                            match target_ordinal == 1:
                                -1:
                                    return argument_start * 1000000 + argument_stop
                                0:
                                    cursor = skip_spaces(argument_stop, end)
                                    match expect_byte(cursor, end, 44):
                                        -1:
                                            cursor += 1
                                            argument_start = first_non_space(cursor, end)
                                            argument_stop = parse_simple_call_argument_end(argument_start, end)
                                            return argument_start * 1000000 + argument_stop
                                        0:
                                            return 0
                                        1:
                                            return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn call_argument_is_literal(argument_span: i64) -> trit:
    mut argument_start: i64 = argument_span / 1000000
    match read_byte(argument_start) == 45:
        -1:
            return is_digit(read_byte(argument_start + 1))
        0:
            return is_digit(read_byte(argument_start))
        1:
            return is_digit(read_byte(argument_start))

fn count_call_literal_arguments(start: i64, end: i64) -> i64:
    mut ordinal: i64 = 0
    mut count: i64 = 0
    while ordinal < 3:
        mut argument_span: i64 = parse_call_argument_span(start, end, ordinal)
        match call_argument_is_literal(argument_span):
            -1:
                count += 1
            0:
                discard 0
            1:
                discard 0
        ordinal += 1
    return count

fn count_one_call_literal_arguments(start: i64, end: i64) -> i64:
    mut argument_span: i64 = parse_call_argument_span(start, end, 0)
    match call_argument_is_literal(argument_span):
        -1:
            return 1
        0:
            return 0
        1:
            return 0

fn count_direct_call_instructions(first: i64, stop: i64) -> i64:
    mut call_start: i64 = skip_spaces(word_end(first, stop), stop)
    mut three_call_info: i64 = parse_call_three_arguments(call_start, stop)
    match three_call_info > 0:
        -1:
            return count_call_literal_arguments(call_start, stop) + 2
        0:
            mut one_call_info: i64 = parse_call_one_argument(call_start, stop)
            match one_call_info > 0:
                -1:
                    mut first_word_stop: i64 = word_end(first, stop)
                    match word_is(first, first_word_stop, 91865680030, 7):
                        -1:
                            return count_one_call_literal_arguments(call_start, stop) + 1
                        0:
                            return 2
                        1:
                            return 2
                0:
                    return 0
                1:
                    return 0
        1:
            return 0

fn count_direct_call_values(first: i64, stop: i64) -> i64:
    mut call_start: i64 = skip_spaces(word_end(first, stop), stop)
    mut three_call_info: i64 = parse_call_three_arguments(call_start, stop)
    match three_call_info > 0:
        -1:
            return count_call_literal_arguments(call_start, stop) + 1
        0:
            mut one_call_info: i64 = parse_call_one_argument(call_start, stop)
            match one_call_info > 0:
                -1:
                    return count_one_call_literal_arguments(call_start, stop) + 1
                0:
                    return 0
                1:
                    return 0
        1:
            return 0

