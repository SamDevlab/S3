                        match same_span(binary_name_start, binary_name_start + binary_name_length, target_start, target_stop):
                            -1:
                                return next_id + 1
                            0:
                                discard 0
                            1:
                                discard 0
                        next_id += 2
                    0:
                        discard 0
                    1:
                        discard 0
                mut mutable_info: i64 = parse_mut(first, stop)
                match mutable_info > 0:
                    -1:
                        mut mutable_type: i64 = mutable_info / 1000000000000000
                        mut mutable_remainder: i64 = mutable_info - mutable_type * 1000000000000000
                        mut mutable_name_start: i64 = mutable_remainder / 1000000000
                        mutable_remainder = mutable_remainder - mutable_name_start * 1000000000
                        mut mutable_name_length: i64 = mutable_remainder / 1000000
                        match same_span(mutable_name_start, mutable_name_start + mutable_name_length, target_start, target_stop):
                            -1:
