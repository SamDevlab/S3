                                            mut nested_jump_id: i64 = nested_successor_context * 1000000 + condition_count + 1
                                            discard emit_v3_i_block(nested_jump_id, nested_successor_context, nested_result_block, condition_count + 1, 24, 0, 0, -1, -1)
                                            discard emit_v3_t_jump(nested_jump_id, successor_block)
