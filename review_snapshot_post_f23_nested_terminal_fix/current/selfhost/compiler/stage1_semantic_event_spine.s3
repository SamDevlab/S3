            mut operand_stop: i64 = word_end(cursor, end)
            match is_identifier_span(cursor, operand_stop):
                -1:
                    cursor = skip_spaces(operand_stop, end)
                    match expect_byte(cursor, end, 58):
                        -1:
                            cursor += 1
                            cursor = skip_spaces(cursor, end)
                            match cursor == end:
                                -1:
                                    return -1
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    match read_byte(cursor) == 45:
                        -1:
                            cursor += 1
                        0:
                            discard 0
                        1:
                            discard 0
                    match is_digit(read_byte(cursor)):
                        -1:
                            operand_stop = number_end(cursor, end)
                            cursor = skip_spaces(operand_stop, end)
                            match expect_byte(cursor, end, 58):
                                -1:
                                    cursor += 1
                                    cursor = skip_spaces(cursor, end)
                                    match cursor == end:
                                        -1:
                                            return -1
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn while_left_start(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    return skip_spaces(word_stop, end)

fn while_left_stop(start: i64, end: i64) -> i64:
    return word_end(while_left_start(start, end), end)

fn while_operator_start(start: i64, end: i64) -> i64:
    return skip_spaces(while_left_stop(start, end), end)

fn parse_match_call(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 103668165, 5):
        -1:
            mut expression_start: i64 = skip_spaces(word_stop, end)
            mut expression_end: i64 = call_expression_end(expression_start)
            return parse_call_callee(expression_start, expression_end)
        0:
            return 0
        1:
            return 0

fn parse_match_nested_call(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 103668165, 5):
        -1:
            mut expression_start: i64 = skip_spaces(word_stop, end)
            mut expression_end: i64 = call_expression_end(expression_start)
            mut nested_shape: i64 = parse_nested_call_shape(expression_start, expression_end)
            match nested_shape > 0:
                -1:
                    mut outer_start: i64 = nested_shape / 1000000000000
                    mut outer_stop: i64 = word_end(outer_start, expression_end)
                    return outer_start * 1000000 + outer_stop
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_match_nested_additive_call(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 103668165, 5):
        -1:
            mut outer_start: i64 = first_non_space(word_stop, end)
            mut outer_stop: i64 = word_end(outer_start, end)
            match is_identifier_span(outer_start, outer_stop):
                -1:
                    mut outer_open: i64 = skip_spaces(outer_stop, end)
                    match expect_byte(outer_open, end, 40):
                        -1:
                            mut outer_close: i64 = matching_close(outer_open, end)
                            match outer_close > 0:
                                -1:
                                    match read_byte(outer_close + 1) == 58:
                                        -1:
                                            mut inner_start: i64 = first_non_space(outer_open + 1, outer_close)
                                            mut inner_stop: i64 = word_end(inner_start, outer_close)
                                            match is_identifier_span(inner_start, inner_stop):
                                                -1:
                                                    mut inner_open: i64 = skip_spaces(inner_stop, outer_close)
                                                    match expect_byte(inner_open, outer_close, 40):
                                                        -1:
                                                            mut inner_close: i64 = matching_close(inner_open, outer_close)
                                                            match inner_close > 0:
                                                                -1:
                                                                    match skip_spaces(inner_close + 1, outer_close) == outer_close:
                                                                        -1:
                                                                            mut left_start: i64 = first_non_space(inner_open + 1, inner_close)
                                                                            mut left_stop: i64 = word_end(left_start, inner_close)
                                                                            match is_identifier_span(left_start, left_stop):
                                                                                -1:
                                                                                    mut operator_start: i64 = skip_spaces(left_stop, inner_close)
                                                                                    match expect_byte(operator_start, inner_close, 43):
                                                                                        -1:
                                                                                            mut literal_start: i64 = first_non_space(operator_start + 1, inner_close)
                                                                                            match is_digit(read_byte(literal_start)):
                                                                                                -1:
                                                                                                    mut literal_stop: i64 = number_end(literal_start, inner_close)
                                                                                                    match skip_spaces(literal_stop, inner_close) == inner_close:
                                                                                                        -1:
                                                                                                            return outer_start * 1000000 + outer_stop
                                                                                                        0:
                                                                                                            return 0
                                                                                                        1:
                                                                                                            return 0
                                                                                                0:
                                                                                                    return 0
                                                                                                1:
                                                                                                    return 0
                                                                                        0:
                                                                                            return 0
                                                                                        1:
                                                                                            return 0
                                                                                0:
                                                                                    return 0
                                                                                1:
                                                                                    return 0
                                                                        0:
                                                                            return 0
                                                                        1:
                                                                            return 0
                                                                0:
                                                                    return 0
                                                                1:
                                                                    return 0
                                                        0:
                                                            return 0
                                                        1:
                                                            return 0
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_match_nested_call_relation(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 103668165, 5):
        -1:
            mut callee_start: i64 = first_non_space(word_stop, end)
            mut callee_stop: i64 = word_end(callee_start, end)
            match is_identifier_span(callee_start, callee_stop):
                -1:
                    mut call_open: i64 = skip_spaces(callee_stop, end)
                    match expect_byte(call_open, end, 40):
                        -1:
                            mut call_close: i64 = matching_close(call_open, end)
                            match call_close > 0:
                                -1:
                                    mut argument_start: i64 = first_non_space(call_open + 1, call_close)
                                    mut argument_stop: i64 = word_end(argument_start, call_close)
                                    mut argument_after: i64 = skip_spaces(argument_stop, call_close)
                                    mut argument_valid: trit = 0
                                    match is_identifier_span(argument_start, argument_stop):
                                        -1:
                                            match argument_after == call_close:
                                                -1:
                                                    argument_valid = -1
                                                0:
                                                    mut additive_start: i64 = skip_spaces(argument_stop, call_close)
                                                    match expect_byte(additive_start, call_close, 43):
                                                        -1:
                                                            mut literal_start: i64 = first_non_space(additive_start + 1, call_close)
                                                            match is_digit(read_byte(literal_start)):
                                                                -1:
                                                                    mut literal_stop: i64 = number_end(literal_start, call_close)
                                                                    match skip_spaces(literal_stop, call_close) == call_close:
                                                                        -1:
                                                                            argument_valid = -1
                                                                        0:
                                                                            argument_valid = 0
                                                                        1:
                                                                            argument_valid = 0
                                                                0:
                                                                    argument_valid = 0
                                                                1:
                                                                    argument_valid = 0
                                                        0:
                                                            argument_valid = 0
                                                        1:
                                                            argument_valid = 0
                                                1:
                                                    argument_valid = 0
                                        0:
                                            argument_valid = 0
                                        1:
                                            argument_valid = 0
                                    match argument_valid == -1:
                                        -1:
                                            mut operator_start: i64 = skip_spaces(call_close + 1, end)
                                            mut operator_length: i64 = comparison_operator_length(operator_start, end)
                                            match operator_length > 0:
                                                -1:
                                                    mut right_start: i64 = skip_spaces(operator_start + operator_length, end)
                                                    mut right_cursor: i64 = right_start
                                                    match read_byte(right_cursor) == 45:
                                                        -1:
                                                            right_cursor += 1
                                                        0:
                                                            discard 0
                                                        1:
                                                            discard 0
                                                    mut right_stop: i64 = number_end(right_cursor, end)
                                                    match is_digit(read_byte(right_cursor)):
                                                        -1:
                                                            right_stop = number_end(right_cursor, end)
                                                        0:
                                                            right_stop = word_end(right_start, end)
                                                        1:
                                                            right_stop = word_end(right_start, end)
                                                    mut after_right: i64 = skip_spaces(right_stop, end)
                                                    match expect_byte(after_right, end, 58):
                                                        -1:
                                                            match skip_spaces(after_right + 1, end) == end:
                                                                -1:
                                                                    return callee_start * 1000000 + callee_stop
                                                                0:
                                                                    return 0
                                                                1:
                                                                    return 0
                                                        0:
                                                            return 0
                                                        1:
                                                            return 0
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

# A condition descriptor keeps expression-family selection separate from match
# CFG lowering.  The payload is one of the established parser descriptors;
# only the named accessors below decode its family tag.
fn match_condition_descriptor(start: i64, end: i64) -> i64:
    mut parsed: i64 = parse_match_nested_call_relation(start, end)
    match parsed > 0:
        -1:
            return 6000000000000000000 + parsed
        0:
            discard 0
        1:
            discard 0
    parsed = parse_match_nested_additive_call(start, end)
    match parsed > 0:
        -1:
            return 5000000000000000000 + parsed
        0:
            discard 0
        1:
            discard 0
    parsed = parse_match_nested_call(start, end)
    match parsed > 0:
        -1:
            return 4000000000000000000 + parsed
        0:
            discard 0
        1:
            discard 0
    parsed = parse_match_call(start, end)
    match parsed > 0:
        -1:
            return 3000000000000000000 + parsed
        0:
            discard 0
        1:
            discard 0
    parsed = parse_match_additive_relation(start, end)
    match parsed > 0:
        -1:
            return 7000000000000000000 + parsed
        0:
            discard 0
        1:
            discard 0
    parsed = parse_match_parameter_rhs_comparison(start, end)
    match parsed > 0:
        -1:
            return 2000000000000000000 + parsed
        0:
            discard 0
        1:
            discard 0
    parsed = parse_match_comparison(start, end)
    match parsed > 0:
        -1:
            return 1000000000000000000 + parsed
        0:
            return 0
        1:
            return 0

fn match_condition_kind(descriptor: i64) -> i64:
    match descriptor > 0:
        -1:
            return descriptor / 1000000000000000000
        0:
            return 0
        1:
            return 0

fn match_condition_payload(descriptor: i64) -> i64:
    mut kind: i64 = match_condition_kind(descriptor)
    match kind > 0:
        -1:
            return descriptor - kind * 1000000000000000000
        0:
            return 0
        1:
            return 0

fn match_condition_expression_kind(descriptor: i64) -> i64:
    mut kind: i64 = match_condition_kind(descriptor)
    match kind == 1:
        -1:
            return 1
        0:
            discard 0
        1:
            discard 0
    match kind == 2:
        -1:
            return 1
        0:
            discard 0
        1:
            discard 0
    match kind == 7:
        -1:
            return 2
        0:
            discard 0
        1:
            discard 0
    match kind == 3:
        -1:
            return 3
        0:
            discard 0
        1:
            discard 0
    match kind > 0:
        -1:
            return 4
        0:
            return 0
        1:
            return 0

fn match_condition_left_start(descriptor: i64) -> i64:
    mut kind: i64 = match_condition_kind(descriptor)
    mut payload: i64 = match_condition_payload(descriptor)
    match kind == 1:
        -1:
            return payload / 1000000000000
        0:
            discard 0
        1:
            discard 0
    match kind == 2:
        -1:
            return payload / 1000000000000
        0:
            discard 0
        1:
            discard 0
    match kind == 7:
        -1:
            return payload / 1000000000000
        0:
            discard 0
        1:
            discard 0
    return payload / 1000000

fn match_condition_left_stop(descriptor: i64) -> i64:
    mut kind: i64 = match_condition_kind(descriptor)
    mut payload: i64 = match_condition_payload(descriptor)
    match kind == 1:
        -1:
            mut left_start: i64 = payload / 1000000000000
            payload = payload - left_start * 1000000000000
            return payload / 1000000
        0:
            discard 0
        1:
            discard 0
    match kind == 2:
        -1:
            mut left_start: i64 = payload / 1000000000000
            payload = payload - left_start * 1000000000000
            return payload / 1000000
        0:
            discard 0
        1:
            discard 0
    match kind == 7:
        -1:
            mut left_start: i64 = payload / 1000000000000
            payload = payload - left_start * 1000000000000
            return payload / 1000000
        0:
            discard 0
        1:
            discard 0
    mut left_start: i64 = payload / 1000000
    return payload - left_start * 1000000

# These scalar context helpers are the shared owner for the ordinary
# three-arm successor layout and continuation packing.
fn match_arm_block(current_block_id: i64, arm_index: i64) -> i64:
    return current_block_id + arm_index + 1

fn match_successor_block(current_block_id: i64) -> i64:
    return current_block_id + 4

fn match_result_continuation(next_id: i64, next_cursor: i64, successor_block: i64) -> i64:
    mut result: i64 = 3000000000000 + successor_block * 100000000000
    result = result + next_id * 1000000 + next_cursor
    return result

fn match_result_terminal(next_id: i64, next_cursor: i64) -> i64:
    mut result: i64 = 2000000000000 + next_id * 1000000
    result = result + next_cursor
    return result

fn match_all_arms_terminal(negative_kind: i64, neutral_kind: i64, positive_kind: i64) -> trit:
    match negative_kind == 1:
        -1:
            match neutral_kind == 1:
                -1:
                    match positive_kind == 1:
                        -1:
                            return -1
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_positive_branch_label(start: i64, end: i64) -> i64:
    mut cursor: i64 = start
    match expect_byte(cursor, end, 48):
        -1:
            cursor += 1
        0:
            match expect_byte(cursor, end, 49):
                -1:
                    cursor += 1
                0:
                    return 0
                1:
                    return 0
        1:
            return 0
    match expect_byte(cursor, end, 58):
        -1:
            cursor += 1
            cursor = skip_spaces(cursor, end)
            match cursor == end:
                -1:
                    return 1
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_branch_label(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    match expect_byte(cursor, end, 45):
        -1:
            cursor += 1
            match expect_byte(cursor, end, 49):
                -1:
                    cursor += 1
                    match expect_byte(cursor, end, 58):
                        -1:
                            cursor += 1
                            cursor = skip_spaces(cursor, end)
                            match cursor == end:
                                -1:
                                    return 2
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return parse_positive_branch_label(cursor, end)
        1:
            return parse_positive_branch_label(cursor, end)

fn is_branch_label(start: i64, end: i64) -> trit:
    match parse_branch_label(start, end) > 0:
        -1:
            return -1
        0:
            return 0
        1:
            return 0

fn header_parameter_type(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 3272, 2):
        -1:
            cursor = skip_spaces(word_stop, end)
        0:
            return 0
        1:
            return 0
    word_stop = word_end(cursor, end)
    match is_identifier_span(cursor, word_stop):
        -1:
            cursor = skip_spaces(word_stop, end)
        0:
            return 0
        1:
            return 0
    match expect_byte(cursor, end, 40):
        -1:
            cursor += 1
            cursor = skip_spaces(cursor, end)
            match cursor < end:
                -1:
                    match read_byte(cursor) == 41:
                        -1:
                            return 0
                        0:
                            mut parameter_start: i64 = cursor
                            mut parameter_stop: i64 = word_end(cursor, end)
                            match is_identifier_span(parameter_start, parameter_stop):
                                -1:
                                    cursor = skip_spaces(parameter_stop, end)
                                0:
                                    return 0
                                1:
                                    return 0
                            match expect_byte(cursor, end, 58):
                                -1:
                                    cursor += 1
                                0:
                                    return 0
                                1:
                                    return 0
                            cursor = skip_spaces(cursor, end)
                            mut type_start: i64 = cursor
                            mut type_stop: i64 = word_end(cursor, end)
                            return type_code(type_start, type_stop)
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn find_function_signature(target_start: i64, target_end: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut cursor: i64 = 0
    while cursor < length:
        mut stop: i64 = line_end(cursor, length)
        mut first: i64 = first_non_space(cursor, stop)
        match first == cursor:
            -1:
                mut header_cursor: i64 = first
                mut foreign_flag: i64 = 0
                mut word_stop: i64 = word_end(header_cursor, stop)
                match word_is(header_cursor, word_stop, 93811605716, 7):
                    -1:
                        foreign_flag = 1
                        header_cursor = skip_spaces(word_stop, stop)
                    0:
                        discard 0
                    1:
                        discard 0
                word_stop = word_end(header_cursor, stop)
                match word_is(header_cursor, word_stop, 3272, 2):
                    -1:
                        mut name_start: i64 = skip_spaces(word_stop, stop)
                        mut name_stop: i64 = word_end(name_start, stop)
                        match same_span(name_start, name_stop, target_start, target_end):
                            -1:
                                mut require_colon: i64 = 1
                                match foreign_flag == 1:
                                    -1:
                                        require_colon = 0
                                    0:
                                        discard 0
                                    1:
                                        discard 0
                                mut header_info: i64 = parse_header(header_cursor, stop, require_colon)
                                match header_info > 0:
                                    -1:
                                        mut parsed_return: i64 = header_info / 10
                                        return parsed_return * 100 + header_parameter_type(header_cursor, stop)
                                    0:
                                        return 0
                                    1:
                                        return 0
                            0:
                                discard 0
                            1:
                                discard 0
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        cursor = stop + 1
    return 0

fn find_function_parameter_type_by_ordinal(target_start: i64, target_end: i64, target_ordinal: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut cursor: i64 = 0
    while cursor < length:
        mut stop: i64 = line_end(cursor, length)
        mut first: i64 = first_non_space(cursor, stop)
        match first == cursor:
            -1:
                mut header_cursor: i64 = first
                mut foreign_flag: i64 = 0
                mut word_stop: i64 = word_end(header_cursor, stop)
                match word_is(header_cursor, word_stop, 93811605716, 7):
                    -1:
                        foreign_flag = 1
                        header_cursor = skip_spaces(word_stop, stop)
                    0:
                        discard 0
                    1:
                        discard 0
                word_stop = word_end(header_cursor, stop)
                match word_is(header_cursor, word_stop, 3272, 2):
                    -1:
                        mut name_start: i64 = skip_spaces(word_stop, stop)
                        mut name_stop: i64 = word_end(name_start, stop)
                        match same_span(name_start, name_stop, target_start, target_end):
                            -1:
                                mut require_colon: i64 = 1
                                match foreign_flag == 1:
                                    -1:
                                        require_colon = 0
                                    0:
                                        discard 0
                                    1:
                                        discard 0
                                mut header_info: i64 = parse_header(header_cursor, stop, require_colon)
                                match header_info > 0:
                                    -1:
                                        mut parameter_cursor: i64 = skip_spaces(name_stop, stop)
                                        match expect_byte(parameter_cursor, stop, 40):
                                            -1:
                                                parameter_cursor += 1
                                                parameter_cursor = skip_spaces(parameter_cursor, stop)
                                                mut ordinal: i64 = 0
                                                match read_byte(parameter_cursor) == 41:
                                                    -1:
                                                        return 0
                                                    0:
                                                        while parameter_cursor < stop:
                                                            mut parameter_name_stop: i64 = word_end(parameter_cursor, stop)
                                                            parameter_cursor = skip_spaces(parameter_name_stop, stop)
                                                            match expect_byte(parameter_cursor, stop, 58):
                                                                -1:
                                                                    parameter_cursor += 1
                                                                    parameter_cursor = skip_spaces(parameter_cursor, stop)
                                                                    mut parameter_type_stop: i64 = word_end(parameter_cursor, stop)
                                                                    match ordinal == target_ordinal:
                                                                        -1:
                                                                            return type_code(parameter_cursor, parameter_type_stop)
                                                                        0:
                                                                            ordinal += 1
                                                                            parameter_cursor = skip_spaces(parameter_type_stop, stop)
                                                                            match read_byte(parameter_cursor) == 41:
                                                                                -1:
                                                                                    return 0
                                                                                0:
                                                                                    match expect_byte(parameter_cursor, stop, 44):
                                                                                        -1:
                                                                                            parameter_cursor += 1
                                                                                            parameter_cursor = skip_spaces(parameter_cursor, stop)
                                                                                        0:
                                                                                            return 0
                                                                                        1:
                                                                                            return 0
                                                                                1:
                                                                                    return 0
                                                                        1:
                                                                            return 0
                                                                0:
                                                                    return 0
                                                                1:
                                                                    return 0
                                                    1:
                                                        return 0
                                            0:
                                                return 0
                                            1:
                                                return 0
                                    0:
                                        return 0
                                    1:
                                        return 0
                            0:
                                discard 0
                            1:
                                discard 0
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        cursor = stop + 1
    return 0

fn count_internal_functions() -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut cursor: i64 = 0
    mut count: i64 = 0
    while cursor < length:
        mut stop: i64 = line_end(cursor, length)
        mut first: i64 = first_non_space(cursor, stop)
        match first == cursor:
            -1:
                mut word_stop: i64 = word_end(first, stop)
                match word_is(first, word_stop, 3272, 2):
                    -1:
                        count += 1
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        cursor = stop + 1
    return count

fn find_function_identity(target_start: i64, target_end: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut cursor: i64 = 0
    mut internal_count: i64 = 0
    mut foreign_count: i64 = 0
    while cursor < length:
        mut stop: i64 = line_end(cursor, length)
        mut first: i64 = first_non_space(cursor, stop)
        match first == cursor:
            -1:
                mut header_start: i64 = first
                mut foreign_flag: i64 = 0
                mut word_stop: i64 = word_end(header_start, stop)
                match word_is(header_start, word_stop, 93811605716, 7):
                    -1:
                        foreign_flag = 1
                        header_start = skip_spaces(word_stop, stop)
                    0:
                        discard 0
                    1:
                        discard 0
                word_stop = word_end(header_start, stop)
                match word_is(header_start, word_stop, 3272, 2):
                    -1:
                        mut name_start: i64 = skip_spaces(word_stop, stop)
                        mut name_stop: i64 = word_end(name_start, stop)
                        match same_span(name_start, name_stop, target_start, target_end):
                            -1:
                                match foreign_flag == 1:
                                    -1:
                                        return foreign_count * 10 + 2
                                    0:
                                        return internal_count * 10 + 1
                                    1:
                                        return internal_count * 10 + 1
                            0:
                                discard 0
                            1:
                                discard 0
                        match foreign_flag == 1:
                            -1:
                                foreign_count += 1
                            0:
                                internal_count += 1
                            1:
                                internal_count += 1
                    0:
                        discard 0
                    1:
                        discard 0
            0:
                discard 0
            1:
                discard 0
        cursor = stop + 1
    return 0

fn find_call_argument_type(start: i64, header_start: i64, header_end: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut end: i64 = call_expression_end(start)
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match is_identifier_span(cursor, word_stop):
        -1:
            cursor = skip_spaces(word_stop, end)
            match expect_byte(cursor, end, 40):
                -1:
                    mut call_close: i64 = matching_close(cursor, end)
                    match call_close > 0:
                        -1:
                            discard 0
                        0:
                            return 0
                        1:
                            return 0
                    cursor += 1
                    cursor = skip_spaces(cursor, end)
                    match cursor < end:
                        -1:
                            match read_byte(cursor) == 41:
                                -1:
                                    cursor += 1
                                    cursor = skip_spaces(cursor, end)
                                    match cursor == end:
                                        -1:
                                            return -1
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    mut argument_start: i64 = cursor
                                    mut argument_stop: i64 = word_end(cursor, end)
                                    mut additive_type: i64 = resolve_additive_expression_type(argument_start, call_close, header_start, header_end)
                                    match additive_type > 0:
                                        -1:
                                            return additive_type
                                        0:
                                            discard 0
                                        1:
                                            discard 0
                                    match is_identifier_span(argument_start, argument_stop):
                                        -1:
                                            cursor = skip_spaces(argument_stop, end)
                                            match expect_byte(cursor, end, 41):
                                                -1:
                                                    cursor += 1
                                                    cursor = skip_spaces(cursor, end)
                                                    match cursor == end:
                                                        -1:
                                                            mut argument_type: i64 = find_parameter_type(header_start, header_end, argument_start, argument_stop)
                                                            match argument_type > 0:
                                                                -1:
                                                                    return argument_type
                                                                0:
                                                                    mut local_type: i64 = find_local_type(header_end + 1, start, argument_start, argument_stop)
                                                                    match local_type > 0:
                                                                        -1:
                                                                            return local_type
                                                                        0:
                                                                            return 0
                                                                        1:
                                                                            return 0
                                                                1:
                                                                    return 0
                                                        0:
                                                            return 0
                                                        1:
                                                            return 0
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_call_return_type(start: i64, header_start: i64, header_end: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut end: i64 = call_expression_end(start)
    mut call_info: i64 = parse_call_expression_callee(start, end)
    match call_info > 0:
        -1:
            mut callee_start: i64 = call_info / 1000000
            mut callee_stop: i64 = call_info - callee_start * 1000000
            mut signature: i64 = resolve_call_signature(callee_start, callee_stop)
            match signature > 0:
                -1:
                    mut parsed_return: i64 = signature / 100
                    mut parameter_type: i64 = signature - parsed_return * 100
                    mut argument_type: i64 = find_call_argument_type(start, header_start, header_end)
                    match argument_type > 0:
                        -1:
                            match argument_type == parameter_type:
                                -1:
                                    return parsed_return
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            match argument_type == -1:
                                -1:
                                    match parameter_type == 0:
                                        -1:
                                            return parsed_return
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn parse_mut_call_binding(start: i64, end: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    match word_is(cursor, word_stop, 108492, 3):
        -1:
            cursor = skip_spaces(word_stop, end)
        0:
            return 0
        1:
            return 0
    mut name_start: i64 = cursor
    mut name_stop: i64 = word_end(cursor, end)
    match is_identifier_span(name_start, name_stop):
        -1:
            cursor = skip_spaces(name_stop, end)
        0:
            return 0
        1:
            return 0
    match expect_byte(cursor, end, 58):
        -1:
            cursor += 1
        0:
            return 0
        1:
            return 0
    cursor = skip_spaces(cursor, end)
    mut type_start: i64 = cursor
    mut type_stop: i64 = word_end(cursor, end)
    mut parsed_type: i64 = type_code(type_start, type_stop)
    match parsed_type > 0:
        -1:
            cursor = skip_spaces(type_stop, end)
        0:
            return 0
        1:
            return 0
    match expect_byte(cursor, end, 61):
        -1:
            cursor += 1
        0:
            return 0
        1:
            return 0
    cursor = skip_spaces(cursor, end)
    match parse_call_callee(cursor, end) > 0:
        -1:
            return parsed_type * 1000000000000 + name_start * 1000000 + name_stop
        0:
            return 0
        1:
            return 0

fn find_call_local_type(start: i64, end: i64, target_start: i64, target_end: i64) -> i64:
    mut packed: i64 = parse_mut_call_binding(start, end)
