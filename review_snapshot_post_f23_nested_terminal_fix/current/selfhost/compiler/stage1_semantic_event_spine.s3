                                        1:
                                            discard 0
                                    discard emit_v3_b_block(function_id, neutral_block, neutral_block, 1, v3_context_instruction_id(neutral_jump_id))
                                    discard emit_v3_b_block(function_id, positive_block, positive_block, 1, v3_context_instruction_id(positive_jump_id))
                                    mut encoded_next_id: i64 = 3000000000000 + successor_block * 100000000000
                                    encoded_next_id = encoded_next_id + negative_result_id * 1000000 + (positive_body_stop + 1)
                                    return encoded_next_id
                                0:
