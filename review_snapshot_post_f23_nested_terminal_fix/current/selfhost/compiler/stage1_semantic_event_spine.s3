                        -1:
                            return 2
                        0:
                            return 0
                        1:
                            return 0
                0:
                    match expect_byte(start, end, 62):
                        -1:
                            match expect_byte(start + 1, end, 61):
                                -1:
                                    return 2
                                0:
                                    return 1
                                1:
                                    return 1
                        0:
                            return 0
                        1:
                            return 0
                1:
                    return 0
        1:
