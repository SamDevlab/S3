            discard emit_v3_v(left_load_value, function_id, 3, left_type, left_start)
            discard emit_v3_i_block(left_index_id, function_id, current_block, ordinal, 1, 1, 0, -1, 0)
            discard emit_v3_r(left_index_id, 0, left_index_value)
            discard emit_v3_i_block(left_load_id, function_id, current_block, ordinal + 1, 15, 1, 1, left_storage_id, -1)
            discard emit_v3_o(left_load_id, 0, left_index_value)
            discard emit_v3_r(left_load_id, 0, left_load_value)
            discard emit_v3_v(right_value, function_id, 2, left_type, literal_start)
            discard emit_v3_i_block(right_id, function_id, current_block, ordinal + 2, 1, 1, 0, -1, parse_integer_literal(literal_start, literal_stop))
            discard emit_v3_r(right_id, 0, right_value)
            discard emit_v3_v(compare_value, function_id, 3, 1, operator_start)
            discard emit_v3_i_block(compare_id, function_id, current_block, ordinal + 3, 13, 1, 2, -1, -1)
            discard emit_v3_o(compare_id, 0, left_load_value)
            discard emit_v3_o(compare_id, 1, right_value)
            discard emit_v3_r(compare_id, 0, compare_value)
            discard emit_v3_i_block(branch_id, function_id, current_block, ordinal + 4, 25, 0, 1, -1, -1)
            discard emit_v3_o(branch_id, 0, compare_value)
            discard emit_v3_t_branch(branch_id, outer_negative_block, outer_neutral_block, outer_positive_block, compare_value)
            discard emit_v3_i_block(negative_jump_id, function_id, outer_negative_block, ordinal + 5, 24, 0, 0, -1, -1)
            discard emit_v3_t_jump(negative_jump_id, nested_match_block)
            discard emit_v3_i_block(neutral_jump_id, function_id, outer_neutral_block, ordinal + 6, 24, 0, 0, -1, -1)
