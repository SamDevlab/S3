            valid = 0
    match outer_identity > 0:
        -1:
            discard 0
        0:
            valid = 0
        1:
            valid = 0
    match valid == -1:
        -1:
            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
            mut base_id: i64 = function_id * 1000000 + ordinal
            mut index_id: i64 = base_id
            mut load_id: i64 = base_id + 1
            mut const_id: i64 = base_id + 2
            mut inner_call_id: i64 = base_id + 3
            mut outer_call_id: i64 = base_id + 4
            mut index_value: i64 = value_id
            mut load_value: i64 = value_id + 1
            mut literal_value: i64 = value_id + 2
            mut inner_value: i64 = value_id + 3
            mut outer_value: i64 = value_id + 4
            mut inner_function_id: i64 = inner_identity / 10
            mut inner_kind: i64 = inner_identity - inner_function_id * 10
            mut outer_function_id: i64 = outer_identity / 10
            mut outer_kind: i64 = outer_identity - outer_function_id * 10
            discard emit_v3_v(index_value, function_id, 2, 2, first_start)
            discard emit_v3_v(load_value, function_id, 3, first_type, first_start)
            discard emit_v3_v(literal_value, function_id, 2, inner_parameter_one_type, second_start)
            discard emit_v3_v(inner_value, function_id, 4, inner_result_type, inner_start)
            discard emit_v3_v(outer_value, function_id, 4, outer_result_type, outer_start)
            discard emit_v3_i(index_id, function_id, ordinal, 1, 1, 0, 0)
            discard emit_v3_r(index_id, 0, index_value)
            discard emit_v3_i_aux(load_id, function_id, ordinal + 1, 15, 1, 1, first_storage_id, -1)
            discard emit_v3_o(load_id, 0, index_value)
            discard emit_v3_r(load_id, 0, load_value)
            discard emit_v3_i(const_id, function_id, ordinal + 2, 1, 1, 0, parse_integer_literal(second_start, second_stop))
            discard emit_v3_r(const_id, 0, literal_value)
            discard emit_v3_i(inner_call_id, function_id, ordinal + 3, 14, 1, 2, -1)
            discard emit_v3_c(inner_call_id, inner_function_id, inner_kind, inner_start, inner_stop - inner_start)
            discard emit_v3_a(inner_call_id, 0, load_value)
            discard emit_v3_a(inner_call_id, 1, literal_value)
            discard emit_v3_o(inner_call_id, 0, load_value)
            discard emit_v3_o(inner_call_id, 1, literal_value)
            discard emit_v3_r(inner_call_id, 0, inner_value)
            discard emit_v3_i(outer_call_id, function_id, ordinal + 4, 14, 1, 1, -1)
            discard emit_v3_c(outer_call_id, outer_function_id, outer_kind, outer_start, outer_stop - outer_start)
            discard emit_v3_a(outer_call_id, 0, inner_value)
            discard emit_v3_o(outer_call_id, 0, inner_value)
            discard emit_v3_r(outer_call_id, 0, outer_value)
            return value_id + 5
        0:
            return -1
        1:
            return -1

fn scan_mutable_literal_assignment_v3(function_id: i64, header_end: i64, first: i64, target_start: i64, target_stop: i64, target_type: i64, expression_info: i64, value_id: i64) -> i64:
    mut storage_id: i64 = find_mutable_storage_id(header_end + 1, first, target_start, target_stop)
    match storage_id >= 0:
        -1:
            mut expression_start: i64 = expression_info / 1000000
            mut expression_end: i64 = expression_info - expression_start * 1000000
            mut literal_info: i64 = parse_literal_expression(expression_start, expression_end)
            match literal_info > 0:
                -1:
                    mut literal_start: i64 = literal_info - 1
                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                    mut const_id: i64 = function_id * 1000000 + ordinal
                    mut index_id: i64 = const_id + 1
                    mut store_id: i64 = const_id + 2
                    discard emit_v3_v(value_id, function_id, 2, target_type, literal_start)
                    discard emit_v3_v(value_id + 1, function_id, 2, 2, target_start)
                    discard emit_v3_i(const_id, function_id, ordinal, 1, 1, 0, parse_integer_literal(expression_start, expression_end))
                    discard emit_v3_r(const_id, 0, value_id)
                    discard emit_v3_i_aux(index_id, function_id, ordinal + 1, 1, 1, 0, -1, 0)
                    discard emit_v3_r(index_id, 0, value_id + 1)
                    discard emit_v3_i_aux(store_id, function_id, ordinal + 2, 16, 0, 2, storage_id, -1)
                    discard emit_v3_o(store_id, 0, value_id + 1)
                    discard emit_v3_o(store_id, 1, value_id)
                    return value_id + 2
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_mutable_binary_assignment_v3(function_id: i64, header_start: i64, header_end: i64, first: i64, target_start: i64, target_stop: i64, target_type: i64, expression_info: i64, value_id: i64) -> i64:
    mut storage_id: i64 = find_mutable_storage_id(header_end + 1, first, target_start, target_stop)
    mut expression_start: i64 = expression_info / 1000000
    mut expression_end: i64 = expression_info - expression_start * 1000000
    mut binary_info: i64 = parse_binary_literal_expression(expression_start, expression_end)
    match storage_id >= 0:
        -1:
            match binary_info > 0:
                -1:
                    mut operator_start: i64 = binary_info / 10
                    mut operator_kind: i64 = binary_info - operator_start * 10
                    mut left_end: i64 = trim_expression_end(expression_start, operator_start)
                    mut left_start: i64 = first_non_space(expression_start, left_end)
                    mut left_stop: i64 = word_end(left_start, left_end)
                    mut right_start: i64 = skip_spaces(operator_start + 1, expression_end)
                    mut right_stop: i64 = binary_right_operand_stop(right_start, expression_end)
                    mut left_literal: i64 = parse_literal_expression(left_start, left_end)
                    mut right_type: i64 = resolve_value_type(header_start, header_end, first, right_start, right_stop)
                    mut right_parameter_ordinal: i64 = find_parameter_ordinal(header_start, header_end, right_start, right_stop)
                    mut right_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, right_start, right_stop)
                    mut right_local_value_id: i64 = find_core_local_value_id(header_end + 1, first, right_start, right_stop)
                    mut right_operand_value_id: i64 = -1
                    mut right_index_value_id: i64 = -1
                    mut right_load_value_id: i64 = -1
                    mut parameter_count: i64 = count_header_parameters(header_start, header_end)
                    match target_type > 0:
                        -1:
                            match left_literal > 0:
                                -1:
                                    match right_type == target_type:
                                        -1:
                                            match right_stop > 0:
                                                -1:
                                                    match right_parameter_ordinal >= 0:
                                                        -1:
                                                            right_operand_value_id = value_id - parameter_count + right_parameter_ordinal
                                                        0:
                                                            match right_storage_id >= 0:
                                                                -1:
                                                                    right_index_value_id = value_id + 2
                                                                    right_load_value_id = value_id + 3
                                                                    right_operand_value_id = right_load_value_id
                                                                0:
                                                                    match right_local_value_id >= 0:
                                                                        -1:
                                                                            right_operand_value_id = right_local_value_id
                                                                        0:
                                                                            return -1
                                                                        1:
                                                                            return -1
                                                                1:
                                                                    return -1
                                                        1:
                                                            return -1
                                                    match right_operand_value_id >= 0:
                                                        -1:
                                                            mut target_index_value_id: i64 = value_id
                                                            mut literal_value_id: i64 = value_id + 1
                                                            mut next_value_id: i64 = value_id + 2
                                                            mut result_value_id: i64 = next_value_id
                                                            match right_storage_id >= 0:
                                                                -1:
                                                                    result_value_id = value_id + 4
                                                                    next_value_id = value_id + 5
                                                                0:
                                                                    next_value_id = value_id + 3
                                                                1:
                                                                    next_value_id = value_id + 3
                                                            mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                                                            mut literal_id: i64 = function_id * 1000000 + ordinal
                                                            mut instruction_ordinal: i64 = ordinal + 1
                                                            mut operation_id: i64 = function_id * 1000000 + instruction_ordinal
                                                            mut target_index_id: i64 = operation_id + 1
                                                            mut store_id: i64 = operation_id + 2
                                                            discard emit_v3_v(target_index_value_id, function_id, 2, 2, target_start)
                                                            discard emit_v3_v(literal_value_id, function_id, 2, target_type, left_start)
                                                            discard emit_v3_v(result_value_id, function_id, 3, target_type, operator_start)
                                                            discard emit_v3_i(literal_id, function_id, ordinal, 1, 1, 0, parse_integer_literal(left_start, left_end))
                                                            discard emit_v3_r(literal_id, 0, literal_value_id)
                                                            match right_storage_id >= 0:
                                                                -1:
                                                                    discard emit_v3_v(right_index_value_id, function_id, 2, 2, right_start)
                                                                    discard emit_v3_v(right_load_value_id, function_id, 3, target_type, right_start)
                                                                    discard emit_v3_i_aux(function_id * 1000000 + instruction_ordinal, function_id, instruction_ordinal, 1, 1, 0, -1, 0)
                                                                    discard emit_v3_r(function_id * 1000000 + instruction_ordinal, 0, right_index_value_id)
                                                                    discard emit_v3_i_aux(function_id * 1000000 + instruction_ordinal + 1, function_id, instruction_ordinal + 1, 15, 1, 1, right_storage_id, -1)
                                                                    discard emit_v3_o(function_id * 1000000 + instruction_ordinal + 1, 0, right_index_value_id)
                                                                    discard emit_v3_r(function_id * 1000000 + instruction_ordinal + 1, 0, right_load_value_id)
                                                                    instruction_ordinal += 2
                                                                    operation_id = function_id * 1000000 + instruction_ordinal
                                                                    target_index_id = operation_id + 1
                                                                    store_id = operation_id + 2
                                                                0:
                                                                    discard 0
                                                                1:
                                                                    discard 0
                                                            match operator_kind == 1:
                                                                -1:
                                                                    discard emit_v3_i(operation_id, function_id, instruction_ordinal, 5, 1, 2, -1)
                                                                0:
                                                                    discard emit_v3_i(operation_id, function_id, instruction_ordinal, 6, 1, 2, -1)
                                                                1:
                                                                    discard emit_v3_i(operation_id, function_id, instruction_ordinal, 5, 1, 2, -1)
                                                            discard emit_v3_o(operation_id, 0, literal_value_id)
                                                            discard emit_v3_o(operation_id, 1, right_operand_value_id)
                                                            discard emit_v3_r(operation_id, 0, result_value_id)
                                                            discard emit_v3_i_aux(target_index_id, function_id, instruction_ordinal + 1, 1, 1, 0, -1, 0)
                                                            discard emit_v3_r(target_index_id, 0, target_index_value_id)
                                                            discard emit_v3_i_aux(store_id, function_id, instruction_ordinal + 2, 16, 0, 2, storage_id, -1)
                                                            discard emit_v3_o(store_id, 0, target_index_value_id)
                                                            discard emit_v3_o(store_id, 1, result_value_id)
                                                            return next_value_id
                                                        0:
                                                            return -1
                                                        1:
                                                            return -1
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn validate_product_types(header_start: i64, header_end: i64, body_limit: i64, target_start: i64, target_type: i64, expression_info: i64) -> i64:
    mut expression_start: i64 = expression_info / 1000000
    mut expression_end: i64 = expression_info - expression_start * 1000000
    mut product_info: i64 = parse_product_literal(expression_start, expression_end)
    match product_info > 0:
        -1:
            mut operator_start: i64 = product_info / 10
            mut left_end: i64 = trim_expression_end(expression_start, operator_start)
            mut left_start: i64 = first_non_space(expression_start, left_end)
            mut left_stop: i64 = word_end(left_start, left_end)
            mut left_type: i64 = resolve_value_type(header_start, header_end, body_limit, left_start, left_stop)
            mut valid: trit = 0
            match left_type > 0:
                -1:
                    match left_type == target_type:
                        -1:
                            valid = -1
                        0:
                            discard 0
                        1:
                            discard 0
                0:
                    discard 0
                1:
                    discard 0
            match valid == -1:
                -1:
                    return product_info
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

fn scan_mutable_product_assignment_v3(function_id: i64, header_end: i64, first: i64, target_start: i64, target_stop: i64, target_type: i64, expression_info: i64, value_id: i64) -> i64:
    mut storage_id: i64 = find_mutable_storage_id(header_end + 1, first, target_start, target_stop)
    match storage_id >= 0:
        -1:
            mut expression_start: i64 = expression_info / 1000000
            mut expression_end: i64 = expression_info - expression_start * 1000000
            mut product_info: i64 = parse_product_literal(expression_start, expression_end)
            match product_info > 0:
                -1:
                    mut operator_start: i64 = product_info / 10
                    mut left_end: i64 = trim_expression_end(expression_start, operator_start)
                    mut left_start: i64 = first_non_space(expression_start, left_end)
                    mut left_stop: i64 = word_end(left_start, left_end)
                    mut right_start: i64 = skip_spaces(operator_start + 1, expression_end)
                    mut right_cursor: i64 = right_start
                    match read_byte(right_cursor) == 45:
                        -1:
                            right_cursor += 1
                        0:
                            discard 0
                        1:
                            discard 0
                    mut right_stop: i64 = number_end(right_cursor, expression_end)
                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                    mut base_id: i64 = function_id * 1000000 + ordinal
                    mut index_id: i64 = base_id
                    mut load_id: i64 = base_id + 1
                    mut const_id: i64 = base_id + 2
                    mut multiply_id: i64 = base_id + 3
                    mut store_index_id: i64 = base_id + 4
                    mut store_id: i64 = base_id + 5
                    mut index_value: i64 = value_id
                    mut load_value: i64 = value_id + 1
                    mut literal_value: i64 = value_id + 2
                    mut multiply_value: i64 = value_id + 3
                    mut store_index_value: i64 = value_id + 4
                    discard emit_v3_v(index_value, function_id, 2, 2, target_start)
                    discard emit_v3_v(load_value, function_id, 3, target_type, target_start)
                    discard emit_v3_v(literal_value, function_id, 2, target_type, right_start)
                    discard emit_v3_v(multiply_value, function_id, 3, target_type, operator_start)
                    discard emit_v3_v(store_index_value, function_id, 2, 2, target_start)
                    discard emit_v3_i(index_id, function_id, ordinal, 1, 1, 0, 0)
                    discard emit_v3_r(index_id, 0, index_value)
                    discard emit_v3_i_aux(load_id, function_id, ordinal + 1, 15, 1, 1, storage_id, -1)
                    discard emit_v3_o(load_id, 0, index_value)
                    discard emit_v3_r(load_id, 0, load_value)
                    discard emit_v3_i(const_id, function_id, ordinal + 2, 1, 1, 0, parse_integer_literal(right_start, right_stop))
                    discard emit_v3_r(const_id, 0, literal_value)
                    discard emit_v3_i(multiply_id, function_id, ordinal + 3, 7, 1, 2, -1)
                    discard emit_v3_o(multiply_id, 0, load_value)
                    discard emit_v3_o(multiply_id, 1, literal_value)
                    discard emit_v3_r(multiply_id, 0, multiply_value)
                    discard emit_v3_i_aux(store_index_id, function_id, ordinal + 4, 1, 1, 0, -1, 0)
                    discard emit_v3_r(store_index_id, 0, store_index_value)
                    discard emit_v3_i_aux(store_id, function_id, ordinal + 5, 16, 0, 2, storage_id, -1)
                    discard emit_v3_o(store_id, 0, store_index_value)
                    discard emit_v3_o(store_id, 1, multiply_value)
                    return value_id + 5
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_mutable_compound_assignment_v3(function_id: i64, header_start: i64, header_end: i64, body_limit: i64, first: i64, stop: i64, target_start: i64, target_stop: i64, target_type: i64, expression_info: i64, value_id: i64) -> i64:
    mut storage_id: i64 = find_mutable_storage_id(header_end + 1, first, target_start, target_stop)
    mut expression_start: i64 = expression_info / 1000000
    mut expression_end: i64 = expression_info - expression_start * 1000000
    mut additive_operator: i64 = find_additive_operator(expression_start, expression_end) / 10
    mut left_end: i64 = trim_expression_end(expression_start, additive_operator)
    mut multiplicative_operator: i64 = find_multiplicative_operator(expression_start, left_end) / 10
    mut literal_start: i64 = skip_spaces(multiplicative_operator + 1, left_end)
    mut literal_stop: i64 = number_end(literal_start, left_end)
    mut nested_expression_start: i64 = skip_spaces(additive_operator + 1, expression_end)
    mut call_info: i64 = parse_nested_call_shape(nested_expression_start, expression_end)
    mut difference_info: i64 = parse_nested_call_difference_shape(nested_expression_start, expression_end)
    match call_info > 0:
        -1:
            discard 0
        0:
            match difference_info > 0:
                -1:
                    call_info = difference_info
                0:
                    discard 0
                1:
                    discard 0
        1:
            discard 0
    mut outer_start: i64 = call_info / 1000000000000
    mut call_remainder: i64 = call_info - outer_start * 1000000000000
    mut inner_start: i64 = call_remainder / 1000000
    mut argument_start: i64 = call_remainder - inner_start * 1000000
    mut argument_stop: i64 = word_end(argument_start, expression_end)
    mut argument_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, argument_start, argument_stop)
    mut argument_type: i64 = resolve_value_type(header_start, header_end, body_limit, argument_start, argument_stop)
    mut inner_stop: i64 = word_end(inner_start, expression_end)
    mut inner_signature: i64 = find_function_signature(inner_start, inner_stop)
    mut inner_result_type: i64 = inner_signature / 100
    mut inner_callee_identity: i64 = find_function_identity(inner_start, inner_stop)
    mut inner_callee_function_id: i64 = inner_callee_identity / 10
    mut inner_callee_kind: i64 = inner_callee_identity - inner_callee_function_id * 10
    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
    mut base_id: i64 = function_id * 1000000 + ordinal
    mut target_index_id: i64 = base_id
    mut target_load_id: i64 = base_id + 1
    mut literal_id: i64 = base_id + 2
    mut multiply_id: i64 = base_id + 3
    mut argument_index_id: i64 = base_id + 4
    mut argument_load_id: i64 = base_id + 5
    mut call_id: i64 = base_id + 6
    mut convert_id: i64 = base_id + 7
    mut difference_literal_id: i64 = base_id + 8
    mut difference_id: i64 = base_id + 9
    mut add_id: i64 = base_id + 8
    mut store_index_id: i64 = base_id + 9
    mut store_id: i64 = base_id + 10
    mut target_index_value: i64 = value_id
    mut target_load_value: i64 = value_id + 1
    mut literal_value: i64 = value_id + 2
    mut multiply_value: i64 = value_id + 3
    mut argument_index_value: i64 = value_id + 4
    mut argument_load_value: i64 = value_id + 5
    mut call_value: i64 = value_id + 6
    mut convert_value: i64 = value_id + 7
    mut difference_literal_value: i64 = value_id + 8
    mut difference_value: i64 = value_id + 9
    mut add_value: i64 = value_id + 8
    mut store_index_value: i64 = value_id + 9
    mut difference_literal_start: i64 = 0
    mut difference_literal_stop: i64 = 0
    mut difference_operator: i64 = 0
    mut instruction_shift: i64 = 0
    match difference_info > 0:
        -1:
            mut difference_open_start: i64 = first_non_space(nested_expression_start, expression_end)
            mut difference_close_start: i64 = matching_close(difference_open_start, expression_end)
            difference_operator = find_additive_operator(difference_open_start + 1, difference_close_start) / 10
            difference_literal_start = skip_spaces(difference_operator + 1, difference_close_start)
            difference_literal_stop = number_end(difference_literal_start, difference_close_start)
            instruction_shift = 2
        0:
            discard 0
        1:
            discard 0
    match instruction_shift > 0:
        -1:
            add_id = base_id + 10
            store_index_id = base_id + 11
            store_id = base_id + 12
            add_value = value_id + 10
            store_index_value = value_id + 11
        0:
            discard 0
        1:
            add_id = base_id + 8
            store_index_id = base_id + 9
            store_id = base_id + 10
            add_value = value_id + 8
            store_index_value = value_id + 9
    match storage_id >= 0:
        -1:
            match argument_storage_id >= 0:
                -1:
                    match target_type == 3:
                        -1:
                            match argument_type == 3:
                                -1:
                                    match inner_result_type == 2:
                                        -1:
                                            discard emit_v3_v(target_index_value, function_id, 2, 2, target_start)
                                            discard emit_v3_v(target_load_value, function_id, 3, target_type, target_start)
                                            discard emit_v3_v(literal_value, function_id, 2, target_type, literal_start)
                                            discard emit_v3_v(multiply_value, function_id, 3, target_type, multiplicative_operator)
                                            discard emit_v3_v(argument_index_value, function_id, 2, 2, argument_start)
                                            discard emit_v3_v(argument_load_value, function_id, 3, argument_type, argument_start)
                                            discard emit_v3_v(call_value, function_id, 4, inner_result_type, inner_start)
                                            discard emit_v3_v(convert_value, function_id, 4, target_type, outer_start)
                                            match difference_info > 0:
                                                -1:
                                                    discard emit_v3_v(difference_literal_value, function_id, 2, target_type, difference_literal_start)
                                                    discard emit_v3_v(difference_value, function_id, 3, target_type, difference_operator)
                                                0:
                                                    discard 0
                                                1:
                                                    discard 0
                                            discard emit_v3_v(add_value, function_id, 3, target_type, additive_operator)
                                            discard emit_v3_v(store_index_value, function_id, 2, 2, target_start)
                                            discard emit_v3_i_block(target_index_id, function_id, 0, ordinal, 1, 1, 1, -1, 0)
                                            discard emit_v3_r(target_index_id, 0, target_index_value)
                                            discard emit_v3_i_block(target_load_id, function_id, 0, ordinal + 1, 15, 1, 1, storage_id, -1)
                                            discard emit_v3_o(target_load_id, 0, target_index_value)
                                            discard emit_v3_r(target_load_id, 0, target_load_value)
                                            discard emit_v3_i_block(literal_id, function_id, 0, ordinal + 2, 1, 1, 0, -1, parse_integer_literal(literal_start, literal_stop))
                                            discard emit_v3_r(literal_id, 0, literal_value)
                                            discard emit_v3_i_block(multiply_id, function_id, 0, ordinal + 3, 7, 1, 2, -1, -1)
                                            discard emit_v3_o(multiply_id, 0, target_load_value)
                                            discard emit_v3_o(multiply_id, 1, literal_value)
                                            discard emit_v3_r(multiply_id, 0, multiply_value)
                                            discard emit_v3_i_block(argument_index_id, function_id, 0, ordinal + 4, 1, 1, 1, -1, 0)
                                            discard emit_v3_r(argument_index_id, 0, argument_index_value)
                                            discard emit_v3_i_block(argument_load_id, function_id, 0, ordinal + 5, 15, 1, 1, argument_storage_id, -1)
                                            discard emit_v3_o(argument_load_id, 0, argument_index_value)
                                            discard emit_v3_r(argument_load_id, 0, argument_load_value)
                                            discard emit_v3_i_block(call_id, function_id, 0, ordinal + 6, 14, 1, 1, -1, -1)
                                            discard emit_v3_o(call_id, 0, argument_load_value)
                                            discard emit_v3_r(call_id, 0, call_value)
                                            discard emit_v3_c(call_id, inner_callee_function_id, inner_callee_kind, inner_start, inner_stop - inner_start)
                                            discard emit_v3_a(call_id, 0, argument_load_value)
                                            discard emit_v3_i_block(convert_id, function_id, 0, ordinal + 7, 10, 1, 1, -1, -1)
                                            discard emit_v3_o(convert_id, 0, call_value)
                                            discard emit_v3_r(convert_id, 0, convert_value)
                                            match difference_info > 0:
                                                -1:
                                                    discard emit_v3_i_block(difference_literal_id, function_id, 0, ordinal + 8, 1, 1, 0, -1, parse_integer_literal(difference_literal_start, difference_literal_stop))
                                                    discard emit_v3_r(difference_literal_id, 0, difference_literal_value)
                                                    discard emit_v3_i_block(difference_id, function_id, 0, ordinal + 9, 6, 1, 2, -1, -1)
                                                    discard emit_v3_o(difference_id, 0, convert_value)
                                                    discard emit_v3_o(difference_id, 1, difference_literal_value)
                                                    discard emit_v3_r(difference_id, 0, difference_value)
                                                0:
                                                    discard 0
                                                1:
                                                    discard 0
                                            discard emit_v3_i_block(add_id, function_id, 0, ordinal + 8 + instruction_shift, 5, 1, 2, -1, -1)
                                            discard emit_v3_o(add_id, 0, multiply_value)
                                            discard emit_v3_o(add_id, 1, convert_value)
                                            discard emit_v3_r(add_id, 0, add_value)
                                            discard emit_v3_i_block(store_index_id, function_id, 0, ordinal + 9 + instruction_shift, 1, 1, 1, -1, 0)
                                            discard emit_v3_r(store_index_id, 0, store_index_value)
                                            discard emit_v3_i_block(store_id, function_id, 0, ordinal + 10 + instruction_shift, 16, 0, 2, storage_id, -1)
                                            discard emit_v3_o(store_id, 0, store_index_value)
                                            discard emit_v3_o(store_id, 1, add_value)
                                            return value_id + 10 + instruction_shift
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_general_assignment(mode: i64, function_id: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut target_start: i64 = first_non_space(first, stop)
    mut target_stop: i64 = word_end(target_start, stop)
    mut target_type: i64 = resolve_value_type(header_start, header_end, first, target_start, target_stop)
    mut immutable_declaration: i64 = parse_immutable_literal(first, stop, 1)
    match target_type > 0:
        -1:
            discard 0
        0:
            match immutable_declaration > 0:
                -1:
                    target_type = immutable_declaration / 1000000000000000
                0:
                    discard 0
                1:
                    discard 0
        1:
            discard 0
    mut expression_info: i64 = parse_assignment_expression_bounds(first, stop)
    mut mutable_storage_id: i64 = find_mutable_storage_id(header_end + 1, first, target_start, target_stop)
    mut expression_start: i64 = expression_info / 1000000
    mut expression_end: i64 = expression_info - expression_start * 1000000
    mut product_info: i64 = validate_product_types(header_start, header_end, first, target_start, target_type, expression_info)
    mut compound_info: i64 = validate_compound_types(header_start, header_end, first, target_start, target_type, expression_info)
    mut binary_info: i64 = validate_binary_types(header_start, header_end, first, target_start, target_type, expression_info)
    match mutable_storage_id >= 0:
        -1:
            match mode == 2:
                -1:
                    match compound_info > 0:
                        -1:
                            return scan_mutable_compound_assignment_v3(function_id, header_start, header_end, first, first, stop, target_start, target_stop, target_type, expression_info, value_id)
                        0:
                            match product_info > 0:
                                -1:
                                    return scan_mutable_product_assignment_v3(function_id, header_end, first, target_start, target_stop, target_type, expression_info, value_id)
                                0:
                                    match binary_info > 0:
                                        -1:
                                            return scan_mutable_binary_assignment_v3(function_id, header_start, header_end, first, target_start, target_stop, target_type, expression_info, value_id)
                                        0:
                                            return scan_mutable_literal_assignment_v3(function_id, header_end, first, target_start, target_stop, target_type, expression_info, value_id)
                                        1:
                                            return scan_mutable_literal_assignment_v3(function_id, header_end, first, target_start, target_stop, target_type, expression_info, value_id)
                                1:
                                    return scan_mutable_literal_assignment_v3(function_id, header_end, first, target_start, target_stop, target_type, expression_info, value_id)
                        1:
                            match product_info > 0:
                                -1:
                                    return scan_mutable_product_assignment_v3(function_id, header_end, first, target_start, target_stop, target_type, expression_info, value_id)
                                0:
                                    return scan_mutable_literal_assignment_v3(function_id, header_end, first, target_start, target_stop, target_type, expression_info, value_id)
                                1:
                                    return scan_mutable_literal_assignment_v3(function_id, header_end, first, target_start, target_stop, target_type, expression_info, value_id)
                0:
                    discard 0
                1:
                    discard 0
        0:
            discard 0
        1:
            discard 0
    match product_info > 0:
        -1:
            match mode == 1:
                -1:
                    mut additive_operator: i64 = product_info / 10
                    mut product_left_end: i64 = trim_expression_end(expression_start, additive_operator)
                    mut product_left_start: i64 = first_non_space(expression_start, product_left_end)
                    discard record_v(mode, value_id, function_id, 3, 2, target_start, 0, 0, -1)
                    discard record_v(mode, value_id + 1, function_id, 4, target_type, product_left_start, 0, 0, -1)
                    discard record_v(mode, value_id + 2, function_id, 3, target_type, skip_spaces(additive_operator + 1, expression_end), 0, 0, -1)
                    discard record_v(mode, value_id + 3, function_id, 4, target_type, additive_operator, 0, 0, -1)
                    discard record_v(mode, value_id + 4, function_id, 3, 2, target_start, 0, 0, -1)
                    return value_id + 5
                0:
                    return value_id + 5
                1:
                    return -1
        0:
            discard 0
        1:
            discard 0
    match expression_info > 0:
        -1:
            mut compound_info: i64 = validate_compound_types(header_start, header_end, first, target_start, target_type, expression_info)
            match compound_info > 0:
                -1:
                    mut expression_start: i64 = expression_info / 1000000
                    mut expression_end: i64 = expression_info - expression_start * 1000000
                    mut additive_operator: i64 = find_additive_operator(expression_start, expression_end) / 10
                    mut left_end: i64 = trim_expression_end(expression_start, additive_operator)
                    mut multiplicative_operator: i64 = find_multiplicative_operator(expression_start, left_end) / 10
                    mut literal_start: i64 = skip_spaces(multiplicative_operator + 1, left_end)
                    mut call_info: i64 = compound_info
                    mut outer_start: i64 = call_info / 1000000000000
                    mut call_remainder: i64 = call_info - outer_start * 1000000000000
                    mut inner_start: i64 = call_remainder / 1000000
                    mut argument_start: i64 = call_remainder - inner_start * 1000000
                    discard record_v(mode, value_id, function_id, 3, 2, target_start, 0, 0, -1)
                    discard record_v(mode, value_id + 1, function_id, 4, target_type, target_start, 0, 0, -1)
                    discard record_v(mode, value_id + 2, function_id, 3, target_type, literal_start, 0, 0, -1)
                    discard record_v(mode, value_id + 3, function_id, 4, target_type, multiplicative_operator, 0, 0, -1)
                    discard record_v(mode, value_id + 4, function_id, 3, 2, argument_start, 0, 0, -1)
                    discard record_v(mode, value_id + 5, function_id, 4, 3, argument_start, 0, 0, -1)
                    discard record_v(mode, value_id + 6, function_id, 4, 2, inner_start, 0, 0, -1)
                    discard record_v(mode, value_id + 7, function_id, 4, target_type, outer_start, 0, 0, -1)
                    discard record_v(mode, value_id + 8, function_id, 4, target_type, additive_operator, 0, 0, -1)
                    discard record_v(mode, value_id + 9, function_id, 3, 2, target_start, 0, 0, -1)
                    return value_id + 10
                0:
                    mut literal_info: i64 = validate_literal_types(header_start, header_end, first, target_start, target_type, expression_info)
                    match literal_info > 0:
                        -1:
                            mut expression_start: i64 = expression_info / 1000000
                            mut expression_end: i64 = expression_info - expression_start * 1000000
                            mut literal_start: i64 = literal_info - 1
                            discard record_v(mode, value_id, function_id, 3, 2, target_start, 0, 0, -1)
                            discard record_v(mode, value_id + 1, function_id, 4, target_type, target_start, 0, 0, -1)
                            discard record_v(mode, value_id + 2, function_id, 3, target_type, literal_start, 0, 0, -1)
                            discard record_v(mode, value_id + 3, function_id, 3, 2, target_start, 0, 0, -1)
                            return value_id + 4
                        0:
                            mut binary_info: i64 = validate_binary_types(header_start, header_end, first, target_start, target_type, expression_info)
                            match binary_info > 0:
                                -1:
                                    mut expression_start: i64 = expression_info / 1000000
                                    mut expression_end: i64 = expression_info - expression_start * 1000000
                                    mut additive_operator: i64 = binary_info / 10
                                    mut left_end: i64 = trim_expression_end(expression_start, additive_operator)
                                    mut right_start: i64 = skip_spaces(additive_operator + 1, expression_end)
                                    discard record_v(mode, value_id, function_id, 3, 2, target_start, 0, 0, -1)
                                    discard record_v(mode, value_id + 1, function_id, 4, target_type, target_start, 0, 0, -1)
                                    discard record_v(mode, value_id + 2, function_id, 3, target_type, right_start, 0, 0, -1)
                                    discard record_v(mode, value_id + 3, function_id, 4, target_type, additive_operator, 0, 0, -1)
                                    discard record_v(mode, value_id + 4, function_id, 3, 2, target_start, 0, 0, -1)
                                    return value_id + 5
                                0:
                                    return -1
                                1:
                                    return -1
                        1:
                            return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_increment_assignment_v3(function_id: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut target_start: i64 = first_non_space(first, stop)
    mut target_stop: i64 = word_end(target_start, stop)
    mut storage_id: i64 = find_mutable_storage_id(header_end + 1, first, target_start, target_stop)
    mut target_type: i64 = resolve_value_type(header_start, header_end, first, target_start, target_stop)
    mut operator_start: i64 = skip_spaces(target_stop, stop)
    mut literal_start: i64 = skip_spaces(operator_start + 2, stop)
    mut literal_stop: i64 = trim_expression_end(literal_start, stop)
    match storage_id >= 0:
        -1:
            match target_type > 0:
                -1:
                    mut ordinal: i64 = count_core_instructions_between(header_end + 1, first)
                    mut base_id: i64 = function_id * 1000000 + ordinal
                    mut index_id: i64 = base_id
                    mut load_id: i64 = base_id + 1
                    mut const_id: i64 = base_id + 2
                    mut add_id: i64 = base_id + 3
                    mut store_index_id: i64 = base_id + 4
                    mut store_id: i64 = base_id + 5
                    mut index_value: i64 = value_id
                    mut load_value: i64 = value_id + 1
                    mut literal_value: i64 = value_id + 2
                    mut add_value: i64 = value_id + 3
                    mut store_index_value: i64 = value_id + 4
                    discard emit_v3_v(index_value, function_id, 2, 2, target_start)
                    discard emit_v3_v(load_value, function_id, 3, target_type, target_start)
                    discard emit_v3_v(literal_value, function_id, 2, target_type, literal_start)
                    discard emit_v3_v(add_value, function_id, 3, target_type, operator_start)
                    discard emit_v3_v(store_index_value, function_id, 2, 2, target_start)
                    discard emit_v3_i(index_id, function_id, ordinal, 1, 1, 0, 0)
                    discard emit_v3_r(index_id, 0, index_value)
                    discard emit_v3_i_aux(load_id, function_id, ordinal + 1, 15, 1, 1, storage_id, -1)
                    discard emit_v3_o(load_id, 0, index_value)
                    discard emit_v3_r(load_id, 0, load_value)
                    discard emit_v3_i(const_id, function_id, ordinal + 2, 1, 1, 0, parse_integer_literal(literal_start, literal_stop))
                    discard emit_v3_r(const_id, 0, literal_value)
                    discard emit_v3_i(add_id, function_id, ordinal + 3, 5, 1, 2, -1)
                    discard emit_v3_o(add_id, 0, load_value)
                    discard emit_v3_o(add_id, 1, literal_value)
                    discard emit_v3_r(add_id, 0, add_value)
                    discard emit_v3_i_aux(store_index_id, function_id, ordinal + 4, 1, 1, 0, -1, 0)
                    discard emit_v3_r(store_index_id, 0, store_index_value)
                    discard emit_v3_i_aux(store_id, function_id, ordinal + 5, 16, 0, 2, storage_id, -1)
                    discard emit_v3_o(store_id, 0, store_index_value)
                    discard emit_v3_o(store_id, 1, add_value)
                    return value_id + 5
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_increment_assignment(mode: i64, function_id: i64, header_start: i64, header_end: i64, first: i64, stop: i64, value_id: i64) -> i64:
    mut cursor: i64 = first_non_space(first, stop)
    mut target_start: i64 = cursor
    mut target_stop: i64 = word_end(cursor, stop)
    match is_identifier_span(target_start, target_stop):
        -1:
            cursor = skip_spaces(target_stop, stop)
            match expect_byte(cursor, stop, 43):
                -1:
                    match expect_byte(cursor + 1, stop, 61):
                        -1:
                            cursor = skip_spaces(cursor + 2, stop)
                            mut literal_start: i64 = cursor
                            match read_byte(cursor) == 45:
                                -1:
                                    cursor += 1
                                0:
                                    discard 0
                                1:
                                    discard 0
                            match is_digit(read_byte(cursor)):
                                -1:
                                    mut literal_stop: i64 = number_end(cursor, stop)
                                    cursor = skip_spaces(literal_stop, stop)
                                    match cursor == stop:
                                        -1:
                                            mut target_type: i64 = resolve_value_type(header_start, header_end, first, target_start, target_stop)
                                            match target_type > 0:
                                                -1:
                                                    match mode == 1:
                                                        -1:
                                                            discard emit_v(value_id, function_id, 3, 2, target_start, 0, 0, -1)
                                                            discard emit_v(value_id + 1, function_id, 4, target_type, target_start, 0, 0, -1)
                                                            discard emit_v(value_id + 2, function_id, 3, target_type, literal_start, 0, 0, -1)
                                                            discard emit_v(value_id + 3, function_id, 4, target_type, target_start, 0, 0, -1)
                                                            discard emit_v(value_id + 4, function_id, 3, 2, target_start, 0, 0, -1)
                                                            return value_id + 5
                                                        0:
                                                            match mode == 2:
                                                                -1:
                                                                    return scan_increment_assignment_v3(function_id, header_start, header_end, first, stop, value_id)
                                                                0:
                                                                    return value_id + 5
                                                                1:
                                                                    return -1
                                                        1:
                                                            return -1
                                                0:
                                                    return -1
                                                1:
                                                    return -1
                                        0:
                                            return -1
                                        1:
                                            return -1
                                0:
                                    return -1
                                1:
                                    return -1
                        0:
                            return -1
                        1:
                            return -1
                0:
                    return scan_general_assignment(mode, function_id, header_start, header_end, first, stop, value_id)
                1:
                    return -1
        0:
            return -1
        1:
            return -1

