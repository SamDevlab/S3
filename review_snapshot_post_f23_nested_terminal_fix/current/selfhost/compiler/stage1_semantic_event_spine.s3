                                    mut product_left_start: i64 = first_non_space(right_start, product_left_stop)
                                    mut product_left_word_stop: i64 = word_end(product_left_start, product_left_stop)
                                    mut product_right_start: i64 = skip_spaces(product_operator + 1, end)
                                    mut product_right_stop: i64 = word_end(product_right_start, end)
                                    match is_identifier_span(left_start, left_stop):
                                        -1:
                                            match skip_spaces(left_stop, left_end) == left_end:
                                                -1:
                                                    match is_identifier_span(product_left_start, product_left_word_stop):
                                                        -1:
                                                            match skip_spaces(product_left_word_stop, product_left_stop) == product_left_stop:
                                                                -1:
                                                                    match is_identifier_span(product_right_start, product_right_stop):
                                                                        -1:
                                                                            match skip_spaces(product_right_stop, end) == end:
                                                                                -1:
                                                                                    return parsed_type * 1000000000000000 + name_start * 1000000000 + (name_stop - name_start) * 1000000 + additive_operator
                                                                                0:
                                                                                    return 0
                                                                                1:
                                                                                    return 0
                                                                        0:
                                                                            return 0
                                                                        1:
                                                                            return 0
                                                                0:
                                                                    return 0
                                                                1:
                                                                    return 0
                                                        0:
                                                            return 0
                                                        1:
                                                            return 0
                                                0:
                                                    return 0
                                                1:
                                                    return 0
                                        0:
                                            return 0
                                        1:
                                            return 0
                                0:
                                    return 0
                                1:
                                    return 0
                        0:
                            return 0
                        1:
                            return 0
                0:
                    return 0
                1:
                    return 0
        0:
            return 0
        1:
            return 0

