                                            -1:
                                                mut decoded_block_id: i64 = lowering_result_next_block(body_next_id)
                                                mut decoded_next_id: i64 = lowering_result_next_id(body_next_id)
                                                mut decoded_cursor: i64 = lowering_result_next_cursor(body_next_id)
                                                next_id = decoded_next_id
                                                current_block_id = decoded_block_id
                                                current_block_start = decoded_cursor
                                                stop = decoded_cursor - 1
                                            0:
                                                match body_result_kind == 2:
                                                    -1:
                                                        mut decoded_next_id: i64 = lowering_result_next_id(body_next_id)
                                                        mut decoded_cursor: i64 = lowering_result_next_cursor(body_next_id)
                                                        next_id = decoded_next_id
                                                        stop = decoded_cursor - 1
                                                        current_has_return = -1
                                                    0:
                                                        match body_result_kind == 1:
                                                            -1:
                                                                mut decoded_next_id: i64 = lowering_result_next_id(body_next_id)
                                                                mut decoded_cursor: i64 = lowering_result_next_cursor(body_next_id)
                                                                next_id = decoded_next_id
                                                                stop = decoded_cursor - 1
                                                            0:
                                                                match body_next_id >= 0:
                                                                    -1:
                                                                        next_id = body_next_id
                                                                        match is_return_line(first, stop):
                                                                            -1:
                                                                                match mode == 2:
                                                                                    -1:
                                                                                        match current_block_id > 0:
                                                                                            -1:
                                                                                                mut block_instruction_count: i64 = count_core_instructions_between(current_block_start, stop)
                                                                                                mut block_terminator_ordinal: i64 = v3_continuation_terminator_ordinal(current_header_start, current_header_end, first, stop)
                                                                                                mut block_context_function_id: i64 = v3_context_function_id(function_id, current_block_id)
                                                                                                discard emit_v3_b_block(function_id, current_block_id, current_block_id, block_instruction_count, v3_context_instruction_id(block_context_function_id * 1000000 + block_terminator_ordinal))
                                                                                            0:
                                                                                                discard 0
                                                                                            1:
                                                                                                discard 0
                                                                                    0:
                                                                                        discard 0
                                                                                    1:
                                                                                        discard 0
                                                                                current_has_return = -1
                                                                            0:
                                                                                discard 0
                                                                            1:
                                                                                return -1
                                                                    0:
                                                                        return -1
                                                                    1:
                                                                        return -1
                                                            1:
                                                                return -1
                                                    1:
                                                        return -1
                                            1:
                                                return -1
                                    1:
                                        return -1
                            0:
                                return -1
                            1:
                                return -1
                    1:
                        return -1
            1:
                return -1
        cursor = stop + 1
    match mode == 2:
        -1:
            match function_contains_match(current_header_end + 1, length):
                -1:
                    discard 0
                0:
                    discard emit_v3_b(function_id, count_core_instructions_between(current_header_end + 1, length))
                1:
                    discard emit_v3_b(function_id, count_core_instructions_between(current_header_end + 1, length))
        0:
            discard 0
        1:
            return -1
    match function_id >= 0:
        -1:
            match current_has_return == -1:
                -1:
                    match mode == 1:
                        -1:
                            return scan_foreign_parameters(function_id + 1, next_id)
                        0:
                            return next_id
                        1:
                            return next_id
                0:
                    return -1
                1:
                    return -1
        0:
            return -1
        1:
            return -1

fn scan_bindings(starting_value_id: i64) -> i64:
    mut length: i64 = s3_stage1_source_length()
    mut cursor: i64 = 0
    mut function_id: i64 = -1
    mut next_id: i64 = starting_value_id
    while cursor < length:
        mut stop: i64 = line_end(cursor, length)
        mut first: i64 = first_non_space(cursor, stop)
        match first == stop:
            -1:
                discard 0
            0:
                match first == cursor:
                    -1:
                        mut header_info: i64 = parse_header(first, stop, 1)
                        match header_info > 0:
                            -1:
                                function_id += 1
                            0:
                                mut foreign_info: i64 = parse_foreign_header(first, stop)
                                match foreign_info > 0:
                                    -1:
                                        discard 0
                                    0:
                                        return -1
                                    1:
                                        return -1
                            1:
                                return -1
                    0:
                        match function_id >= 0:
                            -1:
                                mut body_word_stop: i64 = word_end(first, stop)
                                match word_is(first, body_word_stop, 108492, 3):
                                    -1:
                                        mut packed: i64 = parse_mut(first, stop)
                                        mut call_packed: i64 = 0
                                        match packed == 0:
                                            -1:
                                                packed = parse_mut_identifier(first, stop)
                                                match packed == 0:
                                                    -1:
                                                        call_packed = parse_mut_call_binding(first, stop)
                                                    0:
                                                        discard 0
                                                    1:
                                                        discard 0
                                            0:
                                                discard 0
                                            1:
                                                discard 0
                                        match packed > 0:
                                            -1:
                                                mut parsed_type: i64 = packed / 1000000000000000
                                                mut remainder: i64 = packed - parsed_type * 1000000000000000
                                                mut name_start: i64 = remainder / 1000000000
                                                remainder = remainder - name_start * 1000000000
                                                mut name_length: i64 = remainder / 1000000
                                                discard emit_v(next_id, function_id, 2, parsed_type, name_start, name_length, 1, -1)
                                                next_id += 1
                                            0:
                                                match call_packed > 0:
                                                    -1:
                                                        next_id = emit_call_binding(function_id, call_packed, next_id)
                                                    0:
                                                        return -1
                                                    1:
                                                        return -1
                                            1:
                                                return -1
                                    0:
                                        discard 0
                                    1:
                                        return -1
                            0:
                                return -1
                            1:
                                return -1
                    1:
                        return -1
            1:
                return -1
        cursor = stop + 1
    return next_id


fn main() -> i64:
    # S3_STAGE1_SEMANTIC_EVENT_SPINE: bounded three-pass native V replay.
    mut validated_count: i64 = scan_program(0, 0)
    match validated_count >= 0:
        -1:
            mut host_count: i64 = scan_program(1, 0)
            match host_count >= 0:
                -1:
                    # Declaration records are emitted at the point where their
                    # initializer value is known; a second synthetic-binding
                    # pass would lose the value/storage relationship.
                    mut complete_count: i64 = host_count
                    match complete_count >= 0:
                        -1:
                            match core_v3_subset() == -1:
                                -1:
                                    discard emit_v3_header()
                                    mut v3_count: i64 = scan_program(2, 0)
                                    match v3_count >= 0:
                                        -1:
                                            discard emit_v3_complete()
                                            discard s3_stage1_exit(0)
                                        0:
                                            discard emit_blocked()
                                            discard s3_stage1_exit(2)
                                        1:
                                            discard emit_blocked()
                                            discard s3_stage1_exit(2)
                                0:
                                    discard s3_stage1_exit(0)
                                1:
                                    discard emit_blocked()
                                    discard s3_stage1_exit(2)
                        0:
                            discard emit_blocked()
                            discard s3_stage1_exit(2)
                        1:
                            discard emit_blocked()
                            discard s3_stage1_exit(2)
                0:
                    discard emit_blocked()
                    discard s3_stage1_exit(2)
                1:
                    discard emit_blocked()
                    discard s3_stage1_exit(2)
        0:
            discard emit_blocked()
            discard s3_stage1_exit(2)
        1:
            discard emit_blocked()
            discard s3_stage1_exit(2)
    return 2
