            mut continuation_context: i64 = v3_context_function_id(logical_function_id, nested_next_block)
            mut continuation_next_id: i64 = scan_statement_body(2, continuation_context, return_type, header_start, header_end, continuation_first, continuation_stop, nested_decoded_next_id)
            match continuation_next_id > 0:
