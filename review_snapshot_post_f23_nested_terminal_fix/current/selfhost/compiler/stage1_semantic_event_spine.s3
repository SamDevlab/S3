                        return -1
                    1:
                        return -1
                cursor = skip_spaces(cursor, end)
                mut type_start: i64 = cursor
                mut type_stop: i64 = word_end(cursor, end)
                match type_code(type_start, type_stop) > 0:
                    -1:
                        cursor = skip_spaces(type_stop, end)
                    0:
                        return -1
                    1:
                        return -1
                count += 1
                match read_byte(cursor) == 41:
                    -1:
                        return count
                    0:
                        match expect_byte(cursor, end, 44):
                            -1:
                                cursor += 1
                                cursor = skip_spaces(cursor, end)
                            0:
                                return -1
                            1:
                                return -1
                    1:
                        return -1
            return -1
        1:
            return -1

fn emit_v3_parameters(start: i64, end: i64, function_id: i64, value_id: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    cursor = skip_spaces(word_stop, end)
    word_stop = word_end(cursor, end)
    cursor = skip_spaces(word_stop, end)
    match expect_byte(cursor, end, 40):
        -1:
            cursor += 1
        0:
            return -1
        1:
            return -1
    mut next_id: i64 = value_id
    cursor = skip_spaces(cursor, end)
    match read_byte(cursor) == 41:
        -1:
            return next_id
        0:
            while cursor < end:
                mut name_start: i64 = cursor
                mut name_stop: i64 = word_end(cursor, end)
                match is_identifier_span(name_start, name_stop):
                    -1:
                        cursor = skip_spaces(name_stop, end)
                    0:
                        return -1
                    1:
                        return -1
                match expect_byte(cursor, end, 58):
                    -1:
                        cursor += 1
                    0:
                        return -1
                    1:
                        return -1
                cursor = skip_spaces(cursor, end)
                mut type_start: i64 = cursor
                mut type_stop: i64 = word_end(cursor, end)
                mut parsed_type: i64 = type_code(type_start, type_stop)
                match parsed_type > 0:
                    -1:
                        cursor = skip_spaces(type_stop, end)
                    0:
                        return -1
                    1:
                        return -1
                discard emit_v3_v(next_id, function_id, 1, parsed_type, name_start)
                discard emit_v3_d(next_id, function_id, parsed_type, name_start, name_stop - name_start, 0, 1, next_id)
                next_id += 1
                match read_byte(cursor) == 41:
                    -1:
                        return next_id
                    0:
                        match expect_byte(cursor, end, 44):
                            -1:
                                cursor += 1
                                cursor = skip_spaces(cursor, end)
                            0:
                                return -1
                            1:
                                return -1
                    1:
                        return -1
            return -1
        1:
            return -1

fn emit_parameters(start: i64, end: i64, function_id: i64, value_id: i64) -> i64:
    mut cursor: i64 = first_non_space(start, end)
    mut word_stop: i64 = word_end(cursor, end)
    cursor = skip_spaces(word_stop, end)
    word_stop = word_end(cursor, end)
